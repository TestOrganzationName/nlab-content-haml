                        %mtr
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast
                    \\\
                    {}^{\mathllap{\delta_0}}\downarrow &amp; \searrow^{\mathrlap{x}}
                    \\\
                    I &amp;\stackrel{\eta}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\delta_1}}\uparrow &amp; \nearrow_{\mathrlap{y}}
                    \\\
                    \\ast
                    }
                    \\,.
            %p
              This is simply a continuous path in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose endpoints are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
          %p For instance:
          #StandardContractionOfStandardInterval.num_example
            %h6#example_14 Example
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo ⟶
                    %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi δ
                          %mn 0
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    const_0 \;\colon\; I \longrightarrow \ast \overset{\delta_0}{\longrightarrow} I
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              from the standard interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I = [0,1]
              to itself that is constant on the value 0. Then there is a left homotopy, def.
              = succeed "," do
                %a.maruku-ref{:href => "#LeftHomotopy"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi I
                    %mo ⇒
                    %msub
                      %mi const
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; id_I \Rightarrow const_0
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(x,t) \coloneqq x(1-t)
                    \\,.
          %p
            A key application of the concept of left homotopy is to the definition of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          #HomotopyGroupsOftopologicalSpaces.num_defn
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(X)
              of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              = succeed "," do
                %strong 0-th homotopy set
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftHomotopy"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#PathsAsLeftHomotopyBetweenPoints"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              this extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Top
                    %mo ⟶
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 \colon Top \longrightarrow Set
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              any point, the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %ul
              %li
                %p
                  whose underlying
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  is the set of
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                  of maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi I
                          %mi n
                        %mo ⟶
                        %mi X
                      %annotation{:encoding => "application/x-tex"} I^n \longrightarrow X
                  that take the
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi I
                          %mi n
                      %annotation{:encoding => "application/x-tex"} I^n
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  and where the left homotopies
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  are constrained to be constant on the boundary;
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                  product operation takes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi α
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi I
                          %mi n
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\alpha \colon I^n \to X]
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi β
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi I
                          %mi n
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\beta \colon I^n \to X]
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi α
                        %mo ⋅
                        %mi β
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\alpha \cdot \beta]
                  with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ⋅
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi I
                      %mi n
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi I
                      %mi n
                    %munder
                      %mo ⊔
                      %mrow
                        %msup
                          %mi I
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msup
                      %mi I
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo ,
                        %mi β
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \cdot \beta
                    \\;\colon\;
                    
                    I^n
                    \\stackrel{\simeq}{\longrightarrow}
                    I^n \underset{I^{n-1}}{\sqcup} I^n
                    \\stackrel{(\alpha,\beta)}{\longrightarrow}
                    X
                    \\,,
            %p
              where the first map is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              from the unit
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cube"} cube
              to the
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo ,
                      %msub
                        %mi x
                        %mn 3
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo ,
                      %msub
                        %mi x
                        %mn 3
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1, x_2, x_3, \cdots) \mapsto (2 x_1, x_2, x_3, \cdots)
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo ≥
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msup
                      %mi Grp
                      %mrow
                        %msub
                          %mi ℕ
                          %mrow
                            %mo ≥
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{\bullet \geq 1}
                    \\;\colon\;
                    Top^{\ast/}
                    \\longrightarrow
                    Grp^{\mathbb{N}_{\geq 1}}
            %p
              from
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              to
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groups"} groups
          %p
            Notice that often one writes the value of this functor on a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo =
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast = \pi_\bullet(f)
          .num_remark
            %h6#remark_3 Remark
            %p
              At this point we don’t go further into the abstract reason why def.
              %a.maruku-ref{:href => "#HomotopyGroupsOftopologicalSpaces"}
              yields group structure above degree 0, which is that
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/positive+dimension+spheres+are+H-cogroup+objects"} positive dimension spheres are H-cogroup objects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              %em
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BrownRepresentabilityTheorem"} Brown representability theorem
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} Part S
          #HomotopyEquivalence.num_defn
            %h6#definition_9 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              if there exists a continuous function the other way around,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Y
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g \;\colon\; Y \longrightarrow X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+homotopies"} left homotopies
              = succeed "," do
                %a.maruku-ref{:href => "#LeftHomotopy"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ∘
                    %mi g
                    %msub
                      %mo ⇒
                      %mi L
                    %msub
                      %mi id
                      %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_1 \;\colon\; f\circ g \Rightarrow_L id_Y
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ∘
                    %mi f
                    %msub
                      %mo ⇒
                      %mi L
                    %msub
                      %mi id
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_2 \;\colon\; g\circ f \Rightarrow_L id_X
                    \\,.
            %p
              If here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \eta_2
              is constant along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is said to exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          #ProjectionFromStandardCylinderIsHomotopyEquivalence.num_example
            %h6#example_15 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X \times I
              its standard
              %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi I
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon X \times I \longrightarrow X
              and the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ,
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} (id, \delta_0) \colon X \longrightarrow X\times I
              are
              = succeed "," do
