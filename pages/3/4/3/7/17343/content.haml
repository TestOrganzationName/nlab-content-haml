                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        cofib(X \vee X \to X \wedge (I_+)) \simeq S^1 \wedge X
                        \\,,
            %p Dually:
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SuspensionAndLoopSpaceObject"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mo +
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} Maps(I_+,-)_\ast
                  are isomorphic to the
                  %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#PointedMappingSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/1-sphere"} 1-sphere
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi fib
                        %mo{:stretchy => "false"} (
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mo +
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo →
                        %mi X
                        %mo ×
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        fib(Maps(I_+,X)_\ast \to X \times X)
                        \\simeq
                        Maps(S^1, X)_\ast
                        \\,.
          .proof
            %h6#proof_60 Proof
            %p
              By immediate inspection: For instance the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Maps(I_+,X)_\ast \longrightarrow X\times X
              is clearly the subspace of the unpointed mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi I
                  %annotation{:encoding => "application/x-tex"} X^I
              on elements that take the endpoints of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              to the basepoint of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #MappingConesInTopologicalSpaces.num_example
            %h6#example_36 Example
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://ncatlab.org/nlab/files/mappingcone.jpg", :width => "560"}/
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} =
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Cyl(X) = X\times I
              the standard cyclinder object, def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              = succeed "," do
                %a.maruku-ref{:href => "#PushoutInTop"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              = succeed "," do
                %a.maruku-ref{:href => "#MappingConeAndMappingCocone"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is obtained by
            %ol
              %li
                %p
                  forming the cylinder over
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  attaching to one end of that cylinder the space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  as specified by the map
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
              %li
                %p shrinking the other end of the cylinder to the point.
            %p
              Accordingly the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of a topological space is the result of shrinking both ends of the cylinder on the object two the point. This is homeomoprhic to attaching two copies of the cone on the space at the base of the cone.
            %p
              (graphics taken from
              = succeed ")" do
                %a{:href => "#Muro10"} Muro 2010
            %p
              Below in example
              %a.maruku-ref{:href => "#StandardTopologicalMappingConeIsHomotopyCofiber"}
              we find the homotopy-theoretic interpretation of this standard topological mapping cone as a model for the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
          #UnreducedCone.num_remark
            %h6#remark_28 Remark
            %p
              The
              %em formula
              for the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              in prop.
              %a.maruku-ref{:href => "#ConeAndMappingCylinder"}
              (as opposed to that of the mapping co-cone) does not require the presence of the basepoint: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (as opposed to in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Y
                    %munder
                      %mo ⊔
                      %mi X
                    %mi Cone
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Cone'(f) \coloneqq Y \underset{X}{\sqcup} Cone'(X)
                    \\,,
            %p
              where the prime denotes the
              = succeed "," do
                %em unreduced cone
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #UnreducedMappingConeAsReducedConeOfBasedPointAdjoined.num_prop
            %h6#proposition_38 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              a morphism in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              = succeed "," do
                %a.maruku-ref{:href => "#UnreducedCone"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X \times I
              def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              = succeed "," do
                %a.maruku-ref{:href => "#MappingConeAndMappingCocone"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo +
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo +
                    %mo →
                    %msub
                      %mi Y
                      %mo +
                  %annotation{:encoding => "application/x-tex"} f_+ \colon X_+ \to Y_+
              (with a basepoint adjoined, def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BasePointAdjoined"}
              %a.existingWikiWord{:href => "/nlab/show/reduced+cylinder"} reduced cylinder
              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#StandardReducedCyclinderInTop"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cone'(f) \simeq Cone(f_+)
                    \\,.
          .proof
            %h6#proof_61 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#LimitsAndColimitsOfPointedObjects"}
              and example
              = succeed "," do
                %a.maruku-ref{:href => "#WedgeAndSmashOfBasePointAdjoinedTopologicalSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(f_+)
              is given by the colimit in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              over the following diagram:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo ⊔
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                            %mo ⊔
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                            %mo ⊔
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ×
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ⊔
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mo +
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\longrightarrow&amp; X \sqcup \ast &amp;\overset{(f,id)}{\longrightarrow}&amp; Y \sqcup \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    X \sqcup\ast &amp;\longrightarrow&amp; (X \times I) \sqcup \ast
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; &amp;\longrightarrow&amp; Cone(f_+)
                    }
                    \\,.
            %p We may factor the vertical maps to give
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo ⊔
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                            %mo ⊔
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                            %mo ⊔
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ×
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ⊔
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                            %mo ⊔
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo +
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\longrightarrow&amp; X \sqcup \ast &amp;\overset{(f,id)}{\longrightarrow}&amp; Y \sqcup \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    X \sqcup\ast &amp;\longrightarrow&amp; (X \times I) \sqcup \ast
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    \\ast \sqcup \ast &amp;\longrightarrow&amp; &amp;\longrightarrow&amp; Cone'(f)_+
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; &amp;\longrightarrow&amp; Cone'(f)
                    }
                    \\,.
            %p
              This way the top part of the diagram (using the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              to compute the colimit in two stages) is manifestly a cocone under the result of applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} (-)_+
              to the diagram for the unreduced cone. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} (-)_+
              is itself given by a colimit, it preserves colimits, and hence gives the partial colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} Cone'(f)_+
              as shown. The remaining pushout then contracts the remaining copy of the point away.
          %p
            Example
            %a.maruku-ref{:href => "#MappingConesInTopologicalSpaces"}
            makes it clear that every
            %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} S^n \to Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            that happens to be in the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            can be
            %em continuously
            translated in the cylinder-direction, keeping it constant in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %a.maruku-ref{:href => "#HomotopyGroupsOftopologicalSpaces"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            vanishes in the mapping cone. Hence in the mapping cone
            = succeed "." do
              %strong
                the image of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is removed up to homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cone
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cone(f)
