                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (X \wedge Y) \wedge Z
                    \&amp; =
                    \\frac{
                    \\frac{X\times Y}{X \times\{y\} \sqcup \{x\}\times Y}
