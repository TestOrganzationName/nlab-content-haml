                              %mn 1
                              %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
          .proof
            %h6#proof_9 Proof
            %p We go through each item in turn.
            %p
              %strong containing isomorphisms
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Iso
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{f}{\rightarrow}&amp; X
                    \\\
                    {}_{\mathllap{\in Iso}}^{\mathllap{i}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    B &amp;\underset{g}{\longrightarrow}&amp; Y
                    }
            %p
              with the left morphism an isomorphism, then a
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              is given by using the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              of this isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                        %mrow
                          %mi f
                          %mo ∘
                          %msup
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mo ↗
                    %annotation{:encoding => "application/x-tex"} {}^{{f \circ i^{-1}}}\nearrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} p \in K
              and so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi K
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} i \in K Proj
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              %strong closure under composition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p_1}}_{\mathrlap{\in K Inj}}
                    \\\
                    {}^{\mathllap{i}}_{\mathllap{\in K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_2}}_{\mathrlap{\in K Inj}}
                    \\\
                    B &amp;\longrightarrow&amp; Y
                    }
            %p
              consider its
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              decomposition as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow
                    \&amp;\searrow&amp; \downarrow^{\mathrlap{p_1}}_{\mathrlap{\in K Inj}}
                    \\\
                    {}^{\mathllap{i}}_{\mathllap{\in K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_2}}_{\mathrlap{\in K Inj}}
                    \\\
                    B &amp;\longrightarrow&amp; Y
                    }
                    \\,.
            %p
              Now the bottom commuting square has a lift, by assumption. This yields another
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msubsup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi K
                                  %mi Inj
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{i}}_{\mathllap{\in K}}\downarrow
                    \&amp;&amp; \downarrow^{\mathrlap{p_1}}_{\mathrlap{\in K Inj}}
                    \\\
                    \\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{p_2}}_{\mathrlap{\in K Inj}}
                    \\\
                    B &amp;\longrightarrow&amp; Y
                    }
            %p
              and now the top commuting square has a lift by assumption. This is now equivalently a lift in the total diagram, showing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo ∘
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1\circ p_1
              has the right lifting property against
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and is hence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mi Inj
                    %annotation{:encoding => "application/x-tex"} K Inj
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi Proj
                  %annotation{:encoding => "application/x-tex"} K Proj
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi Proj
                  %annotation{:encoding => "application/x-tex"} K Proj
              under
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              follows since the latter is given by
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              of sequential composition and successive lifts against the underlying sequence as above constitutes a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              (cf. eg.
              = succeed ")." do
                %a{:href => "model+category#Hirschhorn02"} Hirschhorn (2002), Lem. 10.3.1
            %p
              %strong closure under retracts
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              be the
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of an
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
