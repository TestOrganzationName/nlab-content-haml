            %p
              Write the factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as a
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo =
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{i}{\longrightarrow}&amp; A
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y &amp;= &amp; Y
                    }
                    \\,.
            %p
              By the assumed
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              against
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              there exists a diagonal filler
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              making a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo =
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{i}{\longrightarrow}&amp; A
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;{}^{\mathllap{g}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y &amp;= &amp; Y
                    }
                    \\,.
            %p By rearranging this diagram a little, it is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi Y
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; X &amp;=&amp; X
                    \\\
                    \&amp; {}^{\mathllap{f}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{i}}\downarrow
                    \\\
                    id_Y \colon &amp; Y &amp;\underset{g}{\longrightarrow}&amp; A &amp;\underset{p}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
            %p
              Completing this to the right, this yields a diagram exhibiting the required retract according to remark
              = succeed ":" do
                %a.maruku-ref{:href => "#RetractsOfMorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi X
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi X
                          %mtd
                            %mo =
                          %mtd
                            %mi X
                          %mtd
                            %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi Y
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id_X \colon &amp; X &amp;=&amp; X &amp;=&amp; X
                    \\\
                    \&amp; {}^{\mathllap{f}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{i}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{f}}\downarrow
                    \\\
                    id_Y \colon &amp; Y &amp;\underset{g}{\longrightarrow}&amp; A &amp;\underset{p}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
          %p
            %strong Small object argument
          %p
            Given a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊂
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \subset Mor(\mathcal{C})
            of morphisms in some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⟶
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
            through a relative
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %a.maruku-ref{:href => "#TopologicalCCellComplex"}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
            %a.maruku-ref{:href => "#RightLiftingProperty"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %mo ∈
                      %mi C
                      %mi cell
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo ⟶
                    %mrow
                      %mo ∈
                      %mi C
                      %mi inj
                  %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f
                  \\;\colon\;
                  X
                  \\stackrel{\in C cell}{\longrightarrow}
                  \\hat X
                  \\stackrel{\in C inj}{\longrightarrow}
                  Y
                  \\,.
          %p
            A first approximation to such a factorization turns out to be given simply by forming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo =
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \hat X = X_1
            by attaching
            %strong all
            possible
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi dom
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi c
                                  %mo ∈
                                  %mi C
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi cod
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  (C/f)
                  \\coloneqq
                  \\left\{
                  \\array{
                  dom(c) &amp;\stackrel{}{\longrightarrow}&amp; X
                  \\\
                  {}^{\mathllap{c\in C}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                  \\\
                  cod(c) &amp;\longrightarrow&amp; Y
                  }
                  \\right\}
          %p
            be the set of
            %strong all
            ways to find a
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat X
            of the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            over all these:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi c
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} /
                                    %mi f
                                    %mo{:stretchy => "false"} )
                                %mi c
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi po
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\underset{c\in(C/f)}{\coprod} dom(c) &amp;\longrightarrow&amp; X
                  \\\
                  {}^{\mathllap{\underset{c\in(C/f)}{\coprod} c}}\downarrow
                  \&amp;(po)&amp;
                  \\downarrow^{\mathrlap{}}
                  \\\
                  \\underset{c\in(C/f)}{\coprod} cod(c)
                  \&amp;\longrightarrow&amp;
                  X_1
                  }
                  \\,.
          %p This gets already close to producing the intended factorization:
          %p
            First of all the resulting map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X \to X_1
            is a
            = succeed "-relative" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Second, by the fact that the coproduct is over all commuting squres to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself makes a
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi c
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} /
                                    %mi f
                                    %mo{:stretchy => "false"} )
                                %mi c
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\underset{c\in(C/f)}{\coprod} dom(c) &amp;\longrightarrow&amp; X
                  \\\
                  {}^{\mathllap{\underset{c\in(C/f)}{\coprod} c}}\downarrow
                  \&amp;&amp;
                  \\downarrow^{\mathrlap{f}}
                  \\\
                  \\underset{c\in(C/f)}{\coprod} cod(c)
                  \&amp;\longrightarrow&amp;
                  Y
                  }
          %p
            and hence the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is indeed factored through that
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi id
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
