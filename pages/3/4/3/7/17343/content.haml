                    }
            %p
              (for instance: regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              as embedded in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^n
              is identified with the basepoint on the boundary of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              and set
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi κ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta(\vec v,t) \coloneqq \kappa(t \vec v)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              of the top two squares that have appeared this way is equivalent to the following commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
