                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mn 1
                              %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mi Inj
                      %annotation{:encoding => "application/x-tex"} K Inj
                  is closed under forming
                  %a.existingWikiWord{:href => "/nlab/show/products"} products
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mi Δ
