                    \\,.
            %p
              To detect whether this is a homotopy pullback, by def.
              %a.maruku-ref{:href => "#HomotopyPullback"}
              and prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ConditionsForHomotopyPullbackAreIndeedEquivalent"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                        %mtr
