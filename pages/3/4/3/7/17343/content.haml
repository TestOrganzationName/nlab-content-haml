                  %mrow
                    %msub
                      %mi d
                      %mn 2
                    %mo ∘
                    %mi fact
                  %annotation{:encoding => "application/x-tex"} d_2 \circ fact
              lands in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Proj
                  %annotation{:encoding => "application/x-tex"} Proj
