          #JoyalTierneyCalculus.num_prop
            %h6#proposition_28 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} i_1, i_2 , p
              be three morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "." do
                %a.maruku-ref{:href => "#kTop"}
              %a.existingWikiWord{:href => "/nlab/show/pushout-products"} pushout-products
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutProduct"}
              = succeed ")" do
                %a.maruku-ref{:href => "#PullbackPowering"}
              %a.existingWikiWord{:href => "/nlab/show/lifting+properties"} lifting properties
              are equivalent (“
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"}> Joyal-Tierney calculus
              ”):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi i
                              %mn 1
                            %mo □
                            %msub
                              %mi i
                              %mn 2
                          %mtd
                            %mtext has LLP against
                          %mtd
                            %mi p
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %msub
                              %mi i
                              %mn 1
                          %mtd
                            %mtext has LLP against
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo □
                                %msub
                                  %mi i
                                  %mn 2
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %msub
                              %mi i
                              %mn 2
                          %mtd
                            %mtext has LLP against
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo □
                                %msub
                                  %mi i
                                  %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;  i_1 \Box i_2 &amp; \text{has LLP against} &amp; p
                    \\\
                    \\Leftrightarrow &amp; i_1 &amp;  \text{has LLP against} &amp; p^{\Box i_2}
                    \\\
                    \\Leftrightarrow &amp; i_2 &amp;  \text{has LLP against} &amp; p^{\Box i_1}
                    }
                    \\,.
          .proof
            %h6#proof_51 Proof
            %p
              We claim that by the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closure
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
              and their
              %a.existingWikiWord{:href => "/nlab/show/lifts"} lifts
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %msup
                              %mi X
                              %mi B
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mrow
                                      %mo □
                                      %msub
                                        %mi i
                                        %mn 2
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi g
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi g
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi Y
                              %mi B
                            %munder
                              %mo ×
                              %mrow
                                %msup
                                  %mi Y
                                  %mi A
                            %msup
                              %mi X
                              %mi A
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                            %mo ×
                            %mi B
                            %munder
                              %mo ⊔
                              %mrow
                                %mi Q
                                %mo ×
                                %mi A
                            %mi P
                            %mo ×
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                                %mo ,
                                %msub
                                  %mover
                                    %mi g
                                    %mo{:stretchy => "false"} ˜
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                                  %mo □
                                  %msub
                                    %mi i
                                    %mn 2
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi P
                            %mo ×
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi g
                                    %mo{:stretchy => "false"} ˜
                                  %mn 1
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\overset{f}{\longrightarrow}&amp; X^B
                    \\\
                    {}^{\mathllap{i_1}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p^{\Box i_2}}}
                    \\\
                    P &amp;\underset{(g_1,g_2)}{\longrightarrow}&amp; Y^B \underset{Y^A}{\times} X^A
                    }
                    \\;\;\;\;\;\;\;
                    \\leftrightarrow
                    \\;\;\;\;\;\;\;
                    \\array{
                    Q \times B \underset{Q \times A}{\sqcup} P \times A
                    \&amp;\overset{(\tilde f, \tilde g_2)}{\longrightarrow}&amp;
                    X
                    \\\
                    {}^{\mathllap{i_1 \Box i_2}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    P \times B &amp; \underset{\tilde g_1}{\longrightarrow} &amp; Y
                    }
                    \\,,
            %p
              where the tilde denotes product/hom-
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"}> adjuncts
              , for instance
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi P
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi g
                              %mn 1
                        %msup
                          %mi Y
                          %mi B
                      %mrow
                        %mi P
                        %mo ×
                        %mi B
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ˜
                              %mn 1
                        %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    P \overset{g_1}{\longrightarrow} Y^B
                    }{
                    P \times B \overset{\tilde g_1}{\longrightarrow} Y
                    }
            %p etc.
