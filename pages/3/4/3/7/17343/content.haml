                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∪
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo )
                    %mo ↪
                    %mo □
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_1 \Box j_0
                    \\;\colon\;
                    \\left(\;\; = \;\;\cup\;\; \vert \;\; \right)
                    \\hookrightarrow
                    \\Box
                    \\,.
            %p
              Generally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              may be represented as the space of
              = succeed "-tuples" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              as the suspace of tuples for which at least one of the coordinates is equal to 0 or to 1.
            %p
              Accordingly,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ↪
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2} \hookrightarrow D^{n_1 + n_2}
              is the subspace of
              = succeed "-tuples," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_1+n_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} n_1
              coordinates is equal to 0 or 1, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ↪
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{n_1} \times S^{n_2} \hookrightarrow D^{n_1+ n_2}
              is the subspace of
              = succeed "-tuples" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_1 + n_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_2
              coordinates is equal to 0 or to 1. Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ∪
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{n_1} \times D^{n_2} \cup D^{n_1} \times S^{n_2} \simeq S^{n_1 + n_2}
                    \\,.
            %p
              And of course it is clear that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ≃
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2} \simeq D^{n_1 + n_2}
            %p
              For the second, use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2} \times I
              is contractible to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2} \times I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              is a subspace of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2}
          #PullbackPowering.num_defn
            %h6#definition_51 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i \colon A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p \colon X \to Y
              be two morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "." do
                %a.maruku-ref{:href => "#kTop"}
              %strong pullback powering
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo □
                        %mi i
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mi B
                    %mo ,
                    %msup
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p^{\Box i}
                    \\coloneqq
                    (p^B, X^i)
            %p being the universal morphism in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi X
                              %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi p
                                    %mi B
                                  %mo ,
                                  %msup
                                    %mi X
                                    %mi i
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
