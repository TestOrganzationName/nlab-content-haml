            %p is a Quillen adjunction.
          .proof
            %h6#proof_58 Proof
            %p
              Since the fibrations and weak equivalences in the projective model structure (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassesOfMorphismsInTheProjectiveModelStructureOnTopEnrichedFunctors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
              and of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top^{\ast/}_{cg})_{Quillen}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi I
                  %annotation{:encoding => "application/x-tex"} const_I
              preserves these. In particular it preserves fibrations and acyclic fibrations and so the claim follows (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConditionsOnQuillenAdjunctionAreIndeedEquivalent"}
          #LeftDerivedFunctorOfColimitFunctor.num_defn
            %h6#definition_57 Definition
            %p
              In the situation of prop.
              %a.maruku-ref{:href => "#ColimitIsLeftQuillenOfProjectiveModelStructureOnFunctors"}
              we say that the
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              functor is the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hocolim
                      %mi I
                    %mo ≔
                    %mi 𝕃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi I
