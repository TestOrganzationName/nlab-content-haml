                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_1(a) = f(b)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} b = \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \colon A \to Path(Y)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} p_0(a) = \ast
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} p_1(a) = \ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi Y
                      %mo ≔
                      %mo *
                      %munder
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo ×
                        %mi Y
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Omega Y \coloneqq \ast \underset{Y}{\times} Path(Y) \underset{Y}{\times} \ast
            %p
              Now to construct the right vertical morphism in the top square (
              %a{:href => "#Quillen67"}> Quillen 67, page 3.1
              ): Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(Y)
              be any path space object for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(X)
              be given by a factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mo ∘
                    %mi f
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    (id_X, \; i \circ f, \; id_X)
                    \\;\colon\;
                    X
                    \\overset{\in W}{\to}
                    Path(X)
                    \\overset{\in Fib}{\longrightarrow}
                    X \times_Y Path(Y) \times_Y X
            %p
              and regarded as a path space object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by further comoposing with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi pr
                      %mn 1
                    %mo ,
                    %msub
                      %mi pr
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                    %mi X
                    %mo ×
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (pr_1,pr_3)\colon X \times_Y Path(Y) \times_Y X \overset{\in Fib}{\longrightarrow} X \times X
                    \\,.
            %p
              We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Path(X)\to Path(Y) \times_Y X
              is an acyclic fibration.
            %p
              It is a fibration because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\times_Y Path(Y) \times_Y X \to Path(Y)\times_Y X
              is a fibration, this being the pullback of the fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} Y
            %p
              To see that it is also a weak equivalence, first observe that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi W
                          %mo ∩
                          %mi Fib
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Path(Y)\times_Y X \overset{\in W \cap Fib}{\longrightarrow} X
              = succeed "." do
                %a.maruku-ref{:href => "#ComponentMapsOfCylinderAndPathSpaceInGoodSituation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi i
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                    %munder
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    id_X
                    \\;\colon\;
                    X
                    \\underoverset{\in W}{i}{\longrightarrow}
                    Path(X)
                    \\overset{}{\longrightarrow}
                    Path(Y)\times_Y X
                    \\underset{\in W \cap Fib}{\longrightarrow}
                    X
            %p
              and so finally the claim follows by
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
          #HomotopyCommutativeSquares.num_remark
            %h6#remark_32 Remark
            %p
              There is a conceptual way to understand prop.
              %a.maruku-ref{:href => "#HomotopyFiberOfHomotopyFiberIsLooping"}
              as follows: If we draw double arrows to indicate
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyFiber"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    hofib(f) &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    X &amp;\underset{f}{\longrightarrow}&amp; Y
                    }
            %p
              just like the ordinary
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberAndCofiberInPointedObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi fib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    fib(f) &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\underset{f}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              One may show that just like the fiber is the
              %em universal
              solution to making such a commuting square (a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit cone
              def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LimitsAndColimits"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit cone
            %p
              Now just like ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              satisfy the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              saying that attaching two pullback squares gives a pullback rectangle, the analogue is true for homotopy pullbacks. This implies that if we take the homotopy fiber of a homotopy fiber, thereby producing this double homotopy pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    hofib(g) &amp;\longrightarrow&amp; hofib(f) &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{g}} &amp;\swArrow&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; X &amp;\underset{f}{\longrightarrow}&amp; Y
                    }
            %p
              then the total outer rectangle here is itself a homotopy pullback. But the outer rectangle exhibits the homotopy fiber of the point inclusion, which, via def.
              %a.maruku-ref{:href => "#SuspensionAndLoopSpaceObject"}
              and lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FactorizationLemma"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ω
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega Y &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; Y
                    }
                    \\,.
          #LongFiberSequence.num_prop
            %h6#proposition_48 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a model category and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              be morphism in the pointed homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C}^{\ast/})
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
            %ol
              %li
                %p
                  There is a long sequence to the left in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo ⟶
                        %mi Ω
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mover
                              %mi Ω
                              %mo ¯
                            %mi f
                        %mi Ω
                        %mi Y
                        %mo ⟶
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi X
                        %mover
                          %mo ⟶
                          %mi f
                        %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\cdots
                        \\longrightarrow
                        \\Omega X
                        \\overset{\overline{\Omega} f}{\longrightarrow}
                        \\Omega Y
                        \\longrightarrow
                        hofib(f)
                        \\longrightarrow
                        X
                        \\overset{f}{\longrightarrow}
                        Y
                        \\,,
                %p
                  where each morphism is the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#HomotopyFiber"}
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Ω
                          %mo ¯
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \overline{\Omega}f
                  denotes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \Omega f
                  followed by forming inverses with respect to the group structure on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega(-)
                  from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LoopingAsFunctorOnHomotopyCategory"}
                %p
                  Moreover, for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} A\in \mathcal{C}^{\ast/}
                  any object, then there is a
                  %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %msup
                          %mi Ω
                          %mn 2
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi Ω
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi Ω
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi Ω
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"}
                        \\cdots
                        \\to
                        [A,\Omega^2 Y]_\ast
                        \\longrightarrow
                        [A,\Omega hofib(f)]_\ast
                        \\longrightarrow
                        [A, \Omega X]_\ast
                        \\longrightarrow
                        [A,\Omega Y]
                        \\longrightarrow
                        [A,hofib(f)]_\ast
                        \\longrightarrow
                        [A,X]_\ast
                        \\longrightarrow
                        [A,Y]_\ast
                %p
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"} [-,-]_\ast
                  denotes the pointed set valued hom-functor of example
                  = succeed "." do
                    %a.maruku-ref{:href => "#HomotopyCategoryOfPointedModelStructureIsEnrichedInPointedSets"}
              %li
                %p
                  Dually, there is a long sequence to the right in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo ⟶
                          %mi f
                        %mi Y
                        %mover
                          %mo ⟶
                          %mrow
                        %mi hocofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Σ
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mover
                              %mi Σ
                              %mo ¯
                            %mi f
                        %mi Σ
                        %mi Y
                        %mo →
                        %mi ⋯
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        X
                        \\overset{f}{\longrightarrow}
                        Y
                        \\overset{}{\longrightarrow}
                        hocofib(f)
                        \\longrightarrow
                        \\Sigma X
                        \\overset{\overline{\Sigma} f}{\longrightarrow}
                        \\Sigma Y
                        \\to \cdots
                        \\,,
                %p
                  where each morphism is the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#HomotopyFiber"}
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} A\in \mathcal{C}^{\ast/}
                  any object, then there is a
                  %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo →
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Σ
                          %mn 2
                        %mi X
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mi hocofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mi Y
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} ]
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi hocofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi Y
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"}
                        \\cdots
                        \\to
                        [\Sigma^2 X, A]_\ast
                        \\longrightarrow
                        [\Sigma hocofib(f), A]_\ast
                        \\longrightarrow
                        [\Sigma Y, A]_\ast
                        \\longrightarrow
                        [\Sigma X, A]
                        \\longrightarrow
                        [hocofib(f),A]_\ast
                        \\longrightarrow
                        [Y,A]_\ast
                        \\longrightarrow
                        [X,A]_\ast
                %p
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"} [-,-]_\ast
                  denotes the pointed set valued hom-functor of example
                  = succeed "." do
                    %a.maruku-ref{:href => "#HomotopyCategoryOfPointedModelStructureIsEnrichedInPointedSets"}
          %p
            (
            %a{:href => "#Quillen67"}> Quillen 67, I.3, prop. 4
            )
          .proof
            %h6#proof_77 Proof
            %p
              That there are long sequences of this form is the result of combining prop.
              %a.maruku-ref{:href => "#HomotopyFiberOfHomotopyFiberIsLooping"}
              and prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ExactSequenceOfHomotopyFiberAtOneStage"}
            %p
              It only remains to see that it is indeed the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Ω
                      %mo ¯
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \overline{\Omega} f
              that appear, as indicated.
            %p
              In order to see this, it is convenient to adopt the following notation: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              a morphism, then we denote the collection of
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
              of its homotopy fiber as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⇝
                        %mrow
                          %msub
                            %mi γ
                            %mn 1
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    hofib(f)
                    \=
                    \\left\{
                    (x, f(x) \overset{\gamma_1}{\rightsquigarrow} \ast)
                    \\right\}
            %p
              indicating that these elements are pairs consisting of an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and a “path” (an element of the given path space object) from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              to the basepoint.
            %p
              This way the canonical map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} hofib(f) \to X
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⇝
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi x
                    %annotation{:encoding => "application/x-tex"} (x, f(x) \rightsquigarrow \ast) \mapsto x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⇝
                        %mrow
                          %msub
                            %mi γ
                            %mn 1
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mover
                        %mo ⇝
                        %mrow
                          %msub
                            %mi γ
                            %mn 2
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hofib(hofib(f))
                    \=
                    \\left\{
                    ( (x, f(x) \overset{\gamma_1}{\rightsquigarrow} \ast),
                    x \overset{\gamma_2}{\rightsquigarrow} \ast  )
                    \\right\}
                    \\,.
            %p
              This identifies with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \Omega Y
              by forming the loops
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo ⋅
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %msub
                          %mi γ
                          %mn 2
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma_1 \cdot f(\overline{\gamma_2})
                    \\,,
            %p where the overline denotes reversal and the dot denotes concatenation.
            %p Then consider the next homotopy fiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⇝
                          %mrow
                            %msub
                              %mi γ
                              %mn 1
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi x
                        %mover
                          %mo ⇝
                          %mrow
                            %msub
                              %mi γ
                              %mn 2
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi x
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⇝
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mn 3
                                %mtd
                                %mtd
                                  %mo *
                              %mtr
                                %mtd
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⇝
                                    %mrow
                                      %mi f
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi γ
                                        %mn 3
                                      %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %mo *
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi γ
                                          %mn 1
                                  %mo ↘
                                %mtd
                                  %mo ⇒
                                %mtd
                                  %msub
                                    %mo ↙
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mo *
                          %mo )
                        %mo )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    hofib(hofib(hofib(f)))
                    \=
                    \\left\{
                    \\left(
                    ( (x, f(x) \overset{\gamma_1}{\rightsquigarrow} \ast), x \overset{\gamma_2}{\rightsquigarrow} \ast  ),
                    \\left(
                    \\array{
                    x &amp;&amp; \overset{\gamma_3}{\rightsquigarrow} &amp;&amp; \ast
                    \\\
                    f(x) &amp;&amp;\overset{f(\gamma_3)}{\rightsquigarrow}&amp;&amp; \ast
                    \\\
                    \&amp; {}_{\mathllap{\gamma_1}}\searrow &amp; \Rightarrow &amp; \swarrow_{\mathllap{}}
                    \\\
                    \&amp;&amp; \ast
                    }
                    \\right)
                    \\right)
                    \\right\}
                    \\,,
            %p
              where on the right we have a path in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hofib(f)
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⇝
                      %mrow
                        %msub
                          %mi γ
                          %mn 1
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, f(x)\overset{\gamma_1}{\rightsquigarrow} \ast)
              to the basepoint element. This is a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \gamma_3
              together with a path-of-paths which connects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi γ
                        %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\gamma_3)
            %p
              By the above convention this is identified with the loop in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 2
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi γ
                        %mo ¯
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma_2 \cdot (\overline{\gamma}_3)
                    \\,.
            %p
              But the map to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hofib(hofib(f))
              sends this data to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⇝
                        %mrow
                          %msub
                            %mi γ
                            %mn 1
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mover
                        %mo ⇝
                        %mrow
                          %msub
                            %mi γ
                            %mn 2
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (x, f(x) \overset{\gamma_1}{\rightsquigarrow} \ast), x \overset{\gamma_2}{\rightsquigarrow} \ast  )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi γ
                              %mn 1
                            %mo ⋅
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mover
                              %mrow
                                %msub
                                  %mi γ
                                  %mn 2
                              %mo ¯
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi γ
                              %mn 3
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mover
                              %mrow
                                %msub
                                  %mi γ
                                  %mn 2
                              %mo ¯
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi γ
                              %mn 3
                            %mo ⋅
                            %mover
                              %mrow
                                %msub
                                  %mi γ
                                  %mn 2
                              %mo ¯
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mover
                              %mrow
                                %msub
                                  %mi γ
                                  %mn 2
                                %mo ⋅
                                %msub
                                  %mover
                                    %mi γ
                                    %mo ¯
                                  %mn 3
                              %mo ¯
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi γ
                                  %mn 2
                                %mo ⋅
                                %msub
                                  %mover
                                    %mi γ
                                    %mo ¯
                                  %mn 3
                                %mo{:stretchy => "false"} )
                              %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\gamma_1 \cdot f( \overline{\gamma_2} )
                    \&amp; \simeq
                    f(\gamma_3) \cdot f(\overline{\gamma_2})
                    \\\
                    \&amp; =
                    f( \gamma_3 \cdot \overline{\gamma_2} )
                    \\\
                    \&amp; =
                    f ( \overline{\gamma_2 \cdot \overline{\gamma}_3} )
                    \\\
                    \&amp; =
                    \\overline{f(\gamma_2 \cdot \overline{\gamma}_3) }
                    \\end{aligned}
                    \\,,
            %p
              hence to the reveral of the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of the loop in
              = succeed "." do
