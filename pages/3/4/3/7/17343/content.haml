                        %mi max
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\beta_{max}, U_{max})
            %p
              Hence it is now sufficient to show that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
