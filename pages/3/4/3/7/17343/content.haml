          #SmashProductOnTopNotAssociative.num_remark
            %h6#remark_18 Remark
            %p
              For a general category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
