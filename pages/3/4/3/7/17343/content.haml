                    \\,.
          %h3#cell_complexes Cell complexes
          %p
            We consider topological spaces that are built consecutively by
            %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
            basic cells.
          #TopologicalGeneratingCofibrations.num_defn
            %h6#definition_13 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                    %mo ≔
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mover
