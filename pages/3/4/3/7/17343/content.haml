                        %mi β
                        %mi s
                      %mo ,
                      %msub
                        %mo ∪
                        %mi s
                      %msub
                        %mi U
                        %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ({\cup}_s \beta_s ,\cup_s U_s)
              %a.existingWikiWord{:href => "/nlab/show/Zorn%27s+lemma"} Zorn's lemma
              applies, saying that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo &lt;
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T,\lt)
              contains a
              %a.existingWikiWord{:href => "/nlab/show/maximal+element"} maximal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
