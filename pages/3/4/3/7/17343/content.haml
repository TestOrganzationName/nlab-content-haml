            %p Dually:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              = succeed "." do
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              the
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocylinder"} mapping cocylinder
              %a.maruku-ref{:href => "#ConeAndMappingCylinder"}
              provides a fibration resolution of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %ol
              %li
                %p
                  the composite morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Path
