                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma\;\colon\; \mathcal{C} \longrightarrow Ho(\mathcal{C})
              from def.
              %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              (using remark
              = succeed ")" do
                %a.maruku-ref{:href => "#EssentialUniquenessOfLocalizationFunctorOfModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              of def.
              %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
