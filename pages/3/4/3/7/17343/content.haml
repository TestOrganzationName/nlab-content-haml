                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thickmathspace"}
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T
                    \\coloneqq
                    \\left\{
                    \\;
                    (\beta, U)
                    \\;|\;
                    \\alpha_c \leq \beta \leq \gamma
                    \\;\,,\;
                    U \underset{open}{\subset} Y_\beta
                    \\;\,,\;
                    U \cap Y_\alpha = U_c
                    \\;\,,\;
                    U \cap P \in \{ \emptyset, \{c\} \}
                    \\;
                    \\right\}
                    \\,,
            %p
              and regard this as a
              %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
              by declaring a partial ordering via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi β
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi β
                      %mn 2
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
