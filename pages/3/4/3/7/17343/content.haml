                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi I
                        %mover
                          %mo ⟵
                          %mrow
                            %msub
                              %mi const
                              %mi I
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      [I,\mathcal{C}]
                      \\underoverset
                      {\underset{\underset{\longleftarrow}{\lim}_I}{\longrightarrow}}
                      {\overset{const_I}{\longleftarrow}}
                      {\bot}
                      \\mathcal{C}
          #ColimitIsLeftQuillenOfProjectiveModelStructureOnFunctors.num_prop
            %h6#proposition_34 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %munder
                          %mi lim
                          %mo ⟶
                        %mi I
                      %mo ⊣
                      %msub
                        %mi const
                        %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\underset{\longrightarrow}{\lim}_I \dashv const_I)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mrow
                          %msub
                            %mi const
                            %mi I
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %munder
                              %mi lim
                              %mo ⟶
                            %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    [I,(Top_{cg})_{Quillen}]_{proj}
                    \\underoverset
                    {\underset{const_I}{\longleftarrow}}
                    {\overset{\underset{\longrightarrow}{\lim}_I}{\longrightarrow}}
                    {\bot}
                    (Top_{cg})_{Quillen}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+enriched+functors"} projective model structure on topological functors
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveModelStructureOnTopologicalFunctors"}
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              from theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}
            %p
              Similarly, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              (prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
              = succeed ")" do
                %a.maruku-ref{:href => "#CofibrantGenerationOfPointedTopologicalSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mi const
                      %mover
                        %mo ⟶
                        %munder
                          %mi lim
                          %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    [I,(Top^{\ast/}_{cg})_{Quillen}]_{proj}
                    \\underoverset
                    {\underset{const}{\longleftarrow}}
