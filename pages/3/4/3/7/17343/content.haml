                                %mo ,
                                %mi P
                                %mo{:stretchy => "false"} (
                                %mi Q
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:stretchy => "false"} )
