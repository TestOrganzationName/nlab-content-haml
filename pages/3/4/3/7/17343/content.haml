          #QuillenWeakEquivalencesSatisfyTwoOutOfThree.num_prop
            %h6#proposition_15 Proposition
            %p
              The classical weak equivalences, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
          .proof
            %h6#proof_29 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "." do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
          #FactorizationInTopQuillen.num_lemma
            %h6#lemma_15 Lemma
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              factors as a classical cofibration followed by an acyclic classical fibration, def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi Cof
                          %mi cl
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
