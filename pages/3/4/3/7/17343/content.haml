              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat X \to Y
              is both a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              as well as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
          #ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration.num_lemma
            %h6#lemma_16 Lemma
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              factors as an acyclic classical cofibration followed by a fibration, def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                        %mo ∩
                        %msub
                          %mi Cof
                          %mi cl
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi Fib
                          %mi cl
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in W_{cl} \cap Cof_{cl}}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in Fib_{cl}}{\longrightarrow}
                    Y
                    \\,.
          .proof
            %h6#proof_31 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi D
                      %mi n
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} J_{Top} = \{D^n \hookrightarrow D^n\times I\}
              of topological
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generating+acyclic+cofibrations"} generating acyclic cofibrations
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
              (the
              %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              = succeed "," do
                %a.maruku-ref{:href => "#SmallObjectArgument"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalCCellComplex"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi top
                    %annotation{:encoding => "application/x-tex"} J_{top}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
              = succeed ":" do
                %a.maruku-ref{:href => "#RightLiftingProperty"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Cell
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Inj
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in J_{Top} Cell}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in J_{Top} Inj}{\longrightarrow}
                    Y
                    \\,.
            %p
              By definition this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat X \to Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            %p
              By lemma
              %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
              a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} X \to \hat X
              is a classical cofibration. By lemma
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              it is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          #LiftingPropertyInTheClassicalModelStructureOnTopologicalSpaces.num_lemma
            %h6#lemma_17 Lemma
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              with the left morphism a classical cofibration and the right morphism a fibration, def.
              %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi g
                                      %mo ∈
                                  %mrow
                                    %mrow
                                      %msub
                                        %mi Cof
                                        %mi cl
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi f
                                      %mo ∈
                                  %mrow
                                    %msub
                                      %mi Fib
                                      %mi cl
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\longrightarrow&amp;
                    \\\
                    {}^{\mathllap{{g \in} \atop {Cof_{cl}}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{{f \in }\atop Fib_{cl}}}
                    \\\
                    \&amp;\longrightarrow&amp;
                    }
            %p
              admits a
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              as soon as one of the two is also a classical weak equivalence.
          .proof
            %h6#proof_32 Proof
            %p
              %strong A)
              If the fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is also a weak equivalence, then lemma
              %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              says that it has the right lifting property against the generating cofibrations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
              implies the claim.
            %p
              %strong B)
              If the cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              on the left is also a weak equivalence, consider any factorization into a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalCCellComplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Cell
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi Fib
                          %mi cl
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    g \;\colon\; \stackrel{\in J_{Top} Cell}{\longrightarrow} \stackrel{\in Fib_{cl}}{\longrightarrow}
                    \\,,
            %p
              as in the proof of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration"}
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Cell
                  %annotation{:encoding => "application/x-tex"} \overset{\in J_{Top} Cell}{\longrightarrow}
              is a weak homotopy equivalence, and so by
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenWeakEquivalencesSatisfyTwoOutOfThree"}
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against the cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              itself, and so the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              %a.maruku-ref{:href => "#RetractArgument"}
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p Finally:
          #LiftingExhausted.num_prop
            %h6#proposition_16 Proposition
            %p
              The systems
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cof
                      %mi cl
                    %mo ,
                    %msub
                      %mi W
                      %mi cl
                    %mo ∩
                    %msub
                      %mi Fib
                      %mi cl
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cof_{cl} , W_{cl} \cap Fib_{cl})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi cl
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi cl
                    %mo ,
                    %msub
                      %mi Fib
                      %mi cl
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_{cl} \cap Cof_{cl}, Fib_{cl})
              from def.
              %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
          .proof
            %h6#proof_33 Proof
            %p
              Since we have already seen the factorization property (lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FactorizationInTopQuillen"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration"}
              = succeed ")," do
                %a.maruku-ref{:href => "#LiftingPropertyInTheClassicalModelStructureOnTopologicalSpaces"}
            %p
              For the classical fibrations this is by definition, for the the classical acyclic fibrations this is by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
            %p
              The remaining statement for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi cl
                  %annotation{:encoding => "application/x-tex"} Cof_{cl}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi cl
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi cl
                  %annotation{:encoding => "application/x-tex"} W_{cl}\cap Cof_{cl}
              follows from a general argument (
              %a{:href => "cofibrantly+generated+model+category#RetractsOfCellComplexesExchaustLLPOfRLP"}> here
              ) for
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+categories"} cofibrantly generated model categories
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mi Top
                      %mi Inj
                      %mo{:stretchy => "false"} )
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} (I_{Top} Inj) Proj
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a retract (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#RetractsOfMorphisms"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              %a.existingWikiWord{:href => "/nlab/show/small+object"} small object
              argument as in lemma
              %a.maruku-ref{:href => "#FactorizationInTopQuillen"}
              to factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                        %mi Cell
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi I
                          %mi Top
                        %mi Inj
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon \; X \overset{I_{Top} Cell}{\longrightarrow} \hat Y \overset{\in I_{Top} Inj}{\longrightarrow} Y
                    \\,.
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              against
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Y
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat Y \to Y
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#RetractArgument"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mrow
                          %mi I
                          %mi Cell
                      %mover
                        %mi Y
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} X \overset{I Cell}{\to} \hat Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cof
                        %mi cl
                    %annotation{:encoding => "application/x-tex"} Cof_{cl}
            %p
              The analogous argument for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi cl
                      %mo ∩
                      %msub
                        %mi Cof
                        %mi cl
                    %annotation{:encoding => "application/x-tex"} W_{cl} \cap Cof_{cl}
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi J
                      %mi Top
                    %mi Inj
                    %mo{:stretchy => "false"} )
                    %mi Proj
                  %annotation{:encoding => "application/x-tex"} f \in (J_{Top} Inj) Proj
              is a retract of a
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
              and lemma
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              a
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              = succeed "." do
                %a.maruku-ref{:href => "#RetractPreservesIsomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an acyclic cofibration.
          %p
            In conclusion, prop.
            %a.maruku-ref{:href => "#QuillenWeakEquivalencesSatisfyTwoOutOfThree"}
            and prop.
            %a.maruku-ref{:href => "#LiftingExhausted"}
            say that:
          #TopQuillenModelStructure.num_theorem
            %h6#theorem_2 Theorem
            %p
              The classes of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor(Top)
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi cl
                        %mo =
                      %annotation{:encoding => "application/x-tex"} W_{cl} =
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi cl
                        %mo =
                      %annotation{:encoding => "application/x-tex"} Fib_{cl} =
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cof
                          %mi cl
                        %mo =
                      %annotation{:encoding => "application/x-tex"} Cof_{cl} =
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  of
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
            %p
              define a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategory"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              or
              %strong Serre-Quillen model structure
              \.
          %p In particular
          %ol
            %li
              %p
                every object in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                is fibrant;
            %li
              %p
                the cofibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                are the
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
          %p Hence in particular the following classical statement is an immediate corollary:
          #WhiteheadTheorem.num_cor
            %h6#corollary_4 Corollary
            %p
              %strong (Whitehead theorem)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              that are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
          .proof
            %h6#proof_34 Proof
            %p
              This is the “Whitehead theorem in model categories”, lemma
              = succeed "," do
                %a.maruku-ref{:href => "#WhiteheadTheoremInModelCategories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              via theorem
              = succeed "." do
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
          %p
            In proving theorem
            %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            we have in fact shown a bit more that stated. Looking back, all the structure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} Top_{Quillen}
            is entirely induced by the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi Top
                %annotation{:encoding => "application/x-tex"} I_{Top}
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi Top
                %annotation{:encoding => "application/x-tex"} J_{Top}
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
            (def.
            = succeed ")," do
              %a.maruku-ref{:href => "#ClassicalModelStructureOnPointedTopologicalSpaces"}
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+enriched+functors"} projective model structure on topological functors
            (thm.
            = succeed ")," do
              %a.maruku-ref{:href => "#ProjectiveModelStructureOnTopologicalFunctors"}
            %a.existingWikiWord{:href => "/nlab/show/model+structures+on+spectra"} model structures on spectra
            which we turn to in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} section on stable homotopy theory
          %p Therefore we make this situation explicit:
          #CofibrantlyGeneratedModelCategory.num_defn
            %h6#definition_38 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategory"}
              %strong cofibrantly generated
              if there exists two subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi J
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    I, J \subset Mor(\mathcal{C})
            %p of its class of morphisms, such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  have small domains according to def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
              %li
                %p
                  the (acyclic) cofibrations of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  are precisely the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  \-relative cell complexes), def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#TopologicalCCellComplex"}
          #CofibrantlyGeneratedModelCategoryLifting.num_prop
            %h6#proposition_17 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a cofibrantly generated model category, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              ), then its classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ,
                    %mi Fib
                    %mo ,
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} W, Fib, Cof
              of weak equivalences, fibrations and cofibrations are equivalently expressed as
              %a.existingWikiWord{:href => "/nlab/show/injective+or+projective+morphisms"} injective or projective morphisms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LiftingAndExtension"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cof
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mi Inj
                        %mo{:stretchy => "false"} )
                        %mi Proj
                      %annotation{:encoding => "application/x-tex"} Cof = (I Inj) Proj
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi W
                        %mo ∩
                        %mi Fib
                        %mo =
                        %mi I
                        %mi Inj
                      %annotation{:encoding => "application/x-tex"} W \cap Fib = I Inj
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi W
                        %mo ∩
                        %mi Cof
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mi Inj
                        %mo{:stretchy => "false"} )
                        %mi Proj
                      %annotation{:encoding => "application/x-tex"} W \cap Cof = (J Inj) Proj
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Fib
                        %mo =
                        %mi J
                        %mi Inj
                      %annotation{:encoding => "application/x-tex"} Fib = J Inj
                  ;
          .proof
            %h6#proof_35 Proof
            %p
              It is clear from the definition that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mi Inj
                      %mo{:stretchy => "false"} )
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} I \subset (I Inj) Proj
              %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
              gives an inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cof
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mi Inj
                    %mo{:stretchy => "false"} )
                    %mi Proj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cof \subset (I Inj) Proj
                    \\,.
            %p
              For the converse inclusion, let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mi Inj
                      %mo{:stretchy => "false"} )
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} f \in (I Inj) Proj
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              = succeed "," do
                %a.maruku-ref{:href => "#SmallObjectArgument"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi I
                          %mi Cell
                      %mover
                        %mo ⟶
                        %mrow
                          %mi I
                          %mi Inj
                    %annotation{:encoding => "application/x-tex"} f\colon \overset{\in I Cell}{\longrightarrow}\overset{I Inj}{\longrightarrow}
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              lemma
              = succeed "," do
                %a.maruku-ref{:href => "#RetractArgument"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a retract of an
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cof
                    %annotation{:encoding => "application/x-tex"} Cof
            %p
              This proves the first statement. Together with the closure properties of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
            %p
              The proof of the third and fourth item is directly analogous, just with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              replaced for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
          %h3#TheClassicalHomotopyCategory The classical homotopy category
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            in hand, we now have good control over the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
          #ClassicalHomotopyCategory.num_defn
            %h6#definition_39 Definition
            %p
              The
              %strong
                Serre-Quillen
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              from theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho(Top) \coloneqq Ho(Top_{Quillen})
                    \\,.
          #EveryTopologicalSpaceWeaklyEquivalentToACWComplex.num_remark
            %h6#remark_16 Remark
            %p
              From just theorem
              = succeed "," do
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassicalHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mrow
                        %mi Retract
                        %mo{:stretchy => "false"} (
                        %mi Cell
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Ho(Top_{Quillen}) \simeq (Top_{Retract(Cell)})/_\sim
            %p
              is the category whose objects are
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              of
              %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              Theorem
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              in itself implies that every topological space is weakly equivalent to a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW+approximations"} CW approximations
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
            %p
              (Better yet, there is
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              to the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              which implies a
              %em functorial
              %a.existingWikiWord{:href => "/nlab/show/CW+approximation"} CW approximation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Sing
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mi X
                  %annotation{:encoding => "application/x-tex"} {\vert Sing X\vert} \overset{\in W_{cl}}{\longrightarrow} X
              given by forming the
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              of
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Hence the Serre-Quillen
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              is also equivalently the category of just the
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              whith
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              between them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi Quillen
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mrow
                                %mi Retract
                                %mo{:stretchy => "false"} (
                                %mi Cell
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} /
                              %mo ∼
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Top
                              %mi CW
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} /
                              %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Ho(Top_{Quillen}) &amp; \simeq (Top_{Retract(Cell)})/_\sim
                    \\\
                    \&amp; \simeq (Top_{CW})/_{\sim}
                    \\end{aligned}
                    \\,.
            %p
              It follows that the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the homotopy category (theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Top
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi cl
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Ho(Top_{Quillen}) \simeq Top[W_{cl}^{-1}]
            %p
              implies that there is a bijection, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %ol
              %li
                %p
                  functors out of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi CW
                      %annotation{:encoding => "application/x-tex"} Top_{CW}
                  which agree on homotopy-equivalent maps;
              %li
                %p
                  functors out of all of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                  which send weak homotopy equivalences to isomorphisms.
            %p
              This statement in particular serves to show that two different axiomatizations of
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
              theories are equivalent to each other. See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} Introduction to Stable homotopy theory – S
              the section
              %em
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#GeneralizedHomologyAndCohomologyFunctors"} generalized cohomology functors
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#HomotopyTheoreticVersionOfCohomologyFunctorDefIsEquivalent"}> this prop.
              )
            %p
              %strong Beware
              that, by remark
              = succeed "," do
                %a.maruku-ref{:href => "#NotEveryHomotopyEquivalenceIsAWeakHomotopyEquivalence"}
              %strong not
              equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Top_{Quillen})
              is the category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hTop
                    %mo ≔
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    hTop \coloneqq Top/_\sim
            %p
              obtained from
              %em all
              topological spaces with morphisms the homotopy classes of continuous functions. This category is “too large”, the correct homotopy category is just the genuine
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mrow
                        %mi Retract
                        %mo{:stretchy => "false"} (
                        %mi Cell
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ↪
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ≃
                    %mi hTop
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho(Top_{Quillen})
                    \\simeq
                    (Top_{Retract(Cell)})/_\sim
                    \\hookrightarrow
                    Top/_\sim
                    \\simeq hTop
                    \\,.
            %p
              Beware also the ambiguity of terminology: “classical homotopy category” some literature refers to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hTop
                  %annotation{:encoding => "application/x-tex"} hTop
              instead of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Top_{Quillen})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hTop
                  %annotation{:encoding => "application/x-tex"} hTop
              and will not mention it again.
          #TopologicalCylinderOnCWComplexIsGoodCylinderObject.num_prop
            %h6#proposition_18 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              %a.maruku-ref{:href => "#TopologicalInterval"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mi I
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \sqcup X
                    \\overset{(i_0,i_1)}{\longrightarrow}
                    X\times I
                    \\longrightarrow
                    X
            %p
              (obtained by forming the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              with the standard
              %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} I = [0,1]
              %em
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              in the abstract sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
          .proof
            %h6#proof_36 Proof
            %p
              We describe the proof informally. It is immediate how to turn this into a formal proof, but the notation becomes tedious. (One place where it is spelled out completely is
              = succeed ".)" do
                %a{:href => "cylinder+object#Ottina14"} Ottina 14, prop. 2.9
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \to X_1 \to X_2\to \cdots \to X
              be a presentation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a CW-complex. Proceed by induction on the cell dimension.
            %p
              First observe that the cylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X_0 \times I
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              is a cell complex: First
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              itself is a disjoint union of points. Adding a second copy for every point (i.e.
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
              along
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo →
                      %msup
                        %mi D
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S^{-1}\to D^0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo ⊔
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X_0 \sqcup X_0
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 0
                      %mo →
                      %msup
                        %mi D
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^0 \to D^1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} X_0 \times I
            %p
              So assume that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              it has been shown that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X_n \times I
              has the structure of a CW-complex of dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{n+1}
              %em twice
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} X_n \times I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} X_n \times \{0\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} X_n \times \{1\}
            %p
              The result is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{n+1}
              with a
              %em hollow cylinder
              erected over each of its
              = succeed "-cells." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msup
                        %mi D
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{n+1} \to D^{n+1}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} X_{n+1}\times I
            %p
              This completes the induction, hence the proof of the CW-structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} X\times I
            %p
              The construction also manifestly exhibits the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \sqcup X \overset{(i_0,i_1)}{\longrightarrow}
              as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
            %p
              Finally, it is clear (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalHomotopyEquivalencesAreWeakHomotopyEquivalences"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times I \to X
              is a weak homotopy equivalence.
          %p Conversely:
          #TopologicalPathSpaceIsGoodPathSpaceObject.num_prop
            %h6#proposition_19 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalPathSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msup
                      %mi X
                      %mi I
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi δ
                              %mn 0
                        %mo ,
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi δ
                              %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\longrightarrow
                    X^I
                    \\overset{(X^{\delta_0}, X^{\delta_1})}{\longrightarrow}
                    X \times X
            %p
              (obtained by forming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              = succeed "," do
                %a.maruku-ref{:href => "#CompactOpenTopology"}
              %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} I = [0,1]
              %em
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              in the abstract sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
          .proof
            %h6#proof_37 Proof
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msup
                      %mi X
                      %mi I
                  %annotation{:encoding => "application/x-tex"} const \colon X\to X^I
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              it is sufficient, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalHomotopyEquivalencesAreWeakHomotopyEquivalences"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %msub
                            %mi δ
                            %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi X
                        %mi I
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X^{\delta_0} \colon X^I \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi const
                    %msup
                      %mi X
                      %mi I
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi δ
                              %mn 0
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \overset{const}{\longrightarrow} X^I \overset{X^{\delta_0}}{\longrightarrow} X
            %p is already equal to the identity. The other we round, the rescaling of paths provides the required homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi I
                            %mo ×
                            %msup
                              %mi X
                              %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi t
                                %mo ,
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mo ↦
                                %mi γ
                                %mo{:stretchy => "false"} (
                                %mi t
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi X
                              %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    I \times X^I &amp;\overset{(t,\gamma)\mapsto \gamma(t\cdot(-))}{\longrightarrow}&amp;
                    X^I
                    }
                    \\,.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi I
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^I \to X\times X
              is a fibration, we need to show that every commuting square of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi X
                              %mi I
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo ×
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^n &amp;\longrightarrow&amp; X^I
                    \\\
                    {}^{\mathllap{i_0}}\downarrow &amp;&amp; \downarrow^{}
                    \\\
                    D^n \times I &amp;\longrightarrow&amp; X \times X
                    }
            %p has a lift.
            %p
              Now first use the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                  %annotation{:encoding => "application/x-tex"} (I \times (-))\dashv (-)^I
              from prop.
              %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
              to rewrite this equivalently as the following commuting square:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ⊔
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi i
                                  %mn 0
                                %mo ,
                                %msub
                                  %mi i
                                  %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ⊔
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi i
                                    %mn 0
                                  %mo ,
                                  %msub
                                    %mi i
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^n \sqcup D^n
                    \&amp;\overset{(i_0, i_0)}{\longrightarrow}&amp;
                    (D^n \times I) \sqcup (D^n \times I)
                    \\\
                    {}^{\mathllap{(i_0, i_1)}}\downarrow &amp;&amp; \downarrow
                    \\\
                    D^n \times I &amp;\longrightarrow&amp; X
                    }
                    \\,.
            %p
              This square is equivalently (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %munder
                      %mo ⊔
                      %mrow
                        %msup
                          %mi D
                          %mi n
                        %mo ⊔
                        %msup
                          %mi D
                          %mi n
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ⊔
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⟶
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D^n \times I
                    \\underset{D^n \sqcup D^n }{\sqcup}
                    \\left((D^n \times I) \sqcup (D^n \times I)\right)
                    \\longrightarrow
                    X
                    \\,.
            %p By the same reasoning, a lift in the original diagram is now equivalently a lifting in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                            %munder
                              %mo ⊔
                              %mrow
                                %msup
                                  %mi D
                                  %mi n
                                %mo ⊔
                                %msup
                                  %mi D
                                  %mi n
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo ⊔
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^n \times I
                    \\underset{D^n \sqcup D^n }{\sqcup}
                    \\left((D^n \times I) \sqcup (D^n \times I)\right)
                    \&amp;\longrightarrow&amp;
                    X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    (D^n \times I)\times I &amp;\longrightarrow&amp; \ast
                    }
                    \\,.
            %p
              Inspection of the component maps shows that the left vertical morphism here is the inclusion into the square times
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              of three of its faces times
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} D^{n+1} \to D^{n+1} \times I
              (as in remark
              = succeed ")." do
                %a.maruku-ref{:href => "#SerreFibrationsByLiftingAgainstMapsHomeomorphicToDiskInclusions"}
          %h3#ModelstructureOnPointedTopologicalSpaces Model structure on pointed spaces
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,x)
            is of course an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,x) \longrightarrow (Y,y)
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \longrightarrow Y
            that takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
          %p
            Passing to pointed objects is also the first step in linearizing classical homotopy theory to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} section on stable homotopy theory
          #SliceCategory.num_defn
            %h6#definition_40 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              is the category whose
            %ul
              %li
                %p
                  objects are morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi X
                      %annotation{:encoding => "application/x-tex"} \array{A \\ \downarrow \\ X}
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  morphisms are
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                              %mtd
                                %mo ⟶
                              %mtd
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mrow
                                %mo ↘
                              %mtd
                              %mtd
                                %mo ↙
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi X
                      %annotation{:encoding => "application/x-tex"} \array{ A &amp;&amp; \longrightarrow &amp;&amp; B \\ &amp; {}_{}\searrow &amp;&amp; \swarrow \\ &amp;&amp; X}
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Dually, the
              %em
                %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
              is the category whose
            %ul
              %li
                %p
                  objects are morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi A
                      %annotation{:encoding => "application/x-tex"} \array{X \\ \downarrow \\ A}
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  morphisms are
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                              %mtd
                                %mo ⟶
                              %mtd
                              %mtd
                                %mi B
                      %annotation{:encoding => "application/x-tex"} \array{ &amp;&amp; X \\ &amp; \swarrow &amp;&amp; \searrow \\ A &amp;&amp; \longrightarrow &amp;&amp; B }
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              There are the canonical
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functors"} forgetful functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo ,
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    U \;\colon \; \mathcal{C}_{/X}, \mathcal{C}^{X/} \longrightarrow \mathcal{C}
            %p
              given by forgetting the morphisms to/from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p We here focus on this class of examples:
          #CategoryOfPointedObjects.num_defn
            %h6#definition_41 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SliceCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              is the corresponding
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
            %ul
              %li
                %p
                  objects are morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                        %mover
                          %mo →
                          %mi x
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \ast \overset{x}{\to} X
                  (hence an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  equipped with a choice of point; i.e. a
                  = succeed ");" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              %li
                %p
                  morphisms are
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo *
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi x
                                %mo ↙
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mi y
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi f
                              %mtd
                              %mtd
                                %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; \ast
                        \\\
                        \&amp; {}^{\mathllap{x}}\swarrow &amp;&amp; \searrow^{\mathrlap{y}}
                        \\\
                        X &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; Y
                        }
                %p
                  (hence morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  which preserve the chosen points).
          #PointedObjectsHaveZeroObject.num_remark
            %h6#remark_17 Remark
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              coincides with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
              itself, pointed in the unique way.
            %p
              In this situation one says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              is a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed category
            %p
              It follows that also all
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}^{\ast/}}(X,Y)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              are canonically
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
              %em
                %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∃
                        %mo !
                    %mn 0
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∃
                        %mo !
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\;\colon\;
                    X
                    \\overset{\exists !}{\longrightarrow}
                    0
                    \\overset{\exists !}{\longrightarrow} Y
                    \\,.
          #BasePointAdjoined.num_defn
            %h6#definition_42 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} U \colon \mathcal{C}^{\ast/} \to \mathcal{C}
              from its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^{\ast/}
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{(-)_+}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              given by forming the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              (
              %a.existingWikiWord{:href => "/nlab/show/coproduct"}> coproduct
              ) with a base point (“adjoining a base point”).
          #LimitsAndColimitsOfPointedObjects.num_prop
            %h6#proposition_20 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
            %p Moreover:
            %ol
              %li
                %p
                  the limits are the limits of the underlying diagrams in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  the colimits are the limits in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  of the diagrams
                  = succeed "." do
                    %em with the basepoint adjoined
          .proof
            %h6#proof_38 Proof
            %p
              It is immediate to check the relevant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              = succeed "." do
                %em
                  %a{:href => "overcategory#LimitsAndColimits"} slice category – limits and colimits
          #WedgeSumAsCoproduct.num_example
            %h6#example_19 Example
            %p
              Given two pointed objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,y)
            %ol
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  is simply
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X\times Y, (x,y))
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  has to be computed using the second clause in prop.
                  = succeed ":" do
                    %a.maruku-ref{:href => "#LimitsAndColimitsOfPointedObjects"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  has to be adjoined to the diagram, it is given not by the coproduct in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  of the form:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi x
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi y
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi po
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi Y
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi X
                                %mo ∨
                                %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\ast &amp;\overset{x}{\longrightarrow}&amp; X
                        \\\
                        {}^{\mathllap{y}}\downarrow &amp;(po)&amp; \downarrow
                        \\\
                        Y &amp;\longrightarrow&amp; X \vee Y
                        }
                        \\,.
                %p
                  This is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  operation on pointed objects.
            %p
              Generally for a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
            %ol
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  is formed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                  as in example
                  = succeed "," do
                    %a.maruku-ref{:href => "#ProductTopologicalSpace"}
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  is formed by the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                  over the diagram with a basepoint adjoined, and is called the
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo ∨
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \vee_{i \in I} X_i
          .num_example
            %h6#example_20 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %a.maruku-ref{:href => "#TopologicalCellComplex"}
              then for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientSpaceAsPushout"}
              = succeed "-skeleton" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-skeleton" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "," do
