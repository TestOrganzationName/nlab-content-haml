          %title Contents
          %hr/
          %p
            These are lecture notes (also:
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/files/IntroHomotopyTheory-20251118.pdf", :title => "pdf"} pdf
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            in
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            and motivating from this the “abstract homotopy theory” in general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            For background on basic
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Topology"} Introduction to Topology
          %p
            For application to
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Introduction+to+Homological+Algebra"} Introduction to Homological Algebra
          %p
            For application to
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory"} Introduction to Stable homotopy theory
          %hr/
          .rightHandSide
            .toc.clickDown{:tabindex => "0"}
              %h3#context Context
              %h4#homotopy_theory Homotopy theory
              .hide
                %p [[!include homotopy - contents]]
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
