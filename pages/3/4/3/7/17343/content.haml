                          %mo{:stretchy => "false"} (
                          %msub
                            %mi f
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Path(f_1)\to Y
              %li
                %p Similarly the total vertical composite gives a weak equivalence via
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi Path
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mo ∈
                                    %mi W
                              %mtd
                                %mi Path
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mn 1
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi Y
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi id
                              %mtd
                                %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        Path(f) &amp;\overset{\in W}{\longrightarrow}&amp; Path(f_1)
                        \\\
                        \\downarrow &amp;&amp; \downarrow
                        \\\
                        Y &amp;\underset{id}{\longrightarrow}&amp; Y
                        }
            %p
              from the fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Path(f) \to Y
              to the fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Path(f_1)\to Y
            %p
              Together this is a
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of weak equivalences of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟵
                      %mrow
                        %mo ∈
                        %mi W
                    %mspace{:width => "thickmathspace"}
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mspace{:width => "thickmathspace"}
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟵
                      %mrow
                        %mo ∈
                        %mi W
                    %mspace{:width => "thickmathspace"}
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    fib(f_1)
                    \\;\overset{\in W}{\longleftarrow}\;
                    fib(Path(f_1)\to Path(Y))
                    \\;\overset{\in W}{\longrightarrow}\;
                    fib(Path(f_1)\to Y)
                    \\;\overset{\in W}{\longleftarrow}\;
                    fib(Path(f) \to Y)
            %p
              between the fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Path(f) \to Y
              and the fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} f_1
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
          #FibersOfSerreFibrations.num_example
            %h6#example_37 Example
            %p
              %strong (fibers of Serre fibrations)
            %p
              In showing that
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              are abstract fibrations in the sense of
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              theory, theorem
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              implies that the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberAndCofiberInPointedObjects"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.maruku-ref{:href => "#SerreFibration"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F &amp;\longrightarrow&amp; X
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \&amp;&amp; B
                    }
            %p
              over any point is actually a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyFiber"}
              %a.maruku-ref{:href => "#FiberOfFibrationIsCompatibleWithWeakEquivalences"}
              this implies that the
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+type"} weak homotopy type
              of the fiber only depends on the Serre fibration up to weak homotopy equivalence in that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ′
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} p' \colon X' \to B'
              is another Serre fibration fitting into a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %mi X
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ′
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %mi B
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{\in W_{cl}}{\longrightarrow}&amp; X'
                    \\\
                    \\downarrow^{\mathrlap{p}} &amp;&amp; \downarrow^{\mathrlap{p'}}
                    \\\
                    B &amp;\overset{\in W_{cl}}{\longrightarrow}&amp; B'
                    }
            %p
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi W
                            %mi cl
                      %mi F
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F \overset{\in W_{cl}}{\longrightarrow} F'
            %p
              In particular this gives that the
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+type"} weak homotopy type
              of the fiber of a Serre fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon X \to B
              does not change as the basepoint is moved in the same connected component. For let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \gamma \colon I \longrightarrow B
              be a path between two points
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                      %mrow
                        %msub
                          %mi i
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 1
                    %mi I
                    %mover
                      %mo ⟶
                      %mi γ
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b_{0,1}
                    \\;\colon\;
                    \\ast
                    \\underoverset{\in W_{cl}}{i_{0,1}}{\longrightarrow}
                    I
                    \\overset{\gamma}{\longrightarrow}
                    B
                    \\,.
            %p
              Then since all objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
              are fibrant, and since the endpoint inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} i_{0,1}
              are weak equivalences, lemma
              %a.maruku-ref{:href => "#InCfPullbackAlongFibrationPreservesWeakEquivalences"}
              gives the
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of top horizontal weak equivalences in the following diagram:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mrow
                                %msub
                                  %mi b
                                  %mn 0
                            %mo =
                          %mtd
                            %msubsup
                              %mi b
                              %mn 0
                              %mo *
                            %mi p
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %msup
                              %mi γ
                              %mo *
                            %mi p
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %msubsup
                              %mi b
                              %mn 1
                              %mo *
                            %mi p
                          %mtd
                            %mo =
                            %msub
                              %mi F
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msup
                                      %mi γ
                                      %mo *
                                    %mi f
                                %mrow
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mo ∈
                                    %mrow
                                      %mi Fib
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %mo *
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %mi I
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F_{b_0} = &amp; b_0^\ast p
                    \&amp;\overset{\in W_{cl}}{\longrightarrow}&amp;
                    \\gamma^{\ast}p
                    \&amp;\overset{\in W_{cl}}{\longleftarrow}&amp;
                    b_1^\ast p
                    \&amp;
                    \= F_{b_1}
                    \\\
                    \&amp; \downarrow &amp;(pb)&amp; \downarrow{\mathrlap{{\gamma^\ast f} \atop {\in \atop {Fib}}}} &amp;\;\;(pb)&amp; \downarrow
                    \\\
                    \&amp; \ast
                    \&amp;\underoverset{i_0}{\in W_{cl}}{\longrightarrow}&amp;
                    I
                    \&amp;\underoverset{i_1}{\in W_{cl}}{\longleftarrow}&amp;
                    \\ast
                    }
            %p
              and hence an isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi b
                          %mn 0
                    %mo ≃
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} F_{b_0} \simeq F_{b_1}
              in the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ClassicalHomotopyCategory"}
            %p
              The same kind of argument applied to maps from the square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} I^2
              gives that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo ,
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \gamma_1, \gamma_2\colon I \to B
              are two homotopic paths with coinciding endpoints, then the isomorphisms between fibers over endpoints which they induce are equal. (But in general the isomorphism between the fibers does depend on the choice of homotopy class of paths connecting the basepoints!)
            %p
              The same kind of argument also shows that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              has the structure of a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              may be identified in the homotopy category with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi F
                    %annotation{:encoding => "application/x-tex"} D^n \times F
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is trivial. This is used when deriving the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AHSSExistence"}> prop.
              ).
          #StandardTopologicalMappingConeIsHomotopyCofiber.num_example
            %h6#example_38 Example
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ∪
                      %mi f
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    Y \cup_f Cone(X) \;\; \in Top
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              with the standard cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(X)
              given by collapsing one end of the standard topological cyclinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X \times I
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              = succeed "." do
                %a.maruku-ref{:href => "#MappingConesInTopologicalSpaces"}
            %p Equipped with the canonical continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ⟶
                    %mi Y
                    %msub
                      %mo ∪
                      %mi f
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Y \longrightarrow Y \cup_f Cone(X)
            %p
              this represents the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyFiber"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}= Top_{Quillen}
              from theorem
              = succeed "." do
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
          .proof
            %h6#proof_69 Proof
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalCylinderOnCWComplexIsGoodCylinderObject"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              then the standard topological cylinder object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X\times I
              is indeed a cyclinder object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              %a.maruku-ref{:href => "#ConeAndMappingCylinder"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FactorizationLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and then the ordinary cofiber of that, hence a model for the homotopy cofiber.
          .num_example
            %h6#example_39 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the inclusion of
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B O(n) \hookrightarrow B O(n+1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#HomotopyFiberOfInclusionOfConsecutiveClassifyingSpaces"} this prop.
              at
              = succeed "." do
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ClassifyingSpaces"} Classifying spaces and G-structure
          #FiberOfFibrationWeaklyEquivalentToFiberOfItsCocylinder.num_example
            %h6#example_40 Example
            %p
              Suppose a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              already happens to be a fibration between fibrant objects. The
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              %a.maruku-ref{:href => "#FactorizationLemma"}
              replaces it by a fibration out of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cocylinder"} mapping cocylinder
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(f)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi fib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi Fib
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mi fib
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi Fib
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    fib(f) &amp;\longrightarrow&amp; X &amp;\underoverset{\in Fib}{f}{\longrightarrow}&amp; Y
                    \\\
                    \\downarrow^{\mathrlap{\in W}} &amp;&amp; \downarrow^{\mathrlap{\in W}} &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    fib(\tilde f) &amp;\longrightarrow&amp; Path(f) &amp;\underoverset{\in Fib}{\tilde f}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              Hence by prop.
              %a.maruku-ref{:href => "#FiberOfFibrationIsCompatibleWithWeakEquivalences"}
              in this case the ordinary fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is weakly equivalent to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocone"} mapping cocone
              = succeed "." do
                %a.maruku-ref{:href => "#MappingConeAndMappingCocone"}
          %p
            We may now state the abstract version of the statement of prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#SerreFibrationGivesExactSequenceOfHomotopyGroups"}
          #ExactSequenceOfHomotopyFiberAtOneStage.num_prop
            %h6#proposition_41 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              any morphism of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    [A,hofib(f)]_\ast \overset{i_\ast}{\longrightarrow} [A,X]_\ast \overset{f_\ast}{\longrightarrow} [A,Y]_{\ast}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              as a sequence of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
            %p
              (Where the sequence here is the image of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              sequence of def.
              %a.maruku-ref{:href => "#HomotopyFiber"}
              under the hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Set
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} [A,-]_\ast \;\colon\; Ho(\mathcal{C}^{\ast/}) \longrightarrow Set^{\ast/}
              from example
              = succeed ".)" do
                %a.maruku-ref{:href => "#HomotopyCategoryOfPointedModelStructureIsEnrichedInPointedSets"}
          .proof
            %h6#proof_70 Proof
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              denote fibrant-cofibrant objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              representing the given objects of the same name in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C}^{\ast/})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              representing the given morphism of the same name in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C}^{\ast/})
            %p
              Then by def.
              %a.maruku-ref{:href => "#HomotopyFiber"}
              and prop.
              %a.maruku-ref{:href => "#HomotopyFiberIndependentOfChoiceOfFibrantReplacement"}
              there is a representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} hofib(f) \in \mathcal{C}
              of the homotopy fiber which fits into a pullback diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    hofib(f) &amp;\overset{i}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \\ast &amp;\longrightarrow&amp; Y
                    }
            %p
              With this the hom-sets in question are represented by genuine morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(i_\ast)
              includes into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(f_\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(f_\ast)
              indeed comes from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(i_\ast)
            %p
              But an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(f_\ast)
              is represented by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha \colon A \to X
              such that there is a left homotopy as in the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi η
                                %mo{:stretchy => "false"} ˜
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                          %mtd
                            %mi Cyl
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    \&amp;&amp; {}^{\mathllap{i_0}}\downarrow &amp;{}^{\tilde \eta}\nearrow&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    A &amp;\overset{i_1}{\longrightarrow} &amp; Cyl(A) &amp;\overset{\eta}{\longrightarrow}&amp; Y
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    \\ast &amp;&amp; \longrightarrow &amp;&amp; Y
                    }
                    \\,.
            %p
              Now by lemma
              %a.maruku-ref{:href => "#ComponentMapsOfCylinderAndPathSpaceInGoodSituation"}
              the square here has a lift
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo ∘
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} i_1 \circ\tilde \eta
              is left homotopic to
              = succeed "." do
