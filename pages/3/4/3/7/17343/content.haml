                    \\,.
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              to example
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              = succeed ")" do
