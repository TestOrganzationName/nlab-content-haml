                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∈
