                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\overset{i_n}{\longrightarrow}&amp; D^n
                    \\\
                    {}^{\mathllap{i_n}}\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    D^n &amp;\longrightarrow&amp; S^n
                    }
                    \\,.
            %p (graphics from Ueno-Shiga-Morita 95)
          %p
            Another kind of colimit that will play a role for certain technical constructions is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
          #PosetsWosetTosetsAndOrdinals.num_defn
            %h6#definition_3 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
              is a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
              such that for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} a,b,c \in S
            %p
              1) (
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"}> reflexivity
              )
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a \leq a
            %p
              2) (
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"}> transitivity
              ) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} b \leq c
              then
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi c
                    %annotation{:encoding => "application/x-tex"} a \leq c
            %p
              3) (
              %a.existingWikiWord{:href => "/nlab/show/antisymmetric+relation"}> antisymmetry
              ) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\leq b
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} b
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \b \leq a
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a = b
            %p
              This we may and will equivalently think of as a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              the elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and a unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \to b
              precisely if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a\leq b
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              between their corresponding categories.
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/bottom+element"} bottom element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
              in a partial order is one such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \bot \leq a
              for all a. A
              %em
                %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
              is one for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} a \leq \top
            %p
              A partial order is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/total+order"} total order
              if in addition
            %p
              4) (
              %a.existingWikiWord{:href => "/nlab/show/total+relation"}> totality
              ) either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\leq b
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ≤
                      %mi a
                    %annotation{:encoding => "application/x-tex"} b \leq a
            %p
              A total order is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/well+order"} well order
              if in addition
            %p
              5) (
              %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"}> well-foundedness
              ) every non-empty subset has a least element.
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              is the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              of a well-order.
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/successor"} successor
              of an ordinal is the class of the well-order with a
              %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
              freely adjoined.
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
              is one that is not a successor.
          #ExamplesOfOrdinals.num_example
            %h6#example_12 Example
            %p
              The finite ordinals are labeled by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ≤
                      %mn 1
                      %mo ≤
                      %mn 2
                      %mi ⋯
                      %mo ≤
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0 \leq 1 \leq 2 \cdots \leq n-1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              is the successor of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo ,
                      %mo ≤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \omega = [(\mathbb{N}, \leq)]
          #TransfiniteComposition.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I \subset Mor(\mathcal{C})
              be a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its morphisms.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              an
              %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              (regarded as a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %em transfinite sequence
              of elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi α
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet
                    \\;\colon\;
                    \\alpha \longrightarrow \mathcal{C}
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  takes all
                  %a.existingWikiWord{:href => "/nlab/show/successor"} successor
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mover
                          %mo →
                          %mo ≤
                        %mi β
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \beta \stackrel{\leq}{\to} \beta + 1
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  to elements in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi β
                            %mo ,
                            %mi β
                            %mo +
                            %mn 1
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"}
                        X_{\beta,\beta + 1} \in I
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  is
                  %em continuous
                  in that for every nonzero
                  %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi β
                          %mo &lt;
                          %mi α
                        %annotation{:encoding => "application/x-tex"} \beta \lt \alpha
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  restricted to the
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full-subdiagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi γ
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi γ
                        %mo ≤
                        %mi β
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\gamma \;|\; \gamma \leq \beta\}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting cocone
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  restricted to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi γ
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mi γ
                          %mo &lt;
                          %mi β
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \{\gamma \;|\; \gamma \lt \beta\}
            %p
              The corresponding
              %strong transfinite composition
              is the induced morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ⟶
                    %msub
                      %mi X
                      %mi α
                    %mo ≔
                    %munder
                      %mi lim
                      %mo ⟶
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    X_0 \longrightarrow X_\alpha \coloneqq \underset{\longrightarrow}{\lim}X_\bullet
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of the diagram, schematically:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi X
                                  %mrow
                                    %mn 0
                                    %mo ,
                                    %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi X
                                  %mrow
                                    %mn 1
                                    %mo ,
                                    %mn 2
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_0 &amp;\stackrel{X_{0,1}}{\to}&amp; X_1
                    \&amp;\stackrel{X_{1,2}}{\to}&amp; X_2
                    \&amp;\to&amp; \cdots
                    \\\
                    \&amp; \searrow &amp; \downarrow &amp; \swarrow &amp; \cdots
                    \\\
                    \&amp;&amp;
                    X_\alpha
                    }
                    \\,.
          %p
            We now turn to the discussion of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
          #CompactOpenTopology.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              (in that for every point, every
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              contains a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              neighbourhood), the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi Y
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    X^Y \in Top
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ul
              %li
                %p
                  whose underlying set is the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_{Top}(Y,X)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} Y \to X
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  are
                  %a.existingWikiWord{:href => "/nlab/show/unions"} unions
                  of
                  %a.existingWikiWord{:href => "/nlab/show/finitary+intersections"} finitary intersections
                  of the following
                  %a.existingWikiWord{:href => "/nlab/show/topological+base"} subbase
                  elements of standard open subsets:
                %p
                  the standard open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi U
                          %mi K
                        %mo ⊂
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U^K \subset Hom_{Top}(Y,X)
                  for
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi K
                            %mo ↪
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} K \hookrightarrow Y
                      a
                      %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                      subset
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo ↪
                            %mi X
                          %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
                      an
                      %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                %p
                  is the subset of all those
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  that fit into a
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
