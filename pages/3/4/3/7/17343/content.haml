                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi n
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} |
                          %mo ≤
                          %mn 1
                        %mo{:stretchy => "false"} }
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} D^n \coloneqq \{ \vec x\in \mathbb{R}^n | \; {\vert \vec x \vert \leq 1}\} \hookrightarrow \mathbb{R}^n
                  for the standard topological
                  %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
                  (equipped with its
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                  as a subset of
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
