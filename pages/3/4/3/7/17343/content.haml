                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalCCellComplex"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "." do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
          .proof
            %h6#proof_6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mrow
                        %mi β
                        %mo ≤
                        %mi α
                    %msub
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow \hat X = \underset{\longleftarrow}{\lim}_{\beta \leq \alpha} X_\beta
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
            %p
              First observe that with the elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} D^n \hookrightarrow D^n \times I
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} J_{Top}
              being
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              (by example
              = succeed ")," do
                %a.maruku-ref{:href => "#ProjectionFromStandardCylinderIsHomotopyEquivalence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi β
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta} \longrightarrow X_{\beta + 1}
              in the relative cell complex is also a homotopy equivalence. We make this fully explicit:
            %p
              By definition, such a stage is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo ⊔
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi β
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    \\\
                    {}^{\mathllap{\underset{i \in I}{\sqcup} (id, \delta_0)} }\downarrow
                    \&amp;(po)&amp;
                    \\downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i} \times I
                    \&amp;\longrightarrow&amp;
                    X_{\beta + 1}
                    }
                    \\,.
            %p
              Then the fact that the projections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mo ×
                    %mi I
                    %mo →
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                  %annotation{:encoding => "application/x-tex"} p_{n_i} \colon D^{n_i} \times I \to D^{n_i}
              are strict left inverses to the inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ,
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id, \delta_0)
              gives a
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo ⊔
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo ×
                            %mi I
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo ⊔
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                                  %msub
                                    %mi p
                                    %mrow
                                      %msub
                                        %mi n
                                        %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    \\\
                    {}^{\mathllap{\underset{i \in I}{\sqcup} (id, \delta_0)} }\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{id}}
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i} \times I
                    \\\
                    {}^{\mathllap{\underset{i \in I}{\sqcup} p_{n_i} }}\downarrow &amp;&amp; \downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    }
            %p
              and so the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (
              %a.existingWikiWord{:href => "/nlab/show/pushout"}> pushout
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta + 1}
              gives a factorization of the identity morphism on the right through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta + 1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo ⊔
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi β
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo ⊔
                                    %mrow
                                      %mi i
                                      %mo ∈
                                      %mi I
                                  %msub
                                    %mi p
                                    %mrow
                                      %msub
                                        %mi n
                                        %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    \\\
                    {}^{\mathllap{\underset{i \in I}{\sqcup} (id, \delta_0)} }\downarrow
                    \&amp;&amp;
                    \\downarrow^{}
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i} \times I
                    \&amp;\longrightarrow&amp;
                    X_{\beta + 1}
                    \\\
                    {}^{\mathllap{\underset{i \in I}{\sqcup} p_{n_i} }}\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    }
            %p
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X_{\beta + 1} \to X_\beta
              as a strict left inverse to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi β
                      %mo →
                      %msub
                        %mi X
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{\beta} \to X_{\beta + 1}
            %p To that end, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mo ×
                    %mi I
                    %mo ⟶
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{n_i} \colon D^{n_i}\times I \longrightarrow D^{n_i} \times I
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              that exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi n
                          %mi i
                  %annotation{:encoding => "application/x-tex"} p_{n_i}
              as a homotopy right inverse to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi n
                          %mi i
                  %annotation{:encoding => "application/x-tex"} p_{n_i}
              by example
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectionFromStandardCylinderIsHomotopyEquivalence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} t \in [0,1]
              consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi β
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo ×
                            %mi I
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi β
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mrow
                                      %msub
                                        %mi n
                                        %mi i
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo ,
                                  %mi t
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi β
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} D^{n_i}
                    \&amp;\longrightarrow&amp;
                    X_\beta
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i} \times I
                    \&amp;&amp; X_{\beta + 1}
                    \\\
                    {}^{\mathllap{\eta_{n_i}(-,t)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    \\underset{i \in I}{\sqcup} D^{n_i} \times I
                    \&amp;\longrightarrow&amp;
                    X_{\beta + 1}
                    }
                    \\,.
            %p
              Regarded as a
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              under the
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              in the top left, the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (
              %a.existingWikiWord{:href => "/nlab/show/pushout"}> pushout
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta + 1}
              gives a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(-,t) \;\colon\; X_{\beta + 1} \longrightarrow X_{\beta + 1}
            %p
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} t \in [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t = 0
              this construction reduces to the provious one in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi β
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta(-,0) \colon X_{\beta +1 } \to X_{\beta} \to X_{\beta + 1}
              is the composite which we need to homotope to the identity; while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(-,1)
              is the identity. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(-,t)
              is clearly also continuous in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              it constitutes a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                    %mo ×
                    %mi I
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; X_{\beta + 1}\times I \longrightarrow X_{\beta + 1}
            %p which exhibits the required left homotopy.
            %p
              So far this shows that each stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi β
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta} \to X_{\beta+1}
              in the
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              defining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalHomotopyEquivalencesAreWeakHomotopyEquivalences"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %p This means that all morphisms in the following diagram (notationally suppressing basepoints and showing only the finite stages)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msub
                              %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msub
                              %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msub
                              %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 3
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi α
                            %msub
                              %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi α
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\pi_n(X)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\pi_n(X_1)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\pi_n(X_2)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\pi_n(X_3)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\cdots
                    \\\
                    \&amp; {}_{\mathllap{\simeq}}\searrow &amp;
                    \\downarrow^{\mathrlap{\simeq}}
                    \&amp; \swarrow_{\mathrlap{\simeq}} &amp; \cdots
                    \\\
                    \&amp;&amp; \underset{\longleftarrow}{\lim}_\alpha \pi_n(X_\alpha)
                    }
            %p are isomorphisms.
            %p
              Moreover, lemma
              %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              gives that every representative and every null homotopy of elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\hat X)
              already exists at some finite stage
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi k
                    %annotation{:encoding => "application/x-tex"} X_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi α
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\longleftarrow}{\lim}_\alpha \pi_n(X_\alpha)
                    \\overset{\simeq}{\longrightarrow}
                    \\pi_n(\hat X)
            %p
              is an isomorphism. Hence the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X) \overset{\simeq}{\longrightarrow} \pi_n(\hat X)
              is an isomorphism.
          %h3#fibrations Fibrations
          %p
            Given a relative
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \iota \colon  X \to Y
            = succeed "," do
              %a.maruku-ref{:href => "#TopologicalCCellComplex"}
            %a.existingWikiWord{:href => "/nlab/show/extension"} extension
            problem along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            are such that every
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⟶
                  %mi E
                %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow E
            has an extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                %annotation{:encoding => "application/x-tex"} \iota
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi f
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ι
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                      %mtr
                        %mtd
                          %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{f}{\longrightarrow}&amp; E
                  \\\
                  {}^{\mathllap{\iota}}\downarrow &amp; \nearrow_{\mathrlap{\exists \tilde f}}
                  \\\
                  Y
                  }
                  \\,.
          %p
            If such extensions exists, it means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is sufficiently “spread out” with respect to the maps in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            (hence also
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          #RightLiftingProperty.num_defn
            %h6#definition_17 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \subset Mor(\mathcal{C})
              of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \longrightarrow B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is said to have the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              if every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi c
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; E
                    \\\
                    {}^{\mathllap{c}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y &amp;\longrightarrow&amp; B
                    }
                    \\,,
            %p
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi c
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi h
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; E
                    \\\
                    {}^{\mathllap{c}}\downarrow &amp;{}^{\mathllap{h}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y &amp;\longrightarrow&amp; B
                    }
                    \\,.
            %p
              We will also say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                \-
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              if it satisfies the right lifting property against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          #SerreFibration.num_defn
            %h6#definition_18 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \longrightarrow B
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              if it is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              = succeed "," do
                %a.maruku-ref{:href => "#RightLiftingProperty"}
              = succeed ";" do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
