          .num_remark
            %h6#remark_10 Remark
            %p
              Not all weak factorization systems are functorial, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FunctorialWeakFactorizationSystem"}
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              (prop.
              %a.maruku-ref{:href => "#SmallObjectArgument"}
              below), with due care) are.
          #ClosurePropertiesOfInjectiveAndProjectiveMorphisms.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K\subset Mor(\mathcal{C})
              be a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi Proj
                  %annotation{:encoding => "application/x-tex"} K Proj
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mi Inj
                    %annotation{:encoding => "application/x-tex"} K Inj
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/projective+morphisms"} projective morphisms
              and of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
              = succeed "." do
                %a.maruku-ref{:href => "#LiftingAndExtension"}
            %ol
              %li
                %p
                  Both classes contain the class of
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphisms
