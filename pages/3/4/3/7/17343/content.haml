          .proof
            %h6#proof_56 Proof
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo ⟶
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta \colon y(c) \cdot X \longrightarrow F
              consider its component
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c \;\colon\; \mathcal{C}(c,c)\times X \longrightarrow F(c)
            %p
              and restrict that to the identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi c
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
              in the first argument
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c(id_c,-) \;\colon\; X \longrightarrow F(c)
                    \\,.
            %p
              We claim that just this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_c(id_c,-)
              already uniquely determines all components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \;\colon\; \mathcal{C}(c,d)\times X \longrightarrow F(d)
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d \in Obj(\mathcal{C})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    F(-) \circ \eta_c
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d  \circ \mathcal{C}(c,-) \times X
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p
              agree. This means (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicallyEnrichedNaturalTransformationIsTransformationOfUnderlyingFunctors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\array{
                    \\mathcal{C}(c,c) \times X &amp;\overset{\eta_c}{\longrightarrow}&amp; F(c)
                    \\\
                    {}^{\mathllap{\mathcal{C}(c,f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{F(f)}}
                    \\\
                    \\mathcal{C}(c,d) \times X &amp;\underset{\eta_d}{\longrightarrow}&amp; F(d)
                    }
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in \mathcal{C}(c,d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \circ \mathcal{C}(c,f) \in F(d)^{\mathcal{C}(c,c) \times X}
            %p
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi c
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi id
                              %mi c
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi f
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\array{
                    \\{id_c\} \times X &amp;\overset{\eta_c}{\longrightarrow}&amp; F(c)
                    \\\
                    {}^{\mathllap{\mathcal{C}(c,f)}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{F(f)}}
                    \\\
                    \\{f\} \times X &amp;\underset{\eta_d}{\longrightarrow}&amp; F(d)
                    }
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \eta_d
              is fixed to be the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d(f,x) = F(f)\circ \eta_c(id_c,x)
            %p and this is a continuous function since all the operations it is built from are continuous.
            %p
              Conversely, given a continuous function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \colon X \longrightarrow F(c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \colon (f,x) \mapsto F(f) \circ \alpha
                    \\,.
            %p
              Running the above analysis backwards shows that this determines a transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta \colon y(c)\times X \to F
          #GeneratingCofibrationsForProjectiveStructureOnFunctors.num_defn
            %h6#definition_55 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              topologically enriched category, def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi Top
                      %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mrow
                        %mo {
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi ι
                              %mi n
                        %msup
                          %mi D
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                            %mo ,
                        %mrow
                          %mrow
                            %mi c
                            %mo ∈
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    I_{Top}^{\mathcal{C}}
                    \\;\coloneqq\;
                    \\left\{
                    y(c)\cdot (S^{n-1} \overset{\iota_n}{\longrightarrow} D^n)
                    \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Top
                      %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mrow
                        %mo {
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi D
                          %mi n
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %msub
                              %mi δ
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi D
                          %mi n
                        %mo ×
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                            %mo ,
                        %mrow
                          %mrow
                            %mi c
                            %mo ∈
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J_{Top}^{\mathcal{C}}
                    \\;\coloneqq\;
                    \\left\{
                    y(c)\cdot (D^n \overset{(id, \delta_0)}{\longrightarrow} D^n \times I)
                    \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
            %p
              for the sets of morphisms given by
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensoringAndPoweringOfTopologicallyEnrichedCopresheaves"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
              = succeed ")" do
