          #PushoutProductInTopCGSendsCofCofToCof.num_prop
            %h6#proposition_29 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
