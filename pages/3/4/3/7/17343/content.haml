                  %annotation{:encoding => "application/x-tex"} f\in K
              and is hence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} K Proj
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
          %p
            An immediate consequence of prop.
            %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
            is this:
          #SaturationOfGeneratingCofibrations.num_prop
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K\subset Mor(\mathcal{C})
              be a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its morphisms. Then every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              = succeed "," do
                %a.maruku-ref{:href => "#LiftingAndExtension"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              = succeed "," do
                %a.maruku-ref{:href => "#LiftingAndExtension"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
              %a.maruku-ref{:href => "#TopologicalCCellComplex"}
              and their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              = succeed "." do
                %a.maruku-ref{:href => "#RetractsOfMorphisms"}
          #RetractsOfMorphisms.num_remark
            %h6#remark_11 Remark
            %p
              By a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\longrightarrow} Y
              in some
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              we mean a retract of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as an object in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi g
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \stackrel{g}{\longrightarrow} B
              such that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
              there is a factorization of the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ⟶
                    %mi f
                    %mo ⟶
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_g \;\colon\;
                    g \longrightarrow f \longrightarrow g
                    \\,.
            %p
              This means equivalently that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi A
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mi B
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
