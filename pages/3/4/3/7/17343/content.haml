              from example
              %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
              has all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %p if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    F_\bullet
                    \\;\colon\;
                    I
                    \\longrightarrow
                    [\mathcal{C}, Top_{cg}]
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
              is any object, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
