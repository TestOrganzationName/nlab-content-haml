                    \\left\{
                    S^{n-1} \stackrel{\iota_n}{\hookrightarrow} D^{n}
                    \\right\}_{n \in \mathbb{N}}
                    \\;
                    \\subset
                    Mor(Top)
            %p
              for the set of canonical
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              inclusion maps of the standard
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"}
              = succeed "." do
                %strong
                  topological
                  %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
          #TopologicalCellComplex.num_defn
            %h6#definition_14 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} X \in Top
              and for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-cell attachment
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              (“
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"}> attaching space
              ”, example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
              %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
