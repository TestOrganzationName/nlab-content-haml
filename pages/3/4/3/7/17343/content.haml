                    %annotation{:encoding => "application/x-tex"} e_c
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi U
                      %mi c
                    %mo ⊂
                    %msub
                      %mi e
