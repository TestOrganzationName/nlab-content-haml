                            %mo −
                            %mn 1
                        %mo ×
                        %mi I
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
