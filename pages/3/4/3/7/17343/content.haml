            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mi I
                            %mo →
                            %mo *
                      %annotation{:encoding => "application/x-tex"} X^{I \to \ast}
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo *
                            %mo ⊔
                            %mo *
                            %mo →
                            %mi I
                      %annotation{:encoding => "application/x-tex"} X^{\ast \sqcup \ast \to I}
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            %p
              So while in general the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta_X
              is far from being an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              or even just a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              may be thought of as replacing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_defn
