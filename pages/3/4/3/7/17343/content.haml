                  %annotation{:encoding => "application/x-tex"} c \in U_c \subset e_c
              containing no further points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              beyond possibly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              itself, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              happens to be that single point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi c
                    %annotation{:encoding => "application/x-tex"} e_c
            %p
              It is now sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi c
                  %annotation{:encoding => "application/x-tex"} U_c
              may be enlarged to an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \tilde U_c
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              containing no point of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              itself, for that means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is not an accumulation point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %p
              To that end, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \alpha_c
              be the
              %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              that labels the stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mrow
                        %msub
                          %mi α
                          %mi c
                  %annotation{:encoding => "application/x-tex"} Y_{\alpha_c}
              of the
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              in the
              = succeed "-presentation" do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              at which the cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi c
                  %annotation{:encoding => "application/x-tex"} e_c
              above appears. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              be the ordinal of the full cell complex. Then define the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≔
                    %mrow
                      %mo {
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi α
                        %mi c
                      %mo ≤
                      %mi β
                      %mo ≤
                      %mi γ
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %munder
                        %mo ⊂
                        %mi open
                      %msub
                        %mi Y
                        %mi β
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo ∩
                      %msub
                        %mi Y
                        %mi α
                      %mo =
                      %msub
                        %mi U
                        %mi c
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo ∩
                      %mi P
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi ∅
                      %mo ,
