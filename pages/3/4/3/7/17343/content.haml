                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(P X, Q Y)/_{\sim}
                    \\overset{Hom_{\mathcal{C}}(id_{P X}, p_Y)/_\sim }{\longrightarrow}
