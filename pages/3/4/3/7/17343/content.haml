                %a.maruku-ref{:href => "#ModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              in its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi C
