              to some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ′
                      %mo ≔
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                      %msub
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \alpha' \coloneqq \tilde \eta|_0
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
