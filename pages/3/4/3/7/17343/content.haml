          #ProofOfFactorizationLemma.proof
            %h6#proof_62 Proof
            %p
              We discuss the second case. The first case is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              So consider the
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocylinder"} mapping cocylinder
              %a.maruku-ref{:href => "#ConeAndMappingCylinder"}
            #eq:ConstructionOfFactorizationInFactorizationLemma.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi Fib
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi p
                                    %mn 1
                                    %mo *
                                  %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
