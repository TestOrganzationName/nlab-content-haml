                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_f^{\Box}
                  of commuting squares in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
