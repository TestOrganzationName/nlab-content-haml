                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mi L
