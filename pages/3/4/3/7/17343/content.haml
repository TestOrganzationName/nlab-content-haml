                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
