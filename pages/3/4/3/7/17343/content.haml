              any
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow X
