          .num_example
            %h6#example_17 Example
            %p
              The endpoint inclusion into the standard interval, def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalInterval"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi I
                  %annotation{:encoding => "application/x-tex"} X^I
              of def.
              %a.maruku-ref{:href => "#TopologicalPathSpace"}
              factor the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              through the inclusion of constant paths and the endpoint evaluation of paths:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
