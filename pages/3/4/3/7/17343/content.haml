                              %mo ∪
                              %mi ϕ
                            %msup
                              %mi D
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\stackrel{\phi}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    D^n &amp;\longrightarrow&amp; X \underset{S^{n-1}}{\sqcup} D^n &amp; = X \cup_\phi D^n
                    }
            %p
              along some
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            %p
              A continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is called a
              %strong
                topological
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              if it is exhibited by a (possibly infinite) sequence of cell
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attachments
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TransfiniteComposition"}
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi i
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mi k
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                    %mi i
                                  %msub
                                    %mi ι
                                    %mrow
                                      %msub
                                        %mi n
                                        %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi i
                            %msup
                              %mi D
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i}{\coprod} S^{n_i - 1} &amp;\longrightarrow&amp; X_{k}
                    \\\
                    {}^{\mathllap{\underset{i}{\coprod}\iota_{n_i}}}\downarrow
                    \&amp;(po)&amp;
                    \\downarrow
                    \\\
                    \\underset{i}{\coprod} D^{n_i} &amp;\longrightarrow&amp; X_{k+1}
                    }
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpacesIsCoproduct"}
              %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
            %p
              A topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \emptyset \longrightarrow X
              is a relative cell complex.
            %p
              A relative cell complex is called a
              %strong finite relative cell complex
              if it is obtained from a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of cell attachments.
            %p
              A (relative) cell complex is called a (relative)
              %strong
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              if the above transfinite composition is countable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo =
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                            %mo =
                            %munder
                              %mi lim
                              %mo ⟶
                            %msub
                              %mi X
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X = X_0 &amp;\longrightarrow&amp; X_1 &amp;\longrightarrow&amp; X_2 &amp;\longrightarrow&amp; \cdots
                    \\\
                    \&amp; {}_{\mathllap{f}}\searrow &amp; \downarrow &amp; \swarrow &amp;&amp; \cdots
                    \\\
                    \&amp;&amp; Y = \underset{\longrightarrow}{\lim} X_\bullet
                    }
            %p
              and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi k
                  %annotation{:encoding => "application/x-tex"} X_k
              is obtained from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
