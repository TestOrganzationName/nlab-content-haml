                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mrow
                            %mi P
