                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %munder
                              %mo ⊔
                              %mrow
                                %msup
                                  %mi S
                                  %mrow
                                    %mi n
