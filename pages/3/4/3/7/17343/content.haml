            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi A
                      %mi s
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mi s
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi s
