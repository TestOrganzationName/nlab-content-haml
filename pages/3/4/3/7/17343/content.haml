                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Path(f)
                    \&amp;\underoverset{\in Fib}{(f,id)^\ast(p_1,p_0)}{\longrightarrow}&amp;
