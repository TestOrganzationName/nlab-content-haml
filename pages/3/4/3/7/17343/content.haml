                            %mi C
                            %munder
                              %mo ×
                              %mi D
                            %mover
                              %mi B
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %mover
                              %mi B
                              %mo{:stretchy => "false"} ^
                        %mtr
