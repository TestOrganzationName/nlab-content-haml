                              %mi X
                              %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi Y
                                    %mi i
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi Y
                              %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X^B
                    \\\
