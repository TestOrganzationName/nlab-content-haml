              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              %em
                Monopoles, Duality and Chiral Symmetry Breaking in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} N=2
                Supersymmetric QCD
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9408099"}> arXiv:hep-th/9408099
              )
          %p
            See also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+theory"}> Seiberg-Witten theory
              \:
          %p
            The dimensional reduction to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} D = 3
            was first considered in
          %ul
            %li#SeibergWitten96
              %a.existingWikiWord{:href => "/nlab/show/Nathan+Seiberg"}> Nathan Seiberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              %em Gauge Dynamics And Compactification To Three Dimensions
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9607163"}> arXiv:hep-th/9607163
              )
          %p
            The
            = succeed "-phenomenon" do
              %a.existingWikiWord{:href => "/nlab/show/confinement"} confinement
          %ul
            %li#SeibergWitten94
              %a.existingWikiWord{:href => "/nlab/show/Nathan+Seiberg"}> Nathan Seiberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em Monopole Condensation, And Confinement In N=2 Supersymmetric Yang-Mills Theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9407087"} arXiv:hep-th/9407087
          %p Reviews of this confinement mechanism:
          %ul
            %li
              %p
                Alexei Yung,
                %em What Do We Learn about Confinement from the Seiberg-Witten Theory
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0005088"}> arXiv:hep-th/0005088
                )
            %li#Albertsson03
              %p
                Cecilia Albertsson,
                %em Superconformal D-branes and moduli spaces
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0305188"}> arXiv:hep-th/0305188
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"}> Yang-Hui He
                ,
                = succeed "," do
                  %em Lectures on D-branes, Gauge Theories and Calabi-Yau Singularities
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0408142"} arXiv:hep-th/0408142
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Nardoni"}> Emily Nardoni
                ,
                = succeed "," do
                  %em
                    From
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒩
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathcal{N} = 2
                    Supersymmetry to adjoint QCD
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Strings+2022"} Strings 2022
                \&amp;lbrack;
                %a{:href => "https://indico.cern.ch/event/1085701/contributions/4940894"}> indico:4940894
                ,
                = succeed "," do
                  %a{:href => "https://indico.cern.ch/event/1085701/contributions/4940894/attachments/2484206/4265102/Slides_Nardoni.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://ustream.univie.ac.at/media/core.html?id=035dfeb0-ef40-4530-8f20-01e5b890f43d"} video
          %p
            For references on
            %a.existingWikiWord{:href => "/nlab/show/wall+crossing"} wall crossing
            of
            %a.existingWikiWord{:href => "/nlab/show/BPS+states"} BPS states
            see the references given there.
          %h3#ReferencesConstructionFrom5Branes Construction from 5-branes
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} N=2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 4
                %annotation{:encoding => "application/x-tex"} D=4
            SYM including its
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+theory"} Seiberg-Witten theory
            (
            %a{:href => "SeibergWitten94"}> Seiberg-Witten 94
            ) may be understood as being the
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+mechanism"} compactification
            of the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            on the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            on a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            %em
              %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+curve"} Seiberg-Witten curve
            of complexified coupling constants. This observation goes back to
          %ul
            %li#KlemmLercheMayrVafaWarner96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Albrecht+Klemm"}> Albrecht Klemm
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"} Wolfgang Lerche
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Mayr"} Peter Mayr
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+Warner"} Nicholas Warner
                = succeed "," do
                  %em
                    Self-Dual Strings and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒩
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathcal{N}=2
                    Supersymmetric Field Theory
                %strong 477
                (1996) 746-766 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9604034"}> arXiv:hep-th/9604034
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(96)00353-7"} doi:10.1016/0550-3213(96)00353-7
            %li#Witten97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Solutions Of Four-Dimensional Field Theories Via M Theory
                %strong 500
                (1997) 3-42 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9703166"}> arXiv:hep-th/9703166
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0550-3213(97)00416-1"} doi:10.1016/S0550-3213(97)00416-1
          %p review in:
          %ul
            %li
              %p
                Csaba Csaki, Joshua Erlich, John Terning, pp. 4 of;
                = succeed "," do
                  %em
                    Seiberg-Witten Description of the Deconstructed 6D
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,2)
                    Theory
                %strong 67
                025019 (2003) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/0208095"}> arXiv:hep-th/0208095
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevD.67.025019"} doi:10.1103/PhysRevD.67.025019
            %li
              %p
                Ling Bao, Elli Pomoni, Masato Taki, Futoshi Yagi, p. 5 of:
                = succeed "," do
                  %em M5-branes, toric diagrams and gauge theory duality
                %strong 2012
                105 (2012) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1112.5228"}> arXiv:1112.5228
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/JHEP04(2012)105"} doi:10.1007/JHEP04(2012)105
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Taro+Kimura"}> Taro Kimura
                , §4.5.2 in:
                = succeed "," do
                  %em Seiberg–Witten Geometry
                = succeed "," do
                  %em Instanton Counting, Quantum Geometry and Algebra
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-030-76190-5_4"} doi:10.1007/978-3-030-76190-5_4
          %p
            The further observation that therefore the sewing of
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surfaces"} Riemann surfaces
            on which one compactifies the M5-brane yields a gluing operation on N=2 SYM theories is due to
          %ul
            %li#Gaiotto09
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} N=2
                  dualities
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/0904.2715"} arXiv:0904.2715
          %p
            cf. at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/AGT+correspondence"} AGT correspondence
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/topologically+twisted+D%3D4+super+Yang-Mills+theory"} topological twisting
            of the compactification which is used around (2.27) there was previously introduced in section 3.1.2 of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Neitzke"} Andrew Neitzke
              = succeed "," do
                %em Wall-crossing, Hitchin Systems, and the WKB Approximation
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0907.3987"} arXiv:0907.3987
          %p and is discussed also for instance in section 5.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              %em Fivebranes and knots
              (
              %a{:href => "http://arxiv.org/abs/1101.3216"}> arXiv:1101.3216
              )
          %p
            (This is possibly also the mechanism behind the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/AGT+correspondence"} AGT correspondence
          %p
            A brief review of these matters is in (
            %a{:href => "#Moore12"}> Moore 12, section 7
            ). A formalization of the
            %a.existingWikiWord{:href => "/nlab/show/topological+twist"} topological twist
            in
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            formalized by
            %a.existingWikiWord{:href => "/nlab/show/factorization+algebras"} factorization algebras
            with values in
            %a.existingWikiWord{:href => "/nlab/show/BV+complexes"} BV complexes
            is in section 16 of
          %ul
            %li#Costello11
              %a.existingWikiWord{:href => "/nlab/show/Kevin+Costello"}> Kevin Costello
              ,
              = succeed "," do
                %em Notes on supersymmetric and holomorphic field theories in dimension 2 and 4
              = succeed "," do
                %em
                  %a{:href => "https://www.math.stonybrook.edu/dennisfest/"} Geometric and Algebraic Structures in Mathematics
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1111.4234"} arXiv:1111.4234
          %p
            For more on this see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topologically+twisted+D%3D4+super+Yang-Mills+theory"} topologically twisted D=4 super Yang-Mills theory
          %p
            An amplification of the relevance of this to the understanding of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            %a.existingWikiWord{:href => "/nlab/show/electric-magnetic+duality"} electric-magnetic duality
            is in
          %ul#Witten07
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Conformal+field+theory+in+four+and+six+dimensions"} Conformal field theory in four and six dimensions
              %a.existingWikiWord{:href => "/nlab/show/Ulrike+Tillmann"} Ulrike Tillmann
              (ed.)
              %em Topology, geometry and quantum field theory
              LMS Lecture Note Series (2004) (
              %a{:href => "http://arxiv.org/abs/0712.0157"}> arXiv:0712.0157
              )
          %p
            and the resulting relation to the
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              %em Geometric Langlands From Six Dimensions
              (
              %a{:href => "http://arxiv.org/abs/0905.2720"}> arXiv:0905.2720
              )
              %p#Witten09 .
          %p
            The corresponding dual theory under
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
            is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
              %em The gravity duals of N=2 superconformal field theories
              (
              %a{:href => "http://arxiv.org/abs/0904.4466"}> arXiv:0904.4466
              )
          %p
            Discussion of construction of just
            %a.existingWikiWord{:href => "/nlab/show/N%3D1+D%3D4+super+Yang-Mills+theory"} N=1 D=4 super Yang-Mills theory
            this way is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ibrahima+Bah"}> Ibrahima Bah
              , Christopher Beem, Nikolay Bobev, Brian Wecht,
              %em Four-Dimensional SCFTs from M5-Branes
              (
              %a{:href => "http://arxiv.org/abs/1203.0303"}> arXiv:1203.0303
              )
          %h3#relation_to_3branes_in_m5branes_m5_selfintersections Relation to 3-branes in M5-branes (M5 self-intersections)
          %p
            Relation to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/3-brane+in+6d"} 3-brane in 6d
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"} Neil Lambert
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em
                    Classical M-Fivebrane Dynamics and Quantum
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} N=2
                    Yang-Mills
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9710034"} arXiv:hep-th/9710034
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"}> Neil Lambert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em Gauge Fields and M-Fivebrane Dynamics
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9712040"} arXiv:hep-th/9712040
            %li#LambertWest98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"}> Neil Lambert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} N=2
                    Superfields and the M-Fivebrane
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9801104"} arXiv:hep-th/9801104
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"}> Neil Lambert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em Monopole Dynamics from the M-Fivebrane
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9811025"} arXiv:hep-th/9811025
          %p
            and via
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            in
          %ul
            %li
              Robert de Mello Koch, Alastair Paulin-Campbell, Joao P. Rodrigues,
              = succeed "," do
                %em
                  Monopole Dynamics in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒩
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{N}=2
                  super Yang-Mills Theory From a Threebrane Probe
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9903207"} arXiv:hep-th/9903207
        .revisedby
