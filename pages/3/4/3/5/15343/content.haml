                  %use{:x => "117.973073", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-2", :y => "85.895996"}
                  %use{:x => "124.027741", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-3", :y => "85.895996"}
                  %use{:x => "127.391666", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-4", :y => "85.895996"}
                  %use{:x => "136.507773", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-3", :y => "85.895996"}
                  %use{:x => "139.871698", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-5", :y => "85.895996"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "146.09564", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-1", :y => "85.895996"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "150.179889", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph4-1", :y => "85.895996"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "158.348388", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph1-3", :y => "85.895996"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "161.266772", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-2", :y => "85.895996"}
                  %use{:x => "166.518765", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-3", :y => "85.895996"}
                %path{:d => "M 71.879881 12.061744 C 23.259711 34.938814 -16.597018 35.076604 -64.937672 12.734947 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.992226,0,0,-0.992226,134.065646,45.667193)"}
                %path{:d => "M -2.48671 2.867547 C -2.032224 1.148184 -1.020734 0.333752 0.000623462 0.000517818 C -1.021346 -0.333883 -2.03036 -1.147019 -2.488236 -2.86977 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.900653,0.416239,0.416239,0.900653,69.418315,33.132087)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "103.489216", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-6", :y => "10.605902"}
                  %use{:x => "110.217065", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-7", :y => "10.605902"}
                  %use{:x => "114.926362", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-2", :y => "10.605902"}
                  %use{:x => "120.98103", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-8", :y => "10.605902"}
                  %use{:x => "127.70888", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-9", :y => "10.605902"}
                  %use{:x => "133.25545", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-6", :y => "10.605902"}
                  %use{:x => "139.9833", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph2-10", :y => "10.605902"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "146.709331", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-1", :y => "10.605902"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "150.793581", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph4-1", :y => "10.605902"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "158.96332", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph1-3", :y => "10.605902"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "161.880464", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-2", :y => "10.605902"}
                  %use{:x => "167.132457", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph3-3", :y => "10.605902"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "132.989081", "xlink:href" => "#3hxzHj_yqSQ26YJu7SPuvp6JYew=-glyph4-2", :y => "48.169586"}
            and recall that we can identify Boolean algebras with
            %a.existingWikiWord{:href => "/nlab/show/Lindenbaum-Tarski+algebras"} Lindenbaum-Tarski algebras
            of
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/propositional+theories"} propositional theories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi B
                %annotation{:encoding => "application/x-tex"} X_B
            the dual space of a Boolean algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} B \to {2}
          %ol
            %li
              %p
                %em conceptual completeness
                amounts to the fact that, for a homomorphism of Boolean algebras
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mo →
                        %mi B
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f \colon B \to B'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mrow
                          %mi B
                          %mo ′
                      %mo →
                      %msub
                        %mi X
                        %mi B
                    %annotation{:encoding => "application/x-tex"} f^* \colon X_{B'} \to X_{B}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is an isomorphism itself;
            %li
              %p
                %em> strong conceptual completeness
                , instead, corresponds to the isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ≅
                      %mstyle{:mathvariant => "bold"}
                        %mi StoneSp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mi B
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B \cong \mathbf{StoneSp}(X_B, 2)
                for each Boolean algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi B
                    %annotation{:encoding => "application/x-tex"} X_B
                of models of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                allows to reconstruct
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                up to isomorphism, or in other words to the fully-faithfulness of the functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi BoolAlg
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi BoolAlg
                          %mi op
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi StoneSp
                      %annotation{:encoding => "application/x-tex"} \mathbf{BoolAlg}(-,2) \colon \mathbf{BoolAlg}^{op} \to \mathbf{StoneSp}
          %p
          .num_remark
            %h6 Remark
            %p
              In these terms, it’s not always true that strong conceptual completeness, for a logical doctrine, entails conceptual completeness: for example,
              %a.existingWikiWord{:href => "/nlab/show/ultracategories"} virtual ultracategories
              allow for a strong conceptual completeness theorem for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric logic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \to \mathcal{F}
              between toposes (even
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/points+of+a+topos"} with enough points
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              of categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{Mod}(\mathcal{E}) \to \operatorname{Mod}(\mathcal{F})
              is an equivalence itself.
          %h2#conceptual_completeness_for_coherent_logic Conceptual completeness for coherent logic
          %p
            In the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent logic
            %em conceptual completeness
            refers to the result of
            %a{:href => "#MakRey"} Makkai and Reyes ‘77
            that the
            %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} hom-2-functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Pretop
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Pretop
                      %mi op
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi CAT
                  %annotation{:encoding => "application/x-tex"} {\mathbf{Pretop}}(-,{Set}) : \mathbf{Pretop}^{op} \to \mathbf{CAT}
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Pretop
                %annotation{:encoding => "application/x-tex"} \mathbf{Pretop}
            of (
            %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
            )
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pretoposes"} pretoposes
          %p
          #thm:conc-compl-pretoposes.num_theorem
            %h6 Theorem
            %p
              %strong (Conceptual completeness for pretoposes)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi P
                      %mn 1
                    %mo →
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F : P_1 \to P_2
              be a pretopos morphism between small pretoposes. If the precomposition functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Pretop
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mn 2
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Pretop
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mn 1
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^* : {\mathbf{Pretop}}(P_2, {Set}) \to {\mathbf{Pretop}}(P_1,{Set})
            %p
              is an equivalence of categories, then so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p
            Recall indeed that pretoposes can be identified with (
            %a.existingWikiWord{:href => "/nlab/show/syntactic+categories"} syntactic categories
            of) coherent theories up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elimination+of+imaginaries"} elimination of imaginaries
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo →
                  %msub
                    %mi P
                    %mn 2
                %annotation{:encoding => "application/x-tex"} P_1 \to P_2
            corresponds to an interpretation of the theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                %annotation{:encoding => "application/x-tex"} P_1
            into the theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                %annotation{:encoding => "application/x-tex"} P_1
            inside the category
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P_2
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is therefore a model of the source theory. In these terms, conceptual completeness states that if an interpretation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo →
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_1 \to T_2
            between two coherent theories induces an equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \operatorname{Mod}(T_2) \to \operatorname{Mod}(T_1)
            between the categories of models, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            are bi-interpretable up to elimination of imaginaries, that is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mn 1
                    %mi eq
                %annotation{:encoding => "application/x-tex"} T_1^{eq}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mn 2
                    %mi eq
                %annotation{:encoding => "application/x-tex"} T_2^{eq}
            are bi-interpretable.
          %p
          .num_remark
            %h6 Remark
            %p
              The above theorem can also be interpreted as a “semantic” characterization of pretoposes among
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coherent+categories"} coherent categories
              = succeed "," do
                %a{:href => "#MakRey"} Theorem 7.1.8, Makkai and Reyes ‘77
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon P \to C
              is a
              %a.existingWikiWord{:href => "/nlab/show/coherent+functor"} coherent functor
              from a pretopos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              to a coherent category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^* \colon \operatorname{Mod}(C) \to \operatorname{Mod}(P)
              is an equivalence of categories, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an equivalence itself. Call now a coherent functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C \to C'
              an
              %em extension
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} I \colon C \to C'
              of a coherent category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is:
            %ol
              %li
                %p
                  %em tight
                  (or
                  %em strongly conservative
                  in
                  = succeed ")" do
                    %a{:href => "#MakRey"} Makkai and Reyes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi I
                          %mo *
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I^* \colon \operatorname{Mod}(C') \to \operatorname{Mod}(C)
                  is an equivalence of categories;
              %li
                %p
                  %em significant
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo{:lspace => "verythinmathspace"} :
                        %mi C
                        %mo →
                        %mi C
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} I \colon C \to C'
                  is
                  %em not
                  an equivalence of categories.
            %p
              We then say that a coherent category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %em conceptually complete
              if every tight extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is not significant. As the embedding of a coherent category into its
              %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completion
              is a tight extension, conceptually complete categories are pretoposes; conversely, the conceptual completeness theorem can be rephrased by saying that pretoposes are conceptually complete, thus characterizing pretoposes as the conceptually complete (coherent) categories. Intuitively, this corresponds to the fact that pretoposes admit all the coherently-definable structure that coherent categories may lack but which coherent functors automatically preserve: that is, finite (disjunct) coproducts and quotients of definable equivalence relations.
          %p
            The conceptual completeness theorem is proved in
            %a{:href => "#MakRey"} Makkai and Reyes ‘77
            via model-theoretical techniques, such as the compactness theorem, and “syntactical” arguments, exploiting the identification between coherent categories and coherent theories. In
            = succeed "," do
              %a{:href => "#Pitts86"} Pitts ‘86
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} cocomma squares
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Pretop
                  %annotation{:encoding => "application/x-tex"} \mathbf{Pretop}
            %a{:href => "#Pitts89"} Pitts ‘89
            to prove a conceptual completeness theorem for
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic first-order logic
            by considering
            = succeed "." do
              %em Heyting pretoposes
          %p
