                    %mstyle{:mathvariant => "bold"}
                      %mi Ult
                  %annotation{:encoding => "application/x-tex"} \mathbf{Ult}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi PRETOP
                    %annotation{:encoding => "application/x-tex"} \mathbf{PRETOP}
              = succeed "," do
                %a{:href => "#Makkai87"} Theorem 8.2, Makkai
              = succeed "," do
                %em reflection in the small
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo :
                    %mi P
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Ult
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev : P \to \mathbf{Ult} ( \operatorname{Mod}(P), Set )
              is an equivalence for each
              %em small
              pretopos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
          %h3#remarks Remarks
          %p
            In his AMS monograph on duality and definability in first-order logic, Makkai refined the above reconstruction result to work with just the (ultra)
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of the ultracategory of models of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/logical+scheme"} logical scheme
            approach.
          %h3#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/ultraproduct"} ultraproduct
            %li
              %a.existingWikiWord{:href => "/nlab/show/Makkai+duality"} Makkai duality
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
          %h2#references References
          %p For coherent logic:
          %ul
            %li#MakRey
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"} Michael Makkai
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
                = succeed "," do
                  %em First order categorical logic: Model-theoretical methods in the theory of topoi and related categories
            %li#Makkai87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mihaly+Makkai"}> Mihaly Makkai
                ,
                = succeed "," do
                  %em Stone duality for first-order logic
                %strong 65
                2 (1987) 97–170 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0001-8708(87)90020-X"}> doi:10.1016/0001-8708(87)90020-X
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=900266"} MR89h:03067
            %li#Pitts86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Pitts"}> Andrew Pitts
                ,
                = succeed "," do
                  %em Interpolation and Conceptual Completeness for Pretoposes via Category Theory
                %strong 106
                (1987), pp. 301-327 ;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
                  vol. II
                , Oxford UP 2002 (sec. D3.5, pp.931-939) ;
            %li
              %p
                Victor Harnik,
                = succeed "," do
                  %em
                    Model theory vs. categorical logic: two approaches to pretopos completion (a.k.a.
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi T
                              %mi eq
                          %annotation{:encoding => "application/x-tex"} T^{eq}
                = succeed "," do
                  %strong 53
                %a{:href => "http://books.google.fr/books?id=-PZpEXuvvm4C&lpg=PA79&ots=uB-pruKFx8&dq=Victor%20Harnik%20pretopos%20completion&pg=PA79#v=onepage&q=Victor%20Harnik%20pretopos%20completion&f=false"} gBooks
                ;
            %li#Lurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em Ultracategories
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/papers/Conceptual.pdf"} pdf
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"}> Michael Makkai
                ,
                %em Strong Conceptual Completeness for First-Order Logic
                , APAL
                %strong 40
                (1988) pp.167-215 (freely available online) ;
            %li#Pitts89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Pitts"}> Andrew Pitts
                ,
                = succeed "," do
                  %em Conceptual completeness for first-order Intuitionistic logic: an application of categorical logic
                %strong 41
                (1987), pp. 38-81.
          %p For geometric logic:
          %ul
            %li#Saadia
              %p
                Gabriel Saadia,
                %em Extending conceptual completeness via virtual ultracategories
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2506.23935"}> arXiv:2506.23935
                \&amp;rbrack; ;
            %li#HamadGen
              %p
                Ali Hamad,
                %em Generalised ultracategories and conceptual completeness of geometric logic
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2507.07922"}> arXiv:2507.07922
                \&amp;rbrack;
            %li
              %p
                Ivan Di Liberti,
                %em Towards Higher Topology
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2009.14145"}> arXiv:2009.14145
                \&amp;rbrack;.
          %p For continuous logic:
          %ul
            %li#AlbertHart
              Jean-Martin Albert, Bradd Hart.
              = succeed "," do
                %em Metric logical categories and conceptual completeness for first order continuous logic
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1607.03068"} arXiv:1607.03068
          %p
            For
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi ω
                          %mn 1
                        %mo ,
                        %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\omega_1,\omega}
          %ul
            %li
              Ruiyuan Chen,
              = succeed "," do
                %em
                  Borel functors, interpretations, and strong conceptual completeness for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi ω
