            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi k
                    %mo{:stretchy => "false"} |
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} {\vert k\vert} \in \mathbb{N}
            denotes the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
          %p
            A group with a norm is a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/normed+group"} normed group
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
            with a
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            in the positivity condition.
          %h3#on_a_vector_space On a vector space
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/valuation"} valuation
            (most usually, a
            %a.existingWikiWord{:href => "/nlab/show/local+field"} local field
            such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/p-adic+field"} p-adic
            %a.existingWikiWord{:href => "/nlab/show/complete+field"} completion
            of a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            %strong norm
            on a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  {\vert-\vert} \colon V \to \mathbb{R}
          %p
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \lambda \in k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ,
                  %mi w
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v,w \in V
            we have
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi λ
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert \lambda v \vert} = {\vert \lambda\vert} {\vert v \vert}
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi λ
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \vert \lambda \vert
                denotes the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/valuation"} valuation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo +
                        %mi w
                        %mo{:stretchy => "false"} |
                      %mo ≤
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo +
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi w
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert v + w\vert } \leq {\vert v \vert } + {\vert w \vert}
                (“
                %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"}> triangle inequality
                ”)
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} {\vert v\vert} = 0
                then
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} v = 0
          %p
            If the third property is not required, one speaks of a
            = succeed "." do
              %strong seminorm
          %p If the triangle identity is strengthened to
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo +
                      %mi w
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo{:stretchy => "false"} |
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi w
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {\vert v + w\vert } \leq max ({\vert v\vert}, {\vert w\vert})
          %p
            one speaks of a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/non-archimedean"} non-archimedean
            seminorm, otherwise of an
            %a.existingWikiWord{:href => "/nlab/show/archimedean"} archimedean
            one.
          %p
            A vector space equipped with a norm is a
            = succeed "." do
              %strong normed vector space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unit+vector"} unit vector
          %p
            Each seminorm determines a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            precisely if it is a norm.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            is called
            %strong (semi-)normed
            if its
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            can be induced by a (semi-)norm.
          %p
            Two seminorms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mn 1
                %annotation{:encoding => "application/x-tex"} {\vert - \vert}_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mn 2
                %annotation{:encoding => "application/x-tex"} {\vert - \vert}_2
            are called
            %strong equivalent
            if there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo &lt;
                  %mi C
                  %mo ,
                  %mi C
                  %mo ′
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} 0 \lt C, C' \in \mathbb{R}
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo{:stretchy => "false"} |
                    %mn 1
                  %mo ≤
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo{:stretchy => "false"} |
                    %mn 2
                  %mo ≤
                  %mi C
                  %mo ′
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo{:stretchy => "false"} |
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C {\vert v \vert}_1 \leq {\vert v \vert}_2
                  \\leq C' {\vert v \vert}_1
                  \\,.
          %p
            Equivalent seminorms determine the same
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          %p
            The collection of (bounded) multiplicative seminorms on a (
            %a.existingWikiWord{:href => "/nlab/show/Banach+space"}> Banach
            )
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            is called its
            %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            (see there for details).
          %h2#examples Examples
          %h3#general General
          %ul
            %li
              %p
                The standard
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                is a norm on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %li
              %p
                More generally, on any
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                the
                %strong Euclidean norm
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msqrt
                        %mstyle{:displaystyle => "false"}
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo =
                              %mn 1
                            %mi n
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi i
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\vert \vec x\vert
                      \\;\coloneqq\;
                      \\sqrt{
                      \\textstyle{\underoverset{i = 1}{n}{\sum}}
                      (x_i)^2
                      }
                      \\,.
          %ol
            %li
              %p
                more generally, for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p \geq 1
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                carries the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/p-norm"} p-norm
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} |
                        %mi p
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mroot
                        %mstyle{:displaystyle => "false"}
                          %mrow
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi i
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi x
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} |
                              %mi p
                        %mi p
                    %annotation{:encoding => "application/x-tex"}
                      {\vert \vec x \vert}_p
                      \\;\coloneqq\;
                      \\root p {\textstyle{\sum_i} {|x_i|^p}}
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/p-norm"} p-norm
                generalizes to
                %a.existingWikiWord{:href => "/nlab/show/sequence+spaces"} sequence spaces
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lebesgue+spaces"} Lebesgue spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/operator+norm"} operator norm
              in
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/operator+algebra"} operator algebra
              %a.existingWikiWord{:href => "/nlab/show/functional+analysis"} functional analysis
          %h3#minkowski_functionals Minkowski Functionals
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a vector space and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ⊆
                  %mi V
                %annotation{:encoding => "application/x-tex"} B \subseteq V
            an
            %a.existingWikiWord{:href => "/nlab/show/absorbing"} absorbing
            %a.existingWikiWord{:href => "/nlab/show/absolutely+convex"} absolutely convex
            subset. The
            %strong Minkowski functional
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi B
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mu_B \colon V \to \mathbb{R}
            defined by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi inf
                  %mo{:stretchy => "false"} {
                  %mi t
                  %mo &gt;
                  %mn 0
                  %mo :
                  %mi v
                  %mo ∈
                  %mi t
                  %mi B
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\mu_B(v) = \inf\{t \gt 0 : v \in t B\}
          %p
            This is a semi-norm on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %h2#properties Properties
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hahn-Banach+theorem"} Hahn-Banach theorem
          %p
            The (open or closed)
            %a.existingWikiWord{:href => "/nlab/show/unit+ball"} unit ball
            of a seminormed vector space is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/convex+set"} convex set
            %a.existingWikiWord{:href => "/nlab/show/balanced+set"} balanced set
            and an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absorbing+set"} absorbing set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absolutely+convex+set"} absolutely convex set
          %h3#dreamUnique Uniqueness
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dream+mathematics"} dream mathematics
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            (with no topological structure) can have at most one complete norm, up to topological equivalence (
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            %a.existingWikiWord{:href => "/nlab/show/Lebesgue+norms"} Lebesgue norms
            on a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            for finite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            are complete and equivalent; on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^\infty
          %p
            As dream mathematics includes
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+choice"} dependent choice
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %a.existingWikiWord{:href => "/nlab/show/Baire+property"} Baire property
            (which is the only classically false axiom needed in the proof of uniqueness). In
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/HAF"} HAF
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/applied+mathematics"} applied mathematics
          %p
            This theorem applies more generally to
            %a.existingWikiWord{:href => "/nlab/show/F-norms"} F-norms
            but not to
            %a.existingWikiWord{:href => "/nlab/show/G-norms"} G-norms
            (even on a real vector space).
          %h2#norms_valued_in_another_archimedean_integral_domain Norms valued in another Archimedean integral domain
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            are different from the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modulated+Cauchy+real+numbers"} modulated Cauchy real numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/HoTT+book+real+numbers"} HoTT book real numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/localic+real+numbers"} localic real numbers
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            for defining the norm as in impredicative mathematics, one has to define norms and normed spaces more generally.
          %p
            Thus, given an
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+integral+domain"} Archimedean integral domain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            equipped with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/valuation"} valuation
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              \-norm
            on a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"}
                  {\vert-\vert} \colon V \to R
          %p
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \lambda \in k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ,
                  %mi w
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v,w \in V
            we have
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi λ
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert \lambda v \vert} = {\vert \lambda\vert} {\vert v \vert}
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi λ
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \vert \lambda \vert
                denotes the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/valuation"} valuation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo +
                        %mi w
                        %mo{:stretchy => "false"} |
                      %mo ≤
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo +
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi w
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert v + w\vert } \leq {\vert v \vert } + {\vert w \vert}
                (“
                %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"}> triangle inequality
                ”)
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} {\vert v\vert} = 0
                then
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} v = 0
          %p
            One could define
            = succeed "-seminorms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-norms," do
