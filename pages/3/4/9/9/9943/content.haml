                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi Brown
                                %mspace{:width => "thickmathspace"}
                                %mi representation
                      %mtr
                        %mtd
                          %mi ℳ
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi MCTs
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E_\infty Rings
                  \\\
                  \&amp;{}^{\mathllap{\mathcal{O}_{\mathcal{M}^{der}}}}\nearrow&amp; \downarrow^{\mathrlap{Brown\;representation}}
                  \\\
                  \\mathcal{M}(R)
                  \&amp;\longrightarrow&amp;
                  MCTs
                  }
                  \\,,
          %p
            where the bottom map sends (
            %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"}> derived
            )
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curves"} elliptic curves
            over a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to their associated
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
            (“MTC”) and where the right vertical map sends a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            to the cohomology theory which it
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represents
          %h3#hopkinsmiller_theorem Hopkins-Miller theorem
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            consisting of a
            %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfect field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of finite
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            and of a
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            of
            %a.existingWikiWord{:href => "/nlab/show/height+of+a+formal+group"} height
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are base change of fields (as rings).
          %p
            The
            %strong Hopkins-Miller theorem
            says that there is a functorial assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi E
                    %mrow
                      %mi k
                      %mo ,
                      %mi Γ
                %annotation{:encoding => "application/x-tex"} (k,\Gamma) \mapsto E_{k,\Gamma}
            to such data of an
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+ring"} A-∞ ring
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi k
                      %mo ,
                      %mi Γ
                %annotation{:encoding => "application/x-tex"} E_{k,\Gamma}
            such that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                      %msub
                        %mi E
                        %mrow
                          %mi k
                          %mo ,
                          %mi Γ
                    %annotation{:encoding => "application/x-tex"} \pi_2 E_{k,\Gamma}
                contains a
                %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                        %msub
                          %mi E
                          %mrow
                            %mi k
                            %mo ,
                            %mi Γ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \pi_{2n+1} E_{k,\Gamma} = 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %mi k
                          %mo ,
                          %mi Γ
                    %annotation{:encoding => "application/x-tex"} E_{k,\Gamma}
                is
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex orientable
            %li
              %p
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %msub
                        %mi E
                        %mrow
                          %mi k
                          %mo ,
                          %mi Γ
                    %annotation{:encoding => "application/x-tex"} \pi_0 E_{k,\Gamma}
                is the
                %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+formal+group"} universal deformation
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (k,\Gamma)
          %p
            In this form this appears as (
            %a{:href => "#Rezk97"}> Rezk 97, theorem 2.1
            ).
          %h3#goersshopkins_theorem Goerss-Hopkins theorem
          %p (…)
          %p
            this appears reproduced as (
            %a{:href => "#Behrens13"}> Behrens 13, theorem 4.2
            )
          %h3#LurieTheorem Lurie theorem
          %p
            By (
            %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"}> Lurie (Survey), theorem 4.1
            ), the
            %a.existingWikiWord{:href => "/nlab/show/spectral+Deligne-Mumford+stack"} spectral Deligne-Mumford stack
            refinement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℳ
                    %mi ell
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{M}_{ell}, \mathcal{O}^{top})
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            is the moduli stack of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curves"} derived elliptic curves
            %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            in
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+rings"} E-∞ rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℳ
                    %mi ell
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi der
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Hom(Spec(A), (\mathcal{M}_{ell},\mathcal{O}^{der}))
                  \\simeq
                  E(A)
                  \\,,
          %p
            where on the left we have maps of
            %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-toposes"} structured (∞,1)-toposes
            and on the right the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curves"} derived elliptic curves
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            This is based on the
            %a.existingWikiWord{:href => "/nlab/show/Artin-Lurie+representability+theorem"} Artin-Lurie representability theorem
            (
            %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"}> Lurie (Survey), prop. 4.1
            ,
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Representability+Theorems"} Lurie (Representability)
