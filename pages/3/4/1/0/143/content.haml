                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\{U_i\})
              defined this way is the presheaf that sends any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} K \in C
              to the set of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} K \to U
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that factor through one of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                    %annotation{:encoding => "application/x-tex"} f_i
          .num_remark
            %h6#remark_3 Remark
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family there is a canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                    %mo :
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_{\{U_i\}} :  S(\{U_i\}) \to j(U)
            %p
              that is induced by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              from the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(f_i) : j(U_i) \to j(U)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mrow
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                      %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j(U_j) \times_{j(U)} j(U_k) \to j(U)
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              %strong sheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,J)
              is a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PSh(C)
              that is a
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              with respect to all
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i_{\{U_i\}}
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              families
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo :
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f_i : U_i \to U\}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_C(-,A)
              sends the canonical morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                    %mo :
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_{\{U_i\}} : S(\{U_i\}) \to j(U)
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh_C(i_{\{U_i\}}, A) :
                    PSh_C(j(U), A) \stackrel{\simeq}{\to} PSh_C(S(\{U_i\}), A)
                    \\,.
          %p
            Equivalently, using the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            and the fact that the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_C(-,A)
            sends
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi j
                      %mo ,
                      %mi k
                  %msub
                    %mi PSh
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                  %mi j
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(U)
                  \\to
                  \\prod_i A(U_i)
                  \\stackrel{\to}{\to}
                  \\prod_{j,k} PSh_C(j(U_j) \times_{j(U)} j(U_k), A)
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            diagram for each covering family.
          %p
            This is also called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              condition
            for descent along the covering family.
          .num_remark
            %h6#remark_4 Remark
            %p
              For many examples of sites that appear in practice – but by far not for all – it happens that the pullback presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(U_j) \times_{j(U)} j(U_k)
              are themselves again representable, hence that the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi j
                    %msub
                      %mo ×
                      %mi U
                    %msub
                      %mi U
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U_j \times_U U_k
              exists already in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %p
              In this special case we may apply the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              once more to deduce
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %msub
                      %mo ×
                      %mi U
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh_C(j(U_j) \times_{j(U)} j(U_k), A)
                    \\simeq
                    A(U_j \times_U U_k)
                    \\,.
            %p Then the sheaf condition is that all diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ,
                        %mi k
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %msub
                      %mo ×
                      %mi U
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A(U)
                    \\to
                    \\prod_i A(U_i)
                    \\stackrel{\to}{\to}
                    \\prod_{j,k} A(U_j \times_U U_k)
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          .num_prop
            %h6#proposition Proposition
            %p
              The condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_C(S(\{U_i\}), A)
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              is equivalent to the condition that the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(U)
              is isomorphic to the set of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi i
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s_i \in A(U_i))
              as it appears in the
              = succeed "." do
                %a{:href => "#GeneralComponentwiseDefinition"} above component-wise definition
          .proof
            %h6#proof Proof
            %p
              We may express the set of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_C(j(U_j) \times_{j(U)} j(U_k), A)
              (as described there) by the
              %a.existingWikiWord{:href => "/nlab/show/end"} end
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ∫
                      %mrow
                        %mi K
                        %mo ∈
                        %mi C
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh_C(j(U_j) \times_{j(U)} j(U_k), A)
                    \\simeq
                    \\int_{K \in C}
                    Set( C(K,U_j) \times_{C(K,U)} C(K,U_k) , A(K))
                    \\,.
            %p
              Using this in the expression of the
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %mi K
                        %mo ∈
                        %mi C
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ,
                        %mi k
                    %msub
                      %mo ∫
                      %mrow
                        %mi K
                        %mo ∈
                        %mi C
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %msub
                      %mi U
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_i A(U_i)
                    \\simeq
                    \\prod_i
                    \\int_{K \in C}
                    Set( C(K,U_i), A(K))
                    \\stackrel{\to}{\to}
                    \\prod_{j,k}
                    \\int_{K \in C}
                    Set( C(K,U_j) \times_{C(K,U)} C(K,U_k) , A(K))
            %p
              as a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the product set on the left manifestly yields the componenwise definition above.
          .num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong morphism of sheaves
              is just a morphism of the underlying presheaves. So the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_J(C)
              is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              on the sheaves:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh_J(C) \hookrightarrow PSh(C)
          %h3#characterizations_over_special_sites Characterizations over special sites
          %p
            We discuss equivalent characterizations of sheaves that are applicable if the underlying
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            enjoys certain special properties.
          %h4#CharacterizationsOverSitesOfOpens Characterizations over sites of opens
          %p
            An important special case of sheaves is those over a
            %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-site"} (0,1)-site
            such as a
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            (The following was mentioned in Peter LeFanu Lumsdaine’s comment
            = succeed ")." do
              %a{:href => "http://mathoverflow.net/questions/23268/geometric-intuition-for-limits/23276#23276"} here
          #AsContinuousFunctorOverOpenSubsets.num_prop
            %h6#proposition_2 Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                    %mo =
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Op = Op(X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
              of some
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with the canonical
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow U\}
              is
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              if the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∪
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ≃
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \cup_i U_i \simeq U
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                    %annotation{:encoding => "application/x-tex"} Op
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                  %annotation{:encoding => "application/x-tex"} Op
              is a
              %strong sheaf
              precisely if for every
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} full subcategory
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                      %mo ↪
                      %mi Op
                    %annotation{:encoding => "application/x-tex"} \mathcal{U} \hookrightarrow Op
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              takes the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                  %annotation{:encoding => "application/x-tex"} Op
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo ↪
                    %mi Op
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} \hookrightarrow Op
              to a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mo →
                    %mi 𝒰
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo ←
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %mi 𝒰
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{F}(\underset{\to}{lim} \mathcal{U}) \simeq \underset{\leftarrow}{lim} \mathcal{F}(\mathcal{U})
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              A complete full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo ↪
                    %mi Op
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} \hookrightarrow Op
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow X\}
              of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              that is closed under forming
              %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
              of subsets. The
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mi 𝒰
                    %mo ↪
                    %mi Op
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\to}{\lim} (\mathcal{U} \hookrightarrow Op)
                    \\simeq
                    \\cup_{i \in I} U_i
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ≔
                    %msub
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U \coloneqq \cup_{i \in I} U_i
              of all these open subsets. Notice that by construction the component maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow U\}
              of the colimit are a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p
              Inspection then shows that the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim}_{i \in I} \mathcal{F}(U_i)
              is the corresponding set of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              (use the description of
              %a{:href => "http://ncatlab.org/nlab/show/limit#ConstructionFromProductsAndEqualizers"} limits in terms of products and equalizers
              ). Hence the statement follows with def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralComponentwiseDefinition"}
          %h4#AsEtaleSpace As étale spaces
          %p
            Further in the case where the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Some authors (e.g.,
            %a.existingWikiWord{:href => "/nlab/show/Robert+Goldblatt"} Goldblatt
            in
            = succeed "," do
              %em Topoi: The Categorial Analysis of Logic
            %em sheaf
            to mean what we call an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+space"} étale space
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            where the projection map is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+homeomorphism"} local homeomorphism
          %p
            As discussed at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+space#RelationToSheaves"} étale space#RelationToSheaves
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            between the “sheaves” in this sense over a given base space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (i.e., the étale spaces over
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h4#CharacterizationOverCanonicalTopologies Characterization over canonical topologies
          %p
            The above prop.
            %a.maruku-ref{:href => "#AsContinuousFunctorOverOpenSubsets"}
            shows that often sheaves are characterized as contravariant functors that take some
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          #AsContinuousFunctorsOnCanonicalTopology.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              be be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %a.existingWikiWord{:href => "/nlab/show/large+site"} large site
              when equipped with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/canonical+topology"} canonical topology
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              (with values in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/small+sets"} small sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              is a sheaf precisely if it sends all
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          %h2#sheaves_and_localization Sheaves and localization
          %p
            We now describe the derivation and the detailed description of various aspects of sheaves, the
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            condition for sheaves and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/cover"} cover
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
          %p
            We start by assuming that a
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            into a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            category is given and derive the consequences.
          %p
            So let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi PSh
                    %mi S
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} PSh(S) = PSh_S = [S^{op}, Set]
            for the corresponding
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
          %p
            Assume then that another topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Sh
                    %mi S
                %annotation{:encoding => "application/x-tex"} Sh(S) = Sh_S
            is given together with a
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f : Sh(S) \to PSh(S)
          %p
            i.e. with a
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f_* : Sh(S) \to PSh(S)
          %p
            and a left
            %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f^* : PSh(S) \to Sh(S)
          %p
            Such that both form a pair of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo ⊣
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  f^* \dashv f_*
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            for the category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi W
                  %mo ↪
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Core(PSh(S)) \hookrightarrow W \hookrightarrow PSh(S)
          %p
            consisting of all those morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(S)
            that are sent to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  W = (f^*)^{-1}(Core(Sh_S))
                  \\,.
          %p
            From the discussion at
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            we know that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(S)
            is equivalent to the full
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(S)
            on all
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
          %p
            Recall that an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in PSh(S)
            is called a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
            if for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p : Y \to X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mo *
                  %mo :
                  %msub
                    %mi PSh
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi PSh
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  p^* : PSh_S(X,A) \to PSh_S(Y,A)
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            condition on presheaves (saying that a presheaf “descends” along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            “down to”
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            – equipping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            – and characterize the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                  %annotation{:encoding => "application/x-tex"} Sh
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
          .un_lemma
            %h6#lemma Lemma
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              if and only if for every
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\to X
              the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Y \times_X U \to U
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %msub
                              %mo ×
                              %mi X
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mo ⇔
                                %mo ∈
                                %mi W
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y \times_X U &amp;\to&amp; Y
                    \\\
                    \\downarrow^{\in W} &amp;&amp; \downarrow^{\Leftrightarrow \in W}
                    \\\
                    U &amp;\to&amp; X
                    }
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is stable under
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (as described at
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves finite limits) it is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Y \times_X U \to U
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              is.
            %p
              To get the other direction, use the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              to write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              over the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi const
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y/const_X)
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              the
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mi colim
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                    %msub
                      %mi U
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq colim_{U_i \to X} U_i
                    \\,.
            %p
              Then pull back
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %msub
                      %mi colim
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Y \to colim_{U_i \to X} U
              over the entire colimiting cone, so that over each component we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %msub
                              %mo ×
                              %mi X
                            %msub
                              %mi U
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y \times_X U_i &amp;\to&amp; Y
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    U_i &amp;\to&amp; X
                    }
                    \\,.
            %p
              Using that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              %a.existingWikiWord{:href => "/nlab/show/commutativity+of+limits+and+colimits"} colimits are stable under base change
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi colim
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi colim
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    colim_i (Y \times_X U_i) \simeq (colim_i U_i) \times_X Y
                    \\,.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mi colim
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X \simeq colim_i U_i
              the right hand is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ×
                        %mi X
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times_X Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %msub
                      %mi colim
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y = colim_i (Y \times_X U_i)
              and we find that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              is a morphism of colimits. But under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              the two respective diagrams become isomorphic, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} Y \times_X U_i \to U_i
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*(Y \to X)
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves colimits) is an isomorphism, which finally means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
          .un_lemma
            %h6#lemma_2 Lemma
            %p
              A presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PSh(S)
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              with respect to all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              already if it is local with respect to those morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              whose codomain is
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
          .proof
            %h6#proof_4 Proof
            %p
              Rewriting the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              in terms of colimits as in the above proof
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi colim
                              %mrow
                                %mi U
                                %mo →
                                %mi X
                            %msub
                              %mi U
                              %mi i
                            %msub
                              %mo ×
                              %mi X
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi colim
                              %mrow
                                %mi U
                                %mo →
                                %mi X
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    colim_{U \to X} U_i \times_X Y
                    \&amp;\stackrel{\simeq}{\to}&amp; Y
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    colim_{U \to X} U &amp;\stackrel{\simeq}{\to}&amp; X
                    }
            %p
              we find that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(X) \to A(Y)
              equals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mrow
                        %mi U
                        %mo →
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    lim_{U \to X} (A(U) \to A(U \times_X Y))
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is local with respect to morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              with representable codomain, then by the above if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              all the morphisms in the limit here are isomorphisms, hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %msub
                      %mi Id
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots = Id_{A(X)}
                    \\,.
          .un_lemma
            %h6#lemma_3 Lemma
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \subset PSh(S)
              factors as an epimorphism followed by a monomorphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              with both being morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
          .proof
            %h6#proof_5 Proof
            %p
              Use factorization through
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coimage"} coimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              to deduce that the factorization exists not only in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              but even in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %p
              More in detail, given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              we get the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %msub
                              %mo ×
                              %mi X
                            %mi Y
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mi Y
                            %msub
                              %mo ⊔
                              %mrow
                                %mi Y
                                %msub
                                  %mo ×
                                  %mi X
                                %mi Y
                            %mi Y
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y \times_X Y &amp;&amp;\to&amp;&amp; Y
                    \\\
                    \&amp;&amp;&amp; \swarrow
                    \\\
                    \\downarrow &amp;&amp;Y \sqcup_{Y \times_X Y} Y &amp;&amp; \downarrow
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    Y &amp;&amp; \to &amp;&amp; X
                    }
                    \\,.
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is exact, the pullbacks and pushouts in this diagram remain such under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*(Y \to X)
              is an isomorphism by assumption, the all these are pullbacks and pushouts along isomorphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(S)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(S)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %p
              Since the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ⊔
                      %mrow
                        %mi Y
                        %msub
                          %mo ×
                          %mi X
                        %mi Y
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \sqcup_{Y \times_X Y} Y  \to X
              out of the
              %a.existingWikiWord{:href => "/nlab/show/coimage"} coimage
              is at the same time the
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizing
              morphism into the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mover
                        %mo →
                        %mo →
                      %mi X
                      %msub
                        %mo ⊔
                        %mi Y
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} lim(X \stackrel{\to}{\to} X \sqcup_Y X)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          .un_definition
            %h6#definition_6 Definition
            %p
              The monomorphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              which are in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              are called
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
          .un_lemma
            %h6#lemma_4 Lemma
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi colim
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msub
                      %mo ×
                      %mi X
                    %mi U
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Y = colim ( U \times_X U \to U  )
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msub
                      %mo ⊔
                      %mi α
                    %msub
                      %mi U
                      %mi α
                  %annotation{:encoding => "application/x-tex"} U = \sqcup_{\alpha} U_\alpha
              a disjoint union of representables
          .proof
            %h6#proof_6 Proof
            %p
              This is a direct consequence of the standard fact that subfunctors are in bijection with
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
          .un_corollary
            %h6#corollary Corollary
            %p
              If a presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local
              with respect to all
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                    %mo =
                    %mi colim
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi W
                            %mtd
                              %mover
                                %mo →
                                %mo →
                            %mtd
                              %mi U
                          %mtr
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %mi dense
                                  %mi mono
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi Id
                          %mtr
                            %mtd
                              %mi U
                              %msub
                                %mo ×
                                %mi X
                              %mi U
                            %mtd
                              %mover
                                %mo →
                                %mo →
                            %mtd
                              %mi U
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y
                    \\\
                    \\downarrow
                    \\\
                    X
                    }
                    \=
                    colim
                    \\left(
                    \\array{
                    W &amp;\stackrel{\to}{\to}&amp; U
                    \\\
                    \\;\;\downarrow^{dense mono} &amp;&amp; \downarrow^{Id}
                    \\\
                    U \times_X U &amp; \stackrel{\to}{\to}&amp;  U
                    }
                    \\right)
            %p
              with the left vertical morphism a
              %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
            %p
              (and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msub
                      %mo ⊔
                      %mi α
                    %msub
                      %mi U
                      %mi α
                  %annotation{:encoding => "application/x-tex"} U = \sqcup_\alpha U_\alpha
              the disjoint union (of representable presheaves) over a
              = succeed "ing" do
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
          .un_definition
            %h6#definition_7 Definition
            %p
              The morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              with representable codomain
            %ul
              %li
                %p
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi colim
                        %mo{:stretchy => "false"} (
                        %mi U
                        %msub
                          %mo ×
                          %mi X
                        %mi U
                        %mover
                          %mo →
                          %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} colim (U \times_X U \stackrel{\to}{\to} U) \to X
                  as above are
                  = succeed "s:" do
                    %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              %li
                %p
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi colim
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mover
                          %mo →
                          %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} colim (W  \stackrel{\to}{\to} U) \to X
                  (with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  a cover of
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %msub
                            %mo ×
                            %mi X
                          %mi U
                        %annotation{:encoding => "application/x-tex"} U \times_X U
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
            %p
              of the representable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .un_proposition
            %h6#proposition_4 Proposition
            %p
              A presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
          %blockquote
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
              \: the above shows this almost. I am not sure yet how to see the remaining bit directly, without making recourse to the full machinery leading up to section VII, 4, corollary 7 in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
          %p So we finally conclude:
          .un_corollary
            %h6#corollaries Corollaries
            %p We have:
            %ul
              %li
                %p
                  Systems
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  of weak equivalences defined by choice of
                  %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f : Sh(S) \to PSh(S)
                  are in canonical bijection with choice of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              %li
                %p
                  A presheaf
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  = succeed "-local," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
          %p
            From the
            %em assumption
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : Sh(S) \to PSh(S)
            is a
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            follows at once the following explicit description of the
            %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* : PSh(S) \to Sh(S)
          .un_lemma
            %h6#lemma_sheafification Lemma (Sheafification)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PSh(S)
              a presheaf, its
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mo =
                    %msub
                      %mi f
                      %mo *
                    %msup
                      %mi f
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \bar A := f_* f^* A
              is the presheaf given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi U
                    %mo ↦
                    %msub
                      %mi colim
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi W
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\bar A : U \mapsto colim_{(Y \to U) \in W} A(Y)
          .proof
            %h6#proof_7 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(S)
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi W
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} PSh(S)[W^{-1}]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(S)
              and with morphisms given by spans out of hypercovers in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi colim
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi W
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh(S)[W^{-1}](X,A) =
                    colim_{(Y \to X) \in W} A(Y)
                    \\,.
            %p So we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mover
                                %mo ←
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mo ↘
                              %mo ≃
                          %mtd
                            %msup
                              %mo ⇓
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi W
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array {
                    Sh(S) &amp;&amp;\stackrel{\stackrel{f_*}{\to}}{\stackrel{f^*}{\leftarrow}}&amp;
                    PSh(S)
                    \\\
                    \&amp; \searrow_{\simeq}&amp;\Downarrow^{\simeq}&amp;  \downarrow
                    \\\
                    \&amp;&amp;
                    PSh(S)[W^{-1}]
                    \\,.
                    }
            %p and deduce
            %ul
              %li
                %p
                  by
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda
                  that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi PSh
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \bar A(U) = PSh_S(U, \bar A)
              %li
                %p
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} hom-adjunction
                  this is
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ⋯
                          %mo ≃
                          %msub
                            %mi Sh
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi U
                            %mo{:stretchy => "false"} ¯
                          %mo ,
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \cdots \simeq Sh_S(\bar U, \bar A)
              %li
                %p
                  by the equivalence just mentioned this is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ⋯
                          %mo ≃
                          %msub
                            %mi PSh
                            %mi S
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \cdots \simeq PSh_S[W^{-1}](U,A)
          .un_remark
            %h6#remark_covers_versus_hypercovers Remark: covers versus hypercovers
            %p
              For checking the sheaf condition the
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              one really needs the
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/plus+construction+on+presheaves"} plus-construction
          .un_definition
            %h6#definition_plusconstruction Definition: plus-construction
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PSh(S)
              a presheaf, the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/plus+construction+on+presheaves"} plus-construction
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %mo :
                    %mi X
                    %mo ↦
                    %msub
                      %mi colim
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ↪
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi W
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A^+ : X \mapsto  colim_{(Y \hookrightarrow X) \in W } A(Y)
            %p
              where the colimit is over all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar A
          .un_remark
            %h6#remark_plusconstruction_versus_sheafification Remark: plus-construction versus sheafification
            %p
              In general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A^+
              is not yet a sheaf. It is however in general closer to being a sheaf than
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is, namely it is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/separated+presheaf"} separated presheaf
            %p But applying the plus-construction twice yields the desired sheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo =
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (A^+)^+ = \bar A
                    \\,.
            %p
              This is essentially due to the fact that in the context of ordinary sheaves discussed here, all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi colim
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mover
                      %mo →
                      %mo →
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    colim(W \stackrel{\to}{\to} U)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo →
                    %mi U
                    %msub
                      %mo ×
                      %mi X
                    %mi U
                  %annotation{:encoding => "application/x-tex"} W \to U \times_X U
              a cover. For higher
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/stack"} stack
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n+2
              times; see
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/plus+construction+on+presheaves"} plus construction on presheaves
            %p
              When
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} n=\infty
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              of the sheaf
              = succeed "-topos." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %h2#examples Examples
          %p
            The archetypical example of sheaves are
            = succeed ":" do
              %em
                sheaves of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a topological space,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                a topological space and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(X)
                the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                of open subsets of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↦
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \mapsto C(U,\mathbb{C})
                of continuous functions from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                for every open subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \subset X
                is a sheaf on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(X)
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a complex manifold and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                a complex manifold, the assignment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↦
                      %msub
                        %mi C
                        %mi hol
                      %mrow
                        %mi X
                        %mo ,
                        %mi ℂ
                    %annotation{:encoding => "application/x-tex"} U \mapsto C_{hol}{X,\mathbb{C}}
