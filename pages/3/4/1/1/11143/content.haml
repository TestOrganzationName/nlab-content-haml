              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at any point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in the
              %a.existingWikiWord{:href => "/nlab/show/zero+locus"} zero locus
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/germ"} germ
              of some element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            %p
              Equivalently, germ-determined
              %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
              are precisely those
              %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
              that are closed under (possibly infinite) sums of
              %a.existingWikiWord{:href => "/nlab/show/locally+finite"} locally finite
              families. One can also take sums with coefficients in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
          #DubucTopos.num_defn
            %h6#definition_3 Definition
            %p
              %strong (Dubuc topos)
            %p
              The
              %em Dubuc topos
              is the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              on the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              is the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/germ-determined+C-infinity+ring"} germ-determined
              finitely generated
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+rings"} C-infinity rings
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#GermDeterminedCInfinityRing"}
            %p
              The resulting
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              as follows. A collection of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %mi B
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{A_i\to B\}_{i\in I}
              in this category is a
              %a.existingWikiWord{:href => "/nlab/show/covering+family"} covering family
              if for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i\in I
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+rings"} C-infinity rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} B \to A_i
              is isomorphic to a
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              map at some element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi i
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b_i\in B
            %p
              Here
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              is defined using a universal property formulated in the category of
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+rings"} C-infinity rings
              and need not coincide with the usual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/localization+of+commutative+rings"} localization of commutative rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              to the family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %mi B
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{A_i\to B\}_{i\in I}
              produces a jointly surjective family of
              %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p
              Here the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              is the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint+functor"} right adjoint functor
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+functor"} opposite functor
              of the inclusion of finitely generated point-determined
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+rings"} C-infinity rings
              into finitely generated germ-determined
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/C-infinity+rings"} C-infinity rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(C^\infty(M)/I)
              for a germ-determined
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              can be described as the
              %a.existingWikiWord{:href => "/nlab/show/zero+locus"} zero locus
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+ring"} C-infinity ring
              using its
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+ring"} C-infinity ring
              of smooth functions.
            %p
              Here a finitely generated
              %a.existingWikiWord{:href => "/nlab/show/C-infinity+ring"} C-infinity ring
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} C^\infty(M)/I
              for some
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              and
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is
              %strong point-determined
              if the
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is point-determined, which means that for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} f\in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(x)=0
              for any point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in the
              %a.existingWikiWord{:href => "/nlab/show/zero+locus"} zero locus
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
          %h2#SomeHistory Some history
          %p
            %em>
              This section is written by
              %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"} Eduardo Dubuc
            \.
          %p
            In papers on
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} SDG
            one can find phrases of the type “We build our model after the standard manner of Moerdijk &amp; Reyes” ([MR] “
            %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"}> Models for Smooth Infinitesimal Analysis
            ”, Moerdijk and Reyes, Springer Verlag 1991). Now, this “standard manner” of building models was developed by Dubuc, and not by Moerdijk-Reyes. Of course, I understand that when a monograph is available, the proper reference is that, and not the original papers. But, phrases as the one quoted above are ambiguous, and the fault is not of the authors.
          %p
            I resume the history of the subject: In a series of papers and many lectures given specially in Montreal, Sydney, Oberwolfach and elsewhere, I created and started the development of the subject of models of SDG adapted for the applications to classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
          %ol
            %li
              %p
                %em> Sur les Modeles de la Geometrie Differentielle Sinthetyque
                ,
                %a.existingWikiWord{:href => "/nlab/show/Cahiers"} Cahiers de Topologie et Geometrie Differentielle
                Vol. XX-3 (1979).
            %li
              %p
                %em> Schemas C-inf (amplified version of [3], with detailed proofs and many examples)
                , “Prepublications de la Universite de Montreal” 80-81 edited by G. Reyes (1980).
            %li
              %p
                %em> C-inf Schemes
                , American Journal of Mathematics, John Hopkins University, Vol. 103-4 (1981).
            %li
              %p
                %em> Open Covers and Infinitary Operations in C-inf-rings
                , Cahiers de Topologie et Geometrie Differentielle Vol. XXII-3 (1981).
            %li
              %p
                %em> Integracion de campos vectoriales y Geometria Diferencial Sintetica
                , Proceedings of the VII Sem. Nac. de Mat., FAMAF, Univ. Nac. de Cordoba (1984).
            %li
              %p
                %em> Germ representability and Local integration of vector fields in a well adapted model of SDG
                , Aarhus Univ. Math. Inst. preprint series (1985/1986), (Journal of Pure and Applied Algebra Vol. 64, 1990).
            %li
              %p
                %em Archimedian Local C-inf-rings and Models of SDG
                (with
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"} Marta Bunge
            %li
              %p
                %em Local concepts in SDG and germ representability
                (with Marta Bunge), in D. Kueker et al. (ads), Mathematical Logic and Theoretical Computer Science, Lecture Notes in Pure and Applied Mathematics 106, Marcel Dekker (1987)
          %p
            A) I introduced the concept, coined the name “
            %span.newWikiWord>
              well-adapted model
              %a{:href => "/nlab/new/well-adapted+model"} ?
            ”, and constructed the first ones. I considered the two essential properties:
          %p
            i) preservation of all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
          %p
            ii) preservation of
            %a.existingWikiWord{:href => "/nlab/show/transversal+maps"} transversal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
          %p
            B) I started a systematic study of
            %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} C-infinity rings
            as such. Of course, they were already there, but nothing had been done with them. I even had to state and prove such simple facts as that the algebraic quotient of a C-infinity ring by an R-algebra ideal had a canonical structure of C-infinity ring, and was then the quotient in this category.
          %p
            I introduced the key notion of Germ Determined Ideal (or ideal of local nature), which was, as such, nowhere to be found in the literature, and stated and proved their basic properties. This, I think, is the most important concept in the subject. It is the basic definition to start to build upon. It is just the right concept needed. Among other things, I first proved it contains all finitely generated ideals, and defines the largest possible class of C-infinity rings consistent with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nullstellensatz"} Nullstellensatz
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            inverts universally a function which is non-zero exactly on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (every Euclidean open is C-infinity Zariski).
          %p
            %em
              When incorporating this work in their monograph Moerdijk and Reyes say (I quote): “Although this general notion of C-infinity ring does not occur as such in classical analysis and differential geometry, the main examples do … Given the role of these examples of C-infinity rings in the classical literature, it is not surprising that although the statements of several of the results in this chapter seem new, most of their proofs are either known or easily derivable from known ones”. This is, at the least, misleading, and I see a clear intention to disqualify my work. Of course, when the new concepts are introduced, the examples are already there, and the proof of the basic properties is easy. The important thing is to identify explicitly the concept, and to identify the right statements and properties, and this does not come easily. And I repeat, even if C-infinity rings may have been there, the concept of germ determined ideal was not, neither the concept of
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            C) With this in hand, I introduced the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            for the open covering topology on the dual of the category of C-infinity rings presented by a germ determined ideal, and proved all the basic important properties, which many times are the correct relative C-infinity versions of corresponding properties in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            %a.existingWikiWord{:href => "/nlab/show/Zariski+topos"} Zariski topos
            of algebraic geometry (here we should notice that the Zariski topos is defined by the topology of all open covers, this is essential. Moerdijk-Reyes, misunderstanding Zariski, call Smooth-Zariski, the topos determined by the finite covers).
          %p
            The topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the best known model in order to do applications of SDG to classical differential geometry, and as such, it is the most utilized in practice. Many early workers in the subject (
            %a.existingWikiWord{:href => "/nlab/show/Jacques+Penon"}> J. Penon
            , O. Bruno, M. Bunge, F. Gago,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/David+Yetter"} Yetter
          %p
            %em
              In their monograph they say (I quote): “As far as terminology is concerned, we have tried to avoid descriptions of the type ”the
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Moerdijk
              envelop of the Reyes topos“, in favor of more informative ones”. But the true fact was that the only name that was involved was “Dubuc”, since no other new name was being utilized at the time (of course, things as
              %a.existingWikiWord{:href => "/nlab/show/Kock-Lawvere+axiom"} Kock-Lawvere axiom
              or
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebras"} Weil algebras
              were not aimed by this philosophy, and “Moerdijk envelop of the Reyes topos” was an invention to reduce to the ridiculous, the fact of naming things after “Dubuc”.
          %p D) I should mention here that I do not ignore the fact that my work is acknowledged and referenced in the monograph, but the matter is much more subtle, and nobody can deny the evidence of the following consequence of their maneuvering:
          %p My name, as time passes, and as young people appear, is less and less credited with a subject that I created and developed, namely, models of SDG adapted to classical differential geometry. People talk as if the well adapted models were always there, or start referring to them in a way that lead inexperienced (in the subject) readers to believe that these constructions are “M-R way of doing models”, as I quoted at the beginning of this note.
          %p
            E) This does not do justice to my work, and does not corresponds to the true history of the subject. As an starting point to remedy it, I request all workers that need to use the topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            %strong REMARK.
            Proposition 18 and Theorem 22 of 6. cited above establish that postulate WA2 (II, 3.2, 3.3) of 8. holds in the Dubuc Topos. However, there is a mistake (discovered by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"} M. Makkai
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
                ,
                = succeed "," do
                  %em Sur les modèles de la géométrie différentielle synthétique
                %a.existingWikiWord{:href => "/nlab/show/Cahiers"} Cahiers de Topologie et Geometrie Differentielle
                Vol. XX-3 (1979) &amp;lbrack;
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1979__20_3_231_0"}> numdam:CTGDC_1979__20_3_231_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
                ,
                = succeed "," do
                  %em
                    Schemas
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} C^\infty
          %p This preprint is an amplified version of the following article, with detailed proofs and many examples:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} C^\infty
                    Schemes
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/2374046"} jstor:2374046
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
                ,
                = succeed "," do
