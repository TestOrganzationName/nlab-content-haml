                    %mspace{:width => "thickmathspace"}
                    %mi M
                    %mi U
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    c \;\colon\; M U \longrightarrow E
            %p
              that represents the complex orientation by lemma
              %a.maruku-ref{:href => "#S2SpectrumMapFromComplexOrientation"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectra"} homotopy commutative ring spectra
          %p
            (
            %a{:href => "#Lurie10"}> Lurie 10, lecture 6, prop. 6
            )
          .proof
            %h6#proof_6 Proof
            %p The unitality condition demands that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝕊
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi M
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi c
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{S}
                    \&amp;\overset{}{\longrightarrow}&amp;
                    M U
                    \\\
                    \&amp; \searrow &amp; \downarrow^{\mathrlap{c}}
                    \\\
                    \&amp;&amp; E
                    }
            %p
              commutes in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi M
                            %msub
                              %mi U
                              %mrow
                                %mn 2
                                %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi c
                                    %mi n
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %mn 2
                                %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{2n}
                    \&amp;\overset{}{\longrightarrow}&amp;
                    M U_{2n}
                    \\\
                    \&amp; \searrow &amp; \downarrow^{\mathrlap{c_n}}
                    \\\
                    \&amp;&amp; E_{2n}
                    }
            %p
              commutes up to homotopy, hence that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                  %annotation{:encoding => "application/x-tex"} c_n
              to a fiber is the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %mn 2
                          %mi n
                    %annotation{:encoding => "application/x-tex"} E_{2n}
              = succeed ":" do
                %a.maruku-ref{:href => "#ThomClassesCFClass"}
            %p
              Hence componentwise all these triangles commute up to some homotopy. Now we invoke the
              %a.existingWikiWord{:href => "/nlab/show/Milnor+sequence"} Milnor sequence
              for generalized cohomology of spectra (
              %a{:href => "lim^1+and+Milnor+sequences#CohomologyOfSpectraMilnorSequence"}> prop.
              ). Observe that the
              %a.existingWikiWord{:href => "/nlab/show/tower"} tower
              of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ↦
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \mapsto E^{n_1}(S^n)
              is actually constant (
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"}> suspension isomorphism
              ) hence trivially satisfies the
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              and so a homotopy of morphisms of spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbb{S} \to E
              exists as soon as there are componentwise homotopies (
              %a{:href => "lim^1+and+Milnor+sequences#WithSomeLefflerTheHomsOfSpectraAreHomotopicIfComponentsAre"}> cor.
              ).
            %p Next, the respect for the product demands that the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi M
                            %mi U
                            %mo ∧
                            %mi M
                            %mi U
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi c
                                %mo ∧
                                %mi c
                          %mtd
                            %mi E
                            %mo ∧
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi M
                            %mi U
                          %mtd
                            %munder
                              %mo ⟶
                              %mi c
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    M U \wedge M U
                    \&amp;\overset{c \wedge c}{\longrightarrow}&amp;
                    E \wedge E
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    M U
                    \&amp;\underset{c}{\longrightarrow}&amp;
                    E
                    }
            %p
              commutes in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} Ho(OrthSpec(Top_{cg}))_{stable}
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+orthogonal+spectra"} model structure on orthogonal spectra
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#SequentialSpectraQuillenEquivalence"}> thm.
              ).
            %p
              Here the derived
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              is given by
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#SsymModuleSymmetricSpectra"}> def.
              ) and maps out of such a product are equivalently as in the above diagram is equivalent (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#DayConvolutionViaNaturalIsosInvolvingExternalTensorAndTensor"}> cor.
              ) to a suitably equivariant collection diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi M
                            %msub
                              %mi U
                              %mrow
                                %mn 2
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %mi M
                            %msub
                              %mi U
                              %mrow
                                %mn 2
                                %msub
                                  %mi n
                                  %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi c
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                %mo ∧
                                %msub
                                  %mi c
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %mn 2
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi E
                              %mrow
                                %mn 2
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi M
                            %msub
                              %mi U
                              %mrow
                                %mn 2
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi c
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi n
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %mn 2
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                                %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    M U_{2 n_1} \wedge M U_{2 n_2}
                    \&amp;\overset{c_{n_1} \wedge c_{n_2}}{\longrightarrow}&amp;
                    E_{2 n_1} \wedge E_{2 n_2}
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    M U_{2(n_1 + n_2)}
                    \&amp;\underset{c_{(n_1 + n_2)}}{\longrightarrow}&amp;
                    E_{2 (n_1 + n_2)}
                    }
                    \\,,
            %p
              where on the left we have the standard pairing operations for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi U
                  %annotation{:encoding => "application/x-tex"} M U
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#OrthogonalComplexThomSpectrum"}> def.
              ) and on the right we have the given pairing on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              That this indeed commutes up to homotopy is the Whitney sum formula for Chern classes (
              %a{:href => "Chern+class#WhitneySumChernClasses"}> prop.
              ).
            %p
              Hence again we have componentwise homotopies. And again the relevant
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              on
              = succeed "-holds," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ↦
                      %msup
                        %mi E
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi MU
                      %mo ∧
                      %mi MU
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n \mapsto E^{n-1}((MU \wedge MU)_n)
              %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+classes"} Conner-Floyd classes
              (
              %a{:href => "Conner-Floyd+Chern+class#ConnerFloyedClasses"}> prop.
              ). Therefore these componentwise homotopies imply the required homotopy of morphisms of spectra (
              %a{:href => "lim^1+and+Milnor+sequences#WithSomeLefflerTheHomsOfSpectraAreHomotopicIfComponentsAre"}> cor.
              ).
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ). Then the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi U
                    %mover
                      %mo ⟶
                      %mi c
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi M
                    %msub
                      %mi U
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (M U \overset{c}{\longrightarrow} E)
                    \\;\mapsto\;
                    (B U(1) \simeq M U_{2} \overset{c_1}{\longrightarrow} E_2)
            %p
              which sends a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectra"} homotopy commutative ring spectra
              to its component map in degree 2, interpreted as a class on
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(1)
              via lemma
              = succeed "," do
                %a.maruku-ref{:href => "#UniversalComplexLineBundleThomSpace"}
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              from homotopy classes of homomorphisms of homotopy commutative ring spectra to complex orientations (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StrictComplexOrientation"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            (
            %a{:href => "#Lurie10"}> Lurie 10, lecture 6, theorem 8
            )
          .proof
            %h6#proof_7 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#S2SpectrumMapFromComplexOrientation"}
              and lemma
              %a.maruku-ref{:href => "#HRingSpectrumS2SpectrumMapFromComplexOrientation"}
              the map is surjective, hence it only remains to show that it is injective.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mi U
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} c, c' \colon M U \to E
              be two morphisms of homotopy commutative ring spectra that have the same restriction, up to homotopy, to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ≃
                      %msub
                        %mi c
                        %mn 1
                      %mo ′
                      %mo{:lspace => "verythinmathspace"} :
                      %mi M
                      %msub
                        %mi U
                        %mn 2
                      %mo ≃
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_1 \simeq c_1'\colon M U_2 \simeq B U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                    %mo ,
                    %mi c
                    %msub
                      %mo ′
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %msub
                      %mi U
                      %mrow
                        %mn 2
                        %mi n
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} c_n, c'_n \colon M U_{2n} \to E_{2 n}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mo ∧
                          %mi n
                  %annotation{:encoding => "application/x-tex"} B U(1)^{\wedge^n}
              is a product of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ≃
                      %mi c
                      %msub
                        %mo ′
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} c_1 \simeq c'_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                  %annotation{:encoding => "application/x-tex"} c_n
              becomes homotopic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} c_n'
              after this restriction. But by the
              %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
              this restriction is injective on cohomology classes, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                  %annotation{:encoding => "application/x-tex"} c_n
              itself ist already homotopic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %msub
                        %mo ′
                        %mi n
                    %annotation{:encoding => "application/x-tex"} c'_n
            %p It remains to see that these homotopies may be chosen compatibly such as to form a single homotopy of maps of spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi M
                    %mi U
                    %mo ∧
                    %msub
                      %mi I
                      %mo +
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; M U \wedge I_+ \longrightarrow E
                    \\,,
            %p
              This follows due to the existence of the
              %a.existingWikiWord{:href => "/nlab/show/Milnor+exact+sequence"} Milnor
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
