                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B U(n)
          .proof
            %h6#proof Proof
            %p When exhibited by a fibration, here the vertical morphism is equivalently the quotient map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E U(n))/U(n-1) \longrightarrow (E U(n))/U(n)
            %p
              (by the proof of
              = succeed ")." do
                %a{:href => "classifying+space#SphereFibrationOverInclusionOfClassifyingSpaces"} this prop.
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E U(n)
              is (
              %a{:href => "classifying+space#EOn"}> def.
              ) equivalently the colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E U(n) \simeq \underset{\longrightarrow}{\lim}_k  U(k)/U(k-n)
                    \\,.
            %p
              Here each
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifold"} Stiefel manifold
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/U(k-n)
              is equivalently the space of (complex)
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^k
              that are equipped with an orthonormal (hermitian)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℂ
                      %mi n
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    E U(n) \underset{U(n)}{\times} \mathbb{C}^n
                    \\simeq
                    \\underset{\longrightarrow}{\lim}_k  U(k)/U(k-n) \underset{U(n)}{\times} \mathbb{C}^n
            %p has as fiber precisely the linear span of any such choice of basis.
            %p
              While the quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/(U(n-k)\times U(n))
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/(U(n-k) \times U(n-1))
              leaves the choice of precisly one unit vector. This is parameterized by the sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2n-1}
              which is thereby identified as the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              in the respective fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo ×
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %msup
                        %mi ℂ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E U(n) \underset{U(n)}{\times} \mathbb{C}^n
          %p In particular:
          #UniversalComplexLineBundleThomSpace.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/zero-section+into+Thom+space+of+universal+line+bundle+is+weak+equivalence"}> zero-section into Thom space of universal line bundle is weak equivalence
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/zero-section"} zero-section
              map from the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \simeq \mathbb{C}P^\infty
              (the infinite
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              (the
              %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological line bundle
              on infinite
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mi M
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B U(1)
                    \\overset{\in W_{cl}}{\longrightarrow}
                    M U(1)
                    \\coloneqq
                    Th( E U(1) \underset{U(1)}{\times} \mathbb{C})
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Adams74"} Adams 74, Part I, Example 2.1
          .proof
            %h6#proof_2 Proof
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              is naturally identified with the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U (1) \simeq S(\mathbb{S})
              %a.existingWikiWord{:href => "/nlab/show/sphere+bundle"} sphere bundle
              of the universal complex line bundle is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E U(1) \underset{U(1)}{\times} S(\mathbb{C})
                    \&amp;
                    \\;\simeq\;
                    E U(1) \underset{U(1)}{\times} U(1)
                    \\\
                    \&amp;
                    \\;\simeq\;
                    E U(1)
                    \\end{aligned}
                    \\,.
            %p
              But the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E U(1) \overset{\in W_{cl}}{\longrightarrow} \ast
                    \\,.
            %p
              (Alternatively this is the special case of lemma
              %a.maruku-ref{:href => "#SphereBundleBunminus1"}
              for
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the universal complex line bundle is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                            %mspace{:width => "thickmathspace"}
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                            %mspace{:width => "thickmathspace"}
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Th( E U(1) \underset{U(1)}{\times} \mathbb{C} )
                    \&amp;
                    \\;\coloneqq\;
                    D( E U(1) \underset{U(1)}{\times} \mathbb{C} )
                    \/
                    S( E U(1) \underset{U(1)}{\times} \mathbb{C} )
                    \\\
                    \&amp;
                    \\;\overset{\in W_{cl}}{\longrightarrow}\;
                    D( E U(1) \underset{U(1)}{\times} \mathbb{C} )
                    \\\
                    \&amp;
                    \\;\overset{\in W_{cl}}{\longrightarrow}\;
                    B U(1)
                    \\end{aligned}
                    \\,.
          #UniversalComplexVectorBundleThomSpace.num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology
              theory, the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the complex
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              is equivalently the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
              of
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              relative
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
