            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo ×
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} (-)\cdot (-) \colon S \times S \to S
            from the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ×
                  %mi S
                %annotation{:encoding => "application/x-tex"} S \times S
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong magma
            (or binary algebraic structure, or, alternatively, a mono-binary algebra)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S,\cdot)
            is a set equipped with a binary operation on it.
          %p A magma is called
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/unital+magma"} unital
                if it has a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/identity+element"} neutral element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} 1 \in S
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⋅
                        %mi x
                        %mo =
                        %mi x
                        %mo =
                        %mi x
                        %mo ⋅
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1 \cdot x = x = x \cdot 1
                %a.existingWikiWord{:href => "/nlab/show/Borceux-Bourn"} Borceux-Bourn
                Def. 1.2.1). One can consider one-sided unital elements separately:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi L
                      %mo ⋅
                      %mi x
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1_L \cdot x = x
                and/or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mi x
                        %mo ⋅
                        %msub
                          %mn 1
                          %mi R
                      %annotation{:encoding => "application/x-tex"} x = x \cdot 1_R
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/commutative+magma"} commutative
                if the binary operation takes the same value when its two arguments are interchanged:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⋅
                        %mi y
                        %mo =
                        %mi y
                        %mo ⋅
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \cdot y = y \cdot x
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/associative+magma"} associative
                if the binary operation satisfies the
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
                condition
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ⋅
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi z
                        %mo =
                        %mi x
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ⋅
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x \cdot y) \cdot z = x \cdot (y \cdot z)
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/invertible+magma"} invertible
                if it has an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inverse+element"} inverse element
            %li
              %p
                an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/absorption+magma"} absorption magma
                if it has an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} 0 \in S
                such that the binary operation satisfies the absorption condition:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ⋅
                        %mi x
                        %mo =
                        %mi x
                        %mo ⋅
                        %mn 0
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0 \cdot x = x \cdot 0 = 0
            %li
              %p
                a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/quasigroup"} quasigroup
                if one-sided multiplication by any element is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            A magma has a
            %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msqrt
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo :
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} \sqrt{-}:S \to S
            if for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msqrt
                    %mrow
                      %mi x
                      %mo ⋅
                      %mi x
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} \sqrt{x \cdot x} = x
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mi x
                    %mo ⋅
                    %msqrt
                      %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \sqrt{x} \cdot \sqrt{x} = x
          %p
            The term ‘magma’ is from
            %a.existingWikiWord{:href => "/nlab/show/Bourbaki"} Bourbaki
            and is intended to suggest the fluidity of the concept; special cases include
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unital+magmas"} unital magmas
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/semigroups"} semigroups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasigroups"} quasigroups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} something else
            (see also related discussion at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/historical+notes+on+quasigroups"} historical notes on quasigroups
          %p
            More generally, in any
            %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %strong magma object
            or
            %strong
              magma in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/multimorphism"} multimorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi X
                  %mo ,
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} m: X, X \to X
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "." do
              %strong
                binary operation in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⊗
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} m\colon X \otimes X \to X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} m\colon X \to [X, X]
          %h2#properties Properties
          %h3#square Square function
          %p
            Every magma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\cdot)
            has a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo :
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} (-)^2:M \to M
            called the
            %strong square
            and defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                  %mo :
                  %mo =
                  %mi x
                  %mo ⋅
                  %mi x
                %annotation{:encoding => "application/x-tex"} x^2 := x \cdot x
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x \in M
          %h3#magmas_as_actions Magmas as actions
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on another set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi act
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} act:A \times B \to B
          %h3#opposite_magmas Opposite magmas
          %p
            There exists a function on the binary operation set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B:(M\times M\to M)\to (M\times M\to M)
            called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            that takes every binary operation on the set to its opposite binary operation, where for every magma operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} m:M\times M\to M
            and for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(m)(a,b) = m(b,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with the opposite binary operation is the
            %a.existingWikiWord{:href => "/nlab/show/opposite+magma"} opposite magma
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are called
            %strong
              %a.existingWikiWord{:href => "/nlab/show/commutative+magma"} commutative
            binary operations.
          %h2#free_magmas Free magmas
          %p
            The free magma on one generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo ⋅
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M, \cdot, 1)
            is a model of nesting parentheses around a magma, and is important in the study of
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            as
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in
            %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-categories"} (n,r)-categories
            and
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-categories"} (infinity,n)-categories
            are not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative"} associative
            %a.existingWikiWord{:href => "/nlab/show/coherence+laws"} coherence laws
            such as the
            %a.existingWikiWord{:href => "/nlab/show/pentagon+identity"} pentagon identity
            which relate the various ways to nest parentheses around the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            magma in an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-category"} (infinity,n)-category
            with respect to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorems"} coherence theorems
            which also deal with nested parentheses around a binary operation.
          %h2#extensional_magmas Extensional magmas
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            such as
            %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional
            Martin-Loef
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            do not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} preserve equality
            = succeed "," do
              %strong extensional magmas
          %p
            For a magma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \cdot)
            and for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a, b, c:A
            %strong left extensional
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mi c
                %annotation{:encoding => "application/x-tex"} a = c
            implies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo =
                    %mi c
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \cdot b = c \cdot b
            %strong right extensional
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mi c
                %annotation{:encoding => "application/x-tex"} a = c
            implies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⋅
                    %mi a
                    %mo =
                    %mi b
                    %mo ⋅
                    %mi c
                  %annotation{:encoding => "application/x-tex"} b \cdot a = b \cdot c
            %strong extensional
            if it is both left and right extensional.
