          %h2#idea Idea
          %p
            The
            %em quantum geometric Langlands correspondence
            is a conjectured equivalence between the
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of certain twisted
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/D-module"} D-module
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/reductive+group"} reductive group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-bundles," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi L
                    %mi G
                  %annotation{:encoding => "application/x-tex"} {}^L G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi L
                  %mi G
                %annotation{:encoding => "application/x-tex"} {}^L G
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Langlands+dual+group"} Langlands dual group
          %p
            In a certain limit of the twisting parameter the
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-modules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
          %p
            Slightly more precisely, writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bun
                    %mi G
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} Bun_G^\circ
            for the connected component of the moduli stack of
            = succeed "-bundles," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℒ
                    %mrow
                      %mo ⊗
                      %mi k
                %annotation{:encoding => "application/x-tex"} \mathcal{L}^{\otimes k}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bun
                    %mi G
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} Bun_G^\circ
            and dually a line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi ℒ
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mo ⊗
                      %mi k
                %annotation{:encoding => "application/x-tex"} \hat \mathcal{L}^{\otimes k}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bun
                    %mrow
                      %msup
                        %mrow
                        %mi L
                      %mi G
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} Bun_{{}^L G}^\circ
            and these serve to defined sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ,
                      %mi λ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{(k,\lambda)}
            of twisted differential operators on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bun
                    %mi G
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} Bun_{G}^\circ
            and dually sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi 𝒢
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ,
                      %mi λ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat \mathcal{G}^{(k,\lambda)}
            of twisted differential operators on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bun
                      %mrow
                        %msup
                          %mrow
                          %mi L
                        %mi G
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} Bun_{{}^L G}^\circ
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi λ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi ℂℙ
                    %mn 1
                  %mo ×
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (k, \lambda) \in \mathbb{CP}^1 \times \mathbb{C}
                  \\,.
          %p
            Writing then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mrow
                      %mi k
                      %mo ,
                      %mi λ
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Bun
                    %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{k,\lambda} Mod(Bun_{G})
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi 𝒟
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi k
                        %mo ,
                        %mi λ
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Bun
                      %mrow
                        %msup
                          %mrow
                          %mi L
                        %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat \mathcal{D}^{k,\lambda} Mod(Bun_{{}^L G})
          %p
            %strong Quantum geometric Langlands correspondence
          %p There is an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mrow
                      %mi k
                      %mo ,
                      %mi λ
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Bun
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mover
                      %mi 𝒟
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mfrac
                        %mn 1
                        %mi k
                      %mo ,
                      %mi λ
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Bun
                    %mrow
                      %msup
                        %mrow
                        %mi L
                      %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{D}^{k,\lambda} Mod(Bun_{G})
                  \\simeq
                  \\hat \mathcal{D}^{\frac{1}{k},\lambda} Mod(Bun_{{}^L G})
                  \\,.
          %p
            (In fact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mi k
                %annotation{:encoding => "application/x-tex"} \frac{1}{k}
            here should further be shifted by the
            %a.existingWikiWord{:href => "/nlab/show/dual+Coxeter+number"} dual Coxeter number
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi L
                    %mi G
                  %annotation{:encoding => "application/x-tex"} {}^L G
          %h2#embedding_in_string_theory Embedding in string theory
          %p
            Where the plain
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            is meant to be a shadow of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+field+theory"} 6d (2,0)-superconformal field theory
            %a.existingWikiWord{:href => "/nlab/show/little+string+theory"} little string theory
            (
            %a{:href => "#AganagicFrenkelOkounkov17"}> Aganagic-Frenkel-Okounkov 17
            ) (which turns into the 6d QFT in the limit that the strings shrink to points).
          %h2#examples Examples
          %h3#limiting_cases Limiting cases
          %p
            The twisted sheaves of differential operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mrow
                      %mi k
                      %mo ,
                      %mi λ
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{k,\lambda}
            have the following limits:
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lambda \neq 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≠
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} k \neq \infty
                this is the sheaf of differential operators acting on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℒ
                          %mrow
                            %mo ⊗
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}^{\otimes k}
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lambda \neq 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} k = \infty
                this is the pushforward
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒪
                        %mrow
                          %msub
                            %mi Loc
                            %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_*(\mathcal{O}_{Loc_G})
                of the sheaf of
                = succeed "-modules" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo :
                      %msub
                        %mi Loc
                        %mi G
                      %mo →
                      %msub
                        %mi Bun
                        %mi G
                    %annotation{:encoding => "application/x-tex"} P : Loc_G \to Bun_G
                that sends a local system to its underlying bundle;
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lambda = 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                arbitrary this is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒪
                          %mrow
                            %msup
                              %mi T
                              %mo *
                            %msubsup
                              %mi Bun
                              %mi G
                              %mo ∘
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p_*(\mathcal{O}_{T^* Bun_G^\circ})
          %h3#abelian_case Abelian case
          %p
            In the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is abelian, the quantum correspondence is given by a
            %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+transform"} Fourier-Mukai transform
            and has been constructed in (
            %a{:href => "#PolishukRothenstein"}> Polishuk-Rothenstein
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/electro-magnetic+duality"} electro-magnetic duality
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
                %li
                  %p
                    %strong quantum geometric Langlands correspondence
          %h2#references References
          %p
            The statement of the quantum geometric Langlands correspondence is surveyed on
            %a{:href => "http://arxiv.org/PS_cache/hep-th/pdf/0512/0512172v1.pdf#page=71"} page 70-71
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"}> Edward Frenkel
              ,
              %em Lectures on the Langlands Program and Conformal Field Theory
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0512172"}> arXiv:hep-th/0512172
              ).
          %p with more details in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"}> Dennis Gaitsgory
              ,
              %em Quantum Langlands Correspondence
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1601.05279"}> arXiv:1601.05279
              \&amp;rbrack;
          %p
            The construction of the correspondence in the abelian case, where it is given by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+transform"} Fourier-Mukai transform
          %ul
            %li#PolishukRothenstein
              A. Polishchuk and M. Rothstein,
              %em Fourier transform for D-algebras
              , DukeMath. J. 109 (2001) 123–146.
          %p
            An interpretation of the quantum Langlands correspondence in terms of the
            %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
            %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological string
            is given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Anton+Kapustin"}> Anton Kapustin
              ,
              %em A Note on Quantum Geometric Langlands Duality, Gauge Theory, and Quantization of the Moduli Space of Flat Connections
              (
              %a{:href => "http://arxiv.org/abs/0811.3264"}> arXiv:0811.3264
              )
          %p A general quantum geometric Langlands correspondence is produced in
          %ul
            %li#AganagicFrenkelOkounkov17
              %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"} Edward Frenkel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Okounkov"} Andrei Okounkov
              %em
                Quantum
                = succeed "-Langlands" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                      %annotation{:encoding => "application/x-tex"} q
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1701.03146"}> arXiv:1701.03146
              ,
              %a{:href => "https://doi.org/10.1090/mosc/278"} doi:10.1090/mosc/278
              \&amp;rbrack;
          %p see also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adrien+Brochier"} Adrien Brochier
              = succeed "," do
                %em Quantum character varieties and braided module categories
              %strong 24
              (2018) 4711–4748 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00029-018-0426-y"}> doi:10.1007/s00029-018-0426-y
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1606.04769"} arXiv:1606.04769
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/semi-topological+4d+Chern-Simons+theory"} semi-topological 4d Chern-Simons theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Meer+Ashwinkumar"}> Meer Ashwinkumar
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Meng-Chwan+Tan"} Meng-Chwan Tan
              %em Unifying Lattice Models, Links and Quantum Geometric Langlands via Branes in String Theory
              (
              %a{:href => "https://arxiv.org/abs/1910.01134"}> arXiv:1910.01134
              )
          %p See also
          %ul
            %li
              %p
                Peter Koroteev, Daniel S. Sage,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Anton+Zeitlin"} Anton Zeitlin
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi q
                      %annotation{:encoding => "application/x-tex"} (SL(N),q
                  )-opers, the
                  = succeed "-Langlands" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi q
                        %annotation{:encoding => "application/x-tex"} q
                (
                %a{:href => "https://arxiv.org/abs/1811.09937"}> arXiv:1811.09937
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J%C3%B6rg+Teschner"} Jörg Teschner
                %em Quantum Analytic Langlands Correspondence
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2402.00494"}> arXiv:2402.00494
