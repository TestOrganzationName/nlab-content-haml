                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{A}_{\mathbb{Z}}
                    \\coloneqq
                    \\mathbb{R} \times \widehat{\mathbb{Z}}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              of the ring of adeles is called the group of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ideles"} ideles
