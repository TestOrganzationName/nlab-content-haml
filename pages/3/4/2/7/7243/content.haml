            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            where the formal variable is the prime number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
