          %h3#relation_to_profinite_completion_of_the_integers Relation to profinite completion of the integers
          #ProfCompletionOfIntegers.num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/profinite+completion+of+the+integers"} profinite completion of the integers
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℤ
                      %mo ^
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat {\mathbb{Z}}
                    \\coloneqq
                    \\underset{\leftarrow}{\lim}_{n \in \mathbb{N}} (\mathbb{Z}/n\mathbb{Z})
                    \\,.
            %p
              This is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of the
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℤ
                      %mo ^
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mspace{:width => "thickmathspace"}
                        %mi prime
                    %msub
                      %mi ℤ
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\mathbb{Z}} \simeq \underset{p\; prime}{\prod} \mathbb{Z}_p
                    \\,.
          %p
            (
            %a{:href => "#Lenstra"}> e.g. Lenstra, example 2.2
            )
          .num_defn
            %h6#definition_2 Definition
            %p
