          %h2#Idea Idea
          %p
            For each
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            the
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            of
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-adic integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            is the
            %a.existingWikiWord{:href => "/nlab/show/formal+completion"} formal completion
            of the ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            at the
            %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            is the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+functions"} ring of functions
            on a
            %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            inside
            %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
            (this is discussed in more detail
            = succeed ")." do
              %a{:href => "#AsFormalNeighbourhoodOfPrime"} below
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
