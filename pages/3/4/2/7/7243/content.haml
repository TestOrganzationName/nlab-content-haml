          %h2#definition Definition
          %p
            For any
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %strong adic integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            (which, to avoid possible confusion with the ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)
            used in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modular+arithmetic"} modular arithmetic
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ℤ
                        %mo ^
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{Z}}_p
          %ol
            %li
              %p
                To the person on the street, it may be described as (the ring of) numbers written in base
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 0
                      %msub
                        %mi a
                        %mi n
                      %msup
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \sum_{n \geq 0} a_n p^n
              %p
                where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≤
                        %msub
                          %mi a
                          %mi n
                        %mo &lt;
                        %mi p
                      %annotation{:encoding => "application/x-tex"} 0 \leq a_n \lt p
            %li
              %p
                More abstractly, it is the
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim} \mathbb{Z}/(p^n)
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                of (unital)
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/ring"} rings
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi …
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi …
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \ldots \to \mathbb{Z}/(p^{n+1}) \to \mathbb{Z}/(p^n) \to \ldots \to \mathbb{Z}/(p) .
              %p
                This is also a limit in the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+rings"} topological rings
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topologies"} discrete topologies
            %li
              %p
                Alternatively, it is the
                %a.existingWikiWord{:href => "/nlab/show/metric+completion"} metric completion
                of the ring of
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                with respect to the
                = succeed "-adic" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniformly continuous
                with respect to the
                = succeed "-adic" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mi p
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+ring"} topological ring
            %li
              %p
                Also
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo −
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[ [ x ] ]/(x-p)\mathbb{Z}[ [ x ] ]
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/analytic+completion"} analytic completion
          %p
            Hence one also speaks of the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-
              %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
            of the integers. See
            %a.existingWikiWord{:href => "/nlab/show/completion+of+a+ring"} completion of a ring
            (which generalizes 2&amp;3).
          %p There is also this characterization:
          #pAdicIntegersAspExtensionofFpByThemselves.num_lemma
            %h6#lemma Lemma
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi ℤ
                      %mi p
                    %mover
