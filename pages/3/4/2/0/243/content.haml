                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi π
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo :
                      %mi C
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X(x, \pi_c): X(x, \int_{c: C} F(c, c)) \to X(x, F(c, c))
          %p
            are the projection maps realizing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo :
                      %mi C
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(x, \int_{c: C} F(c, c))
            as the corresponding end
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo :
                      %mi C
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_{c: C} X(x, F(c, c))
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %h4#end_as_an_equalizer End as an equalizer
          %h5#ordinary_ends_as_equalizers Ordinary ends as equalizers
          %p
            Now we motivate and define the
            %em end
            in
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
          %p
            Recall from the discussion at the end of
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            that the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            over an (ordinary, i.e., not enriched)
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  F : C^{op} \to Set
          %p
            is given by the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi f
                          %mo ∈
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi p
                        %mrow
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{c \in Obj(C)}
                  F(c)
                  \\stackrel{\prod_{f \in Mor(c)} (F(f) \circ p_{t(f)}) }{\to}
                  \\prod_{f \in Mor(C)}
                  F(s(f))
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi f
                          %mo ∈
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mrow
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{c \in Obj(C)}
                  F(c)
                  \\stackrel{\prod_{f \in Mor(c)} (p_{s(f)}) }{\to}
                  \\prod_{f \in Mor(C)}
                  F(s(f))
                  \\,.
          %p
            If we want to generalize an expression like this to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p To that end, observe that we have a canonical isomorphism (of sets, still)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mover
                          %mo →
                          %mi f
                        %msub
                          %mi c
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{{(c_1 \stackrel{f}{\to} c_2)} \in Mor(C)} F(c_1)
                  \\simeq
                  \\prod_{c_1,c_2 \in Obj(C)} F(c_1)^{C(c_1,c_2)}
                  \\,.
          %p
            If we write for the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            instead
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [C(c_1,c_2), F(c_1)] := F(c_1)^{C(c_1,c_2)}
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p
            Still equivalently, but suggestively rewriting the above, we now obtain the limit over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mover
                      %mo →
                      %mi λ
                    %mover
                      %mo →
                      %mi ρ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{c \in Obj(C)}
                  F(c)
                  \\stackrel{\stackrel{\rho}{\to}}{\stackrel{\lambda}{\to}}
                  \\prod_{c_1,c_2 \in Obj(C)}
                  [C(c_1,c_2),F(c_1)]
                  \\,,
          %p where in components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\rho_{c_1, c_2} : F(c_1) \to [C(c_1,c_2), F(c_1)]
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo *
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  C(c_1, c_2) \to * \to [F(c_1), F(c_1)]
          %p
            (with the last map the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Id_{F(c_1)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\lambda_{c_1, c_2} : F(c_2) \to [C(c_1,c_2), F(c_1)]
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_{c_1, c_2} : C(c_1, c_2) \to [F(c_2), F(c_1)]
                  \\,.
          %p So, for definiteness, the equalizer we are looking at is that of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo ∈
                      %mi C
                  %msub
                    %mi ρ
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                  %mo ∘
                  %msub
                    %mi pr
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\rho := \prod_{c_1, c_2 \in C} \rho_{c_1,c_2}\circ pr_{F(c_1)}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                      %mo ∈
                      %mi C
                  %msub
                    %mi λ
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ,
                      %msub
                        %mi c
                        %mn 2
                  %mo ∘
                  %msub
                    %mi pr
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\lambda := \prod_{c_1, c_2 \in C} \lambda_{c_1,c_2}\circ pr_{F(c_2)}
          %p
            This way of writing the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            clearly suggests that it is more natural to have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
