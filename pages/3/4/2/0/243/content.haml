                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\coprod_{c,c'} C(-,c) \times C(c,c') \times C(c',-)
                  \\,\rightrightarrows\,
                  \\coprod_c C(-,c) \times C(c,-) \,\to\, C(-,-)
          %p
            It is also a general fact (see e.g.
            = succeed ")" do
              %a{:href => "#Kelly82"} Kelly, ch. 3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi W
                  %mo *
                  %mi V
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} }
                  %mo ≅
                  %mo{:stretchy => "false"} {
                  %mi W
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi V
                  %mo −
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{W \ast V, F\} \cong \{W, \{V-, F\}\}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo *
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo *
                  %mi G
                  %mo ≅
                  %mi W
                  %mo *
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo *
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W \ast V) \ast G \cong W \ast (V \ast G)
          %p
            This implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{-,F\}
            takes the coequalizer above to an equalizer, which, after some fiddling with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:endeq"} (1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo *
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (- \ast F)
            takes the analogous coequalizer presentation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{op}(-,-)
            to
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:coendcoeq"} (2)
          %h2#Properties Properties
          %h3#SetCoendsAsColimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            \-enriched coends as ordinary colimits
          %p
            Let the enriching category be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{V} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "/colimits" do
              %a.existingWikiWord{:href => "/nlab/show/weighted+limits"} weighted limits
          %p Consider
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                a
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensored
                over
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                be a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F : D \to C
                a functor;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} W : D^{op} \to Set
                another functor;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi el
                      %mi W
                    %annotation{:encoding => "application/x-tex"} el W
                the
                %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
          %p
          #CoendAsColimitOverCategoryOfElements.num_prop
            %h6 Proposition
            %p
              %strong
                (coend as
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              %br/
              There is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mi d
                        %mo ∈
                        %mi D
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi el
                    %mi W
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi D
                    %mover
                      %mo →
                      %mi F
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{d \in D} W(d) \cdot F(d)
                    \\simeq
                    \\lim_{\to}(
                    (el W)^{op} \to D \stackrel{F}{\to} C
                    )
            %p
              between the coend, as indicated, and the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %p
          %p
            This is equation (3.34) in (
            %a{:href => "#Kelly82"}> Kelly
            ) in view of (3.70).
          #ConPres.num_cor
            %h6#corollary Corollary
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/continuous+functor"} continuous functor
              preserves ends, and any cocontinuous functor preserves coends. In particular, for functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F: D^{op} \times D \to C
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∫
                              %mi x
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≅
                            %msub
                              %mo ∫
                              %mi x
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %msub
                              %mo ∫
                              %mi x
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≅
                            %msub
                              %mo ∫
                              %mi x
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    C(\int^x F(x, x), c) &amp;\cong \int_x C(F(x, x), c)\\
                    C(c, \int_x F(x, x)) &amp;\cong \int_x C(c, F(x, x)).
                    \\end{aligned}
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W = D(-,e)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi el
                    %mi W
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} /
                    %mi e
                  %annotation{:encoding => "application/x-tex"}
                    (el W)^{op} = D/e
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
              over the representing object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mover
                        %mo →
                        %mi Id
                      %mi e
                    %annotation{:encoding => "application/x-tex"} (e \stackrel{Id}{\to} e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} /
                    %mi e
                    %mo →
                    %mi D
                    %mover
                      %mo →
                      %mi F
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_\to( D/e \to D \stackrel{F}{\to} C) \simeq F(e)
                    \\,.
            %p
              Since this is natural in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mi k
                        %mo ∈
                        %mi D
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(-) \simeq \int^{k \in D} D(k,-) \cdot F(k)
                    \\,.
            %p
              This statement is sometimes called the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
          %p
            More generally, ends and coends may be expressed as limits and colimits from the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+category"} twisted arrow category
          %h3#commutativity_of_ends_and_coends Commutativity of ends and coends
          %p
            Ordinary
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %em Fubini theorem
            for ends (for instance
            = succeed ")." do
              %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf#page=35"} Kelly, p. 29
          %p
          #Fubini.num_prop
            %h6 Proposition
            %p
              %strong (Fubini theorem for ends)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be small
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ⊗
                    %mi ℬ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ⊗
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"}
                    T \colon (\mathcal{A} \otimes \mathcal{B})^{op} \otimes
                    (\mathcal{A} \otimes \mathcal{B})
                    \\to
                    \\mathcal{V}
            %p
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            %p
              If for all object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ,
                    %mi B
                    %mo ′
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B,B' \in \mathcal{B}
              the end
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi A
                        %mo ∈
                        %mi 𝒜
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_{A \in \mathcal{A}} T(A,B,A,B')
              exists, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi 𝒜
                        %mo ⊗
                        %mi ℬ
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ∫
                      %mrow
                        %mi A
                        %mo ∈
                        %mi 𝒜
                    %msub
                      %mo ∫
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{(A,B) \in \mathcal{A} \otimes \mathcal{B}}
                    T(A,B,A,B)
                    \\simeq
                    \\int_{A \in \mathcal{A}}
                    \\int_{B \in \mathcal{B}}
                    T(A,B,A,B)
            %p
              if either side exists. In particular, since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                      %mo ⊗
                      %mi ℬ
                      %mo ≃
                      %mi ℬ
                      %mo ⊗
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A} \otimes \mathcal{B} \simeq \mathcal{B} \otimes \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                    %msub
                      %mo ∫
                      %mrow
                        %mi A
                        %mo ∈
                        %mi 𝒜
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ∫
                      %mrow
                        %mi A
                        %mo ∈
                        %mi 𝒜
                    %msub
                      %mo ∫
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{B \in \mathcal{B}}
                    \\int_{A \in \mathcal{A}}
                    T(A,B,A,B)
                    \\simeq
                    \\int_{A \in \mathcal{A}}
                    \\int_{B \in \mathcal{B}}
                    T(A,B,A,B),
            %p if either side exists.
          %h2#examples Examples
          %h3#natural_transformations Natural transformations
          #NatTrans.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F, G: C \to D
              be
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between two categories, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [C, D] (F, G)
              be the set of
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between them. Then, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C, D] (F, G) = \int_{c \in C} D(F(c), G(c)).
          .proof
            %h6#proof Proof
            %p
              An element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_{c \in C} D(F(c), G(c))
              is, by definition, a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi c
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_c: F(c) \to G(c)
              of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              such that, for any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f: c \to d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi τ
                                    %mi c
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi τ
                                    %mi d
                        %mtr
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi G
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(c) &amp; \overset{F(f)}{\to} &amp; F(d)\\
                    ^\mathllap{\tau_c}\downarrow &amp; &amp; \downarrow^\mathrlap{\tau_d}\\
                    G(c) &amp; \underset{G(f)}{\to} &amp; G(d)
                    }
            %p
              which is, by definition, a natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \to G
          %h3#enriched_functor_categories Enriched functor categories
          %p
            In light of Proposition
            = succeed "," do
              %a.maruku-ref{:href => "#NatTrans"}
            %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
            as an end:
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            both
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched categories
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C,D]
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            whose
          %ul
            %li
              %p
                objects are
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} F : C \to D
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                are given by the end-formula
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi C
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msub
                          %mo ∫
                          %mrow
                            %mi c
                            %mo ∈
                            %mi C
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [C,D](F,G) := \int_{c \in C} D(F(c), G(c))
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V = Set
              this reproduces of course the ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi ℝ
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V = \mathbb{R}_{\geq 0}\cup \{\infty\}
              with the monoidal product given by addition, a
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x, y \in X
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X(x, y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X, Y
              and maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g: X \to Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi sup
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X, Y](f, g) = \int_{x \in X} Y(f(x), g(x)) = \sup_{x \in X} Y(f(x), g(x)).
          %h3#kan_extension Kan extension
          %p
            If the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is
            = succeed "ed" do
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            of a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            along a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p : C \to B
            is given by the coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lan
                  %mi F
                  %mo :
                  %mi b
                  %mo ↦
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Lan F : b \mapsto  \int^{c \in C} hom(p(c),b) \cdot F(c)
                  \\,.
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            for more details.
          %h3#geometric_realization Geometric realization
          %p
            A special case of the example of Kan extension is that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
          %p
            Very generally, geometric realization is the left Kan extension of a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            along the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y : C \to [C^{op},V]
          %p
            The “geometric realization” of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X \in [C^{op},V]
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is then the coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mo :
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  |X| := \int^{c \in C} F(c) \cdot hom(Y(c),X)
                  \\simeq \int^{c \in C} F(c) \cdot X(c)
                  \\,,
          %p
            where the last step on the right uses the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %p
            More specifically, this is traditionally thought of as applying to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} C = \Delta
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi Δ
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} F : \Delta \to Top
            regards the abstract
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            as the standard simplex as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          %h3#tensor_product_of_functors Tensor product of functors
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %msup
                    %mi C
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} S : C^\op \to D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} T : C \to D
            are functors, their
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+functors"} tensor product
            is the coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %msub
                    %mo ⊗
                    %mi C
                  %mi T
                  %mo =
                  %msup
                    %mo ∫
                    %mi c
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} S \otimes_C T = \int^c S(c) \otimes T(c),
          %p
            where the tensor product on the right hand side refers to some
            %a.existingWikiWord{:href => "/nlab/show/monoidal+structure"} monoidal structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %h2#coend_calculus (Co)end calculus
          %p
            The formal properties of (co)ends in Propositions
            = succeed "," do
              %a.maruku-ref{:href => "#ConPres"}
            %a.maruku-ref{:href => "#Fubini"}
            and
            %a.maruku-ref{:href => "#NatTrans"}
            allow us to prove certain results by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abstract+nonsense"} abstract nonsense
          .num_example
            %h6#example_4 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F: C^op \to Set
              be a functor. We prove the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ′
                        %mo ∈
                        %mi C
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(c) \simeq \int^{c' \in C} C(c,c')\times F(c')
            %p We perform the following manipulations, where each isomorphism is natural:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ′
                                %mo ∈
                                %mi C
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ′
                                %mo ∈
                                %mi C
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ′
                                %mo ∈
                                %mi C
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi C
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Set (\int^{c' \in C} C(c,c')\times F(c'), y) &amp;\simeq \int_{c' \in C} Set (C(c,c')\times F(c'), y)\\
                    \&amp;\simeq \int_{c' \in C} Set (C(c, c'), Set(F(c'), y))\\
                    \&amp;\simeq [C, Set] (C(c, -), Set(F(-), y))\\
                    \&amp;\simeq Set(F(c), y).
                    \\end{aligned}
            %p
              So by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ′
                        %mo ∈
                        %mi C
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(c) \simeq \int^{c' \in C} C(c,c')\times F(c').
          %p
            For more examples see e.g.
            = succeed "." do
              %a{:href => "#Loregian21"} Loregian (2021)
