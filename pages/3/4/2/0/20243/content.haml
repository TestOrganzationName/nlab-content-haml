            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of
            %a.existingWikiWord{:href => "/nlab/show/semi-spin+groups"} semi-spin groups
            (motivated by analysis of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+groups"} gauge groups
            and
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
            of
            = succeed ")" do
