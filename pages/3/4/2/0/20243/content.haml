                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = Sp(n).Sp(1)
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternion-K%C3%A4hler+manifold"} quaternion-Kähler manifold
          %p
            Similarly, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
