              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
