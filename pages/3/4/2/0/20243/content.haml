            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "158.031", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-0-1", :y => "652.298"}
              %use{:x => "164.534629", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-0-2", :y => "652.298"}
              %use{:x => "171.038258", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-0-3", :y => "652.298"}
