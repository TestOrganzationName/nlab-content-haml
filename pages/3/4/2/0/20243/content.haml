            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "167.096", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-2-10", :y => "636.179"}
            %path{:d => "M 137.214125 -631.37775 L 137.264906 -631.366031 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 32.614, 8.966)"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
