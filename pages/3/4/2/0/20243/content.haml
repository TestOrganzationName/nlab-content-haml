              %use{:x => "263.441008", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-4-1", :y => "579.079"}
            %path{:d => "M 137.214125 -631.37775 L 225.643813 -572.4715 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 32.614, 8.966)"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "354.554", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-5-7", :y => "517.306"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "354.554", "xlink:href" => "#ThlPRA_oC3kWxubmpCaIjVrYNPQ=-glyph-6-7", :y => "517.306"}
            %path{:d => "M 233.511 -567.244937 L 321.940688 -508.338687 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 32.614, 8.966)"}
            %path{:d => "M 321.893813 -508.350406 L 321.940688 -508.338687 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 32.614, 8.966)"}
          %h3#Sp1Sp1Sp1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sp(1)Sp(1)Sp(1) = Spin(4)\cdot Spin(3)
          #Spin4Spin3.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%284%29.Spin%283%29"}> Spin(4).Spin(3)
                )
            %p The group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    Spin(4)\cdot Spin(3)
                    \\;\coloneqq\;
                    \\big(
                    Spin(4) \times Spin(3)
                    \\big)/\mathbb{Z}_2
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
              of
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
              with
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
              by the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            #eq:Spin4Spin3DiagonalCenter.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mo ↪
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_2
                    \\;\simeq\;
                    \\big\{
                    (1,1), (-1,-1)
                    \\big\}
                    \\hookrightarrow
                    Spin(4) \times Spin(3)
                    \\,.
            %p
              Due to the exception
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                  %annotation{:encoding => "application/x-tex"} \times
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
              (
              %a{:href => "Spin4#ExceptionalIsoWithSpin3TimesSpin3"}> this Prop.
              ) this is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product
              of 3 copies of
              %a.existingWikiWord{:href => "/nlab/show/Sp%281%29"} Sp(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
              with itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi diag
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    Spin(4)\cdot Spin(3)
                    \\;\simeq\;
                    Sp(1)Sp(1)Sp(1)
                    \\;\coloneqq\;
                    \\big( Spin(3) \times Spin(3) \times Spin(3)\big)/_{diag} \mathbb{Z}_2
            %p by the triple diagonal center
            #eq:Spin3Spin3Spin3DiagonalCenter.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mo ↪
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_2
                    \\;\simeq\;
                    \\big\{
                    (1,1,1), (-1,-1,-1)
                    \\big\}
                    \\hookrightarrow
                    Spin(3) \times Spin(3) \times Spin(3)
                    \\,.
          %p
            See the references
            = succeed "." do
              %a{:href => "#ReferencesSpin4Spin3"} below
          .num_example
            %h6#example_3 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              of
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29"} Sp(2).Sp(1)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpnSp1"}
              %a.existingWikiWord{:href => "/nlab/show/Sp%281%29Sp%281%29Sp%281%29"} Sp(1)Sp(1)Sp(1)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Spin4Spin3"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    Sp(2)\cdot Sp(1)
                    }
                    {
                    Sp(1)Sp(1)Sp(1)
                    }
                    \\;\simeq\;
                    S^4
                    \\,.
            %p
              This follows essentially from the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
              and its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sp(2)
              = succeed "\u2026" do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariance
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#BettiolMendes15"} Bettiol-Mendes 15, (3.1), (3.2), (3.3)
          %h3#SpinGrassmannians Spin-Grassmannians
          %p
            We have the following
            %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
            of
            %a.existingWikiWord{:href => "/nlab/show/spin+groups"} spin groups
            by dot-products of Spin groups as above:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi Gr
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo ,
                  %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spin(7)/ \big(  Spin(4)\cdot Spin(3) \big)
                  \\;\simeq\;
                  SO(7) / \big( SO(4) \times SO(3)  \big)
                  \\;\simeq\;
                  Gr(4, 7)
          %p
            is the space of
            %a.existingWikiWord{:href => "/nlab/show/Cayley+4-planes"} Cayley 4-planes
            (
            %a.existingWikiWord{:href => "/nlab/show/Cayley+4-form"}> Cayley 4-form
            \-
            %a.existingWikiWord{:href => "/nlab/show/calibrated+submanifolds"} calibrated submanifolds
            in 8d
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            to just the plain
            %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
            of 4-planes in 7d (recalled e.g. in
            = succeed ")." do
              %a{:href => "#OrneaPiccini00"} Ornea-Piccini 00, p. 1
          %p Similarly,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spin(6)/ \big(  Spin(3)\cdot Spin(3) \big)
                  \\;\simeq\;
                  SU(6)/ SO(4)
          %p
            is the Grassmannian of those
            %a.existingWikiWord{:href => "/nlab/show/Cayley+4-planes"} Cayley 4-planes
            that are also
            %a.existingWikiWord{:href => "/nlab/show/special+Lagrangian+submanifolds"} special Lagrangian submanifolds
            (
            %a{:href => "Cayley+form#BBMOOY96"}> BBMOOY 96, p. 7 (8 of 17)
            ).
          %p Moreover,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 8
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi Gr
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo ,
                  %mn 8
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spin(8)/ \big(  Spin(5)\cdot Spin(3) \big)
                  \\;\simeq\;
                  Gr(3, 8)
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
            of 3-planes in 8d. (
            %a{:href => "#CadekVanzura97"}> Cadek-Vanzura 97, Lemma 2.6
            ).
