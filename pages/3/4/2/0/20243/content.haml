            with
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
            for this group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
