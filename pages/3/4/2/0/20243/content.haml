            %a.existingWikiWord{:href => "/nlab/show/Spin%5Ec"} Spin^c
            appears for instance in
          %ul
            %li#Gompf97
              %a.existingWikiWord{:href => "/nlab/show/Robert+Gompf"}> Robert Gompf
              ,
              = succeed "," do
                %em
