            %a.existingWikiWord{:href => "/nlab/show/duality"} duality
            between
            %a.existingWikiWord{:href => "/nlab/show/Stein+manifolds"} Stein manifolds
            and
            %a.existingWikiWord{:href => "/nlab/show/Oka+manifolds"} Oka manifolds
            in this
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            for
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+%E2%88%9E-groupoids"} complex analytic ∞-groupoids
            in which a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            is
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
            %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
            if it is
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Stein+manifold"} Stein
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka
            = succeed "," do
              %a{:href => "#Larusson01"} Lárusson 2001
            = succeed ")." do
              %a{:href => "#Larusson03"} 03
          %h2#HomotopicalOkaPrinciple Homotopical Oka principle
          %p
          #WeakHomotopyEquivalenceOkaPrinciples.num_prop
            %h6 Proposition
            %p
              %strong (weak homotopy equivalence Oka principle)
              For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
