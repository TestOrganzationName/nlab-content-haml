                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Stein+manifold"} Stein manifold
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka manifold
            %p the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
