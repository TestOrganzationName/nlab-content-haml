                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ≃
                          %mi whe
                        %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Maps_{hol}
                    \\big(
                    S, \, X
                    \\big)
                    \\xhookrightarrow{\;\simeq_{whe}\;}
                    Maps
                    \\big(
                    S ,\, X
                    \\big)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+functions"} holomorphic functions
              into the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              of their
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (with the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          (review in
          = succeed ")" do
            %a{:href => "#ForstnericLarusson11"} Forstnerič &amp; Lárusson 2011, Cor. 3.5
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mover
                    %mo →
