            and their
            %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
            (
            %a{:href => "#Forstneric09b"}> Forstnerič 2009b
            ).
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
            %em weak homotopy equivalence Oka principle
            goes back to results of
            = succeed "," do
              %a{:href => "#Gromov89"} Gromov 89
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-principle"} h-principle
          %p
