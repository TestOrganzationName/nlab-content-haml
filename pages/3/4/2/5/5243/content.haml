          %p
            (
            %a{:href => "#Forstneric11"}> Forstnerič 2011, Cor. 5.4.8
            )
          %h2#StatementInComplexAnalyticGeometry In higher complex analytic geometry
          %p
            In (
            %a{:href => "#Larusson01"}> Lárusson 2001
            ,
            = succeed ")" do
              %a{:href => "#Larusson03"} Lárusson 2003
            %a.existingWikiWord{:href => "/nlab/show/higher+complex+analytic+geometry"} higher complex analytic geometry
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+analytic+infinity-groupoids"} complex analytic infinity-groupoids
          %p
            Say that a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            %em
              %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka manifold
            if for every
            %a.existingWikiWord{:href => "/nlab/show/Stein+manifold"} Stein manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            the canonical morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
