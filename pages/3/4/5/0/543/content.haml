                    %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi Z
                        %annotation{:encoding => "application/x-tex"} \mathbf{Z}
              %li
                %p
                  for all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mo .
                        %mo .
                        %mo .
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_1,...,X_n
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ob(C)
                  there is a family of linear composition maps (the higher compositions)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi m
                          %mi n
                        %mo :
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 0
                        %mo ,
                        %msub
                          %mi X
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi ⋯
                        %mo ⊗
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 0
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m_n : Hom_C(X_0,X_1) \otimes Hom_C(X_1,X_2) \otimes \cdots \otimes Hom_C(X_{n-1},X_n) \to Hom_C(X_0,X_n)
                  of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n-2
                  (homological grading convention is used) for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n\geq1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
