                %a.existingWikiWord{:href => "/nlab/show/Volodymyr+Lyubashenko"} Volodymyr Lyubashenko
          %p
            The relation of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
          %ul
            %li#KonsevichSoibelman08
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yan+Soibelman"} Yan Soibelman
              = succeed "," do
                %em
                  Notes on
                  = succeed "-algebras," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Anton+Kapustin"} Anton Kapustin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Maximilian+Kreuzer"} Maximilian Kreuzer
              %a.existingWikiWord{:href => "/nlab/show/Karl-Georg+Schlesinger"} Karl-Georg Schlesinger
              (eds.)
              = succeed "," do
                %em Homological mirror symmetry – New developments and perspectives
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/math/0606241"} arXiv:math/0606241
              = succeed ")" do
                %a{:href => "https://www.springer.com/de/book/9783540680291"} doi:10.1007/978-3-540-68030-7
          %p
            which mostly discusses just
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/A-infinity-algebra"} A-infinity-algebra
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a{:href => "http://arxiv.org/PS_cache/math/pdf/0606/0606241v2.pdf#page=3"} p. 3
          %p
            Essentially the authors say that an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/dg-manifold"} dg-manifold
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity-algebroid"} L-infinity-algebroid
          %p
            More
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %ul
            %li#LefevreHasegawa03
              %p
                Kenji Lefèvre-Hasegawa,
                %em Sur les A-infini catégories
                (
                %a{:href => "http://arxiv.org/abs/math/0310337"}> arXiv:math/0310337
                )
            %li
              %p
                %span.newWikiWord>
                  Bruno Valette
                  %a{:href => "/nlab/new/Bruno+Valette"} ?
                ,
                = succeed "," do
                  %em Homotopy theory of homotopy algebras
                = succeed ":2" do
                  %strong 70
                %a{:href => "https://10.5802/aif.3322"} doi
                %a{:href => "https://zbmath.org/?q=an:1335.18001"} Zbl:1335.18001
                %a{:href => "https://arxiv.org/abs/1411.5533"} arXiv:1411.5533
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Yong-Geun+Oh"}> Yong-Geun Oh
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hiro+Lee+Tanaka"} Hiro Lee Tanaka
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
                \-categories, their
                = succeed "-categories," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "https://arxiv.org/abs/2003.05806"}> arXiv:2003.05806
              )
          %h3#for_categories_in_the_wider_sense
            For
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            If one understands
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %ul
            %li
              Eugenia Cheng,
              %em
                Comparing operadic definitions of
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              (
              %a{:href => "http://arxiv.org/abs/0809.2070"}> arXiv
              )
          %p
            With operads modeled by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+sets"} dendroidal sets
            %a.existingWikiWord{:href => "/nlab/show/n-categories"} n-categories
            for low
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            viewed as objects with an
            = succeed "-composition" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo −
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} A-\infty
          %ul
            %li
              Andor Lucacs,
              %em Cyclic Operads, Dendroidal Structures, Higher Categories
              (
              %a{:href => "http://igitur-archive.library.uu.nl/dissertations/2011-0211-200314/lukacs.pdf"}> pdf
              )
          %p and
          %ul
            %li
              Andor Lucacs,
              %em Dendroidal weak 2-categories
              (
              %a{:href => "http://de.arxiv.org/abs/1304.4278"}> arXiv:1304.4278
              )
          %p
            See also the references at
