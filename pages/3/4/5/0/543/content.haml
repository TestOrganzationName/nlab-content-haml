          %h3#examples_and_remarks Examples (and remarks)
          %ul
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
                may be regarded as a special case when there are no higher maps (trivial homotopies) of an
                = succeed "-category." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
            %li
              %p
                Every
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
