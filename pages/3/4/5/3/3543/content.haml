          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            one considers
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            only up to maps that induce
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            on
            %em rationalized
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℤ
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \pi_\bullet(X) \otimes_{\mathbb{Z}} \mathbb{Q}
            (as opposed to genuine
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
