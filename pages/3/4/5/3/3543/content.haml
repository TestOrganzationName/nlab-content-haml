            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            is a
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+homotopy+type"} simply connected homotopy type
            (in fact, more generally in the case that it is a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+homotopy+type"} nilpotent homotopy type
