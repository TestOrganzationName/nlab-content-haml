          %h2#idea Idea
          %p
            A
            %em dense sub-site
            is a
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            of a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            such that a natural
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between the corresponding
            %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence of categories
          %h2#definition Definition
          #InducedCoverage.num_prop
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,J)
              a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D \to C
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %strong induced coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi D
                  %annotation{:encoding => "application/x-tex"} J_D
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              has as
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieves
              the intersections of the covering sieves of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with the morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          #DenseSubSite.num_prop
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,J)
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (possibly
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/large+site"} large
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D \to C
              (not necessarily
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
              %strong dense sub-site
              with the
              %a{:href => "#InducedCoverage"} induced coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi D
                  %annotation{:encoding => "application/x-tex"} J_D
              if
            %ol
              %li
                %p
                  every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U \in C
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
                  generated by maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U_i \to U
                  with
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ∈
                          %mi D
                        %annotation{:encoding => "application/x-tex"} U_i \in D
              %li
                %p
                  for every morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi U
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} f : U \to V
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ,
                        %mi V
                        %mo ∈
                        %mi D
                      %annotation{:encoding => "application/x-tex"} U, V \in D
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi f
                          %mi i
                        %mo :
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{f_i : U_i \to U\}
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  such that the composites
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi f
                          %mi i
                      %annotation{:encoding => "application/x-tex"} f \circ f_i
                  are in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
          .num_remark
            %h6#remark Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              then the second condition is automatic.
          %p
            The following theorem is known as the
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"} comparison lemma
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,J)
              be a (possibly
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/large+site"} large
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : D \to C
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed "." do
                %a{:href => "#DenseSubSite"} dense sub-site
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (f^* \dashv f_*)
                    \:
                    PSh(D)
                    \\stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}
                    PSh(C)
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              given by precomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              given by right
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between the categories of sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %msub
                          %mi J
                          %mi D
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ≃
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %msub
                      %mi Sh
                      %mi J
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_* \dashv f^*) :
                    Sh_{J_D}(D)
                    \\underoverset
                    {\underset{f_*}{\to}}{\overset{f^*}
                    {\leftarrow}}
                    {\simeq}
                    Sh_J{C}
                    \\,.
          %p
            This appears as (
            %a{:href => "#JTT02"}> Johnstone, theorem C2.2.3
            ).
          %h2#problems_with_another_definition Problems with another definition
          %p
            The nLab following Johnstone (
            %a{:href => "#JTT02"}> 2002
            , p.546) had initially the following form of condition 2 in definition
            = succeed ":" do
              %a.maruku-ref{:href => "#DenseSubSite"}
          %p
            2’. For every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi U
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} f : U \to V
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} V \in D
            there is a cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S\in J(U)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            generated by a family of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{f_i : U_i \to U\}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that the composites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %msub
                    %mi f
                    %mi i
                %annotation{:encoding => "application/x-tex"} f \circ f_i
            are in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p But this is too weak to prove the comparison lemma as the following example shows:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be any groupoid, with the trivial topology (only maximal sieves cover), and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be the discrete category on the same objects. Then for any morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi U
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f:U\to V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %mi V
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} f^{-1}:V\to U
            generates the maximal sieve on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %msub
                    %mn 1
                    %mi V
                %annotation{:encoding => "application/x-tex"} f f^{-1} = 1_V
            is in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi D
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{C^{op}} \to Set^{D^{op}}
            is not generally an equivalence.
          %p
            See the dicussion
            = succeed "." do
              %a{:href => "https://nforum.ncatlab.org/discussion/7220/dense-subsite/#Item_0"} here
          %h2#examples Examples
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                with
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                regarded as a site with the canonical coverage (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
                covers if the
                %a.existingWikiWord{:href => "/nlab/show/join"} join
                of the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                is
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi bOp
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} bOp(X)
                be a
                %a.existingWikiWord{:href => "/nlab/show/basis+for+the+topology"} basis for the topology
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
                such that every object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                is the
                %a.existingWikiWord{:href => "/nlab/show/join"} join
                of objects of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi bOp
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} bOp(X)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi bOp
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} bOp(X)
                is a dense sub-site.
              %ul
                %li
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/locally+contractible+space"} locally contractible space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Op
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Op(X)
                  its
                  %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cOp
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cOp(X)
                  the full subcategory of
                  %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                  open subsets, we have that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cOp
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cOp(X)
                  is a dense sub-site.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi TopManifold
                    %annotation{:encoding => "application/x-tex"} C = TopManifold
                the category of all
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                coverage, the category
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mi top
                    %annotation{:encoding => "application/x-tex"} {}_{top}
                is a dense sub-site: every
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                has an
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                by
                %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
                %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
                to a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %ul
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo =
                          %mi PCompTopManifold
                        %annotation{:encoding => "application/x-tex"} C = PCompTopManifold
                    the category of all
                    %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                    coverage, the category
                    %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mrow
                            %mi top
                        %annotation{:encoding => "application/x-tex"} {}_{top}
                    is a dense sub-site: every paracompact
                    %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                    has an
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                    by
                    %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
                    %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
                    to a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %li
                  %p
                    Similarly for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo =
                        %annotation{:encoding => "application/x-tex"} C =
                    %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
                    the category of
                    %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                    %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mrow
                            %mi smooth
                        %annotation{:encoding => "application/x-tex"} {}_{smooth}
                    is a dense sub-site: every such smooth manifold has a
                    %em differentiably
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                    (see there): a good cover by open balls each of which are
                    %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
                    to a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
          %h2#warning Warning
          %p
            Replacing
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            by
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            of
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            produces a strictly stronger notion. See
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-comparison+lemma"} (∞,1)-comparison lemma
            for a sufficient criterion for a dense inclusion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sites"} (∞,1)-sites
          %h2#remark_2 Remark
          %p
            There is also the notion of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
            %em dense sub-site
            by both vaguely invoking the topological concept of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dense"} dense
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"} comparison lemma
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-comparison+lemma"} (∞,1)-comparison lemma
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/covering+lifting+property"} covering lifting property
          %h2#references References
          %p
            The comparison lemma originates with the exposé III by
            %a.existingWikiWord{:href => "/nlab/show/J.+L.+Verdier"} Verdier
            in
          %ul
            %li#SGA4
              %a.existingWikiWord{:href => "/nlab/show/M.+Artin"}> M. Artin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/A.+Grothendieck"} A. Grothendieck
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J.+L.+Verdier"} J. L. Verdier
              = succeed "," do
                %em
                  Théorie des Topos et Cohomologie Etale des Schémas (
                  %a.existingWikiWord{:href => "/nlab/show/SGA4"}> SGA4
                  )
              %strong 269
              Springer Heidelberg 1972. (p.288)
          %p
            A more general form is used to give a site characterization for
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tendue"} étendue toposes
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/A.+Kock"}> A. Kock
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/I.+Moerdijk"} I. Moerdijk
              %em Presentations of Etendues
              , Cah. Top. Géom. Diff. Cat.
              %strong XXXII
              2 (1991) pp.145-164. (
              %a{:href => "http://www.numdam.org/numdam-bin/item?id=CTGDC_1991__32_2_145_0"}> numdam
              , pp.151f)
          %p A proof of the comparison lemma together with a nice list of examples is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"}> S. Mac Lane
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/I.+Moerdijk"} I. Moerdijk
              %em Sheaves in Geometry and Logic
              , Springer Heidelberg 1994. (Appendix 4, pp.590ff)
          %p See also
          %ul
            %li#Caramello19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Olivia+Caramello"}> Olivia Caramello
                ,
                %em Denseness conditions, morphisms and equivalences of toposes
                , arXiv:1906.08737 (2019). (
                %a{:href => "https://arxiv.org/abs/1906.08737"}> abstract
                )
            %li#JTT02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Elephant"} Sketches of an Elephant
                  vol 2
                , Oxford UP 2002. (Section C2.2, p.546)
            %li#Shulman12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                ,
                %em Exact Completions and Small Sheaves
                , TAC
                %strong 27
                no.7 (2012) pp.97-173. (
                %a{:href => "http://www.tac.mta.ca/tac/volumes/27/7/27-07abs.html"}> abstract
                ; Section 11)
