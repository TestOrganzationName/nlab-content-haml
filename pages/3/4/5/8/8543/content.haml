                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \langle -\rangle \;\colon\; \mathcal{A} \to \mathbb{C}
          %p
            This means that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            %em
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
            in the given
            %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔼
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{E}(A) \;\coloneqq\;  \langle A \rangle \in \mathbb{C}
                  \\,.
          %p
            More generally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} P \in \mathcal{A}
            is a
            %a.existingWikiWord{:href => "/nlab/show/real+part"} real
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            %a.existingWikiWord{:href => "/nlab/show/projector"} projector
          #eq:RealIdempotent.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo *
