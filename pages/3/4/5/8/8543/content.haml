                  \\phantom{AAA}
                  P P = P
          %p
            thought of as an event, then for any observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
