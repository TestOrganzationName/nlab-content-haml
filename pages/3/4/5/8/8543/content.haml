          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            a
            %em conditional expectation value
            or
            = succeed "," do
              %em conditional expectation
            %em
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
            of some
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            %em conditioned
            on the assumption that a certain
            %a.existingWikiWord{:href => "/nlab/show/event+%28in+probability+theory%29"} event
            is assumed to have occured.
          %p
            More technically: If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mi 𝔄
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega,\mathfrak{A},P)
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            %em conditional expectation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi Σ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E[X|\Sigma]
            of a (measurable) random variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with respect to some sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            \-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ⊆
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \Sigma\subseteq \mathfrak{A}
            is some measurable random variable which is a ‘’coarsened’‘ version of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi Σ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E[X|\Sigma]
            as a random variable with the same
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            but which is measured with a sigma algebra containing only restricted information on the original
            %a.existingWikiWord{:href => "/nlab/show/event+%28in+probability+theory%29"} event
            since to some events in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}
            has been assigned probability
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in a consistent way.
          %h2#conditional_expectation_relative_to_a_random_variable Conditional expectation relative to a random variable
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mi 𝔄
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega,\mathfrak{A},P)
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be a measurable function into a
            %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi Σ
                  %mo ,
                  %msup
                    %mi P
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U,\Sigma,P^Y)
            equipped with the
            %a.existingWikiWord{:href => "/nlab/show/pushforward+measure"} pushforward measure
            induced by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mi 𝔄
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ,
                  %mi ℬ
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi λ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X:(\Omega,\mathfrak{A},P)\to(\mathbb{R},\mathcal{B}(\mathbb{R}), \lambda)
            be a real-valued
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            there exists a essentially unique (two sets are defined to be equivalent if their difference is a set of measure
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo :
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} g=:E[X|Y]
            such that the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mo ,
                          %mi 𝔄
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi Y
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} U
                          %mo ,
                          %mi Σ
                          %mo ,
                          %msup
                            %mi P
                            %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi X
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                                %mi g
                                %mo =
                                %mo :
                                %mi E
                                %mo{:stretchy => "false"} [
                                %mi X
                                %mo{:stretchy => "false"} |
                                %mi Y
                                %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo ,
                          %mi ℬ
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi λ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (\Omega,\mathfrak{A},P)&amp;
                  \\stackrel{Y}{\to}&amp;
                  (\U, \Sigma, P^Y)
                  \\\
                  \\downarrow^{\mathrlap{X}}
                  \&amp;&amp;
                  \\swarrow_{\mathrlap{g=:E[X|Y]}}
                  \\\
                  (\mathbb{R},\mathcal{B}(\mathbb{R}),\lambda)
                  }
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi y
                    %mo ↦
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} g:y\mapsto E[X|Y=y]
          %p
            (1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is
            = succeed "-measurable." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            (2) the
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi Y
                %annotation{:encoding => "application/x-tex"} g\circ Y
            are equal.
          %p
            In this case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} g=E[X|Y]
            is called a version of the
            = succeed "." do
              %strong
                conditional expectation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                provided
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          %p
            In more detail (2) is equivalent to that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} B\in \Sigma
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi d
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi B
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi d
                  %msup
                    %mi P
                    %mi Y
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_{Y^{-1}(B)}X(\omega)d P(\omega)=\int_B g(u)d P^Y (u)
          %p and to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi d
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi d
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_{Y^{-1}(B)}X(\omega)d P(\omega)=\int_{Y^{-1}(B)}(g\circ Y)(\omega)d P (\omega)
          %p
            (The equivalence of the last two formulas is given since we always have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi B
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi d
                  %msup
                    %mi P
                    %mi Y
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi d
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_B g(u)d P^Y (u)=\int_{Y^{-1}(B)} (g\circ Y)(\omega)d P (\omega)
            by the substitution rule.)
          %p
            Note that it does
            %em not
            follow from the preceding definition that the conditional expectation exists. This is a consequence of the
            %a.existingWikiWord{:href => "/nlab/show/Radon-Nikodym+theorem"} Radon-Nikodym theorem
            as will be shown in the following section. (Note that the argument of the theorem applies to the definition of the conditional expectation by random variables if we consider the
            %a.existingWikiWord{:href => "/nlab/show/pushforward+measure"} pushforward measure
            as given by a sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            \-algebra of the original one. In this sense
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E[X|Y]
            is a ‘’coarsened version’‘ of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            factored by the information (i.e. the
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %h2#conditional_expectation_relative_to_a_subalgebra
            Conditional expectation relative to a sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            \-algebra
          %p
            Note that by construction of the pushforward-measure it suffices to define the conditional expectation only for the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo :
                  %mo =
                  %mi 𝔖
                  %mo ⊆
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \Sigma:=\mathfrak{S}\subseteq \mathfrak{A}
            is a sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            \-algebra.
          %p
            (Note that we loose information with the notation
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} P^Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi P
                    %mi 𝔄
                    %mi id
                %annotation{:encoding => "application/x-tex"} P^{id}_\mathfrak{A}
            is different from
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi P
                      %mi 𝔖
                      %mi id
                  %annotation{:encoding => "application/x-tex"} P^{id}_\mathfrak{S}
          %p The diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mo ,
                          %mi 𝔄
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi id
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mo ,
                          %mi 𝔖
                          %mo ,
                          %msup
                            %mi P
                            %mi id
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi X
                        %mtd
                        %mtd
                          %msup
                            %mo ↙
                            %mrow
                              %mi Z
                              %mo =
                              %mo :
                              %mi E
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo{:stretchy => "false"} |
                              %mi 𝔖
                              %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo ,
                          %mi ℬ
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi λ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (\Omega,\mathfrak{A},P)&amp;
                  \\stackrel{id}{\to}&amp;
                  (\Omega, \mathfrak{S}, P^{id})
                  \\\
                  \\downarrow^X&amp;&amp;
                  \\swarrow^{Z=:E[X|\mathfrak{S}]}
                  \\\
                  (\mathbb{R},\mathcal{B}(\mathbb{R}),\lambda)
                  }
          %p is commutative (in our sense) iff
          %p
            (a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            is
            = succeed "-measurable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔖
                  %annotation{:encoding => "application/x-tex"} \mathfrak{S}
          %p
            (b)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi A
                    %mi Z
                    %mi d
                    %mi P
                    %mo =
                    %msub
                      %mo ∫
                      %mi A
                    %mi X
                    %mi d
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \int_A Z d P=\int_A X d P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi A
                  %mo ∈
                  %mi 𝔖
                %annotation{:encoding => "application/x-tex"} \forall A\in \mathfrak{S}
          %p We hence can write the conditional expectation as the equivalence class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi 𝔖
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi Z
                  %mo ∈
                  %msup
                    %mi L
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mi F
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %msub
                    %mo ∫
                    %mi A
                  %mi ZdP
                  %mo =
                  %msub
                    %mo ∫
                    %mi A
                  %mi XdP
                  %mspace{:width => "thickmathspace"}
                  %mo ∀
                  %mi A
                  %mo ∈
                  %mi 𝔖
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} E[X|\mathfrak{S}]=\{Z\in L^1 (\Omega, F,P)|\int_A ZdP=\int_A XdP\;\forall A\in \mathfrak{S}\}
          %p
            An element of this class is also called a
            = succeed "." do
              %em version
          .num_theorem
            %h6#theorem Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mi 𝔖
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E[X|\mathfrak{S}]
              exists and is unique almost surely.
          .proof
            %h6#proof Proof
            %p Existence: By
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mi A
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(A):=\int_A X(\omega)P(d\omega)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝔄
                  %annotation{:encoding => "application/x-tex"} A\in \mathfrak{A}
              is defined a measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ,
                    %mi 𝔄
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega,\mathfrak{A},P)
              (if
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} X\ge 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo +
                  %annotation{:encoding => "application/x-tex"} X^+
              and the negative part
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo −
                  %annotation{:encoding => "application/x-tex"} X^-
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi X
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi X
                      %mo −
                  %annotation{:encoding => "application/x-tex"} X=X^+ -X^-
              separate and use linearity of the integral). Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                  %annotation{:encoding => "application/x-tex"} P|_{\mathfrak{S}}
              be the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔖
                    %annotation{:encoding => "application/x-tex"} \mathfrak{S}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo &lt;
                    %mo &lt;
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                  %annotation{:encoding => "application/x-tex"} Q\lt\lt P|_{\mathfrak{S}}
            %p
              meaning:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo ⇒
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} P|_{\mathfrak{S}}(M)=0\Rightarrow Q(M)=0
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∈
                      %mi 𝔖
                    %annotation{:encoding => "application/x-tex"} M\in\mathfrak{S}
              %a.existingWikiWord{:href => "/nlab/show/Radon-Nikodym+derivative"} theorem of Radon-Nikodym
              (the other condition of the theorem that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                  %annotation{:encoding => "application/x-tex"} P|_{\mathfrak{S}}
              is
              = succeed "-finite" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a probability measure). The theorem implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              has a density w.r.t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                  %annotation{:encoding => "application/x-tex"} P|_{\mathfrak{S}}
              which is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} |
                      %mi 𝔖
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} E[X|\mathfrak{S}]
            %p
              Uniqueness: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} g^\prime
              are candidates, by linearity the integral over their difference is zero.
          %h2#conditional_probability Conditional probability
          %p
            From elementary probability theory we know that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} [
                    %msub
                      %mn 1
                      %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P(A)=E[1_A]
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝔖
                %annotation{:encoding => "application/x-tex"} A\in \mathfrak{S}
            we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi 𝔖
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi E
                  %mo{:stretchy => "false"} [
                  %msub
                    %mn 1
                    %mi A
                  %mo{:stretchy => "false"} |
                  %mi 𝔖
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} P(A|\mathfrak{S}):=E[1_A|\mathfrak{S}]
            the
            = succeed "." do
              %em
                conditional probability of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                provided
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %h2#conditional_distribution_conditional_density Conditional distribution, Conditional density
          %h2#integral_kernel_stochastic_kernel Integral kernel, Stochastic kernel
          %p In probability theory and statistics, a stochastic kernel is the transition function of a stochastic process. In a discrete time process with continuous probability distributions, it is the same thing as the kernel of the integral operator that advances the probability density function.
          %h3#integral_kernel Integral kernel
          %p
            An
            %em integral transform
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is an assignation of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Tf
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo ∫
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mi dt
                %annotation{:encoding => "application/x-tex"} (Tf)(u)=\int K(t,u)f(t)dt
          %p
            where the function of two variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi …
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K( \dots ,\cdots)
            is called
            = succeed "." do
              %em
                integral kernel of the transform
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %h3#stochastic_kernel Stochastic kernel
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_1,\mathfrak{A}_1)
            be a measure space, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 2
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_2,\mathfrak{A}_2)
            be a measurable space.
          %p
            A map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ×
                  %msub
                    %mi 𝔄
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Q: \Omega_1\times \mathfrak{A}_2
            satisfying
          %p
            (1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Ω
                    %mn 1
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Q(-, A):\Omega_1\to [0,1]
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔄
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}_1
            measurable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %msub
                    %mi A
                    %mn 2
                  %mo ∈
                  %msub
                    %mi 𝔄
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \forall A_2\in \mathfrak{A}_2
          %p
            (2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi 𝔄
                    %mn 2
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Q(\omega,-):\mathfrak{A}_2\to [0,1]
            is a probability measure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ω
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔄
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega_2,\mathfrak{A}_2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %msub
                    %mi ω
                    %mn 1
                  %mo ∈
                  %msub
                    %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \forall \omega_1\in \Omega_1
          %p
            is called a
            %em stochastic kernel
            or
            %em transition kernel
            (or
            %em Markov kernel
            \- which we avoid since it is confusing)
            %em
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ω
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝔄
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega_1,\mathfrak{A}_1)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 2
                      %mo ,
                      %msub
                        %mi 𝔄
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Omega_2,\mathfrak{A}_2)
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            induces a function between the classes of measures on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_1, \mathfrak{A}_1)
            and on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 2
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_2, \mathfrak{A}_2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Q
                    %mo ¯
                  %mo :
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mi M
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Ω
                              %mn 1
                            %mo ,
                            %msub
                              %mi 𝔄
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi M
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Ω
                              %mn 2
                            %mo ,
                            %msub
                              %mi 𝔄
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi μ
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ↦
                            %msub
                              %mo ∫
                              %mrow
                                %msub
                                  %mi Ω
                                  %mn 1
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi μ
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\overline{Q}:
                  \\begin{cases}
                  M(\Omega_1, \mathfrak{A}_1)&amp;
                  \\to&amp;
                  M(\Omega_2, \mathfrak{A}_2)
                  \\\
                  \\mu&amp;
                  \\mapsto&amp;
                  (A\mapsto \int_{\Omega_1} Q(-, A) d\mu)
                  \\end{cases}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is a probability measure, then so is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Q
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{Q}(\mu)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(\omega, A)
            is sometimes written as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(A|\omega)
            in optical proximity to a conditional probability.
          %p The stochastic kernel is hence in particular an integral kernel.
          %p
            In a discrete stochastic process (see below) the transition function is a stochastic kernel (more precisely it is the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Q
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{Q}
            induced by a kernel
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          %h4#coupling_koppelung Coupling (Koppelung)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 1
                  %mo ,
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_1,\mathfrak{A}_1, P_1)
            be a probability space, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 2
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_2,\mathfrak{A}_2)
            be a measure space, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ×
                  %msub
                    %mi 𝔄
                    %mn 2
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Q:\Omega_1\times \mathfrak{A}_2\to [0,1]
            be a stochastic kernel from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi 𝔄
                    %mn 1
                  %mo ,
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega_1,\mathfrak{A}_1, P_1)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ω
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔄
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega_2,\mathfrak{A}_2)
          %p Then by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi Ω
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi Ω
                        %mn 2
                  %msub
                    %mn 1
                    %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 2
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(A):=\int_{\Omega_1}(\int_{\Omega_2} 1_A (\omega_1,\omega_2 Q(\omega_1,\omega_2))P_1(d \omega_1)
          %p
            is defined a probability measure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔄
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi 𝔄
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}_1\otimes\mathfrak{A}_2
            which is called
            = succeed "." do
              %em coupling
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mo :
                  %mi P
                  %mo ⊗
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P=:P\otimes Q
            is unique with the property
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ×
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ω
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(A_1\times A_2)=\int_{A_1} Q(\omega_1, A_2) P_1(d\omega_1)
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Let (with the above settings)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %msub
                      %mi Ω
                      %mn 1
                    %mo →
                    %msub
                      %mi Ω
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y:\Omega_1\to \Omega_2
              be
              = succeed "-measurable," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔄
                        %mn 1
                      %mo ,
                      %msub
                        %mi 𝔄
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathfrak{A}_1,\mathfrak{A}_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            %p
              Then there exists a stochastic kernel from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ω
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝔄
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega_1, \mathfrak{A}_1)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi d
                    %mo ,
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^d,\mathcal{B}(\mathbb{R})^d)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                    %mo =
                    %msup
                      %mi P
                      %mi Y
                    %mo ⊗
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P^{X,Y}=P^Y\otimes Q
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is (a version of) the conditional distribution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              provided
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi P
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(y,-)=P^X(-|Y=y)
          %p
            This theorem says that that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            (more precisely
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ↦
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y\mapsto Q(y,-)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Ω
                            %mn 1
                          %mo ,
                          %msub
                            %mi 𝔄
                            %mn 1
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi Y
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Ω
                            %mn 2
                          %mo ,
                          %msub
                            %mi 𝔄
                            %mn 2
                          %mo ,
                          %msup
                            %mi P
                            %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi X
                        %mtd
                        %mtd
                          %msup
                            %mo ↙
                            %mi Q
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo ,
                          %mi ℬ
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi λ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (\Omega_1,\mathfrak{A}_1,P)&amp;
                  \\stackrel{Y}{\to}&amp;
                  (\Omega_2,\mathfrak{A}_2, P^Y)
                  \\\
                  \\downarrow^X&amp;&amp;
                  \\swarrow^{Q}
                  \\\
                  (\mathbb{R},\mathcal{B}(\mathbb{R}),\lambda)
                  }
          %p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} E[X|Y]=Q
          %h4#discrete_case Discrete case
          %p
            In the discrete case, i.e. if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Omega_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Omega_2
            are finite- or enumerable sets, it is possible to reconstruct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            by just considering one-element sets in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔄
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}_2
            and the related probabilities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi ij
                  %mo :
                  %mo =
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi j
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p_{ij}:= Q(i,\{j\})
          %p
            called
            %em transition probabilities
            encoding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            assemble to a (perhaps countably infinite) matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            called
            = succeed "." do
              %em
                transition matrix of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                resp. of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Q
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi ij
                %annotation{:encoding => "application/x-tex"} p_{ij}
            is the probability of the transition of the
            %em state
            (aka.
            %em elementary event
            or
            = succeed ")" do
              %em one-element event
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            to the
            %em event
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{j\}
            (which in this case happens to have only one element, too). We have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi p
                    %mi ij
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \sum_i p_{ij}=1
            forall
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %msub
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i\in \Omega_1
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi Ω
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \rho:=(p_i)_{i\in \Omega_1}
            is a counting density on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Omega_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pM
                  %mo =
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo ∈
                      %mi Ω
                  %msub
                    %mi p
                    %mi i
                  %msub
                    %mi p
                    %mi ij
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi j
                      %mo ∈
                      %msub
                        %mi Ω
                        %mn 2
                %annotation{:encoding => "application/x-tex"} pM=(\sum_{i\in \Omega} p_i p_{ij})_{j\in \Omega_2}
          %p
            is a counting density on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Omega_2
          %p
            The conditional expectation plays a defining role in the theory of
            %em martingales
            which are
            %em stochastic processes
            such that the conditional expectation of the next value (provided the previous values) equals the present realized value.
          %h3#stochastic_processes Stochastic processes
          %p
            The terminology of
            %em stochastic processes
            is a special interpretation of some aspects of
            %span.newWikiWord
              infinitary combinatorics
              %a{:href => "/nlab/new/infinitary+combinatorics"} ?
            in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            be a
            %a.existingWikiWord{:href => "/nlab/show/total+order"} total order
            (i.e. transitive, antisymmetric, and total).
          %p
            A
            %em stochastic process
            is a diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi I
                  %mo :
                  %mi I
                  %mo →
                  %mi ℛ
                %annotation{:encoding => "application/x-tex"} X_I: I\to \mathcal{R}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℛ
                %annotation{:encoding => "application/x-tex"} \mathcal{R}
            is the class of random variables such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo :
                  %msub
                    %mi X
                    %mi i
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mi i
                  %mo ,
                  %msub
                    %mi 𝔉
                    %mi i
                  %mo ,
                  %msub
                    %mi P
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo ,
                  %msub
                    %mi 𝔖
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_I(i)=:X_i:(\Omega_i, \mathfrak{F}_i, P_i)\to (S_i, \mathfrak{S}_i)
            is a random variable. Often one considers the case where all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo ,
                  %msub
                    %mi 𝔖
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi 𝔖
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S_i, \mathfrak{S}_i)=(S, \mathfrak{S})
            are equal; in this case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is called
            = succeed "." do
              %em
                state space of the process
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi I
                    %annotation{:encoding => "application/x-tex"} X_I
          %p
            If all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi i
                  %mo =
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega_i=\Omega
            are equal and the class of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔄
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (\mathfrak{A}_i)_{i\in I}
            is
            %em filtered
            i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔉
                    %mi i
                  %mo ⊆
                  %msub
                    %mi 𝔉
                    %mi j
