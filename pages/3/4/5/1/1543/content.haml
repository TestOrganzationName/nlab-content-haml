                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo ×
                      %mi ρ
                  %mi P
                  %msub
                    %mo ×
                    %mi X
                  %mi P
                %annotation{:encoding => "application/x-tex"}
                  P \times G \stackrel{p_1 \times \rho}{\to} P \times_X P
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            We now unwrap the first statement in gory detail to make clear that this abstract nonsense does reproduce the familiar definition of the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h4#UnwindingTheAbstractDefinition Unwinding the abstract description
          %p
            We now rederive the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            given just the classifying map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B} G
            by spelling out the details implied by the above abstract description.
          %p
            Whatever the precise context is (topological, smooth, etc.) we may assume that we are at least in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
            is represented by an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi F
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C(U) &amp;\stackrel{g}{\to} &amp; \mathbf{B}G
                  \\\
                  \\downarrow^{\mathrlap{\in W \cap F}}
                  \\\
                  X
                  }
          %p
            in
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            coming from some
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(U)
            has
          %ul
            %li
              %p
                objects =
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{(x,i) | x \in U_i\}
            %li
              %p
                morphisms =
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ (x,i) \stackrel{}{\longrightarrow} (x,j) | x \in U_{i j}\}
                \.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} g : C(U) \to \mathbf{B}G
            sends
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} (
                      %mi x
