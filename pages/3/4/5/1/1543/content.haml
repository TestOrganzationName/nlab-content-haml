                      \\cdots
                      \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                      P \times G
                      \\stackrel{\stackrel{\rho}{\longrightarrow}}{\stackrel{p_1}{\longrightarrow}}
                      P
                      \\to X
            %li
              %p
                and it exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ×
                      %msup
                        %mi G
                        %mrow
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P \times G^{\times (n-1)}
                as the
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
                being the
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \to X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
