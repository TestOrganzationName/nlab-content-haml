                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\cdots
                  \&amp;
                  P \times G \times G
                  \&amp;
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  \&amp;
                  P \times G
                  \&amp;
                  \\stackrel{\longrightarrow}{\longrightarrow}
                  \&amp;
                  P
                  \&amp;
