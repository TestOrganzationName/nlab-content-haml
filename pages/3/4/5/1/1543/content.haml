                , section I.7 of:
                = succeed "," do
                  %em The topology of fibre bundles
                = succeed "," do
                  %strong 14
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/j.ctt1bpm9t5"} jstor:j.ctt1bpm9t5
            %li{:id => "Husemöller94"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dale+Husem%C3%B6ller"}> Dale Husemöller
                , §4.3 in:
                = succeed "," do
                  %em Fiber bundles
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-1-4757-2261-1"} doi:10.1007/978-1-4757-2261-1
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dale+Husem%C3%B6ller"}> Dale Husemöller
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Joachim"} Michael Joachim
                = succeed "," do
