                                %mrow
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\cdots
                      \&amp;
                      P \times_X P \times_X P
                      \&amp;
                      \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                      \&amp;
