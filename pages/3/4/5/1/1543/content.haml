            for details)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P &amp;\to&amp; \mathbf{E}G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  C(U) &amp;\stackrel{g}{\longrightarrow}&amp;
                  \\mathbf{B}G
