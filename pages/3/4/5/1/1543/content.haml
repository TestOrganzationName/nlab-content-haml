                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_{i j} \in Functions(U_{i j}, G)
            as described in detail at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi g
                  %mover
                    %mo →
                    %mi h
                  %mi g
                  %mi h
                  %mo{:stretchy => "false"} |
                  %mi g
                  %mo ,
                  %mi h
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbf{E}G = \{g \stackrel{h}{\to} g h | g,h \in G \}
            the fibrant replacement of the point, which we shall find it helpful to think of as given by
          %ul
            %li
              %p
                objects =
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
