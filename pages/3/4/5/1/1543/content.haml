          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/quotient+object"} effective
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
            that exhibits the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Form the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            of the classifying morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
            along the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} d_0
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} face maps
            of this diagram. This yields a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
