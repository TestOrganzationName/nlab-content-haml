                                  %mrow
                                  %mi g
                                %mo ↙
                            %mtr
                              %mtd
                                %mo •
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      \&amp;&amp; \bullet
                      \\\
                      \&amp; {}^g\swarrow
                      \\\
                      \\bullet
                      }
                      \\right\}
            %li
              %p
                morphisms =
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo •
                            %mtr
                              %mtd
                              %mtd
                                %msup
