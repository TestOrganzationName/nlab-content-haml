                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi h
                              %mtd
                              %mtd
                                %mo •
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      \&amp;&amp; \bullet
                      \\\
                      \&amp; {}^g\swarrow &amp;&amp; \searrow^{g' = g h}
                      \\\
