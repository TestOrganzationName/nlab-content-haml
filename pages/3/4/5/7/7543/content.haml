                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  forms the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/nerve+of+a+category"} nerve of a category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                  that sends a category to its underlying graph
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          #AdjointsToTheSegalPullbackDiagram.num_remark
            %h6#remark_5 Remark
            %p
              The morphisms in the commuting diagram of prop.
              %a.maruku-ref{:href => "#CatAsPullback"}
              participate in further
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
            %p
              First of all the nerve has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} \tau \colon PSh(\Delta) \to Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                  %annotation{:encoding => "application/x-tex"} j^*
              induces a left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ≃
                    %mi τ
                    %msub
                      %mi j
                      %mo !
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    F \simeq \tau j_! i_*
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
              functor.
            %p
              Moreover, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                  %annotation{:encoding => "application/x-tex"} j^*
              is a
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic functor
              and the
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Grph
                    %mo →
                    %mi Grph
                  %annotation{:encoding => "application/x-tex"} U F \colon Grph \to Grph
              of which
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              is the category of
              %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+monad"} algebras
              is the restriction of the monad
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                      %mo ∘
                      %msub
                        %mi j
                        %mo !
                    %annotation{:encoding => "application/x-tex"} j^* \circ j_!
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mi U
                    %mi F
                    %mo ≃
                    %msup
                      %mi j
                      %mo *
                    %msub
                      %mi j
                      %mo !
                    %msub
                      %mi i
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_* U F \simeq j^* j_! i_*
                    \\,.
            %p
              (All this is discussed in (
              %a{:href => "#Berger"}> Berger, p. 13
              ), and actually in the further generality of cellular sets that we get to
              = succeed ".)" do
                %a{:href => "#InTermsOfPullBackOfCatOfSheavesForCellularObjects"} below
            %p In summary we have a diagram of adjoint pairs of functors of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Cat
                          %mtd
                            %mover
                              %munderover
                                %mo ↪
                                %mi N
                                %mo ⊥
                              %mover
                                %mo ←
                                %mi τ
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mi sSet
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi U
                            %mo{:stretchy => "false"} ↓
                            %mo ⊢
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi F
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi j
                                    %mo *
                            %mo{:stretchy => "false"} ↓
                            %mo ⊢
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mo !
                        %mtr
                          %mtd
                            %mi Graph
                            %mo ≃
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Δ
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munderover
                                %mo ↪
                                %mrow
                                  %msub
                                    %mi i
                                    %mo *
                                %mo ⊥
                              %mover
                                %mo ←
                                %mrow
                                  %msup
                                    %mi i
                                    %mo *
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Δ
                              %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Cat &amp;\stackrel{\overset{\tau}{\leftarrow}}{\underoverset{N}{\bottom}{\hookrightarrow}}&amp; PSh(\Delta) \simeq sSet
                    \\\
                    {}^{\mathllap{U}}\downarrow \vdash \uparrow^{\mathrlap{F}} &amp;&amp; {}^{\mathllap{j^*}}\downarrow \vdash \uparrow^{\mathrlap{j_!}}
                    \\\
                    Graph \simeq Sh(\Delta_0) &amp;\stackrel{\overset{i^*}{\leftarrow}}{\underoverset{i_*}{\bottom}{\hookrightarrow}}&amp; PSh(\Delta_0)
                    }
            %p
              where several (however not all) subdiagrams of functors commute, as discussed above. In terms of this the reformulation of the Segal condition as in prop.
              %a.maruku-ref{:href => "#CatAsPullback"}
              is now further reformulated as:
            %p
              %em
                A category is equivalently an algebra over the monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                      %msub
                        %mi j
                        %mo !
                    %annotation{:encoding => "application/x-tex"} j^* j_!
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(\Delta_0)
                which satisfies the Segal condition in that it is in the essential image of the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} i_*
                of prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#NerveOfGraph"}
          %h4#InTermsOfPullBackOfCatOfSheavesForCellularObjects
            For cellular objects and
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            The immediate generalization of prop.
            %a.maruku-ref{:href => "#CatAsPullback"}
            from simplicial objects to
            %a.existingWikiWord{:href => "/nlab/show/cellular+objects"} cellular objects
            is the following.
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Θ
                    %mn 0
                  %mo →
                  %mi Θ
                %annotation{:encoding => "application/x-tex"}
                  j \colon \Theta_0 \to \Theta
          %p
            be the defining inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/cellular+site"} cellular site
            into the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cell+category"} cell category
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str\omega Cat
              of
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-categories"} strict ∞-categories
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Str
                            %mi ω
                            %mi Cat
                          %mtd
                            %munderover
                              %mo →
                              %mo ≃
                              %mi N
                          %mtd
                            %msub
                              %mi Mod
                              %mi Θ
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi Θ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi U
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi j
                                    %mo *
                        %mtr
                          %mtd
                            %mi ω
                            %mi Graph
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Θ
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Θ
                              %mn 0
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Str\omega Cat
                    \&amp;\underoverset{\simeq}{N}{\to}&amp; Mod_\Theta &amp;\hookrightarrow&amp;
                    PSh(\Theta)
                    \\\
                    \\downarrow^{\mathrlap{U}} &amp;&amp; \downarrow^{} &amp;&amp; \downarrow^{\mathrlap{j^*}}
                    \\\
                    \\omega Graph &amp;\stackrel{\simeq}{\to}&amp; Sh(\Theta_0) &amp;\hookrightarrow&amp; PSh(\Theta_0)
                    }
                    \\,.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/globular+theory"} globular theory
            for more.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Segal+space"}> Segal space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
                %a.existingWikiWord{:href => "/nlab/show/n-fold+complete+Segal+space"} n-fold complete Segal space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Algebraic+pattern"} Algebraic pattern
          %h2#references References
          %p The “Segal conditions” are originally due to:
          %ul
            %li#Grothendieck61
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              , Prop. 4.1 of:
              %a.existingWikiWord{:href => "/nlab/show/FGA"} FGA
              = succeed "," do
                %em Techniques de construction et théorèmes d’existence en géométrie algébrique III : préschémas quotients
              = succeed "," do
                %a{:href => "http://www.numdam.org/item/?id=SB_1960-1961__6__99_0"} numdam:SB_1960-1961__6__99_0
              = succeed "," do
                %a{:href => "http://www.numdam.org/item/SB_1960-1961__6__99_0.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://translations.thosgood.com/fga/fga3.iii.xml"} web version
          %p and named after their mentioning in
          %ul
            %li#Segal68
              %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
              , Section 2 of:
              = succeed "," do
                %em Classifying spaces and spectral sequences
              %strong 34
              (1968) 105-112 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/PMIHES_1968__34__105_0/"}> numdam:PMIHES_1968__34__105_0
              \&amp;rbrack;
          %p
            The interpretation of the Segal condition as a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            condition is reviewed for instance in section 2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
              \:
              %em Polynomial functors and trees
              \&amp;lbrack;
              %a{:href => "https://ddd.uab.cat/pub/prepub/2008/hdl_2072_15534/Pr825.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/0807.2874"} arxiv:0807.2874
          %p
            and discussed for
            %a.existingWikiWord{:href => "/nlab/show/strict+infinity-categories"} strict infinity-categories
            in
          %ul
            %li#Berger
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
              ,
              = succeed "," do
                %em A cellular nerve for higher categories
              %strong 169
              1 (2002) 118-175 &amp;lbrack;
              %a{:href => "https://doi.org/10.1006/aima.2001.2056"}> doi:10.1006/aima.2001.2056
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://math1.unice.fr/~cberger/nerve.pdf"} pdf
          %p Based on that, an iterative and homotopy-theoretic formulation of the cellular Segal conditions is in section 5 of
          %ul
            %li#Rezk
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em
                A cartesian presentation of weak
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              Geom. Topol. 14 (2010), no. 1, 521–571 (
              %a{:href => "http://arxiv.org/abs/0901.3602"}> arXiv:0901.3602
              )
        .revisedby
