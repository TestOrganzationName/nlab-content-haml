                %annotation{:encoding => "application/x-tex"} f\in Top_*^\to(X,Y)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mrow
                      %mn 0
                      %mo ,
                      %mo *
                  %mo :
                  %msub
                    %mi π
                    %mi q
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %msub
                    %mi π
                    %mi q
                  %msub
                    %mi Y
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f_{0,*}:\pi_q X_0\to \pi_q Y_0
            are isomorphisms for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ≥
                  %mi N
                %annotation{:encoding => "application/x-tex"} q\geq N
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 0
                  %mo ,
                  %msubsup
                    %mi f
                    %mn 1
                    %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo :
                  %msub
                    %mi π
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                  %msubsup
                    %mi X
                    %mn 1
                    %mi I
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mn 0
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi Y
                        %mn 1
                  %msubsup
                    %mi Y
                    %mn 1
                    %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f_0,f_1^I)_*:\pi_q(X_0\times_{X_1}X_1^I)\to \pi_q(Y_0\times_{Y_1}Y_1^I)
            are isomorphisms for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≥
                    %mi N
                    %mo −
                    %mn 1
