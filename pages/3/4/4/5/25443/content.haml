          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#VVieira2020"}> Vieira 2020, Theorem 4.3.5, Theorem 4.3.8
              ) We have an idempotent weak Quillen quasiadjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
