            %p is a homotopy pullback.
            %p The resulting homotopy category is the reflective subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mi o
                    %msub
                      %mi 𝒯
                      %mi Q
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
