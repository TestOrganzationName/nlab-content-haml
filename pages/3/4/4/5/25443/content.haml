            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 2
                    %mo ,
                    %mi N
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N-2,N-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Y_0
            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
