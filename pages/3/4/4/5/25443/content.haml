            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Y_1
            is
            = succeed "-connected." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %msubsup
                    %mi Top
                    %mo *
                    %mo →
                %annotation{:encoding => "application/x-tex"} Y\in Top_*^\to
            that are homotopy equivalent to
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 2
                    %mo ,
                    %mi N
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N-2,N-1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mrow
                        %mi N
                        %mo −
                        %mn 2
                        %mo ,
                        %mi N
                        %mo −
                        %mn 1
                      %mo →
                  %annotation{:encoding => "application/x-tex"} Top^\to_{N-2,N-1}
          %p
            The images of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mn 2
                    %mi N
                %annotation{:encoding => "application/x-tex"} \Omega^N_2
            are naturally algebras over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathcal{SC}_N
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 2
                      %mi N
                    %mo :
                    %msubsup
                      %mi Top
                      %mo *
                      %mo →
                    %mo →
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Omega^N_2:Top_*^\to\rightarrow \mathcal{SC}_N[Top]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/two-sided+bar+construction"} two-sided bar construction
          %p
          .num_defn
            %h6 Definition
            %p
              The relative
              = succeed "-delooping" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mo →
                      %mi N
                    %mo :
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msubsup
                      %mi Top
                      %mo *
                      %mo →
                    %mo ,
                    %mspace{:width => "2em"}
                    %msubsup
                      %mi B
                      %mo →
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mo →
                      %mi N
                    %mo ,
                    %msub
                      %mi SC
                      %mi N
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B^N_\to:\mathcal{SC}_N[Top]\to Top_*^\to,\qquad B^N_\to(X)\coloneqq B(\Sigma^N_\to,SC_N,X).
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              The resolution of
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮𝒞
                        %mi N
                    %annotation{:encoding => "application/x-tex"} \mathcal{SC}_N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi B
                        %mo ¯
                      %mn 2
                    %mo :
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mover
                        %mi B
                        %mo ¯
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi SC
                      %mi N
                    %mo ,
                    %msub
                      %mi SC
                      %mi N
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{B}_2:\mathcal{SC}_N[Top]\to\mathcal{SC}_N[Top],\qquad \overline{B}_2(X)=B(SC_N,SC_N,X).
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#VVieira2020"}> Vieira 2020, Theorem 4.3.5, Theorem 4.3.8
              ) We have an idempotent weak Quillen quasiadjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi B
                      %mo →
                      %mi N
                    %msub
                      %mo ⊣
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mover
                            %mi B
                            %mo ¯
                          %mn 2
                        %mo ,
                        %msub
                          %mi Id
                          %mrow
                            %msubsup
                              %mi Top
                              %mo *
                              %mo →
                    %msubsup
                      %mi Ω
                      %mn 2
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %mo{:stretchy => "false"} ]
                    %mo ⇋
                    %msup
                      %mi Top
                      %mo →
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B^N_\to\dashv_{\ \overline{B}_2,Id_{Top_*^\to}}\Omega^N_2):\mathcal{SC}_N[Top]\leftrightharpoons Top^\to.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} N\geq 3
              then this quasiadjunction induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %msubsup
                      %mi B
                      %mo →
                      %mi N
                    %mo ⊣
                    %mi ℝ
                    %msubsup
                      %mi Ω
                      %mn 2
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℋ
                    %mi o
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                    %mo{:stretchy => "false"} [
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi grp
                    %mo ⇋
                    %mi ℋ
                    %mi o
                    %msubsup
                      %mi Top
                      %mrow
                        %mi N
                        %mo −
                        %mn 2
                        %mo ,
                        %mi N
                        %mo −
                        %mn 1
                      %mo →
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{L}B^N_\to\dashv\mathbb{R}\Omega^N_2):\mathcal{H}o\mathcal{SC}_N[Top]_{grp}\leftrightharpoons \mathcal{H}o Top^\to_{N-2,N-1}
            %p
              between the homotopy subcategory of grouplike Swiss cheese algebras and the homotopy category of
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo −
                      %mn 2
                      %mo ,
                      %mi N
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (N-2,N-1)
          %p
          .num_remark
            %h6 Remark
            %p
              In the reference
              %a{:href => "#VVieira2020"} Vieira 2020
              a cofibrant resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathcal{SC}_N
              is used. The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮𝒞
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathcal{SC}_N
              is a
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
          %p
          .num_remark
            %h6 Remark
            %p
              The reason the proof of the above theorem doesn’t extend to the cases
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mn 1
                    %mo ,
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} N=1,2
              is due to the fact that the constructed unit of the quasiadjunction is induced by a natural map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %msub
                      %mi SC
                      %mi N
                    %mo ⇒
                    %msubsup
                      %mi Ω
                      %mn 2
                      %mi N
                    %msubsup
                      %mi Σ
                      %mo →
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \alpha:SC_N\Rightarrow \Omega^N_2\Sigma^N_\to
              which is a natural pair of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ≥
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} N\geq 3
          %h2#infinite_relative_recognition_theorem Infinite relative recognition theorem
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                %annotation{:encoding => "application/x-tex"} Sp
            be the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Sp
                    %mo ↗
                %annotation{:encoding => "application/x-tex"} Sp^{\nearrow}
            the category composed of pairs of spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mn 0
                  %mo ,
                  %msub
                    %mi Y
                    %mn 1
                  %mo ∈
                  %mi Sp
                %annotation{:encoding => "application/x-tex"} Y_0,Y_1\in Sp
            equipped with a 1-shifted spectra map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %msub
                      %mi Y
                      %mn 0
                    %mo →
                    %msub
                      %mi Y
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y:Y_0\to Y_1[1]
          %p
          .num_defn
            %h6 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              functor is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo :
                    %mi Sp
                    %mo →
                    %mi Sp
                    %mo ,
                    %mspace{:width => "2em"}
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ≔
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                      %mrow
                        %mi q
                        %mo →
                        %mn ∞
                    %msubsup
                      %mover
                        %mi Y
                        %mo ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi q
                      %mrow
                        %msup
                          %mi 𝕊
                          %mi q
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{\Omega}:Sp\to Sp,\qquad \widetilde{\Omega}(Y)_\bullet\coloneqq \colim_{q\to\infty} \widetilde Y_{\bullet+q}^{\mathbb{S}^q}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Y
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{Y}
              is a certain inclusion prespectrum constructed from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mover
                      %mi Y
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} Y\to \widetilde{Y}
              (
              %a{:href => "#LewisMaySteinberger86"}> LMS 86, Appendix 1
              ). If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is already an inclusion spectrum then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Y
                        %mo ˜
                      %mo =
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \widetilde Y=Y
            %p This functor induces a spectrification functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Ω
                        %mo ˜
                      %mo ↗
                    %mo :
                    %msup
                      %mi Sp
                      %mo ↗
                    %mo →
                    %msup
                      %mi Sp
                      %mo ↗
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mover
                        %mi Ω
                        %mo ˜
                      %mo ↗
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{\Omega}_{\nearrow}:Sp^{\nearrow}\to Sp^{\nearrow}
                    ,\qquad \widetilde{\Omega}_{\nearrow}(Y)\coloneqq(\widetilde{\Omega}(Y):\widetilde{\Omega}(Y_0)\to \widetilde{\Omega}(Y_1)[1]).
            %p
          %p
            We have a natural
            %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ′
                  %mo :
                  %msub
                    %mi Id
                    %mrow
                      %msup
                        %mi Sp
                        %mo ↗
                  %mo ⇒
                  %msub
                    %mover
                      %mi Ω
                      %mo ˜
                    %mo ↗
                %annotation{:encoding => "application/x-tex"} \epsilon':Id_{Sp^{\nearrow}}\Rightarrow\widetilde{\Omega}_{\nearrow}
            which gives a Quillen idempotent monad structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Ω
                        %mo ˜
                      %mo ↗
                  %annotation{:encoding => "application/x-tex"} \widetilde{\Omega}_{\nearrow}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Sp
                    %mo ↗
                %annotation{:encoding => "application/x-tex"} Sp^{\nearrow}
            is the one induced by this idempotent monad, which is the left Bousfield localization of the strict mixed model structure on the pairs of stable weak homotopy equivalences. The fibrant objects in this model structure are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectra"} Omega-spectra
