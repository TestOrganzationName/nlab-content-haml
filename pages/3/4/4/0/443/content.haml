          %h2#idea Idea
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            , the category of relations, is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            and whose
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are (binary)
            %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            between sets. It becomes a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            (in fact, a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/2-poset"} 2-poset
            %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            to be inclusions of relations.
          %h2#definition Definition
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            is a category whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            or
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            or
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            are
            %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ⊆
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} R \subseteq X \times Y
            %em composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∘
                  %mi R
                %annotation{:encoding => "application/x-tex"} S \circ R
            of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} R: X \to Y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi Y
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} S: Y \to Z
            is defined as the usual relational composite:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi X
                  %mo ×
                  %mi Z
                  %mo :
                  %msub
                    %mo ∃
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi R
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi S
                  %mo{:stretchy => "false"} }
                  %mo ⊆
                  %mi X
                  %mo ×
                  %mi Z
                  %mo .
                %annotation{:encoding => "application/x-tex"} \{(x, z) \in X \times Z: \exists_{y \in Y} (x, y) \in R \wedge (y, z) \in S\} \subseteq X \times Z .
          %p
            Another important operation on relations is taking the
            = succeed "," do
              %em opposite
            %em transpose
            or sometimes the
            = succeed "." do
              %em converse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} R: X \to Y
            induces a relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo †
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Y
                  %mo ×
                  %mi X
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} }
                  %mo ⊆
                  %mi Y
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} R^\dagger = \{(y, x) \in Y \times X: (x, y) \in R\} \subseteq Y \times X
          %p
            This makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            into a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dagger-category"} dagger-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∘
                    %mi R
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %msup
                      %mi R
                      %mo †
                    %mo ∘
                    %msup
                      %mi S
                      %mo †
                  %annotation{:encoding => "application/x-tex"} (S \circ R)^\dagger = R^\dagger \circ S^\dagger
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mn 1
                      %mi X
                      %mo †
                    %mo =
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} 1_X^\dagger = 1_X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mo †
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %mi R
                  %annotation{:encoding => "application/x-tex"} (R^{\dagger})^{\dagger} = R
          %p
            We can enhance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            to a 2-category, which we can call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            to distinguish it from the mere category, by taking
            %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            or
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⇒
                  %mi S
                %annotation{:encoding => "application/x-tex"} R \Rightarrow S
            to be inclusions of relations. Since there is at most one 2-morphism between parallel 1-morphisms,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2-poset"} 2-poset
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} category enriched
            in the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
          %h2#relations_and_spans Relations and spans
          %p
            It is useful to be aware of the connections between the
            %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
            and the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/span"} spans
            %em span
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a diagram of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ←
                  %mi S
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \leftarrow S \to Y
          %p
            and there is an obvious category whose objects are spans from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            and whose morphisms are morphisms between such diagrams. The terminal span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                  %mi X
                  %mo ×
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \stackrel{\pi_1}{\leftarrow} X \times Y \stackrel{\pi_2}{\to} Y
          %p
            and a relation from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is just a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of the terminal span, in other words an isomorphism class of monos into the terminal span.
          %p
            To each span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the unique morphism of spans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} S \to X \times Y
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mo −
                  %mo{:stretchy => "false"} |
                  %mo :
                  %mi Span
                  %mo →
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} |-|:Span \to Rel
          %p
            Indeed for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ←
                  %mi R
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \leftarrow R \to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ←
                    %mi S
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B \leftarrow S \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi R
                  %msub
                    %mo ×
                    %mi B
                  %mi S
                  %mo{:stretchy => "false"} |
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo ∃
                  %mi k
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msub
                    %mo ×
                    %mi B
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo ∃
                  %mi b
                  %mo ∈
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi r
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} land
                  %mo ∃
                  %mi s
                  %mo ∈
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mi R
                  %mo{:stretchy => "false"} |
                  %mo ⊙
                  %mo{:stretchy => "false"} |
                  %mi S
                  %mo{:stretchy => "false"} |
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  |R \times_B S| = \{(a,c) \mid \exists k \in (R \times_B S)(a,c)\} = \{(a,c) \mid \exists b \in B (\exists r \in R(a,b) \land \exists s \in S(b,c))\} = |R| \odot |S|.
          %h2#LimitsAndColimit Limits and colimits
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            does have
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            and
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
            of sets. However, otherwise
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            has very few (co)limits; it doesn’t even have splittings of all idempotents. All symmetric idempotents have splittings, but the order-relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                  %mspace{:width => "thickmathspace"}
                  %mo ⊆
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \leq \; \subseteq \{0,1\} \times \{0,1\}
            can’t be split. It follows that it can’t have (co)equalisers.
          %p
            Since the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            is the category of
            %em free algebras
            (
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"}> Kleisli category
            ) for the
            = succeed "," do
              %span.newWikiWord
                powerset monad
                %a{:href => "/nlab/new/powerset+monad"} ?
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            of the
            %a.existingWikiWord{:href => "/nlab/show/powerset"} powerset
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/suplattices"} suplattices
          %h3#weak_equalizers_and_completion Weak equalizers and completion
          %p
            As the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            has
            %em
              %a.existingWikiWord{:href => "/nlab/show/weak+limit"} weak
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exact+completion"} exact completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            extends to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exact+completion"} exact completion
          %p
            The Freyd completion of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            has products and weak equalizers. The Freyd completion adds freely a strong factorization system to a(ny) category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has products, and it has equalizers if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has weak equalizers.
          %h3#in_the_double_category_of_relations In the double category of relations
          %p
            If you insert the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            into the
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} RRel
                %annotation{:encoding => "application/x-tex"} \mathrm{RRel}
            of sets, mappings and relations, one has a double category with all
            %a.existingWikiWord{:href => "/nlab/show/double+limits"} double limits
            and colimits. For instance, the obvious cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ×
                  %mi b
                  %mo :
                  %mi X
                  %mo ×
                  %mi Y
                  %mo →
                  %mi X
                  %mo ′
                  %mo ×
                  %mi Y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} a \times b : X \times Y \to X' \times Y'
            (resp. sum
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                    %mo :
                    %mi X
                    %mo +
                    %mi Y
                    %mo →
                    %mi X
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} a+b : X + Y \to X' + Y'
          %p Similarly, many bicategories of spans, cospans, relations, profunctors, etc. have poor (co)limits, but can be usefully embedded in weak double categories (with the same objects, “strict morphisms”, “same morphisms”, suitable double cells) that have all limits and colimits.
          %h2#as_an_enriched_category As an enriched category
          %p
            Writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            for the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suplattices"} suplattices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            is a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %ul
            %li
              in
              %a.existingWikiWord{:href => "/nlab/show/additive+categories"} additive categories
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %em finitary
              (co)
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              are
              %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              \-categories with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %em arbitrary
              (co)
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              are
              %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
          %p
            is remarkable. This was probably first noticed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dana+May+Latch"} Dana May Latch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            of complete
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/suplattices"} suplattices
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
            for maps to products, from coproducts, and most especially, from coproducts to products, works just as it does in the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/additive+categories"} additive categories
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
          %h2#in_spans In spans
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimit"} van Kampen colimit
          %h2#monoepimorphisms Mono/epimorphisms
          %p
            It is not hard to see that a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊆
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} R \subseteq A \times B
            is a
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \to B
            iff the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi A
                  %mo →
                  %mi 𝒫
                  %mi B
                %annotation{:encoding => "application/x-tex"} \mathcal{P}A \to \mathcal{P}B
            sending a subset of A to the set of all R-relatives of its members is injective; dually for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
          %h2#2categorical_aspects 2-categorical aspects
          %p
            Recall that we are using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            to stand for the 2-category of sets, relations and inclusions. Various facts about relations can be recast in these terms. For example, a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} L : X \to Y
            is a function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            iff it has a right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} R : Y \to X
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Rel
                  %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mo †
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L^\dagger : Y \to X
          %p
            Similarly, a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} T : X \to X
            in the 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            is exactly a preorder on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %msub
                    %mn 1
                    %mi X
                  %mo ⇒
                  %mi T
                %annotation{:encoding => "application/x-tex"} i: 1_X \Rightarrow T
            says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is reflexive and the existence of the multiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %msup
                    %mi T
                    %mn 2
                  %mo ⇒
                  %mi T
                %annotation{:encoding => "application/x-tex"} m: T^2 \Rightarrow T
            says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is transitive. This monad has an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore object
            iff it is an equivalence relation, in which case the Eilenberg-Moore object is the set of equivalence classes of the relation.
          %h2#relations_in_a_category Relations in a category
          %p
            More generally, given any
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}(C)
            in similar fashion. The objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}(C)
            are objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} r: c \to d
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}(C)
            are defined to be
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobjects
            of the terminal span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo →
                  %mi s
                %annotation{:encoding => "application/x-tex"} r \to s
            are subobject inclusions. To form the composite of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ⊆
                  %mi c
                  %mo ×
                  %mi d
                %annotation{:encoding => "application/x-tex"} r \subseteq c \times d
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ⊆
                    %mi d
                    %mo ×
                    %mi e
                  %annotation{:encoding => "application/x-tex"} s \subseteq d \times e
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the unique span morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %msub
                    %mo ×
                    %mi c
                  %mi s
                  %mo →
                  %mi c
                  %mo ×
                  %mi e
                %annotation{:encoding => "application/x-tex"} r \times_c s \to c \times e
          %p
            in the category of spans from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∘
                  %mi r
                  %mo ⊆
                  %mi c
                  %mo ×
                  %mi e
                %annotation{:encoding => "application/x-tex"} s \circ r \subseteq c \times e
          %p
            and the axioms of a regular category ensure that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}(C)
            is a 2-category with desirable properties. Similar to what was said above, there is again a
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span(C) \to \mathbf{Rel}(C)
          %p
            Indeed, the proof this was strong for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} bf
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C=\bf Set
            carries over to an arbitrary regular category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            since it is written in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular logic
          %p There is also a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi C
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i: C \to \mathbf{Rel}(C)
          %p
            that takes a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} f: c \to d
            to the functional relation defined by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ⟩
                  %mo :
                  %mi c
                  %mo →
                  %mi c
                  %mo ×
                  %mi d
                %annotation{:encoding => "application/x-tex"} \langle 1, f\rangle: c \to c \times d
          %p
            Such functional relations may also be characterized as precisely those 1-cells in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rel(C)
            which are
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} left adjoints
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle 1, f \rangle
            is the opposite relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle f, 1\rangle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi c
                  %mo ⊆
                  %mo{:stretchy => "false"} ⟨
                  %mi f
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                  %mo ∘
                  %mo{:stretchy => "false"} ⟨
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} 1_c \subseteq \langle f, 1 \rangle \circ \langle 1, f \rangle
          %p
            which says that the functional relation is
            = succeed "," do
              %em total
          .maruku-equation
