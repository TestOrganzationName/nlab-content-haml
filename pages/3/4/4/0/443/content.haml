                  %mi f
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                  %mo ⊆
                  %msub
                    %mn 1
                    %mi d
                %annotation{:encoding => "application/x-tex"} \langle 1, f \rangle \circ \langle f, 1 \rangle \subseteq 1_d
          %p
            which says the functional relation is
            = succeed "." do
