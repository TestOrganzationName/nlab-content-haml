            %p
          %p
            An immediate variant of Lemma
            = succeed ":" do
              %a.maruku-ref{:href => "#SumOfExpLambdaNumCyclesOverPermutations"}
          %p
          #SumOfSgnExpLambdaNumCyclesOverPermutations.num_lemma
            %h6 Lemma
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              denoting the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements, and for any
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              between
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                    %annotation{:encoding => "application/x-tex"} e^\beta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msup
                      %mi e
                      %mrow
                        %mi β
                        %mo ⋅
                        %mrow
                          %mo |
                          %mi Cycles
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} )
                          %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo −
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{
                    \\sum
                    }
                    sgn(\sigma)
                    \\cdot
                    e^{ \beta \cdot \left\vert Cycles(\sigma) \right\vert }
                    \\;=\;
                    \\underoverset
                    {k = 0}
                    {n-1}
                    {\prod}
                    \\big(
                    e^{\beta} - k
                    \\big)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sgn(\sigma)
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of a permutation
          This is mentioned, without proof, at
          = succeed "." do
            %a{:href => "https://mathoverflow.net/a/245010/"} MO:q/245010
          .proof
            %h6 Proof
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi e
                              %mi β
                            %mo −
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi e
                              %mi β
                            %mo +
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi e
                              %mi β
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo |
                                %mi Cycles
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo{:stretchy => "false"} )
                                %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo −
                                %mrow
                                  %mo |
                                  %mi Cycles
                                  %mo{:stretchy => "false"} (
                                  %mi σ
                                  %mo{:stretchy => "false"} )
                                  %mo |
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi e
                              %mi β
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo |
                                %mi Cycles
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo{:stretchy => "false"} )
                                %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo |
                                %mi EvenLengthCycles
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo{:stretchy => "false"} )
                                %mo |
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi e
                              %mi β
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo |
                                %mi Cycles
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo{:stretchy => "false"} )
                                %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi e
                              %mi β
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo |
                                %mi Cycles
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo{:stretchy => "false"} )
                                %mo |
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underoverset
                    {k = 0}
                    {n-1}
                    {\prod}
                    \\big(
                    e^{\beta} - k
                    \\big)
                    \&amp;
                    \\;=\;
                    (-1)^n
                    \\underoverset
                    {k = 0}
                    {n-1}
                    {\prod}
                    \\big(
                    \- e^{\beta} + k
                    \\big)
                    \\\
                    \&amp;
                    \\;=\;
                    (-1)^n
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    (-e^\beta)^{\left\vert Cycles(\sigma)\right\vert}
                    \\\
                    \&amp; \;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    (-1)^{n - \left\vert Cycles(\sigma)\right\vert}
                    \\cdot
                    (e^\beta)^{\left\vert Cycles(\sigma)\right\vert}
                    \\\
                    \&amp; \;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    (-1)^{\left\vert EvenLengthCycles(\sigma)\right\vert}
                    \\cdot
                    (e^\beta)^{\left\vert Cycles(\sigma)\right\vert}
                    \\\
                    \&amp; \;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    sgn(\sigma)
                    \\cdot
                    (e^\beta)^{\left\vert Cycles(\sigma)\right\vert}
                    \\end{aligned}
            %p
              Here the second step is Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#SumOfExpLambdaNumCyclesOverPermutations"}
            %p
              To see the fourth step, notice that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is even/odd there must be an even/odd number of permutations of odd length. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              plus the number of odd-length permutations cancels out in signs and thus leaves the sign of the number of even permutations.
            %p
              The last step is the observation that the signature of a permutation is the sign of its number of even-length permutations, since for each cycle there is one less transposition than elements in the cycle (see
              = succeed ")." do
                %a{:href => "Cayley+distance#eq:CyclicPermutationAsProductOfTranspositions"} here
          %p
            Another immediate consequence of Lemma
            %a.maruku-ref{:href => "#SumOfExpLambdaNumCyclesOverPermutations"}
            is this:
          %p
          #SumOverFirstRowOfCayleyDistanceKernel.num_lemma
            %h6 Lemma
            %p
              %strong (sum over first row of Cayley distance kernel)
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over the first row of the Cayley distance kernel (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistanceKernel"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %mi n
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ - \beta \cdot d_C(\sigma, e) }
                    \\;=\;
                    e^{- \beta \cdot n }
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
            %p
          .proof
            %h6 Proof
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %msub
                                  %mi d
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo ,
                                %mi e
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mrow
                                  %mo |
                                  %mi Cycles
                                  %mo{:stretchy => "false"} (
                                  %mi σ
                                  %mo{:stretchy => "false"} )
                                  %mo |
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi n
                            %mspace{:width => "thinmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mi β
                                %mo ⋅
                                %mrow
                                  %mo |
                                  %mi Cycles
                                  %mo{:stretchy => "false"} (
                                  %mi σ
                                  %mo{:stretchy => "false"} )
                                  %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi n
                            %mspace{:width => "thinmathspace"}
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi e
                              %mi β
                            %mo +
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ - \beta \cdot d_C(\sigma, e) }
                    \&amp;
                    \\;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ - \beta \cdot (n - \left\vert Cycles(\sigma) \right\vert ) }
                    \\\
                    \&amp;
                    \\;=\;
                    e^{- \beta \cdot n }
                    \\,
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ \beta \cdot  \left\vert Cycles(\sigma) \right\vert }
                    \\\
                    \&amp; =\;
                    e^{- \beta \cdot n }
                    \\,
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
                    \\mathrlap{\,,}
                    \\end{aligned}
            %p where:
            %ul
              %li
                %p
                  the first step is
                  = succeed "," do
                    %a{:href => "Cayley+distance#CayleyObservation"} Cayley’s observation
              %li
                %p
                  the last step uses Lemma
                  = succeed "." do
                    %a.maruku-ref{:href => "#SumOfExpLambdaNumCyclesOverPermutations"}
            %p
          %h4#gershgorin_radius Gershgorin radius
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/Gershgorin+radius"} Gershgorin radius
            of the Cayley distance kernel, in Prop.
            %a.maruku-ref{:href => "#GershgorinRadiiOfCayleyDistanceKernel"}
            below.
          %p
          #GershgorinRadiiOfCayleyDistanceKernel.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Gershgorin+radius"} Gershgorin radius
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Gershgorin+radii"} Gershgorin radii
              of the Cayley distance kernel (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistanceKernel"}
            #eq:GershgorinRadiusExpression.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    r(\beta)
                    \\;=\;
                    e^{- \beta \cdot n }
                    \\,
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
                    \-
                    1
            %p
          .proof
            %h6 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/right+invariant+metric"} right invariance
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
              (
              %a{:href => "Cayley+distance#CayleyMetricIsRightInvariant"}> this Prop.
              ) the sum over entries of any row is equal to that of the first row. Since moreover
            %ul
              %li
                %p
                  all entries are
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                  and non-
                  %a.existingWikiWord{:href => "/nlab/show/negative+number"}> negative
                  , hence equal to their
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %li
                %p
                  the diagonal elements are all equal to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo =
                          %msup
                            %mi e
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi β
                              %mo ⋅
                              %mn 0
                        %annotation{:encoding => "application/x-tex"} 1 = e^{ - \beta \cdot 0 }
            %p
              it follows that this sum over the first row equals the Gershgorin radius plus 1 (by its defining formula
              = succeed ")." do
                %a{:href => "Gershgorin+circle+theorem#eq:GershoginRadiusFormula"} here
              = succeed "." do
                %a.maruku-ref{:href => "#SumOverFirstRowOfCayleyDistanceKernel"}
          %p
            %br/
          %h3#eigenvectors Eigenvectors
          %p
            We discuss some
            %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
            of the Cayley distance kernel.
          %h4#the_homogeneous_distribution The homogeneous distribution
          %p
          #HomogeneousDistributionIsEigenvalue.num_remark
            %h6 Example
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1)_{\sigma \in Sym(n)}
              is an eigenvector with eigenvalue
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi β
                          %mo ⋅
                          %mi n
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi k
                          %mo =
                          %mn 0
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi e
                        %mi β
                      %mo +
                      %mi k
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      e^{- \beta \cdot n }
                      \\underoverset
                      {k = 0}
                      {n - 1}
                      {\prod}\big(e^{\beta}+ k \big)
          (by Lemma
          = succeed ")" do
            %a.maruku-ref{:href => "#SumOfExpLambdaNumCyclesOverPermutations"}
          %h4#TheSignatureDistribution The signature distribution
          %p
          #SignatureDistributionIsEigenvector.num_prop
            %h6 Proposition
            %p
              A further
              %a.existingWikiWord{:href => "/nlab/show/eigenvector"} eigenvector
              of the Cayley distance kernel is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (sgn(\sigma))_{\sigma \in Sym(n)}
              with corresponding
              %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
            #eq:EigenvectorOfSignDistribution.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EV
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %mi n
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo −
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    EV
                    \\big
                    (sgn(\sigma))_{\sigma \in Sym(n)}
                    \\big)
                    \\;=\;
                    e^{- \beta \cdot n }
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}\big(e^{\beta}- k \big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p That this is an eigenvector follows from the following calculation:
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              component of the image of this vector is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %msub
                                  %mi d
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo ,
                                %mi τ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi τ
                            %mo{:stretchy => "false"} )
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo ⋅
                            %msup
                              %mi τ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %msub
                                  %mi d
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo ⋅
                                %msup
                                  %mi τ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo ,
                                %mi e
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi τ
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %msub
                                  %mi d
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %mo ,
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum} sgn(\sigma)
                    e^{ - \beta \cdot d_C(\sigma, \tau) }
                    \&amp;\;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum} sgn(\tau)sgn(\sigma \cdot \tau^{-1})
                    e^{ - \beta \cdot d_C(\sigma \cdot \tau^{-1}, e) }
                    \\\
                    \&amp; \;=\;
                    sgn(\tau)\underset{
                    \\sigma \in Sym(n)
                    }{\sum} sgn(\sigma)
                    e^{ - \beta \cdot d_C(\sigma, e) }.
                    \\end{aligned}
            %p
              This follows from the
              %a.existingWikiWord{:href => "/nlab/show/right+invariant+metric"} right invariance
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
              (
              %a{:href => "Cayley+distance#Invariance"}> here
              ) and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sgn
                  %annotation{:encoding => "application/x-tex"} sgn
              is a multiplicative character,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo ⋅
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} sgn(\sigma \cdot \tau) = sgn(\sigma)\cdot sgn(\tau)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (sgn(\sigma))_{\sigma \in Sym(n)}
              is an eigenvector and the corresponding eigenvalue equals the signed sum of, in particular, the first row of the Cayley distance kernel. This is as claimed by Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#SumOverSgnFirstRowOfCayleyDistanceKernel"}
          %p
          #SumOverSgnFirstRowOfCayleyDistanceKernel.num_lemma
            %h6 Lemma
            %p
              %strong (signed sum over first row of Cayley distance kernel)
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
