                    {\phantom{AAAA}}
                    N \in \mathbb{N}_+
                    \\,.
            %p We may regard this set of equations as the specialization of the following more general equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi β
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⋅
                    %mi EigVals
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                    %mo ⋅
                    %msub
                      %mi d
                      %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %msup
                          %mi e
                          %mi β
                        %mo +
                        %mi content
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi ℓ
                        %msub
                          %mi hook
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\frac
                    {  \chi^{(\lambda)}(e) }
                    { n!  }
                    (e^\beta)^n
                    \\cdot
                    EigVals[e^{- \beta} \cdot d_C]_\lambda
                    \\;=\;
                    \\underset{(i,j)}{\prod}
                    \\frac
                    { e^\beta + content(i,j) }
                    { \ell hook_\lambda(i,j) }
            %p
              to all integer values of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                    %annotation{:encoding => "application/x-tex"} e^\beta
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                  %annotation{:encoding => "application/x-tex"} e^\beta
              – the right hand manifestly so, the left hand side by
              %a.maruku-eqref{:href => "#eq:CharacterFormulaForEigenvalueOfCayleyDistanceKernel"} (10)
              – the fact that the equation holds at infinite many distinct points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} e^\beta \in \mathbb{N}_+
              implies that in fact it holds for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} e^\beta \in \mathbb{R}_+
            %p
          %p In fact:
          %p
          #EigenvaluesInTermsOfJustBoxContent.num_prop
            %h6 Proposition
            %p
              %strong (Eigenvalues if Cayley distance kernel in terms of just box content)
              %br/
              The Eigenvalues
              %a.maruku-eqref{:href => "#eq:CharacterFormulaForEigenvalueOfCayleyDistanceKernel"} (10)
              of the Cayley distance kernel for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} e^\beta \in \mathbb{R}_+
              may be expressed as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EigVals
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %mi N
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi i
                            %mo ≤
                            %mi rows
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi j
                            %mo ≤
                            %msub
                              %mi λ
                              %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi j
                    %mo −
                    %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    EigVals[e^{- \beta \cdot d_C}]_\lambda
                    \\;=\;
                    e^{- \beta \cdot N}
                    \\underset
                    {
                    { 1 \leq i \leq rows(\lambda) }
                    \\atop
                    { 1 \leq j \leq \lambda_i }
                    }
                    {\prod}
                    \\big(
                    e^{\beta}+ j - i
                    \\big)
                    \\,.
            %p
          This is essentially, the result of
          = succeed "," do
            %a{:href => "Jucys-Murphy+element#Jucys71"} Jucys 71
          = succeed "." do
            %em
              %a.existingWikiWord{:href => "/nlab/show/Jucys-Murphy+element"} Jucys-Murphy element
          .proof
            %h6 Proof
            %p
            %p
              The point is that the
              %a.existingWikiWord{:href => "/nlab/show/hook+length+formula"} hook length formula
              (see
              = succeed ")" do
                %a{:href => "hook+length+formula#eq:HookLengthFormulaMeasuresDimensionOfIrrepOfSymmetricGroup"} here
              %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            #eq:HookLengthFormulaForDimensionOfIrrepsOfSymmetricGroup.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi χ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi dim
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi n
                        %mo !
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} )
                        %mi ℓ
                        %msub
                          %mi hook
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi^{(\lambda)}(e)
                    \\;=\;
                    dim
                    \\big(
                    S^{(\lambda)}
                    \\big)
                    \\;=\;
                    \\frac
                    { n! }
                    {
                    \\underset{(i,j)}{\prod}  \ell hook_\lambda(i,j)
                    }
                    \\,.
            %p Using this, we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi EigVals
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi λ
                                %mo ⋅
                                %msub
                                  %mi d
                                  %mi C
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi λ
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi n
                                %mo !
                              %mrow
                                %msup
                                  %mi χ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi λ
                                    %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi N
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mn 1
                                    %mo ≤
                                    %mi i
                                    %mo ≤
