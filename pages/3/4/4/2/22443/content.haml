            %p#PlotOfEigenvalueOfKernelOnSym4AsFunctionOfExponentiatedBeta
              The following plot (via WolframAlpha,
              = succeed ")" do
                %a{:href => "https://www.wolframalpha.com/input/?i=min%5B+%7B++N%5E3+%2B+6+*+N%5E2+%2B+11+*+N+%2B+6+%2C+N%5E3+-+6+*+N%5E2+%2B+11+*+N++-+6+%2C+N%5E3+-+N+%2C+N%5E3+%2B+2+*+N%5E2+-+N+-+2%2C+N%5E3+-+2+*+N%5E2+-+N++%2B+2+%7D+%5D++for+0.6+%3C+N+%3C+4"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mn 3
                        %mi β
                  %annotation{:encoding => "application/x-tex"} e^{3 \beta}
              times) the lowest eigenvalue of the Cayley distance kernel on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(4)
              as a function of the exponentiated inverse temperature
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ≔
                      %msup
                        %mi e
                        %mi β
                    %annotation{:encoding => "application/x-tex"} N \coloneqq e^\beta
            %p
              %a{:href => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym4-b.jpg"}
                %img{:src => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym4-b.jpg", :width => "540"}/
            %p One sees that the kernel is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mtext indefinite
                          %mtd
                            %mtext for
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo ∈
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo ,
                                %mn 2
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mtext positive semi-definite
                          %mtd
                            %mtext for
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo =
                                %mn 2
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mtext indefinite
                          %mtd
                            %mtext for
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo ∈
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mo ,
                                %mn 3
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mtext positive semi-definite
                          %mtd
                            %mtext for
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo =
                                %mn 3
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mtext positive definite
                          %mtd
                            %mtext for
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo &gt;
                                %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathllap{
                    \\text{indefinite}
                    }
                    \&amp; \text{for} &amp;
                    \\mathrlap{
                    e^{\beta} \in (1,2)
                    }
                    \\\
                    \\mathllap{
                    \\text{positive semi-definite}
                    }
                    \&amp;\text{for}&amp;
                    \\mathrlap{
                    e^{\beta} = 2
                    }
                    \\\
                    \\mathllap{
                    \\text{indefinite}
                    }
                    \&amp; \text{for} &amp;
                    \\mathrlap{
                    e^{\beta} \in (2,3)
                    }
                    \\\
                    \\mathllap{
                    \\text{positive semi-definite}
                    }
                    \&amp;\text{for}&amp;
                    \\mathrlap{
                    e^{\beta} = 3
                    }
                    \\\
                    \\mathllap{
                    \\text{positive definite}
                    }
                    \&amp;\text{for}&amp;
                    \\mathrlap{
                    e^{\beta} \gt 3
                    }
                    }
            %p
              This exhibits the general behaviour discussed as Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CayleyDistanceKernelIsIndefiniteForEBetaNonIntegralAndSmallernminusone"}
              %a.maruku-ref{:href => "#PositiveSemidefinitenessAtLowIntegerValuedOfEBeta"}
              and , Prop.
              %a.maruku-ref{:href => "#ExplicitBoundForInverseTemperatureEnsuringPositivity"}
              below.
            %p
          %p
          #CayleyDistanceKernelOnSym6.num_remark
            %h6 Example
            %p
              %strong (Cayley distance kernel on Sym(6))
            %p
              Similarly, here is the graph of the lowest eigenvalue of the Cayley distance kernel on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(6)
              (from
              = succeed "):" do
                %a{:href => "#BarNatan21"} Bar-Natan 21
            %p
              %a{:href => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym6.jpg"}
                %img{:src => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym6.jpg", :width => "440"}/
            %p
          %h2#properties Properties
          %h3#some_lemmas Some lemmas
          %h4#sum_over_one_row Sum over one row
          %p
            We give a useful expression (Lemma
            %a.maruku-ref{:href => "#SumOverFirstRowOfCayleyDistanceKernel"}
            below) for the sum over the first row of the Cayley distance kernel. This appears both in the expression for its Gershgorin radius (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#GershgorinRadiiOfCayleyDistanceKernel"}
            = succeed ")." do
              %a.maruku-ref{:href => "#HomogeneousDistributionIsEigenvalue"}
          %p
          #SumOfExpLambdaNumCyclesOverPermutations.num_lemma
            %h6 Lemma
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              denoting the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements, and for any
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              between
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                    %annotation{:encoding => "application/x-tex"} e^\beta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mi β
                        %mo ⋅
                        %mrow
                          %mo |
                          %mi Cycles
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} )
                          %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{
                    \\sum
                    }
                    e^{ \beta \cdot \left\vert Cycles(\sigma) \right\vert }
                    \\;=\;
                    \\underoverset
                    {k = 0}
                    {n-1}
                    {\prod}
                    \\big(
                    e^{\beta} + k
                    \\big)
                    \\,.
            %p
          In
          %a{:href => "#Stanley11"} Stanley 11, Prop. 1.3.7
          are offered four proofs of this lemma, see also discussion at
          = succeed ";" do
            %a{:href => "https://mathoverflow.net/q/245005/381"} MO:q/245005
          = succeed ":" do
            %a{:href => "https://math.stackexchange.com/a/92051/58526"} Math.SE:a/92051
          .proof
            %h6 Proof
            %p
              Notice that every
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              has a
              %em unique
              representative in
              %a.existingWikiWord{:href => "/nlab/show/cycle+notation"} cycle notation
            #eq:NormalizedCycleNotation.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi σ
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mn 1
                            %msub
                              %mi t
                              %mn 11
                            %msub
                              %mi t
                              %mn 12
                            %mi ⋯
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mn 2
                            %msub
                              %mi t
                              %mn 21
                            %msub
                              %mi t
                              %mn 22
                            %mi ⋯
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mn 3
                            %msub
                              %mi t
                              %mn 31
                            %msub
                              %mi t
                              %mn 32
                            %mi ⋯
                            %mo{:stretchy => "false"} )
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi h
                              %mn 1
                            %msub
                              %mi t
                              %mn 11
                            %msub
                              %mi t
                              %mn 12
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi h
                              %mn 2
                            %msub
                              %mi t
                              %mn 21
                            %msub
                              %mi t
                              %mn 22
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi h
                              %mn 3
                            %msub
                              %mi t
                              %mn 31
                            %msub
                              %mi t
                              %mn 32
                            %mo{:stretchy => "false"} |
                            %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\sigma
                    \&amp; = \;
                    (h_1 t_{11} t_{12} \cdots)
                    (h_2 t_{21} t_{22} \cdots)
                    (h_3 t_{31} t_{32} \cdots)
                    \\cdots
                    \\\
                    \&amp; =
                    \\vert
                    h_1 t_{11} t_{12} \vert
                    h_2 t_{21} t_{22} \vert
                    h_3 t_{31} t_{32} \vert \cdots
                    \\end{aligned}
            %p with the property that the following two conditions hold:
            %ol
              %li
                %p
                  heads are smallest in their cycle:
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi h
                            %mi i
                          %mo &lt;
                          %msub
                            %mi t
                            %mrow
                              %mi i
                              %mi j
                        %annotation{:encoding => "application/x-tex"} h_i \lt t_{i j}
              %li
                %p
                  cycles are ordered by their heads:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi h
                            %mi i
                          %mo &lt;
                          %msub
                            %mi h
                            %mrow
                              %mi i
                              %mo +
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} h_i \lt h_{i + 1}
            %p
              This yields a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the set of permutations and the set of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sec
                  %annotation{:encoding => "application/x-tex"} sec
              of the following
              %a.existingWikiWord{:href => "/nlab/show/indexed+family"} indexed family
              of sets
            #eq:SectionDeterminingAPermutation.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi k
                                %mo ∈
                                %mo{:stretchy => "false"} {
                                %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %mi n
                                %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi k
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi sec
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{
                    k \in \{1, \cdots, n\}
                    }{\sqcup}
                    \\{0, \cdots, k-1\}
                    \\\
                    {}^{\mathllap{p_n}}
                    \\big\downarrow
                    \\;
                    \\big\uparrow {}^{\mathrlap{sec}}
                    \\\
                    \\{1, \cdots, n\}
                    }
            %p as follows:
            %p
              To a given section
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sec
                    %annotation{:encoding => "application/x-tex"} sec
              %a.maruku-eqref{:href => "#eq:NormalizedCycleNotation"} (4)
              has underlying it (forgetting the bars “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert
              ”) the
              %a.existingWikiWord{:href => "/nlab/show/list"} list
              obtained by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi list
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo ∅
                  %annotation{:encoding => "application/x-tex"}
                    list_0
                    \\;\coloneqq\;
                    \\varnothing
            %p
              and then
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
              adding the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k+1
              to the list at stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              by
            %ul
              %li
                %p
                  either appending it on the right, if
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sec
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} sec(k+1) = 0
              %li
                %p
                  or inserting it
                  %em after
                  the
                  = succeed "-st" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sec
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} sec(k+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi list
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi list
                                %mi k
                              %mo ,
                              %mi k
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mi if
                            %mtd
                              %mi sec
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msubsup
                                %mi list
                                %mi k
                                %mrow
                                  %mo ≤
                                  %mi sec
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo +
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo ,
                              %mi k
                              %mo +
                              %mn 1
                              %mo ,
                              %msubsup
                                %mi list
                                %mi k
                                %mrow
                                  %mo &gt;
                                  %mi sec
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo +
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mi if
                            %mtd
                              %mi sec
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo &gt;
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    list_{k+1}
                    \\;\coloneqq\;
                    \\left\{
                    \\array{
                    [ list_k, k+1 ] &amp;if&amp; sec(k+1) = 0
                    \\\
                    [ list_k^{ \leq sec(k+1)}, k+1 , list_k^{\gt sec(k+1)} ]
                    \&amp; if &amp; sec(k+1) \gt 0
                    }
                    \\right.
            %p
              The resulting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi list
                        %mi n
                    %annotation{:encoding => "application/x-tex"} list_n
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
