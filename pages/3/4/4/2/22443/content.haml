                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                  %annotation{:encoding => "application/x-tex"} e^\beta
              drops below
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n=1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n - 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                  %annotation{:encoding => "application/x-tex"} e^\beta
              drops below
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n - 3
          %h4#general_eigenvectors General eigenvectors
          %p
            The general eigenvectors and eigenvalues of the Cayley distance kernel are given as explicit expressions in the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+characters"} irreducible characters
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            = succeed ":" do
              %em
                %a{:href => "Cayley+graph+spectrum#CharacterFormulaForCayleyGraphSpectra"} character formula
                of
                %a.existingWikiWord{:href => "/nlab/show/Cayley+graph+spectra"} Cayley graph spectra
          %p
            To be able to apply this formula, one just has to observe that the exponentiated
            %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
            in a single variable
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Sym
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi ℝ
                          %mpadded{:width => "0"}
                            %mrow
                              %mo ↪
                              %mi ℂ
                      %mtr
                        %mtd
                          %mi σ
                        %mtd
                          %mo ↦
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi β
                              %mo ⋅
                              %msub
                                %mi d
                                %mi C
                              %mo{:stretchy => "false"} (
                              %mi σ
                              %mo ,
                              %mi e
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Sym(n)
                  \&amp;\longrightarrow&amp;
                  \\mathbb{R}
                  \\mathrlap{
                  \\hookrightarrow \mathbb{C}
                  }
                  \\\
                  \\sigma &amp;\mapsto&amp; e^{- \beta \cdot d_C(\sigma,e)}
                  }
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/class+function"} class function
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %a{:href => "Cayley+distance#CayleyObservation"} Cayley’s observation
            that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo −
                    %mrow
                      %mo |
                      %mi Cycles
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo |
                  %annotation{:encoding => "application/x-tex"} d_c(\sigma,e) = n - \left\vert Cycles(\sigma)\right\vert
          %p
            It thus follows from the general
            %a{:href => "Cayley+graph+spectrum#CharacterFormulaForCayleyGraphSpectra"} character formula
            and the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+symmetric+group"} representation theory of the symmetric group
            (
            %a{:href => "representation+theory+of+the+symmetric+group#IrreducibleRepresentations"}> here
            ) that:
          %p
          #CharacterFormulaForEigenvalues.num_prop
            %h6 Proposition
            %p
              %strong (character formula for eigenvalues)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              of the Cayley distance kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              are:
            %ol
              %li
                %p
                  labeled by
                  %a.existingWikiWord{:href => "/nlab/show/partitions"} partitions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                #eq:EigenvaluesLabeledByPartitions.maruku-equation
                  %span.maruku-eq-number (9)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi EigVals
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi β
                            %mo ⋅
                            %msub
                              %mi d
                              %mi C
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi λ
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\big(
                        EigVals[e^{-\beta \cdot d_C}]_\lambda
                        \\big)_{\lambda \in Part(n)}
              %li
                %p
                  have multiplicity the square
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \big(\chi^{(\lambda)}(e)\big)^2
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  of the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
              %li
                %p are given by
                #eq:CharacterFormulaForEigenvalueOfCayleyDistanceKernel.maruku-equation
                  %span.maruku-eq-number (10)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi EigVals
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi β
                            %mo ⋅
                            %msub
                              %mi d
                              %mi C
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi λ
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msup
                                %mi χ
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi λ
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi e
                              %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi σ
                            %mo ∈
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi e
                          %mrow
                            %mi β
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mrow
                              %mo |
                              %mi Cycles
                              %mo{:stretchy => "false"} (
                              %mi σ
                              %mo{:stretchy => "false"} )
                              %mo |
                            %mo −
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        EigVals[e^{- \beta\cdot d_C}]_\lambda
                        \\;=\;
                        \\tfrac{1}{\chi^{(\lambda)}(e)}
                        \\underset{ \sigma \in Sym(n) }{\sum}
                        e^{ \beta \cdot ( \left\vert Cycles(\sigma)\right\vert - n )   }
                        \\cdot
                        \\chi^{(\lambda)}(\sigma)
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi^{(\lambda)}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+character"} irreducible character
                  corresponding to the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
              %li
                %p
                  correspond to
                  %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
                  given by the
                  %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugate
                  of the
                  = succeed "-components," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i,j)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ∈
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msup
                            %mi χ
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                        %annotation{:encoding => "application/x-tex"} i,j  \in \big\{1, \cdots, \chi^{(\lambda)}(e) \big\}
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda
                  %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} S^{(\lambda)} \colon Sym(n) \to U\big(\chi^{(\lambda)}(e)\big)
                  regarded for each
                  %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/unitary+matrix"} unitary matrix
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi S
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                          %msub
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                        %annotation{:encoding => "application/x-tex"} \big(S^{(\lambda)}(\sigma)_{i,j}\big)_{i,j}
                #eq:EigenvectorsOfCayleyDistanceKernel.maruku-equation
                  %span.maruku-eq-number (11)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo |
                          %mi λ
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                          %mo ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi EigVects
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi β
                            %mo ⋅
                            %msub
                              %mi d
                              %mi X
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi λ
                            %mo ,
                            %mi i
                            %mo ,
                            %mi j
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mover
                            %mi S
                            %mo{:stretchy => "false"} ¯
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi σ
                            %mo ∈
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi ℂ
                        %mo{:stretchy => "false"} [
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left\vert
                        \\lambda, (i,j)
                        \\right\rangle
                        \\;\coloneqq\;
                        EigVects[e^{-\beta \cdot d_X}]_{\lambda, i, j}
                        \\;=\;
                        \\big(
                        \\bar S^{(\lambda)}(\sigma)_{i j}
                        \\big)_{\sigma \in Sym(n)}
                        \\;\;
                        \\in
                        \\;
                        \\mathbb{C}[Sym(n)]
                        \\,.
            %p
          %p
            %br/
          %p#EigenvaluesFurther
            We further characterize these eigenvalues (Prop.
            %a.maruku-ref{:href => "#EigenvaluesAtLogIntegerInvTemViaYoungTabl"}
            below) at the special inverse temperatures of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo =
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta = ln(N)
          %p
          #SetsOfSemistandardYoungTableau.num_defn
            %h6 Definition
            %p
              %strong (notation for sets of semistandard Young tableaux)
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ,
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n, N \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ssYT
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    ssYT_n(N)
                    \\;\in\;
                    Set
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
            %ul
              %li
                %p
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  boxes, and
              %li
                %p
                  all labels
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≤
                          %mi N
                        %annotation{:encoding => "application/x-tex"} \leq N
            %p
              Moreover for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi Part
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda \in Part(n)
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ssYT
                      %mrow
                        %mi λ
                        %mo ⊢
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi T
                    %mo ∈
                    %msub
                      %mi ssYT
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi λ
                    %mo =
                    %mrow
                      %mo |
                      %mi T
                      %mo |
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ssYT
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ssYT_{\lambda \vdash n}(N)
                    \\;\coloneqq\;
                    \\big\{
                    T \in ssYT_n(N)
                    \\;\vert\;
                    \\lambda
                    \=
                    \\left\vert T \right\vert
                    \\big\}
                    \\;\subset\;
                    ssYT_{n}(N)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              on those tableau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi T
                      %mo |
                  %annotation{:encoding => "application/x-tex"} \left\vert T \right\vert
              corresponds to the partition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            %p
          %p
          #CharacterForumlaForIntegerExponentialByCycleNumber.num_lemma
            %h6 Lemma
            %p
              %strong (character formula for integer exponential by cycle number)
              %br/
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              to the number of
              %a.existingWikiWord{:href => "/nlab/show/permutation+cycles"} cycles of a permutation
              is, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/class+function"} class function
              %a.existingWikiWord{:href => "/nlab/show/irreducible+characters"} irreducible characters
              weighted by the number of corresponding
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableaux"} semistandard Young tableaux
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SetsOfSemistandardYoungTableau"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mrow
                        %mo |
                        %mi Cycles
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi T
                        %mo ∈
                        %msub
                          %mi ssYT
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi χ
                      %mrow
                        %mo |
                        %mi T
                        %mo |
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N^{\left\vert Cycles(-) \right\vert}
                    \\;=\;
                    \\underset{
                    T \in ssYT_n(N)
                    }{\sum}
                    \\chi^{ \left\vert T \right\vert }(-)
                    \\,.
            %p
          %p
            This is the statement of
            %a{:href => "#GnedinGorinKerov11"} Gnedin, Gorin &amp; Kerov 11, Prop. 2.4
            (with notation from Prop. 2.1).
          %p
          #EigenvaluesAtLogIntegerInvTemViaYoungTabl.num_prop
            %h6 Proposition
            %p
              %strong
                (Eigenvalues of Cayley distance kernel at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo =
                      %mi ln
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta = ln(N)
                count semistandard Young tableaux)
              %br/
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %mi Part
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda \in Part(n)
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %a.maruku-eqref{:href => "#eq:EigenvaluesLabeledByPartitions"} (9)
              of the Cayley distance kernel at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo =
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta = ln(N)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              is proportional to the number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi ssYT
                        %mrow
                          %mi λ
                          %mo ⊢
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo |
                  %annotation{:encoding => "application/x-tex"} \left\vert ssYT_{\lambda \vdash n}(N)\right\vert
              of
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableaux"} semistandard Young tableaux
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SetsOfSemistandardYoungTableau"}
            #eq:EigenvaluesAtLogIntegerInverseTempeteratureCountingYoungTableaux.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EigVals
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi d
                          %mi c
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mi n
                          %mo !
                        %mrow
                          %msup
                            %mi N
                            %mi n
                          %mo ⋅
                          %msup
                            %mi χ
                            %mrow
                              %mo{:stretchy => "false"} (
