                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [P^{(\lambda)}_{i_\lambda}]^\dagger = [P^{(\lambda)}_{i_\lambda}]
          %p
            (by grand Schur orthogonality, see
            = succeed ")." do
              %a{:href => "Cayley+distance+kernel#DualEigenvectorBasis"} this Prop.
          %h4#the_mixture The mixture
          %p
            Using the above properties of the projectors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
