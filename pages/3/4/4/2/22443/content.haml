                            %mi ℂ
                            %mo{:stretchy => "false"} [
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
