                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} e^\beta = N \in \{1,2, \cdots, n-1\}
              the Cayley distance kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
