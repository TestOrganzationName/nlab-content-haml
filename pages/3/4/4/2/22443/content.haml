                        %munder
                          %mo ∀
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi EigVals
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ln
                            %mo{:stretchy => "false"} (
