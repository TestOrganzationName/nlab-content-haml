                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mn 6
                        %mo ×
                        %mn 6
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [d_C]
                    \\;\coloneqq\;
                    \\big(
                    d_C
                    \\big(
                    \\sigma_i, \sigma_j
                    \\big)
                    \\big)_{i,j}
                    \\;\in\;
                    Mat_{6 \times 6}(\mathbb{N})
            %p is
            #eq:ExplicitCayleyDistanceMatrix.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                          %mtr
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    [d_c]
                    \\;=\;
                    \\left[
                    \\array{
                    0 &amp; 1 &amp; 1 &amp; 1  &amp; 2 &amp;  2
                    \\\
                    1 &amp; 0 &amp; 2 &amp; 2 &amp; 1 &amp; 1
                    \\\
                    1 &amp; 2 &amp; 0 &amp; 2 &amp; 1 &amp; 1
                    \\\
                    1 &amp; 2 &amp; 2 &amp; 0 &amp; 1 &amp; 1
                    \\\
                    2 &amp; 1 &amp; 1 &amp; 1 &amp; 0 &amp; 2
                    \\\
                    2 &amp; 1 &amp; 1 &amp; 1 &amp; 2 &amp; 0
                    }
                    \\right]
            %p
              One checks (
              %a{:href => "https://www.wolframalpha.com/input/?i=eigenvalues++exp%5B+-+ln%5Bkappa%5D+*++%7B++%7B0%2C1%2C1%2C1+%2C2%2C+2%7D%2C+%7B1%2C+0+%2C+2%2C+2%2C+1%2C+1%7D%2C+%7B1%2C+2%2C+0%2C+2%2C+1%2C+1%7D%2C+%7B1%2C2%2C+2%2C0%2C1%2C+1+%7D%2C+%7B2%2C+1%2C+1%2C+1%2C+0%2C+2+%7D%2C+%7B2%2C1%2C1%2C1%2C2%2C0%7D++%7D+%5D"}> here
              ) that the Cayley distance kernel
            #eq:CayleyDistanceKernel.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mn 6
                        %mo ×
                        %mn 6
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    e^{- \beta \cdot d_C}
                    \\big]
                    \\;\in\;
                    Mat_{6 \times 6}(\mathbb{R})
            %p
              has the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi β
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo −
                        %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi β
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi β
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo ±
                        %mn 3
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi β
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi β
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac
                    {
                    (e^\beta)^2 -1
                    }
                    {(e^\beta)^2}
                    \\,,\;\;\;
                    \\frac
                    {
                    (e^\beta)^2 \pm 3 (e^\beta)  + 2
                    }
                    {(e^\beta)^2}
                    \\,,
            %p
              where the first one appears with multiplicity 4. Exactly one of these can become non-positive for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \beta \in \mathbb{R}_+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi β
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo &lt;
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi e
                                %mi β
                              %mo{:stretchy => "false"} )
                              %mo &lt;
                              %mn 2
                          %mtr
                            %mtd
                              %mo =
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi e
                                %mi β
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 2
                          %mtr
                            %mtd
                              %mo &gt;
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi e
                                %mi β
                              %mo{:stretchy => "false"} )
                              %mo &gt;
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    (e^\beta)^2 - 3 (e^\beta) + 2
                    \\;is\;
                    \\left\{
                    \\array{
                    \\lt 0 &amp;\vert&amp;  (e^\beta) \lt 2
                    \\\
                    \= 0 &amp;\vert&amp; (e^\beta) = 2
                    \\\
                    \\gt 0 &amp;\vert&amp; (e^\beta) \gt 2
                    }
                    \\right.
            %p
              The following plot (via WolframAlpha,
              = succeed ")" do
                %a{:href => "https://www.wolframalpha.com/input/?i=min%5B+%7B+N%5E2+-+1+%7D%2C+%7B+N%5E2+%2B+3+*+N+%2B+2+%7D%2C+%7B+N%5E2+-+3+*+N+%2B+2+%7D+%5D++for+0.6+%3C+N+%3C+3"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mn 2
                        %mi β
                  %annotation{:encoding => "application/x-tex"} e^{2 \beta}
              times) the lowest eigenvalue of the Cayley distance kernel on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(3)
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ≔
                      %msup
                        %mi e
                        %mi β
                    %annotation{:encoding => "application/x-tex"} N \coloneqq e^{\beta}
            %p
              %a{:href => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym3.jpg"}
                %img{:src => "https://ncatlab.org/nlab/files/LowestEigenvalueOfCayleyDistanceKernelOnSym3.jpg", :width => "350"}/
            %p
              In conclusion: The
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CayleyDistanceKernel"} (3)
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              on the
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}[Sym(3)]
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext indefinite
                          %mtd
                            %mtext for
                          %mtd
                            %msup
                              %mi e
                              %mi β
                            %mo &lt;
                            %mn 2
                        %mtr
                          %mtd
                            %mtext positive semi-definite
                          %mtd
                            %mtext for
                          %mtd
                            %msup
                              %mi e
                              %mi β
                            %mo =
                            %mn 2
                        %mtr
                          %mtd
                            %mtext positive definite
                          %mtd
                            %mtext for
                          %mtd
                            %msup
                              %mi e
                              %mi β
                            %mo &gt;
                            %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\text{indefinite} &amp; \text{for} &amp; e^{\beta} \lt 2
                    \\\
                    \\text{positive semi-definite} &amp;\text{for}&amp; e^{\beta} = 2
                    \\\
                    \\text{positive definite} &amp;\text{for}&amp;  e^{\beta} \gt 2
                    }
            %p
              This exhibits the general behaviour discussed as Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FailureOfPositivityForBetaBelowLn2"}
              = succeed "," do
                %a.maruku-ref{:href => "#PositiveSemidefinitenessAtLowIntegerValuedOfEBeta"}
              %a.maruku-ref{:href => "#ExplicitBoundForInverseTemperatureEnsuringPositivity"}
              below.
            %p
          %p
          #CayleyDistanceKernelOnSym4.num_remark
