                    \\cdot
                    v_2(\sigma)
                    }
            %p
              denote the
              %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear form
              induced by the canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of the
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}[Sym(n)]
            %p
          %p
          #DualEigenvectorBasis.num_prop
            %h6 Proposition
            %p
              %strong (dual eigenvector basis)
            %p
              With respect to the Cartesian inner product from Def.
              = succeed "," do
                %a.maruku-ref{:href => "#CartesianInnerProduct"}
              %a.maruku-eqref{:href => "#eq:EigenvectorsOfCayleyDistanceKernel"} (11)
              from Prop.
              %a.maruku-ref{:href => "#CharacterFormulaForEigenvalues"}
              have a
              %a.existingWikiWord{:href => "/nlab/show/dual+basis"} dual basis
              given by
            #eq:TheDualEigenvectorBasis.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %mi λ
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo !
                    %mi EigVects
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi χ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo !
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ¯
                      %mrow
                        %mi i
                        %mi j
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle
                    \\lambda, (i, j)
                    \\right\vert
                    \\;\coloneqq\;
                    \\frac
                    {
                    \\chi^{(\lambda)}(e)
                    }
                    {
                    n!
                    }
                    EigVects[e^{- \beta \cdot d_C}]_\lambda
                    \\;=\;
                    \\frac
                    {
                    \\chi^{(\lambda)}(e)
                    }
                    {
                    n!
                    }
                    \\big(
                    \\bar S^{(\lambda)}_{i j}(\sigma)
                    \\big)_{\sigma \in Sym(n)}
                    \\,.
            %p
          Beware that the original eigenvector basis
          %a.maruku-eqref{:href => "#eq:EigenvectorsOfCayleyDistanceKernel"} (11)
          already involves the
          %a.existingWikiWord{:href => "/nlab/show/complex+conjugate"} complex conjugate
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mover
                  %mi S
                  %mo{:stretchy => "false"} ¯
              %annotation{:encoding => "application/x-tex"} \bar S
          of component entries.
          %p
          .proof
            %h6 Proof
            %p
              This is a restatement of the
              %a.existingWikiWord{:href => "/nlab/show/Schur+orthogonality+relation"} Schur orthogonality relation
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
              %a.existingWikiWord{:href => "/nlab/show/Specht+modules"} Specht modules
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^{(\lambda)}
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                            %msub
                              %mi λ
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mn 1
                            %mo ,
                            %msub
                              %mi j
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %msub
                              %mi λ
                              %mn 2
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mn 2
                            %mo ,
                            %msub
                              %mi j
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %msup
                                  %mi χ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi λ
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi e
                                %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo !
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi S
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi λ
                                  %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi j
                                  %mn 1
                                %msub
                                  %mi i
                                  %mn 1
                            %mover
                              %mrow
                                %msup
                                  %mi S
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi λ
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi σ
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 2
                                    %msub
                                      %mi j
                                      %mn 2
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi δ
                              %mrow
                                %msub
                                  %mi λ
                                  %mn 1
                                %msub
                                  %mi λ
                                  %mn 2
                            %msub
                              %mi δ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                                %msub
                                  %mi i
                                  %mn 2
                            %msub
                              %mi δ
                              %mrow
                                %msub
                                  %mi j
                                  %mn 1
                                %msub
                                  %mi j
                                  %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big\langle
                    \\lambda_1, (i_1, j_1)
                    \\big\vert
                    \\lambda_2, (i_2, j_2)
                    \\big\rangle
                    \&amp;
                    \\;=\;
                    \\frac{ \chi^{(\lambda_1)}(e) }{ n! }
                    \\underset{\sigma \in Sym(n)}{\sum}
                    S^{(\lambda_1)}(\sigma)_{j_1 i_1}
                    \\overline{
                    S^{(\lambda_2)}(\sigma)_{i_2 j_2}
                    }
                    \\\
                    \&amp; \;=\;
                    \\delta^{\lambda_1 \lambda_2}
                    \\delta_{i_1 i_2} \delta_{j_1 j_2}
                    \\,.
                    \\end{aligned}
            %p
              Here the first step unwinds the definitions (using
              %a.maruku-eqref{:href => "#eq:TheDualEigenvectorBasis"} (14)
              and
              %a.maruku-eqref{:href => "#eq:EigenvectorsOfCayleyDistanceKernel"} (11)
              in Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CartesianInnerProduct"}
              %a.existingWikiWord{:href => "/nlab/show/grand+Schur+orthogonality+relation"} grand Schur orthogonality relation
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SchurOrthogonalityForIrreps"} (?)
            %p
          %p
            %br/
          %h3#Positivity Positivity
          %p
            We discuss at which values of the
            %a.existingWikiWord{:href => "/nlab/show/inverse+temperature"} inverse temperature
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym(n)
            is, as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
          %h4#indefiniteness_for_
            Indefiniteness for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi β
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mi ⋯
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 2
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e^{\beta} \in (0,1) \cup (1,2) \cup \cdots \cup (n-2,n-1)
          %p
          #FailureOfPositivityForBetaBelowLn2.num_prop
            %h6 Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \geq 3
              and all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi β
                      %mo &lt;
                      %mi ln
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \lt \beta \lt ln(2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              %em fails
              to be positive semi-definite on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(n)
          .proof
            %h6 Proof
            %p
              By Example
              %a.maruku-ref{:href => "#CayleyDistanceKernelOnSym3"}
              the statement holds for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n = 3
              %a.existingWikiWord{:href => "/nlab/show/principal+submatrix"} principal submatrix
              of the kernels in all other cases (see
              = succeed ")," do
                %a{:href => "Cayley+distance#CayleyDistancePreservedByInclusionOfSymmetricGroups"} this Prop.
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy%27s+interlace+theorem"} Cauchy's interlace theorem
          %p More generally:
          %p
          #CayleyDistanceKernelIsIndefiniteForEBetaNonIntegralAndSmallernminusone.num_prop
            %h6 Proposition
            %p
              The Cayley distance kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistanceKernel"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              is indefinite for all
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi ⋯
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    e^{\beta}
                    \\;\in\;
                    (0,1) \cup (1,2) \cup \cdots \cup (n-2, n-1)
                    \\,,
            %p or equivalently:
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %msup
                      %mi e
                      %mi β
                    %mo &lt;
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \lt e^\beta \lt n-1
              the Cayley distance kernel is indefinite except possibly at
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              values.
          .proof
            %h6 Proof
            %p
              With the third statement in Lemma
              %a.maruku-ref{:href => "#SignOfTheEigenvalueOfTheSigantureDistribution"}
              the claim follows for every
              %em second
              open unit
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              between 0 and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n-1
              %em other
              of these unit intervals for the kernel on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n-1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/principal+submatrix"} principal submatrix
              of that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              (see
              = succeed ")," do
                %a{:href => "Cayley+distance#CayleyDistancePreservedByInclusionOfSymmetricGroups"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+interlace+theorem"} Cauchy interlace theorem
              implies that the kernel on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              must have a negative eigenvalue as soon as that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n-1)
              does.
          %h4#PositiveSemiDefinitenessAtLowNaturalNumbers
            Semi-definiteness for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi β
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} e^\beta \in \{1,2,\cdots, n-1\}
          %p
          #EigenvaluesNonNegativeAtNBetween1Andn.num_lemma
            %h6 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo =
                    %mi N
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} e^\beta = N \in \{1, 2, \cdots, n-1\}
              all the eigenvalues of the Cayley distance kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              are non-negative and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} e^\beta = n
              they are all positive.
          .proof
            %h6 Proof
            %p
              We observe that the eigenvalues at these particular values of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              appear, up to a positive multiple, as
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              of
              %a.existingWikiWord{:href => "/nlab/show/monomials"} monomials
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Schur+polynomials"} Schur polynomials
              = succeed ")." do
                %a{:href => "Schur+function#CoefficientsOfMonomialsAreNaturalNumbers"} this Prop.
            %p
              Concretely, for
