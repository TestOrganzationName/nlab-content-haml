                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    EigVals[e^{- ln(N) \cdot d_c}]_\lambda
                    \\;=\;
                    \\tfrac{n!}{N^n \cdot \chi^{(\lambda)}(e)}
                    \\left\vert ssYT_{\lambda}(N)\right\vert
                    \\,.
