                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi rows
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                            %mo ≤
                            %mi N
                    %munder
                      %munder
                        %mrow
                          %mo |
