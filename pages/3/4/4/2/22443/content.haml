              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              using that all eigenvalues are real (the Cayley distance kernel being a real symmetric matrix). The fourth step inserts the character formula from Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#CharacterForumlaForIntegerExponentialByCycleNumber"}
              %a.existingWikiWord{:href => "/nlab/show/Schur+orthogonality"} Schur orthogonality
              (
              %a{:href => "Schur+orthogonality+relation#eq:FirstSchurOrthogonalityRelation"}> this equation
              ).
            %p
          %p As a corollary we obtain:
          %p
          #PositivitiViaCountingOfYoungTableaux.num_prop
            %h6 Proposition
            %p
              %strong (non-negativity of Cayley distance kernel at log-integer inverse temperature)
              %br/
            %p
              For the Cayley distance kernel at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo =
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta = ln(N)
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
            %ol
              %li
                %p
                  all eigenvalues
                  %a.maruku-eqref{:href => "#eq:EigenvaluesLabeledByPartitions"} (9)
                  are non-negative
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi EigVals
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi d
                              %mi c
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi λ
                        %mspace{:width => "thickmathspace"}
                        %mo ≥
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{\lambda \in Part(n)}{\forall}
                        \\,
                        EigVals[e^{- ln(N) \cdot d_c}]_\lambda
                        \\;\geq\;
                        0
                        \\,;
              %li
                %p
                  zero is an eigenvalue for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo &lt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} N \lt n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                        %mspace{:width => "thickmathspace"}
