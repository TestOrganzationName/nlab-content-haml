                                %mo{:stretchy => "false"} (
                                %mi λ
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi k
                                %mi j
                            %mspace{:width => "thinmathspace"}
                            %mi σ
                            %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\sigma'
                  \\;\bullet\;
                  \\left(
                  \\underset{
                  \\sigma \in Sym(n)
                  }{\sum}
                  \\bar S^{(\lambda)}(\sigma)_{i j}
                  \\,
                  \\sigma
                  \\right)
                  \&amp; \;=\;
                  \\underset{
                  \\sigma \in Sym(n)
                  }{\sum}
                  \\bar S^{(\lambda)}(\sigma)_{i j}
                  \\,
                  \\sigma' \bullet \sigma
                  \\\
                  \&amp; =
                  \\underset{
                  \\sigma \in Sym(n)
                  }{\sum}
                  \\bar S^{(\lambda)}( (\sigma')^{-1} \sigma)_{i j}
                  \\,
                  \\sigma
                  \\\
                  \&amp; \;=\;
                  \\underset{
                  \\sigma \in Sym(n)
                  }{\sum}
                  \\underset{ 1 \leq k \leq dim(S^{(\lambda)}) }{\sum}
                  S^{(\lambda)}( \sigma' )_{i k}
                  \\bar S^{(\lambda)}( \sigma)_{k j}
                  \\,
                  \\sigma
                  \\\
                  \&amp; \;=\;
                  \\underset{
                  1 \leq k \leq dim(S^{(\lambda)})
                  }{\sum}
                  S^{(\lambda)}( \sigma' )_{i k}
                  \\left(
                  \\underset{
                  \\sigma \in Sym(n)
                  }{\sum}
                  \\bar S^{(\lambda)}( \sigma)_{k j}
                  \\,
                  \\sigma
                  \\right)
                  \\end{aligned}
          %p Hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo ⊕
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %mi λ
                          %mo ∈
                          %mi Part
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mrow
                          %mn 1
                          %mo ≤
                          %msub
                            %mi i
                            %mi λ
                          %mo ≤
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %msubsup
                    %mi P
                    %mi i
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{C}[Sym(n)]
                  \\;\simeq\;
                  \\underset{
                  { \lambda \in Part(n) }
                  \\atop
                  {1 \leq i_\lambda \leq dim(S^{(\lambda)})}
                  }{\oplus}
                  P^{(\lambda)}_i\big( \mathbb{C}[Sym(n)]  \big)
          %p
            is a decomposition into left
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
          %p
            In fact, this is a decomposition into
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/minimal+ideals"} minimal ideals
          %p
            The minimal left ideals of any complex
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[G]
            are labeled by pairs consisting of an
            %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \in Rep(G)
            and a left ideal in the linear
            %a.existingWikiWord{:href => "/nlab/show/endomorphism+algebra"} endomorphism algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi End
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} End_{\mathbb{C}}(V)
            (by
            = succeed ")." do
              %a{:href => "group+algebra#ComplexGroupAlgebraOfFiniteGroupAsDirectSumOfEndomorphismAlgebras"} this Prop.
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
            and hence its left minimal ideals are the
            = succeed "-many" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[G]
            are labeled by pairs consisting of an irrep and a postitive natural number no larger than the dimension of the irrep. This is the same number/cardinality of ideals we found above, hence they must already be minimal.
          %p
            (It’s also the same number of primitive idempotents as used in the discussion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Jucys-Murphy+elements"} Jucys-Murphy elements
            = succeed ".)" do
              %a{:href => "Jucys-Murphy+element#Projectors"} there
          %p
            %br/
          %p
            This decomposition of the group algebra into left ideals implies that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A \in \mathbb{C}[Sym(n)]
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi P
                    %mrow
                      %msub
                        %mi i
                        %mi λ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi P
                    %mrow
                      %msub
                        %mi i
                        %mi λ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [P^{(\lambda)}_{i_\lambda}] \cdot [A]
                  \\;=\;
                  [A] \cdot [P^{(\lambda)}_{i_\lambda}]
          %p Moreover, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi P
                    %mrow
                      %msub
                        %mi i
                        %mi λ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi P
                    %mrow
                      %msub
                        %mi i
                        %mi λ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [e^{- \beta \cdot d_C}]
                  \\cdot
                  [P^{(\lambda)}_{i_\lambda}]
                  \\;=\;
                  [P^{(\lambda)}_{i_\lambda}]
                  \\cdot
                  [e^{- \beta \cdot d_C}]
          %p
            by the fact that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi σ
                  %msup
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ¯
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \underset{ \sigma }{ \sum } \bar S^{(\lambda)}(\sigma) \, \sigma
            are eigenvectors of the Cayley distance kernel.
          %p Finally, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %msubsup
                      %mi P
                      %mrow
                        %msub
                          %mi i
                          %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ¯
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %msub
                          %mi j
                          %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi λ
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ¯
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                        %mo ,
                        %msub
                          %mi j
                          %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi λ
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %msubsup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ¯
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %msub
                          %mi j
                          %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi λ
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi P
                      %mrow
                        %msub
                          %mi i
                          %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
