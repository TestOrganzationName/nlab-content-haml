                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              is positive definite for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi n
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo ,
                      %mi n
                      %mo +
                      %mn 2
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} e^\beta \in \{n, n+1, n+2, \cdots\}
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#PositiveSemidefinitenessAtLowIntegerValuedOfEBeta"}
              the CD kernel on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n + k)
              is positive definite at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                      %mo =
                      %mi n
                      %mo +
                      %mi k
                    %annotation{:encoding => "application/x-tex"} e^\beta = n + k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/principal+submatrix"} principal submatrix
              of this positive one (see
              = succeed ")," do
                %a{:href => "Cayley+distance#CayleyDistancePreservedByInclusionOfSymmetricGroups"} this Prop.
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+interlace+theorem"} Cauchy interlace theorem
          %p
            Alternatively, this follows from the third clause of Prop.
            %a.maruku-ref{:href => "#PositivitiViaCountingOfYoungTableaux"}
          %h4#DefinitenessForEBetaGreaterThann
            Definiteness for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} e
                    %mi β
                  %mo &gt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} \e^\beta \gt n
          %p
          #CayleyDistanceKernelPositiveForEBetaGreaterThann.num_prop
            %h6 Proposition
            %p
              The Cayley distance kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              is positive definite for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                      %mo &gt;
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} e^\beta \gt n - 1
          .proof
            %h6 Proof
            %p
            %p
              With the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %a.maruku-ref{:href => "#EigenvaluesInTermsOfHookContent"}
              or Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#EigenvaluesInTermsOfJustBoxContent"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi content
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi j
                    %mo −
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo &gt;
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    e^\beta + content(i,j)
                    \\;\coloneqq\;
                    e^{\beta} + j - i
                    \\;\gt\;
                    0
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j)
              that appear in the product, hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mn 1
                    %mo −
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo &gt;
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    e^{\beta} + 1 - i
                    \\;\gt\;
                    0
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              that appear. But the index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              labels the rows of
              %a.existingWikiWord{:href => "/nlab/show/Young+diagrams"} Young diagrams
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              boxes, and hence the condition is that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo &gt;
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi max
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi i
                            %mo ≤
                            %mi rows
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi n
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    e^{\beta}
                    \\;\gt\;
                    \\underset{
                    {
                    \\lambda \in Part(n)
                    }
                    \\atop
                    {
                    1 \leq i \leq rows(\lambda)
                    }
                    }{max}
                    (i - 1)
                    \\;=\;
                    n - 1
                    \\,.
            %p
          %p
            %br/
          %p
            The following is an alternative proof of a much weaker lower bound, not relying on the
            %a.existingWikiWord{:href => "/nlab/show/hook-content+formula"} hook-content formula
            from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            %a.existingWikiWord{:href => "/nlab/show/Gershgorin+circle+theorem"} Gershgorin circle theorem
            from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
          %p
          .num_prop
            %h6 Proposition
            %p
              A sufficient condition for the Cayley distance kernel (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistanceKernel"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              to be
              %a.existingWikiWord{:href => "/nlab/show/positive+definite+bilinear+form"} positive definite
              is that its
              %a.existingWikiWord{:href => "/nlab/show/inverse+temperature"} inverse temperature
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              satisfies the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inequality"} inequality
            #eq:GershgorinBoundOnTemperatureForPositivity.maruku-equation
              %span.maruku-eq-number (16)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi β
                    %mo +
                    %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo &lt;
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %msup
                      %mi e
                      %mrow
                        %mi β
                        %mo ⋅
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
                    \\;\lt\;
                    2
                    e^{\beta \cdot n }
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Gershgorin+circle+theorem"} Gershgorin circle theorem
              and using Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#GershgorinRadiiOfCayleyDistanceKernel"}
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              of the kernel are within a distance
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(\beta)
              %a.maruku-eqref{:href => "#eq:GershgorinRadiusExpression"} (6)
              from its diagonal values, which are all equal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo =
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi β
                          %mo ⋅
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 = e^{- \beta \cdot 0}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
            #eq:GershgorinRadiusConditionForNonNegativeEigenvalues.maruku-equation
              %span.maruku-eq-number (17)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi β
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi n
                            %mspace{:width => "thinmathspace"}
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi e
                              %mi β
                            %mo +
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo −
                            %mn 1
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo &lt;
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mn 1
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi n
                            %mspace{:width => "thinmathspace"}
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi e
                              %mi β
                            %mo +
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo &lt;
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    r(\beta)
                    \\;=\;
                    e^{- \beta \cdot n }
                    \\,
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
                    \-
                    1
                    \&amp;
                    \\;\;\lt\;\;
                    1
                    \\\
                    \\Leftrightarrow
                    \\;\;\;
                    e^{- \beta \cdot n }
                    \\,
                    \\underoverset
                    {k = 0}
                    {n - 1}
                    {\prod}
                    \\big(
                    e^{\beta}
                    +
                    k
                    \\big)
                    \&amp;
                    \\;\;\lt\;\;
                    2
                    \\end{aligned}
            %p
              implies that all eigenvalues are contained in the
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} (0,2) \subset \mathbb{R}
              and hence in particular that they are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
          %p
          #ExplicitBoundForInverseTemperatureEnsuringPositivity.num_prop
            %h6 Proposition
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/inverse+temperature"} inverse temperature
              being the
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
              of a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            #eq:InverseTemperatureEqualToNaturalLogarithmOfNaturalNumber.maruku-equation
              %span.maruku-eq-number (18)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    \\beta
                    \\;=\;
                    \\ln(N)
                    \\,,
                    \\;\;\;
                    N \,\in\, \mathbb{N}
            %p
              a sufficient condition for the Cayley distance kernel (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistanceKernel"}
              %a.existingWikiWord{:href => "/nlab/show/positive+semi-definite+bilinear+form"} positive semi-definite
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              is that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo &gt;
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mrow
                        %msup
                          %mi q
                          %mrow
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\;\gt\;
                    \\frac{
                    n-1
                    }{
                    q^{1/n} - 1
                    }
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} q = 3
          .proof
            %h6 Proof
            %p
              First consider the case of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} q =2
            %p
              In the given case
              %a.maruku-eqref{:href => "#eq:InverseTemperatureEqualToNaturalLogarithmOfNaturalNumber"} (18)
              the Gershgorin bound
              %a.maruku-eqref{:href => "#eq:GershgorinBoundOnTemperatureForPositivity"} (16)
              for positive semi-definity of the Cayley distance kernel reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo +
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mi ⋯
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo +
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo +
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                    %mspace{:width => "thickmathspace"}
                    %mo &lt;
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %msup
                      %mi N
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \= (N + n - 1)! / (N - 1)!
                    }{
                    \\underbrace{
                    N
                    (N + 1)
                    (N + 2)
                    \\cdots
                    (N + n - 1)
                    }
                    }
                    \\;\lt\;
                    2
                    N^n
            %p and hence may equivalently be expressed as
            #eq:GershgorinPositivityBoundForInverseTemperatureTheLogOfNaturalNumber.maruku-equation
              %span.maruku-eq-number (19)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mfrac
                              %mrow
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} )
                                %mi ⋯
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo +
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                              %mrow
                                %msup
                                  %mi N
                                  %mi n
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo &lt;
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %mrow
                              %mo (
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi N
                                    %mo +
                                    %mi n
                                    %mo −
                                    %mn 1
                                %mrow
                                  %mrow
                                    %mi N
                                    %mo −
                                    %mn 1
                              %mo )
                            %mo ⋅
                            %mfrac
                              %mrow
                                %mi n
                                %mo !
                              %mrow
                                %msup
                                  %mi N
                                  %mi n
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo &lt;
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %mspace{:width => "thinmathspace"}
                    %mtext is positive definite on
                    %mspace{:width => "thinmathspace"}
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;
                    \\frac{
                    N (N + 1 ) \cdots (N + n -1)
                    }{
                    N^n
                    }
                    \&amp;
                    \\;\lt\;
                    2
                    \\\
                    \\Leftrightarrow
                    \&amp;
                    \\left(
                    { N + n - 1 }
                    \\atop
                    { N -1 }
                    \\right)
                    \\cdot
                    \\frac{
                    n !
                    }{
                    N^n
                    }
                    \&amp;
                    \\;\lt\;
                    2
                    }
                    \\;\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;\;
                    e^{- ln(N) \cdot d_C}
                    \\,
                    \\text{is positive definite on}
                    \\,
                    Sym(n)
                    \\,.
            %p With the evident bound
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi ⋯
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo +
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi N
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %mi N
                            %mo +
                            %mi n
                            %mo −
                            %mn 1
                          %mi N
                        %mo )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %mn 1
                        %mo +
                        %mfrac
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                          %mi N
                        %mo )
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    N (N + 1 ) \cdots (N + n -1)
                    }{
                    N^n
                    }
                    \\;\leq\;
                    \\left(
                    \\frac{
                    N + n - 1
                    }{
                    N
                    }
                    \\right)^n
                    \\;=\;
                    \\left(
                    1
                    +
                    \\frac{
                    n - 1
                    }{
                    N
                    }
                    \\right)^n
                    \\,,
            %p
              the condition
              %a.maruku-eqref{:href => "#eq:GershgorinPositivityBoundForInverseTemperatureTheLogOfNaturalNumber"} (19)
              is satisfied as soon as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                                %mo (
                                %mn 1
                                %mo +
                                %mfrac
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                                  %mi N
                                %mo )
                              %mi n
                            %mspace{:width => "thickmathspace"}
                            %mo &lt;
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi N
                            %mspace{:width => "thickmathspace"}
                            %mo &gt;
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                              %mrow
                                %msup
                                  %mn 2
                                  %mrow
                                    %mn 1
                                    %mo{:stretchy => "false"} /
                                    %mi n
                                %mo −
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp;
                    \\left(
                    1
                    +
                    \\frac{
                    n - 1
                    }{
                    N
                    }
                    \\right)^n
                    \\;\lt\;
                    2
                    \\\
                    \\Leftrightarrow
                    \\;\;\;
                    \&amp;
                    N
                    \\;\gt\;
                    \\frac{
                    n-1
                    }{
                    2^{1/n} - 1
                    }
                    \\end{aligned}
            %p
              Now to improve this to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} q =3
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo &gt;
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N \gt n-1
              = succeed ")" do
                %a.maruku-ref{:href => "#HomogeneousDistributionIsEigenvalue"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SignatureDistributionIsEigenvector"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SignOfTheEigenvalueOfTheSigantureDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/Cayley+graph+spectra"} Cayley graph spectra
              (
              %a{:href => "Cayley+graph+spectrum#CharacterFormula"}> this Prop
              ) these are precisely the two eigenvalues with unit multiplicity. Therefore a strengthening of the
              %a.existingWikiWord{:href => "/nlab/show/Gershgorin+circle+theorem"} Gershgorin circle theorem
              applies to all the remaining eigenvalues, saying (
              %a{:href => "Gershgorin+circle+theorem#StrengtheningForNonNegativeMatrices"}> this Prop.
              ) that these are in fact within
              %em half
              the Gershgorin radius
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GershgorinRadiusExpression"} (6)
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GershgorinRadiusConditionForNonNegativeEigenvalues"} (17)
          %p
          .num_remark
            %h6 Remark
            %p
              Computer-experiment suggests (
              %a{:href => "#CSS21"}> CSS21
              ,
              = succeed ")" do
                %a{:href => "#BarNatan21"} Bar-Natan 21
              = succeed ")" do
                %a.maruku-ref{:href => "#ExplicitBoundForInverseTemperatureEnsuringPositivity"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ≥
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta \geq ln(N-1)
              is already sufficient for positive semi-definiteness.
          %p
            %br/
          %h3#CayleyStateOnTheGroupAlgebra Cayley state on the group algebra
          %blockquote
            %p under construction
          %p
            We observe that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi β
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mo +
                %annotation{:encoding => "application/x-tex"} e^\beta \in \mathbb{R}_+
            integral or greater than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
            defines a
            %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
            (in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state on a star-algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"}
                  \\big\langle
                  \-
                  \\big\rangle_\beta
                  \\;\colon\;
                  \\mathbb{C}[Sym(n)]
                  \\longrightarrow
                  \\mathbb{C}
          %p
            on the
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            canonically regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
            %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed state
            given by a
            %a.existingWikiWord{:href => "/nlab/show/probability+distribution"} probability distribution
            on
            %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
            which are labeled by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
          %blockquote
            %p unpolished notes
          %h4#the_algebra The algebra
          %p
            We regard the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[Sym(n)]
            as equipped with the
            %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear form
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %msub
                    %mi σ
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ¯
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi a
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi δ
                    %mrow
                      %msub
                        %mi σ
                        %mn 1
                      %mo ,
                      %msub
                        %mi σ
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi for
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %mo ∈
                  %mi ℂ
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi σ
                    %mn 1
                  %mo ,
                  %msub
                    %mi σ
                    %mn 2
                  %mo ∈
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (a_1 \sigma_1, a_2 \sigma_2)
                  \\;\coloneqq\;
                  \\bar a_1
                  \\,
                  a_2
                  \\,
                  \\delta_{\sigma_1, \sigma_2}
                  \\,,
                  \\;\;\;\;\;
                  for \; a_1, a_2 \in \mathbb{C}, \; \sigma_1, \sigma_2 \in Sym(n)
                  \\,.
          %p
            We regard any
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            on the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[Sym(n)]
            as a
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\phi]
            with respect to the canonical
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %msub
                        %mi σ
                        %mn 1
                      %mo ,
                      %msub
                        %mi σ
                        %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi σ
                    %mn 1
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\phi]_{\sigma_1, \sigma_2}
                  \\;\coloneqq\;
                  \\big(
                  \\sigma_1, \phi(\sigma_2)
                  \\big)
                  \\,.
          %p
            We denote
            %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            by “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            ”, so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ϕ
                    %mn 2
                  %mo ∘
                  %msub
                    %mi ϕ
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ϕ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ϕ
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [ \phi_2 \circ \phi_1 ]
                  \\;=\;
                  [\phi_2]
                  \\cdot
                  [\phi_1]
                  \\,.
          %p
            Next, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[Sym(n)]
            regarded as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                  %annotation{:encoding => "application/x-tex"} \bullet
          %p
            This way, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo ∈
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathbb{C}[Sym(n)]
            and with any element of the group algebra conflated with the endomorphism of left multiplication by this element, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo •
                  %mi B
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [ A \bullet B]
                  \\;=\;
                  [A] \cdot [B]
          %p Notice that in this notation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo •
                  %mi e
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mi e
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  A \;=\; A \bullet e \;=\; [A] \cdot e
                  \\,,
          %p
            reflecting that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} e \in \mathbb{C}[Sym(n)]
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+vector"} cyclic vector
          %p
            Finally, we consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[Sym(n)]
            as a complex
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
            via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mi σ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ¯
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi σ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (a \, \sigma)^\ast \;=\; \bar a \, \sigma^{-1}
                  \\,.
          %p Noticing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi A
                    %mo *
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi σ
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi σ
                        %mn 1
                      %msubsup
                        %mi σ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi σ
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big(
                  [A^\ast] \cdot [\sigma_1]
                  ,\,
                  [\sigma_2]
                  \\big)
                  \\;=\;
                  a_{ \sigma_1 \sigma_2^{-1} }
                  \\;=\;
                  \\big(
                  [\sigma_1]
                  ,\,
                  [A]\cdot [\sigma_2]
                  \\big)
          %p we see that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo †
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msup
                    %mi A
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                %annotation{:encoding => "application/x-tex"}
                  [A]^\dagger \;=\; \big[ A^\ast \big]
          %p and so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %mi Mat
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo !
                  %mo ×
                  %mi n
                  %mo !
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{C}[Sym(n)]
                  \\overset{ [-] }{\longrightarrow}
                  Mat(n! \times n!, \mathbb{C})
          %p is a homomorphism of complex star-algebras.
          %p
            %br/
          %h4#TheCayleyState The state
          %p For
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi β
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  e^\beta \in \{1,2, \cdots, n-1\} \cup \mathbb{R}_{\gt n-1}
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
            on this algebra is given by sending any
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi a
                    %mi σ
                  %mi σ
                %annotation{:encoding => "application/x-tex"}
                  A \;=\; \underset{\sigma \in Sym(n)}{\sum} a_\sigma \sigma
          %p to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                  %mi A
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi e
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mi A
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi a
                    %mi σ
                  %mo ⋅
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi σ
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi e
                    %mrow
