                    \\begin{aligned}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{\beta \cdot \left\vert Cycles(\sigma) \right\vert}
                    \\;\;\;
                    \&amp; = \;
                    \\underset{
                    sec \in \Gamma(p_n)
                    }{\sum}
                    e^{ \beta \cdot \left\vert sec^{-1}(\{0\}) \right\vert }
                    \\\
                    \&amp; = \;
                    \\underset{
                    sec \in \Gamma(p_n)
                    }{\sum}
                    \\underoverset
                    {k = 1}
                    {n}
                    {\prod}
                    \\left\{
                    \\array{
                    e^{\beta} &amp;\vert&amp; sec(k) = 0
                    \\\
