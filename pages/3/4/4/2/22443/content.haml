                        %mo{:stretchy => "false"} (
                        %msub
                          %mi λ
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  P^{(\lambda)}_{i_\lambda}( \bar S^{(\lambda_1)}_{i_1, j_1} ),
                  \\,
                  \\bar S^{(\lambda_2)}_{i_2, j_2}
                  \\right)
                  \\;=\;
                  \\left(
                  \\bar S^{(\lambda_1)}_{i_1, j_1},
                  \\,
                  P^{(\lambda)}_{i_\lambda}
                  (
                  \\bar S^{(\lambda_2)}_{i_2, j_2}
