                                %mi ℓ
                                %msub
                                  %mi hook
                                  %mi λ
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi N
                            %mi n
                            %mo !
                            %mfrac
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi i
                                    %mo ,
                                    %mi j
                                    %mo{:stretchy => "false"} )
                                %mi ℓ
                                %msub
                                  %mi hook
                                  %mi λ
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo !
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                            %mfrac
                              %mrow
                                %msup
                                  %mi e
                                  %mi β
                                %mo +
                                %mi j
                                %mo −
                                %mi i
                              %mrow
                                %mi ℓ
                                %msub
                                  %mi hook
                                  %mi λ
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi β
                                %mo ⋅
                                %mi N
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mn 1
                                    %mo ≤
                                    %mi i
                                    %mo ≤
                                    %mi rows
                                    %mo{:stretchy => "false"} (
                                    %mi λ
