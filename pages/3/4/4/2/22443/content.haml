          #CayleyDistanceKernel.num_defn
            %h6 Definition
            %p
              %strong (Cayley distance kernel)
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              denoting the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements, and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi d
                                  %mi C
                          %mtd
                            %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sym(n) \times Sym(n)
                    \&amp;\overset{d_C}{\longrightarrow}&amp;
                    \\mathbb{N}
                    }
            %p
              denoting its
              = succeed "-function," do
                %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
              %em Cayley distance kernel
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \beta \in \mathbb{R}_+
            #eq:CayleyDistanceKernel.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi e
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mi β
                                    %mo ⋅
                                    %msub
                                      %mi d
                                      %mi C
                          %mtd
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sym(n) \times Sym(n)
                    \&amp;
                    \\overset{
                    e^{- \beta \cdot d_C}
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    \\mathbb{R}
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              of the Cayley distance, weighted by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi β
                    %annotation{:encoding => "application/x-tex"} - \beta
            %p
              This may and often is regarded as a
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              and as such often conflated with the corresponding
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              on the
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
