                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathrm{EigVals}[e^{-\mathrm{ln}(N) \cdot d_C}]_\lambda
                    \&amp;
                    \\;=\;
                    \\frac{
                    e^{- \mathrm{ln}(N)\cdot n}
                    }{
                    \\chi^{(\lambda)}(e)
