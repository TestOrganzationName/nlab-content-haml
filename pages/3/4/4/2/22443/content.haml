                          %mo ∃
                          %mrow
                            %mi λ
                            %mo ∈
                            %mi Part
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi EigVals
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi d
                              %mi c
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi λ
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        N \leq n - 1
                        \\;\;\;\;\;\;\;
                        \\Rightarrow
                        \\;\;\;\;\;\;\;
                        \\underset{\lambda \in Part(n)}{\exists}
                        \\,
                        EigVals[e^{- ln(N) \cdot d_c}]_\lambda
                        \\;=\;
                        0
                        \\,;
              %li
                %p
                  all eigenvalues are positive if
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo ≥
                          %mi n
                        %annotation{:encoding => "application/x-tex"} N \geq n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ≥
                        %mi n
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
