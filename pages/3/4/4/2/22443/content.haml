                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mi σ
                                %mo ′
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi σ
                                %mo ∈
                                %mi Sym
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msub
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ¯
                              %mn 1
                            %mo{:stretchy => "false"} (
