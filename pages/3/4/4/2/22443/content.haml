                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{C}[Sym(n)]
                    \\times
                    \\mathbb{C}[Sym(n)]
                    \&amp;
                    \\overset{
                    \\;\;\;\;\;\;
                    \\langle -,-\rangle
                    \\;\;\;\;\;\;
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    \\mathbb{C}
                    \\\
                    \\Big(
                    \\big(
