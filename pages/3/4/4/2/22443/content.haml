                        %mi β
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                  %annotation{:encoding => "application/x-tex"} e^{- \beta \cdot d_C}
              is positive semi-definite.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} e^{\beta} = n
              it is positive definite.
          .proof
            %h6 Proof
            %p
              By Lemma
              %a.maruku-ref{:href => "#EigenvaluesNonNegativeAtNBetween1Andn"}
              the eigenvalues at all these values are non-negative and positive for the special case
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi β
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} e^{\beta} = n
              %a.maruku-ref{:href => "#SignOfTheEigenvalueOfTheSigantureDistribution"}
              they do contain 0 away from this special case.
          %p
            Alternatively, this follows from Prop.
            = succeed "." do
              %a.maruku-ref{:href => "#PositivitiViaCountingOfYoungTableaux"}
          %h4#definiteness_for_
            Definiteness for
