              ,
              %em K-theory from a physical perspective
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/0304018"}> arXiv:hep-th/0304018
              \&amp;rbrack;
          %p
            In relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} Einstein-Cartan theory
          %ul
