                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} AUT(U)(1))
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p for the bosonic string this is discussed in
          %ul
            %li#SSW05
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"} Konrad Waldorf
              = succeed "," do
                %em Unoriented WZW models and Holonomy of Bundle Gerbes
              %strong 274
              1 (2007) 31-64 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/0512283"}> arXiv:hep-th/0512283
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-007-0271-x"} doi:10.1007/s00220-007-0271-x
          %p
            and for the refinement to the
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"}> Jacques Distler
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"} Dan Freed
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                = succeed "," do
