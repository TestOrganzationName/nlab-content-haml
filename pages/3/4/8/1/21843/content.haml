          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cobordism+cohomology+theory"} cobordism cohomology theory
            for
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
          %h2#properties Properties
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi SU
                %annotation{:encoding => "application/x-tex"} \Omega^{SU}_\bullet
            for the
            %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism ring
            for
            %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
          %h3#relation_to_
            Relation to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MU
                %annotation{:encoding => "application/x-tex"} MU
          %p
            The canonical
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} inclusions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  1
                  \\;\subset\;
                  Sp(k)
                  \\;\subset\;
                  SU(2k)
                  \\;\subset\;
                  U(2k)
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
            into
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
            into
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            into
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi Fr
                  %mspace{:width => "thickmathspace"}
                  %mo ⟶
                  %mspace{:width => "thickmathspace"}
                  %mi M
                  %mi Sp
                  %mspace{:width => "thickmathspace"}
                  %mo ⟶
                  %mspace{:width => "thickmathspace"}
                  %mi M
                  %mi SU
                  %mspace{:width => "thickmathspace"}
                  %mo ⟶
                  %mspace{:width => "thickmathspace"}
                  %mi M
                  %mi{:mathvariant => "normal"} U
                %annotation{:encoding => "application/x-tex"}
                  M Fr
                  \\;\longrightarrow\;
                  M Sp
                  \\;\longrightarrow\;
                  M SU
                  \\;\longrightarrow\;
                  M \mathrm{U}
          %p
            (from
            %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
            to
            %a.existingWikiWord{:href => "/nlab/show/MSp"} MSp
            to
            %a.existingWikiWord{:href => "/nlab/show/MSU"} MSU
            to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
          %p
            and hence corresponding
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+cohomology+theories"} cobordism cohomology theories
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphisms"} ring homomorphisms
            of
            %a.existingWikiWord{:href => "/nlab/show/bordism+rings"} bordism rings
          #eq:HomomorphismsOfCobordismRings.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi fr
                  %mo ⟶
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi Sp
                  %mo ⟶
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi SU
                  %mo ⟶
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi U
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^{fr}_{\bullet}
                  \\longrightarrow
                  \\Omega^{Sp}_{\bullet}
                  \\longrightarrow
                  \\Omega^{SU}_{\bullet}
                  \\longrightarrow
                  \\Omega^{U}_{\bullet}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#ConnerFloyd66"} Conner-Floyd 66, p. 27 (34 of 120)
          #KernelOfMapFromSUBordismToUBordismIsTorsion.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful
              morphism
              %a.maruku-eqref{:href => "#eq:HomomorphismsOfCobordismRings"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi SU
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi{:mathvariant => "normal"} U
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{SU}_\bullet
                    \\longrightarrow
                    \\Omega^{\mathrm{U}}_\bullet
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+bordism+ring"} complex bordism ring
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
          %p
            (
            %a{:href => "#CLP19"}> CLP 19, Thm. 5.8a
            )
          #TorsionInSUBordismConcentratedInDegrees1And2Mod8.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              is concentrated in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 8
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 8k+1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 8
                      %mi k
                      %mo +
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 8k+2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
          %p
            (
            %a{:href => "#CLP19"}> CLP 19, Thm. 5.11a
            )
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/torsion+element"} torsion element
              in the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi SU
                  %annotation{:encoding => "application/x-tex"} \Omega^{SU}_\bullet
              has
              %a.existingWikiWord{:href => "/nlab/show/order+of+an+element"} order
              2.
          %p
            (
            %a{:href => "#CLP19"}> CLP 19, Thm. 5.8b
            )
          #SUBordismRingAwayFromTwo.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              with
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} 2 inverted
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}\big[\tfrac{1}{2}\big]
              on one generator in every even degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≥
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} \geq 4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi SU
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mrow
                        %mn 2
                        %mi i
                        %mo +
                        %mn 4
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{SU}\big[\tfrac{1}{2}\big]
                    \\;\simeq\;
                    \\mathbb{Z}
                    \\big[
                    \\tfrac{1}{2}
                    \\big]
                    \\big[
                    \\{
                    y_{2i+4}
                    \\}_{i \in \mathbb{N}}
                    \\big]
                    \\,.
          %p
            (due to
            = succeed "," do
              %a{:href => "#Novikov62"} Novikov 62
            = succeed ")" do
              %a{:href => "#LLP17"} LLP 17, Thm. 1.2
          %h3#RelationToCalabiYauManifolds Relation to Calabi-Yau manifolds
          %p
            We discuss the classes of
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds+in+SU-bordism+theory"} Calabi-Yau manifolds in SU-bordism theory
          #K3SurfaceSpansSUBordismRingInDegree4.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
                spans
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                in degree 4)
            %p
              The degree-4 generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 4
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                  %annotation{:encoding => "application/x-tex"} y_4 \in \Omega^{SU}_4
              in the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SUBordismRingAwayFromTwo"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/torus"} torus
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
            #eq:K3GeneratesNonTorsionSUBordimsRing.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{SU}_4
                    \\;\simeq\;
                    \\mathbb{Z}\big\langle -[K3] \big\rangle
                    \\,.
          %p
            (
            %a{:href => "#LLP17"}> LLP 17, Example 3.1
            ,
            = succeed ")" do
              %a{:href => "#CLP19"} CLP 19, Theorem 13.5a
          #K3SurfaceInUBordismRing.num_cor
            %h6#corollary Corollary
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
                represents non-trivial element in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/U-bordism+ring"} U-bordism ring
            %p
              The image in the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/cobordism+ring"} cobordism ring
              of the class of the
              %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                  %annotation{:encoding => "application/x-tex"} [K3] \in \Omega^{SU}_4
              %a.maruku-eqref{:href => "#eq:K3GeneratesNonTorsionSUBordimsRing"} (2)
              under the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                    %mo →
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi{:mathvariant => "normal"} U
                  %annotation{:encoding => "application/x-tex"} \Omega^{SU}_4 \to \Omega^{\mathrm{U}}_4
              %a.maruku-eqref{:href => "#eq:HomomorphismsOfCobordismRings"} (1)
              is non-trivial.
            %p
              In fact, the canonical morphism is an
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              in this degree
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mn 4
                              %mi SU
                          %mtd
                            %mo ↪
                          %mtd
                            %msubsup
                              %mi Ω
                              %mn 4
                              %mi{:mathvariant => "normal"} U
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mn 3
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mn 3
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega^{SU}_4
                    \&amp;\hookrightarrow&amp;
                    \\Omega^{\mathrm{U}}_4
                    \\\
                    [K3] &amp;\mapsto&amp; [K3]
                    \\,.
                    }
          %p
            (This is vaguely indicated in
            = succeed ".)" do
              %a{:href => "#Novikov86"} Novikov 86, p. 216 (218 of 321)
          %p
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#KernelOfMapFromSUBordismToUBordismIsTorsion"}
              the kernel of the map to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi{:mathvariant => "normal"} U
                  %annotation{:encoding => "application/x-tex"} \Omega^{\mathrm{U}}_4
              is torsion, but by Prop.
              %a.maruku-ref{:href => "#K3SurfaceSpansSUBordismRingInDegree4"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [K3]
              represents a non-torsion element. Since it is in fact a non-torsion generator, the kernel vanishes (as also implied by Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#TorsionInSUBordismConcentratedInDegrees1And2Mod8"}
            %p
          .num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
                generate the
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
              is multiplicatively generated by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
          %p
            (
            %a{:href => "#LLP17"}> LLP 17, Theorem 2.4
            )
          .num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
                in complex dim
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} \leq 4
                span the
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo ≤
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} deg \leq 8
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} away from 2
            %p
              There are
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
              of complex dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4
              whose whose SU-bordism classes equal the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %msub
                      %mi y
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \pm y_6
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %msub
                      %mi y
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} \pm y_8
              in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SUBordismRingAwayFromTwo"}
            %p
              Together with the
              %a.existingWikiWord{:href => "/nlab/show/K3+surface"} K3 surface
              representing
