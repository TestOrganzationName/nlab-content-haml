          %h3#essential_images_of_accessible_functors Essential images of accessible functors
          %p
          .num_theorem
            %h6 Theorem
            %p
              Assuming the existence of a
              %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strongly+compact+cardinals"} strongly compact cardinals
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              of an accessible functor:
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                is
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/complete"} complete
              %li
