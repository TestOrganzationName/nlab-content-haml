                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒞
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi Γ
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/ \Gamma}
                  %td{:style => "text-align: left;"}
                    Morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo :
                          %mn 1
                          %mo →
                          %mi σ
                        %annotation{:encoding => "application/x-tex"} s : 1 \rightarrow \sigma
                    in
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Gamma
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
