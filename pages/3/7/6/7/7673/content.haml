          %h2#idea Idea
          %p
            In the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} relation between type theory and category theory
            %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
            (in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            given by
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            which are the
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            whose
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            are the
            %a.existingWikiWord{:href => "/nlab/show/indexed+family"} families
            indexed by the base (see also at
            = succeed ")." do
              %a{:href => "dependent+type#RelationToFamiliesOfElements"} dependent type – Relation to families of elements
          %p
            More concretely: if a
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            interprets as an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi Type
                %annotation{:encoding => "application/x-tex"}
                  (x \colon A)
                  \\;\;\;\vdash\;\;\;
                  B(x) \;Type
          %p
            interprets as a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} B \to A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (hence as an object in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/A}
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \colon A
            is the type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(x)
            %a.existingWikiWord{:href => "/nlab/show/type+former"} type forming operations
            such as
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            and
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            correspond to category-theoretic operations of
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          %p
            However, this correspondence is not quite precise; in the case of dependent types there are extra
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            issues.
            %a.existingWikiWord{:href => "/nlab/show/substitution"} Substitution
            in
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            should correspond to
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            (but see at
            %em
              %a{:href => "substitution#CategoricalSemantics"} substitution – Categorical semantics
            for more); that is, given a term
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (y:C) \;\vdash\; (f(y) : A)
          %p
            corresponding to a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:C\to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi type
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (y:C) \;\vdash\; (B(f(y)) \;type)
          %p
            should correspond to the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} B\to A
            along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g:D\to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo :
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi type
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (z:D) \;\vdash\; (B(f(g(z))) \;type)
          %p
            is
            %a.existingWikiWord{:href => "/nlab/show/equality"} syntactically the same
            regardless of whether we obtain it by substituting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≔
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y \coloneqq g(z)
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(f(y))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≔
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \coloneqq f(g(z))
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(x)
            %a.existingWikiWord{:href => "/nlab/show/type+formation+rule"} type-forming operation
            must also be strictly preserved by substitition/pullback.
          %p The way this is generally dealt with is to introduce a category-theoretic structure which does have a “substitution” operation which is strictly associative, hence does correspond directly to type theory, and then show that any category can be “strictified” into such a stricter structure. Unfortunately, there are many different such structures which have been used, differing only slightly. On this page we define and compare them all.
          %p
            One of these structures is called “contextual categories” (definition
            %a.maruku-ref{:href => "#ContextualCategory"}
            below).
          %p#StandInForSyntax
            This and other kinds of categories-with-extra-structure may hence be thought of as stand-ins for the
            %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
            of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
          %blockquote
            %p Rather than constructing an interpretation of the syntax directly, we may work via the intermediary notion of contextual categories, a class of algebraic objects abstracting the key structure carried by the syntax. The plain definition of a contextual category corresponds to the structural core of the syntax; further syntactic rules (logical constructors, etc.) correspond to extra algebraic structure that contextual categories may carry. Essentially, contextual categories provide a completely equivalent alternative to the syntactic presentation of type theory.
            %p Why is this duplication of notions desirable? The trouble with the syntax is that it is mathematically tricky to handle. Any full presentation must account for (among other things) variable binding, capture-free substitution, and the possibility of multiple derivations of a judgement; and so a direct interpretation must deal with all of these, at the same time as tackling the details of the particular model in question. By passing to contextual categories, one deals with these subtleties and bureaucracy once and for all, and obtains a clear framework for subsequently constructing models. Conversely, why not work only with contextual categories, dispensing with syntax entirely?
            %p The trouble on this side is that working with higher-order logical structure in contextual categories quickly becomes unreadable. The reader preferring to take contextual categories as primary may regard the syntax as essentially a notation for working within them: a powerful, flexible, and intuitive notation, but one whose validity requires non-trivial work to establish. (The situation is comparable to that of string diagrams, as used in monoidal and more elaborately structured categories.)
            %p
              (from
              = succeed ")" do
                %a{:href => "#KapulkinLumsdaine12"} Kapulkin-Lumsdaine 12
          %h2#definitions Definitions
          %p
            In all the definitions,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            will be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as
            %a.existingWikiWord{:href => "/nlab/show/contexts"} contexts
            in a type theory.
          %p
            So far, we do not assume anything about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a category. Usually, one at least wants
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            below will imply in particular that certain
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            exist in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Sometimes, we want to consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            rather than
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in an ordinary category-theoretic way, with the strictness living in the additional structure.
          %p
            All of this could be made more precise by assembling the structures considered below into
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
          %h3#comprehension_categories Comprehension categories
          #ComprehensionCategory.num_defn
            %h6#definition Definition
            %p
              A
              %strong comprehension category
              consists of a strictly
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutative triangle
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                            %mstyle{:scriptlevel => "1"}
                              %mi cod
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"} \array{ E &amp;&amp; \to &amp;&amp; C^I\\ &amp; \searrow &amp;&amp; \swarrow {\scriptsize cod} \\ &amp;&amp; C }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} C^I
              is the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mi I
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} cod \colon C^I \to C
              denotes the codomain projection (which is a
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} fibration
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has pullbacks), and such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} E\to C
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %msup
                          %mi C
                          %mi I
                      %annotation{:encoding => "application/x-tex"} E\to C^I
                  takes
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+morphisms"} cartesian morphisms
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  to cartesian morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi I
                      %annotation{:encoding => "application/x-tex"} C^I
                  (i.e. to
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  squares in
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
          .num_remark
            %h6#remark Remark
            %p
              In def
              %a.maruku-ref{:href => "#ComprehensionCategory"}
              we do not ask that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi I
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C^I \to C
              be a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} fibration
              (that would require
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to have all
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              %em particular
              morphisms in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are cartesian.
          #FullAndSplitComprehensionCategory.num_defn
            %h6#definition_2 Definition
            %p
              A comprehension category (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComprehensionCategory"}
            %ul
              %li
                %p
                  %strong full
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %msup
                          %mi C
                          %mi I
                      %annotation{:encoding => "application/x-tex"} E\to C^I
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %li
                %p
                  %strong split
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} E\to C
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/split+fibration"} split fibration
            %p
              In the latter case, we must consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              at least to be a
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
              (that is, we consider its objects up to equality rather than isomorphism) for the notion to make sense.
          #MeaningOfComprehensionCategory.num_remark
            %h6#remark_2 Remark
            %p
              The interpretation of def.
              %a.maruku-ref{:href => "#ComprehensionCategory"}
              is as follows:
            %p
              In a comprehension category, we may regard the objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/contexts"} contexts
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi Γ
                  %annotation{:encoding => "application/x-tex"} E^\Gamma
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E\to C
              over an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              as the category of
              %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
              in context
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")," do
                %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} E\to C^I
              assigns to each “type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in context
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              %em extended
              by a fresh
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              of type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo .
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Gamma.A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo .
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma.A
              comes with a projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo .
                    %mi A
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma.A\to \Gamma
              (which forgets the fresh variable), and all substitutions in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are realized as pullbacks in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %h3#display_map_categories Display map categories
          #DisplayMapCategory.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/display+map+category"} display map category
              consists of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              together with a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/display+maps"} display maps
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              of display maps exist and are themselves display maps.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a display map category, then by defining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            to be the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi I
                %annotation{:encoding => "application/x-tex"} C^I
            whose objects are display maps, we obtain a full comprehension category (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
          #DMCasCmpC.num_lemma
            %h6#lemma Lemma
            %p
              Display map categories (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DisplayMapCategory"}
              = succeed "," do
                %a.maruku-ref{:href => "#ComprehensionCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} E\to C^I
              is the inclusion of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
          .num_remark
            %h6#remark_3 Remark
            %p
              Working up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              %em full
              comprehension categories, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} E\to C^I
              is merely fully faithful).
            %p
              However, this breaks down when we are interested in
              %em split
              comprehension categories, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              at least must be regarded as a
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
              and considered up to
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              rather than equivalence. Thus, display map categories may be said to be equivalent to non-split full comprehension categories, but “split display map categories” are not equivalent to split full comprehension categories. (In fact, split display map categories are not very useful; usually in order to make pullbacks strictly associative we have to introduce extra “names” for the same objects.)
          %h3#categories_with_attributes Categories with attributes
          #CategoryWithAttributes.num_defn
            %h6#definition_4 Definition
            %p
              A
              %strong category with attributes
              is a comprehension category, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ComprehensionCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E\to C
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
          .num_remark
            %h6#remark_4 Remark
            %p
              That is, in a category with attributes (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryWithAttributes"}
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
              in that context, rather than a category of such. The intent is that the morphisms between two types in context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              should be determined by the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              between the extended contexts over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              Another way to convey this same intent with a comprehension category would be to ask that it be
              = succeed "," do
                %em full
              = succeed "," do
                %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} E\to C^I
              be fully faithful.
          %p
            In fact, any category with attributes gives rise to a full comprehension category by factoring the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %msup
                    %mi C
                    %mi I
                %annotation{:encoding => "application/x-tex"} E\to C^I
            into a
            %a.existingWikiWord{:href => "/nlab/show/bijective+on+objects+functor"} bijective on objects functor
            followed by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
          #CWAasCmpC.num_lemma
            %h6#lemma_2 Lemma
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi CwA
                  %annotation{:encoding => "application/x-tex"} \mathbf{CwA}
              of categories with attributes (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryWithAttributes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi CompCat
                      %mtext full,split
                  %annotation{:encoding => "application/x-tex"} \mathbf{CompCat}_{\text{full,split}}
              of full split comprehension categories (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullAndSplitComprehensionCategory"}
            %p
              (These are, however, quite different as subcategories of
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi CompCat
                    %annotation{:encoding => "application/x-tex"} \mathbf{CompCat}
          %h3#categories_with_families Categories with families
          %p
            A category with attributes specifies for each “context” only a set of “types” in that context. A comprehension category, by contrast, specifies a whole
            %em category
            of “types” in each context. If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %msup
                      %mi E
                      %mi Γ
                  %annotation{:encoding => "application/x-tex"} A,B\in E^\Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A\to B
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi Γ
                %annotation{:encoding => "application/x-tex"} E^\Gamma
            as a term
          #eq:cmpcterm.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo :
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vec{x} : \Gamma), (a:A(\vec{x})) \;\vdash\; (f(\vec{x},a) : B(\vec{x}))
          %p
            in type theory.
            %br>/
            A
            %em category with families
            specifies instead, for each context and each type in that context, a set of “terms belonging to that type”. These should be thought of as terms
          #eq:cwfterm.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo :
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vec{x} : \Gamma) \;\vdash\; (f(\vec{x}) : B(\vec{x}))
          %p in type theory.
          .num_remark
            %h6#remark_5 Remark
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/term"} term
              of the form
              %a.maruku-eqref{:href => "#eq:cmpcterm"} (1)
              can equivalently be regarded as a term of the form
              %a.maruku-eqref{:href => "#eq:cwfterm"} (2)
              by replacing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              by the extended context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo .
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Gamma.A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              by its substitution along the projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo .
                      %mi A
                      %mo →
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma.A \to \Gamma
          %p
            The additional insight in the following definition is that if we expect all of these terms to be determined by the morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %msup
                    %mi C
                    %mi I
                %annotation{:encoding => "application/x-tex"} E\to C^I
            and then asking either that it be fully faithful or that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be discrete (removing the information about extra morphisms in
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:cwfterm"} (2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %msup
                    %mi C
                    %mi I
                %annotation{:encoding => "application/x-tex"} E\to C^I
            is determined by a universal property.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fam
                %annotation{:encoding => "application/x-tex"} Fam
            denote the category of families of sets. Its objects are set-indexed families
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (A_i)_{i\in I}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi j
                      %mo ∈
                      %mi J
                %annotation{:encoding => "application/x-tex"} (A_i)_{i\in I} \to (B_j)_{j\in J}
            consist of a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} f\colon I\to J
            and functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_i \colon A_i \to B_{f(i)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi I
                %annotation{:encoding => "application/x-tex"} Set^I
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi j
                      %mo ∈
                      %mi J
                %annotation{:encoding => "application/x-tex"} (B_j)_{j\in J}
            corresponds to the arrow
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi B
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} \coprod B \to J
          #CategoryWithFamilies.num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong category with families
              is a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              together with
            %ul
              %li
                %p
                  A functor
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo :
                          %msup
                            %mi C
                            %mi op
                          %mo →
                          %mi Fam
                        %annotation{:encoding => "application/x-tex"} F:C^{op} \to Fam
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi Tm
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi A
                              %mo ∈
                              %mi Ty
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F(\Gamma) = (Tm(A))_{A\in Ty(\Gamma)}
              %li
                %p
                  For each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \Gamma\in C
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %mi Ty
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A\in Ty(\Gamma)
                  %a.existingWikiWord{:href => "/nlab/show/representing+object"} representing object
                  for the functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} /
                                %mi Γ
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi op
                              %mtd
                                %mo →
                                %mi Set
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Δ
                                %mover
                                  %mo →
                                  %mi f
                                %mi Γ
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ↦
                                %mi Tm
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi f
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        (C/\Gamma)^{op} &amp; \to Set\\
                        (\Delta \xrightarrow{f} \Gamma) &amp; \mapsto Tm(f^*(A))
                        \\end{aligned}
          %p
            Intuitively,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(\Gamma)
            is the set of terms in the context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            indexed by their type, and the representing object for the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Γ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} (C/\Gamma)^{op} \to Set
            is the projection from context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ;
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Gamma; A
            to context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p We can then prove:
          #CwAareCwF.num_lemma
            %h6#lemma_3 Lemma
            %p
              Categories with attributes, def.
              %a.maruku-ref{:href => "#CategoryWithAttributes"}
              are equivalent to categories with families, def.
              = succeed "." do
                %a.maruku-ref{:href => "#CategoryWithFamilies"}
          .proof
            %h6#proof Proof
            %p
              Given a category with families, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E\to C
              be the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              of the functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ty
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Ty:C^{op}\to Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} E\to C^I
              take each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ty
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in Ty(\Gamma)
              to the above representing object. This is a category with attributes.
            %p
              Conversely, given a category with attributes, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ty
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Ty:C^{op}\to Set
              be the functor corresponding to the discrete fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} E\to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ty
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in Ty(\Gamma)
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tm
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tm(A)
              be the set of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that is the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi I
                    %annotation{:encoding => "application/x-tex"} C^I
          %h3#NaturalModels Natural Models
          %p
            %a{:href => "#Awodey2016"} Awodey 2016
            presented the following “
            %a.existingWikiWord{:href => "/nlab/show/natural+model+of+homotopy+type+theory"}> natural model
            ” of type theory as an alternative to categories with families.
          .num_theorem
            %h6#theorem Theorem
            %p
              If we modify Def.
              %a.maruku-ref{:href => "#CategoryWithFamilies"}
              by requiring only that the functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mover
                      %mo →
                      %mi f
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi Tm
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Delta \xrightarrow{f} \Gamma) \mapsto Tm(f^*(A))
              be representable (rather than equipped with representing objects), then it is equivalent to giving
            %ol
              %li
                a category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              %li
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Tm
                      %mo →
                      %mi Ty
                    %annotation{:encoding => "application/x-tex"} Tm \to Ty
                in the category of
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                which is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/representable+morphism"} representable morphism
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            models the category of contexts and substitutions, and the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm \to Ty
            models the bundle of (context-dependent) terms over (context-dependent) types. The representability models the extension of a context with a new typed variable.
          %p
            The condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm \to Ty
            is a representable morphism in presheaves can be reformulated in terms of adjoints as follows:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm \to Ty
            is representable just if the associated functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ∫
                    %mi Tm
                  %mo →
                  %mrow
                    %mo ∫
                    %mi Ty
                %annotation{:encoding => "application/x-tex"} {\int Tm} \to {\int Ty}
            has a right adjoint. Thus a natural model can be equivalently described as a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            equipped with a natural transformation of presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm \to Ty
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ∫
                    %mi Tm
                  %mo →
                  %mrow
                    %mo ∫
                    %mi Ty
                %annotation{:encoding => "application/x-tex"} {\int Tm} \to {\int Ty}
            has a right adjoint.
          %p
            This specification can be related to that of a
            = succeed "," do
              %a.maruku-ref{:href => "#CategoryWithFamilies"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm \to Ty
            in terms of representable profunctors as follows. A natural model is equivalently described as:
          %ol
            %li
              a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              a presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ty
                    %mo :
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} Ty : \hat C
              of types in context.
            %li
              a presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tm
                    %mo :
                    %mover
                      %mrow
                        %mo ∫
                        %mi Ty
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} Tm : \widehat {\int Ty}
              of typed terms in context.
            %li
              a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ext
                    %mo :
                    %mover
                      %mrow
                        %mo ∫
                        %mi Ty
                      %mo ^
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} ext : \widehat {\int Ty} \to C
              of context extension with data that represents the profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ∫
                      %mi Ty
                    %mo{:stretchy => "false"} (
                    %mi ty
                    %mo −
                    %mo ,
                    %mo =
                    %mo{:stretchy => "false"} )
                    %mo ⊙
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi ctx
                    %mo{:stretchy => "false"} (
                    %mi ty
                    %mo{:stretchy => "false"} (
                    %mo =
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo ∫
                    %mi Ty
                    %mi ⇸
                    %mi C
                  %annotation{:encoding => "application/x-tex"} {\int Ty}(ty-,=) \odot C(-,ctx(ty(=))) : \int Ty &amp;#8696; C
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ty
                    %mo :
                    %mo ∫
                    %mi Tm
                    %mo →
                    %mo ∫
                    %mi Ty
                  %annotation{:encoding => "application/x-tex"} ty : \int Tm \to \int Ty
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ctx
                    %mo :
                    %mo ∫
                    %mi Ty
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} ctx : \int Ty \to C
              are the projections of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
          %p Writing the profunctor as P, it is equivalent to the following definition:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo :
                  %mi Δ
                  %mo →
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo :
                  %mi Tm
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\Delta, (\Gamma, A)) = (\gamma : \Delta \to \Gamma) \times (a : Tm(\Delta, A[\gamma]))
          %p
            then the universal property of the context extension is that there is a natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
