                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
                \&amp;lbrack;
                %a{:href => "https://doi.org/10.1142/0224"}> doi:10.1142/0224
                , ch I.4:
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChI4.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jorge+Zanelli"}> Jorge Zanelli
                , sections 4 and 5 of:
                = succeed "," do
                  %em Lecture notes on Chern-Simons (super-)gravities. Second edition (February 2008)
                = succeed "," do
                  %em Geometric and topological methods for quantum field theory
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/hep-th/0502193"} arXiv:hep-th/0502193
                = succeed "&rbrack;" do
                  %a{:href => "https://inspirehep.net/literature/677203"} inspire:677203
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"}> Pietro Fré
                , §5 in:
                = succeed "," do
                  %em Gravity, a Geometrical Course
                = succeed "," do
                  %em Development of the Theory and Basic Physical Applications
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-94-007-5361-7"} doi:10.1007/978-94-007-5361-7
          %p
            More explicitly understood via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriel+Catren"}> Gabriel Catren
                ,
                = succeed "," do
                  %em Geometrical Foundations of Cartan Gauge Gravity
                %strong 12
                04 (2015) 1530002 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1407.7814"}> arXiv:1407.7814
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0219887815300020"} doi:10.1142/S0219887815300020
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kirill+Krasnov"}> Kirill Krasnov
                , §3 in:
                = succeed "," do
                  %em Formulations of General Relativity
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108674652"} doi:10.1017/9781108674652
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.nottingham.ac.uk/plp/pmzkk/book_taster.pdf"} pdf
          %p
            and in view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %ul
            %li#CastellaniDAuriaFre
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
              %em
                %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
              \&amp;lbrack;
              %a{:href => "https://doi.org/10.1142/0224"}> doi:10.1142/0224
              , ch I.4:
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChI4.pdf", :title => "pdf"} pdf
          %p
            For more in the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bernard+Julia"}> Bernard Julia
              , S. Silva,
              = succeed "," do
                %em On first order formulations of supergravities
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/hep-th/9911035"} arXiv:hep-th/9911035
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1088/1126-6708/2000/01/026"} doi:10.1088/1126-6708/2000/01/026
          %p
            Formulation via
            %a.existingWikiWord{:href => "/nlab/show/BV-formalism"} BV-formalism
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebras
          %ul
            %li
              Marija Dimitrijević Ćirić,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grigorios+Giotopoulos"} Grigorios Giotopoulos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+J.+Szabo"} Richard J. Szabo
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
                  \-Algebras of Einstein-Cartan-Palatini Gravity
              %strong 61
              (2020) 112502 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2003.06173"}> arXiv:2003.06173
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1063/5.0011344"} doi:10.1063/5.0011344
          %p
            The equivalence of the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of Palatini-Cartan-Holst
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            with the
            %a.existingWikiWord{:href => "/nlab/show/Einstein-Hilbert+action"} Einstein-Hilbert version
            is established in
          %ul
            %li#CattaneoSchiavina17a
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michele+Schiavina"} Michele Schiavina
              = succeed "," do
                %em The reduced phase space of Palatini-Cartan-Holst theory
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1707.05351"} arXiv:1707.05351
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/s00023-018-0733-z"} doi:10.1007/s00023-018-0733-z
          %p
            Subtleties in extending this to a
            %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local field theory
            (gluing pieces of spacetimes along their boundaries) are discussed in
          %ul
            %li#CattaneoSchiavina17b
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michele+Schiavina"} Michele Schiavina
              %em BV-BFV approach to General Relativity: Palatini-Cartan-Holst action
              (
              %a{:href => "https://arxiv.org/abs/1707.06328"}> arXiv:1707.06328
              )
          %p following
          %ul
            %li#CattaneoSchiavina15
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michele+Schiavina"} Michele Schiavina
              = succeed "," do
                %em BV-BFV approach to General Relativity, Einstein-Hilbert action
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1509.05762"} arXiv:1509.05762
          %p see also:
          %ul
            %li
              Giovanni Canepa,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"} Alberto Cattaneo
              = succeed "," do
                %em Corner Structure of Four-Dimensional General Relativity in the Coframe Formalism
              %strong 25
              (2024) 2585–2639 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2202.08684"}> arXiv:2202.08684
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00023-023-01360-8"} doi:10.1007/s00023-023-01360-8
          %p Reviewed in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
                ,
                = succeed "," do
                  %em Phase space for gravity with boundaries
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2307.04666"} arXiv:2307.04666
              %blockquote
                %p
                  (following
                  = succeed ")" do
                    %a{:href => "phase+space#KijowskiTulczyjew05"} Kijowski &amp; Tulczyjew (2005)
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/BF-theory"} BF-theory
          %ul
            %li#CattaneoMengerSchiavina23
              %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Leon+Menger"} Leon Menger
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michele+Schiavina"} Michele Schiavina
              %em Gravity with torsion as deformed BF theory
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2310.01877"}> arXiv:2310.01877
              \&amp;rbrack;
          %p See also:
          %ul
            %li
              J. Fernando Barbero G., Juan Margalef-Bentabol, Valle Varo, Eduardo J.S. Villaseñor,
              %em Covariant phase space for gravity with boundaries: metric vs tetrad formulations
              (
              %a{:href => "https://arxiv.org/abs/2103.06362"}> arXiv:2103.06362
              )
          %p
            More towards
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            (
            %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"}> quantum gravity
            ):
          %ul
            %li
              %p
                Fernando T. Brandt, J. Frenkel, S. Martins-Filho, D. G. C. McKeon,
                %em Quantization of Einstein-Cartan theory in the first order form
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2401.16343"}> arXiv:2401.16343
                \&amp;rbrack;
            %li
              %p
                Fernando T. Brandt, J. Frenkel, S. Martins-Filho, D. G. C. McKeon:
                %em On the equivalence of first and second order formulations of the Einstein-Hilbert theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2510.17615"}> arXiv:2510.17615
                \&amp;rbrack;
