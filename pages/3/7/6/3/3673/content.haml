              %a.existingWikiWord{:href => "/nlab/show/cofree+functor"} cofree functor
          %h2#definition Definition
          %h3#RightTransfer Right transfer
          %p
          #RightTransferredModelStructure.num_defn
            %h6 Definition
            %p
              %strong (right transferred model structure)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi D
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mi F
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv U )
                    \\;\colon\;
                    D
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{F}{\longleftarrow}}
                    {\;\;\;\bot\;\;\;}
                    C
            %p
              a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              with
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              to be
            %ul
              %li
                %p
                  a
                  %em fibration
                  or
                  %em weak equivalence
                  precisely if its image under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  is so in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                %p
                  (by
                  %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} adjointness
                  this means that the fibrations form equivalently the class with the
                  %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                  against the image under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
                  in
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  a
                  %em cofibration
                  precisely if it has the
                  %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                  with respect to the fibrations that are also weak equivalences, according to the previous item.
            %p
              If these classes of maps define a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %em right transferred model structure
              (
              %a{:href => "#Crans95"}> Crans 1995, §3
              ) or sometimes
              %em right induced model structure
              or
              %em right lifted model structure
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            In the above situation of Def.
            %a.maruku-ref{:href => "#RightTransferredModelStructure"}
            it is clear what one means by an
            %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is,
            = succeed "," do
              %em a priori
            %a.maruku-ref{:href => "#NeccSuff"}
            we declare that:
          %ol
            %li
              %p
                an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is (of course) a morphism that is both a fibration and a weak equivalence, or equivalently whose image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is an acyclic fibration in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                a morphism is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is
              %ol
                %li
                  %p
                    a
                    %strong cofibration weak equivalence
                    if it is both a cofibration and a weak equivalence in the sense of Def.
                    = succeed ";" do
                      %a.maruku-ref{:href => "#RightTransferredModelStructure"}
                %li
                  %p
                    an
                    %strong anodyne map
                    if it has the
                    %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                    with respect to all fibrations.
              %p Of course, if the transferred model structure exists, then these two classes of maps coincide.
          %p Conversely we have:
          %p
          #NeccSuff.num_theorem
            %h6 Theorem
            %p
              A necessary and sufficient condition for the existence of the right transferred model structure (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RightTransferredModelStructure"}
            %ol
              %li
                %p
                  Every morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  factors as
                %ol
                  %li
                    %p a cofibration followed by a trivial fibration,
                  %li
                    %p an anodyne map followed by a fibration;
              %li
                %p every anodyne map is a weak equivalence.
            %p
          %p
          .proof
            %h6 Proof
            %p
              Clearly the conditions are necessary. For the converse, the weak equivalences have the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3+property"} 2-out-of-3 property
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A \longrightarrow B
              is a cofibration weak equivalence, factor it as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi p
                    %mi i
                  %annotation{:encoding => "application/x-tex"} f = p i
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              anodyne and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a fibration. Then since anodyne maps are weak equivalences and weak equivalences satisfy
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an acyclic fibration. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the left lifting property against
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and thus also anodyne.
          %h3#LeftTransfer Left transfer
          %p
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
            , if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a model category and we have an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ⊣
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi D
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟵
                      %mi G
                    %mover
                      %mo ⟶
                      %mi U
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  (U \dashv G )
                  \\;\colon\;
                  D
                  \\underoverset
                  {
                  \\underset{G}{\longleftarrow}
                  }
                  {
                  \\overset{U}{\longrightarrow}
                  }
                  {\;\;\;\bot\;\;\;}
                  C
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            to be
          %ul
            %li
              %p
                a
                %strong cofibration
                or
                %strong weak equivalence
                precisely if its image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is, respectively, in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                a
                %strong fibration
                precisely if it has the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                with respect to the cofibrations that are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
          %p
            If these classes of maps define a model structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %strong left transferred model structure
            (or sometimes
            %strong left induced model structure
            or
            = succeed ")" do
              %strong left lifted model structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p The above necessary and sufficient conditions dualize directly.
          %h2#existence Existence
          %h3#ConstructingFactorizationsForRightTransfer For right transfer
          %h4#ConstructingFactorizations Constructing factorizations
          %p
            The most traditional way to obtain the factorization properties in the right-transferred case (Thm.
            = succeed ")" do
              %a.maruku-ref{:href => "#NeccSuff"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated"} cofibrantly generated
          %p
          #SufficientConditions.num_prop
            %h6 Proposition
            %p
              In the right-transferred situation (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#RightTransferredModelStructure"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated"} cofibrantly generated
              %li
                %p
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/small+objects"} small objects
                %p
                  (which is the case, in particular, when
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  preserves
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
            %p
              then every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              factors as a cofibration followed by a trivial fibration, and as an anodyne map followed by a fibration.
            %p
              Moreover, if every anodyne map is a weak equivalence so that the transferred model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              exists (by Thm.
              = succeed ")," do
                %a.maruku-ref{:href => "#NeccSuff"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
              (resp. acyclic cofibrations) in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(I)
              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(J)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
          .proof
            %h6 Proof
            %p
              By the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊣
                      %mi U
                    %annotation{:encoding => "application/x-tex"} F \dashv U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a fibration (resp. trivial fibration) if and only if it has the right lifting property against the maps in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(I)
              (resp.
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(J)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              preserves small objects, the sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(I)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(J)
              permit the small object argument in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
            Another way to produce these factorizations is to generate them by a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial factorization
          #AlgebraicLift.num_lemma
            %h6#lemma Lemma
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo ⇄
                    %mi D
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F \colon C \rightleftarrows D \colon U
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial factorization
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L,R)
                  with a
                  %a.existingWikiWord{:href => "/nlab/show/right+weak+composition+law+for+factorizations"} right weak composition law for factorizations
                  (e.g. if it is
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/awfs"} algebraic
              %li
                %p
                  the induced functorial factorization on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  permits Garner’s
                  %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                  (e.g. if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  are locally presentable and all functors are accessible).
            %p
              Then there is an induced (
              %a.existingWikiWord{:href => "/nlab/show/awfs"}> algebraic
              ) weak factorization system on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              whose right class consists precisely of those maps whose
              = succeed "-image" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          .proof
            %h6#proof Proof
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A\to B
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mi U
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mo{:stretchy => "false"} (
                                    %mi U
                                    %mi f
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mi L
                                    %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi F
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi E
                            %mi f
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mo{:stretchy => "false"} (
                                    %mi U
                                    %mi f
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mi R
                                    %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi F
                            %mi U
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F U A &amp; \longrightarrow &amp; A
                    \\\
                    \\mathllap{ {}^{F ((U f)_L)} }
                    \\big\downarrow &amp; &amp; \big\downarrow
                    \\\
                    F E (U f) &amp; &amp; E f
                    \\\
                    \\mathllap{ {}^{F ((U f)_R)} }
                    \\big\downarrow &amp; &amp; \big\downarrow
                    \\\
                    F U B &amp; \longrightarrow &amp; B
                    }
            %p
              This yields a functorial factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ′
                    %mo ,
                    %mi R
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L',R')
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} R'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is determined by a diagonal lifting in the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mi U
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mo{:stretchy => "false"} (
                                    %mi U
                                    %mi f
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mi L
                                    %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                        %mtr
                          %mtd
                            %mi F
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi R
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F U A &amp; \longrightarrow &amp; A
                    \\\
                    \\mathllap{ {}^{F ((U f)_L)} }
                    \\big\downarrow &amp; &amp; \big\downarrow \mathrlap{{}^f}
                    \\\
                    F E (U f)
                    \&amp;
                    \\underset{F ((U f)_R)}{\longrightarrow}
                    \&amp;
                    B
                    }
            %p
              which corresponds by adjunction to precisely an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mi f
                    %annotation{:encoding => "application/x-tex"} U f
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} R'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ′
                    %mo ,
                    %mi R
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L',R')
              then produces a monad over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                  %annotation{:encoding => "application/x-tex"} cod
              with a right strong composition law, which is therefore an
              %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic weak factorization system
              whose algebraic right maps are the
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} R'
              = succeed "-image" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            In particular, therefore, the factorizations of any
            %a.existingWikiWord{:href => "/nlab/show/accessible+model+structure"} accessible model structure
            right-lift along any adjunction between locally presentable model categories, whether or not they are cofibrantly generated. But the cofibrantly generated case can also be subsumed, by taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            to be the one-step factorization produced by the generating left maps.
          %p Left-lifting is generally rather trickier. But by invoking fancier categorical machinery, one can show more generally:
          %p
          #TransferFromAnAccessibleFactorizationSystem.num_lemma
            %h6 Lemma
            %p
              Suppose given a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \colon D\to C
              between
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
              and an
              %a.existingWikiWord{:href => "/nlab/show/accessible+weak+factorization+system"} accessible weak factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  has a left adjoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L,R)
                  right-lifts along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  to an accessible wfs on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  has a right adjoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L,R)
                  left-lifts along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  to an accessible wfs on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is cofibrantly generated, so are the lifted wfs.
            %p
          .proof
            %h6 Proof
            %p
              See
              %a{:href => "#HKRS15"} HKRS15
              and
              %a{:href => "#GKR18"} GKR18
              for the lifting of accessible wfs. Cofibrant generation of a right-lifted wfs follows as in Theorem
              %a.maruku-ref{:href => "#SufficientConditions"}
              above, while in the left-lifted case it is Remark 3.8 of
              = succeed "." do
                %a{:href => "#MakkaiRosický14"} Makkai &amp; Rosický 2014
          %p This sort of result seems to be necessary for the case of left-lifting; the simpler cofibrantly-generated argument does not dualize as directly.
          %h4#verifying_acyclicity Verifying acyclicity
          %p
            The “acyclicity condition” in Thm.
            = succeed "," do
              %a.maruku-ref{:href => "#NeccSuff"}
            %a.existingWikiWord{:href => "/nlab/show/sequential+colimits"} sequential colimits
            of
            %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
            of
            %a.existingWikiWord{:href => "/nlab/show/images"} images
            under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of the generating acyclic cofibrations in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (i.e. forming
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(J)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(J)
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(J)
          %p
            Another useful sufficient condition is the following, going back roughly to section II.4 of (
            %a{:href => "#Quillen"}> Quillen
            ).
          %p
          #PathObjects.num_prop
            %h6 Proposition
            %p
              In the situation of right transfer (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#RightTransferredModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \colon D\to C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement+functor"} fibrant replacement functor
                  (in fact it suffices for individual objects and morphisms to have fibrant replacements, while functoriality is not necessary),
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  has
                  %a.existingWikiWord{:href => "/nlab/show/path+objects"} path objects
                  for fibrant objects, i.e. a factorization of the
                  %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo :
                        %mi A
                        %mo →
                        %mi A
                        %mo ×
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \Delta : A \to A \times A
                  as a weak equivalence followed by a fibration
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Δ
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                          %mover
                            %mo →
                            %mo ≃
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mi fib
                          %mi A
                          %mo ×
                          %mi A
                        %annotation{:encoding => "application/x-tex"} \Delta \colon A \stackrel{\simeq}{\to} P(A) \stackrel{fib}{\to} A \times A
            %p
              Then any anodyne map in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a weak equivalence. Thus, if the two factorizations exist in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
          .proof
            %h6 Proof
            %p
              The notation in the following is mostly that of
              = succeed "." do
                %a{:href => "#Rezk02"} Rezk 02, Lemma 7.6
              = succeed "Let" do
                %br/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a fibrant replacement functor, with natural weak equivalence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Id
                      %mo →
                      %mi R
                    %annotation{:encoding => "application/x-tex"} j \colon Id \to R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
              is anodyne, and consider the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            %div{:style => "text-align: center"}
              %svg{:height => "225.369", :viewbox => "0 0 325.708 225.369", :width => "325.708", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
                %defs
                  %g
