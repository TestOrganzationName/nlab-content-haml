          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood+theorem"}> tubular neighbourhood theorem
                )
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              does admit a tubular neighbourhood, def.
              = succeed "." do
                %a.maruku-ref{:href => "#TubularNeighbourhood"}
          %p
            For instance (
            %a{:href => "#DaSilva"}> DaSilva, theorem 3.1
            ).
          %p
            Moreover, tubular neighbourhoods are unique
            %em
              up to
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            in a suitable sense:
          .num_defn
            %h6#definition_3 Definition
            %p
              For an embedding
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} i : X \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tub
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tub(i)
              for the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              whose underlying set is the set of tubular neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and whose
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              is the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mi i
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(N_i X, Y)
              equipped with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/C-infinity+topology"} C-infinity topology
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tub
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tub(i)
              is
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              for all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} i : X \to Y
          %p
            This appears as (
            %a{:href => "#Godin"}> Godin, prop. 31
            ).
          %h3#PropertiesEquivariant Equivariant version
          %p
            These statements generalize to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+differential+topology"} equivariant differential topology
          #FixedLociOfSmoothProperActionsAreSubmanifolds.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                %a.existingWikiWord{:href => "/nlab/show/proper+actions"} proper actions
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/submanifolds"} submanifolds
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \rho \;\colon\; G \times X \to X
              a
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              Then the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi G
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^G \hookrightarrow X
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            %p
              If in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts by
              %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
              then the
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi G
                  %annotation{:encoding => "application/x-tex"} X^G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/totally+geodesic+submanifold"} totally geodesic submanifold
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Ziller13"} Ziller 13, theorem 3.5.2
            = succeed ")" do
              %a{:href => "https://math.stackexchange.com/a/1739784/58526"} this MO discussion
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi X
                      %mi G
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X^G \subset X
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              %a.maruku-ref{:href => "#ExistenceOfGInvariantTubularNeighbourhoods"}
              applies and shows that an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-equivariantly" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi RO
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V \in RO(G)
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mi G
                    %mo ⊂
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V^G \subset V
              of that is hence
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          .num_remark
            %h6#remark_2 Remark
            %p
              Without the assumption of
              %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper action
              in Prop.
              %a.maruku-ref{:href => "#FixedLociOfSmoothProperActionsAreSubmanifolds"}
              the conclusion generally fails. See
              %a{:href => "https://math.stackexchange.com/a/1739768/58526"} this MO comment
              for a counter-example.
          #GActionOnNormalBundleToFixedLocus.num_prop
            %h6#propositiondefinition Proposition/Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-action on
