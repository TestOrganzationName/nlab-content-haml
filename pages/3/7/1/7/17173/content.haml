                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo ⊂
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Sigma \subset U \subset X
                  (Def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#GInvariantTubularNeighbourhood"}
              %li
                %p
                  any two choices of such
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "-equivariantly" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/isotopy"} isotopic
              %li
                %p
                  there always exists an
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ⊂
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(\Sigma \subset X)
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sigma
                      %annotation{:encoding => "application/x-tex"} Sigma
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  from Def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#GActionOnNormalBundleToFixedLocus"}
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
                  is given by the
                  %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi exp
                          %mi ϵ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ⊂
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi 𝒩
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ⊂
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\exp_\epsilon
                        \\;\colon\;
                        N(\Sigma \subset X)
                        \\overset{\simeq}{\longrightarrow}
                        \\mathcal{N}(\Sigma \subset X)
            %p
              with respect to a
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              (which exists according to Prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#ExistenceOfGInvariantRiemannianMetrics"}
          %p
            The existence of the
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a{:href => "#Bredon72"} Bredon 72 VI Theorem 2.2
            = succeed "." do
              %a{:href => "#Kankaanrinta07"} Kankaanrinta 07, theorem 4.4
            = succeed "." do
              %a{:href => "#Kankaanrinta07"} Kankaanrinta 07, theorem 4.4, theorem 4.6
            %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
            appears at the end of the proof of
            = succeed "," do
              %a{:href => "#Bredon72"} Bredon 72 VI Theorem 2.2
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            it follows from
            %a{:href => "#PflaumPosthumaTang11"} Pflaum-Posthuma-Tang 11, Theorem 4.1
            by applying the construction there to each point in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            for one and the same choice of background metric. See also for instance
            = succeed "." do
              %a{:href => "#PflaumWilkin17"} Pflaum-Wilkin 17, Example 2.5
          %h3#pullbacks_of_tubular_neighbourhoods Pullbacks of tubular neighbourhoods
          %p
            (…)
            %a.existingWikiWord{:href => "/nlab/show/propagating+flow"} propagating flow
            (…) (
            %a{:href => "#Godin"}> Godin
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood+of+a+mapping+space"} tubular neighbourhood of a mapping space
            %li
              %p
                key application:
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+collapse+map"} Pontrjagin-Thom collapse map
          %h2#references References
          %ul
            %li#Thom54
              %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Thom"}> René Thom
              , p. 21 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quelques+propri%C3%A9t%C3%A9s+globales+des+vari%C3%A9t%C3%A9s+diff%C3%A9rentiables"} Quelques propriétés globales des variétés différentiables
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/BF02566923"} doi:10.1007/BF02566923
              = succeed "," do
                %a{:href => "https://eudml.org/doc/139072"} dml:139072
              = succeed "," do
                %a{:href => "http://www.digizeitschriften.de/dms/img/?PID=GDZPPN002056259"} digiz:GDZPPN002056259
              = succeed ")" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/thomcob.pdf"} pdf
          %p Basics on tubular neighbourhoods are reviewed for instance in
          %ul
            %li#DaSilva
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ana+Cannas+da+Silva"}> Ana Cannas da Silva
                , section 3 of
                %em Prerequisites from differential geometry
                (
                %a{:href => "http://www.math.princeton.edu/~acannas/appendix_dg.pdf"}> pdf
                )
            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , section 1.2 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
          %p
            Discussion in the generality of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+differential+topology"} equivariant differential topology
            includes
          %ul
            %li#Bredon72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
                , Chapter VI.2 of
                = succeed "," do
                  %em Introduction to compact transformation groups
                = succeed ")" do
                  %a{:href => "http://www.indiana.edu/~jfdavis/seminar/Bredon,Introduction_to_Compact_Transformation_Groups.pdf"} pdf
            %li#Bredon72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
                ,
                = succeed "," do
                  %em Introduction to compact transformation groups
                = succeed ")" do
                  %a{:href => "http://www.indiana.edu/~jfdavis/seminar/Bredon,Introduction_to_Compact_Transformation_Groups.pdf"} pdf
            %li#Kankaanrinta07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marja+Kankaanrinta"}> Marja Kankaanrinta
                ,
                = succeed "," do
                  %em Equivariant collaring, tubular neighbourhood and gluing theorems for proper Lie group actions
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.agt/1513796653"} euclid:agt/1513796653
            %li#PflaumPosthumaTang11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Pflaum"}> Markus Pflaum
                , Hessel Posthuma, X. Tang,
                = succeed "," do
                  %em Geometry of orbit spaces of proper Lie groupoids
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1101.0180"} arXiv:1101.0180
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/crelle-2012-0092"} doi:10.1515/crelle-2012-0092
            %li#Ziller13
              %p
                Wolfgang Ziller,
                = succeed "," do
                  %em Group actions
                = succeed ")" do
                  %a{:href => "https://www.math.upenn.edu/~wziller/math661/LectureNotesLee.pdf"} pdf
            %li#CrainicStruchiner13
              %p
                Marius Crainic, Ivan Struchiner,
                = succeed "," do
                  %em On the linearization theorem for proper Lie groupoids
                %a{:href => "http://www.numdam.org/item/ASENS_2013_4_46_5_723_0/"} numdam:ASENS_2013_4_46_5_723_0
                = succeed ")" do
                  %a{:href => "https://doi.org/10.24033/asens.2200"} doi:10.24033/asens.2200
            %li#PflaumWilkin17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Pflaum"}> Markus Pflaum
                , Graeme Wilkin,
                = succeed "," do
                  %em Equivariant control data and neighborhood deformation retractions
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1706.09539"} arXiv:1706.09539
          %p The homotopical uniqueness of tubular neighbourhoods is discussed in
          %ul
            %li#Godin
              %a.existingWikiWord{:href => "/nlab/show/Veronique+Godin"}> Veronique Godin
              ,
              %em Higher string topology operations
              (2007)(
              %a{:href => "http://arxiv.org/abs/0711.4859"}> arXiv:0711.4859
              )
          %p For an analogue in homotopical algebraic geometry see
          %ul
