            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \rho \;\colon\; G \times X \to X
              a
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              Then linearization of the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi G
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^G \subset X
              equips the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi X
                    %mrow
                      %mo (
                      %msup
                        %mi X
                        %mi G
                      %mo )
                  %annotation{:encoding => "application/x-tex"} N_X\left( X^G\right)
              with
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              and
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
