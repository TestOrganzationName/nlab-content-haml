            = succeed ")" do
              %a{:href => "#CrainicStruchiner13"} Crainic-Struchiner 13, Example 1.7
          #ExistenceOfGInvariantRiemannianMetrics.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (existence of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/invariant+Riemannian+metric"} invariant Riemannian metric
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \rho \;\colon\; G \times X \to X
              a
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              Then there exists a
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with its
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              with respect to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              act by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
          %p
            (
            %a{:href => "#Bredon72"}> Bredon 72,VI Theorem 2.1
            , see also
            = succeed ")" do
              %a{:href => "#Ziller13"} Ziller 13, Theorem 3.0.2
          #GInvariantTubularNeighbourhood.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-
                %a.existingWikiWord{:href => "/nlab/show/equivariant+tubular+neighbourhood"}> equivariant tubular neighbourhood
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \rho \;\colon\; G \times X \to X
              a
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⊂
                    %msup
                      %mi X
                      %mi G
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma \subset X^G \subset X
              a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              inside the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-invariant
                %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{N}(\Sigma \subset X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} E \to \Sigma
                  equipped with a
                  = succeed "-wise" do
                    %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/action"} action
              %li
                %p
                  an equivariant
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo ⟶
                          %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{}{\longrightarrow} X
                  onto an
                  %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  which takes the
                  %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
                  identically to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
