              %strong tubular neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
            %ul
              %li
                %p
                  a real
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} E \to X
              %li
                %p
                  an extension of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  to an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi i
                          %mo{:stretchy => "false"} ^
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi E
                        %mo →
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\hat i \;\colon\; E \to U_{i(X)}
                %p
                  with an
