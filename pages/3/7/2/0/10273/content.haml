          %h3#spin_group_spin_representations_and_invariant_forms Spin group, spin representations and invariant forms
          %p
            With this background about Clifford algebras at hand, we can finally define the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
          .un_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,Q)
              be a quadratic vector space. The
              %em
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,Q)
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %msub
                        %mi v
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mi …
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi v
                        %mrow
                          %mn 2
                          %mi k
                      %mo{:stretchy => "false"} |
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo ±
                      %mn 1
                      %mo ∀
                      %mi i
                      %mo }
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"}
                    Spin(V,Q) = \left\{ v_1\,\dots\,v_{2k} | Q(v_i) = \pm 1 \forall i \right\} \subset Cl(V,Q)^+
            %p
              The irreducible
              %a.existingWikiWord{:href => "/nlab/show/representations"} representations
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,Q)
              that arise from simple
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi Q
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo +
                    %annotation{:encoding => "application/x-tex"} Cl(V,Q)^+
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
          %p
            Note that this definition of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            differs from the one given in
            = succeed "," do
              %a{:href => "#Varadarajan04"} Varadarajan 04, Proposition 5.4.8
            = succeed "." do
              %a{:href => "#LawsonMichelsohn89"} Lawson-Michelsohn 89, page 18
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                %annotation{:encoding => "application/x-tex"} V = \mathbb{R}^{p|q}
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo =
                  %mrow
                    %mo {
                    %msub
                      %mi v
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mi …
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi v
                      %mrow
                        %mn 2
                        %mi k
                    %msub
                      %mi w
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mi …
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi w
                      %mrow
                        %mn 2
                        %mi l
                    %mo{:stretchy => "false"} |
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi w
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ∀
                    %mi i
                    %mo ,
                    %mi j
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  Spin(p,q)^0 = \left\{ v_1\,\dots\,v_{2k}w_1\,\dots\,w_{2l} | Q(v_i) = 1, Q(w_j) = -1 \forall i,j \right\}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(p,q)
            is a double cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(p,q)
            in the sense that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mi ℤ
                  %mo →
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  0 \to \mathbb{Z}/2\mathbb{Z} \to Spin(p,q) \to SO(p,q) \to 1
          %p
            is exact (
            %a{:href => "#LawsonMichelsohn89"}> Lawson-Michelsohn 89, Theorem 2.10
            ). If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi min
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \min(p,q) = 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \max(p,q) \geq 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(p,q)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(p,q)
            have two connected components and the above restricts to a double cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} SO(p,q)^0
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Spin(p,q)^0
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} Cl(V,Q)^+
            %em irreducible
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            when restricted to the group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,Q)
          %p
            We have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ,
                  %mi s
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo ≅
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ,
                  %mi s
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(r,s)^+ \cong Cl(r,s-1)
            as ungraded algebras. Therefore we can read off the spin representations from the above classification table. Consider for example the group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ≅
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi M
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(3,1) \subset Cl(3,1)^+ \cong Cl(3,0) \cong M_2(\mathbb{C})
            %em two
            simple modules as a real algebra,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^2
            and its conjugate.
          %h4#invariant_forms_and_super_lie_algebras Invariant forms and Super Lie Algebras
          %p
            The symmetries of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+space"} Minkowski space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1|1}
            are given by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+group"} Poincaré group
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mn 0
                  %mo =
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi d
                  %mo ⋉
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g}_0 = \mathbb{R}^{d-1|d} \ltimes \mathfrak{so}(d-1,1)
          %p
            To get the
            %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
            from this, we would like to extend it by an odd part
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_1
            given by a spin representation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            can be obtained from the following data:
          %ul
            %li
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔤
                        %mn 0
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mspace{:width => "thinmathspace"}
                      %mo ⋅
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo ⋅
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathfrak{g}_0, [\,\cdot\,, \,\cdot\,])
            %li
              a
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}_1
            %li
              a symmetric
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝔤
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi 𝔤
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝔤
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \kappa \colon \mathfrak{g}_1 \otimes \mathfrak{g}_1 \to \mathfrak{g}_0
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi κ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \cdot \kappa(a,a) = 0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msub
                        %mi 𝔤
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} a \in \mathfrak{g}_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}_1
          %p
            We know what
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_1
            should be in our case. Note that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝔰𝔭𝔦𝔫
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1) = \mathfrak{spin}(d-1,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
            acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (where the translations act trivially). Therefore we need to concentrate on invariant symmetric forms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
          %p
            One way to easily satisfy the last condition for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            is to just look at those symmetric forms that take values in the translation part of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1|1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo →
                  %mi Λ
                  %mi V
                %annotation{:encoding => "application/x-tex"} S \otimes S \to \Lambda V
            for a quadratic vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V,Q)
            and an irreducible
            %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,Q)
          %p
            We will again spell out the case of complex vector spaces in more detail and just state the results in the real case. Since we would like to use duality results to classify invariant vector-valued forms, we first need to think about scalar-valued ones. Surprisingly enough, their existence in the
            %em complex
            case shows an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 8
                  %annotation{:encoding => "application/x-tex"} 8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of the underlying
            %em complex vector space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                  mod
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} 8
                %th type of invariant scalar form
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                %td{:style => "text-align: left;"}
                  symmetric forms on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %annotation{:encoding => "application/x-tex"} S^{+}
                  and on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %annotation{:encoding => "application/x-tex"} S^{-}
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 7
                      %annotation{:encoding => "application/x-tex"} 1,7
                %td{:style => "text-align: left;"}
                  symmetric form on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 6
                      %annotation{:encoding => "application/x-tex"} 2,6
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S^+
                  dual to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo −
                      %annotation{:encoding => "application/x-tex"} S^-
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 3
                        %mo ,
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} 3,5
                %td{:style => "text-align: left;"}
                  skew-symmetric form on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} 4
                %td{:style => "text-align: left;"}
                  skew-symmetric form on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %annotation{:encoding => "application/x-tex"} S^{+}
                  and on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %annotation{:encoding => "application/x-tex"} S^{-}
          %p
            This can be found in
            = succeed "." do
              %a{:href => "#Varadarajan04"} Varadarajan 04, Table 6.4
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a complex vector space. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d = \dim(V)
              is even, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}l(V) \cong End(S)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msup
                      %mi S
                      %mo +
                    %mo ⊕
                    %msup
                      %mi S
                      %mo −
                  %annotation{:encoding => "application/x-tex"} S = S^+ \oplus S^-
              for irreducible spin representations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo ±
                    %annotation{:encoding => "application/x-tex"} S^{\pm}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi r
                      %mo ≤
                      %mfrac
                        %mi d
                        %mn 2
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \leq r \leq \frac{d}{2}-1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Hom
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ,
                    %msup
                      %mi Λ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\dim(Hom_{Spin(V)}(S \otimes S, \Lambda^r(V))) = 2.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is odd, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ≅
                    %mi End
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}l(V)^+ \cong End(S_0)
              for an irreducible spin representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S_0
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Hom
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 0
                    %mo ⊗
                    %msub
                      %mi S
                      %mn 0
                    %mo ,
                    %msup
                      %mi Λ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\dim(Hom_{Spin(V)}(S_0 \otimes S_0, \Lambda^r(V))) = 1.
          .proof
            %h6#proof_3 Proof
            %p
              We just prove the even case: By the above table we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                    %mo ≅
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S^* \cong S
              via an equivariant isomorphism. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ≅
                    %msup
                      %mi S
                      %mo *
                    %mo ⊗
                    %mi S
                    %mo ≅
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi ℂ
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \otimes S \cong S^* \otimes S \cong End(S) \cong \mathbb{C}l(V) \cong \Lambda(V)
              as
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(V)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ,
                    %msup
                      %mi Λ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi Hom
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Λ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Spin(V)}(S \otimes S, \Lambda^r(V)) \cong Hom_{Spin(V)}(\Lambda(V), \Lambda^r(V))
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^r(V)
              is irreducible as
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(V)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi r
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msup
                        %mi Λ
                        %mrow
                          %mi d
                          %mo −
                          %mi r
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Lambda^r(V) \cong \Lambda^{d-r}(V)
          %p
            The basis in both cases is obtained from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            defined via duality by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Λ
                          %mi r
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo ,
                    %mi y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi S
                  %annotation{:encoding => "application/x-tex"} (\kappa(x \otimes y), v)_{\Lambda^r(V)} = (\lambda(v)x, y)_S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Lambda^r(V)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            respectively. We can read off the parity and the symmetry of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            from this definition and we have to restrict to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo +
                    %mo ⊗
                    %msup
                      %mi S
                      %mo +
                  %annotation{:encoding => "application/x-tex"} S^+ \otimes S^+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo −
                  %mo ⊗
                  %msup
                    %mi S
                    %mo −
                %annotation{:encoding => "application/x-tex"} S^- \otimes S^-
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo +
                  %mo ⊗
                  %msup
                    %mi S
                    %mo −
                %annotation{:encoding => "application/x-tex"} S^+ \otimes S^-
            depending on the dimension and on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
          %p
            This time the results are much more complex in the real case. Aside from the fact that the dimension of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            and the parity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            enter, the invariant forms need not be projectively unique anymore. The case most important for us, however, is that of Minkowski signature. And here - quite magically - all the ambiguities disappear and we have (
            %a{:href => "#Varadarajan04"}> Varadarajan 04, Theorem 6.7.1
            ):
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a real quadratic vector space of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              and with Minkowski signature, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be a real irreducible spin representation, then there is a projectively unique nontrivial invariant symmetric form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo →
                    %mi V
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa \colon S \otimes S \to V.
          %h3#summary_3 Summary
          %p
            A class of examples of
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            of particular interest in applications to
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            in general and
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            in particular are super-
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extensions"} Lie algebra extensions
            of the Lie algebra of infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            that appear as
            %a.existingWikiWord{:href => "/nlab/show/local+symmetries"} local symmetries
            in
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            and
            %a.existingWikiWord{:href => "/nlab/show/superstring+theory"} superstring theory
            and, more speculatively, as
            %a.existingWikiWord{:href => "/nlab/show/global+symmetries"} global symmetries
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/MSSM"} MSSM
          %p
            These we turn to
            = succeed "," do
              %a{:href => "#SuperMinkowskiSpacetime"} below
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            crucially contain
            %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            and crucially depend on the subtleties of the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %em
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            in general.
          %p
            A standard mathematical textbook account for this is (
            %a{:href => "#LawsonMichelsohn89"}> Lawson-Michelsohn 89, I.2, I.3, I.5
            ), but for actual computations and notably for comparison with the bulk of the literature, it is useful to also make explicit the standard
            %a.existingWikiWord{:href => "/nlab/show/bases"} bases
            and
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            representations, as summarized neatly for instance in (
            %a{:href => "#Polchinski01"}> Polchinski 01, volume II, appendix B
            ). Decent accounts that are both mathematically satisfactory as well as geared towards the applications to
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            are (
            %a{:href => "#Varadarajan04"}> Varadarajan 04, chapters 5 and 6
            ) and (
            %a{:href => "#Freed99"}> Freed 99, lecture 3
            ).
          %p
            The main point of interest here is that a
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            for
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+space"} Minkowski space
            requires precisely a
            %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            which is equipped with a linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma \;\colon\; S \otimes S \longrightarrow \mathbb{R}^{d-1,1}
          %p which is
          %ol
            %li
              %p symmetric;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                \-equivariant.
          %p
            (Precisely these two properties will make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            the odd/odd component of a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
          %p
            In (
            %a{:href => "#Varadarajan04"}> Varadarajan 04, section 6.6
            ) these bilinear pairings are classified in full generality, for arbitrary
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+quadratic+form"} signature
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski
            %a.existingWikiWord{:href => "/nlab/show/signature+of+a+quadratic+form"} signature
            all
            %em real
            spinor representations (“
            %a.existingWikiWord{:href => "/nlab/show/Majorana+representations"}> Majorana representations
            ”) carry an essentially unique such pairing and at the same time are the representations relevant in most applications. Therefore we concentrate
            %a{:href => "#ClassificationAndPropertiesOfMajoranaRepresentations"} below
            on the classification and properties of
            %a.existingWikiWord{:href => "/nlab/show/Majorana+representations"} Majorana representations
            of the Lorentzian
            %a.existingWikiWord{:href => "/nlab/show/spin+groups"} spin groups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
          %h3#classification_and_properties_of_majorana_representations Classification and properties of Majorana representations
          %p
            The following table lists the irreducible real representations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(V)
            (
            %a{:href => "#Freed99"}> Freed 99, page 48
            ).
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                %th
                  minimal real spin representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mi S
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"} dim_{\mathbb{R}} S\;\;
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  in terms of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo *
                      %annotation{:encoding => "application/x-tex"} S^\ast
                %th
                  %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %tbody
              %tr
                %td{:style => "text-align: left;"} 1
