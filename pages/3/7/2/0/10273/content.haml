          .num_remark
            %h6#remark_5 Remark
            %p
              Observe that the ordinary
              %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
