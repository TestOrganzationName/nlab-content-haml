                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            as the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
          %p
            For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            (“
            %a.existingWikiWord{:href => "/nlab/show/spacetime"}> spacetime
            ”) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \;\colon\; X \longrightarrow \mathbf{B}U(1)_{conn}
            a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            (“
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            on
            = succeed "\u201D)" do
