          %p
            But more generally, if the
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I \coloneqq [0,1]
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            functional on
            %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [S^1, X]
            generalizes to the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            on the
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,X]
            and there it is no longer a function, but exists only as a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} |
                                %mn 0
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mn 1
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %msub
                                %mo ∫
                                %mi I
                              %mo{:stretchy => "false"} [
                              %mi I
                              %mo ,
                              %mo ∇
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi χ
                                  %mo ∇
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi χ
                                  %mo ∇
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [I,X]
                  \\\
                  \&amp; {}^{(-)|_0}\swarrow &amp;&amp; \searrow^{\mathrlap{(-)|_1}}
                  \\\
                  X &amp;&amp; \swArrow_{\exp(i \int_{I}[I,\nabla])} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\chi_\nabla}}\searrow &amp;&amp; \swarrow_{\mathrlap{\chi_\nabla}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)
                  }
                  \\,.
          %p Notice that this is a “local” description of the action functional: the data that determines it is the boundary
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
