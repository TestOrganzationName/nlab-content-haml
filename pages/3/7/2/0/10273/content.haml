                  %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
