            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of shape the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (“
            %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
            gauge
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            %a.existingWikiWord{:href => "/nlab/show/nonlinear+functional"} functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi Lor
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi S
                        %mn 1
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{Lor})
                  \\coloneqq
                  \\exp(i \int_{S^1} [S^1, \nabla])
                  \\;\colon\;
                  [S^1, X]
