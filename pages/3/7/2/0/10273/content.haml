                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_{WZW} \;\colon\; G \longrightarrow \mathbf{B}^2 U(1)_{conn}
            %p
              on a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              is characterized (e.g.
              = succeed ")" do
                %a{:href => "#SchweigertWaldorf07"} Schweigert-Waldorf 07
              %a.existingWikiWord{:href => "/nlab/show/universal+Chern-Simons+circle+3-connection"} universal Chern-Simons circle 3-connection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi CS
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo ⟶
                    %msup
