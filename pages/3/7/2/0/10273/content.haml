                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_{CS} \;\colon\; \mathbf{B}G_{conn} \longrightarrow \mathbf{B}^3 U(1)_{conn}
            %p
              by two pieces (the two ingredients in the
              = succeed "-definition" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mi WZW
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_{WZW}
                  is the value of the
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
                  on the canonical
                  %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              %li
                %p
