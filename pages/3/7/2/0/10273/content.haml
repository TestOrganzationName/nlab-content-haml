                              %mo ∇
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \\\
                  \\downarrow^{\mathrlap{\nabla}}
                  \\\
                  \\mathbf{B}U(1)_{conn}
                  }
          %p
            and from this the rest is induced by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
          %p
            A related class of examples are
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondences"} prequantized Lagrangian correspondences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi ω
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \\\
                  \\downarrow^{\mathrlap{\omega}}
                  \\\
                  \\mathbf{\Omega}^2
                  }
          %p
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow X
            is a
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ω
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi ω
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; graph(f)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\omega}}\searrow &amp;&amp; \swarrow_{\mathrlap{\omega}}
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2
                  }
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mo ∇
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{\nabla}{\longrightarrow}&amp; \mathbf{B}U(1)_{conn}
                  \\\
                  \&amp; \searrow &amp; \downarrow^{\mathrlap{F_{(-)}}}
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2
                  }
          %p
            and so a
            %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondence"} prequantized Lagrangian correspondence
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
