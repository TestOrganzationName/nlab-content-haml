                        %mi t
                        %mo −
                        %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (t-s)
                  mod
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} 8
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(s,t)
                %th
