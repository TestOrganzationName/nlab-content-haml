                        %mtd
                        %mtd
                          %mi graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mo ∇
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; graph(f)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; \swArrow &amp;&amp; X
                  \\\
                  \&amp; _{\mathllap{\nabla}}\searrow &amp;&amp; \swarrow_{\mathrlap{\nabla}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)_{conn}
                  }
                  \\,.
          %p To conceptualize all this, write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %mi SmoothGrpd
                  %mo ≔
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SmoothMfd
                    %mi op
                  %mo ,
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %mi stalkwise
                  %mspace{:width => "thickmathspace"}
                  %mi equivalences
                  %msup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq SmoothGrpd \coloneqq
                  Func(SmoothMfd^{op}, Grpd)[\{stalkwise\;equivalences\}^{-1}]
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of all
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            by universally turning
            %a.existingWikiWord{:href => "/nlab/show/stalk"} stalkwise
            %a.existingWikiWord{:href => "/nlab/show/equivalences+of+groupoids"} equivalences of groupoids
            into genuine
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            (“
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"}> simplicial localization
            ”).
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            of
            = succeed "/smooth" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  Corr_1(\mathbf{H})
                  \\in
                  (2,1)Cat
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}U(1)_{conn}}
            for the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"} slice
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            over the smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle bundles with connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo ∈
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nabla \in Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
              is the
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
              which is the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete
              smooth 1-parameter subgroup
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℝ
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{R} \longrightarrow
                    \\mathbf{B}\mathbf{Aut}_{/\mathbf{B}U(1)_{conn}}(\nabla)
                    \\hookrightarrow
                    \\mathbf{H}_{/\mathbf{B}U(1)_{conn}}
            %p
              is equivalently a choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in C^\infty(X)
              of a smooth function and sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi t
                                  %mo{:stretchy => "false"} {
                                  %mi H
                                  %mo ,
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} }
                                  %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mo ∇
                              %mo ↘
                            %mtd
                              %msub
                                %mo ⇙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi exp
                                    %mo{:stretchy => "false"} (
                                    %mi i
                                    %msub
                                      %mi S
                                      %mi t
                                    %mo{:stretchy => "false"} )
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mo ∇
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi conn
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    t
                    \\;\;
                    \\mapsto
                    \\;\;
                    \\left(
                    \\array{
                    X &amp;&amp;\stackrel{\exp(t \{H,-\})}{\longrightarrow}&amp;&amp; X
                    \\\
                    \&amp; {}_{\mathllap{\nabla}}\searrow &amp;\swArrow_{\mathrlap{\exp(i S_t)}}&amp; \swarrow_{\mathrlap{\nabla}}
                    \\\
                    \&amp;&amp; \mathbf{B}U(1)_{conn}
                    }
                    \\right)
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} {
                        %mi H
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exp(t \{H,-\})
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+flow"} Hamiltonian flow
                  induced by
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi t
                        %mo =
                        %msubsup
                          %mo ∫
                          %mn 0
                          %mi t
                        %mi L
                      %annotation{:encoding => "application/x-tex"} S_t = \int_0^t L
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hamilton-Jacobi+theory"} Hamilton-Jacobi
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  %a.existingWikiWord{:href => "/nlab/show/integral"} integral
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
          %p
            (see
            = succeed ")." do
              %a{:href => "#SchreiberClassical"} Schreiber 13
          %p
            It is now clear how to pass from this to
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            of higher dimension.
          %p Let now more generally
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo ≔
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SuperMfd
                    %mi op
                  %mo ,
                  %mi KanCplx
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %mi stalkwise
                  %mspace{:width => "thickmathspace"}
                  %mi homotopy
                  %mspace{:width => "thickmathspace"}
                  %mi equivalences
                  %msup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq
                  Smooth\infty Grpd
                  \\coloneqq
                  Func(SuperMfd^{op}, KanCplx)[\{stalkwise\;homotopy\;equivalences\}^{-1}]
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on the category of all
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            by universally turning
            %a.existingWikiWord{:href => "/nlab/show/stalk"} stalkwise
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            into actual
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
          %p
            We say that this is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "/_" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
            %em .
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  Corr_n(\mathbf{H}) \in (\infty,n)Cat
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            of
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            under the objectwise
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            has the special property that it is
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive
            in that it is equipped with an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mi coDisc
                        %mover
                          %mo ⟶
                          %mi Γ
                      %mover
                        %mo ←
                        %mi Disc
                    %mover
                      %mo ⟶
                      %mi Π
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}
                  \\stackrel{\overset{\Pi}{\longrightarrow}}{\stackrel{\overset{Disc}{\leftarrow}}{\stackrel{\overset{\Gamma}{\longrightarrow}}{\underset{coDisc}{\leftarrow}}}}
                  \\infty Grpd
          %p
            which induce an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
            = succeed "/comonads" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monads"} (∞,1)-monads
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi Π
                    %mo ⊣
                    %mo ♭
                    %mo ⊣
                    %mo ♯
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\Pi \dashv \flat \dashv \sharp
                  \\right)
                  \\;\colon\;
                  \\mathbf{H}
                  \\longrightarrow
                  \\mathbf{H}
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
