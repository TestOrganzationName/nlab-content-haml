                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{n+1}
                    \\longrightarrow
                    \\flat \mathbf{B}^{n+1}U(1)
                    \\,.
            %p
              By the above we may regard this as an
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              for an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              of
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              being
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi cl
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^{n+1}_{cl}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %msub
                                    %mi S
                                    %mi tYM
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\Omega}^{n+1}_{cl}
                    \\\
                    \\downarrow^{\mathrlap{\exp(i S_{tYM})}}
                    \\\
                    \\flat \mathbf{B}^{n+1}U(1)
                    }
                    \\,,
            %p
              where the subscript is supposed to refer to “universal higher
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
          %p
            Observe that by the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                %annotation{:encoding => "application/x-tex"} Bord_n
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} fully dualizable objects
            generated from a single object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                  %mo ≃
                  %mi FreeSMwD
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Bord_n \simeq FreeSMwD(\{\ast\})
                  \\,.
          %p Let then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ∂
                  %mo ≔
                  %mi FreeSMwD
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo ⟶
                  %mo *
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Bord_n^{\partial} \coloneqq FreeSMwD(\{\emptyset \longrightarrow \ast\})
          %p
            the free
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} fully dualizable objects
            generated from a single object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            and a single
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⟶
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset \longrightarrow \ast
            from the
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            to the generating object. By the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            %a.existingWikiWord{:href => "/nlab/show/defect+field+theory"} defect
            version of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
            with possibly a
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            component of
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            Hence a
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi Bord
                            %mi n
                            %mo ∂
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mi S
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi Corr
                            %mi n
                          %mo{:stretchy => "false"} (
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mo ♭
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mrow
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi Fields
                                %mo ∂
                          %mo ↘
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Corr
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Bord_n^\partial
                  \&amp;\stackrel{\exp(i S)}{\longrightarrow}&amp;
                  Corr_n(\mathbf{H}_{/\flat \mathbf{B}^{n+1}U(1)})
                  \\\
                  \&amp; {}_{\mathbf{Fields}^\partial} \searrow &amp; \downarrow
                  \\\
                  \&amp;&amp; Corr_n(\mathbf{H})
                  }
          .num_remark
            %h6#remark_2 Remark
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
              as above is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Fields
                              %mi bdr
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo ⇙
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi S
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{Fields}_{bdr}
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\ast &amp;&amp; \swArrow &amp;&amp; \mathbf{Fields}
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\exp(i S)}}
                    \\\
                    \&amp;&amp; \flat \mathbf{B}^{n+1}U(1)
                    }
                    \\,.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %em universal
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary condition
              for the universal higher topological Yang-Mills theory of example
              %a.maruku-ref{:href => "#tYM"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/higher+moduli+stack"} higher moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)_{conn}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
              %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
              is a
              = succeed "]." do
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          %p
            The
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            that we are after are boundaries of these boundary field theories, hence “corner field theories” (
            %a{:href => "#Sati11"}> Sati 11
            ,
            = succeed ")" do
              %a{:href => "#lpqft"} lpqft
          .num_remark
            %h6#remark_3 Remark
            %p
              The earliest and the only rigorously understood example of the
              %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
              is the
              %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} AdS3-CFT2 and CS-WZW correspondence
              between the
              %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
              on a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and 3d
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %p
              In (
              %a{:href => "7d+Chern-Simons+theory#Witten98"}> Witten 98
              ) it is argued that all examples of the
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
              are governed by the
              %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} higher Chern-Simons theory
              terms in the
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
              on one side of the correspondence, hence that the corresponding
              = succeed ":" do
                %span.newWikiWord
                  conformal field theories] are higher dimensional analogs of the traditional [[WZW model
                  %a{:href => "/nlab/new/conformal+field+theories%5D+are+higher+dimensional+analogs+of+the+traditional+%5B%5BWZW+model"} ?
              = succeed "\u201D-type" do
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            %p
              In particular for
              %a.existingWikiWord{:href => "/nlab/show/AdS7-CFT6"} AdS7-CFT6
              this means that the
              %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
              on the
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              should be a 6d-dimensional WZW model holographically related to the
              %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
              which appears when
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              is
              %a.existingWikiWord{:href => "/nlab/show/KK-reduction"} KK-reduced
              on a 4-
              %a.existingWikiWord{:href => "/nlab/show/sphere"}> sphere
              \:
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ←
                        %annotation{:encoding => "application/x-tex"} \leftarrow
                    %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo →
                        %annotation{:encoding => "application/x-tex"} \rightarrow
                  %th
                    %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    3d
                    %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    2d
                    %a.existingWikiWord{:href => "/nlab/show/Wess-Zumino-Witten+model"} Wess-Zumino-Witten model
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
                    from
                    %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
                    on
                    %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            %p
              In (
              %a{:href => "http://ncatlab.org/nlab/show/7d+Chern-Simons+theory#WittenI"}> Witten 96
              ) this is argued, by
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
              after
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
              to
              %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
              1, for the
              %em bosonic and abelian
              contribution in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
              %a.existingWikiWord{:href => "/nlab/show/theta+characteristic"} theta characteristic
              involved was later formalized in
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Quadratic+Functions+in+Geometry%2C+Topology%2C+and+M-Theory"} Hopkins-Singer 02
            %p
              In order to formalize this in generality, one needs a general formalization of
              %a.existingWikiWord{:href => "/nlab/show/holography"} holography
              for
              %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
              as these. How are
              = succeed "-models" do
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
              = succeed "?" do
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          %h3#lie_integration_of_cocycles
            Lie integration of
            = succeed "-cocycles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            The datum going into
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            is
            %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-group"} smooth super ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            which is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of a given
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            We discuss here how
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            relates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and how the Lie integration of the cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            induces a smooth universal
            %a.existingWikiWord{:href => "/nlab/show/characteristic+map"} characteristic map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mu) \colon \mathbf{B}G \longrightarrow \mathbf{B}^n (\mathbb{R}/\Gamma)
            (
            %a{:href => "#FiorenzaSchreiberStasheff12"}> Fiorenza-Schreiber-Stasheff 12
            ).
          .num_defn
            %h6#definition_5 Definition
            %p
              Given a (
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"}> super
              \-)
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              is the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo ↦
                    %mrow
                      %mo (
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} maptso
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi flat
                          %mo ,
                          %mi vert
                          %mo ,
                          %mi si
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})
                    \\colon
                    U \mapsto
                    \\left(
                    \\Delta[k] \maptso
                    \\Omega^\bullet_{flat,vert,si}(U \times \Delta^k, \mathfrak{g})
                    \\right)
            %p
              which assigns to a test (
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"}> super Cartesian space
              \-)
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              the
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              whose
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              are smooth
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U \times \Delta^k
              which are
            %ol
              %li
                %p flat
              %li
                %p
                  vertical, this means that all their “legs” are along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Delta^k
              %li
                %p
                  have
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/sitting+instants"} sitting instants
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  such that in this neighbourhood the differential form is constant in the direction perpendicular to the boundary (this condition makes the
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  indeed by a
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .num_example
            %h6#example_3 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              then the
              %a.existingWikiWord{:href => "/nlab/show/truncated"} 1-truncation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the simply connected
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              under traditional
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_1 \exp(\mathfrak{g}) \simeq \mathbf{B}G
                    \\,.
            %p In fact also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_2 \exp(\mathfrak{g}) \simeq \mathbf{B}G
            %p
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_3 \exp(\mathfrak{g})
              is different from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_3(G)
              is non-trivial.
          .num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{string}(\mathfrak{g})
              its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_2 \exp(\mathfrak{string}(\mathfrak{g}))
                    \\simeq
                    \\mathbf{B}String(G)
                    
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} String(G)
              is the smooth
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
          .num_remark
            %h6#remark_4 Remark
            %p
              The
              = succeed "-construction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                    %annotation{:encoding => "application/x-tex"} \exp
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mo ⟶
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi sCartSp
                      %mi op
                    %mo ,
                    %mi KanCplx
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    s L_\infty Alg
                    \\longrightarrow
                    Func(sCartSp^{op}, KanCplx)
                    \\longrightarrow
                    \\mathbf{H}
          .num_defn
            %h6#definition_6 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ cocycle
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ⟶
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu
                    \\;\colon\;
                    \\mathfrak{g}
                    \\longrightarrow
                    \\mathbb{R}[n]
                    \\,.
          %p
            Hence given a cocycle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            produces a morphism of
            %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(\mu)
                  \\;\colon\;
                  \\exp(\mathfrak{g})
                  \\longrightarrow
                  \\exp(\mathbb{R}[n])
                  \\simeq
                  \\mathbf{B}^{n+1}\mathbb{R}
                  \\,.
          .num_defn
            %h6#definition_7 Definition
            %p
              Say that the
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              are all values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              obtained by
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              of the
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              in the image of the biundary of an
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi μ
                    %mo ↪
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \Gamma_\mu \hookrightarrow \mathbb{R}
              for the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of such
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
          .num_defn
            %h6#definition_8 Definition
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncation
              the universal
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              above descents to an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+cohomology"} ∞-group cocycle
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi Γ
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}/\Gamma_{\mu}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi Γ
                              %mi μ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g})
                    \&amp;\stackrel{\exp(\mu)}{\longrightarrow}&amp;
                    \\mathbf{B}^{n+1}\mathbb{R}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}G
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    \\mathbf{B}^{n+1}(\mathbb{R}/\Gamma_\mu)
                    }
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ≔
                    %msub
                      %mi τ
                      %mi n
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G \coloneqq \tau_n \exp(\mathfrak{g})
                    \\,.
          %p
            Proof: Use the standard
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} simplicial (n+1)-coskeleton
            model for the
            = succeed "-truncation." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              with its canonical 3-cocycle
              = succeed "," do
