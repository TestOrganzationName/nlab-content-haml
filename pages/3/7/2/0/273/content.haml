                %annotation{:encoding => "application/x-tex"}
                  H^n_{\mathrm{dR}}(X)
                  \\;\;
                  \=
                  \\;\;
                  \\Omega^n_{\mathrm{dR}}(X)_{\mathrm{clsd}}
                  \\big/
                  \\Big(
                  \\omega^{(0)}
                  \\,\sim\,
                  \\omega^{(1)}
                  \\;\;\;
                  \\mbox{iff}
                  \\;\;
                  \\exists
                  \\;
                  {
                  \\widehat{\omega}
                  \\,\in\,
