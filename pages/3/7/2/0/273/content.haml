                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} B A
            (may be chosen such that it) carries topological group structure itself!, so that the construction iterates:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} AbGrp
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} TopSpc
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mn 2
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mn 3
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi ⋮
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mrow
                              %mn 1
                              %mo +
                              %mi n
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi B
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi B
                            %mi n
                          %mi A
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  A \;\in\;
                  \\mathrm{AbGrp}(\mathrm{TopSpc})
                  \\;\;\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;\;\;
                  \\left\{
                  \\begin{array}{l}
                  B^2 A
                  \\;\coloneqq\;
                  B(B A)
                  \\\
                  B^3 A
                  \\;\coloneqq\;
                  B\big(B(B A)\big)
                  \\\
                  \\;\;\;\vdots
                  \\\
                  B^{1+n} \;\coloneqq\; B\big(B^n A\big)
                  \\mathrlap{\,.}
                  \\end{array}
                  \\right.
          %p
            For a
            %em
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
            abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (such as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/integers"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(A,n)
            = succeed "\u201D:" do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} AbGrp
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi B
                    %mi n
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A \,\in\,
                  \\mathrm{AbGrp}(\mathrm{Set})
                  \\;\;\;\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;\;\;\;
                  K(A,n)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  B^n A
                  \\,.
          %p
            But this means that for abelian group coefficients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            there is
            %em
              higher-degree
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            appearing as a special case of non-abelian cohomology, as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mn 1
                      %mo +
                      %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi B
                    %mi nA
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi B
                    %mrow
                      %mn 1
                      %mo +
                      %mi n
                  %mi A
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^{1+n}\big(
                  X
                  ;\,
                  A
                  \\big)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  H^1\big(
                  X
                  ;\,
                  B^nA
                  \\big)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\pi_0
                  \\, \mathrm{Maps}\big(
                  X
                  ,\,
                  B^{1+n} A
                  \\big)
                  \\,.
          %p
            Of course, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is discrete then there is also
            %em
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            agree, hence that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ordinary
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mtext -
                  %mi cohomology
                  %mspace{:width => "thickmathspace"}
                  %mi has
                  %mspace{:width => "thickmathspace"}
                  %mi classifying
                  %mspace{:width => "thickmathspace"}
                  %mi spaces
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi B
                    %mi n
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ordinary \; A\text{-}cohomology \; has \; classifying \; spaces \; B^n A \,=\, K(A,n).
          %p
            %br/
          %h3#OrdinaryCharacteristicClasses Ordinary Characteristic Classes
          %p
            Thereby we obtain an immediate means to
            = succeed ":" do
              %em approximate non-abelian cohomology by abelian cohomology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mi G
                    %mover
                      %mo →
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %msup
                      %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} c \colon B G \xrightarrow{\phantom{--}} B^n A
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+class"} universal characteristic class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi c
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi B
                  %mi G
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  [c]
                  \\;\in\;
                  H^n\big(
                  B G
                  ;\,
                  A
                  \\big)
                  \\,,
          %p
            induces a
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            from non-abelian to abelian cohomology, simply by
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of classifying maps:
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/CharacteristicClassSchematics.jpg", :width => "800px"}/
          %p
            For example, the
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Fr
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathrm{Fr}_X
            of a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(d)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            carries universal
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+classes"} Pontrjagin classes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 4
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi{:mathvariant => "normal"} O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} p_n \,\in\, H^{4n}\big(B \mathrm{O}(d);\, \mathbb{Z}\big)
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi n
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi p
                    %mi n
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi p
                    %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi{:mathvariant => "normal"} Fr
                    %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} Fr
                        %mi X
                  %mi B
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mi n
                  %msup
                    %mi B
                    %mrow
                      %mn 4
                      %mi n
                  %mi ℤ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mrow
                      %mn 4
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p_n[X]
                  \\;\coloneqq\;
                  p_n[T X]
                  \\;\coloneqq\;
                  p_n[\mathrm{Fr}_X]
                  \\;\coloneqq\;
                  \\big[
                  X
                  \\xrightarrow{
                  \\vdash \mathrm{Fr}_X
                  }
                  B\mathrm{O}(d)
                  \\xrightarrow{p_n}
                  B^{4n}\mathbb{Z}
                  \\big]
                  \\;\;
                  \\in
                  \\;\;
                  H^{4n}(X; \,\mathbb{Z})
                  \\,.
          %p We see again that:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi In
                        %mspace{:width => "thickmathspace"}
                        %mi terms
                        %mspace{:width => "thickmathspace"}
                        %mi of
                        %mspace{:width => "thickmathspace"}
                        %mi classifying
                        %mspace{:width => "thickmathspace"}
                        %mi spaces
                        %mo ,
                    %mtr
                      %mtd
                        %mi cohomology
                        %mspace{:width => "thickmathspace"}
                        %mi and
                        %mspace{:width => "thickmathspace"}
                        %mi characteristic
                        %mspace{:width => "thickmathspace"}
                        %mi classes
                    %mtr
                      %mtd
                        %mi become
                        %mspace{:width => "thickmathspace"}
                        %mi conceptually
                        %mspace{:width => "thickmathspace"}
                        %mi very
                        %mspace{:width => "thickmathspace"}
                        %mi transparent
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  In \; terms \; of \; classifying \; spaces,
                  \\\
                  cohomology \; and \; characteristic \; classes
                  \\\
                  become \; conceptually \; very \; transparent.
                  \\end{array}
          %p
            %br/
          %h3#OrdinaryCharacterMap Ordinary Character Map
          %p
            One more notion of cohomology available on
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi{:mathvariant => "normal"} dR
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n}_{\mathrm{dR}}(X)
            %a{:href => "#FSS23"} FSS23 Prop. 6.4
            – as equivalence classes of closed differential forms modulo
            %em
              %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} dR
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} clsd
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi ω
