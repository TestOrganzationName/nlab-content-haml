                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} K(G, 1) \,\simeq\, B G
            still exists (cf.
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %em not a loop space
          %p While the suspension isomorphism is thus lost for non-abelian coefficients, the assignment
          #eq:OrdinaryNonAbelianCohomology.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi B
                  %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi{:mathvariant => "normal"} Set
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  X
                  \\;\;
                  \\mapsto
                  \\;\;
                  H^1\big(
                  X
                  ;\,
                  G
                  \\big)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\pi_0
                  \\,
                  \\mathrm{Maps}\big(
                  X
                  ,\,
                  B G
                  \\big)
                  \\;\;\;
                  \\in\;
                  \\mathrm{Set}^{\ast/}
          %p
            still satisfies homotopy invariance, exactness and wedge property, just as before by the general properties of mapping spaces, and hence has all the characteristic properties of ordinary cohomology – except for its abelian-ness. Accordingly,
            %a.maruku-eqref{:href => "#eq:OrdinaryNonAbelianCohomology"} (3)
            is known as
            = succeed "," do
              %em non-abelian cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
          %p
            %br/
          %p
            %strong Whitehead-generalized cohomology.
            If or as long as we do insist on abelian cohomology groups related by suspension isomorphisms, we may still immediately generalize ordinary cohomology in the form
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:OrdinaryCohomologyRepresented"} (1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi n
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} (E_n)_{n=0}^\infty
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:LoopingEquivOnEmSpaces"} (2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi E
                    %mi n
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mo ∼
                      %mspace{:width => "thickmathspace"}
                  %mi Ω
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\sigma_n \,:\,
                  E_n
                  \\xrightarrow{\; \sim \;}
                  \\Omega
                  E_{n+1}
                  \\,,
          %p
            as such called a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Ω
                      %annotation{:encoding => "application/x-tex"} \Omega
                  \-spectrum
                of spaces
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
            says that the resulting assignments
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi E
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  X
                  \\;\;
                  \\mapsto
                  \\;\;
                  E^n(X)
                  \\,\coloneqq\,
                  \\pi_0
                  \\,
                  \\mathrm{Maps}\big(
                  X
                  ,\,
                  E_n
                  \\big)
          %p
            are equivalently the “
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"}> generalized cohomology theories
            ” as introduced by Whitehead, including examples such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+cohomology"} cobordism cohomology
          %p
            %br/
          %p
            %strong Non-abelian generalized cohomology.
            But as we just saw, suspension isomorphisms are to be regarded as
            %em
              %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on cohomology. Not necessarily requiring them leads to consider
            %em any pointed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"} \mathscr{A}
            (which we may as well assume to be
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %em non-abelian generalized cohomology
            theory, defined in evident generalization of
            %a.maruku-eqref{:href => "#eq:OrdinaryNonAbelianCohomology"} (3)
            simply by
          #eq:NonabelianCohomology.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %mi.mathscript 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi.mathscript 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^1\big(
                  X
                  ;\,
                  \\Omega\mathscr{A}
                  \\big)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\pi_0
                  \\,
                  \\mathrm{Maps}\big(
                  X
                  ,\,
                  \\mathscr{A}
                  \\big)
                  \\,.
          %p
            Here the notation on the left is suggestive of the fact that any loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"} \Omega \mathscr{A}
            canonically carries the structure of a higher homotopy-coherent group – a groupal
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-group
            %a{:href => "May+recognition+theorem#statement"} is equivalent
            to the connected component of the original space:
          #eq:DeloopingEquivalence.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %mi.mathscript 𝒜
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{A}
                  \\;\;
                  \\simeq
                  \\;\;
                  B \, \Omega \mathscr{A}
                  \\,.
          %p
            For example, in the archetypical case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                  %mspace{:width => "thinmathspace"}
                  %mo ≡
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathscr{A} \,\equiv\, S^n
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-sphere
            %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi π
                    %mi n
                %annotation{:encoding => "application/x-tex"} \pi^n
          #eq:Cohomotopy.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi H
                      %mo ˜
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %msup
                    %mi S
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi{:mathvariant => "normal"} Maps
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\widetilde H^1\big(
                  X
                  ;\,
                  \\Omega S^n
                  \\big)
                  \\;\;
                  \\equiv
                  \\;\;
                  \\pi_0
                  \\,
                  \\mathrm{Maps}^{\ast/\!}\big(
                  X
                  ,\,
                  S^n
                  \\big)
                  \\;\;
                  \\equiv
                  \\;\;
                  \\pi^n(X)
                  \\,,
          %p
            in dual reference to the familar
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy
            groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi{:mathvariant => "normal"} Maps
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_n(X)
                  \\;\;
                  \\simeq
                  \\;\;
                  \\pi_0
                  \\,
                  \\mathrm{Maps}^{\ast/\!}\big(
                  S^n
                  ,\,
                  X
                  \\big)
                  \\,.
          %p
            Another example of non-abelian generalized cohomology is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unstable+topological+K-theory"} unstable topological K-theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{U}(n)
            of the sequential colimits which construct the classifying spaces of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %h3#developing_nonabelian_cohomology Developing non-abelian cohomology
          %p
            Fundamental, elementary and compelling as the notion of non-abelian generalized cohomology in
            %a.maruku-eqref{:href => "#eq:NonabelianCohomology"} (4)
            is, it has long remained underappreciated. For example, none of the original authors on
            %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
            %a.maruku-eqref{:href => "#eq:Cohomotopy"} (6)
            address their subject as a cohomology theory, instead the early development revolves around partial fixes for the perceived defect of co-homotopy sets to not in general carry group structure. The situation does not improve with the early development of “
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+gerbes"}> non-abelian gerbes
            ”, whose original description appears unwieldy.
          %p
            Explicit acknowledgement of (stacky) non-abelian generalized cohomology in the transparent guise
            %a.maruku-eqref{:href => "#eq:NonabelianCohomology"} (4)
            appears only in a lecture of
            = succeed "," do
              %a{:href => "#Toen02"} Toën 2002
            %a{:href => "#Simpson02"} Simpson 2002
            where non-abelian generalization of
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            is considered).
          %p Two independent developments around 2009 put non-abelian generalized cohomology into practical context:
          %ul
            %li
              %p
                The discovery of
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+Poincar%C3%A9+duality"} nonabelian Poincaré duality
                (
                %a{:href => "nonabelian+Poincaré+duality#Lurie09"}> Lurie 2009 §3.8
                ), relating non-abelian cohomology (as later made explicit in
                = succeed ")" do
                  %a{:href => "#Lurie14"} Lurie 2014 Def. 6
                = succeed "\u201D" do
                  %em homology
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+chiral+homology"} topological chiral homology
            %li
              %p
                The observation in theoretical physics (
                %a{:href => "#SS08"}> SS 2008
                ,
                = succeed ")" do
                  %a{:href => "#Schreiber09"} Sc 2009
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+flux+quantization"} charge/flux-quantization laws
                for
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
                are generally in non-abelian cohomology.
          %p
            %br/
          %p With non-abelian generalized cohomology thus recognized as a worthwhile subject, one is led to generalize familiar constructions in abelian cohomology, as far as possible, and to explore the consequences.
          %p
            First, one may straightforwardly equip non-abelian cohomology with further attributes: Considering the right hand side of
            %a.maruku-eqref{:href => "#eq:NonabelianCohomology"} (4)
            not just for plain spaces but for sheaves of spaces (
            %a.existingWikiWord{:href => "/nlab/show/infinity-stack"}> higher stacks
            ) leads to non-abelian generalized sheaf cohomology, including, in particular, non-abelian generalized versions of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+differential+cohomology"} nonabelian differential cohomology
          %p
            %br/
          %p
            %strong Equivariant non-abelian cohomology.
            Via the above identification of cohomology sets with homotopy-classes of maps to a classifying space, every flavor of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            comes with its corresponding flavor of cohomology theories.
          %p
            In
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            one considers topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"} \mathscr{A}
            equipped with the
            %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ↷
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"} G \curvearrowright \mathscr{A}
            of a (finite, for our purposes) group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and with
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %em equivariant cohomology
          #eq:EquivariantCohomology.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi G
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %mi.mathscript 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi G
                  %mo ↷
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo ↷
                  %mi.mathscript 𝒜
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^1_G\big(
                  X;\,
                  \\Omega\mathscr{A}
                  \\big)
                  \\;\;
                  \=
                  \\;\;
                  \\pi_0
                  \\,
                  \\mathrm{Maps}\big(
                  G \curvearrowright X
                  ,\,
                  G \curvearrowright \mathscr{A}
                  \\big)^G
                  \\,.
          %p
            Here the notion of
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            reveals that
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-fixed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi.mathscript 𝒜
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathscr{A}^H
            for all subgroups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
            %em
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Orb
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Orb}(G)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-presheaf"} presheaves of spaces
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Orb
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Orb}(G)
          %p
            %br/
          %p
            %strong Twisted non-abelian cohomology.
            Somewhat similarly, given any space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript ℬ
                %annotation{:encoding => "application/x-tex"} \mathscr{B}
            in any homotopy theory, the
            %em
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi.mathscript ℬ
                    %annotation{:encoding => "application/x-tex"} \mathscr{B}
                \-slice
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            whose objects are spaces fibered over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript ℬ
                %annotation{:encoding => "application/x-tex"} \mathscr{B}
            with maps between them respecting the fibration up to specified homotopy. If we assume, without essential restriction, that the base space is connected, then we may identify it as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℬ
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi B
                    %mi.mathscript 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathscr{B} \,\simeq\, B \mathscr{G}
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:DeloopingEquivalence"} (5)
            %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                  %mo ⫽
                  %mi.mathscript 𝒢
                %annotation{:encoding => "application/x-tex"} \mathscr{A} \sslash \mathscr{G}
            of the homotopy-quotient of a homotopy-coherent action
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒢
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} acts
                    %mi.mathscript 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathscr{G} \acts \mathscr{A}
          %p
            If we now think of a domain object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi τ
                  %mi B
                  %mi.mathscript 𝒢
                %annotation{:encoding => "application/x-tex"} X \xrightarrow{\tau} B\mathscr{G}
            in this
            = succeed "-slice" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi.mathscript 𝒢
                  %annotation{:encoding => "application/x-tex"} B \mathscr{G}
            %em twist
            and of a codomain object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                  %mo ⫽
                  %mi.mathscript 𝒢
                  %mover
                    %mo →
                    %mi p
                  %mi B
                  %mi.mathscript 𝒢
                %annotation{:encoding => "application/x-tex"} \mathscr{A} \sslash \mathscr{G} \xrightarrow{p}  B \mathscr{G}
            as a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+coefficient+bundle"} local coefficient bundle
            = succeed "-associated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
            = succeed "-fiber" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathscr{A}
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
            = succeed "-cohomology:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathscr{A}
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/TwistedNonalianCohomologyB.jpg", :width => "600px"}/
          %p
            This works generally: If all spaces here are
            %em in addition
            equipped with
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:EquivariantCohomology"} (7)
            %em twisted equivariant
            non-abelian cohomology.
          %p
            %br/
          %p
            %strong The non-abelian character.
            One famous construction on abelian cohomology is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Dold+character+map"} Chern-Dold character map
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} K-cohomology
            becomes the familar
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            (and which on ordinary cohomology is essentially just the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} non-torsion
            data of cohomology. Its generalization to non-abelian cohomology was developed in
            = succeed ":" do
              %a{:href => "#FSS23"} FSS23
          %p
            Observing that the Chern-Dold character is essentially just the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            induced by
            %em
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒜
                  %mover
                    %mo →
                    %mrow
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                      %msup
                        %mi η
                        %mi ℚ
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                  %msup
                    %mi L
                    %mrow
                      %mspace{:width => "negativethinmathspace"}
                      %mi ℚ
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{A}
                  \\xrightarrow{
                  \\phantom{--}
                  \\eta^{\mathbb{Q}}
                  \\phantom{--}
                  }
                  L^{\!\mathbb{Q}}\mathscr{A}
          %p
            as such it makes sense in the generality of non-abelian classifying spaces (immediately so under mild technical assumptions, such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+topological+space"} nilpotency
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+dg-algebraic+rational+homotopy+theory"} fundamental theorem of dg-algebraic rational homotopy theory
            may be re-cast as a
            %em
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+de+Rham+theorem"} non-abelian de Rham theorem
            which identifies, over smooth manifolds
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/concordance+classes"} concordance classes
            of
            %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity+algebra+valued+differential+form"} flat differential forms having coefficients
            in the real
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+algebra"}
              Whitehead-bracket
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mi.mathscript 𝒜
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathscr{A}
            of the classifying space:
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/NonabelianCharacterMap.jpg", :width => "670px"}/
          %p
            Since generalized cohomology theories are typically hard to analyze, in particular non-abelian ones, this character map may be regarded as extracting the first non-trivial stage of more tractable invariants. For instance, the character of a non-abelian class is the first
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            to the trivialization of that class.
          %p
            %br/
          %p#NACGauge
            %strong Nonabelian cohomology and gauge fields.
            In the mentioned application to physics, the
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            of a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            are sourced by charges which appear as classes in
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+de+Rham+cohomology"} non-abelian de Rham cohomology
            on the right, and the completion of the higher gauge theory by a
            %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+flux+quantization"} flux-quantization law
            means to lift these charges through the character map to classes in a chosen non-abelian cohomology theory on the left.
          %div
            %table
              %thead
                %tr
                  %th
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/cohomology"} Cohomology
                  %th
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} Gauge fields
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} -theory
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+flux+quantization"} flux-quantization law
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/field+configuration"} field configuration
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Chern-Dold+character"} character
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary-
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential-
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/gauge+potentials"} gauge potentials
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted-
                  %td{:style => "text-align: left;"}
