                  %td{:style => "text-align: left;"}
                    on
                    %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/real+oriented+cohomology+theory"} Real-
                  %td{:style => "text-align: left;"}
                    on
                    %a.existingWikiWord{:href => "/nlab/show/orientifolds"} orientifolds
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} nonabelian-
                  %td{:style => "text-align: left;"}
                    non-
                    %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                    %a.existingWikiWord{:href => "/nlab/show/Gauss+law"} Gauss law
            %blockquote
              %p
                %strong Cohomology and gauge fields.
                While
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                has of course many and diverse applications, in
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                no less than in other fields, the role of cohomology specifically in the
                %em global
                description of (
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"}> higher
                )
                %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
                (“
                %a.existingWikiWord{:href => "/nlab/show/force+fields"}> force fields
                ”) is profound: In generalization of the seminal historical observation (“
                %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"}> Dirac charge quantization
                ”) that
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                %a.existingWikiWord{:href => "/nlab/show/field+configurations"} configurations
                are globally to be identified with 2-
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                in
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
                species are similarly to be identified with
                %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
                theories whose further properties and attributes closely reflect the field’s physical nature, as indicated in the above table.
          %p
            %br/
          %h2#MoreDetails More details
          %p
            %br/
          %h3#ordinary_principal_bundles Ordinary Principal Bundles
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %em
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"}
                principal
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            over a base space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \xrightarrow{\;} X
            such that there exists an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≔
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %msub
                    %mi U
                    %mi i
                  %mover
                    %mo ↠
                    %mi ι
                  %mi X
                %annotation{:encoding => "application/x-tex"} C \coloneqq \coprod_i U_i \overset{\iota}{\twoheadrightarrow} X
            over which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is identified with the trivial fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mspace{:width => "negativethinmathspace"}
                  %mo ×
                  %mspace{:width => "negativethinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} C \!\times\! G
            in a way that the
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            are identified by
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo :
                  %mspace{:width => "thinmathspace"}
                  %mi C
                  %mspace{:width => "negativethinmathspace"}
                  %msub
                    %mo ×
                    %mi X
                  %mspace{:width => "negativethinmathspace"}
                  %mi C
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \,:\, C \!\times_X\! C \xrightarrow{\;} G
            on double overlaps of charts,
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %msub
                      %mo ×
                      %mi X
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} C \times_X C \,=\, \underset{i,j}{\coprod} \, U_i \cap U_j
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/PrncBundlLocTriv-Schematics.jpg", :width => "860px"}/
          %p
            These
            %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
            clearly satisfy on triple overlaps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %msub
                    %mo ×
                    %mi X
                  %mi C
                  %msub
                    %mo ×
                    %mi X
                  %mi C
                %annotation{:encoding => "application/x-tex"} C \times_X C \times_X C
            the
            %em Čech cocycle
            condition
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/CechCocycle-Schematics.jpg", :width => "600px"}/
          %p
            and transform under a principal bundle
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mover
                    %mo →
                    %mi ϕ
                  %mi P
                  %mo ′
                %annotation{:encoding => "application/x-tex"} P \xrightarrow{ \phi } P'
            by the
            %em Čech coboundary
            relation
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/CechCoboundary-Schematics.jpg", :width => "600px"}/
          %p
            whence the
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            of principal bundles map to the
            %em
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            of the base space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Prncpl
                  %mi G
                  %mi{:mathvariant => "normal"} Bndl
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                      %mo ∼
                  %mover
                    %mo →
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} phanrtom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                      %mo ∼
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Prncpl}G\mathrm{Bndl}(X)_{\!\big/\sim}
                  \\xrightarrow{\phanrtom{--} \sim \phantom{--}}
                  H^1\big(X;\, G\big)
                  \\,.
          %p
            As indicated, this map is in fact a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            (for well-behaved
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          %p The outer parts of these diagrams then also show that if we write
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                for the
                %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
                with a single object and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                worth of morphisms,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat X
                for the
                %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                as its manifold of objects and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mspace{:width => "negativethinmathspace"}
                      %msub
                        %mo ×
                        %mi X
                      %mspace{:width => "negativethinmathspace"}
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \!\times_X\! C
                as its manifold of morphisms,
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mover
                        %mo →
                        %mi ι
                      %mi X
                    %annotation{:encoding => "application/x-tex"} C \xrightarrow{\iota} X
                a
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} *good* open cover
                (over which every
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
          %p
            then the groupoid of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Top"} continuous
            %a.existingWikiWord{:href => "/nlab/show/internal+functor"} functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mover
                    %mi X
                    %mo ^
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \,\colon\, \widehat{X} \xrightarrow{\;} \mathbf{B}G
            with
            %a.existingWikiWord{:href => "/nlab/show/Top"} continuous
            %a.existingWikiWord{:href => "/nlab/show/internal+natural+transformation"} natural transformations
            between these:
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/CechCohomology-Schematics.jpg", :width => "800px"}/
          %p
            %br/
          %h3#OrdinaryNonabelianCohomology Ordinary Nonabelian Cohomology
          %p
            A deeper but classical theorem says (cf.
            %span.newWikiWord
              SS25
              %a{:href => "/schreiber/new/Equivariant+principal+infinity-bundles"} ?
            = succeed ")" do
              %a{:href => "https://arxiv.org/pdf/2112.13654#page=171"} Thm. 4.1.3
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/topological+realization"} topological realization
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
            to
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo |
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi SmthGrpd
                  %mo ⟶
                  %mi TopSpc
                %annotation{:encoding => "application/x-tex"}
                  \\left\vert-\right\vert
                  \\,\colon\,
                  SmthGrpd
                  \\longrightarrow
                  TopSpc
          %p
            under which a continuous functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mover
                    %mi X
                    %mo ^
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \,\colon\, \widehat X \xrightarrow{\;} \mathbf{B}G
            becomes a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mi g
                    %mo |
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mover
                    %mi X
                    %mo ^
                  %mo{:stretchy => "false"} |
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \left\vert g\right\vert \;\colon\; \vert\widehat{X}\vert \xrightarrow{\;}  \vert\mathbf{B}G\vert
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mover
                    %mi X
                    %mo ^
                  %mo{:stretchy => "false"} |
                  %mo ≃
                  %mi X
                %annotation{:encoding => "application/x-tex"} \vert\widehat{X}\vert \simeq X
            to the
            %em
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mrow
                    %mo |
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo |
                %annotation{:encoding => "application/x-tex"} B G \,\coloneqq\, \left\vert\mathbf{B}G\right\vert
            – which still represents isomorphism classes of principal
            = succeed "-bundles:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/PrncBndlToNonabCohomology.jpg", :width => "800px"}/
          %p
            This is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/ordinary+nonabelian+cohomology"} ordinary nonabelian cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %br/
          %h3#OrdinaryAbelianCohomology Ordinary Abelian Cohomology
          %p
            In the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo ≡
                  %mspace{:width => "thinmathspace"}
                  %mi A
                %annotation{:encoding => "application/x-tex"} G \,\equiv\, A
            an
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} group
            = succeed "-wise" do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
