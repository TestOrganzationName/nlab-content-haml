                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                  %mi A
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi A
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ∧
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1_{\mathrm{dR}}\big(
                  \-
                  ;\,
                  \\mathfrak{g}
                  \\big)_{\mathrm{flat}}
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\Big\{
                  A \in \Omega^1_{\mathrm{dR}}(
                  \-
                  ;\,
                  \\mathfrak{g}
                  )
                  \\;\Big\vert\;
                  \\mathrm{d} A
                  +
                  \\tfrac{1}{2}
                  [A \wedge A]
                  \\,=\,
                  0
                  \\Big\}
                  \\mathrlap{\,.}
          %p
            There is a
            %em universal
            such flat form, called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi{:mathvariant => "normal"} dR
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} flat
                  %annotation{:encoding => "application/x-tex"}
                    \\theta
                    \\;\in\;
                    \\Omega^1_{\mathrm{dR}}(G;\, \mathfrak{g})_{\mathrm{flat}}
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullbacks
            of the MC-form along
            %a.existingWikiWord{:href => "/nlab/show/smooth+maps"} smooth maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^n \xrightarrow{\;} G
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/UniversalPropertyOfMCForm.jpg", :width => "280px"}/
          %p
            Hence on a trivial
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mi X
                  %mo ×
                  %mi G
                %annotation{:encoding => "application/x-tex"} P = X \times G
            we have a flat form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi{:mathvariant => "normal"} pr
                    %mi G
                    %mo *
                  %mi θ
                %annotation{:encoding => "application/x-tex"} A \,\coloneqq\, \mathrm{pr}_G^\ast \theta
            which restricts on each fiber to the MC-form.
          %p
            On a non-trivial principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            we still find a
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1_{\mathrm{dR}}(P;\, \mathfrak{g})
            that restricts on each fiber to the MC-form, but it may not itself be flat anymore, the failure being its
            %em
              %a.existingWikiWord{:href => "/nlab/show/curvature+2-form"} curvature
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi A
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ∧
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F_A
                  \\,\coloneqq\,
                  \\mathrm{d}A
                  +
                  \\tfrac{1}{2}
                  [A \wedge A]
                  \\;\in\;
                  \\Omega^2_{\mathrm{dR}}(P;\, \mathfrak{g})
                  \\,,
          %p
            which is therefore a measure for the non-triviality of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %em
              %a.existingWikiWord{:href => "/nlab/show/horizontal+form"} horizontal form
            in that it vanishes on vectors tangent to the fibers – in this case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} principal connection
          %p
            %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            then shows that all
            = succeed "-" do
              %a{:href => "adjoint+action#OfALieAlgebraOnItself"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} ad
                    %annotation{:encoding => "application/x-tex"} \mathrm{ad}
            %em
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomials"} invariant polynomials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} Sym
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \langle -, \cdots, -\rangle \;\in\; \mathrm{Sym}(\mathfrak{g}^\ast)^{\mathfrak{g}}
            evaluated on the curvature 2-form are in fact closed
            %em
              %a.existingWikiWord{:href => "/nlab/show/basic+differential+form"} basic forms
            in that they are
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back
            from closed forms on the base manifold:
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/EhresmannConditionsDiagramB.jpg", :width => "580px"}/
          %p
            Thus:
            %em Connections on principal bundles extract de Rham classes on their base space measuring their non-triviality.
          %p
            That these indeed give the above Chern-de Rham classes is the content of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theorem"} Chern-Weil theorem
          %p
            %br/
          %h2#more_history More history
          %p
            It was originally apparently
            %a.existingWikiWord{:href => "/nlab/show/John+Roberts"} John Roberts
            who understood (remarkably: while thinking about
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            in the guise of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
