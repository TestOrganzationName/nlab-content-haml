          %title Selected writings
          %p Thomas Streicher (1958-2025)
          %ul
            %li
              %p
                %a{:href => "https://www2.mathematik.tu-darmstadt.de/~streicher/"} personal page
            %li
              %p
                %a{:href => "https://www.mathematik.tu-darmstadt.de/fb/personal/details/thomas_streicher.de.jsp"} institute page
            %li
              %p
                %a{:href => "https://en.wikipedia.org/wiki/Thomas_Streicher"} Wikipedia entry
            %li
              %p
                %a{:href => "https://www.mathgenealogy.org/id.php?id=76350"} MathGenealogy page
          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of (
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"}> dependent
            )
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            (and proving an
            %a.existingWikiWord{:href => "/nlab/show/initiality+conjecture"} initiality conjecture
            in Ch. 4), see at
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/categorical+model+of+dependent+types"} categorical model of dependent types
          %ul
            %li#Streicher91
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              = succeed "," do
                %em Semantics of type theory – Correctness, completeness and independence results
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-1-4612-0433-6"} doi:10.1007/978-1-4612-0433-6
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              = succeed "," do
                %em Investigations into Intensional Type Theory
              = succeed "," do
                %a{:href => "https://www2.mathematik.tu-darmstadt.de/~streicher/HabilStreicher.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Streicher-IntensionalTT.pdf", :title => "pdf"} pdf
          %p
            Introducing the
            = succeed "-interpretation" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            (the “groupoid model”)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Martin+Hofmann"}> Martin Hofmann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
                %em The groupoid model refutes uniqueness of identity proofs
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1109/LICS.1994.316071"} doi:10.1109/LICS.1994.316071
          %p
            and introducing what came to be known the
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            (under the name “universe extensionality”):
          %ul
            %li#HofmannStreicher98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hofmann"}> Martin Hofmann
                ,
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
                = succeed "," do
                  %em The groupoid interpretation of type theory
                %a.existingWikiWord{:href => "/nlab/show/Giovanni+Sambin"} Giovanni Sambin
                et al. (eds.),
                = succeed "," do
                  %em Twenty-five years of constructive type theory
                %strong 36
                (1998) 83-111 &amp;lbrack;
                %a{:href => "https://global.oup.com/academic/product/twenty-five-years-of-constructive-type-theory-9780198501275"}> ISBN:9780198501275
                ,
                = succeed "," do
                  %a{:href => "http://www.mathematik.tu-darmstadt.de/~streicher/venedig.ps.gz"} ps.gz
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/HofmannStreicherGroupoidInterpretation.pdf", :title => "pdf"} pdf
              %p see also:
              %p
                Ethan Lewis, Max Bohnet,
                = succeed "," do
                  %em The groupoid model of type theory
                = succeed "," do
                  %a{:href => "https://staff.fnwi.uva.nl/b.vandenberg3/Onderwijs/Homotopy_Type_Theory_2017/HoTT-bohnet-lewis-handout.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/LewisBohnet.GroupoidModelOfTT.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            (
            %a.existingWikiWord{:href => "/nlab/show/distributors"}> distributors
            ):
          %ul
            %li{:id => "Bénabou00"}
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"} Jean Bénabou
              (notes by
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
                %em Distributors at Work
              = succeed "," do
                %a{:href => "http://www.mathematik.tu-darmstadt.de/~streicher/FIBR/DiWo.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Benabou-DistributorsAtWork.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+logic"} categorical logic
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              %em Introduction to Category Theory and Categorical Logic
              (2003) &amp;lbrack;
              %a{:href => "https://www2.mathematik.tu-darmstadt.de/~streicher/CTCL.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Streicher-CategoryTheory.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/denotational+semantics"} denotational semantics
            and
            %a.existingWikiWord{:href => "/nlab/show/domain+theory"} domain theory
            for
            %a.existingWikiWord{:href => "/nlab/show/functional+programming"} functional
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/programming+languages"} programming languages
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              = succeed "," do
                %em Domain-Theoretic Foundations of Functional Programming
              = succeed "," do
                %a{:href => "https://doc.lagout.org/programmation/Functional%20Programming/Domain-Theoretic%20Foundations%20of%20Functional%20Programming%20%5BStreicher%202006-12-04%5D.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://www.worldscientific.com/worldscibooks/10.1142/6284"} doi:10.1142/6284
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/first-order+set+theory"} first-order set theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+logic"} categorical logic
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"}> Steve Awodey
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Carsten+Butz"} Carsten Butz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alex+Simpson"} Alex Simpson
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
                %em Relating first-order set theories, toposes and categories of classes
              %strong 165
              2 (2014) 428-502 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/j.apal.2013.06.004"}> doi:10.1016/j.apal.2013.06.004
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/fibered+categories"} fibered categories
            following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"} Jean Bénabou
          %ul
            %li#Streicher18
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              = succeed "," do
                %em Fibred Categories à la Jean Bénabou
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1801.02927"} arXiv:1801.02927
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/2-comonad"} 2-comonad
            characterizing
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibrations"} Grothendieck fibrations
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacopo+Emmenegger"}> Jacopo Emmenegger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Luca+Mesiti"} Luca Mesiti
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Rosolini"} Giuseppe Rosolini
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              %em A comonad for Grothendieck fibrations
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2305.01474"}> arXiv:2305.01474
              \&amp;rbrack;
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/people"} people
