                    %mn 2
                    %msubsup
                      %mi Alg
                      %mi k
                      %mi b
                    %mo =
                    %mn 3
                    %msub
                      %mi Mod
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} 2 Alg_k^b = 3Mod_3
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trialgebra"} trialgebra
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            equipped with two compatible product structures a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+category"} Hopf category
          %p
            The 2-category of 2-modules of that is a
            = succeed "." do
