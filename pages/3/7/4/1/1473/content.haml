                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              does not have to be discrete: the same result extends to any space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and its inclusion into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X\sqcup\{\infty\}
              where we declare a subset in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X \sqcup \{\infty\}
              to be open iff it either does not contain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              and is open in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Z\sqcup\{\infty\}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Z\in U
              is and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            A space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is compact iff the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⟶
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} K\longrightarrow \{*\}
            is proper. Thus to see that a product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi Y
                    %mi i
                %annotation{:encoding => "application/x-tex"} \prod_{i \in I} Y_i
            of compact spaces is compact, it suffices to show that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, U)
            and any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi Y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f: X \to \prod_{i \in I} Y_i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %msub
                      %mi X
                      %mi U
                    %mo →
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi Y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \tilde{f}: X_U \to \prod_{i \in I} Y_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msub
                        %mi π
                        %mi i
                      %mi f
                    %mo ˜
                  %mo :
                  %msub
                    %mi X
                    %mi U
                  %mo →
                  %msub
                    %mi Y
                    %mi i
                %annotation{:encoding => "application/x-tex"} \widetilde{\pi_i f}: X_U \to Y_i
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mi Y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \pi_i f: X \to Y_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo ≔
                  %mo{:stretchy => "false"} ⟨
                  %mover
                    %mrow
                      %msub
                        %mi π
                        %mi i
                      %mi f
                    %mo ˜
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo :
                  %msub
                    %mi X
                    %mi U
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi Y
                    %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} \tilde{f} \coloneqq \langle \widetilde{\pi_i f} \rangle_{i \in I}: X_U \to \prod_{i \in I} Y_i.
          %h3#ProofViaTaimanovTheoremAndLiftingProperties Proof via Taimanov theorem and lifting properties
          #Taimanov.num_remark
            %h6#remark_3 Remark
            %p
              One can avoid mentioning ultrafilters altogether, at least for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+spaces"} Hausdorff spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Taimanov+theorem"} Taimanov theorem
            %p
              Call a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              %em ultrafilter-like
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              wrt each proper, equivalently closed, map of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+topological+spaces"} finite topological spaces
              %a.existingWikiWord{:href => "/nlab/show/Taimanov+theorem"} Taimanov theorem
              implies that a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              of normal (T4) spaces is
              %a.existingWikiWord{:href => "/nlab/show/proper+maps"} proper
              iff it has the
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋌
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \rightthreetimes g
              against each ultrafilter-like
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Using notation explained just below, this can expressed as follows: The
              %a.existingWikiWord{:href => "/nlab/show/Taimanov+theorem"} Taimanov theorem
              says that a Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is compact iff
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ⟶
                      %mo{:stretchy => "false"} {
                      %mo *
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo ⟶
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo ↘
                      %mi b
                      %mo{:stretchy => "false"} }
                      %msubsup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mo ≤
                          %mn 3
                        %mi r
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi lr
                    %annotation{:encoding => "application/x-tex"} K\longrightarrow \{*\} \,\in\,  (\{\{a\}\longrightarrow \{a{\searrow}b\}\}^r_{\le 3})^{lr}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↔
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↘
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↘
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↙
                    %mi o
                    %mo ↘
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo =
                    %mi o
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mo{:stretchy => "false"} }
                      %mi lr
                  %annotation{:encoding => "application/x-tex"}
                    \\{\, \{a\leftrightarrow b\}\longrightarrow \{a=b\},\, \{a{\searrow}b\}\longrightarrow \{a=b\},\,
                    \\{b\}\longrightarrow \{a{\searrow}b\},\,\{a{\swarrow}o{\searrow}b\}\longrightarrow \{a=o=b\}\,\,\}^{lr}
            %p
              For a property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} {C}
              of arrows (morphisms) in a category, define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi l
                    %mo ≔
                    %mrow
                      %mo {
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo ∀
                        %mrow
                          %mi g
                          %mo ∈
                          %mi C
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mo ⋌
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    C^l \coloneqq \left\{ {f} \colon \underset{g \in C}{\forall}\,{f} \,\rightthreetimes\,  {g} \right\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi r
                    %mo ≔
                    %mrow
                      %mo {
                      %mi g
                      %mo :
                      %munder
                        %mo ∀
                        %mrow
                          %mi f
                          %mo ∈
                          %mi C
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mo ⋌
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo }
                  %annotation{:encoding => "application/x-tex"} C^r \coloneqq \left\{ {g} : \underset{f \in C}{\forall}\,{f} \,\rightthreetimes\,  {g} \right\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi lr
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi l
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi r
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                  %annotation{:encoding => "application/x-tex"} C^{lr} \coloneqq (C^l)^r, ...
            %p
              here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ⋌
                    %mspace{:width => "thinmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \,\rightthreetimes\,  g
              reads “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the left
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              wrt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              ”, “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is (left) orthogonal to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              ”, i.e. for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo ⟶
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A\longrightarrow B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} g:X\longrightarrow Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ⋌
                    %mspace{:width => "thinmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \,\rightthreetimes\, g
              iff for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi A
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i:A\longrightarrow X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi B
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} j:B\longrightarrow Y
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ig
                    %mo =
                    %mi fj
                  %annotation{:encoding => "application/x-tex"} ig=fj
              (“the square commutes”), there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mo :
                    %mi B
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j':B\longrightarrow X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fj
                    %mo ′
                    %mo =
                    %mi i
                  %annotation{:encoding => "application/x-tex"} fj'=i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mi g
                    %mo =
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j'g=j
              (“there is a diagonal making the diagram commute”).
            %p Finally,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mi n
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo :
                    %mi f
                    %mo ∈
                    %mi C
                    %mo ,
                    %mtext both the domain and range of
                    %mi f
                    %mtext are finite of size less or equal than
                    %mspace{:width => "thinmathspace"}
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_{\le n} := \{ {f} : {f} \in {C},\text{ both the domain and range of }f \text{ are finite of size less or equal than }\,n \}.
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↘
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{a\}\longrightarrow \{a{\searrow}b\}
              denotes the inclusion of the open point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              into the Sierpinski space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo ↘
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{a{\searrow}b\}
          %p These observations give rise to the following question.
          #TaimanovQ.num_remark
            %h6#question Question
            %p
              Question. Is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ↘
                    %mi b
                    %mo{:stretchy => "false"} }
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ≤
                        %mn 4
                      %mi r
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi lr
                  %annotation{:encoding => "application/x-tex"} ((\{a\}\longrightarrow \{a{\searrow}b\})^r_{\le 4})^{lr}
              the class of proper maps?
          %p Considerations above show that it is contained in the class of proper maps and that it contains proper maps between normal (T4) spaces (this is what gives the standard proof of the Taimanov theorem).
          %h3#proof_of_converses Proof of converses
          %p
            Now we will prove that Tychonoff’s theorem implies the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          %p
            %strong> Tychonoff’s theorem implies axiom of choice
            \: let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi X
                    %mi α
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi α
                      %mo ∈
                      %mi A
                %annotation{:encoding => "application/x-tex"} \{X_\alpha\}_{\alpha \in A}
            be a family of nonempty sets. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi α
                %annotation{:encoding => "application/x-tex"} Y_\alpha
            be obtained by adjoining a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi α
                  %annotation{:encoding => "application/x-tex"} X_\alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi α
                %annotation{:encoding => "application/x-tex"} Y_\alpha
            by taking the nontrivial open sets to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi α
                %annotation{:encoding => "application/x-tex"} X_\alpha
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{p\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi α
                %annotation{:encoding => "application/x-tex"} Y_\alpha
            is compact; assuming Tychonoff,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi α
                  %msub
                    %mi Y
                    %mi α
                %annotation{:encoding => "application/x-tex"} Y = \prod_\alpha Y_\alpha
            is compact. For each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi α
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo ∈
                  %mi Y
                  %mo :
                  %msub
                    %mi y
                    %mi α
                  %mo ∈
                  %msub
                    %mi X
                    %mi α
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} K_\alpha = \{y \in Y: y_\alpha \in X_\alpha\}
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi α
                %annotation{:encoding => "application/x-tex"} K_\alpha
            is closed, and any finite intersection of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi α
                %annotation{:encoding => "application/x-tex"} K_\alpha
            is nonempty (use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            in all but finitely many components). Hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi α
                  %msub
                    %mi X
                    %mi α
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                    %mi α
                  %msub
                    %mi K
                    %mi α
                %annotation{:encoding => "application/x-tex"} \prod_\alpha X_\alpha = \bigcap_\alpha K_\alpha
          %p is nonempty as well, by compactness. Thus the axiom of choice follows.
          %p
            %strong> Tychonoff’s theorem for Hausdorff spaces implies ultrafilter theorem
            \: let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be a filter on a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is tantamount to a Boolean algebra map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 2
                    %mi X
                  %mo →
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2^X \to 2
            which sends all of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi B
                    %mo =
                    %msup
                      %mn 2
                      %mi X
                    %mo{:stretchy => "false"} /
                    %mi F
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi: B = 2^X/F \to 2
          #nonempty.num_prop
            %h6#proposition Proposition
            %p
              For every (non-terminal) Boolean algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} B \to 2
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
