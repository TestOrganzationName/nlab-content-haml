                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and ultrafilter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi U
                %annotation{:encoding => "application/x-tex"} X_U
            whose underlying set is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⊔
                  %mo{:stretchy => "false"} {
                  %mn ∞
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} X \sqcup \{\infty\}
            (adjoin an extra point
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⊔
                  %mo{:stretchy => "false"} {
                  %mn ∞
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} X \sqcup\{\infty\}
            is open iff it either does not contain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
