          .num_theorem
            %h6#theorem_bourbaki Theorem (Bourbaki)
            %p
              A map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g: Y \to Z
              is
              %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper
              if and only if it has the
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} right lifting property
              with respect to the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi X
                    %mo ↪
                    %msub
                      %mi X
                      %mi U
                  %annotation{:encoding => "application/x-tex"} i: X \hookrightarrow X_U
              for any such pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi U
                    %mo ∈
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, U \in \beta(X))
              (in symbols:
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ⋌
                      %mi g
                    %annotation{:encoding => "application/x-tex"} i \rightthreetimes g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
