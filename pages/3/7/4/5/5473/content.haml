          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#introduction"} Introduction
              %li
                %a{:href => "#reflexive_coequalizers_and_cocompleteness"} Reflexive coequalizers and cocompleteness
              %ul
                %li
                  %a{:href => "#categories_of_algebras_are_barr_exact"} Categories of algebras are Barr exact
                %li
                  %a{:href => "#for_functors_preserving_filtered_colimits"} For functors preserving filtered colimits
                %li
                  %a{:href => "#for_locally_presentable_categories"} For locally presentable categories
              %li
                %a{:href => "#algebraic_functors_have_left_adjoints"} Algebraic functors have left adjoints
              %li
                %a{:href => "#references"} References
          %h2#introduction Introduction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
            denote the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mi C
                    %mi T
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} U: C^T \to C
          %p
            be the usual underlying or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} F: C \to C^T
            %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msub
                      %mn 1
                      %mi C
                    %mo →
                    %mi U
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta: 1_C \to U F
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo :
                    %mi F
                    %mi U
                    %mo →
                    %msub
                      %mn 1
                      %mrow
                        %msup
                          %mi C
                          %mi T
                  %annotation{:encoding => "application/x-tex"} \varepsilon: F U \to 1_{C^T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflects limits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
            is also complete and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+functor"} continuous
          %p
            The situation with regard to colimits is more complicated. It is not generally true that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is cocomplete, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
            is also. (See
            = succeed "," do
              %a{:href => "#AK"} Adámek &amp; Koubek
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Pos"} Pos
          %h2#reflexive_coequalizers_and_cocompleteness Reflexive coequalizers and cocompleteness
          %p
            A simple but basic fact is the following. Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            preserves colimits over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi J
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F: J \to C
            the canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi colim
                    %mi J
                  %mi T
                  %mo ∘
                  %mi F
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi colim
                    %mi J
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} colim_J T \circ F \to T(colim_J F)
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .num_prop
            %h6#proposition Proposition
            %p
              Under these hypotheses,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %msup
                      %mi C
                      %mi T
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U: C^T \to C
              %a.existingWikiWord{:href => "/nlab/show/creates+colimits"} creates colimits
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
          %p
            For a proof, see Proposition 4.3.2 of
            %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
            (Volume 2). In fact, what is shown there is a tighter result: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %mi J
                  %mo →
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} D:J\to C^T
            is any diagram such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∘
                  %mi D
                %annotation{:encoding => "application/x-tex"} U \circ D
            has a colimit preserved by both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ∘
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T \circ T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            has a colimit preserved by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            Here preservation by just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is not sufficient. A counterexample is given by the algebraic theory generated by a 1-ary operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and a 3-ary operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            with the following laws:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(f(x)) = x
              \.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} g(x,x,y) = g(x,y,x) = g(y,x,x) = x
              \.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} g(x,f(x),y) = g(x,y,f(x)) = g(y,x,f(x)) = y
              \.
          %p
            The corresponding monad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Set
                %annotation{:encoding => "application/x-tex"} \mathrm{Set}
            preserves the coproduct
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 + 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 + 1 = 1
          %p
            Here are some sample applications of this proposition which arise frequently in practice. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be the generic
            = succeed "," do
              %em reflexive fork
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0, 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mn 1
                  %mover
                    %mo ⟶
                    %mo ⟶
                  %mn 0
                  %mo ,
                %annotation{:encoding => "application/x-tex"} 0 \to 1 \stackrel{\longrightarrow}{\longrightarrow} 0,
          %p
            and subject to the condition that the two composites from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            are the identity. A colimit over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} T: C \to C
            preserves reflexive coequalizers; in this case, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has reflexive coequalizers, then so does
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
          %p The following very useful observation was first made by Linton.
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is cocomplete and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              has reflexive coequalizers, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              is cocomplete.
          .proof
            %h6#proof Proof
            %p
              First observe that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi ξ
                    %mo :
                    %mi T
                    %mi c
                    %mo →
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c, \xi: T c \to c)
              is a
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              is the coequalizer of the reflexive fork
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mi U
                            %mi c
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi F
                                %mi η
                                %mi U
                                %mi c
                          %mtd
                            %mi F
                            %mi U
                            %mi F
                            %mi U
                            %mi c
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi F
                                  %mi ξ
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi ε
                                  %mi F
                                  %mi U
                                  %mi c
                          %mtd
                            %mi F
                            %mi U
                            %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F U c &amp; \stackrel{F \eta U c}{\longrightarrow} &amp; F U F U c &amp; \stackrel{\overset{\varepsilon F U c}{\longrightarrow}}{\underset{F \xi}{\longrightarrow}} &amp; F U c
                    }
            %p
              To show
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              has coproducts, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi i
                    %mo ,
                    %msub
                      %mi ξ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c_i, \xi_i)
              be a collection of algebras. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi U
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\sum_i U c_i)
              is the coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi F
                    %mi U
                    %msub
                      %mi c
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sum_i F U c_i
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              preserves coproducts and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has them). We have a reflexive fork
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi i
                            %mi F
                            %mi U
                            %msub
                              %mi c
                              %mi i
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mi i
                                %mi F
                                %mi η
                                %mi U
                                %msub
                                  %mi c
                                  %mi i
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi i
                            %mi F
                            %mi U
                            %mi F
                            %mi U
                            %msub
                              %mi c
                              %mi i
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                    %mi i
                                  %mi F
                                  %msub
                                    %mi ξ
                                    %mi i
                              %mover
                                %mo ⟶
                                %mrow
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                    %mi i
                                  %mi ε
                                  %mi F
                                  %mi U
                                  %msub
                                    %mi c
                                    %mi i
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi i
                            %mi F
                            %mi U
                            %msub
                              %mi c
                              %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\sum_i F U c_i &amp; \stackrel{\sum_i F \eta U c_i}{\to} &amp; \sum_i F U F U c_i &amp; \stackrel{\overset{\sum_i \varepsilon F U c_i}{\longrightarrow}}{\underset{\sum_i F \xi_i}{\longrightarrow}} &amp; \sum_i F U c_i
                    }
            %p
              and it is not difficult to show that the coequalizer in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              of this diagram is the coproduct
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi c
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \sum_i c_i
            %p
              Finally, general coequalizers in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              are constructed from coproducts and reflexive coequalizers: given a parallel pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi c
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f, g: c \stackrel{\longrightarrow}{\longrightarrow} d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} C^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is the colimit of the reflexive fork
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
                          %mtd
                            %mo →
                          %mtd
                            %mi c
                            %mo +
                            %mi d
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo ,
                                  %msub
                                    %mn 1
                                    %mi d
                                  %mo{:stretchy => "false"} )
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %msub
                                    %mn 1
                                    %mi d
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    d &amp; \to &amp; c + d &amp; \stackrel{\overset{(f, 1_d)}{\to}}{\underset{(g, 1_d)}{\to}} &amp; d}
            %p where the first arrow is the coproduct coprojection.
          .num_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a monad on a complete and cocomplete category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that preserves reflexive coequalizers, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              is complete and cocomplete.
          %p
            The hypotheses of the preceding corollary hold when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a complete, cocomplete, cartesian closed category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is the monad corresponding to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} finitary algebraic theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msup
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x \mapsto x^n
            preserve reflexive coequalizers if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is cartesian closed.)
          .num_cor
            %h6#corollary_2 Corollary
            %p
              Assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a monad on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
              is cocomplete. Similarly upon replacing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              by a slice
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo ≃
                      %msup
                        %mi Set
                        %mi X
                    %annotation{:encoding => "application/x-tex"} Set/X \simeq Set^X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
          .proof
            %h6#proof_2 Proof
            %p
              It is enough to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
              has coequalizers. Suppose given a pair of algebra maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi A
                    %mover
                      %mo →
                      %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f, g: A \stackrel{\to}{\to} B
              whose coequalizer we wish to construct. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} R = \langle f, g \rangle: A \to B \times B
            %p
              and then let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be the smallest
              = succeed "-congruence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ↪
                      %mi B
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} E \hookrightarrow B \times B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              factors. (This is the intersection of all
              = succeed "-congruences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              factors, and may be calculated in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} Alg
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %msup
                      %mi Set
                      %mi T
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U: Set^T \to Set
              reflects arbitrary intersections.) The coequalizer as calculated in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mi E
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 2
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 1
                          %mtd
                            %mi U
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U E &amp; \stackrel{\overset{U \pi_1}{\longrightarrow}}{\underset{U \pi_2}{\longrightarrow}} &amp; U B &amp; \stackrel{p}{\longrightarrow} &amp; Q
                    }
            %p
              is a split coequalizer, because every quotient of an equivalence relation in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              is a split coequalizer. (This requires the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi Q
                    %mo →
                    %mi U
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i: Q \to U B
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi i
                      %mi p
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi U
                      %mi B
                      %mo →
                      %mi U
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \langle i p, 1 \rangle: U B \to U E
          #split.num_lemma
            %h6#lemma Lemma
            %p
              In a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi E
                    %mo ⇉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2: E \rightrightarrows B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %mi U
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi U
                    %mi E
                    %mo ⇉
                    %mi U
                    %mi B
                  %annotation{:encoding => "application/x-tex"} U\pi_1, U\pi_2: U E \rightrightarrows U B
              has a split coequalizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi B
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} U B \to Q
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2
              has a coequalizer in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              (reflected by the split coequalizer).
          .proof
            %h6#proof_3 Proof
            %p
              (Cf.
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/monadicity+theorem"} monadicity theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              preserves. Hence the top row in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mi U
                            %mi E
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %mi T
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 2
                              %mover
                                %mo →
                                %mrow
                                  %mi T
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 1
                          %mtd
                            %mi T
                            %mi U
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi T
                                %mi p
                          %mtd
                            %mi T
                            %mi Q
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi U
                            %mi E
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 2
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 1
                          %mtd
                            %mi U
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T U E &amp; \stackrel{\overset{T U\pi_1}{\to}}{\underset{T U\pi_2}{\to}} &amp; T U B &amp; \stackrel{T p}{\longrightarrow} &amp; T Q \\
                    \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                    U E &amp; \stackrel{\overset{U\pi_1}{\longrightarrow}}{\underset{U\pi_2}{\longrightarrow}} &amp; U B &amp; \stackrel{p}{\longrightarrow} &amp; Q
                    }
            %p
              (the first two vertical arrows being algebra structure maps) is a coequalizer in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              (i.e., lifts to a coequalizer in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
          %h3#categories_of_algebras_are_barr_exact Categories of algebras are Barr exact
          #exact.num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
              or
              %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact category
              in which regular epimorphisms
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is any monad on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              is a regular category (or exact category, respectively).
          .proof
            %h6#proof_4 Proof
            %p
              For regularity, we first construct coequalizers of kernel pairs in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi E
                    %mo ⇉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2: E \rightrightarrows B
              is the kernel pair of some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f: B \to C
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %mi U
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi U
                    %mi E
                    %mo →
                    %mi U
                    %mi B
                  %annotation{:encoding => "application/x-tex"} U\pi_1, U\pi_2: U E \to U B
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi f
                  %annotation{:encoding => "application/x-tex"} U f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              has a coequalizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi U
                    %mi B
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} q: U B \to Q
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %mi U
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U\pi_1, U\pi_2
              is the kernel pair of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              as well. It follows from the splitting hypothesis that the fork
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mi E
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 2
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi U
                                  %msub
                                    %mi π
                                    %mn 1
                          %mtd
                            %mi U
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi q
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U E &amp; \stackrel{\overset{U\pi_1}{\longrightarrow}}{\underset{U\pi_2}{\longrightarrow}} &amp; U B &amp; \stackrel{q}{\longrightarrow} &amp; Q}
            %p
              splits in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %a.maruku-ref{:href => "#split"}
              this diagram lifts to a coequalizer for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi E
                    %mo ⇉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2: E \rightrightarrows B
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              have coequalizers.
            %p
              That regular epis in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              are stable under pullback follows a similar line of reasoning: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} p: B \to P
              be a regular epi in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo ,
                      %msub
                        %mi π
                        %mn 2
                      %mo :
                      %mi E
                      %mo ⇉
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2: E \rightrightarrows B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi U
                    %mi B
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} q: U B \to Q
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %mi U
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U\pi_1, U\pi_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              lifts to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is identified with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mi p
                    %annotation{:encoding => "application/x-tex"} U p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi p
                  %annotation{:encoding => "application/x-tex"} U p
              is a regular epi in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} f: A \to P
              is a map in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mi p
                  %annotation{:encoding => "application/x-tex"} b = f^\ast p
              is the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (with kernel pair
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ker(b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi b
                  %annotation{:encoding => "application/x-tex"} U b
              is the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi p
                  %annotation{:encoding => "application/x-tex"} U p
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi f
                  %annotation{:encoding => "application/x-tex"} U f
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              preserves pullbacks, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi b
                  %annotation{:encoding => "application/x-tex"} U b
              is a regular epi since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              is regular. This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi b
                  %annotation{:encoding => "application/x-tex"} U b
              is the coequalizer of its kernel pair, and splits, so by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#split"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is the coequalizer of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ker(b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^T
              are stable under pullback.
            %p
              For Barr-exactness, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo :
                    %mi E
                    %mo ⇉
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2: E \rightrightarrows B
              is an equivalence relation (or
              = succeed ")" do
