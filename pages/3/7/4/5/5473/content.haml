                    \&amp; \mathllap{B \otimes f \otimes M} \nearrow &amp; &amp; \searrow \mathrlap{mult_B \otimes M} \\
                    B \otimes A \otimes M &amp; &amp; \stackrel{\; \; \; \; \; \; \; \; B \otimes \alpha_M \; \; \; \; \; \; \; \; }{\longrightarrow} &amp; &amp; B \otimes M,
                    }
            %p
              and so the coequalizer of
              %a.maruku-eqref{:href => "#eq:coeq"} (1)
              will be denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ∘
                      %mi S
