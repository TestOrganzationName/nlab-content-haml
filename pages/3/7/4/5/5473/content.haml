              to underline the analogy.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ∘
                      %mi S
                    %mo −
                  %annotation{:encoding => "application/x-tex"} T \circ_S -
              is the left adjoint, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi α
                    %mo :
                    %mi T
                    %mi d
                    %mo →
                    %mi d
                    %mo{:stretchy => "false"} )
