                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories+of+spans"} (∞,n)-categories of spans
            and of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-vector+spaces"} (∞,n)-vector spaces
          %p
