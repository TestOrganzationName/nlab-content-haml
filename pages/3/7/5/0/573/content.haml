            %li
              %p
                by iterated
                %a.existingWikiWord{:href => "/nlab/show/category+object+in+an+%28%E2%88%9E%2C1%29-category"} (∞,1)-internalization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
