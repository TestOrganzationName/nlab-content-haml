                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n-1)
          %ul
            %li
              %a{:href => "#ViaInternalization"}> Definitions via internalization
              \.
          %h3#AxiomaticCharacterization
            Via generation by strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            We discuss a characterization of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/strict+n-categories"} strict n-categories
            = succeed ")." do
              %a{:href => "#BarwickSchommerPries"} Barwick, Schommer-Pries
          %p
            The blueprint for the following construction is the traditional fact that a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            is characterized by the fact that its
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            which satisfies the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
            %a.existingWikiWord{:href => "/nlab/show/total+order"} linear categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo →
                  %mn 1
                  %mo →
                  %mn 2
                  %mo →
                  %mi ⋯
                  %mo →
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \Delta[n] = \{0 \to 1 \to 2 \to \cdots \to n\}
            this can be taken as saying that these linear categories
            %em generate
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
