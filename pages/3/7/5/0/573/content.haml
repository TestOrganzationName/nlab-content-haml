                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
          %p
            (
            %a{:href => "#BarwickSchommerPries"}> B-SP, theorem 8.13
            )
          .num_remark
            %h6#remark_9 Remark
            %p This means that
            %ol
              %li
                %p
                  the
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cat
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cat_{(\infty,n)}
                  from def.
                  %a.maruku-ref{:href => "#AxiomaticDefinition"}
                  is uniquely defined, up to
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cat
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cat_{(\infty,n)}
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi Cat
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat Cat_{(\infty,1)}
                  is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℤ
                            %mn 2
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi n
                        %annotation{:encoding => "application/x-tex"} (\mathbb{Z}_2)^n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  analogs of forming an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
          .proof
            %h6#proof_2 Proof
            %p The idea is this:
            %p
              One first observes that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                  %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
              from def.
              %a.maruku-ref{:href => "#GauntStrictNCategories"}
              has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ×
                        %mi n
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}_2)^{\times n}
              worth of automorphisms, given by reversing the directions of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            %p For this,
            %ol
              %li
                %p
                  observe that the identity is the only
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                  on
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Id
                          %mo :
                          %mi Str
                          %mi n
                          %msub
                            %mi Cat
                            %mi gaunt
                          %mo →
                          %mi Str
                          %mi n
                          %msub
                            %mi Cat
                            %mi gaunt
                        %annotation{:encoding => "application/x-tex"} Id : Str n Cat_{gaunt} \to Str n Cat_{gaunt}
                  %a.existingWikiWord{:href => "/nlab/show/globes"} globes
                  for which one observes that if a functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi n
                        %mo →
                        %msub
                          %mi G
                          %mi n
                      %annotation{:encoding => "application/x-tex"} G_n \to G_n
                  is the identity on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∂
                          %msub
                            %mi G
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \partial G_n
                  = succeed "-cell." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed ")" do
                    %a{:href => "#BarwickSchomerPries"} B-SP, lemma 4.1
              %li
                %p
                  observe that every autoequivalence of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Str
                        %mi n
                        %msub
                          %mi Cat
                          %mi gaunt
                      %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
                  restricts to one on the
                  %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_n
                  (
                  %a{:href => "#BarwickSchomerPries"}> B-SP, lemma 4.4
                  ).
              %li
                %p
                  observe that the only autoequivalences of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_n
                  are those that reverse the direction of the
                  = succeed "-morphisms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi k
                          %mo ≠
                          %mi n
                        %annotation{:encoding => "application/x-tex"} 1 \leq k \neq n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Str
                        %mi n
                        %msub
                          %mi Cat
                          %mi gaunt
                      %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
                  (
                  %a{:href => "#BarwickSchomerPries"}> B-SP, lemma 4.5
                  ).
            %p
              Now us that, by the
              = succeed "," do
                %a{:href => "#Generators"} above discussion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                  %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
              generates all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat_{(\infty,n)}
              under
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
          %h3#WebOfQuillenEquivalences Web of Quillen equivalent model category presentations
