                %a.existingWikiWord{:href => "/nlab/show/weak+omega-category"} weak omega-category
                for which all
                %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \gt n
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
          %p
            Accordingly, the notion of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            = succeed "," do
