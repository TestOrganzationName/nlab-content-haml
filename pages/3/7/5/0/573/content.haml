            (
            %a{:href => "#Lurie"}> Lurie, prop. 1.1.14
            ).
          #IteratedInternalization.num_defn
            %h6#definition_11 Definition
            %p
              An
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi PreCat
                      %mrow
                        %mi Grpd
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Cat
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in PreCat_{Grpd(Cat_{(\infty,0)})}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mn ∞
                      %mi Grpd
                      %mo ↪
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Core(X) \in \infty Grpd \hookrightarrow Grpd(Cat_{(\infty,0)})
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi 𝒩
                  %annotation{:encoding => "application/x-tex"} n \in \mathcal{N}
              the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi Cat
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cat_{(\infty,n)}
                    \\coloneqq
                    Cat^n(\infty Grpd)
                    \\coloneqq
                    Cat(\cdots Cat(Cat_{(\infty,0)}) \cdots)
                    \\,.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, prop. 1.1.14
            ).
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
