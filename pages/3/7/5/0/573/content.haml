                    %annotation{:encoding => "application/x-tex"} n \geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cSegal
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
