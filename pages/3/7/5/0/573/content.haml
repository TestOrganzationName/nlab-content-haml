          %h3#moduli Moduli
          #AutomorphismInfinityGroup.num_prop
            %h6#proposition_13 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
