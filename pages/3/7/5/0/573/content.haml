                  %annotation{:encoding => "application/x-tex"} (\infty,n)
              \-category
            may be thought of as
          %ul
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/n-category"} n-category
                up to
                %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (r,n)-category
                for
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo =
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} r = \infty
            %li
              %p
