            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/3-categories"} 3-categories
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/4-categories"} 4-categories
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            \/
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            they are a generalization to
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+theory"} directed homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            they are a generalization to
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+type+theory"} directed homotopy type theory
          %p
            There are two main
            %a.existingWikiWord{:href => "/nlab/show/recursion"} recursive
            definitions of
            = succeed "-categories:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          %ol
            %li
              %p
                by iterated
                %a.existingWikiWord{:href => "/nlab/show/enriched+%28%E2%88%9E%2C1%29-category"} (∞,1)-enrichment
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cat
