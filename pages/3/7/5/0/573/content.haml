                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cat^n(\infty Grpd)
          .num_prop
            %h6#proposition_9 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
