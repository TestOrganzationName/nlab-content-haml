                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat_{(\infty,n)}
            itself, as something
            %em
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+n-categories"} strict n-categories
          %p
            Then there is also a plethora of
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structures that
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} present
            the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cat_{(\infty,n)}
            of all
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          %p
            A central result of
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            %em
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+with+duals"} with duals
            and provides deep relations between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extended+topological+quantum+field+theory"} extended topological quantum field theory
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
