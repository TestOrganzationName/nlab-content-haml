          %h2#Idea Idea
          %p
            The standard abelian form of
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            5 is the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            with a single abelian (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = \mathrm{U}(1)
            )
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (locally a
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            with
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo ≔
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %annotation{:encoding => "application/x-tex"} F_A \coloneqq \mathrm{d}A
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            proportional to
          #eq:LagrangianDensityFor5dAbelianChernSimons.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi L
                    %mi CS
                    %mrow
                      %mn 5
                      %mi D
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L_{CS}^{5D}(A) \;\propto\; A \wedge F_A \wedge F_A
                  \\,.
          %p
            One way this appears is as a “topological mass” term to
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+theory"} Maxwell theory
            in 5D:
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 4
                %annotation{:encoding => "application/x-tex"} Y^{1,4}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} dim
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi Y
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 4
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo =
                      %mn 5
                    %annotation{:encoding => "application/x-tex"} \mathrm{dim}\big(Y^{1,4}\big) = 5
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
          #eq:HodgeStarOnSpacetimeDomain.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋆
                    %mrow
                      %msub
                        %mrow
                        %mi Y
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Y
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 4
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mrow
                      %mn 5
                      %mo −
                      %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Y
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 4
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\star_{{}_Y}
                  \\;\colon\;
                  \\Omega^\bullet_{dR}\big(
                  Y^{1,4}
                  \\big)
                  \\longrightarrow
                  \\Omega^{5-\bullet}_{dR}\big(
                  Y^{1,4}
                  \\big)
                  \\,,
          %p
            the Lagrangian density of
            %em
              5D
              %a.existingWikiWord{:href => "/nlab/show/Maxwell-Chern-Simons+theory"} Maxwell-Chern-Simons theory
            is proportional to
          #eq:LagrangianDensityFor5dMaxwellChernSimons.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi L
                    %mi MCS
                    %mrow
                      %mn 5
                      %mi D
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mo ⋆
                    %mn 5
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi c
                      %mn 3
                  %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  L_{MCS}^{5D}(A)
                  \\;\propto\;
                  \\tfrac{1}{2}
                  F_A \wedge \star_5 F_A
                  \\;-\;
                  \\tfrac{c}{3}
                  A \wedge F_A \wedge F_A
                  \\,,
          %p
            for some relative prefactor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
          %p
            This appears notably in the
            %a.existingWikiWord{:href => "/nlab/show/bosonic+field"} bosonic sector
            of minimal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+supergravity"} D=5 supergravity
            = succeed "-Chern-Simons" do
              %a.existingWikiWord{:href => "/nlab/show/Einstein-Maxwell+theory"} Einstein-Maxwell
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of 5D Chern-Simons-Maxwell theory
            %a.maruku-eqref{:href => "#eq:LagrangianDensityFor5dMaxwellChernSimons"} (3)
            are (setting
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c=1
          #eq:EoMof5dMCS.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi F
                            %mn 2
                        %mtd
                          %mo =
                          %mn 0
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mo ⋆
                            %mrow
                              %msub
                                %mrow
                                %mi Y
                          %msub
                            %mi F
                            %mn 2
                        %mtd
                          %mo =
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %msub
                            %mi F
                            %mn 2
                          %mo ∧
                          %msub
                            %mi F
                            %mn 2
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathrm{d}\, F_2 &amp; = 0
                  \\mathrlap{\,,}
                  \\\
                  \\mathrm{d}\, \star_{{}_Y} F_2
                  \&amp; =
                  \\tfrac{1}{2}
                  F_2 \wedge F_2
                  \\mathrlap{\,.}
                  \\end{aligned}
          %p
            These are like
            %a.existingWikiWord{:href => "/nlab/show/Maxwell%27s+equations"} Maxwell's equations
            where an
            %a.existingWikiWord{:href => "/nlab/show/electric+current"} electric current
            is sourced by the gauge field itself.
          %p
            The structure of the these equations of motion is, up to dimension and form degree, the same as that of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            (cf. references
            = succeed ")." do
              %a{:href => "D%3D5+supergravity#ReferencesViaMTheoryOnCY3Folds"} here
          %h2#properties Properties
          %h3#DimReductionOf5dMaxwellCSTo3D Dimensional reduction of 5D Maxwell-Chern-Simons to 3D
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/dimensional+reduction"} dimensional reduction
            of the 5D Maxwell-Chern-Simons equations of motion
            %a.maruku-eqref{:href => "#eq:EoMof5dMCS"} (4)
            to 3D, specifically:
          %p
            Consider the case that the
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 4
                %annotation{:encoding => "application/x-tex"} Y^{1,4}
            is a
            %a.existingWikiWord{:href => "/nlab/show/product+manifold"} product manifold
            (with product
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metric
          #eq:DimRedSpacetime.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 4
                  %mo =
                  %msup
                    %mi X
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 2
                  %mo ×
                  %msup
                    %mi L
                    %mn 1
                  %mo ×
                  %msup
                    %mi V
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Y^{1,4}
                  \=
                  X^{1,2} \times L^1 \times V^1
                  \\,,
          %p of:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} X^{1,2}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi X
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo =
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} dim\big(X^{1,2}\big) = 3
            %li
              %p
                1-dimensional
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifolds"} Riemannian manifolds
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} L^1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V^1
                (not necessarily
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                or
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %p
                which in suitable
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                have metrics
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi g
                                %mi L
                            %mtd
                              %mo =
                              %msubsup
                                %mi ℓ
                                %mi l
                                %mn 2
                              %mi{:mathvariant => "normal"} d
                              %mi l
                              %mo ⊗
                              %mi{:mathvariant => "normal"} d
                              %mi l
                          %mtr
                            %mtd
                              %msub
                                %mi g
                                %mi V
                            %mtd
                              %mo =
                              %msubsup
                                %mi ℓ
