                    \\tfrac{1}{2}
                    \\underset{ =0 }{
                    \\underbrace{
                    F_2^{(X X)} \wedge F_2^{(X X)}
                    }}
                    \\mathrlap{\,,}
                    \\end{aligned}
            %p where the terms over the brace vanish by degree reasons.
            %p
              In the limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi v
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \ell_v \to 0
              the first equation in
              %a.maruku-eqref{:href => "#eq:SecondEoMInKKComponents"} (9)
              goes to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi F
                              %mn 2
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo →
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %msubsup
                                    %mi F
                                    %mn 0
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mi l
                                      %mi v
                                      %mo{:stretchy => "false"} )
                            %msubsup
                              %mi F
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mi l
                                %mo{:stretchy => "false"} )
                            %mo ∧
                            %msubsup
                              %mi F
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mi v
                                %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F_2^{(X X)}
                    \\;\to\;
                    \-
                    \\tfrac{1}{F_0^{(l v)}}
                    F_1^{(X l)} \wedge F_1^{(X v)}
                    \\end{aligned}
            %p
              and thus implies the vanishing of the right hand sides of the second and third equations in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:SecondEoMInKKComponents"} (9)
              %a.maruku-eqref{:href => "#eq:SecondEoMInKKComponents"} (9)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mo ⋆
                      %mi X
                    %msubsup
                      %mi F
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo →
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}_X \big( \star_X F_1^{(X v)} \big)
                    \\;\to\;
                    0
                    \\,.
            %p
              Finally, the first equation of motion
              %a.maruku-eqref{:href => "#eq:EoMof5dMCS"} (4)
              says that the component forms
              %a.maruku-eqref{:href => "#eq:DimRedDecompositionOfFluxDensity"} (6)
              are closed. The closure of the 0-form component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mn 0
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi l
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_0^{(l v)}
              means that it is locally constant, and the closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_1^{(X -)}
              implies that of their wedge product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi F
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mi X
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_2^{(X X)}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:5DMCSEoMdimReducedTo3D"} (8)
          %p
