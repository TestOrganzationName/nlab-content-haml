                                %mn 2
                              %mi{:mathvariant => "normal"} d
                              %mi v
                              %mo ⊗
                              %mi{:mathvariant => "normal"} d
                              %mi v
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      g_L &amp; = \ell_l^2 \mathrm{d}l \otimes \mathrm{d}l
                      \\\
                      g_V &amp; = \ell_v^2 \mathrm{d}v \otimes \mathrm{d}v
                      \\end{aligned}
                for
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi l
                        %mo ,
                        %mi v
                        %mo ∈
                        %msub
                          %mi ℝ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} l,v \in \mathbb{R}_+
          %p
            and that the
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            is constant along the fibers, in that
