            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g(c_1)
            is not the identity, let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
