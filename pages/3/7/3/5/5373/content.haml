          %h2#examples Examples
          %p
          #ReractiveSpaces.num_remark
            %h6 Example
            %p
              %strong (spaces among retractive spaces)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be the category of
              %a.existingWikiWord{:href => "/nlab/show/retractive+space"} retractive
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (or just of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (
              %a.existingWikiWord{:href => "/nlab/show/Set"}> Set
              ) of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mover
                      %mo →
                      %mi i
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \xrightarrow{i} E \xrightarrow{p} B
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi id
                        %mi B
                    %annotation{:encoding => "application/x-tex"} p \circ i \,=\, id_B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Top
                        %mtd
                          %mo ↪
                        %mtd
                          %msub
                            %mi Top
                            %mi ℛ
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mi B
                          %mover
                            %mo →
                            %mi id
                          %mi B
                          %mover
                            %mo →
                            %mi id
                          %mi B
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    Top &amp;\hookrightarrow&amp; Top_{\mathcal{R}}
                    \\\
                    B &amp;\mapsto&amp; \big[ B \xrightarrow{id} B \xrightarrow{id} B \big]
                    \\end{array}
            %p
              is a bireflective subcategory inlusion (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BireflectiveSubcategory"}
              %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjoint"} ambidextrous adjoint
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi Top
                            %mi ℛ
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Top
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mi B
                          %mover
                            %mo →
                            %mi i
                          %mi E
                          %mover
                            %mo →
                            %mi p
                          %mi B
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    Top_{\mathcal{R}} &amp;\longrightarrow&amp; Top
                    \\\
                    \\big[
                    B \xrightarrow{i} E \xrightarrow{p} B
                    \\big]
                    \&amp;\mapsto&amp;
                    B
                    \\end{array}
            %p
          %p
          #ZeroVectorBundlesAmongVectorBundles.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/zero-vector+bundles"} zero-vector bundles
                among all
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              %br/
              For any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mo ≔
                    %msub
                      %mi Vect
                      %mi Set
                    %mo ≔
                    %msub
                      %mo ∫
                      %mrow
                        %mi S
                        %mo ∈
                        %mi Set
                    %mi Vect
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{B} \coloneqq Vect_{Set} \coloneqq \int_{S \in Set} Vect S
              be the category
              %a.existingWikiWord{:href => "/nlab/show/VectBund"} VectBund
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mover
                      %mo ↪
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Set \xhookrightarrow{\;\; 0 \;\;} Vect_{Set}
            %p
              which sends any set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the
              %a.existingWikiWord{:href => "/nlab/show/zero+vector+bundle"} zero vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S \times \{0\}
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a bireflective subcategory in the sense of Def.
              = succeed "." do
                %a.maruku-ref{:href => "#BireflectiveSubcategory"}
          %p
          #ZeroSpectrumBundlesAmongSpectrumBundles.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/zero-spectrum+bundles"} zero-spectrum bundles
                among all
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} T Grpd_\infty
              denote the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category
              of
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
              over varying
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids
              (the
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28infinity%2C1%29-category"}
                tangent
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Grpd
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} Grpd_\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mn ∞
                    %mo ↪
                    %mi T
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    Grpd_\infty \hookrightarrow T Grpd_\infty
            %p
              given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} X \in Grpd_\infty
              to the
              %a.existingWikiWord{:href => "/nlab/show/zero-spectrum+bundle"} zero-spectrum bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ought to count as a “bireflective
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/sub-%28infinity%2C1%29-category"}
                  sub-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-category
              %a{:href => "https://ncatlab.org/nlab/show/infinitesimal+cohesion#GoodwillieTangentCohesion"} here
              at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
            %p
              A
              = succeed "-presentation" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
              to a
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+parameterized+spectra"} model structure for parameterized spectra
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              which is a bireflective sub-1-category inclusion (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BireflectiveSubcategory"}
              = succeed "," do
                %a{:href => "model+structure+for+parameterized+spectra#HebestreitSagaveSchlichtkrull20"} Hebestreit, Sagave &amp; Schlichtkrull (2020), Lem. 3.19
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒮
                      %mi ℐ
                    %mo ↪
                    %msubsup
                      %mi Sp
                      %mi ℛ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}^{\mathcal{I}}
                    \\hookrightarrow
                    Sp^{\Sigma}_{\mathcal{R}}
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/I-spaces"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}
                \-spaces
              into
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
              %a.existingWikiWord{:href => "/nlab/show/retractive+spaces"} retractive spaces
              (Exp.
              = succeed ")." do
                %a.maruku-ref{:href => "#ReractiveSpaces"}
            %p
              An analogous statement is in
              = succeed "." do
                %a{:href => "model+structure+for+parameterized+spectra#BraunackMayer19"} Braunack-Mayer (2019), Cor. 2.45
