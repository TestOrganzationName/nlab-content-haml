                            %mo ♮
                            %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\natural_\Gamma
                    \\left[
                    \\begin{array}{c}
                    A
                    \\\
                    \\big\downarrow \mathrlap{\!\! {}^{p_A} }
                    \\\
                    \\Gamma
                    \\end{array}
                    \\;\;\;\;
                    \\right]
                    \\;\;\coloneqq\;\;
                    \\big(\eta^\natural_\Gamma\big)^\ast
                    \\,\natural\,
                    \\left[
                    \\begin{array}{c}
                    \\natural A
                    \\\
                    \\big\downarrow \mathrlap{\!\! {}^{\natural p_A} }
                    \\\
                    \\natural \Gamma
                    \\end{array}
                    \\;\;\;\;
                    \\right]
            %p
          %p
          #OdditiesOfTheRFLSyntax.num_remark
            %h6 Remark
            %p
              Beware of some non-obvious properties of the following type-theoretic
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
            %ol
              %li
                %p
                  There is an asymmetry in the meaning of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mo ̲
                        %annotation{:encoding => "application/x-tex"} \underline{(-)}
                %p
                  An underline of a context denotes application of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ♮
                        %annotation{:encoding => "application/x-tex"} \natural
                  %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ϵ
                            %mo ♮
                        %annotation{:encoding => "application/x-tex"} \epsilon^{\natural}
                  %em dependency
                  on
                  = succeed "-modal" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ♮
                        %annotation{:encoding => "application/x-tex"} \natural
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ♮
                        %annotation{:encoding => "application/x-tex"} \natural
                  %a.existingWikiWord{:href => "/nlab/show/modal+type"} modal
                  or not.
              %li
                %p
                  The syntactic symbol “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ♮
                      %annotation{:encoding => "application/x-tex"} \natural
                  ” is not exactly
                  %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interpreted
                  as the bireflective monad of that name. Rather:
                %ul
                  %li
                    %p
                      An unadorned “
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mo ♮
                          %annotation{:encoding => "application/x-tex"} \natural
                      ” in the syntax
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interprets
                      %a.existingWikiWord{:href => "/nlab/show/context"} context
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Γ
                            %annotation{:encoding => "application/x-tex"} \Gamma
                      %a.existingWikiWord{:href => "/nlab/show/relative+monad"} relative monad
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} classical
                              %mi Γ
                              %mi rel
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ℬ
                                      %mrow
                                        %mo{:stretchy => "false"} /
                                        %mo ♮
                                        %mi Γ
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %mo{:stretchy => "false"} (
                                        %msubsup
                                          %mi η
                                          %mi Γ
                                          %mo ♮
                                        %msup
                                          %mo{:stretchy => "false"} )
                                          %mo *
                                  %mtd
                                    %msub
                                      %mi ℬ
                                      %mrow
                                        %mo{:stretchy => "false"} /
                                        %mi Γ
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mo ♮
                                          %mi Γ
                                  %mtd
                                    %msub
                                      %mi ℬ
                                      %mrow
                                        %mo{:stretchy => "false"} /
                                        %mi Γ
                          %annotation{:encoding => "application/x-tex"}
                            \\classical^{rel}_\Gamma
                            \\;\;
                            \\colon
                            \\;\;
                            \\array{
                            \\mathcal{B}_{/\natural \Gamma}
                            \&amp;
                            \\xrightarrow{
                            (\eta^\natural_\Gamma)^\ast
                            }
                            \&amp;
                            \\mathcal{B}_{/\Gamma}
                            \&amp;
                            \\xrightarrow{
                            \\natural_\Gamma
                            }
                            \&amp;
                            \\mathcal{B}_{/\Gamma}
                            }
                  %li
                    %p
                      The combination
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ♮
                            %munder
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                              %mo ̲
                          %annotation{:encoding => "application/x-tex"} \natural \underline{(-)}
                      is what actually
                      %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interprets
                      as
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo ♮
                              %mi Γ
                          %annotation{:encoding => "application/x-tex"} \natural_\Gamma
                      = succeed "." do
                        %a.maruku-eqref{:href => "#eq:TheMonadOnSlices"} (2)
                    %p
                      This transpires syntactically in
                      = succeed ";" do
                        %a{:href => "#RFL21"} RFL21, Cor. 2.14
                      = succeed "," do
                        %a{:href => "#Riley22"} Riley22, Cor. 1.1.16
                      %a.maruku-eqref{:href => "#eq:InternalUnitConstruction"} (3)
                      below.
            %p
          %p
            %br/
          %p
            The list of
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            and their
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            (first the
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            then derived rules):
          %center
            %img{:src => "/nlab/files/BireflectiveTypesStructureRules-230327.jpg", :width => "690"}/
          %center
            %img{:src => "/nlab/files/BireflectiveModalityInferenceRules-230327.jpg", :width => "690"}/
          %center
            %img{:src => "/nlab/files/BireflectiveModalityComputationRules-230327b.jpg", :width => "690"}/
          %p
            Using these ingredients, one finds that the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo ↦
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %munder
                      %mi a
                      %mo ̲
                    %mo ♮
                %annotation{:encoding => "application/x-tex"} a \,\mapsto\, \underline{a}^\natural
            is interpreted simply as postcomposition with the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mo ♮
                  %annotation{:encoding => "application/x-tex"} \eta^{\natural}
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
          %p
            %br/
          %p
            %br/
          #eq:InternalUnitConstruction.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  \\;
          %center
            %div{:style => "margin:-130px 10px 10px 0;"}
              %img{:src => "/nlab/files/BireflectiveModalityUnitDefinition-230304b.jpg", :width => "690"}/
          %p
            With this, one finds the following rule for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♮
                %annotation{:encoding => "application/x-tex"} \natural
            respecting
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+pair+types"} dependent pair types
          %p
            %br/
          %p
            %br/
          #eq:NaturalRespectsDependentPairs.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  \\;
          %center
            %div{:style => "margin:-130px 10px 10px 0;"}
              %img{:src => "/nlab/files/BireflectiveModalityRespectForPairs-230404b.jpg", :width => "690"}/
          %p
            Using this one finds that every type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            of its fiber
            %a.existingWikiWord{:href => "/nlab/show/linear+types"} linear types
