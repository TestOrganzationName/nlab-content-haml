              the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              of the right adjunction followed by the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              of the left adjunction (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} points-to-pieces transform
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity
