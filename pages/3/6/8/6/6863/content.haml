          %h2#selected_writings Selected writings
          %p
            Introducing what came to be called the
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Nicolai+map"} Nicolai map
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
                ,
                = succeed "," do
                  %em On a new characterization of scalar supersymmetric theories
                %strong 89
                3–4 (1980) Pages 341-346 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0370-2693(80)90138-0"}> doi:10.1016/0370-2693(80)90138-0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
                ,
                = succeed "," do
                  %em Supersymmetry and functional integration measures
              %p
                %strong 176
                2 (1980) 419-428 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0550-3213(80)90460-5"}> doi:10.1016/0550-3213(80)90460-5
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
                ,
                = succeed "," do
                  %em Supersymmetric functional integration measures
                = succeed "&rbrack;" do
                  %a{:href => "https://cds.cern.ch/record/155731"} cds:155731
          %p
            Early (first?) discussion of
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+supergravity"} D=5 supergravity
            and its
            %a.existingWikiWord{:href => "/nlab/show/dimensional+reduction"} dimensional reduction
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(2)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D4+supergravity"} D=4 supergravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ali+Chamseddine"}> Ali Chamseddine
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em
                    Coupling the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(2)
                    Supergravity Through Dimensional Reduction
                %strong 96
                1–2 (1980) 89-93 [
                %a{:href => "https://doi.org/10.1016/0370-2693(80)90218-X"}> doi:10.1016/0370-2693(80)90218-X
                ,
                = succeed "]" do
                  %a.existingWikiWord{:href => "/nlab/files/ChamseddineNicolai-SU2SuGra.pdf", :title => "pdf"} pdf
              %p
                %em>
                  Corrigendum to “Coupling the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(2)
                  supergravity through dimensional reduction” [Phys. Lett. B 96 (1-2) (1980) 89-93]
                , Phys. Lett. B
                %strong 785
                (2018) 631-632 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1808.08955"}> arXiv:1808.08955
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.physletb.2018.05.029"} doi:10.1016/j.physletb.2018.05.029
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/singleton+representation"} singleton representations
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orthosymplectic+super+Lie+algebra"} orthosymplectic super Lie algebra
          %ul
            %li#NicolaiSezgin84
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %em
                  Singleton representations of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Osp
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo ,
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Osp(N,4)
              %strong 143
              4-6 (1984) 389-395
          %p
            Realizing
            %a.existingWikiWord{:href => "/nlab/show/local+symmetry"} local
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 8
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{su}(8)
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            symmetry of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bernard+de+Wit"}> Bernard de Wit
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em
                    D = 11 Supergravity With Local
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 8
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(8)
                    Invariance
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/0550-3213(86)90290-7"} doi:10.1016/0550-3213(86)90290-7
                = succeed "&rbrack;" do
                  %a{:href => "http://inspirehep.net/record/227409"} spire:227409
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bernard+de+Wit"}> Bernard de Wit
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
                = succeed "," do
                  %em
                    Local SU(8) invariance in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} d = 11
                    supergravity
                = succeed "," do
                  %em
                    %a{:href => "https://inspirehep.net/conferences/966045"} Nuffield Workshop on Supersymmetry and its Applications
                = succeed "&rbrack;" do
                  %a{:href => "http://inspirehep.net/record/218601"} spire:218601
          %p
            Realizing
            %a.existingWikiWord{:href => "/nlab/show/local+symmetry"} local
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mn 18
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{so}(18)
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            symmetry of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"}> Hermann Nicolai
              \:
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 11
                      %annotation{:encoding => "application/x-tex"} d=11
                  Supergravity with local
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 16
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(16)
                  invariance
              %strong 187
              3–4 (1987) 316-320 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0370-2693(87)91102-6"}> doi:10.1016/0370-2693(87)91102-6
              \&amp;rbrack;
          %p
            On
            = succeed ":" do
