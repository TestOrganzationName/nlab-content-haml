                        %mi y
                        %mo ∨
                      %annotation{:encoding => "application/x-tex"} \backslash y\dashv y\vee
                  _ and the existence of a left adjoint implies that
                  = succeed "_" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
