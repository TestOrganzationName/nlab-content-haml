                        %annotation{:encoding => "application/x-tex"} y\vee
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∧
                      %annotation{:encoding => "application/x-tex"} \wedge
