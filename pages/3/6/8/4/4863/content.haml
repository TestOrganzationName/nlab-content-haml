                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                  %mi R
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  g_{X \times F}
                  \\;\mapsto\;
                  S_{EH}(g_{X \times F})
                  \\;\coloneqq\;
                  \\int_{X \times F} R(g_{X \times F}) \, dvol(g_{X \times F})
          %p
            when restricted to
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metrics"} pseudo-Riemannian metrics
            of the special form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %msubsup
                      %mi g
                      %mrow
                        %mi X
                        %mo ×
                        %mi F
                      %mi KK
                    %mrow
                      %mo (
                      %mi x
                      %mo ,
                      %mi f
                      %mo )
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Sym
                    %mn 2
                  %mrow
                    %mo (
                    %mi Γ
                    %mrow
                      %mo (
                      %msup
                        %mi T
                        %mo *
                      %mi X
                      %mo ×
                      %mi F
                      %mo )
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi g
                              %mi F
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi A
                              %mi a
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi k
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi A
                              %mi a
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi k
                              %mi a
                          %mtd
                            %msub
                              %mi g
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left(g^{KK}_{X \times F} \left(x,f\right) \right)
                  \\;\in \;
                  Sym^2\left(\Gamma\left(T^* X \times F\right)\right)
                  \\;=\;
                  \\left(
                  \\array{
                  g_F(f) &amp; A^a(x)k_a
                  \\\
                  A^a(x) k_a &amp; g_X(x)
                  }
                  \\right)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi k
                    %mi a
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{k_a \in \Gamma(T F)\}
            are a
            %a.existingWikiWord{:href => "/nlab/show/basis"} basis
            for the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Killing+vector+field"} Killing vector field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %msub
                      %mi g
                      %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F,g_F)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi EH
                  %mrow
                    %mo (
                    %msubsup
                      %mi g
                      %mrow
                        %mi X
                        %mo ×
                        %mi F
                      %mi KK
                    %mo )
                  %mo =
                  %msub
                    %mi S
                    %mi EH
                  %mrow
                    %mo (
                    %msub
                      %mi g
                      %mi X
                    %mo )
                  %mo +
                  %msub
                    %mi S
                    %mi YM
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi S
                    %mi mod
                  %mrow
                    %mo (
                    %msub
                      %mi g
                      %mi F
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S_{EH}\left(g^KK_{X \times F}\right)
                  \=
                  S_{EH}\left(g_X\right) + S_{YM}(A) + S_{mod}\left(g_F\right)
                  \\,,
          %p where
          %ul
            %li
              %p
                the first term is the
                %a.existingWikiWord{:href => "/nlab/show/Einstein-Hilbert+action"} EH action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi X
                    %annotation{:encoding => "application/x-tex"} g_X
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                and the second term is the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                of
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
                for the
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+1-form"} Lie algebra-valued 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                with values in the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                of the
                %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo ,
                        %msub
                          %mi g
                          %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (F,g_F)
            %li
              %p
                and finally the last term is regarded as a
                %a.existingWikiWord{:href => "/nlab/show/functional"} functional
                on the
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
                of this ansatz: the
                %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+Riemannian+metrics"} moduli space of Riemannian metrics
                on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
          %p
            More generally, one observes that the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
            transformation of
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metrics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                %annotation{:encoding => "application/x-tex"} g_{X \times F}
            of the above form under
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            generated by a
            %a.existingWikiWord{:href => "/nlab/show/Killing+vector+field"} Killing vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msup
                    %mi λ
                    %mi a
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi k
                    %mi a
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,f) \mapsto \lambda^a(x) k_a(f)
            is given on the
            = succeed "-component" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi ϵ
                  %mi A
                  %mo =
                  %msub
                    %mi d
                    %mi X
                  %msup
                    %mi λ
                    %mi a
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi λ
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{d}{d \epsilon} A  = d_X \lambda^a + [\lambda,A]
                  \\,.
          %p
            This is the infinitesimal form of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra-valued+forms"} groupoid of Lie algebra-valued forms
            %em every
            functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi S
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (g_{X \times F}) \mapsto S(g_{X\times F})
            that is invariant under
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            will restrict on metrics of the above form to something that looks like an action functional for a
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Moreover, all this of course remains true if the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi F
                %annotation{:encoding => "application/x-tex"} X \times F
            – which we may think of as the trivial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – is generalized to any
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            with
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            (hence such that
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E = P \times_G F
          %p
            Then one finds that the KK-mechanics indeed not only reproduces
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            and their correct
            %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            from pure
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            in higher dimensions, but also the
            %a.existingWikiWord{:href => "/nlab/show/forces"} forces
            which they exert on test particles. For instance the trajectory of a
            %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
            subject to the
            %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
            exerted by an
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            in
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            is in fact a
            %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
            in the field of pure
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            of the total space of the corresponding KK-un-compactified
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            = succeed ")" do
              %a{:href => "#Bleecker81"} Bleecker 81
            = succeed ")" do
              %a{:href => "#Bartlett13"} Bartlett 13
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            of this form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi E
                    %mo ,
                    %msubsup
                      %mi g
                      %mi E
                      %mi KK
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(E, g^KK_{E}\right)
            for fixed
            %em
              %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi F
                %annotation{:encoding => "application/x-tex"} g_F
            is called a
            %strong Kaluza-Klein compactification
            of the
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as being obtained by
            %strong dimensional reduction
            from the spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            (Beware that the term “compactification” here is vaguely related to but rather different from the use of the term in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematics
            %em
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            etc.).
          %h3#its_application_in_theoretical_physics Its application in theoretical physics
          %p Various evident generalizations of this ansatz can and are being considered.
          %p
            Most notably for actual
            %a.existingWikiWord{:href => "/nlab/show/model+building"} model building
            in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            it is of interest to consider the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi X
                %annotation{:encoding => "application/x-tex"} g_{X}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are
            %em not
            necessarily constant along the fiber
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/Fourier+modes"} Fourier modes
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            of the higher modes appear as
            %em
              %a.existingWikiWord{:href => "/nlab/show/mass"} massive
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            in the
            %a.existingWikiWord{:href => "/nlab/show/effective+QFT"} effective
            KK-
            %a.existingWikiWord{:href => "/nlab/show/action+functional"}> action functional
            \. They are called the
            %strong higher Kaluza-Klein modes
            \. These masses are inversely proportional to the metric
            %a.existingWikiWord{:href => "/nlab/show/volume"} volume
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/model+building"} model building
            this volume is therefore chosen to be very small, such that it implies that the
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
            does not predict the
            %a.existingWikiWord{:href => "/nlab/show/observation"} observation
            of the
            %a.existingWikiWord{:href => "/nlab/show/quanta"} quanta
            of these massive modes in existing accelerator
            %a.existingWikiWord{:href => "/nlab/show/experiments"} experiments
            (such as the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/LHC"} LHC
          %p
            On the other hand, the extra
            %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi F
                %annotation{:encoding => "application/x-tex"} g_F
            do not acquire effective
            %a.existingWikiWord{:href => "/nlab/show/masses"} masses
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            this way. Therefore
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            in
            %em plain
            Kaluza-Klein theory are trivially ruled out by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            they predicts the
            %a.existingWikiWord{:href => "/nlab/show/observation"} observation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of these massless
            %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/experiments"} experiments
          %p
            Therefore if in a
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
            for fundamental physics the Kaluza-Klein mechanism is invoked as a way to explain the existence of the
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            in
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            from pure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
            need to be introduced that serve to equip the
            %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            with an effective
            %a.existingWikiWord{:href => "/nlab/show/potential"} potential
            with a
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/minimum"} minimum
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            to acquire an effective
            %a.existingWikiWord{:href => "/nlab/show/mass"} mass
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %a.existingWikiWord{:href => "/nlab/show/model+building"} model building
            the problem of constructing such a more general KK-
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
            is called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
              problem
            \. (See also at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/landscape+of+string+theory+vacua"} landscape of string theory vacua
          %h3#Formalization Formalization
          %p
            KK-compactification along trivial fibrations is closely related to forming
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/mapping+stacks"} mapping stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_n
            is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            for an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %em
              %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            for more on this), then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \Sigma_{k}
            a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &lt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} k \lt n
            the
            %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mi k
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}_{n-k} \coloneqq [\Sigma_k, \mathbf{Fields}]
          %p
            may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of fields for an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-k)
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the mapping stack, this lower dimensional field theory is then such that a field configuration over an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-k)
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                %annotation{:encoding => "application/x-tex"} X_{n-k}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo ⟶
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                %annotation{:encoding => "application/x-tex"}
                  \\phi \colon X_{n-k} \longrightarrow \mathbf{Fields}_{n-k}
          %p
            is equivalently a field configuration of the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo ×
                  %msub
                    %mi Σ
                    %mi k
                  %mo ⟶
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  X_{n-k} \times \Sigma_k \longrightarrow \mathbf{Fields}_n
          %p
            on the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo ×
                  %msub
                    %mi Σ
                    %mi k
                %annotation{:encoding => "application/x-tex"} X_{n-k}\times \Sigma_k
            (the trivial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Sigma_{k}
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            over
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} X_{n-k}
          %p
            Traditionally KK-reduction is understood as retaining only parts of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_{n-k}
            (the “0-modes” of fields on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \Sigma_k
            only) but of course one may consider arbitrary corrections to this picture and eventually retain the full information.
          %p
            One example of KK-reduction where the full mapping stack appears is the reduction of
            %a.existingWikiWord{:href => "/nlab/show/topological+twist"} topologically twisted
            %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+super+Yang-Mills+theory"} N=4 D=4 super Yang-Mills theory
            on a complex curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as it appears in the explanation of
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+duality"} geometric Langlands duality
            as a special case of
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            (
            %a{:href => "#Witten08"}> Witten 08, section 6
            ). Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mn 4
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi{:mathvariant => "normal"} conn
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_4 = \mathbf{B}G_{\mathrm{conn}}
            is the universal moduli stack of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            (or rther that of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Higgs+bundles"} Higgs bundles
          %h2#examples Examples
          %h3#ReductionsOfPureGravity Reductions of pure gravity with realistic gauge groups
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            of the
            %a.existingWikiWord{:href => "/nlab/show/experiment"} experimentally
            verified
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            is a
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            of the
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+groups"} special unitary groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(3)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2)
            and the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p
            In (
            %a{:href => "#Witten81"}> Witten 81
            ) it was observed that the minimal
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of a
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            for the KK-reduction to yield the
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(3) \times SU(2) \times U(1)
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi F
                  %mo =
                  %mn 7
                %annotation{:encoding => "application/x-tex"} d_F = 7
            \. This may be a meaningless numerical coincidence, but might be – and was regarded as being – remarkable: because it means that the minimum total dimension of a KK-compactification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi F
                %annotation{:encoding => "application/x-tex"} X \times F
            that could yield a realistic model of observed physics is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mo +
                    %mn 7
                    %mo =
                    %mn 11
                  %annotation{:encoding => "application/x-tex"} 4 + 7 = 11
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            model:
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
          %p
            While there are many 7-
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            that do yield the desired
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model
            %a{:href => "#Witten81"} Witten 81
            also shows that for none of them does the remaining
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            content of the
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model
            – the
            %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
            and the
            %a.existingWikiWord{:href => "/nlab/show/Higgs+field"} Higgs field
            – come out correctly, due to lack of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chiral+fermions"} chiral fermions
          %p
            Largely due to this result, the original pure Kaluza-Klein ansatz that starts with just pure
            %a.existingWikiWord{:href => "/nlab/show/Einstein+gravity"} Einstein gravity
            with no other
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            that still exhibit the essence of KK-reduction in parts.
          %p
            Notably the
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            mentioned above contains more
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            than just the field of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            which is a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher
            analog of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            and of its conjectured
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/UV-completion"} UV-completion
            for instance on
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-manifold"} G₂-manifold
            fibers turn out to be able to yield
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            which come at least very close to the
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            when considered on
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            spacetimes. This we come to
            = succeed "," do
              %a{:href => "#KKReductionOf11dSupergravity"} below
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
          %h3#ReductionsOfTypeIISupergravity Reductions of type II supergravity
          %p
            Motivation for further variants of the KK-ansatz has to a large extent come from models in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            models KK-reduced on 6-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+spaces"} Calabi-Yau spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+Calabi-Yau+manifolds"} supersymmetry and Calabi-Yau manifolds
          %p
            The advantage of these type II models is that they naturally involve further
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            and in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            is an inhomogeneous closed
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            of even or of odd degree. Moreover, restricted to configurations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            of these forms with specified
            %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            in the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            part of the KK-reduced action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi g
                    %mi KK
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi S
                    %mi EH
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi S
                    %mi YM
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi S
                    %mi mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mi F
                  %mo ,
                  %mi ℱ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g^KK, F) \mapsto S_{EH}(g_X) + S_{YM}(A) + S_{mod}(g_F, \mathcal{F})
          %p
            %em does
            produce the previously missing
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            %a.existingWikiWord{:href => "/nlab/show/potentials"} potentials
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi F
                %annotation{:encoding => "application/x-tex"} g_F
            proportional to these cycles of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            in KK-theory.
          %p
            This means that physical model building using the specific ansatz of KK-reduction of type II supergravities on Calabi-Yau fibers reduces to a noteworthy enumerative problem in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+geometry"} complex geometry
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
            with given
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
            and given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
          %p
            While interesting, there are few tools known for performing this classification. The only thing that seems to be clear is that the classification is not sparse: there are many points in this space of choices. Since all this is relevant in model building in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/landscape+of+string+theory+vacua"} landscape of string theory vacua
          %p For more on this see also
          %ul
            %li
              %p
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+and+Calabi-Yau+manifolds"} supergravity and Calabi-Yau manifolds
                ,
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/string+phenomenology"} string phenomenology
            %li
              %p
                %em>
                  %a{:href => "string%20theory%20FAQ#WhatDoesItMeanToSayStringTheoryHasALandscapeOfSolutions"} string theory FAQ – What does it mean to say that string theory has a “landscape” of solutions?
                \.
          %h3{:id => "#KKReductionOf11dSupergravity"} KK-Reduction of 11d supergravity
          %p
            …
            %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"}> duality between M-theory and type IIA string theory
            …
          %p
            The lift of the
            %a{:href => "#ReductionsOfTypeIISupergravity"} above
            reduction of
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type IIA supergravity
            on
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
            to
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            is the KK-reduction of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-manifolds"} G₂-manifolds
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} X_7
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            and
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            is now played by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            in
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            of degree 3+1. For non-vanishing
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            (“flux”) of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            in the 4d space this is the
            %a.existingWikiWord{:href => "/nlab/show/Freund-Rubin+compactification"} Freund-Rubin compactification
            yielding
            %a.existingWikiWord{:href => "/nlab/show/weak+G%E2%82%82+holonomy"} weak G₂ holonomy
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} X_7
          %p
            Such KK-compactification of the form
            %em
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
            turn out to yield very detailed and at least semi-realistic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} physics
            %em
              %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-MSSM"} G₂-MSSM
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
          %p
            The 1-form gauge field induced by KK-compactification of
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on a circle is the potential of the degree-2 part of the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            of
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            which couples to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D0-brane"} D0-brane
          %p
            Followed by a
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            operations these compactifications yields
            %a.existingWikiWord{:href => "/nlab/show/type+IIB+superstring+theory"} type IIB superstring theory
            compactifications and this route is known as
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
                %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactified
                on
                %a.existingWikiWord{:href => "/nlab/show/elliptic+fibration"} elliptically fibered
                %a.existingWikiWord{:href => "/nlab/show/complex+analytic+space"} complex analytic
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi dim
                            %mi ℂ
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(\Sigma)
                  %th 1
                  %th 2
                  %th 3
                  %th 4
                  %th 5
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/F%2FM-theory+on+elliptically+fibered+Calabi-Yau+2-folds"} F-theory on CY2
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/F%2FM-theory+on+elliptically+fibered+Calabi-Yau+3-folds"} F-theory on CY3
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/F%2FM-theory+on+elliptically+fibered+Calabi-Yau+4-folds"} F-theory on CY4
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/F%2FM-theory+on+elliptically+fibered+Calabi-Yau+5-folds"} F-theory on CY5
          %h3#high_codimension_compactification_of__super_yangmills
            High codimension compactification of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 10
                %annotation{:encoding => "application/x-tex"} D=10
            super Yang-Mills
          %p
            The KK-compactification of
            %a.existingWikiWord{:href => "/nlab/show/D%3D10+super+Yang-Mills+theory"} D=10 super Yang-Mills theory
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} D=1
            is related to what is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/BFSS+matrix+model"} BFSS matrix model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} D = 0
            gives the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/IKKT+matrix+model"} IKKT matrix model
          %h3#CascadedOfKKReductionsFromHolographicBoundaries Cascades of KK-reductions
          %p
            Apart from possibly producing
            %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenologically
            interesting
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            from
            %a.existingWikiWord{:href => "/nlab/show/UV-completion"} UV-complete
            fundamental
            %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theories
            on higher dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
            with each other in a way that serves to illuminate their general structure and to map the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of all of them.
          %p
            For instance various deep but rather mysterious properties of 4-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            (the central theory of the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            versions
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/N%3D1+D%3D4+super+Yang-Mills+theory"} N=1 D=4 super Yang-Mills theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/N%3D2+D%3D4+sYM"} N=2 D=4 sYM
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+sYM"} N=4 D=4 sYM
            %em geometric
            interpretation by understanding this 4d theory as the KK-compactification of the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            on a
            %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Montonen-Olive+duality"} Montonen-Olive duality
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            of
            %a.existingWikiWord{:href => "/nlab/show/N%3D2+D%3D4+super+Yang-Mills+theory"} N=2 D=4 super Yang-Mills theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/conformal+transformation"} conformal transformation
            remnant of the compactification torus remaining of the
            %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal invariant
            of the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            (see there for more on this).
          %p
            At the same time, the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            is itself related to a yet higher dimensional theory, namely to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            theory (
            %a.existingWikiWord{:href => "/nlab/show/M-theory"}> M-theory
            ) if in addition to KK-reduction one also considers
            = succeed "-boundary" do
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT"} AdS-CFT
          %p
            In an analogous way, the supersymmetric version of 4-dimensional Yang-Mills theory with twice that supersymmetry, namely
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+sYM"} N=4 D=4 sYM
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT"} AdS-CFT
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
          %p
            And this process continues further down in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %a.existingWikiWord{:href => "/nlab/show/N%3D2+D%3D4+super+Yang-Mills+theory"} N=2 D=4 super Yang-Mills theory
            and
            %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+sYM"} N=4 D=4 sYM
            themselves have further KK-reductions to 2-dimensional field theories. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 4
                %annotation{:encoding => "application/x-tex"} N = 4
            and after passing to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topologically+twisted+D%3D4+super+Yang-Mills+theory"} topologically twisted theory
            %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
            and a
            %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
            %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological string
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/TCFT"} TCFT
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            %a.existingWikiWord{:href => "/nlab/show/Montonen-Olive+duality"} Montonen-Olive duality
            in 4d and
            %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal invariance
            in 6d and topological invariant in 7d and 11d here becomes
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+duality"} geometric Langlands duality
            in 2d (see there for more on this) and produces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Donaldson+theory"} Donaldson theory
          %p
            Hence by iteratively applying KK-reductions and other
            %a.existingWikiWord{:href => "/nlab/show/dualities"} dualities
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topologically+twisted+D%3D4+super+Yang-Mills+theory"} topological twists
            %em cascades
            of different
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
            that all superficially look very different, but which thereby become closely related as different aspects of one single higher dimensional field theory. Not all of these lower dimensional theories can be
            %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenological
            viable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            serve, via KK-reduction, to explain and illuminate deep properties of (semi-)realistic theories such as
            %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theory"} super Yang-Mills theory
            in 4d.
          %p
            The following table displays parts of this cascade of field theories which are induced from
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            under iterative KK-reduction,
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
            and topological twists. There is another such cascade which starts instead from
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT"} AdS-CFT
            applied to
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            and then proceeds downward in dimension. This is displayed further below.
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
                induced via
                %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} AdS-CFT correspondence
            %table
              %thead
                %tr
                  %th
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
                      perspective via
                      %a.existingWikiWord{:href => "/nlab/show/AdS7-CFT6"} AdS7-CFT6
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
                    perspective
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
