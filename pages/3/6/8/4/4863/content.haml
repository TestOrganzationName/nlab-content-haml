                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
                    on the
                    %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                    with
                    %a.existingWikiWord{:href => "/nlab/show/CFT"} conformal invariance
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                    worldvolume theory
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
