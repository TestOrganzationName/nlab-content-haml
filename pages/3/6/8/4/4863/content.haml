            %li#Landsman89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"}> Klaas Landsman
                ,
                = succeed "," do
                  %em Limitations to dimensional reduction at high temperature
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(89)90424-0"} doi:10.1016/0550-3213(89)90424-0
            %li#Reisz92
              %p
                T. Reisz,
                = succeed "," do
                  %em Realization of dimensional reduction at high temperature
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01483886"} doi:10.1007/BF01483886
            %li#Braaten95
              %p
                Eric Braaten,
