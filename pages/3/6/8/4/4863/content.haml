          %h2#idea Idea
          %p
            The
            = succeed "," do
              %em Kaluza-Klein mechanism
            %a.existingWikiWord{:href => "/nlab/show/Theodor+Kaluza"} Theodor Kaluza
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Oskar+Klein"} Oskar Klein
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            on a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} product
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi F
                %annotation{:encoding => "application/x-tex"} X \times F
            with fixed
