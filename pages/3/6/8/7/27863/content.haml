                  \\cong\Omega^1(M,\underline{End}(L))
                  \\cong\Omega^1(M,Ad Fr_U(L))
                  \\cong\Omega_{Ad}^1(Fr_U(L),\mathfrak{u}(1))
          %p
            (In particular, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
