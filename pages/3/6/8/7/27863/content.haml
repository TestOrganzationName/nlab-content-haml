                %annotation{:encoding => "application/x-tex"} \Gamma^\infty(W^-)
            (or short
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
