          %h2#idea Idea
          %p
            The
            %em Seiberg-Witten equations
            are
            %a.existingWikiWord{:href => "/nlab/show/partial+differential+equations"} partial differential equations
            for connections of
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
            and smooth sections of their spinor bundles. Their
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            is used to define the
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+invariants"} Seiberg-Witten invariants
            capable to study smooth structures on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/4-manifolds"} 4-manifolds
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            of the Seiberg-Witten equations is abelian, calculations from
            %a.existingWikiWord{:href => "/nlab/show/Donaldson+theory"} Donaldson theory
            could be simplified with new methods provided by the Seiberg-Witten invariants.
          %h2#basics Basics
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            %a.existingWikiWord{:href => "/nlab/show/orientable"} orientable
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian
            %a.existingWikiWord{:href => "/nlab/show/4-manifold"} 4-manifold
            with a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            %a.existingWikiWord{:href => "/nlab/show/spin%E1%B6%9C+structure"} spinᶜ structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
            %a.existingWikiWord{:href => "/nlab/show/classifying+map"} classifying map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mi BSO
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau\colon M\rightarrow BSO(4)
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi TM
                  %mo ≅
                  %msup
                    %mi τ
                    %mo *
                  %msubsup
                    %mi γ
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} TM\cong\tau^*\gamma_\mathbb{R}^4
            to a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %msup
                      %mi BSpin
                      %mi{:mathvariant => "normal"} c
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}\colon M\rightarrow BSpin^\mathrm{c}(4)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/exceptional+isomorphism"} exceptional isomorphism
            = succeed ")" do
              %a{:href => "#Perutz02"} Perutz 2002, p. 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Spin
                    %mi{:mathvariant => "normal"} c
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi A
                    %mo ±
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi det
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo −
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi det
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  Spin^\mathrm{c}(4)
                  \\cong U(2)\times_{U(1)}U(2)
                  \=\{A^\pm\in U(2)|det(A^-)=det(A^+)\}
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/spin%E1%B6%9C+structure"} spinᶜ structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰
                %annotation{:encoding => "application/x-tex"} \mathfrak{s}
            consists of two complex plane bundles
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo ±
                    %mo ↠
                    %mi M
                  %annotation{:encoding => "application/x-tex"} W^\pm\twoheadrightarrow M
            = succeed "," do
              %em associated spinor bundles
            %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi det
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo ±
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L=det(W^\pm)
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            one has
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo ±
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1(L)=c_1(W^\pm)\in H^2(M,\mathbb{Z})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %msup
                    %mi W
                    %mo −
                  %mo ⊕
                  %msup
                    %mi W
                    %mo +
                %annotation{:encoding => "application/x-tex"} W=W^-\oplus W^+
            be the
            %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
            of the spinor bundles.
          %h2#seibergwitten_equations Seiberg-Witten equations
          %p
            %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} Covariant derivatives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi M
                  %mo ⊗
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nabla\colon\Gamma^\infty(L)\rightarrow\Gamma^\infty(T^*M\otimes L)
            on the
            %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
            and fulfill the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            on the
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fr
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fr_U(L)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi M
                  %mo ⊗
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Γ
                    %mn ∞
                  %munder
                    %mi Hom
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %msup
                    %mi T
                    %mo *
                  %mi M
                  %mo ⊗
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi M
                  %mo ⊗
                  %msup
                    %mi L
                    %mo *
                  %mo ⊗
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi M
                  %mo ⊗
                  %munder
                    %mi End
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %munder
                    %mi End
                    %mo ̲
                  %mo{:stretchy => "false"} (
