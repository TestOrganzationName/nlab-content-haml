                      %mi D
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Γ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Γ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^A\colon\Gamma^\infty(W^+)\rightarrow\Gamma^\infty(W^-)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi W
                      %mo ±
                    %mo ⊕
                    %msup
                      %mi W
                      %mo ±
                    %mo →
                    %munder
                      %mi ℝ
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle\colon W^\pm\oplus W^\pm\rightarrow\underline{\mathbb{R}}
          %p
            Now the Seiberg-Witten equations are
            %a.existingWikiWord{:href => "/nlab/show/partial+differential+equations"} partial differential equations
            for a connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A\in\Omega^1(M,\mathfrak{u}(1))
            and a self-dual spinor field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %msup
                      %mi Γ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi\in\Gamma^\infty(W^+)
            %em undisturbed Seiberg-Witten equations
            without and
            %em disturbed Seiberg-Witten equations
            with a self-dual form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mo +
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta\in\Omega_+^2(M,\mathfrak{u}(1))
            as:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi A
                  %mi ϕ
                  %mo =
                  %mn 0
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  D^A\phi
                  \=0;
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi F
                    %mi A
                    %mo +
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi η
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_A^+
                  +\tau(\phi)
                  +\eta
                  \=0.
          %p
            (
            %a{:href => "#Nicolaescu00"}> Nicolaescu 2000, Definition 2.1.3.
            )
          %p
            Considering the undisturbed Seiberg-Witten equations with a vanishing spinor field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \phi=0
            yields the anti self-dual
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            (ASDYM equations)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi A
                      %mo +
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F_A^+=0
          %h2#references References
          %ul
            %li#Nicolaescu00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Liviu+Nicolaescu"}> Liviu Nicolaescu
                ,
                = succeed "," do
                  %em Notes on Seiberg-Witten theory
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/GSM/28"} ISBN:978-0-8218-2145-9
                = succeed "&rbrack;" do
                  %a{:href => "https://www3.nd.edu/~lnicolae/new1.pdf"} pdf
            %li#Perutz02
              %p
                Tim Perutz,
                %em Basics of Seiberg-Witten theory
                (May 2002), &amp;lbrack;
                %a{:href => "https://www.imperial.ac.uk/media/imperial-college/research-centres-and-groups/geometry/junior-geometry-seminar/Seiberg-Witten-theory.pdf"}> pdf
                \&amp;rbrack;
            %li#EinhornFriedrich
              %p
                Jürgen Einhorn, Thomas Friedrich,
                %em Seiberg-Witten theory
                (
                %a{:href => "http://matwbn.icm.edu.pl/ksiazki/bcp/bcp39/bcp3925.pdf"}> pdf
                )
            %li#Donaldson
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Donaldson"}> Simon Donaldson
                ,
                %em The Seiberg-Witten equations and 4-manifold topology
                (
                %a{:href => "http://www.ams.org/journals/bull/1996-33-01/S0273-0979-96-00625-8/S0273-0979-96-00625-8.pdf"}> pdf
                )
            %li#Marcolli
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"}> Matilde Marcolli
                ,
                = succeed "," do
                  %em Seiberg-Witten gauge theory
                %a{:href => "http://www.its.caltech.edu/~matilde/swcosi.pdf"} pdf
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Seiberg%E2%80%93Witten_equations"} Seiberg-Witten equations
