                      %a{:href => "/nlab/edit/foundations+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#firstorder_axioms"} “First-order” axioms
                %li
                  %a{:href => "#secondorder_axioms"} “Second-order” axioms
              %li
