                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi Top
                          %mi cpt
                      %annotation{:encoding => "application/x-tex"} */Top_{cpt}
                  for the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
                  %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
