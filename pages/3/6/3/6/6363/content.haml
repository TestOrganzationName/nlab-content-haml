                      %annotation{:encoding => "application/x-tex"} Top_{cpt}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi Haus
                      %annotation{:encoding => "application/x-tex"} {}_{Haus}
                  of the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
              %li
                %p
