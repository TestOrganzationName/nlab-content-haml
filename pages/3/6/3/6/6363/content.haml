          %h2#idea Idea
          %p
            %em Gelfand duality
            is a
            %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} duality between spaces and their algebras of functions
            for the case of
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.existingWikiWord{:href => "/nlab/show/commutative+C-star-algebra"} commutative
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/C-star+algebras"} C-star algebras
          %blockquote
            %p
              Every (nonunital) commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalent to the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              on the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              called its
              %em
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+spectrum"} Gelfand spectrum
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} sp(A)
          %p
            This theorem is the basis for regarding non-commutative
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
          %h2#definitions Definitions
          %p
            The statement of Gelfand duality involves the following
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
          .num_defn
            %h6#definition Definition
            %p Write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                        %mi Alg
                      %annotation{:encoding => "application/x-tex"} C^\ast Alg
                  for the category of unital
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/C-star+algebras"} C-star algebras
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                        %msub
                          %mi Alg
                          %mi nu
                      %annotation{:encoding => "application/x-tex"} C^\ast Alg_{nu}
                  for the category of nonunital
                  = succeed "-algebras;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                        %msub
                          %mi Alg
                          %mrow
                            %mi nu
                            %mo ,
                            %mi nd
                      %annotation{:encoding => "application/x-tex"} C^\ast Alg_{nu,nd}
                  for the sub category of nonunital
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                  %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                    \-algebra
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                        %msub
                          %mi Alg
                          %mi com
                      %annotation{:encoding => "application/x-tex"} C^\ast Alg_{com}
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                          %msub
                            %mi Alg
                            %mrow
                              %mi com
                              %mo ,
                              %mi nu
                        %annotation{:encoding => "application/x-tex"} C^\ast Alg_{com,nu}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                        %msub
                          %mi Alg
                          %mrow
                            %mi com
                            %mo ,
                            %mi nu
                            %mo ,
                            %mi nd
                      %annotation{:encoding => "application/x-tex"} C^\ast Alg_{com,nu,nd}
                  for the full subcategories of the above three categories consisting of commutative C*-algebras.
            %p And
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi Haus
                      %annotation{:encoding => "application/x-tex"} {}_{Haus}
                  for the category of
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+spaces"} Hausdorff topological spaces
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
