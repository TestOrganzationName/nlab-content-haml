          %h2#references References
          %p The original reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Israel+Gelfand"}> Israel Gelfand
              ,
              = succeed "," do
                %em Normierte Ringe
          %p
            Formulation of Gelfand duality in terms of
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            (
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"}> adjoint functors
            ,
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            (“triples”) and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalences"} adjoint equivalences
          %ul
            %li#Negropontis71
              Joan W. Negrepontis,
              = succeed "," do
                %em Duality in analysis from the point of view of triples
              = succeed "," do
                %a{:href => "https://doi.org/10.1016/0021-8693(71)90105-0"} doi
          %p Quick exposition is in
          %ul
            %li
              Ivo Dell’Ambrogio,
              %em
                Categories of
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
              (
              %a{:href => "https://idellambrogio.github.io/exercise_C_algebras.pdf"}> pdf
              )
          %p Textbook accounts:
          %ul
            %li#Johnstone82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                , section IV.4 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stone+Spaces"} Stone Spaces
                = succeed "," do
                  %strong 3
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolaas+P.+Landsman"}> Nicolaas P. Landsman
                \:
                = succeed "," do
                  %em Mathematical topics between classical and quantum mechanics
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1662141"} MR2000g:81081
                %a{:href => "http://dx.doi.org/10.1007/978-1-4612-1680-3"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gerald+B.+Folland"}> Gerald B. Folland
                ,
                = succeed "," do
                  %em A course in abstract harmonic analysis
                = succeed "," do
                  %a{:href => "https://sv.20file.org/up1/1415_0.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.com/books?hl=en&lr=&id=0VwYZI1DypUC"} gBooks
          %p
            Discussion in the generality of
            %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+spaces"} Hausdorff spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/nonunital+algebra"} nonunital
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
                \-algebras
          %ul
            %li#Brandenburg07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Brandenburg"}> Martin Brandenburg
                ,
                %em Gelfand-Dualität ohne 1
                (2007) &amp;lbrack;
                %a{:href => "http://www.matheplanet.com/matheplanet/nuke/html/article.php?sid=1111"}> web
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masoud+Khalkhali"}> Masoud Khalkhali
                \:
                = succeed "," do
                  %em
                    Locally compact spaces and commutative
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
                = succeed "," do
                  %em Basic Noncommutative Geometry
                = succeed "," do
                  %a{:href => "https://ems.press/books/elm/225"} ems:elm/225
                = succeed "," do
                  %a{:href => "https://doi.org/10.4171/128"} doi:10.4171/128
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Khalkhali-GelfandDuality.pdf", :title => "pdf"} pdf
            %li
              %p
                Eleftherios Papadopoulos:
                = succeed "," do
                  %em Gelfand Duality
                = succeed "," do
                  %a{:href => "https://olympias.lib.uoi.gr/jspui/bitstream/123456789/31841/1/%CE%9C.%CE%95.%20%CE%A0%CE%91%CE%A0%CE%91%CE%94%CE%9F%CE%A0%CE%9F%CE%A5%CE%9B%CE%9F%CE%A3%20%CE%95%CE%9B%CE%95%CE%A5%CE%98%CE%95%CE%A1%CE%99%CE%9F%CE%A3%202022.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Papadopoulos-GelfandDuality.pdf", :title => "pdf"} pdf
            %li
              %p
                Abhijeet Vats:
                = succeed "," do
                  %em The Path to Gelfand Duality and Spectral Theory
                = succeed "," do
                  %a{:href => "https://lup.lub.lu.se/student-papers/search/publication/9129834"} lup:9129834
                = succeed "," do
                  %a{:href => "https://lup.lub.lu.se/luur/download?func=downloadFile&recordOId=9129834&fileOId=9129838"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Vats-GelfandDuality.pdf", :title => "pdf"} pdf
          %p
            and in
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            (with topological spaces generalized to
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
              \:
              %em
                Constructive Gelfand duality for non-unital commutative
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1412.2009"}> arXiv:1412.2009
              \&amp;rbrack;
          %p#ReferencesCenterOfAction
            Discussion of Gelfand duality as a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+equivalence+of+an+adjunction"} fixed point equivalence of an adjunction
          %ul
            %li#PorstTholen91
              %a.existingWikiWord{:href => "/nlab/show/Hans-E.+Porst"}> Hans-E. Porst
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
              %em Concrete Dualities
              in H. Herrlich,
              %a.existingWikiWord{:href => "/nlab/show/Hans-E.+Porst"} Hans-E. Porst
              (eds.)
              = succeed "," do
                %em Category Theory at Work
              = succeed ")" do
                %a{:href => "http://www.heldermann.de/R&E/RAE18/ctw07.pdf"} pdf
          %p following
          %ul
            %li#DubucPorta71
              %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Horacio+Porta"} Horacio Porta
              = succeed "," do
                %em Convenient categories of topological algebras
              %a{:href => "https://projecteuclid.org/euclid.bams/1183533170"} euclid
          %p Some other generalized contexts for Gelfand duality:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans+Porst"}> Hans Porst
                , Manfred B. Wischnewsky,
                = succeed "," do
                  %em Every topological category is convenient for Gelfand duality
                = succeed ":2," do
                  %strong 25
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Heunen"}> Chris Heunen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"} Klaas Landsman
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bas+Spitters"} Bas Spitters
                = succeed "," do
                  %em
                    The Gelfand spectrum of a noncommutative
                    = succeed "-algebra" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
                %strong 90
                (2011), 39–52
                %a{:href => "http://dx.doi.org/10.1017/S1446788711001157"} doi
                %a{:href => "http://www.math.ru.nl/~landsman/LandsmanCarey60.pdf"} pdf
            %li
              %p
