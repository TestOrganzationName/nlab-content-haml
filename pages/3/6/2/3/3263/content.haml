                        %semantics
                          %mrow
                            %mi q
                          %annotation{:encoding => "application/x-tex"} q
                %strong 246
                (1997), vi+135 pp. (
                %a{:href => "https://arxiv.org/abs/q-alg/9703044"}> arXiv:q-alg/9703044
                ,
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/AST_1997__246__R1_0"} numdam:AST_1997__246__R1_0
          %p Online entries/resources on hypergeometric function:
          %ul
            %li
              %p
                at Wolframworld:
                = succeed "," do
                  %a{:href => "http://mathworld.wolfram.com/HypergeometricFunction.html"} hypergeometric function
                = succeed "," do
