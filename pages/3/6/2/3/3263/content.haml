                %annotation{:encoding => "application/x-tex"} x,p,q,a_1,\ldots,a_p,b_1,\ldots, b_q
            to write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
