                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{c_{n+1}}{c_n} = \frac{(n+a_1)(n+a_2)\cdots (n+a_p) x}{(n+b_1)(n+b_2)\cdots (n+b_q)(n+1)}
          %p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msub
                      %mi c
                      %mi n
                    %mo =
                    %msub
                      %mi c
                      %mn 0
                    %mo ⋅
                    %msub
                      %mrow
                      %mi p
                    %msub
                      %mi F
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi p
                    %mo ;
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi q
                    %mo ;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum c_n = c_0\cdot {}_p F_q(a_1,\ldots,a_p; b_1,\ldots, b_q; x)
          %h3#classical_case_
            Classical case,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mn 2
                  %msub
                    %mi F
                    %mn 1
                %annotation{:encoding => "application/x-tex"} {}_2 F_1
          %p
            Hypergeometric function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %msub
                    %mrow
                    %mn 2
                  %msub
                    %mi F
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi c
                  %mo ;
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F = {}_2 F_1(a,b;c;x)
            satisfies the ordinary differential equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                      %mi F
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mn 2
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi c
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo +
                  %mi b
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mfrac
                    %mrow
                      %mi d
                      %mi F
                    %mrow
                      %mi d
                      %mi x
                  %mo −
                  %mi a
                  %mi b
                  %mi F
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  x(1-x)\frac{d^2 F}{d x^2} + [c-(a+b-1)x]\frac{d F}{d x}
                  \- a b F = 0.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(c)\gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Re
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} Re(b)\gt 0
            function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mn 2
                  %msub
                    %mi F
                    %mn 1
                %annotation{:encoding => "application/x-tex"} {}_2 F_1
            can be represented as the
            %span.newWikiWord
              Euler integral
              %a{:href => "/nlab/new/Euler+integral"} ?
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mn 2
                  %msub
                    %mi F
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi c
                  %mo ;
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo −
                      %mi b
                      %mo{:stretchy => "false"} )
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %msup
                    %mi t
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi t
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi c
                      %mo −
                      %mi b
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi t
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                  %mi d
                  %mi t
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi x
                  %mo ∉
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {}_2 F_1(a,b;c;x) = \frac{\Gamma(c)}{\Gamma(b)\Gamma(c-b)}\int_0^1 t^b (1-t)^{c-b-1}(1-t x)^{-a} d t,\,\,\,\,x\notin [1,+\infty).
          %p
            The value of this function at origin is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mn 1
                        %mo −
                        %mi c
                    %msub
                      %mrow
                      %mn 2
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi c
                    %mo +
                    %mn 1
                    %mo ,
                    %mi b
                    %mo −
                    %mi c
                    %mo +
                    %mn 1
                    %mo ;
                    %mn 2
                    %mo −
                    %mi c
                    %mo ;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^{1-c} {}_2 F_1(a-c+1,b-c+1;2-c;x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            is given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mn 1
                  %mo −
                  %mi c
                  %mo +
                  %mn 1
                  %mo ;
                  %mn 1
                  %mo −
                  %mi b
                  %mo +
                  %mi a
                  %mo ;
                  %msup
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x^{-a}F(a,1-c+1;1-b+a;x^{-1})
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi b
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mn 1
                    %mo −
                    %mi c
                    %mo +
                    %mi b
                    %mo ;
                    %mn 1
                    %mo −
                    %mi a
                    %mo +
                    %mi b
                    %mo ;
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^{-b}F(b,1-c+b;1-a+b;x^{-1})
          %h3#confluent_hypergeometric_functions Confluent hypergeometric functions
          %p
            If some singular points of the differential equation coalesce, in the limiting case we obtain confluent hypergeometric function (special case of which are e.g.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Bessel+functions"} Bessel functions
          %h2#examples Examples
          %p
            The classical orthogonal polynomials appear as special cases for particular choices of parameters, for example Jacobi polynomials and, as their special case,
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Legendre+polynomial"} Legendre polynomial
          %h2#generalizations_and_related_equations Generalizations and related equations
          %p
            There are other variants like
            = succeed "-hypergeometric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          %p
            %a.existingWikiWord{:href => "/nlab/show/Heun+equation"} Heun equation
            is the second order
            %a.existingWikiWord{:href => "/nlab/show/Fuchsian+differential+equation"} Fuchsian ODE
            with 4 regular singular points at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi a
                %annotation{:encoding => "application/x-tex"} 0,1,a
            and
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            There is a recent elliptic version of hypergeometric functions due Spiridonov,
            = succeed "." do
              %a{:href => "#Spiridonov2013"} Spiridonov2013
          %p
            There are now modern generalizations to many variables due Aomoto and another variant due
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"} Mikhail Kapranov
            %a.existingWikiWord{:href => "/nlab/show/Israel+Gelfand"} Israel Gelfand
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Andrei+Zelevinsky"} Andrei Zelevinsky
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hypergeometric+construction+of+KZ+solutions"} hypergeometric construction of KZ solutions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
            = succeed "," do
              %span.newWikiWord
                Hiroaki Terao
                %a{:href => "/nlab/new/Hiroaki+Terao"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Orlik"} Peter Orlik
            %a.existingWikiWord{:href => "/nlab/show/Daniel+Cohen"} Daniel Cohen
            and others; often in connection to the study of (complements of)
            %a.existingWikiWord{:href => "/nlab/show/arrangements+of+hyperplanes"} arrangements of hyperplanes
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
            %a.existingWikiWord{:href => "/nlab/show/Selberg+integral"} Selberg-type integrals
            are involved.
