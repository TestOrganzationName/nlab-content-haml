                  %mi a
                  %mo +
                  %mi k
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (a)_k := a (a+1) (a+2) \cdots (a+k-1)
          %p
            is the shifted
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/factorial"} factorial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi c
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sum_{n = 0}^\infty c_n
            be any series of complex numbers such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi c
                    %mi n
                %annotation{:encoding => "application/x-tex"} c_{n+1}/c_n
            is a rational function of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi p
                  %mo ,
                  %mi q
                  %mo ,
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
