                      %mi n
                      %mo +
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %msub
                        %mi a
                        %mi p
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %msub
                        %mi b
