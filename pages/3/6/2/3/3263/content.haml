          %h2#idea Idea
          %p
            The classical
            %strong hypergeometric series
            (introduced by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Gauss"} Gauss
            %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
            solutions of certain
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+equations"} ordinary differential equations
            of second order, the hypergeometric differential equation.
          %p
            Special cases appear in classical problems of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/wave+equation"} wave equation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Legendre+polynomial"} Legendre polynomial
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Hermite+polynomial"} Hermite polynomial
          %h2#definition Definition
          %p The hypergeometric series is defined by the formula,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi p
                  %msub
                    %mi F
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mi p
                  %mo ;
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi b
                    %mi q
                  %mo ;
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mi ⋯
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi p
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mi ⋯
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mi q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi n
                    %mrow
                      %mi n
                      %mo !
                %annotation{:encoding => "application/x-tex"}
                  {}_p F_q (a_1,\ldots,a_p; b_1,\ldots, b_q; x) = \sum_{n=0}^\infty
                  \\frac{(a_1)_n (a_2)_n\cdots (a_p)_n}{(b_1)_n (b_2)_n\cdots (b_q)_n}\frac{x^n}{n!}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (a)_0 = 1
            and, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo ,
                  %mi …
                %annotation{:encoding => "application/x-tex"} k = 1,2,3,\ldots
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo :
                  %mo =
                  %mi a
                  %mo{:stretchy => "false"} (
                  %mi a
