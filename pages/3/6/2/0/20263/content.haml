          %h2#idea Idea
          %p
            A
            %em homotopy sphere
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which need not be
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            to an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            as an
            = succeed "-sphere." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h2#properties Properties
          %p
          .num_cor
            %h6 Corollary
            %p
              Every homotopy sphere is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+sphere"} rational homotopy sphere
          %p
          .num_cor
            %h6 Corollary
            %p
              Every homotopy sphere is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homology+sphere"} homology sphere
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/homology+sphere"} homology sphere
              is a homotopy sphere.
          %p
          .num_prop
            %h6 Proposition
            %p
              A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+space"} path-connected
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              = succeed "-sphere." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
          %p
          .num_prop
            %h6 Proposition
            %p
              A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+space"} path-connected
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n+1
              = succeed "-sphere." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n+1
          %ul
