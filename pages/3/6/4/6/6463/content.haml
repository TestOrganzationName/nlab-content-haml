                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                %ul
                  %li
                    %a{:href => "#remark_on_notation"} Remark on notation
              %li
                %a{:href => "#bisimplicial_abelian_groups"} Bisimplicial abelian groups
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            A bisimplicial set is a
            %a.existingWikiWord{:href => "/nlab/show/bisimplicial+object"} bisimplicial object
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h2#properties Properties
          %h3#Diagonal Diagonal
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/diagonal+of+a+bisimplicial+set"}> diagonal
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} X_{\bullet,\bullet}
              a bisimplicial set, its
              %strong
                %a.existingWikiWord{:href => "/nlab/show/diagonal+of+a+bisimplicial+set"} diagonal
              is the simplicial set that is the precomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Id
                    %mo ,
                    %mi Id
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                    %mo ×
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (Id, Id) \colon \Delta^{op} \to \Delta^{op} \times \Delta^{op}
              with the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo ,
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d(X)_n \;\coloneqq\; X_{n,n}
                    \\,.
          .num_defn
            %h6#definition_3 Definition
            %p
              %strong (realization)
            %p
              The
              %strong realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |X|
              of a bisimplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} X_{\bullet,\bullet}
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              that is given by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo ,
                        %mo *
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    |X| =  \int^{[n] \in \Delta} X_{n, *} \times \Delta[n]
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          .num_prop
            %h6#proposition Proposition
            %p
              %strong (diagonal is realization)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a bisimplicial set, its diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(X)
              is (isomorphic to) its realization
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |X|
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    |X| \simeq d(X)
                    \\,.
          %p
            This is for instance exercise 1.6 in in
            %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-4.dvi"} chapter 4
            = succeed "." do
              %a{:href => "#GoerssJardine"} Goerss-Jardine
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %p
          #DiagonalAsSimplicialHomotopyColimit.num_prop
            %h6 Proposition
            %p
              %strong (diagonal is homotopy colimit)
            %p
              The diagonal of a bisimplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} X_{\bullet,\bullet}
              is also (up to weak equivalence) the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              regarded as a simplicial diagram in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mi X
                    %mo ≃
                    %mi hocolim
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    diag X \simeq hocolim (X : \Delta^{op} \to sSet_{Quillen})
                    \\,.
            %p
          %p
            This appears for instance as theorem 3.6 in (
            %a{:href => "#Isaacson"}> Isaacson
            ).
          .proof
            %h6#proof Proof
            %p
              This follows with the above equivalence to the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mi X
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mi X
                      %mi k
                  %annotation{:encoding => "application/x-tex"} diag X \simeq \int^{[k] \in \Delta} \Delta[k] \cdot X_k
              and general expression of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    \\int^\Delta (-) \cdot (-)
                    \:
                    [\Delta, sSet_{Quillen}]_{Reedy} \times
                    [\Delta, sSet_{Quillen}]_{Reedy}
                    \\to
                    sSet_{Quillen}
            %p
              in
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Δ
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \Delta[-] : \Delta \to sSet_{Quillen}
              is a Reedy cofibrant resultion of the point in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]
              and that every object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet_{Quillen}]_{Reedy}
              is cofibrant.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (degreewise weak equivalences)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo ×
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X,Y : \Delta^{op} \times \Delta^{op} \to Set
              be bisimplicial sets. A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              which is degreewise in one argument a weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo :
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{n,\bullet} : X(n,\bullet) \to Y(n,\bullet)
              induces a weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(f) : d(X) \to d(Y)
              of the associated diagonal simplicial sets (with respect to the standard
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          .proof
            %h6#proof_2 Proof
            %p
              This is prop 1.9 in
              %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-4.dvi"} chapter 4
              of
            %ul
              %li
                Goerss-Jardine,
                %em Simplicial Homotopy Theory
                (
                %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/html/archive/goerss-jardine.html"}> dvi
                )
          %h3#TotalSimplicialSets Total décalage and total simplicial sets
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            called
            %em
              %a.existingWikiWord{:href => "/nlab/show/ordinal+sum"} ordinal sum
            (see also at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo :
                  %msup
                    %mi Δ
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo ×
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %msup
                    %mi Δ
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  + : \Delta^\op \times \Delta^{op} \to \Delta^{op}
                  \\,.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                  %mo ↦
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo +
                  %mi l
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  + : [k], [l] \mapsto [k+l+1]
                  \\,.
          %p
            This induces an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ssSet
                  %mover
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mo !
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ssSet
                  \\stackrel{\overset{+_!}{\longrightarrow}}{\stackrel{\overset{+^*}{\longleftarrow}}{\underset{+_*}{\longrightarrow}}}
                  sSet
                  \\,.
          .num_defn
            %h6#definition_4 Definition
            %p Here
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ≔
                        %msub
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mo *
                      %annotation{:encoding => "application/x-tex"} T \coloneqq +_*
                  is called the
                  %strong total simplicial set
                  functor or
                  %strong Artin-Mazur codiagonal
                  (we will use the first of these as codiagonal also has another accepted meaning, see
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Dec
                        %mo ≔
                        %msup
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mo *
                      %annotation{:encoding => "application/x-tex"} Dec \coloneqq +^*
                  is called the
                  %a.existingWikiWord{:href => "/nlab/show/total+d%C3%A9calage"} total décalage
                  functor (inside which is plain
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"} décalage
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              preserves degreewise
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          #TotalAndDiagonal.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any bisimplicial set
            %ul
              %li
                %p the canonical morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi diag
                        %mi X
                        %mo →
                        %mi T
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        diag X \to T X
                %p
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                  to the total simplicial set is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                  in the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction unit
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi T
                        %mi Dec
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        X \to T Dec X
                %p is a weak equivalence.
          %p
            These statements are for instance in (
            %a{:href => "#CegarraRemedios"}> CegarraRemedios
            ) and (
            %a{:href => "#Stevenson"}> Stevenson
            ). They may be considered as a non-additive versions of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
          .num_remark
            %h6#remark Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#TotalAndDiagonal"}
              and the usual
              %em
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
              it follows that under forming chain complexes for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homology"} simplicial homology
              %a.existingWikiWord{:href => "/nlab/show/total+complexes"} total complexes
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/double+complexes"} double complexes
          .num_remark
            %h6#remark_2 Remark
            %p
              After
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              these spaces are even related by a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
          %p (This seems to be due to Berger and Hübschmann, but related results were known to Zisman as they are so mentioned by Cordier in his work on homotopy limits.)
          .num_remark
            %h6#remark_3 Remark
            %p
              The
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              for
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi sGrp
                    %mo ⟶
                    %msub
                      %mi sSet
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W}
                    \\;\colon\;
                    sGrp \longrightarrow sSet_*
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mo{:lspace => "verythinmathspace"} :
                    %mi sGrp
                    %mover
                      %mo ⟶
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %mi sGrpd
                    %mover
                      %mo ⟶
                      %mi N
                    %mi ssSet
                    %mover
                      %mo ⟶
                      %mi T
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar W
                    \\colon
                    sGrp
                    \\stackrel{\mathbf{B}}{\longrightarrow}
                    sGrpd
                    \\stackrel{N}{\longrightarrow}
                    ssSet
                    \\stackrel{T}{\longrightarrow}
                    sSet
                    \\,.
          %p
            We have the following explicit formula for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/John+Duskin"} John Duskin
          .num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} bisimplicial set
              the total simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              is in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              the
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo →
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (T X)_n
                    \\to
                    \\prod_{i = 0}^n X_{i, n-i}
                    \\stackrel{\longrightarrow}{\longrightarrow}
                    \\prod_{i = 0}^{n-1}
                    X_{i, n-i-1}
            %p where the components of the two morphisms on the right are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi d
                          %mn 0
                          %mi v
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{i = 0}^n X_{i,n-i}
                    \\stackrel{p_i}{\to}
                    X_{i, n-i}
                    \\stackrel{d_0^v}{\to}
                    X_{i, n-i-1}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi d
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                          %mi h
                    %msub
                      %mi X
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{i = 0}^n X_{i,n-i}
                    \\stackrel{p_{i+1}}{\to}
                    X_{i+1,n-i-1}
                    \\stackrel{d_{i+1}^h}{\to}
                    X_{i,n-i-1}
                    \\,.
            %p
              The face maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d_i : (T X)_n \to (T X)_{n-1}
              are given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi d
                      %mi i
                      %mi v
                    %msub
                      %mi p
                      %mn 0
                    %mo ,
                    %msubsup
                      %mi d
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                      %mi v
                    %msub
                      %mi p
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi d
                      %mn 1
                      %mi v
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo ,
                    %msubsup
                      %mi d
                      %mi i
                      %mi h
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo ,
                    %msubsup
                      %mi d
                      %mi i
                      %mi h
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo +
                        %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi d
                      %mi i
                      %mi h
                    %msub
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d_i
                    \=
                    (d_i^v p_0,
                    d_{i-1}^v p_1,
                    \\cdots,
                    d_1^v p_{i-1},
                    d_i^h p_{i+1},
                    d_i^h p_{i+2},
                    \\cdots,
                    d_i^h p_n
                    )
            %p and the degeneracy maps are given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi s
                      %mi i
                      %mi v
                    %msub
                      %mi p
                      %mn 0
                    %mo ,
                    %msubsup
                      %mi s
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                      %mi v
                    %msub
                      %mi p
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi s
                      %mn 0
                      %mi v
                    %msub
                      %mi p
                      %mi i
                    %mo ,
                    %msubsup
                      %mi s
                      %mi i
                      %mi h
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi s
                      %mi i
                      %mi h
                    %msub
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_i
                    \=
                    (s_i^v p_0, s_{i-1}^v p_1, \cdots,
                    s_0^v p_i, s_i^h p_{i+1}, \cdots,
                    s_i^h p_n)
                    \\,.
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Dec
                      %mo ⊣
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Dec \dashv T)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi X
                    %mo →
                    %mi T
                    %mi Dec
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \eta : X \to T Dec X
              is given in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi s
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta : x \mapsto
                    (s_0(x), s_1(x), \cdots, s_n(x))
                    \\,.
          %h3#geometric_realization Geometric realization
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
          %h2#model_structures Model structures
          %p
            There are various useful
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structures on the category of bisimplicial sets.
          %h3#induced_from_the_diagonal Induced from the diagonal
          %p
            There is an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi diag
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ssSet
                  %mover
                    %munder
                      %mo ⟶
                      %mi diag
                    %mover
                      %mo ⟵
                      %mi L
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (L \dashv diag)   :
                  ssSet
                  \\stackrel{\overset{L}{\longleftarrow}}{\underset{diag}{\longrightarrow}}
                  sSet
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            along this adjunction of the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            exists and with respect to it the above
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %p
            This is due to (
            %a{:href => "#Moerdijk"}> Moerdijk 89
            )
          %h3#induced_from_codiagonal_
            Induced from codiagonal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ssSet
                %annotation{:encoding => "application/x-tex"} ssSet
            along the total simplicial set functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            exists. And for it
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Dec
                  %mo ⊣
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ssSet
                  %mover
                    %munder
                      %mo ⟶
                      %mi T
                    %mover
                      %mo ⟵
                      %mi Dec
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  (Dec \dashv T) : ssSet
                  \\stackrel{\overset{Dec}{\longleftarrow}}{\underset{T}{\longrightarrow}}
                  sSet
          %p
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Every diag-fibration is also a
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
            This is (
            %a{:href => "#CegarraRemedios"}> CegarraRemedios, theorem 9
            ).
          %h4#remark_on_notation Remark on notation
          %p
            There are two uses of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar W
            in this area, one is as used in (
            %a{:href => "#CegarraRemedios"}> CegarraRemedios
            ) where it is used for the codiagonal (sometimes denoted “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            ” or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            as above), the other is for the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            functor for a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            construction. The relationship between the two is that given a simplicial group or simplicially enriched groupoid,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            functor in each dimension gives a bisimplicial set and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                    %mo =
                    %mi T
                    %mi Ner
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar{W}G = T Ner G
          %h2#bisimplicial_abelian_groups Bisimplicial abelian groups
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo ×
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} A,B : \Delta^{op} \times \Delta^{op} \to Ab
              be bisimplicial abelian groups. A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              which is degreewise in one argument a weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{n,\bullet} : A(n,\bullet) \to B(n,\bullet)
              induces a weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(f) : d(A) \to d(B)
              of the associated diagonal complexes.
          .proof
            %h6#proof_3 Proof
            %p
              This is Lemma 2.7 in
              %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-4.dvi"} chapter 4
              of (
              %a{:href => "#GoerssJardine"}> GoerssJardine
              )
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%CF%80-Kan+condition"} π-Kan condition
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/decalage"} decalage
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bicubical+set"} bicubical set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cubical-simplicial+set"} cubical-simplicial set
          %h2#references References
          %p Some standard material is for instance in
          %ul
            %li#GoerssJardine
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"} Paul Goerss
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Rick Jardine
                %em Simplicial Homotopy Theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"}> Rick Jardine
                , Lecture 008 (2010) (
                %a{:href => "http://jardine.math.uwo.ca/HomTh/lecture008a.pdf"}> pdf
                )
            %li#Isaacson
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Isaacson"}> Samuel Isaacson
                ,
                %em Excercises in homotopy colimits
                (
                %a{:href => "http://www-math.mit.edu/~mbehrens/TAGS/Isaacson_exer.pdf"}> pdf
                )
          %p The total simplicial set functor goes back to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/M.+Artin"}> M. Artin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/B.+Mazur"} B. Mazur
              %em On the Van Kampen theorem
              , Topology 5 (1966) 179–189.
          %p
            The
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagonal+of+a+bisimplicial+set"} diagonal
            %a.existingWikiWord{:href => "/nlab/show/total+simplicial+set"} total simplicial set
            constructions are discussed in
          %ul#CegarraRemedios
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Antonio+Cegarra"}> Antonio Cegarra
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Josu%C3%A9+Remedios"} Josué Remedios
                = succeed "," do
                  %em The relationship between the diagonal and the bar constructions on a bisimplicial set
                = succeed "," do
                  %a{:href => "http://www.ugr.es/~acegarra/Paperspdfs/TRBDWC.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.topol.2004.12.003"} doi:10.1016/j.topol.2004.12.003
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Antonio+Cegarra"}> Antonio Cegarra
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Josu%C3%A9+Remedios"} Josué Remedios
                = succeed "," do
                  %em
                    The behaviour of the
                    = succeed "-construction" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                          %annotation{:encoding => "application/x-tex"} \bar W
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
                ,
                %em Décalage and Kan’s simplicial loop group functor
                (
                %a{:href => "http://arxiv.org/abs/1112.0474"}> arXiv:1112.0474
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Viktoriya+Ozornova"}> Viktoriya Ozornova
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Martina+Rovelli"} Martina Rovelli
                = succeed "," do
                  %em The unit of the total décalage adjunction
                %a{:href => "https://doi.org/10.1007/s40062-020-00257-1"} doi.org/10.1007/s40062-020-00257-1
          %p
            The diagonal-induced model structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ssSet
                %annotation{:encoding => "application/x-tex"} ssSet
            is discussed in
          %ul
            %li#Moerdijk
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              %em Bisimplicial sets and the group completion theorem
              in
              = succeed "," do
                %em Algebraic K-Theory: Connections with Geometry and Topology
          %p
            On the behaviour of fibrations under
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of bisimplicial sets:
          %ul
            %li#Anderson78
              %a.existingWikiWord{:href => "/nlab/show/Donald+Werner+Anderson"}> Donald Werner Anderson
              ,
              = succeed "," do
                %em Fibrations and geometric realization
              = succeed ")" do
                %a{:href => "http://projecteuclid.org/euclid.bams/1183541139"} euclid:1183541139
          %p
            Discussion of the
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{W}
            respecting
            %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            is in Fact 2.8 of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Antonio+Mart%C3%ADnez+Cegarra"}> Antonio Martínez Cegarra
              , Benjamın A. Heredia,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Josu%C3%A9+Remedios"} Josué Remedios
              = succeed "," do
                %em Double groupoids and homotopy 2-types
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1003.3820"} arXiv:1003.3820
