                %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
            the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                  %mo =
                  %msub
                    %mi 𝔽
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{F}_p
            a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
          %p
