                  %annotation{:encoding => "application/x-tex"} C^\ast
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : Bohr(A) \to Bohr(B)
              an essential geometric morphism, the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %munder
                      %mi B
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} f^\ast \underline{B}
              is naturally a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}(A), Set]
          .proof
            %h6#proof_2 Proof
            %p
              According to (
              %a{:href => "#HLSDeep"}> HLS09, 4.8
              ) every functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(A) \to C^\ast Alg
              is an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}(A), Set]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %munder
                      %mi B
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} f^* \underline{B}
              is such a functor, sending
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msub
                        %mi im
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C \in \mathcal{C}(A)) \mapsto im_f(C)
          %p
            Using this we now discuss morphisms of Bohr toposes in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"} C^\ast Topos
          #BohrFunctoriality.num_prop
            %h6#proposition_6 Proposition
            %p
              The construction of Bohr toposes from def.
              %a.maruku-ref{:href => "#TheSheafTopos"}
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bohr
                    %mo :
                    %msup
                      %mi C
                      %mo *
                    %msubsup
                      %mi Alg
                      %mi cr
                      %mi op
                    %mo →
                    %msubsup
                      %mi C
                      %mi com
                      %mo *
                    %mi TopSpace
                    %mo ↪
                    %msubsup
                      %mi C
                      %mi com
                      %mo *
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"}
                    Bohr
                    \:
                    C^\ast Alg_{cr}^{op}
                    \\to
                    C^\ast_{com} TopSpace
                    \\hookrightarrow
                    C^\ast_{com} Topos
            %p
              with the special property that any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              is sent to
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphisms"} essential geometric morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mo ⊣
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi Bohr
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Bohr
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*) : Bohr(B) \to Bohr(A)
                  with an extra
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Bohr
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mover
                          %mover
                            %mover
                              %munder
                                %mo ←
                                %mrow
                                  %msup
                                    %mi f
                                    %mo !
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi f
                                %mo !
                        %mi Bohr
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Bohr(B)
                        \\stackrel{\overset{f_!}{\to}}{\stackrel{\overset{f^*}{\leftarrow}}{\stackrel{\overset{f_*}{\to}}{\underset{f^!}{\leftarrow}}}}
                        Bohr(A)
              %li
                %p
                  such that the corresponding internal
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  of internal algebras
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi A
                          %mo ̲
                        %mo →
                        %msub
                          %mi f
                          %mo *
                        %munder
                          %mi B
                          %mo ̲
                      %annotation{:encoding => "application/x-tex"} \underline{A} \to f_* \underline{B}
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          %p
            This is (
            %a{:href => "#Nuiten11"}> Nuiten 11, lemma 2.7
            ). (Essentially this argument also appears as (
            %a{:href => "#vdBergHeunen"}> vdBergHeunen, prop. 33
            ), where however the extra right adjoint is not made use of and instead the variances of the morphisms involved in the definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo *
                  %mi Topos
                %annotation{:encoding => "application/x-tex"} C^\ast Topos
            are redefined in order to make the statement come out.)
          .proof
            %h6#proof_3 Proof
            %p
              To a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %msub
                      %mi Alg
                      %mi cr
                  %annotation{:encoding => "application/x-tex"} C^\ast Alg_{cr}
              which by prop.
              %a.maruku-ref{:href => "#CommutativityReflectionByAdjoints"}
              corresponds to an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %msub
                      %mi R
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi R
                            %mi f
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( \mathcal{C}(f) \dashv R_f) :
                    \\mathcal{C}(A)
                    \\stackrel{\overset{R_f}{\leftarrow}}{\underset{\mathcal{C}(f)}{\to}}
                    \\mathcal{C}(B)
            %p
              we assign the
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo ⊣
                    %msup
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ←
                            %mrow
                              %msup
                                %mi f
                                %mo !
                              %mo :
                              %mo =
                              %msub
                                %mi Ran
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi f
                                %mo *
                              %mo :
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo ∘
                              %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi f
                              %mo *
                            %mo :
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi R
                              %mi f
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo !
                          %mo :
                          %mo =
                          %msub
                            %mi Lan
                            %mrow
                              %msub
                                %mi R
                                %mi f
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (f_! \dashv f^* \dashv f_* \dashv f^!)
                    \:=
                    [\mathcal{C}(B), Set]
                    \\stackrel{\overset{f_! := Lan_{R_f}}{\longrightarrow}}{\stackrel{\overset{f^* := (-)\circ R_f}{\leftarrow}}{\stackrel{\overset{f_* := (-)\circ \mathcal{C}(f)}{\longrightarrow}}{\underset{f^! := Ran_{\mathcal{C}(f)}}{\leftarrow}}}}
                    [\mathcal{C}(A), Set]
            %p
              (wher
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lan
                  %annotation{:encoding => "application/x-tex"} Lan
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ran
                  %annotation{:encoding => "application/x-tex"} Ran
              denote left and right
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi f
                    %mo :
                    %munder
                      %mi A
                      %mo ̲
                    %mo →
                    %msub
                      %mi f
                      %mo *
                    %munder
                      %mi B
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_f : \underline{A} \to f_* \underline{B}
            %p
              which over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \in \mathcal{C}(A)
              is the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %a.existingWikiWord{:href => "/nlab/show/corestriction"} corestriction
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(f)(C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi C
                    %mo :
                    %mi C
                    %mo →
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f|_C : C \to \mathcal{C}(f)(C)
            %p
              (to the
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi C
                    %annotation{:encoding => "application/x-tex"} f|_C
          %p
            Using prop.
            %a.maruku-ref{:href => "#EssentialGeomMorphismsAndPosetMorphisms"}
            the above prop.
            %a.maruku-ref{:href => "#BohrFunctoriality"}
            has the following partial converse.
          #ToposCharacterizationOfAlgebraHomomorphisms.num_prop
            %h6#proposition_7 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                      %mo ∈
                      %msup
                        %mi C
                        %mo *
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} A, B \in C^\ast Alg
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : Bohr(B) \to Bohr(A)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} C^\ast Top
              for which
            %ol
              %li
                %p the underlying geometric morphism has an extra right adjoint
              %li
                %p
                  the morphism of internal algebras
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi A
                          %mo ̲
                        %mo →
                        %msub
                          %mi f
                          %mo *
                        %munder
                          %mi B
                          %mo ̲
                      %annotation{:encoding => "application/x-tex"} \underline{A} \to f_* \underline{B}
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            %p
              are in bijection with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    f : A \to B
            %p
              that are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %p
              In particular when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is already commutative, morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bohr(B) \to Bohr(A)
              with an extra right adjoint and epi ring homomorphism are in bijection with algebra homomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
          .proof
            %h6#proof_4 Proof
            %p
              By prop
              %a.maruku-ref{:href => "#EssentialGeomMorphismsAndPosetMorphisms"}
              every
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Alex
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Alex
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(Alex \mathcal{C}(A)) \to Sh(Alex \mathcal{C}(B))
              comes from a morphism of locales
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Alex
                      %mi 𝒞
                      %mi A
                      %mo →
                      %mi Alex
                      %mi 𝒞
                      %mi A
                    %annotation{:encoding => "application/x-tex"} Alex \mathcal{C}A \to Alex \mathcal{C}A
              %a.existingWikiWord{:href => "/nlab/show/Alexandroff+space"} Alexandroff space
              is equivalently a morphism of posets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}(f) : \mathcal{C}(A) \to \mathcal{C}(B)
              = succeed "," do
                %a.maruku-ref{:href => "#EssentialGeomMorphismsAndPosetMorphisms"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %msub
                      %mi R
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↔
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{C}(f) \dashv R_f) : \mathcal{C}(A) \leftrightarrow \mathcal{C}(B)
            %p
              that induces functors between toposes as in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#BohrFunctoriality"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a morphism of
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi C
                    %mo :
                    %mi C
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_C : C \to f(C)
            %p
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C \in \mathcal{C}(A)
            %p
              By the assumption that this are the components of an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/copresheaves"} copresheaves
              all these component morphisms are themselves epimorphisms and hence we have that indeed
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi image
                        %mrow
                          %msub
                            %mi f
                            %mi C
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(C) = image_{f_C}(C)
          %h2#KinematicsOnBohrTopos Kinematics in a Bohr topos
          %p
            A key aspect of the Bohr topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bohr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bohr(A)
            of a
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanical+system"} quantum mechanical system
            (as defined
            = succeed ")" do
              %a{:href => "#BohrToposOfQMSystem"} above
            %em classical
            %a.existingWikiWord{:href => "/nlab/show/kinematics"} kinematics
            and classical
            %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            of the commutative
            %em internal
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi A
                    %mo ̲
                  %mo ∈
                  %mi Bohr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \underline{A} \in Bohr(A)
            is the
            %em quantum
            %a.existingWikiWord{:href => "/nlab/show/kinematics"} kinematics
            and
            %a.existingWikiWord{:href => "/nlab/show/quantum+probability+theory"} quantum probability theory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            In fact, the very definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bohr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bohr(A)
            provides a formal context in which
            %a.existingWikiWord{:href => "/nlab/show/Gleason%27s+theorem"} Gleason's theorem
            has a natural formulation:
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Gleason’s theorem)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              a
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mi H
                      %mo &gt;
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} dim H \gt 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} A = B(H) \in C^\ast Alg
              its algebra of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
              %a.existingWikiWord{:href => "/nlab/show/state"} state
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi A
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\rho : A \to \mathbb{C}
            %p
              which is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              when restricted to each commutative subalgebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ⊂
                      %mi A
                    %annotation{:encoding => "application/x-tex"} C \subset A
          %p
            A function that preserves certain
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            locally – here: over each commutative subalgebra – is precisely an
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            fully structure preserving
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            in the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            over these local objects – here: over commutative subalgebras. Hence we have the following direct topos-theoretic equivalent reformulation of Gleason’s theorem.
          .num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} A = B(H) \in C^\ast Alg
              as above, we have a natural bijection between the quantum
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/state"} state
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the (classical) states of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi A
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{A}
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Bohr
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Bohr(H)
          %h3#ThePhaseSpace The phase space
          %p
            The idea is that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
