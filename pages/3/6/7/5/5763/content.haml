                    Sh (Alex(f))) : Sh(Alex \mathcal{C}(A)) \to Sh(Alex \mathcal{C}(B))
                    \\,.
          %p The next proposition asserts that all essential geometric morphisms between Bohr toposes arise this way:
          #EssentialGeomMorphismsAndPosetMorphisms.num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Poset
                    %mo ↪
                    %msub
                      %mi Topos
                      %mi ess
                  %annotation{:encoding => "application/x-tex"}
                    [-,Set] : Poset \hookrightarrow Topos_{ess}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+2-functor"} full and faithful 2-functor
            %p
              Analogously,
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bohr(A) \to Bohr(B)
              are precisely those in image under the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo ∘
                    %mi Alex
                  %annotation{:encoding => "application/x-tex"} Sh \circ Alex
              of functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}(A) \to \mathcal{C}(B)
          .proof
            %h6#proof Proof
            %p
              By the discussion in the section
              %em
                %a{:href => "http://ncatlab.org/nlab/show/Cauchy+complete+category#InOrdinaryCatTheoryByEssGeomMorphisms"} In terms of essential geometric morphisms
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete category
              we have a full and faithful embedding of Cauchy-complete catgeories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %msub
                        %mi Cat
                        %mi Cauchy
                      %mo ↪
                      %msub
                        %mi Topos
                        %mi ess
                    %annotation{:encoding => "application/x-tex"} [-,Set] : Cat_{Cauchy} \hookrightarrow Topos_{ess}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi Poset
                      %mo ↪
                      %msub
                        %mi Cat
                        %mi Cauchy
                      %mo ↪
                      %msub
                        %mi Topos
                        %mi ess
                    %annotation{:encoding => "application/x-tex"} [-,Set] : Poset \hookrightarrow Cat_{Cauchy} \hookrightarrow Topos_{ess}
            %p
              In terms of Alexandroff topologies: by the discussion of
              %a{:href => "http://ncatlab.org/nlab/show/specialization+topology#AlexandrovLocales"} Alexandroff locales
              (in the entry
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Alexandroff+space"} Alexandroff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Alex
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Poset
                    %mo →
                    %mi Locale
                  %annotation{:encoding => "application/x-tex"} Alex\colon Poset \to Locale
              takes values precisely on those morphisms of locales whose inverse image has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/localic+reflection"} localic reflection
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo :
                    %mi Locale
                    %mo →
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"} Sh : Locale \to Topos
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+2-functor"} full and faithful 2-functor
          %p
            For such essential geometric morphisms to be parts of morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
