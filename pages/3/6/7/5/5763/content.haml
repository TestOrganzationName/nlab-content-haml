                %strong 39
                6 (2000) 1413-1436 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/quant-ph/9911020"}> arXiv:quant-ph/9911020
                ,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1788498"} MR2001k:81016
                = succeed "&rbrack;" do
                  %a{:href => "http://dx.doi.org/10.1023/A:1003667607842"} doi:10.1023/A:1003667607842
              %p
                %em> IV. Interval valuations
                , Internat. J. Theoret. Phys.
                %strong 41
                4 (2002) 613-639 &amp;lbrack;
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1902067"}> MR2003g:81009
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://dx.doi.org/10.1023/A:1015276209768"} doi
          %p with some review and outlook in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Isham"}> Chris Isham
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jeremy+Butterfield"} Jeremy Butterfield
              = succeed "," do
                %em Some Possible Roles for Topos Theory in Quantum Theory and Quantum Gravity
              %strong 30
              (2000) 1707-1735 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/gr-qc/9910005"}> arXiv:gr-qc/9910005
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1023/A:1026406502316"} doi:10.1023/A:1026406502316
          %p and then
          %ul
            %li#IshamDoering07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andreas+D%C3%B6ring"}> Andreas Döring
                ,
