                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"} C^\ast Topos
            %a.maruku-ref{:href => "#CStarTopos"}
            we need that their
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            = succeed "-algebras:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
