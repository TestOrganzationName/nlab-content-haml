                          %mrow
                            %msup
                              %mi f
                              %mo *
                            %mo :
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi f
                      %mover
                        %mo ⟶
                        %mrow
