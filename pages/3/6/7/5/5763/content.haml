                        %mo ′
                        %mo ∈
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda' \in \Sigma(D)
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                          %mo ′
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi C
                          %mo =
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda'|_C = \lambda
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                          %mo ′
                          %mo ∈
                          %mi 𝒰
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi D
                        %annotation{:encoding => "application/x-tex"} \lambda' \in \mathcal{U}|_D
            %p
              Regarded equivalently as an
              %a.existingWikiWord{:href => "/nlab/show/internal+locale"} internal locale
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}(A))
              this
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              on the poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(A)
              this is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Σ
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi A
                      %mo ̲
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo ↦
                    %msub
                      %mi Σ
                      %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underline{\Sigma}(\underline{A})
                    \:
                    U \mapsto \Sigma_U
                    \\,,
            %p
              where for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{O}(\mathcal{C}(A))
              we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi U
                    %mo :
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi C
                        %mo ∈
                        %mi U
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_U := \coprod_{C \in U} \Sigma(C)
            %p
              with the relative topology inherited from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \Sigma_A
          %p
            This appears as (
            %a{:href => "#HLSW"}> HLSW, theorem 1
            ).
          #BohrificationDependsOnNormalElementsOnly.num_prop
            %h6#proposition_9 Proposition
            %p
              The Bohrification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ncCStar
                  %annotation{:encoding => "application/x-tex"} A \in ncCStar
              only depends on its
              %a{:href => "#PartialCStar"} partial C-star algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(A)
              of normal elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi A
                    %mo ≃
                    %msub
                      %mi Σ
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_A \simeq \Sigma_{N(A)}
                    \\,.
          %p
            This is highlighted in (
            %a{:href => "#vdBergHeunen"}> vdBergHeunen
            ).
          #ReproducingOrdinaryGelfandDuality.num_prop
            %h6#proposition_10 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi A
                      %mi Gelf
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \Sigma_A^{Gelf} \in
              %a.existingWikiWord{:href => "/nlab/show/Loc"} Loc
              its ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+spectrum"} Gelfand spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi A
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo ≃
                    %msubsup
                      %mi Σ
                      %mi A
                      %mi Gel
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^{\not \not}_A \simeq \Sigma_A^{Gel}
                    \\,.
          %p
            This is (
            %a{:href => "#Spitters06"}> Spitters06, theorem 9, corollary 10
            ).
          #FunctorToRingedToposes.num_prop
            %h6#proposition_11 Proposition
            %p
              Then the construction of the
              %a.existingWikiWord{:href => "/nlab/show/ringed+topos"} ringed topos
              over the
              %a.existingWikiWord{:href => "/nlab/show/poset+of+commutative+subalgebras"} poset of commutative subalgebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %munder
                      %mi A
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto ([\mathcal{C}(A), Set], \underline{A})
            %p extends to a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %msub
                      %mi Alg
                      %mi incl
                    %mo →
                    %msup
                      %mi C
                      %mo *
                    %mi TopSpace
                    %mo ↪
                    %msup
                      %mi C
                      %mo *
                    %mi Topos
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C^* Alg_{incl} \to C^*TopSpace \hookrightarrow C^* Topos
                    \\,,
            %p
              where on the right the morphisms of internal rings are even morphisms of internal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/C%2A+algebras"} C* algebras
          .proof
            %h6#proof_5 Proof
            %p With the components of the morphism of internal rings the evident objectwise inclusions, this is directly checked.
          #BohrificationFunctorToLoc.num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cstar
                      %mi inc
                  %annotation{:encoding => "application/x-tex"} Cstar_{inc}
              be the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"} C-star algebra
              %a{:href => "#Bohrification"} Bohrification
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi CStar
                      %mi inc
                      %mi op
                    %mo →
                    %mi Loc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_{(-)} : CStar_{inc}^{op} \to Loc
                    \\,.
          %p
            This is effectively the functoriality of the internal
            %a.existingWikiWord{:href => "/nlab/show/constructive+Gelfand+duality"} constructive Gelfand duality
            applied to the
            = succeed "." do
              %a{:href => "#FunctorToRingedToposes"} above observation
            = succeed ")." do
              %a{:href => "#vdBergHeunen"} vdBergHeunen, theorem 35
          %h3#TheObservables The observables
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi C
                    %mo *
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} A \in C^\ast Alg
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
            %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            a
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            is a
            = succeed "." do
              %em
                quantum
                %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are in a precise sense the
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\mathbb{R})
            for the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bohr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bohr(C(\mathbb{R}))
            as the incarnation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            in the context of Bohr toposes.
          .num_prop
            %h6#proposition_13 Proposition
            %p
              Morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : Bohr(A) \to Bohr(C(\mathbb{R})_0)
              with an extra right adjoint and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo →
                    %msub
                      %mi f
                      %mo *
                    %munder
                      %mi A
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} C(\mathbb{R})_0 \to f_*\underline{A}
              epi are in bijection to the observables on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ToposCharacterizationOfAlgebraHomomorphisms"}
              such morphisms are in bijection to algebra homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo →
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C(\mathbb{R})_0 \to A
                    \\,.
            %p
              By
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/functional+calculus"} functional calculus
              %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              provides such a homomorphism by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \mapsto f(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi x
                    %mo ↦
                    %mi x
                  %annotation{:encoding => "application/x-tex"} i : x \mapsto x
              is a self-adjoint operator in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_remark
            %h6#remark_5 Remark
            %p
              In the different but related context of the
              %a.existingWikiWord{:href => "/nlab/show/spectral+presheaf"} spectral presheaf
              (
              %a{:href => "#IshamDoering07"}> Isham-Döring 07
              ) the identification of
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              with a topos-theoretic construction, as far as possible, has been called “
              %a.existingWikiWord{:href => "/nlab/show/daseinisation"}> daseinisation
              ”. This is a bit more involved than the above direct characterization in terms of maps of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ringed+toposes"} ringed toposes
          .num_remark
            %h6#remark_6 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x_{t_1} \in A
              be an observable and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle x_{t_1} \rangle
              for the subalgebra generated by it. Then (by general properties of
              = succeed ")" do
                %a{:href => "#http://ncatlab.org/nlab/show/over-topos#PresheafOverTopos"} presheaf over-toposes
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi x
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} Bohr(A)_{/\langle x_{t_1}\rangle}
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bohr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi x
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} ⟩
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Bohr(A)_{/\langle x_{t_1}\rangle}
                    \\simeq
                    [\langle x_{t_1}\rangle_{/\mathcal{C}(A)}, Set]
                    \\,,
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/copresheaves"} copresheaves
              over the
              %a.existingWikiWord{:href => "/nlab/show/under-category"} under-category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi x
                        %mrow
                          %msub
                            %mi t
                            %mn 1
                      %msub
                        %mo{:stretchy => "false"} ⟩
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \langle x_{t_1}\rangle_{/\mathcal{C}(A)}
