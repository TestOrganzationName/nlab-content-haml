              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1109.1192"}> arXiv:1109.1192
              \&amp;rbrack;
          %p
            A variant of the Bohr topos construction meant to take more of the topology of the underlying
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "-algebra" do
