          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mn 1
                  %mo ,
                  %msub
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mn 1
                  %mo ,
