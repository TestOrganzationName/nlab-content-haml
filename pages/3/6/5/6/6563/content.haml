              closes with only a finite number of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              = succeed "s" do
                %span.newWikiWord
                  critical exponent
                  %a{:href => "/nlab/new/critical+exponent"} ?
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/correlation+function"} correlation function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 1
