                      %mi p
                      %mo =
                      %mi λ
                      %mi x
                      %mo .
                      %mi λ
                      %mi y
                      %mo .
                      %mi λ
                      %mi z
                      %mo .
                      %mi z
                      %mi x
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p = \lambda x. \lambda y. \lambda z. z x y
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
