                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  r(p a a') &amp; = &amp; (\lambda z. z a a')(\lambda x. \lambda y. y) \\
                  \&amp; = &amp; (\lambda x. \lambda y. y) a a' \\
                  \&amp; = &amp; (\lambda y. y) a' = a'
                  }
          %p
            That out of the way, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(A)
            be the power set of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a set. Put a preorder structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
