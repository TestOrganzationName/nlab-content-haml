          %h2#idea Idea
          %p
            A partial combinatory algebra is a generalization of a model of the
            %a.existingWikiWord{:href => "/nlab/show/untyped+lambda+calculus"} untyped lambda calculus
            allowing for application to be only partially defined. It is often expressed as an algebraic abstraction of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatory+logic"} combinatory logic
          %h2#definition Definition
          %p
            The following definitions are taken from
            = succeed "." do
              %a{:href => "#Hofstra"} Hofstra
          %p
            A
            %em partial applicative structure
            is a set equipped with a partial binary operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ×
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} m \colon A \times A \to A
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/function+application"} application
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is indicated by juxtaposition:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                %annotation{:encoding => "application/x-tex"} a b
            denotes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(a, b)
            if (and only if)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(a, b)
            is defined, i.e., if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b)
            belongs to the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %em Homomorphisms
            between partial applicative structures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A, B
            are defined to be total functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f \colon A \to B
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(a b) = f(a)f(b)
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of sets and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi f
                              %mo ×
                              %mi f
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                      %mtr
                        %mtd
                          %mi m
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ≤
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mi m
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %munder
                            %mo →
                            %mi f
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A \times A &amp; \stackrel{f \times f}{\to} &amp; B \times B \\
                  m \downarrow &amp; \leq &amp; \downarrow m \\
                  A &amp; \underset{f}{\to} &amp; B
                  }
          %p
            By convention, unbracketed juxtapositions are associated to the left, so that for example
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} x y z
            means
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mi z
                  %annotation{:encoding => "application/x-tex"} (x y)z
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a partial applicative structure and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Magma
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Magma}(A)
            is the free
            %a.existingWikiWord{:href => "/nlab/show/magma"} magma
            on the underlying set of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Magma
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \alpha \colon \mathbf{Magma}(A) \to A
          %p
            which evaluates binary words in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as elements in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .num_defn
            %h6#definition_2 Definition
            %p
              A partial applicative structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %em partial combinatory algebra
              (a
              = succeed ")" do
                %strong PCA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi s
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} k, s \in A
              such that
            %ul
              %li
                For all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a, b \in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi a
                    %annotation{:encoding => "application/x-tex"} k a
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi a
                      %mi b
                    %annotation{:encoding => "application/x-tex"} k a b
                are defined and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mi a
                        %mi b
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} k a b = a
              %li
                For all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a, b \in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi a
                    %annotation{:encoding => "application/x-tex"} s a
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi a
                      %mi b
                    %annotation{:encoding => "application/x-tex"} s a b
                are defined and for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a c)(b c)
                is defined if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi a
                      %mi b
                      %mi c
                    %annotation{:encoding => "application/x-tex"} s a b c
                is defined, and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mi a
                        %mi b
                        %mi c
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s a b c = (a c)(b c)
            %p
              A
              %em homomorphism
              of PCA’s is a homomorphism of the underlying partial applicative structures.
            %p
              A
              %em total
              combinatory algebra is a PCA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              whose application
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} m \colon A \times A \to A
              is a total function.
          %p
            Note that appropriate elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            are not considered part of the structure (to be preserved under homomorphism) – here one is interested only in the property that such elements exist. Indeed, they need not be uniquely determined within the PCA.
          %h2#functional_completeness Functional completeness
          %p
            The definition of PCA given above is traditional but somewhat opaque at first glance. The real point of the definition is that a PCA is the same thing as a partial applicative structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that enjoys a
            %em functional completeness
            property, in the following sense.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a countably infinite set of “variables”, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A[X]
            denote the
            %a.existingWikiWord{:href => "/nlab/show/magma"} magma
            freely generated from the disjoint sum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo +
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A + X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} t \in A[X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x_i \in X
            occurring inside it; these are called the
            %em free variables
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FV
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} FV(t)
            for the set of free variables. If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FV
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} FV(t) \subseteq \{x_0, x_1, \ldots, x_n\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            as giving a partially defined function in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            variables. That is, we may consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            as a term of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Magma
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Magma}(A + \{x_0, \ldots, x_n\})
            %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi a
                    %mn 0
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} t[a_0/x_0, \ldots, a_n/x_n]
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_0, \ldots, a_n
            are elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            of the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Magma
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo +
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Magma
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi Magma
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi α
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{Magma}(A + \{x_0, \ldots, x_n\}) \stackrel{\mathbf{Magma}(\phi)}{\to} \mathbf{Magma}(A) \stackrel{\alpha}{\to} A
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} \phi(x_i) = a_i
            and is elsewhere the identity.
          %p
            Then, we say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %em functionally complete
            if every term
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} t \in A[X]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FV
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} FV(t) \subseteq \{x_0, \ldots, x_n\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            such that
          %ul
            %li
              %p
                For all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mn 0
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi a
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a_0, \ldots, a_{n-1} \in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msub
                        %mi a
                        %mn 0
                      %mi …
                      %msub
                        %mi a
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} a a_0 \ldots a_{n-1}
                is defined;
            %li
              %p
                For all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mn 0
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi a
                          %mi n
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a_0, \ldots, a_n \in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi a
                        %mn 0
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} t[a_0/x_0, \ldots, a_n/x_n]
                is defined precisely when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msub
                        %mi a
                        %mn 0
                      %mi …
                      %msub
                        %mi a
                        %mi n
                    %annotation{:encoding => "application/x-tex"} a a_0 \ldots a_n
                is defined, and these two elements are equal.
          %p
            For example, if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            are elements which realize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a PCA, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            represents the term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %msub
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} t = x_0
            viewed as belonging to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Magma
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Magma}(A + \{x_0, x_1\})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            represents the term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %msub
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %msub
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_0 x_2)(x_1 x_2)
            viewed as belonging to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Magma
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{Magma}(A + \{x_0, x_1, x_2)\}
          .num_theorem
            %h6#theorem Theorem
            %p A partial combinatory algebra is functionally complete.
          .proof
            %h6#proof Proof
            %p
              The idea is to simulate
              = succeed "-abstraction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mi x
                      %mo .
                      %mi t
                    %annotation{:encoding => "application/x-tex"} \lambda x. t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is a variable and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              is a term, by induction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi s
                  %annotation{:encoding => "application/x-tex"} k, s
              that realize
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as a PCA, put
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi λ
                            %mi x
                            %mo .
                            %mi x
                          %mtd
                            %mo ≔
                          %mtd
                            %mi s
                            %mi k
                            %mi k
                          %mtd
                        %mtr
                          %mtd
                            %mi λ
                            %mi x
                            %mo .
                            %mi t
                          %mtd
                            %mo ≔
                          %mtd
                            %mi k
                            %mi t
                          %mtd
                            %mi if
                            %mi x
                            %mo ∉
                            %mi FV
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi λ
                            %mi x
                            %mo .
                            %mi t
                            %mi t
                            %mo ′
                          %mtd
                            %mo ≔
                          %mtd
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mi x
                            %mo .
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mi x
                            %mo .
                            %mi t
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\lambda x. x &amp; \coloneqq &amp; s k k &amp; \\
                    \\lambda x. t &amp; \coloneqq &amp; k t &amp; if  x \notin FV(t) \\
                    \\lambda x. t t' &amp; \coloneqq &amp; s(\lambda x. t)(\lambda x. t')
                    }
            %p
              One then proves equality of partial functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo .
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} (\lambda x. t)(a) = t[a/x]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
          %p
            %a{:href => "#Hofstra"} Hofstra
            %em defines
            a PCA to be a functionally complete partial applicative structure. This is an unbiased definition, in the sense that it does not privilege certain elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            (or, for that matter, any other system of combinators that provide functional completeness).
          %h3#ExamplesOfCombinators Examples of combinators
          %ol
            %li
              %p
                Let us check that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi k
                      %mi k
                    %annotation{:encoding => "application/x-tex"} s k k
                indeed represents the identity function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a \in A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi k
                      %mi k
                      %mi a
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                      %mo .
                    %annotation{:encoding => "application/x-tex"} s k k a = (k a)(k a) = a.
            %li
              %p
                Consider the second projection function, corresponding to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi Magma
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo +
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x_1 \in \mathbf{Magma}(A + \{x_0, x_1\})
                = succeed "-terms," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mi x
                        %mo .
                        %mi λ
                        %mi y
                        %mo .
                        %mi y
                        %mo =
                        %mi λ
                        %mi x
                        %mo .
                        %mi s
                        %mi k
                        %mi k
                        %mo =
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mi k
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda x. \lambda y. y = \lambda x. s k k = k(s k k)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mi I
                      %annotation{:encoding => "application/x-tex"} k I
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi I
                      %mi a
                      %mi b
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mi b
                      %mo =
                      %mi I
                      %mi b
                      %mo =
                      %mi b
                      %mo .
                    %annotation{:encoding => "application/x-tex"} k I a b = ((k I) a) b = I b = b.
            %li
              %p Following the proof of functional completeness, we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mi x
                      %mo .
                      %mi x
                      %mi x
                      %mo =
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi s
                      %mi I
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \lambda x. x x = s(\lambda x. x)(\lambda x. x) = s I I
            %li#FinallyClassicalConstruction
              %p
                Finally, consider the classical construction of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fixed-point+combinator"} fixed-point combinator
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo =
                        %mi λ
                        %mi y
                        %mo .
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mi x
                        %mo .
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mi x
                        %mo .
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y = \lambda y. (\lambda x. y(x x))(\lambda x. y(x x))
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mi x
                      %mo .
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo .
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi x
                      %mo .
                      %mi x
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mi I
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda x. y(x x) = s(\lambda x. y)(\lambda x. x x) = s(k y)(s I I)
              %p which means
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Y
                            %mtd
                              %mo =
                            %mtd
                              %mi λ
                              %mi y
                              %mo .
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                            %mtd
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mi y
                              %mo .
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi λ
                              %mi y
                              %mo .
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                            %mtd
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mi y
                              %mo .
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mi y
                              %mo .
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                            %mtd
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mi k
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mi I
                              %mi I
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Y &amp; = &amp; \lambda y. (s I I)(s(k y)(s I I)) \\
                      \&amp; = &amp; s(\lambda y. s I I)\big(\lambda y. s(k y)(s I I)\big) \\
                      \&amp; = &amp; s(k (s I I)) \big(s(\lambda y. s(k y))(\lambda y. s I I)\big) \\
                      \&amp; = &amp; s(k (s I I)) \big(s(s(k s)k)(k (s I I))\big)
                      }
          %h2#examples_of_pcas Examples of PCAs
          %ol
            %li
              %p
                (Kleene’s first algebra.) Suppose given a coding of all
                %a.existingWikiWord{:href => "/nlab/show/partial+recursive+functions"} partial recursive functions
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mi k
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}^k \to \mathbb{N}
                (ranging over
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo ,
                        %mi …
                      %annotation{:encoding => "application/x-tex"} k = 0, 1, 2, \ldots
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}^k
                over all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                by elements of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                      %mo ×
                      %mi ℕ
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N} \times \mathbb{N} \to \mathbb{N}
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi p
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi q
                      %mo{:stretchy => "false"} ]
