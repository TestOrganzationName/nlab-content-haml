          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The preorder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi X
                  %annotation{:encoding => "application/x-tex"} P(A)^X
              has finite products, finite coproducts, and is cartesian closed. In other words, the preorder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi X
                  %annotation{:encoding => "application/x-tex"} P(A)^X
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heyting+prealgebra"} Heyting prealgebra
          .proof
            %h6#proof_2 Proof
            %p
              An initial object is given by the constant function taking each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to the empty subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ⊆
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \emptyset \subseteq A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to the full subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \subseteq A
            %p
              Take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f, g \colon X \to P(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∧
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mi a
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo ∈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi a
                    %mo ′
                    %mo ∈
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (f \wedge g)(x) = \{p a a' | a \in f(x) \wedge a' \in g(x)\}
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              realizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∧
                    %mi g
                    %mo ≤
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f \wedge g \leq f
              (since
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mi a
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} l (p a a') = a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∧
                      %mi g
                      %mo ≤
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \wedge g \leq g
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h \colon X \to P(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} t \in A
              realizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ≤
                    %mi f
                  %annotation{:encoding => "application/x-tex"} h \leq f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} u \in A
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ≤
                      %mi g
                    %annotation{:encoding => "application/x-tex"} h \leq g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mi λ
                    %mi b
                    %mo .
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v = \lambda b. p (t b)(u b)
            %p
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ≤
                      %mi f
                      %mo ∧
                      %mi g
                    %annotation{:encoding => "application/x-tex"} h \leq f \wedge g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∧
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \wedge g
              is a product in the preorder.
            %p For binary coproducts, define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∨
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mi l
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo ∈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mi r
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo ′
                    %mo ∈
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (f \vee g)(x) = \{p l a | a \in f(x)\} \cup \{p r a' | a' \in g(x)\}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi l
                  %annotation{:encoding => "application/x-tex"} p l
              realizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mi f
                    %mo ∨
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \leq f \vee g
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi r
                  %annotation{:encoding => "application/x-tex"} p r
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≤
                      %mi f
                      %mo ∨
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g \leq f \vee g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              realizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f \leq h
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≤
                      %mi h
                    %annotation{:encoding => "application/x-tex"} g \leq h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mi λ
                    %mi b
                    %mo .
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v = \lambda b. l(b)(p(t(r b))(u(r b)))
            %p
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∨
                      %mi g
                      %mo ≤
                      %mi h
                    %annotation{:encoding => "application/x-tex"} f \vee g \leq h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi v
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mi l
                            %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mi l
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mi l
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mi l
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mi l
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi l
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi t
                            %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    v(p l a) &amp; = &amp; l(p l a)(p(t(r(p l a)))(u(r(p l a)))) \\
                    \&amp; = &amp; l(p(t a)(u a)) \\
                    \&amp; = &amp; t a
                    }
            %p
              and similarly
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mi r
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi u
                      %mi a
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} v(p r a') = u a'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v(b)
              lives in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(x)
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ∨
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in (f \vee g)(x)
            %p For cartesian closure, define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⇒
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mo ∀
                    %mi a
                    %mo ∈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi a
                    %mo ′
                    %mi a
                    %mo{:stretchy => "false"} ↓
                    %mo ∧
                    %mi a
                    %mo ′
                    %mi a
                    %mo ∈
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (f \Rightarrow g)(x) = \{a' | \forall a \in f(x) a' a \downarrow \wedge a' a \in g(x)\}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ′
                    %mi a
                    %mo{:stretchy => "false"} ↓
                  %annotation{:encoding => "application/x-tex"} a' a \downarrow
              is standard shorthand for “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ′
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a' a
              is defined”. Then for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi b
                    %mo .
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda b. l(b)r(b)
              realizes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ⇒
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi f
                      %mo ≤
                      %mi g
                    %annotation{:encoding => "application/x-tex"} (f \Rightarrow g) \wedge f \leq g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi b
                    %mo .
                    %mi λ
                    %mi a
                    %mo .
                    %mi p
                    %mi a
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \lambda b. \lambda a. p a b
              realizes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≤
                      %mi f
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ∧
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \leq f \Rightarrow (f \wedge g)
          %p
            For any function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi Y
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} P(A)^f \colon P(A)^Y \to P(A)^X
          %p is a functor preorder map that preserves Heyting prealgebra structure.
          %p
            Furthermore, in the case of a projection map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Z
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon Z \times Y \to Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Y
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Z
                        %mo ×
                        %mi Y
                    %mo{:stretchy => "false"} (
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Z
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(A)^f \colon P(A)^Y \to P(A)^{Z \times Y} (\cong (P(A)^Z)^Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi Z
                %annotation{:encoding => "application/x-tex"} P(A)^Z
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(A)
