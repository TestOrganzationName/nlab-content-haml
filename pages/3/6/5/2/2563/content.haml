          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/D%3D3+supergravity"} D=3 supergravity
            in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9-Regge+formulation+of+supergravity"} D'Auria-Fré-Regge formulation
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"} Roberto Catenacci
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+A.+Grassi"} Pietro A. Grassi
              = succeed "," do
                %em The Integral Form of Supergravity
