              49 (2016) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/JHEP10(2016)049"}> doi:10.1007/JHEP10(2016)049
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1607.05193"} arXiv:1607.05193
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/supersymmetric+quantum+mechanics"} supersymmetric quantum mechanics
            in the perspective of
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            (
            %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"}> integration over supermanifolds
            ,
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/picture+changing+operators"} picture changing operators
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
