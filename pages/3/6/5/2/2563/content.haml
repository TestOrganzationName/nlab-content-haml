          %h2#selected_writings Selected writings
          %p
            On the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fre formulation of supergravity
            %a.existingWikiWord{:href => "/nlab/show/pure+spinors"} pure spinors
            and the
            %a.existingWikiWord{:href => "/nlab/show/supermembrane"} supermembrane
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"}> Pietro Fré
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
              = succeed "," do
                %em Pure spinors, free differential algebras, and the supermembrane
              = succeed ")" do
                %a{:href => "http://www.arxiv.org/abs/hep-th/0606171"} arXiv:hep-th/0606171
          %p
            On the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fre formulation of supergravity
            %a.existingWikiWord{:href => "/nlab/show/rheonomy"} rheonomy
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pure+spinors"} pure spinors
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"}> Pietro Fré
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
                %em Free differential algebras, rheonomy, and pure spinors
                (
                %a{:href => "http://www.arxiv.org/abs/0801.3076"}> arXiv:0801.3076
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"}> Riccardo D'Auria
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+A.+Grassi"} Pietro A. Grassi
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Trigiante"} Mario Trigiante
                = succeed "," do
                  %em Pure Spinor Superstrings on Generic type IIA Supergravity Backgrounds
                %strong 2008
                07 (2008) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0803.1703"}> arXiv:0803.1703
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2008/07/059"} doi:10.1088/1126-6708/2008/07/059
              %blockquote
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/type+IIA+supergravity"}> type IIA supergravity
                  )
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            on
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            (in terms of
            %a.existingWikiWord{:href => "/nlab/show/picture+changing+operators"} picture changing operators
            and integral top-forms for
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"} integration over supermanifolds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"} Roberto Catenacci
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
              = succeed "," do
                %em Hodge Dualities on Supermanifolds
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1507.01421"} arXiv:1507.01421
          %p
            and generally in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Berezin+integration"} Berezin integration
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"} Roberto Catenacci
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
              %em The Hodge Operator Revisited
              (
              %a{:href => "https://arxiv.org/abs/1511.05105"}> arXiv:1511.05105
              )
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D7+supergravity"} D=7 supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"}> Pietro Fré
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lucrezia+Ravera"} Lucrezia Ravera
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mario+Trigiante"} Mario Trigiante
              = succeed "," do
                %em
