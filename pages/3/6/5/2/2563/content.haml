            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"} integration over supermanifolds
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms+on+supermanifolds"} differential forms on supermanifolds
            and on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/picture+changing+operators"} picture changing operators
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Grassi"}> Pietro Grassi
                ,
                = succeed "," do
                  %em Integral Forms and Applications
                = succeed "," do
                  %a{:href => "https://agenda.infn.it/event/8823/attachments/55101/64989/Grassi-SL.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/GrassiIntegralForms2015.pdf", :title => "pdf"} pdf
            %li#CatenacciGrassiNoja18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"}> Roberto Catenacci
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Grassi"} Pietro Grassi
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simone+Noja"} Simone Noja
                = succeed "," do
                  %em Superstring Field Theory, Superforms and Supergeometry
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1807.09563"} arXiv:1807.09563
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"} integration over supermanifolds
            and
            %a.existingWikiWord{:href => "/nlab/show/picture+changing+operators"} picture changing operators
