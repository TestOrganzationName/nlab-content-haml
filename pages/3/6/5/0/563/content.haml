          %p
            A pseudofunctor is
            %strong strict
            if the structural isomorphisms for identities of 1-cells and composites are identity 2-cells.
          %h3#composition_of_pseudofunctors Composition of Pseudofunctors
          %p
            The composite of two pseudofunctors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi ℭ
                    %mo →
                    %mi 𝔇
                  %annotation{:encoding => "application/x-tex"} P:\mathfrak{C}\to\mathfrak{D}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mi 𝔅
                  %mo →
                  %mi ℭ
                %annotation{:encoding => "application/x-tex"} Q:\mathfrak{B}\to\mathfrak{C}
            is defined as follows:
          %ol
            %li
              Action on objects is given by function composition, so
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ∘
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      P\circ Q(X)=P(Q(X))
            %li
              Hom functors are given by functor composition, so
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ∘
                      %mi Q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi XY
                      %mo =
                      %msub
                        %mi P
                        %mi XY
                      %mo ∘
                      %msub
                        %mi Q
                        %mi XY
                    %annotation{:encoding => "application/x-tex"}
                      (P\circ Q)_{XY}=P_{XY}\circ Q_{XY}
            %li
              For each object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} X\in\mathfrak{B}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ∘
                      %mi Q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi id
                            %mi X
                      %mo =
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Q
                        %mrow
                          %msub
                            %mi id
                            %mi X
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi P
                        %mrow
                          %msub
                            %mi id
                            %mrow
                              %mi Q
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (P\circ Q)_{id_X}=P(Q_{id_X})\circ P_{id_{Q(X)}}
            %li
              For each pair of composable arrows
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Y
                      %mo →
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} f:Y\to Z
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                      %mo ∈
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} g:X\to Y\in\mathfrak{B}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ∘
                      %mi Q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                      %mo =
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Q
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi P
                        %mrow
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Q
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (P\circ Q)_{f,g}=P(Q_{f,g})\circ P_{Q(f),Q(g)}
          %p
            Coherence diagrams commute as a consequence of the coherence diagrams for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            commuting.
          %h2#pseudofunctors_versus_lax_functors Pseudofunctors versus lax functors
          %p
            If we remove the requirement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mi x
                %annotation{:encoding => "application/x-tex"} P_{\id_x}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_{x,y,z}(f,g)
            be invertible, then we have the definition of
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax functor
          %p
            If in the definition of lax functor we reverse the direction of the constraints, then we have an
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/oplax+functor"} oplax functor
            %em inverses
            of the constraints of a pseudofunctor, we obtain an oplax functor. Because there is little difference between specifying an invertible morphism and specifying its invertible inverse, one could equally well define a pseudofunctor to be an oplax functor whose constraints are invertible (i.e. reverse the direction of the isomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mi x
                %annotation{:encoding => "application/x-tex"} P_{\id_x}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mi x
