            )
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              \-category
            is simply a
            %a.existingWikiWord{:href => "/nlab/show/category+enriched"} category enriched
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T, L)
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
