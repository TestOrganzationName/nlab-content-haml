          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relative+category"} relative category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/F-category"} F-category
          %h2#references References
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
