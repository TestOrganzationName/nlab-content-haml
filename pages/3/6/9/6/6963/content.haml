            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mo →
                %annotation{:encoding => "application/x-tex"} Set^\to
            (the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/product-preserving+functor"} preserves products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
