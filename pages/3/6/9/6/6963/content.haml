                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            as the category of
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            inclusions) in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Power"} John Power
              (2002),
              = succeed "," do
                %em Premonoidal categories as categories with algebraic structure
              = succeed "." do
                %a{:href => "http://www.inf.ed.ac.uk/publications/online/0413.pdf"} pdf
          %p
            We discussed them in the
            %a.existingWikiWord{:href => "/nlabmeta/show/n-Forum"} n-Forum
            as part of a discussion of the category of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mark+Meckes"} Mark Meckes
              et al. (2011), Banach space, n-Forum, (
