                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/2-category"} categories
            is the concept of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/F-category"} category
            = succeed "-enriched" do
