            %a.existingWikiWord{:href => "/nlab/show/separated+presheaves"} separated presheaves
            for the
            %a.existingWikiWord{:href => "/nlab/show/double+negation+topology"} double negation topology
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
