          %h2#def Definitions
          %p#mono
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            (or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mono
                  %annotation{:encoding => "application/x-tex"} Mono
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            %a.existingWikiWord{:href => "/nlab/show/injections"} injections
            (
            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            in the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+squares"} commutative squares
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            is a
