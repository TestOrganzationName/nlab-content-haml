              %li
                %a{:href => "#quantale_congruences_and_nuclei"} Quantale congruences and nuclei
              %li
                %a{:href => "#enrichment_over_quantales"} Enrichment over quantales
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#quantales"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
                  \-quantales
              %li
                %a{:href => "#RelationToLinearLogic"} Relation to linear logic
              %li
