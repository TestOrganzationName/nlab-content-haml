                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            = succeed "." do
              %a{:href => "#ReferencesRelationToVonNeumannAlgebras"} references below
          %p
            To make this work correctly, we cannot simply define localizability as a
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            of measurable spaces; instead, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/localizable+measurable+space"} localizable measurable space
            is a measurable space (a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/%CF%83-ideal"} σ-ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒩
                %annotation{:encoding => "application/x-tex"} \mathcal{N}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{P}X
            simultaneously (called the ideal of
            %strong negligible sets
            or
            = succeed ")" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/null+sets"} null sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} /
                  %mi 𝒩
                %annotation{:encoding => "application/x-tex"} \Sigma/\mathcal{N}
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete lattice
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of localizable measurable spaces is a measurable function, with the property that the
            %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
            of any null set is null, up to an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≅
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \cong g
            if for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ∈
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} m\in\Sigma
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi m
                  %mo ⊕
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi m
                %annotation{:encoding => "application/x-tex"} f^{-1}m\oplus g^{-1}m
            is a null set. For good properties of point-set measurable maps, we need to add the property of
            %strong strict localizability
            and
            = succeed "." do
              %strong compactness
            %a.existingWikiWord{:href => "/nlab/show/categories+of+measure+theory"} categories of measure theory
            for full details.
          %p
            The requirement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} /
                  %mi 𝒩
                %annotation{:encoding => "application/x-tex"} \Sigma/\mathcal{N}
            be complete is the real localizability condition here; the trick of equipping a measurable space with a
            = succeed "-ideal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/full+sets"} full sets
          %p
            Localizable measurable spaces can also be studied via the lattice
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} /
                    %mi 𝒩
                  %annotation{:encoding => "application/x-tex"} \Sigma/\mathcal{N}
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extra+property"} extra property
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/measurable+locales"} measurable locales
          %h3#relation_to_boolean_toposes Relation to Boolean toposes
          %p
            In terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            %a.existingWikiWord{:href => "/nlab/show/Boolean+toposes"} Boolean toposes
            (e.g.
            = succeed "," do
              %a{:href => "#Jackson06"} Jackson 06
            = succeed ")." do
              %a{:href => "#Henry14"} Henry 14
          %h2#in_alternative_foundations In alternative foundations
          %p
            While Lebesgue measure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            can be done in very weak
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set-theoretic
            machinery. Indeed, not much seems to be possible in
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
            contexts, and the (nonpredicative)
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            theory is noticeably more complicated than the classical theory. On the other hand, the classical theory has its own complications, with nonmeasurable sets and functions that can be proved to exist but which seem to never arise in practice. Instead, there are classically false but apparently consistent foundations in which measure theory is extremely simple.
          %h3#Predicative Predicative theory
          %p
            The main problem for measure theory in
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
            is getting your hands on a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
            %em are
            ways to describe the Lebesgue-measurable sets predicatively, but these do not seem to generalise to a broader theory.)
          %p
            Note that there is no real problem in describing what, say, an open set is. Not only can this be done for the real line in the usual
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            way, but it is easy to take
            %em any
            collection of subsets of any set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
            generated by that subbase. The reason is that there are only two steps in moving from a subbase to a topology, and while the latter step is too impredicative to allow one to speak of the
            %em set
            of all open sets, it's OK if you only want to talk about
            %em individual
            open sets. (To be explicit: given a collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be used as subbase, a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            %em open
            if, for every point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} x \in G
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A_1, \ldots, A_n
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} x \in A_i
            for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and, for every point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} y \in A_i
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} y \in G
          %p
            This cannot be done with
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi δ
                %annotation{:encoding => "application/x-tex"} G_\delta
            sets and the like, but to define a Borel set we need to quantify over all countable ordinals. While it is possible to hypothesise the existence of an uncountable ordinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_1
            and be predicative ‘over’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_1
            (and after all, everything else in this section is only predicative over the first infinite ordinal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \omega_0
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+infinity"} axiom of infinity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_1
            as the
            %a.existingWikiWord{:href => "/nlab/show/Hartog%27s+number"} Hartog's number
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \omega_0
            uses
            = succeed "s;" do
              %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            %a.existingWikiWord{:href => "/nlab/show/well-ordering+theorem"} well-ordering theorem
            to the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                %annotation{:encoding => "application/x-tex"} \mathbf{N}^{\mathbf{N}}
            doesn't seem to use reasoning that requires the existence of power sets as long as you don't also throw in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
          %p
            So as far as I (
            %a.existingWikiWord{:href => "/nlab/show/Toby+Bartels"}> Toby Bartels
            ) can tell, there is no general predicative theory of measurable spaces, only an ad hoc theory of Lebsegue measurability. I would be delighted to learn otherwise!
          %h3#constructive_theory Constructive theory
          %p
            From a constructive perspective, there are a couple of related problems with the classical theory. One is that the notion of
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "ation," do
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            that
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            uses. The other is that, even you acept the definition of
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            Indeed, if we set aside the general theory of measurable spaces and simply do Lebesgue measure ad hoc in a constructive (even predicative) way, we find that instead of measurable
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            we really want measurable
            %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            whose domain of definition is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+set"} full set
          %p
            There is a way out, due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Henry+Cheng"} Henry Cheng
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+sets"} disjoint sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \cup B
            is full —with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\neg{A})
            being the motivating example in the classical theory—, but we let the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            See details at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cheng+space"} Cheng space
          %p
            There are also other approaches to constructive measure theory, such as
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
            = succeed "\u2019s" do
              %a.existingWikiWord{:href => "/nlab/show/Erik+Palmgren"} Erik Palmgren
            = succeed "." do
              %span.newWikiWord
                metric Boolean algebra
                %a{:href => "/nlab/new/metric+Boolean+algebra"} ?
          %h3#in_dream_mathematics In dream mathematics
          %p
            While measure theory only gets more complicated in constructive mathematics, it becomes much easier in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dream+mathematics"} dream mathematics
          %p … more coming …
          %h3#pointfree_measurable_spaces Point-free measurable spaces
          %p
            Just like how in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point-free+topology"} point-free topology
            %a.existingWikiWord{:href => "/nlab/show/opens"} opens
            to be fundamental and defines a
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} frame of opens
            %a.existingWikiWord{:href => "/nlab/show/sigma-complete+Boolean+algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              \-complete Boolean algebra
            of measurables.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/measurable+locale"} measurable locale
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/noncommutative+measurable+space"} noncommutative measurable space
          %h2#references References
          %h3#general General
          %p
            For
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Henry+Cheng"} Henry Cheng
          %ul
            %li#BishopBridges
              %p
                %a.existingWikiWord{:href => "/nlab/show/Errett+Bishop"}> Errett Bishop
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Douglas+Bridges"} Douglas Bridges
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Constructive+Analysis"} Constructive Analysis
                = succeed "," do
                  %strong 279
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-61667-9"} doi:10.1007/978-3-642-61667-9
            %li#BishopCheng
              %p
                %a.existingWikiWord{:href => "/nlab/show/Errett+Bishop"}> Errett Bishop
                ,
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Henry+Cheng"} Henry Cheng
                = succeed "," do
                  %em Constructive Measure Theory
          %p
            For
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
            = succeed "\u2019s" do
              %a.existingWikiWord{:href => "/nlab/show/Erik+Palmgren"} Erik Palmgren
          %ul
            %li#CoquandPalmgren
              %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"}> Thierry Coquand
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Erik+Palmgren"} Erik Palmgren
              = succeed "," do
                %em Metric Boolean algebras and constructive measure theory
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s001530100123"} doi:10.1007/s001530100123
          %h3#ReferencesRelationToVonNeumannAlgebras Relation to von Neumann algebra
          %p
            A discussion of the abstract properties of the category of
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
            is in
          %ul
            %li
              Alain Guichardet,
              %em Sur la catégorie des algèbres de von Neumann
              (French) Bull. Sci. Math. (2) 90 1966 41–64. (
              %a{:href => "http://ams.org/mathscinet-getitem?mr=201989"}> MSN
              ) (
              %a{:href => "http://dmitripavlov.org/scans/guichardet.pdf"}> scan
              )
          %p A modern treatment of this discussion can be found in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Pavlov"}> Dmitri Pavlov
              ,
              = succeed "," do
                %em Gelfand-type duality for commutative von Neumann algebras
              %strong 226
              4 (2022) 106884 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2005.05284"}> arXiv:2005.05284
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2021.106884"} doi:10.1016/j.jpaa.2021.106884
          %p
            A useful series of expositions along these lines is in the article
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories+of+measure+theory"} categories of measure theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Pavlov"}> Dmitri Pavlov
                ,
                %em On measurable spaces
              %ul
                %li
                  %p
                    %a{:href => "http://mathoverflow.net/questions/20740/is-there-an-introduction-to-probability-theory-from-a-structuralist-categorical-p/20820#20820"} MO comment 1
                %li
                  %p
                    %a{:href => "http://mathoverflow.net/questions/49426/is-there-a-category-structure-one-can-place-on-measure-spaces-so-that-category-th/49542#49542"} MO comment 2
          %p See also
          %ul
            %li
              Ryszard Paweł Kostecki,
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mo *
                    %annotation{:encoding => "application/x-tex"} W^\ast
                \-algebras and noncommutative integration
              (
              %a{:href => "http://www.fuw.edu.pl/~kostecki/wstarint.pdf"}> pdf
              )
          %h3#relation_to_boolean_toposes_2 Relation to Boolean toposes
          %ul
            %li#Jackson06
              %p
                Matthew Jackson,
                = succeed "," do
                  %em A sheaf-theoretic approach to measure theory
                = succeed ")" do
                  %a{:href => "http://www.andrew.cmu.edu/~awodey/students/jackson.pdf"} pdf
            %li#Henry14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                ,
                = succeed "," do
                  %em From toposes to non-commutative geometry through the study of internal Hilbert spaces
                = succeed ")" do
                  %a{:href => "http://www.normalesup.org/~henry/Thesis.pdf"} pdf
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/probability"} probability
