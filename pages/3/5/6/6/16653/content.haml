                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p \in k[x]
            a
            %a.existingWikiWord{:href => "/nlab/show/monic+polynomial"} monic polynomial
            of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %em splitting field
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a
            %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi k
                  %mo ↪
                  %mi E
                %annotation{:encoding => "application/x-tex"} i: k \hookrightarrow E
            such that, regarding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            as a
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E[x]
            by applying the map
