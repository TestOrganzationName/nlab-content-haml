            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mi k
                  %msub
                    %mo ⊗
                    %mi k
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mi i
                      %mo ⊗
                      %mn 1
                  %mi E
                  %msub
                    %mo ⊗
                    %mi k
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} k[x] \cong k \otimes_k k[x] \stackrel{i \otimes 1}{\to} E \otimes_k k[x] \cong E[x],
          %p the polynomial factors or “splits” as a product of linear factors (possibly repeated):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mi …
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x) = (x - r_1)(x - r_2)\ldots (x - r_n)
          %p
            with all the
            %a.existingWikiWord{:href => "/nlab/show/roots"} roots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            lying in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and these roots is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            itself (so that the roots generate
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi r
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = k(r_1, \ldots, r_n)
          %p
            More generally, given a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊆
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
