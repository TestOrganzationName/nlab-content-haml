          %h2#construction Construction
          %p
            The existence of a splitting field for a single polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p \in k[x]
            can be proven by
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n = \deg(p)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[x]
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unique+factorization+domain"} unique factorization domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a product of irreducible polynomials
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %msub
                      %mi p
                      %mn 2
                    %mi …
                    %msub
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p_1 p_2 \ldots p_k
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p_1)
            is
            %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal
            and so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E = k[x]/(p_1)
            is an
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite
            %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            where the
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mn 1
                  %mo ≔
                  %mi x
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} r_1 \coloneqq x + (p_1) \in E
            is a
            %a.existingWikiWord{:href => "/nlab/show/root"} root
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p_1(x) \in E[x]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = k(r_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi E
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} q(x) = p(x)/(x - r_1) \in E[x]
            has degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            by induction, whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q(x)
            splits as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mi …
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x - r_2)\ldots (x-r_n)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F[x]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mi …
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x) = (x - r_1)(x - r_2) \ldots (x - r_n)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F[x]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mi E
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi k
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi k
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo ,
                  %msub
                    %mi r
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi r
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F = E(r_2, \ldots, r_n) = k(r_1)(r_2, \ldots, r_n) = k(r_1, r_2, \ldots, r_n).
          %p
            What is not clear from this construction is that splitting fields are unique (up to
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          #unique.num_theorem
            %h6#theorem Theorem
            %p Splitting fields of a polynomial are unique up to (non-unique) isomorphism.
          .proof
            %h6#proof Proof
            %p
              (After
              = succeed ".)" do
                %a{:href => "#Con"} Conrad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi r
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = k(r_1, \ldots, r_n)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ′
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi r
                      %mi n
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E' = k(r_1', \ldots, r_n')
              are two splitting fields of a polynomial
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in k[x]
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E \otimes_k E'
              is a
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E'
              in the category of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi E
                    %mo →
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} i: E \to E \otimes_k E'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ′
                    %mo :
                    %mi E
                    %mo ′
                    %mo →
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} i': E' \to E \otimes_k E'
              be the coproduct
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coprojection"} injections
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E \otimes_k E'
              is generated by the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(r_j)
              together with the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi r
                        %mi j
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i'(r_j')
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              be any maximal ideal of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E \otimes_k E'
              (note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E \otimes_k E'
              is finite-dimensional over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              does not involve any choice principles), and consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mover
                      %mo →
                      %mi i
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                    %mover
                      %mo →
                      %mi quot
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \phi = (E \stackrel{i}{\to} E \otimes_k E' \stackrel{quot}{\to} E \otimes_k E'/m).
            %p
              As is the case for any homomorphism between fields, this composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+map"} injective map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \rho_j
              denote the coset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi m
                  %annotation{:encoding => "application/x-tex"} i(r_j) + m
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi j
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \rho_j'
              the coset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi r
                        %mi j
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi m
                    %annotation{:encoding => "application/x-tex"} i'(r_j') + m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(x)
              splits over the field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ⊗
                      %mi k
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi m
                  %annotation{:encoding => "application/x-tex"} E \otimes_k E'/m
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %msub
                      %mi ρ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %msub
                      %mi ρ
                      %mi k
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_j (x - \rho_j) = \prod_k (x - \rho_k')
            %p
              and so by
              %a.existingWikiWord{:href => "/nlab/show/unique+factorization+domain"} unique factorization
              of polynomials, for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi k
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \rho_k'
              there is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi j
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_j = \phi(r_j)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ρ
                        %mi k
                      %mo ′
                      %mo =
                      %msub
                        %mi ρ
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \rho_k' = \rho_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(r_j)
              exhaust the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi j
                    %mo ,
                    %msub
                      %mi ρ
                      %mi k
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \rho_j, \rho_k'
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ⊗
                        %mi k
                      %mi E
                      %mo ′
                      %mo{:stretchy => "false"} /
                      %mi m
                    %annotation{:encoding => "application/x-tex"} E \otimes_k E'/m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is also surjective and provides an isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≅
                      %mi E
                      %msub
                        %mo ⊗
                        %mi k
                      %mi E
                      %mo ′
                      %mo{:stretchy => "false"} /
                      %mi m
                    %annotation{:encoding => "application/x-tex"} E \cong E \otimes_k E'/m
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ′
                      %mo ≅
                      %mi E
                      %msub
                        %mo ⊗
                        %mi k
                      %mi E
                      %mo ′
                      %mo{:stretchy => "false"} /
                      %mi m
                    %annotation{:encoding => "application/x-tex"} E' \cong E \otimes_k E'/m
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≅
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} E \cong E'
          %h3#splitting_fields_of_sets_of_polynomials Splitting fields of sets of polynomials
          %p
            A splitting field for a finite set of polynomials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi p
                    %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{p_1, \ldots, p_k\}
            is just a splitting field of the product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %msub
                      %mi p
                      %mn 2
                    %mi …
                    %msub
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p_1 p_2 \ldots p_k
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊆
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} S \subseteq k[x]
            be an arbitrary set of monic polynomials. For each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi p
                %annotation{:encoding => "application/x-tex"} n_p
            denote the degree of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi p
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi p
                        %mo ,
                        %msub
                          %mi n
                          %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X_p = \{x_{p, 1}, \ldots, x_{p, n_p}\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be the coproduct
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi p
                        %mo ∈
                        %mi S
                    %msub
                      %mi X
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \sum_{p \in S} X_p
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R = k[X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} p \in S
            let us write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo −
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mrow
                      %msub
                        %mi n
                        %mi p
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo −
                  %msub
                    %mi x
                    %mrow
                      %mi p
                      %mo ,
                      %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi j
                      %mo =
                      %mn 0
                    %mrow
                      %msub
                        %mi n
                        %mi p
                      %mo −
                      %mn 1
                  %msub
                    %mi s
                    %mrow
                      %mi p
                      %mo ,
                      %mi j
                  %msup
                    %mi t
                    %mi j
                %annotation{:encoding => "application/x-tex"} p(t) - \prod_{i = 1}^{n_p} (t - x_{p, i}) = \sum_{j = 0}^{n_p - 1} s_{p, j} t^j
          %p
            for some elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mi p
                        %mo ,
                        %mi j
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} s_{p, j} \in R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mrow
                      %mi p
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} s_{p, j}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            ranging over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            generates a proper ideal in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %msub
                    %mi g
                    %mn 1
                  %msub
                    %mi s
                    %mn 1
                  %mo +
                  %mi …
                  %mo +
                  %msub
                    %mi g
                    %mi k
                  %msub
                    %mi s
                    %mi k
                %annotation{:encoding => "application/x-tex"} g = g_1 s_1 + \ldots + g_k s_k
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} s_i \in \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            is associated with a polynomial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be the splitting field of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %msub
                      %mi p
                      %mn 1
                    %mi …
                    %msub
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p = p_1 \ldots p_k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} k[X] \to E
            that sends distinct elements of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} x = x_{p_i, j}
            to distinct roots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi j
                %annotation{:encoding => "application/x-tex"} r_j
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %mi f
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} x = x_{f, j}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∉
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi p
                    %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f \notin \{p_1, \ldots, p_k\}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is sent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            cannot be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔭
                %annotation{:encoding => "application/x-tex"} \mathfrak{p}
            be a
            %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
            containing the ideal generated by
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔭
                %annotation{:encoding => "application/x-tex"} \mathfrak{p}
            is guaranteed under the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi 𝔭
                %annotation{:encoding => "application/x-tex"} R/\mathfrak{p}
            is an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} p \in S
            splits over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi 𝔭
                %annotation{:encoding => "application/x-tex"} R/\mathfrak{p}
            and the roots of such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            generate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi 𝔭
                %annotation{:encoding => "application/x-tex"} R/\mathfrak{p}
            as a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as a field and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is therefore a splitting field for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            In particular, taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to be the set of all monic polynomials in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
            %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            that invokes not the full strength of the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            (in the form of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Zorn%27s+lemma"} Zorn's lemma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Any two splitting fields of a given set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of polynomials are isomorphic.
          %p
            Again we prove this only under the assumption of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          .proof
            %h6#proof_2 Proof
            %p
              (After
              = succeed ".)" do
                %a{:href => "#AC"} Caicedo
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ,
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E, F
              be splitting fields for
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is closed under multiplication of polynomials. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p \in S
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                  %annotation{:encoding => "application/x-tex"} E_p, F_p
              denote the corresponding subfields obtained by adjoining all roots of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              that occur in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ,
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E, F
              to the ground field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E \to F
              restricts to an isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi p
                      %mo →
                      %msub
                        %mi F
                        %mi p
                    %annotation{:encoding => "application/x-tex"} E_p \to F_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi p
                  %annotation{:encoding => "application/x-tex"} E_p
              form a directed system of fields, with an inclusion morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi p
                    %mo →
                    %msub
                      %mi E
                      %mi q
                  %annotation{:encoding => "application/x-tex"} E_p \to E_q
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              divides
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi p
                  %annotation{:encoding => "application/x-tex"} E_p
              over this directed system. We are required to show that the set of isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(E, F)
              is nonempty; we have restriction maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(E, F) \to Iso(E_p, F_p)
              which exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(E, F)
              as the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(E_p, F_p)
              over the corresponding system, with transition maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Res
                      %mrow
                        %mi p
                        %mi q
                    %mo :
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi q
                    %mo ,
                    %msub
                      %mi F
                      %mi q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Res_{p q}: Iso(E_q, F_q) \to Iso(E_p, F_p)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p|q
              also given by restriction. So we are required to show that this inverse limit is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            %p
              By Theorem
              = succeed "," do
                %a.maruku-ref{:href => "#unique"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(E_p, F_p)
              is inhabited, and it is also
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              (being a
              %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
              of the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(E_p)
              which has cardinality at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo !
                  %annotation{:encoding => "application/x-tex"} n!
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is the number of roots). It can then be proven from the
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+theorem"} ultrafilter theorem
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mo ∈
                        %mi S
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi p
                    %mo ,
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi = \prod_{p \in S} Iso(E_p, F_p)
              is nonempty; see
              %a{:href => "/nlab/show/compactness+theorem#surj"} here
              for a proof. Similarly, the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mi p
                        %mi q
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi ϕ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo ∈
                        %mi S
                    %mo ∈
                    %mi Φ
                    %mo :
                    %msub
                      %mi Res
                      %mrow
                        %mi p
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Phi_{p q} \coloneqq \{\phi = (\phi_p)_{p \in S} \in \Phi: Res_{p q}(\phi_q) = \phi_p\}
            %p
              is also nonempty, as is any finite intersection of such subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mi p
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \Phi_{p q}
              (which actually is another
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mi p
                          %mo ′
                          %mi q
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} \Phi_{p' q'}
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "\u2019s)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              topologized as a product of finite discrete spaces is a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"} Tychonoff theorem
              also follows from the ultrafilter theorem. We conclude from compactness that the full intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %msub
                      %mi Φ
                      %mrow
                        %mi p
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \bigcap_{p|q} \Phi_{p q}
              is inhabited. But this intersection is just the inverse limit which is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Iso
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Iso(E, F)
          %p
            An alternative proof based on a similar pattern of reasoning, but more explicitly in the language of
            %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compactness+theorem"} compactness theorem
            = succeed "," do
              %a{:href => "#JDH"} Joel David Hamkins
