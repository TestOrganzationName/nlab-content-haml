          #JucycMurphyElements.num_defn
            %h6 Definition
            %p
            %p
              The
              %em Jucys-Murphy elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    J_k \;\in\; \mathbb{C}[Sym(n)] \;\;\;\; k \in \{1, \cdots, n\}
            %p
              are the following
              %a.existingWikiWord{:href => "/nlab/show/sums"} sums
              of
              %a.existingWikiWord{:href => "/nlab/show/transpositions"} transpositions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (i,j) \in Sym(n) \subset \mathbb{C}[Sym(n)]
              in this
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            #eq:J1IsZero.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    J_1 \;\coloneqq\; 0
            #eq:JkAsSum.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J_k \;\coloneqq\; \underoverset{i = 1}{k-1}{\sum} (i,k)
            %p
          %p
            (
            %a{:href => "#Murphy81"}> Murphy 81, p. 287 (1 of 11)
            ,
            = succeed ")" do
              %a{:href => "#Murphy83"} Murphy 83, p. 259 (2 of 8)
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi k
                %annotation{:encoding => "application/x-tex"} J_k
            may be understood as the sum of all transpositions in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym(k)
            that are not in the
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(k-1) \subset Sym(k)
          %h2#properties Properties
          %h3#eigenvalues Eigenvalues
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sYTableaux
                    %mi n
                %annotation{:encoding => "application/x-tex"} sYTableaux_n
            for the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            boxes, and write
          #eq:VectorsInSeminormalRepresentations.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi v
                    %mrow
                      %mi T
                      %mo ,
                      %mi k
                  %mo ∈
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %mi T
                          %mo ∈
                          %msub
                            %mi sYTableaux
                            %mi n
                      %mrow
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi m
                          %mo ≤
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mrow
                                %mo |
                                %mi T
                                %mo |
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big\{ v_{T,k} \in \mathbb{C}[Sym(n)]\big\}_{
                  { T \in sYTableaux_n}
                  \\atop
                  { 1 \leq m \leq dim(S^{(\left\vert T\right\vert)})  }
                  }
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Gelfand-Tsetlin+basis"} Gelfand-Tsetlin basis
            (Young’s
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/seminormal+representation"} seminormal representation
          %p
            We will notationally suppress the multiplicity index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            in the following.
          %p
          #EigenvaluesOfJMElements.num_prop
            %h6 Proposition
            %p
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi T
                  %annotation{:encoding => "application/x-tex"} v_T
              %a.maruku-eqref{:href => "#eq:VectorsInSeminormalRepresentations"} (3)
              are joint
              %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
              of the Jucys-Murphy elements (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JucycMurphyElements"}
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              the “content”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo −
                    %mi i
                  %annotation{:encoding => "application/x-tex"} j - i
              of the box
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j)
              that contains the number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in the standard Young tableau
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi k
                    %msub
                      %mi v
                      %mi T
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo −
                    %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi v
                      %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo =
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J_k v_T \;=\; (j - i) v_T
                    \\,,
                    \\;\;\;
                    T_{i,j} = k
                    \\,.
            %p
          %p In particular, the Jucys-Murphy elements all commute with each other.
          %p
            This is due to
            = succeed "," do
              %a{:href => "#Jucys71"} Jucys 71
            = succeed "," do
              %a{:href => "#Jucys74"} Jucys 74 (12)
            = succeed "." do
              %a{:href => "#Murphy81"} Murphy 81 (3.8)
          %h3#factorization_of_cayleydistance_kernel Factorization of Cayley-Distance kernel
          %p
          #FactorizationOfCayleyDistanceKernelAsCharPolynomialOfJMElements.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomial"} characteristic polynomial
              of the Jucys-Murphy elements is proportional to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi t
                    %mo +
                    %msub
                      %mi J
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi t
                    %mo +
                    %msub
                      %mi J
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi ⋯
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi t
                    %mo +
                    %msub
                      %mi J
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo #
                        %mi cycles
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    t + J_1
                    \\big)
                    \\big(
                    t + J_2
                    \\big)
                    \\cdots
                    \\big(
                    t + J_n
                    \\big)
                    \\;=\;
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ ln(t) \cdot \# cycles(\sigma) }
                    \\, \sigma
                    \\;\;\;\;\;
                    \\in
                    \\mathbb{C}[Sym(n)][t]
            %p
          %p
            On the
            %a{:href => "https://en.wikipedia.org/wiki/Jucys%E2%80%93Murphy_element"} Wikipedia page
            this is attributed to Jucys, but without explicit reference. It might be in
            %a{:href => "#Jucys71"} Jucys 71
            (but is not mentioned in the review in
            = succeed ")." do
              %a{:href => "#Jucys74"} Jucys 74
          .proof
            %h6 Proof
            %p
              By
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              the claim reduces to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi t
                    %mo +
                    %msub
                      %mi J
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    t + J_1
                    \\big)
                    \\;=\;
                    e^{ ln(t) \cdot 1 }
                    \\,,
            %p
              which holds by
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:J1IsZero"} (1)
            %p
              Now assume that the statement is true for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Observe that every permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(n+1)
              may be written as product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msub
                      %mi c
                      %mrow
                        %mo #
                        %mi cycles
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;=\;
                    c_1(\sigma)
                    \\cdot
                    c_2(\sigma)
                    \\cdots
                    c_{\# cycles(\sigma)}(\sigma)
            %p of products of transpositions of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi ℓ
                          %mi i
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi ℓ
                          %mi i
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi ⋯
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 3
                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 2
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi ℓ
                          %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    c_i(\sigma)
                    \\;\;
                    \\;=\;
                    (i_{\ell_i-1},i_{\ell_i-2})
                    \\circ
                    \\cdots
                    \\circ
                    (i_3,i_2)
                    \\circ
                    (i_2,i_1)
                    \\circ
                    (i_1,i_{\ell_i})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \ell_i
              is the length of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutation+cycle"} permutation cycle
            %p Here we may assume without restriction that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi j
                    %mo &lt;
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi ℓ
                          %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi i
                    %mo &lt;
                    %mi j
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi ℓ
                          %mi i
                    %mo &lt;
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi ℓ
                          %mi j
                  %annotation{:encoding => "application/x-tex"}
                    i_j
                    \\lt
                    i_{\ell_i}
                    \\,,
                    {\phantom{AAA}}
                    \\text{and}
                    {\phantom{AAA}}
                    i \lt j
                    \\;\;
                    \\Rightarrow
                    \\;\;
                    i_{\ell_i} \lt j_{\ell_j}
            %p
              because if not then we may (1) rearrange the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_i(\sigma)
              within their product (these commute with each other, since they contain permutations among elements within distinct cycles) and (2) cyclically rearrange the factors withing each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_i(\sigma)
            %p
              Once all permutations are uniquely represented as products this way, the representative of any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(n+1)
              is uniquely obtained from the representative of an element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(n)
            %ol
              %li
                %p
                  multiplying from the right with a transposition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo ,
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (k, n+1)
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≤
                          %mi n
                        %annotation{:encoding => "application/x-tex"} k \leq n
                  = succeed "st" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n+1
              %li
                %p
                  by retaining the previous product as is, in which case the
                  = succeed "st" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n+1
            %p This means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi t
                      %mrow
                        %mo #
                        %mi cycles
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ′
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi t
                      %mrow
                        %mo #
                        %mi cycles
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi σ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo +
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\sigma \in Sym(n+1)}{\sum}
                    t^{ \# cycles(\sigma) }
                    \\,
                    \\sigma
                    \\;
                    \=
                    \\;
                    \\underset{\sigma' \in Sym(n)}{\sum}
                    t^{ \# cycles(\sigma') }
                    \\,
                    \\sigma' (t + J_{n+1})
            %p and hence the claim follows by the induction assumption.
          %p
            Combining Prop.
            %a.maruku-ref{:href => "#EigenvaluesOfJMElements"}
            with Prop.
            %a.maruku-ref{:href => "#FactorizationOfCayleyDistanceKernelAsCharPolynomialOfJMElements"}
            yields:
          %p
          .num_cor
            %h6 Corollary
            %p
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo #
                        %mi cycles
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi σ
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"}
                    e^{ - ln(t) \cdot d_C }
                    \\;=\;
                    e^{- ln(t) \cdot n}
                    \\underset{
                    \\sigma \in Sym(n)
                    }{\sum}
                    e^{ ln(t) \cdot \# cycles(\sigma) }
                    \\, \sigma \cdot
            %p
              (regarded on the right as the linear map given by right multiplication in the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
              by
              %a.existingWikiWord{:href => "/nlab/show/Young+diagrams"} Young diagrams
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              and are given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EigVals
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi d
                          %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi i
                            %mo ≤
                            %mi rows
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi j
                            %mo ≤
                            %msub
                              %mi λ
                              %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi t
                    %mo −
                    %mi j
                    %mo +
                    %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    EigVals[e^{- ln(t) \cdot d_C}]_\lambda
                    \\;=\;
                    e^{ - ln(t) \cdot  n}
                    \\underset{
                    { 1 \leq i \leq rows(\lambda) }
                    \\atop
                    { 1 \leq j \leq \lambda_i }
                    }{\prod}
                    \\big(
                    t - j + i
                    \\big)
            %p
          %p
            An alternative derivation of this statement, using the formula for
            %a.existingWikiWord{:href => "/nlab/show/Cayley+graph+spectra"} Cayley graph spectra
            and the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/hook+length+formula"} hook length formula
            %a.existingWikiWord{:href => "/nlab/show/hook-content+formula"} hook-content formula
            is
            %a{:href => "Cayley+distance+kernel#EigenvaluesInTermsOfJustBoxContent"} this Prop.
            at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
            (
            %a{:href => "Cayley+distance+kernel#CSS21"}> CSS 21
            ).
          %h3#Projectors Projectors
          %p
            %a{:href => "#Murphy81"} Murphy 81, p. 291 (5 of 11)
          %p
            %a{:href => "#Murphy83"} Murphy 83, p. 259 (2 of 8)
          %p
            %a{:href => "https://mathoverflow.net/a/151375/381"} MathOverflow:a/151375
          %h2#references References
          %p The Jucys-Murphy elements are independently due to:
          %ul
            %li#Jucys71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Algimantas+Adolfas+Jucys"}> Algimantas Adolfas Jucys
                ,
                = succeed "," do
                  %em Factorization of Young projection operators for the symmetric group
                %strong 11
                (1) 9 (1971) &amp;lbrack;
                %a{:href => "http://www.itpa.lt/%7Elfd/Lfz/Turiniai/Turi1971.html#"}> journal content
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Jucys-1971.pdf", :title => "pdf"} pdf
            %li#Jucys74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Algimantas+Adolfas+Jucys"}> Algimantas Adolfas Jucys
                ,
                = succeed "," do
                  %em Symmetric polynomials and the center of the symmetric group ring
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0034-4877(74)90019-6"} doi:10.1016/0034-4877(74)90019-6
          %p and
          %ul
            %li#Murphy81
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+E.+Murphy"}> G. E. Murphy
                ,
                = succeed "," do
                  %em A new construction of Young’s seminormal representation of the symmetric groups
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0021-8693(81)90205-2"} doi:10.1016/0021-8693(81)90205-2
            %li#Murphy83
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+E.+Murphy"}> G. E. Murphy
                ,
                = succeed "," do
                  %em The idempotents of the symmetric group and Nakayama’s conjecture
                = succeed ")" do
                  %a{:href => "https://core.ac.uk/download/pdf/82692868.pdf"} pdf
            %li#Murphy92
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+E.+Murphy"}> G. E. Murphy
                ,
                = succeed "," do
                  %em On the representation theory of the symmetric groups and associated Hecke algebras
                = succeed "," do
                  %a{:href => "https://core.ac.uk/download/pdf/82422274.pdf"} pdf
                = succeed "))" do
                  %a{:href => "https://doi.org/10.1016/0021-8693(92)90045-N"} doi:10.1016/0021-8693(92)90045-N
          %p
            (According to
            = succeed "," do
              %a{:href => "representation+theory+of+the+symmetric+group#VershikOkounkov04"} Vershik-Okounkov 04, Footnote 2
            %a{:href => "#Jucys74"} Jucys 74
            “remained unnoticed” until
