                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mrow
                              %msub
                                %mi λ
                                %mrow
                                  %mi i
                                  %mi j
                                  %mi k
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi x
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; (x,j)
                  \\\
                  \&amp; \nearrow &amp;\Downarrow&amp; \searrow
                  \\\
                  (x,1) &amp;&amp;\to&amp;&amp; (x,k)
                  }
                  \\;\;\;
                  \\mapsto
                  \\;\;\;
                  \\array{
                  \&amp;&amp; *
                  \\\
                  \&amp; \nearrow &amp;\Downarrow^{\lambda_{i j k})(x}&amp; \searrow
                  \\\
                  * &amp;&amp;\to&amp;&amp; *
                  }
          %p
            smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            on triple overlaps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
