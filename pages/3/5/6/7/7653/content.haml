                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
