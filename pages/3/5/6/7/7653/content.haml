                %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
