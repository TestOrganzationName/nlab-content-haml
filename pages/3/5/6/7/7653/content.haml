                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mi k
                  %msub
                    %mi ϕ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  h_{i j} h_{j k} = h_{i k} \phi_{i j k}
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                %annotation{:encoding => "application/x-tex"} \phi_{i j k}
            happens to be constant on the neutral element, then this is the condition for a cocycle in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi smooth
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1_{smooth}(X, U(n))
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              \-twisted
            such cocycle. And that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
