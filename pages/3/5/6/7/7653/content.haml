                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B} U(n) &amp;\to&amp; \mathbf{B} PU(n)
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{dd}_n}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 U(1)
                  }
          %p
            induces a notion of unitary bundles that are
            %em twisted
            by a 2-bundle.
          %p
            Indeed, unwinding the definition one finds that a
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
