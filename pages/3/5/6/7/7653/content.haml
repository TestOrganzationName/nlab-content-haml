                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi{:mathvariant => "normal"} O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{O}(d) \times \mathrm{O}(d)
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              this can always be brought into a form where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mo +
                    %mo =
                    %msub
                      %mi e
                      %mo −
                    %mo =
                    %mo :
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e_+ = e_- =: \tfrac{1}{2}e
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi e
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mi B
                            %mtd
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E =
                    \\left(
                    \\array{
                    e &amp; 0
                    \\\
                    \- e^{-T}B  &amp; e^{-T}
                    }
                    \\right)
                    \\,.
            %p
              The corresponding “generalized metric” over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi T
                    %mi E
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi e
                                %mi T
                            %mtd
                              %mi B
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                      %mo )
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi e
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mi B
                            %mtd
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi g
                              %mo −
                              %mi B
                              %msup
                                %mi g
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
