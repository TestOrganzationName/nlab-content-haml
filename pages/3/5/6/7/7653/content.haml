                  %mi X
                  %mo ⊕
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi TypeII
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E
                  \\in
                  \\mathbf{TypeII}Struc(X)
                  \\coloneqq
                  \\mathbf{H}_{/\mathbf{B} O(n,n)}(T X \oplus T^* X, \mathbf{TypeII})
                  \\,.
          .un_prop
            %h6#proposition__definition Proposition / Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi TypeII
                    %mi{:mathvariant => "normal"} Struc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{TypeII}\mathrm{Struc}(X)
              is that of “generalized vielbein fields” on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ")" do
                %a{:href => "type+II+geometry#GMPW"} GMPW
            %p
              In particular, its set of equivalence classes is the set of type-II generalized geometry structures on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof Proof
            %p
              Over a local
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi d
                      %mo ≃
                      %msub
                        %mi U
                        %mi i
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^d \simeq U_i \hookrightarrow X
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{O}(d,d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mo +
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %msub
                                %mi e
                                %mo −
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi e
                                %mo +
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo −
                              %msubsup
                                %mi e
                                %mo −
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo{:stretchy => "false"} )
                              %mi B
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi e
                                %mo +
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo −
                              %msubsup
                                %mi e
                                %mo −
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mo +
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi e
                                %mo −
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi e
                                %mo +
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo +
                              %msubsup
                                %mi e
                                %mo −
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo{:stretchy => "false"} )
                              %mi B
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi e
                                %mo +
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo +
                              %msubsup
                                %mi e
                                %mo −
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi T
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E =
                    \\frac{1}{2}
                    \\left(
                    \\array{
                    (e_+ + e_-) + (e_+^{-T} - e_-^{-T})B &amp; (e_+^{-T} - e_-^{-T})
                    \\\
                    (e_+ - e_-) - (e_+^{-T} + e_-^{-T})B &amp; (e_+^{-T} + e_-^{-T})
                    }
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mo +
                    %mo ,
                    %msub
                      %mi e
                      %mo −
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ,
                    %mi{:mathvariant => "normal"} O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_+, e_- \in C^\infty(U_i, \mathrm{O}(d))
              are thought of as two
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} ordinary vielbein
              fields, and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is any smooth skew-symmetric
              = succeed "-matrix" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi d
                      %mo ≃
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^d \simeq U_i
            %p
              By an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} O
