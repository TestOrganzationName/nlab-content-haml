            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mi lim
                    %mrow
                      %msub
                        %mo →
                        %mi n
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X, \mathbf{B}U)
                  \\simeq
                  \\underset{\rightarrow_n}{\lim} \mathbf{H}(X, \mathbf{B} U(n))
                  \\,.
          %p
            Now we think of the manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+II+superstring"} type II superstring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} w_1(X) = 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} w_2(X) = 0
            %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo :
                  %mi Q
                  %mo ↪
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\iota : Q \hookrightarrow X
                  \\,,
          %p
            to be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
          %p
            Assume first that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            also admits a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
            %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
            vanishes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mn 3
