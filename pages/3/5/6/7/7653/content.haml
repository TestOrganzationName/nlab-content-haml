                          %mi x
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                          %mo ⇓
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
