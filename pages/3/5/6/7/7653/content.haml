                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo →
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %msup
                              %mo ⇓
                              %mrow
                                %mi c
                                %mo ∈
                                %msup
                                  %mi C
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo ,
