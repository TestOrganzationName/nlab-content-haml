          %p
            But more generally, if the
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I \coloneqq [0,1]
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            functional on
            %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [S^1, X]
            generalizes to the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            on the
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,X]
            and there it is no longer a function, but exists only as a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} |
                                %mn 0
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mn 1
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %msub
                                %mo ∫
                                %mi I
                              %mo{:stretchy => "false"} [
                              %mi I
                              %mo ,
                              %mo ∇
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi χ
                                  %mo ∇
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi χ
                                  %mo ∇
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [I,X]
                  \\\
                  \&amp; {}^{(-)|_0}\swarrow &amp;&amp; \searrow^{\mathrlap{(-)|_1}}
                  \\\
                  X &amp;&amp; \swArrow_{\exp(i \int_{I}[I,\nabla])} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\chi_\nabla}}\searrow &amp;&amp; \swarrow_{\mathrlap{\chi_\nabla}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)
                  }
                  \\,.
          %p Notice that this is a “local” description of the action functional: the data that determines it is the boundary
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ∇
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \\\
                  \\downarrow^{\mathrlap{\nabla}}
                  \\\
                  \\mathbf{B}U(1)_{conn}
                  }
          %p
            and from this the rest is induced by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
          %p
            A related class of examples are
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondences"} prequantized Lagrangian correspondences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi ω
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \\\
                  \\downarrow^{\mathrlap{\omega}}
                  \\\
                  \\mathbf{\Omega}^2
                  }
          %p
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow X
            is a
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ω
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi ω
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; graph(f)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\omega}}\searrow &amp;&amp; \swarrow_{\mathrlap{\omega}}
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2
                  }
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mo ∇
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{\nabla}{\longrightarrow}&amp; \mathbf{B}U(1)_{conn}
                  \\\
                  \&amp; \searrow &amp; \downarrow^{\mathrlap{F_{(-)}}}
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2
                  }
          %p
            and so a
            %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondence"} prequantized Lagrangian correspondence
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mo ∇
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; graph(f)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; \swArrow &amp;&amp; X
                  \\\
                  \&amp; _{\mathllap{\nabla}}\searrow &amp;&amp; \swarrow_{\mathrlap{\nabla}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)_{conn}
                  }
                  \\,.
          %p To conceptualize all this, write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %mi SmoothGrpd
                  %mo ≔
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SmoothMfd
                    %mi op
                  %mo ,
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %mi stalkwise
                  %mspace{:width => "thickmathspace"}
                  %mi equivalences
                  %msup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq SmoothGrpd \coloneqq
                  Func(SmoothMfd^{op}, Grpd)[\{stalkwise\;equivalences\}^{-1}]
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of all
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            by universally turning
            %a.existingWikiWord{:href => "/nlab/show/stalk"} stalkwise
            %a.existingWikiWord{:href => "/nlab/show/equivalences+of+groupoids"} equivalences of groupoids
            into genuine
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            (“
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"}> simplicial localization
            ”).
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            of
            = succeed "/smooth" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  Corr_1(\mathbf{H})
                  \\in
                  (2,1)Cat
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}U(1)_{conn}}
            for the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"} slice
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            over the smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle bundles with connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo ∈
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nabla \in Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
              is the
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
              which is the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete
              smooth 1-parameter subgroup
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℝ
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{R} \longrightarrow
                    \\mathbf{B}\mathbf{Aut}_{/\mathbf{B}U(1)_{conn}}(\nabla)
                    \\hookrightarrow
                    \\mathbf{H}_{/\mathbf{B}U(1)_{conn}}
            %p
              is equivalently a choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in C^\infty(X)
              of a smooth function and sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
