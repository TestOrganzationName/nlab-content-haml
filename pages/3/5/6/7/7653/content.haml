                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} E \in Stab(\mathbf{H}) \simeq T_\ast \mathbf{H} \hookrightarrow T \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_{T \mathbf{H}} \in T \mathbf{H}
            %p
              (with respect to the Cartesian
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+%28%E2%88%9E%2C1%29-category"} closed monoidal (∞,1)-category
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\Sigma^\infty X, E]_{Stab(\mathbf{H})} \in Stab(\mathbf{H}) \hookrightarrow T \mathbf{H}
                    \\,,
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_{T \mathbf{H}} \simeq [\Sigma^\infty X,E]_{Stab(\mathbf{H})}
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              Notice that as an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo ↪
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} T \mathbf{H} \hookrightarrow \mathbf{H}^{seq}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the constant
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi seq
                    %annotation{:encoding => "application/x-tex"} seq
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo •
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_\bullet \simeq \mathbf{H}^{seq}(X \times \bullet, E)
                    \\,.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is constant the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo •
                  %annotation{:encoding => "application/x-tex"} X \times \bullet
              is for each object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              the
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} presheaf represented
              by that object. Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_\bullet \simeq [X,E_\bullet]
                    \\,.
            %p
              This is manifestly the same formula as for the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
              out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mn ∞
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma^\infty X
          %p By the same kind of argument we have the following more general statement.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mn 0
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H} \stackrel{0}{\hookrightarrow} T \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %msub
                      %mi E
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in E_\infty(\mathbf{H})
              an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo →
                    %mi Pic
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} (\widehat{Pic(E)} \to Pic(E)) \hookrightarrow T \mathbf{H}
              its universal
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-line+bundle"} (∞,1)-line bundle
              over its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Picard+%E2%88%9E-groupoid"} Picard ∞-groupoid
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mover
                      %mrow
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi T
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [X,\widehat{Pic(E)}]_{T \mathbf{H}} \in T \mathbf{H}
            %p is the object whose
            %ul
              %li
                %p
                  base homotopy type is the
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Pic
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [X, Pic(E)]
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/spectrum+bundle"} spectrum bundle
                  is the collection of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi χ
                        %annotation{:encoding => "application/x-tex"} \chi
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted E-cohomology spectra
                  for all twists
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi χ
                        %annotation{:encoding => "application/x-tex"} \chi
          %h4#CohesiveAndDifferentialRefinement Cohesive and differential refinement in tangent cohesion
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T\mathbf{H}
            be a tangent cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mo *
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T_\ast \mathbf{H}
            for the
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            inside it.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi T
                      %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A \in T_\ast \mathbf{H}
              the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo ♭
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo ♭
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{}{\longrightarrow}&amp; A/\flat A
                    \\\
                    \\downarrow &amp;{}^{(pb)}&amp; \downarrow
                    \\\
                    \\Pi(A) &amp;\stackrel{}{\longrightarrow}&amp; \Pi(A/\flat A)
                    }
            %p
              (of the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              square.
          %p
            This was observed in (
            %a{:href => "tangent+cohesion#BunkeNikolausVoelkl13"}> Bunke-Nikolaus-Völkl 13
            ). It is an incarnation of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fracture+theorem"} fracture theorem
          .proof
            %h6#proof_5 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesion
              and
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stability
              we have the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ♭
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo ♭
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mo ♭
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} /
                            %mo ♭
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat A &amp;\longrightarrow &amp; A &amp;\stackrel{}{\longrightarrow}&amp; A/\flat A
                    \\\
                    \\downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\Pi(\flat A) &amp;\longrightarrow&amp; \Pi(A) &amp;\stackrel{}{\longrightarrow}&amp; \Pi(A/\flat A)
                    }
            %p
              where both rows are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesion
              the left vertical map is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
              %a{:href => "homotopy+pullback#HomotopyFiberCharacterization"} homotopy fiber characterization
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
          .num_remark
            %h6#remark_3 Remark
            %p
              This means that in stable cohesion every cohesive stable homotopy type is in controled sense a cohesive extension/refinement of its
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+infinity-groupoids"} geometric realization
              %a.existingWikiWord{:href => "/nlab/show/discrete+infinity-groupoid"} geometrically discrete
              (“bare”) stable
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              by the non-
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
              part of its cohesive structure;
            %p
              In particular,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo ♭
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A/\flat A
              may be identified with differential cycle data. Indeed, by stability and cohesion it is the
              %a{:href => "cohesive+%28infinity,1%29-topos+--+structures#deRhamCohomology"} flat de Rham coefficient object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo ♭
                    %mi A
                    %mo =
                    %msub
                      %mo ♭
                      %mi dR
                    %mi Σ
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A/\flat A = \flat_{dR}\Sigma A
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi θ
                                  %mi A
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %mi Σ
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                          %mtd
