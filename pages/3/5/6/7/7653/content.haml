                  \\,.
          %p
            Hence these are collections of smooth
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mi j
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (h_{i j} : U_i \cap U_j \to U(n))
          %p which satisfy on triple overlaps the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mi h
                    %mrow
                      %mi j
                      %mi k
