                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}U(1)_{conn} = [C^\infty(-) \stackrel{d_{dR}}{\to} \Omega^1(-)]
                      \\,.
            %li
              %p
                The smooth
                = succeed "-stack" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
                is realized as the image under the
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
                by the chain complex of sheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(-,U(1))
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn 0
                      %mo →
                      %mi ⋯
                      %mo →
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}^n U(1)
                      \\simeq
                      [
                      C^\infty(-,U(1))
                      \\to 0
                      \\to \cdots
                      \\to 0
                      ]
                      \\,.
          %p
            From the look of these expressions there is already a plausible candidate for the differential refinement
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)_{conn}
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            – it should be the
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo =
                  %mrow
                    %mo [
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                        %mi log
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^{n} U(1)_{conn}
                  \=
                  \\left[
                  C^\infty(-,U(1))
                  \\stackrel{d_{dR} log}{\to}
                  \\Omega^1(-)
                  \\stackrel{d_{dR}}{\to}
                  \\Omega^2(-)
                  \\stackrel{d_{dR}}{\to}
                  \\cdots
                  \\stackrel{d_{dR}}{\to}
                  \\Omega^n(- )
                  \\right]
                  \\,.
          %p
            For instance a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}^2 U(1)_{conn}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Funct
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SmthMfd
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Funct(SmthMfd^{op}, sSet)
            and relative to a
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            given by a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to \mathbf{B}^2 U(1)_{conn}
          %ul
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                a
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+2-bundle"} connection 2-form
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mi i
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B_i \in \Omega^2(U_i)
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                a 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_{i j} \in \Omega^1(U_i \cap U_j)
                such that
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mi j
                        %mo −
                        %msub
                          %mi B
                          %mi i
                        %mo =
                        %msub
                          %mi d
                          %mi dR
                        %msub
                          %mi A
                          %mrow
                            %mi i
                            %mi j
                      %annotation{:encoding => "application/x-tex"} B_j - B_i = d_{dR} A_{i j}
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %msub
                        %mi U
                        %mi k
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
                a smooth functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %msub
                        %mi U
                        %mi k
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_{i j k} \in C^\infty(U_i \cap U_j \cap U_k, U(1))
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                      %mo +
                      %msub
                        %mi A
                        %mrow
                          %mi j
                          %mi k
                      %mo −
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi k
                      %mo =
                      %msub
                        %mi d
                        %mi dR
                      %mi log
                      %msub
                        %mi ϕ
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                    %annotation{:encoding => "application/x-tex"} A_{i j} + A_{j k} - A_{i k} = d_{dR} log \phi_{i j k}
                and such that on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %msub
                        %mi U
                        %mi k
                      %mo ∩
                      %msub
                        %mi U
                        %mi l
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k \cap U_l
                the equation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %msub
                        %mi ϕ
                        %mrow
                          %mi i
                          %mi k
                          %mi l
                      %mo =
                      %msub
                        %mi ϕ
                        %mrow
                          %mi i
                          %mi j
                          %mi l
                      %msub
                        %mi ϕ
                        %mrow
                          %mi j
                          %mi k
                          %mi l
                    %annotation{:encoding => "application/x-tex"} \phi_{i j k} \phi_{i k l} = \phi_{i j l} \phi_{j k l}
                holds.
          %p
            Tthe
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            on
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            is (in the absence of various possible twists, to be discussed), such a cocycle
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}^2 U(1)_{conn}
            %a.existingWikiWord{:href => "/nlab/show/C-field"} C-field
            (similarly in the absence of possible twists, to be discussed below) is given by a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}^3 U(1)_{conn}
          %p
            Such cocycles in
            %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne
            %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
            define classes in
            %em
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{diff}^{n+1}(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{diff}^{n+1}(X)
                  \=
                  \\pi_0 \mathbf{H}(X, \mathbf{B}^n U(1)_{conn})
                  \\,.
          %p There is an evident morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n U(1)_{conn} \to \mathbf{B}^n U(1)
          %p
            which
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgets
            the connection data. We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)_{conn}
            is a
            %em differential refinement
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
          %p
            We now want to construct a differential refinement of the above smooth Whitehead tower, hence of the smooth
            %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
            appearing in it. To do so, we now first provide a more conceptual way to think of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)_{conn}
          %p
            The key is that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-stacks
            comes with a canonical notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            or
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} flat ∞-connection
            %em twist
            this to find a notion of
            = succeed "-twisted" do
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %munder
                      %mo →
                      %mi Γ
                    %mover
                      %mo ←
                      %mi Disc
                  %mn ∞
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}
                  \\stackrel{\overset{Disc}{\leftarrow}}{\underset{\Gamma}{\to}}
                  \\infty Grpd
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            evaluates a presheaf on the point, and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                %annotation{:encoding => "application/x-tex"} Disc
            sends an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mo →
                    %mi Γ
                  %mn ∞
                  %mi Grpd
                  %mover
                    %mo →
                    %mi Disc
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\flat : \mathbf{H} \stackrel{\Gamma}{\to} \infty Grpd \stackrel{Disc}{\to} \mathbf{H}
                  \\,,
          %p
            to be pronounced “flat”: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
            a smooth homotopy type, we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mi A
                %annotation{:encoding => "application/x-tex"} \flat A
            the corresponding
            %em flat local coefficient
            object.
          %p
            For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ≃
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi disc
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi disc
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma \mathbf{B}G \simeq B (G_{disc}) = K(G_{disc}, 1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo ♭
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \flat \mathbf{B}G
            is equivalently a cocycle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi disc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B} (G_{disc})
            = succeed "-covering" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi disc
                  %annotation{:encoding => "application/x-tex"} G_{disc}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
          %p Generally, we say that a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo ♭
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  X \to \flat A
          %p
            is an
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              \-
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            or
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              \-valued
              %a{:href => "cohesive+%28infinity,1%29-topos+--+structures#FlatDifferentialCohomology"} flat ∞-connection
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            There is a canonical forgetful morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mo ♭
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} u : \flat A \to A
            which forgets the flat connection: this is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Disc
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Disc \dashv \Gamma)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            is trivial
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ≔
                  %mrow
                    %mo {
                    %mo ∇
                    %mo ∈
                    %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\flat_{dR} \mathbf{B}G
                  \\coloneqq
                  \\left\{
                  \\nabla \in \flat \mathbf{B}G | (u(\nabla) \simeq * )
                  \\right\}
                  \\,.
          %p
            From the example of ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            it is familiar that flat
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+forms"} Lie algebra valued differential forms
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groups"} smooth ∞-groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \flat_{dR} \mathbf{B}G
            are
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebroid-valued+differential+form"} ∞-Lie algebra valued differential forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Reading the above expression in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the counit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ≔
                  %mo *
                  %msub
                    %mo ×
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mo ♭
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\flat_{dR} \mathbf{B}G \coloneqq * \times_{\mathbf{B}G} \flat \mathbf{B}G
                  \\,.
          %p
            By this construction and applying the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi G
                    %mo →
                    %msub
                      %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \theta : G \to \flat_{dR} \mathbf{B}G
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi θ
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mo →
                        %mtd
                          %mo ♭
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi u
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G &amp;\to&amp; *
                  \\\
                  {}^{\mathllap{\theta}}\downarrow &amp;&amp; \downarrow
                  \\\
                  \\flat_{dR} \mathbf{B}G &amp;\to&amp; \flat \mathbf{B}G
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{u}}
                  \\\
                  * &amp;\to&amp; \mathbf{B}G
                  }
                  \\,.
          %p
            For the special class of cases
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = \mathbf{B}^n U(1)
            the
            %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle (n+1)-group
            we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi curv
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} curv_{\mathbf{B}^n U(1)}  \coloneqq  \mathbf{B}^n U(1) \to \flat_{dR} \mathbf{B}^{n+1} U(1)
            the
            %em
              universal
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              class
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            Due to the existence of the further functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \Pi : \mathbf{H} \to \infty Grpd
            discussed
            %a{:href => "#SmoothWhitehead"} above
            it follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \flat : \mathbf{H} \to \infty Grpd
            is a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            and hence commutes with homotopy pullback. This in turn implies that by forming one more homotopy fiber above, we obtain the following differential version of a universal local coefficient bundle:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo ♭
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi curv
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\flat \mathbf{B}^n U(1) &amp;\to&amp; \mathbf{B}^n U(1)
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{curv}}
                  \\\
                  \&amp;&amp; \flat_{dR} \mathbf{B}^{n+1} U(1)
                  }
                  \\,.
          %p
            By the general concept of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %em curvature twisted flat differential cohomology
            – hence of differential cohomology.
          %p
            Specifically, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_X : X \to \Omega^{n+1}_{cl}(-)
            a closed
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi X
                  %annotation{:encoding => "application/x-tex"} F_X
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi curv
                  %annotation{:encoding => "application/x-tex"} \mathbf{curv}
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            with that curvature
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi F
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ∇
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi curv
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ♭
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi curv
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{}{\to}&amp;&amp; \mathbf{B}^n U(1)
                  \\\
