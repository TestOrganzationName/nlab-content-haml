                    \\\
                    \- g^{-1} B  &amp; g^{-1}
                    }
                    \\right)
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ≔
                    %msup
                      %mi e
                      %mi T
                    %mi e
                  %annotation{:encoding => "application/x-tex"}
                    g \coloneqq e^T e
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              (over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi q
                    %mo ≃
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^q \simeq U_i
              a smooth function with values in symmetric
              = succeed "-matrices)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} ordinary vielbein
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
          %h3#SpinStringFivebraneStructures
            %strong II)
            Spin-, String- and Fivebrane-structure
          %p
            Above we have seen (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"}> pseudo
            \-)
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian structure
            given by lifts through the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
