                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^2 U(1)
                  \:
                  U \mapsto
                  K(  C^\infty(U, U(1)), 2)
                  \=
                  \\left\{
                  \\array{
                  \&amp;&amp; \to
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  *
                  \&amp;&amp;\Downarrow^{c \in C^\infty(U,U(1))}&amp;&amp;
                  *
                  \\\
                  \&amp; \searrow &amp;&amp; \nearrow
                  \\\
