                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          #SpectrificationLemma.num_lemma
            %h6#lemma Lemma
            %p
              %strong (spectrification is left exact reflective)
            %p
              The inclusion of
              %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is
              %a.existingWikiWord{:href => "/nlab/show/left+exact+%28infinity%2C1%29-functor"} left
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflective
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              which preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi L
                            %mi lex
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T \mathbf{H}
                    \\stackrel{\overset{L_{lex}}{\leftarrow}}{\hookrightarrow}
                    \\mathbf{H}^{seq}
                    \\,.
          %p
            (
            %a{:href => "#Joyal08"}> Joyal 08, section 35.1
            )
          .proof
            %h6#proof_2 Proof
            %p
              Forming degreewise
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              constitutes an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \Omega \colon \mathbf{H}^{seq} \longrightarrow \mathbf{H}^{seq}
              and by definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              this comes with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              out of the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mo ⟶
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \;\colon\; id \longrightarrow \Omega
                    \\,.
            %p
              This in turn is compatible with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∘
                    %mi Ω
                    %mo ≃
                    %mi Ω
                    %mo ∘
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ω
                    %mo ⟶
                    %mi Ω
                    %mo ∘
                    %mi Ω
                    %mo =
                    %msup
                      %mi Ω
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \circ \Omega \simeq \Omega \circ \theta
                    \\;\colon\;
                    \\Omega \longrightarrow \Omega \circ \Omega = \Omega^2
                    \\,.
            %p
              Consider then a sufficiently deep
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ρ
                        %mi tf
                    %annotation{:encoding => "application/x-tex"} \rho^{tf}
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              available in the
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              this stabilizes, and hence provides a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                      %mo ⟶
                      %mi T
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} L \;\colon\; \mathbf{H}^{seq} \longrightarrow T \mathbf{H}
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+%28%E2%88%9E%2C1%29-colimit"} filtered (∞,1)-colimit
              and since in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              these commute with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} left exact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              over the
              %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-category"} tangent (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T \mathbf{H}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              over the base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} T \infty Grpd
              (and hence in particular also over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \infty Grpd
              itself).
          %p
            (
            %a{:href => "#Joyal08"}> Joyal 08, section 35.5
            )
          .proof
            %h6#proof_3 Proof
            %p
              By the the spectrification lemma
              %a.maruku-ref{:href => "#SpectrificationLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T \mathbf{H}
              has a
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              into the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-presheaf (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}^{seq}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              (by the discussion there).
            %p
              Moreover, since both
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              in the
              %a.existingWikiWord{:href => "/nlab/show/global+section+geometric+morphism"} global section geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo ⟶
                        %mi Γ
                      %mover
                        %mo ←
                        %mi Δ
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\longrightarrow}} \infty Grpd
              preserve
              %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              they preserve
              %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
              and hence their immediate
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              prolongation immediately restricts to the inclusion of spectrum objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi T
                                  %mi Γ
                              %mover
                                %mo ←
                                %mrow
                                  %mi T
                                  %mi Δ
                          %mtd
                            %mi T
                            %mn ∞
                            %mi Grpd
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi incl
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi incl
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mi Γ
                              %mover
                                %mo ←
                                %mi Δ
                          %mtd
                            %mn ∞
                            %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T \mathbf{H} &amp;\stackrel{\overset{T \Delta}{\leftarrow}}{\underset{T \Gamma}{\longrightarrow}}&amp;
                    T \infty Grpd
                    \\\
                    \\downarrow^{\mathrlap{incl}} &amp;&amp; \downarrow^{\mathrlap{incl}}
                    \\\
                    \\mathbf{H}
                    \&amp;
                    \\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\longrightarrow}}
                    \&amp;
                    \\infty Grpd
                    }
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              We may think of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-topos"} tangent (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T \mathbf{H}
              as being an
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              by its
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Stab
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi T
                        %mo *
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} Stab(\mathbf{H}) \simeq T_\ast \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Stab
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi Stab
                                  %mo{:stretchy => "false"} (
                                  %mi Γ
                                  %mo{:stretchy => "false"} )
                              %mover
                                %mo ←
                                %mrow
                                  %mi Stab
                                  %mo{:stretchy => "false"} (
                                  %mi Δ
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mi Spectra
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi incl
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi incl
                        %mtr
                          %mtd
                            %mi T
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi T
                                  %mi Γ
                              %mover
                                %mo ←
                                %mrow
                                  %mi T
                                  %mi Δ
                          %mtd
                            %mi T
                            %mn ∞
                            %mi Grpd
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi base
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi base
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mi Γ
                              %mover
                                %mo ←
                                %mi Δ
                          %mtd
                            %mn ∞
                            %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Stab(\mathbf{H}) &amp;\stackrel{\overset{Stab(\Delta)}{\leftarrow}}{\underset{Stab(\Gamma)}{\longrightarrow}}&amp;
                    Spectra
                    \\\
                    \\downarrow^{\mathrlap{incl}} &amp;&amp; \downarrow^{\mathrlap{incl}}
                    \\\
                    T\mathbf{H} &amp;\stackrel{\overset{T\Delta}{\leftarrow}}{\underset{T\Gamma}{\longrightarrow}}&amp;
                    T \infty Grpd
                    \\\
                    \\downarrow^{\mathrlap{base}} &amp;&amp; \downarrow^{\mathrlap{base}}
                    \\\
                    \\mathbf{H} &amp;\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\longrightarrow}}&amp;
                    \\infty Grpd
                    }
                    \\,.
            %p
              Crucial for the internal interpretation in
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              is that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T_\ast \mathbf{H} \hookrightarrow T \mathbf{H}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} stable homotopy types
          %h4#tangent_cohesive_homotopy_theory Tangent cohesive homotopy theory
          %p
            Now consider the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mi coDisc
                        %mover
                          %mo ⟶
                          %mi Γ
                      %mover
                        %mo ←
                        %mi Disc
                    %mover
                      %mo ⟶
                      %mi Π
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}
                  \\stackrel{\overset{\Pi}{\longrightarrow}}{\stackrel{\overset{Disc}{\leftarrow}}{\stackrel{\overset{\Gamma}{\longrightarrow}}{\underset{coDisc}{\leftarrow}}}}
                  \\infty Grpd
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                  %mo ,
                  %mi coDisc
                %annotation{:encoding => "application/x-tex"} Disc, coDisc
            being
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functors"} full and faithful (∞,1)-functors
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            preserving finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-products"} (∞,1)-products
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
            and
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
            in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-presheaf (∞,1)-topos
            are computed objectwise, this
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            immediately prolongs to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi seq
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{seq}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi seq
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mrow
                            %msup
                              %mi coDisc
                              %mi seq
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi Γ
                              %mi seq
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi Disc
                            %mi seq
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi Π
                          %mi seq
                  %mn ∞
                  %msup
                    %mi Grpd
                    %mi seq
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{seq}
                  \\stackrel{\overset{\Pi^{seq}}{\longrightarrow}}{\stackrel{\overset{Disc^{seq}}{\leftarrow}}{\stackrel{\overset{\Gamma^{seq}}{\longrightarrow}}{\underset{coDisc^{seq}}{\leftarrow}}}}
                  \\infty Grpd^{seq}
                  \\,.
          %p
            Moreover, all three
            %a.existingWikiWord{:href => "/nlab/show/right+adjoints"} right adjoints
            preserves the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullbacks"} (∞,1)-pullbacks
            involved in the characterization of
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            and hence restrict to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mrow
                            %msup
                              %mi coDisc
                              %mi seq
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi Γ
                              %mi seq
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi Disc
                            %mi seq
                    %mrow
                  %mi T
                  %mn ∞
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T\mathbf{H}
                  \\stackrel{}{\stackrel{\overset{Disc^{seq}}{\leftarrow}}{\stackrel{\overset{\Gamma^{seq}}{\longrightarrow}}{\underset{coDisc^{seq}}{\leftarrow}}}}
                  T\infty Grpd
                  \\,.
          %p
            But then we have a further
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            given as the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ↪
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi seq
                  %mover
                    %munder
                      %mo ←
                      %mrow
                        %msup
                          %mi Disc
                          %mi seq
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi Π
                          %mi seq
                  %mn ∞
                  %msup
                    %mi Grpd
                    %mi seq
                  %mover
                    %munder
                      %mo ←
                      %mrow
                    %mover
                      %mo ⟶
                      %mi L
                  %mi T
                  %mn ∞
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T\mathbf{H}
                  \\hookrightarrow
                  \\mathbf{H}^{seq}
                  \\stackrel{\overset{\Pi^{seq}}{\longrightarrow}}{\underset{Disc^{seq}}{\leftarrow}}
                  \\infty Grpd^{seq}
                  \\stackrel{\overset{L}{\longrightarrow}}{\underset{}{\leftarrow}}
                  T \infty Grpd
                  \\,.
          %p
            Again since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            %a.existingWikiWord{:href => "/nlab/show/left+exact+%28%E2%88%9E%2C1%29-functor"} left exact (∞,1)-functor
            this composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi Π
                %annotation{:encoding => "application/x-tex"} L \Pi
            preserves finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-products"} (∞,1)-products
          %p
            So it follows in conclusion that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            then its tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T \mathbf{H}
            is itself a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            over the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} T \infty Grpd
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/extension"} extension
            of the cohesion of the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
