                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mo ≃
                              %mtr
                                %mtd
                                  %msub
                                    %mi E
                                    %mrow
                                      %mo •
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                      %msubsup
                                        %mi i
                                        %mi out
                                        %mo *
                                      %msub
                                        %mi χ
                                        %mi out
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Fields
                                    %mi traj
                                  %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi i
                                %mi out
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                        %mtd
                          %msub
                            %mi E
                            %mrow
                              %mo •
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %msub
                                %mi χ
                                %mi out
                          %mo{:stretchy => "false"} (
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi out
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Fields}_{traj}
                  \\\
                  \&amp; {}^{i_{in}}\swarrow &amp;&amp; \searrow^{\mathrlap{i_{out}}}
                  \\\
                  \\mathbf{Fields}_{in}
                  \&amp; &amp; \swArrow_{\simeq}  &amp; &amp;
                  \\mathbf{Fields}_{out}
                  \\\
                  \&amp; {}_{\mathllap{\chi_{in}}}\searrow
                  \&amp;&amp;
                  \\swarrow_{\mathrlap{\chi_{out}}}
                  \\\
                  \&amp;&amp; E Mod
                  \\\
                  \\,
                  \\\
                  \\,
                  \\\
                  E_{\bullet + \chi_{in}}(\mathbf{Fields}_{in})
                  \&amp; \stackrel{(i_{in})_\ast}{\longleftarrow}&amp;
                  \\array{
                  E_{\bullet + i_{in}^\ast\chi_{in}}(\mathbf{Fields}_{traj})
                  \\\
                  \\simeq
                  \\\
                  E_{\bullet + i_{out}^\ast\chi_{out}}(\mathbf{Fields}_{traj})
                  }
                  \&amp; \stackrel{(i_{out})^\ast}{\longrightarrow}&amp;
                  E_{\bullet + \chi_{out}}(\mathbf{Fields}_{out})
                  }
                  \\,.
          %p
            The actual
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/path+integral+as+a+pull-push+transform"} path integral as a pull-push transform
            map now consists in forming
            %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} E Mod
            such as to turn one of the projections of such a correspondence arround a produce a
            %a.existingWikiWord{:href => "/nlab/show/quantum+propagator"} quantum propagator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi χ
                        %mi in
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi in
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi E
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi χ
                        %mi out
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi out
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E^{\bullet + \chi_{in}}(\mathbf{Fields}_{in})
                  \\longrightarrow
                  E^{\bullet + \chi_{out}}(\mathbf{Fields}_{out})
          %p
            that maps the incoming
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+states"} quantum states
            %a.existingWikiWord{:href => "/nlab/show/wavefunctions"} wavefunctions
            to the outgoing ones.
          %h4#ExpositionCohomologicalQuantization Cohomological quantization by pull-push
          %p
            What we need now for
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            is a
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            map that adds up the values of the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            over the space of trajectories, a functor of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Corr
                    %mi n
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⊗
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi E
                  %msup
                    %mi Mod
                    %mrow
                      %msup
                        %mo □
                        %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  \\int (-)
                  \\;\;
                  \\colon
                  \\;\;
                  Corr_n\left(\mathbf{H}_{/\mathbf{B}^n U(1)}\right)^\otimes
                  \\to
                  (E Mod^{\Box^n})^\otimes
          %p
            As such this will in general only exist for
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            and hence has a “counting measure”. This case has been considered in (
            %a{:href => "#FreedHopkinsLurieTeleman09"}> Freed-Hopkins-Lurie-Teleman 09
            ,
            = succeed ")." do
              %a{:href => "#Morton10"} Morton 10
          %p
            In the general case the path integral requires that we
            %em choose
            a suitable
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            on the spaces of fields. We see below what this means, for the moment we just write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Corr
                    %mi n
                    %mi or
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  Corr^{or}_n(\mathbf{H}_{/\mathbf{B}^n U(1)})^\otimes
          %p
            (i.e. with an
            = succeed "-superscript)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mi or
                  %annotation{:encoding => "application/x-tex"} {(-)}^{or}
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            of suitably oriented/measured spaces of fields with action functional. Then we may consider lifts of the action functional to
            %em measure-valued
            action functionals
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mi μ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Corr
                    %mi n
                    %mi or
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⊗
                  %mo →
                  %msup
                    %mrow
                      %mo (
                      %mi E
                      %msup
                        %mi Mod
                        %mrow
                          %msup
                            %mo □
                            %mi n
                      %mo )
                    %mo ⊗
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S) \, d\mu
                  \\;\colon\;
                  Corr_n^{or}\left(\mathbf{H}_{/\mathbf{B}^n U(1)}\right)^\otimes
                  
                  \\to
                  \\left(
                  E Mod^{\Box^n}
                  \\right)^\otimes
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            is then to be a monoidal functor of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Corr
                    %mi n
                    %mi or
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⊗
                  %mo →
                  %msup
                    %mrow
                      %mo (
                      %mi E
                      %msup
                        %mi Mod
                        %mrow
                          %msup
                            %mo □
                            %mi n
                      %mo )
                    %mo ⊗
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int(-) \;\colon\;
                  Corr_n^{or}\left(\mathbf{H}_{/\mathbf{B}^n U(1)}\right)^\otimes
                  \\to
                  \\left(
                  E Mod^{\Box^n}
                  \\right)^\otimes
                  \\,.
          %p
            This we discuss now below. Once we have such a
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            functor, the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            process is its
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            with the given
            %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \exp(i S) \, d \mu
            to obtain the genuine quantized
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo ∫
                            %mrow
                              %mi ϕ
                              %mo ∈
                              %mstyle{:mathvariant => "bold"}
                                %mi Fields
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi μ
                          %mo{:stretchy => "false"} (
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %msubsup
                            %mi Bord
                            %mi n
                            %mo ⊗
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi d
                              %mi μ
                        %mtd
                          %msubsup
                            %mi Corr
                            %mi n
                            %mi or
                          %msup
                            %mrow
                              %mo (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi H
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %msup
                                    %mstyle{:mathvariant => "bold"}
                                      %mi B
                                    %mi n
                                  %mi U
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo )
                            %mo ⊗
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo ∫
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msup
                            %mrow
                              %mo (
                              %mi E
                              %msup
                                %mi Mod
                                %mrow
                                  %msup
                                    %mo □
                                    %mi n
                              %mo )
                            %mo ⊗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi Fields
                          %mo ↘
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Corr
                            %mi n
                          %msup
                            %mrow
                              %mo (
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mo )
                            %mo ⊗
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\underset{\phi \in \mathbf{Fields}}{\int}
                  \\exp(i S(\phi)) \, d \mu(\phi)
                  \&amp;
                  \\colon
                  \&amp;
                  Bord_n^\otimes
                  \&amp;\stackrel{\exp(i S)\, d\mu}{\to}&amp;
                  Corr_n^{or}\left(\mathbf{H}_{/\mathbf{B}^n U(1)}\right)^\otimes
                  \&amp;\stackrel{\int (-) }{\to}&amp;
                  \\left(
                  E Mod^{\Box^n}
                  \\right)^\otimes
                  \\\
                  \&amp;&amp; &amp; {}_{\mathllap{Fields}}\searrow &amp; \downarrow
                  \\\
                  \&amp;&amp; &amp;&amp; Corr_n\left(\mathbf{H}\right)^\otimes
                  }
                  \\,.
          %p
            We realize this now by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+generalized+cohomology"} fiber integration in generalized cohomology
          %p
            While traditionally the definition of
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            is notoriously elusive, here we make use of general abstract but basic facts of
            %a.existingWikiWord{:href => "/nlab/show/higher+linear+algebra"} higher linear algebra
            in a
            %em
              %a.existingWikiWord{:href => "/nlab/show/tensor+%28%E2%88%9E%2C1%29-category"} tensor (∞,1)-category
            (a
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable
            and
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %p
            %em Cohomological integration
          %ol
            %li
              %p
                %em
                  Fiber integration of
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
                of pulling back
                = succeed "-modules." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                The choice of
                %em measure
                against which one integrates is the choice of identification of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
          %p
            More in detail, given a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes
            and given a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mn 1
                  %mo →
                  %msub
                    %mi V
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  f \;\colon\; V_1 \to V_2
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %em
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"}> fiber integration
              \/
              %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"}> push-forward
              \/
              %a.existingWikiWord{:href => "/nlab/show/index"} index map
            is just
          %ul
            %li
              %p
                forming the
                %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo ∨
                        %mo{:lspace => "verythinmathspace"} :
                        %msubsup
                          %mi V
                          %mn 2
                          %mo ∨
                        %mo →
                        %msubsup
                          %mi V
                          %mn 1
                          %mo ∨
                      %annotation{:encoding => "application/x-tex"} f^\vee \colon V_2^\vee \to V_1^\vee
            %li
              %p
                such that
                %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi V
                        %mi i
                        %mo ∨
                      %mo ≃
                      %msub
                        %mi V
                        %mi i
                    %annotation{:encoding => "application/x-tex"} V_i^\vee \simeq V_i
                exhbiting self-
                %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
                exist (
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality"}> Poincaré duality
                ) and have been chosen (
                %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"}> orientation
                ).
          %p This allows in total to have a morphism between the same objects, but in the opposite direction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo !
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mn 2
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi V
                    %mn 2
                    %mo ∨
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi f
                        %mo ∨
                      %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi V
                    %mn 1
                    %mo ∨
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f^!
                  \\;\colon\;
                  V_2
                  \\stackrel{\;\simeq\;}{\to}
                  V_2^\vee
                  \\stackrel{\; f^\vee \;}{\to}
                  V_1^\vee
                  \\stackrel{\; \simeq \;}{\to}
                  V_1
                  \\,.
          %p
            That this is also the mechanism of
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+generalized+cohomology"} fiber integration in generalized cohomology
            is almost explicit in the literature (
            %a.existingWikiWord{:href => "/nlab/show/Alexander-Whitehead-Atiyah+duality"}> Alexander-Whitehead-Atiyah duality
            ), if maybe not fully clearly so. The statement is discussed explicitly in (
            %a{:href => "#Nuiten13"}> Nuiten 13, section 4.1
            ).
          %p
            First, the basic example to keep in mind of is integration in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi H
                  %mi R
                  %mo =
                  %mi H
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} E = H R = H \mathbb{C}
            for the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a manifold, the
            %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msup
                    %mi R
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi H
                  %mi R
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  H R^\bullet(X)
                  \\coloneqq
                  [X,H R]
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality"} Poincaré duality
            asserts that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msup
                    %mi R
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi H
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} H R^\bullet(X) \in H R Mod
            is essentially a self-
            %a.existingWikiWord{:href => "/nlab/show/dual+object"}> dual object
            , except for a shift in degree: a choice of
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            induces an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msup
                    %mi R
                    %mo •
                  %mrow
                    %mo (
                    %mi X
                    %mo )
                  %munderover
                    %mo →
                    %mo ≃
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi PD
                        %mi X
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %msup
                    %mrow
                      %mo (
                      %mi H
                      %msup
                        %mi R
                        %mrow
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mo (
                        %mi X
                        %mo )
                      %mo )
                    %mo ∨
                  %mo ≃
                  %mi H
                  %msub
                    %mi R
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mrow
                    %mo (
                    %mi X
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H R^\bullet\left(X\right)
                  \\underoverset{\simeq}{\;\; PD_X\;\;}{\to}
                  \\left(
                  H R^{\bullet+ dim(X)}\left(X\right)\right)^\vee
                  \\simeq
                  H R_{\bullet + dim(X)}\left(X\right)
                  \\,.
          %p
            Using this, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            a map of
            %a.existingWikiWord{:href => "/nlab/show/closed+manifolds"} closed manifolds
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            of both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            induces from the canonical push-forward map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_\ast
            on homology the
            = succeed "/push-forward" do
              %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"} Umkehr map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo !
                  %mo =
                  %msub
                    %mo ∫
                    %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi H
                  %msup
                    %mi R
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %munderover
                    %mo →
                    %mo ≃
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi PD
                        %mi X
                      %mspace{:width => "thickmathspace"}
                  %mi H
                  %msub
                    %mi R
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi f
                        %mo *
                      %mspace{:width => "thickmathspace"}
                  %mi H
                  %msub
                    %mi R
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %munderover
                    %mo →
                    %mo ≃
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi PD
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                  %mi H
                  %msup
                    %mi R
                    %mrow
                      %mi n
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f^!
                  \=
                  \\int_f
                  \\;\colon\;
                  H R^\bullet(X)
                  \\underoverset{\simeq}{\;PD_X\;}{\to}
                  H R_{\bullet + dim(X)}(X)
                  \\stackrel{\; f_\ast \;}{\to}
                  H R_{\bullet + dim(X)}(Y)
                  \\underoverset{\simeq}{\;PD_Y^{-1}\;}{\to}
                  H R^{n-(dim(X)-dim(Y))}(Y)
                  \\,.
          %p
            This is ordinary
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msup
                    %mi ℝ
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \mathbb{R}^\bullet(X)
            is modeled by
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PD
                    %mi X
                %annotation{:encoding => "application/x-tex"} PD_X
            is given by a choice of
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo !
                  %mo =
                  %msub
                    %mo ∫
                    %mi f
                %annotation{:encoding => "application/x-tex"} f^! = \int_{f}
            is ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
          %p
            The shift in degree here seems to somewhat break the simple pattern. In fact this is not so, if only we realize that since we are working over spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em relative/fiberwise
            point of view and regard not duality in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} E Mod
            itself, but in the functor categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(X, E Mod)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} E Mod
          %p
            Accordingly, given an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\chi \;\colon \;  X \to E Mod
          %p
            we form not just the mapping space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E^\bullet(X) = [X, E]
            as above, but form the space of
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of this bundle, which we write:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi Γ
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E^{\bullet + \chi}(X) \coloneqq \Gamma_X(\chi)
          %p
            Here for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %munder
                    %mi lim
                    %mo →
                  %mi χ
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_X(\chi) \coloneqq [\underset{\to}{\lim} \chi, E]
                  \\,.
          %p Consider now a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                                %mi χ
                          %mo ↘
                        %mtd
                          %mo ⇙
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi χ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                          %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp; \stackrel{f}{\to} &amp;&amp; Y
                  \\\
                  \&amp; {}_{\mathllap{f^\ast \chi}}\searrow &amp;\swArrow&amp; \swarrow_{\mathrlap{\chi}}
                  \\\
                  \&amp;&amp; E Mod
                  }
          %p
            along which we want to integrate, whith
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            invertible in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(Y, E Mod)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msup
                          %mi χ
                          %mo ∨
                        %mo )
                      %mo ∨
                    %mo ≃
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \left(\chi^\vee\right)^\vee \simeq \chi
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msup
                          %mi χ
                          %mo ∨
                        %mo )
                      %mo ∨
                    %mo ≃
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \left(\chi^\vee\right)^\vee \simeq \chi
          %p
            Observe that we have the pair of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triples"} adjoint triples
            of left/right
            %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
            and
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Y
                        %mtd
                          %mover
                            %mo →
                            %mi p
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %mi Func
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi E
                          %mi Mod
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                              %mover
                                %mo ←
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mo !
                        %mtd
                          %mi Func
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi E
                          %mi Mod
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi p
                                    %mo *
                              %mover
                                %mo ←
                                %mrow
                                  %msup
                                    %mi p
                                    %mo *
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mo !
                        %mtd
                          %mi E
                          %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{f}{\to}&amp; Y &amp;\stackrel{p}{\to}&amp; \ast
                  \\\
                  \\\
                  Func(X, E Mod)
                  \&amp;\stackrel{\overset{f_!}{\to}}{\stackrel{\overset{f^\ast}{\leftarrow}}{\underset{f_\ast}{\to}}}
                  \&amp;
                  Func(Y, E Mod)
                  \&amp;\stackrel{\overset{p_!}{\to}}{\stackrel{\overset{p^\ast}{\leftarrow}}{\underset{p_\ast}{\to}}}
                  \&amp;
                  E Mod
                  }
                  \\,.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^\ast
            preserves duals, but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_!
            may not.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %msup
                    %mi f
                    %mo *
                  %msup
                    %mi χ
                    %mo ∨
                %annotation{:encoding => "application/x-tex"} f_! f^\ast \chi^\vee
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
            %em choice of twisted orientation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            is a choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} \beta \colon X \to E Mod
            together with a choice of a
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            (if such exists) of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PD
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mi f
                        %mo !
                      %msup
                        %mi f
                        %mo *
                      %msup
                        %mi χ
                        %mo ∨
                      %mo )
                    %mo ∨
                  %mo ≃
                  %msub
                    %mi f
                    %mo !
                  %mrow
                    %mo (
                    %msup
                      %mi f
                      %mo *
                    %mi χ
                    %mo +
                    %mi β
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  PD
                  \\;\colon \;
                  \\left( f_! f^\ast \chi^\vee
                  \\right)^\vee
                  \\simeq
                  f_!\left(
                  f^\ast \chi + \beta
                  \\right)
                  \\,,
          %p
            hence a choice of correction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_!
            preserving the duality of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} f^\ast \chi
          %p
            Then the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo !
                  %mo ⊣
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f_! \dashv f^\ast)
            %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %msup
                    %mi f
                    %mo *
                  %msup
                    %mi χ
                    %mo ∨
                  %mo →
                  %msup
                    %mi χ
                    %mo ∨
                %annotation{:encoding => "application/x-tex"}
                  f_! f^\ast \chi^\vee \to  \chi^\vee
          %p
            induces the
            %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo ⟶
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mi f
                        %mo !
                      %msup
                        %mi f
                        %mo *
                      %msup
                        %mi χ
                        %mo ∨
                      %mo )
                    %mo ∨
                  %munderover
                    %mo ⟶
                    %mo ≃
                    %mi PD
                  %msub
                    %mi f
                    %mo !
                  %mrow
                    %mo (
                    %msup
                      %mi f
                      %mo *
                    %mi χ
                    %mo +
                    %mi β
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\chi
                  \\longrightarrow
                  \\left(f_! f^\ast \chi^\vee \right)^\vee
                  \\underoverset{\simeq}{PD}{\longrightarrow}
                  f_!\left(
                  f^\ast \chi + \beta
                  \\right)
          %p
            and under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %msub
                      %mi p
                      %mo !
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                    %mo ,
                    %mi E
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left[ p_! \left( - \right), E \right]
            this becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %msub
                      %mi p
                      %mo !
                    %msub
                      %mi f
                      %mo !
                    %mrow
                      %mo (
                      %msup
                        %mi f
                        %mo *
                      %mi χ
                      %mo +
                      %mi β
                      %mo )
                    %mo ,
                    %mi E
                    %mo ]
                  %mo ⟶
                  %mrow
                    %mo [
                    %msub
                      %mi p
                      %mo !
                    %mi χ
                    %mo ,
                    %mi E
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  \\left[p_! f_! \left(f^\ast \chi + \beta\right), E\right]
                  \\longrightarrow
                  \\left[p_! \chi , E\right]
          %p which is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi E
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msup
                        %mi f
                        %mo *
                      %mi χ
                      %mo +
                      %mi β
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi E
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_f
                  \\;\colon \;
                  E^{\bullet + f^\ast \chi + \beta}(X)
                  \\longrightarrow
                  E^{\bullet + \chi}(Y)
                  \\,.
          %p
            This we may call the the
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+generalized+cohomology"} fiber integration
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %em
              twisted
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/index"} index
              map
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            %em
              , induced by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo ,
                      %mi PD
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\beta, PD)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta = 0
              then we call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PD
                  %annotation{:encoding => "application/x-tex"} PD
              an
            = succeed "_" do
              %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
          %p Notice that
          %ul
            %li
              %p
                Under fiber integration in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %li
              %p
                Grading in cohomology is just one incarnation of twist. Hence the fact that the twist changes under duality was already seen above in the ordinary case of
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality"} Poincaré duality
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %li
              %p
                For the special case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                %a.existingWikiWord{:href => "/nlab/show/Atiyah+duality"} Atiyah duality
                identifies the dual cohomology spectrum with the
                %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
                cohomology spectrum. Then a choice of orientation amounts to a choice of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
          %h2#GeneralTheory General theory
          %p
            We survey here some key aspects of a general theory of geometric twisted differential cohomology, following (
            %a{:href => "#Schreiber"}> DCCT
            ), in which the above examples find a formal home. This is meant as a reference for readers of the
            = succeed "-section" do
              %em
                %a{:href => "#Examples"} Examples
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We base the formulation of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            on the
            %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interpreted
            in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
          %p
            The following table indicates the hierarchy of
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            that we invoke, the fragments of
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            that can be
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interpreted
            with these and the
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            that we need. Essentially all of the above discussion works in the model
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            and works in the model
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SmoothSuper%E2%88%9EGrpd"} SmoothSuper∞Grpd
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
                %th
                  %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
                %th
                  %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
                %th
                  typical
                  %a.existingWikiWord{:href => "/nlab/show/models"} models
                %th expressiveness
            %tbody
              %tr
                %td{:style => "text-align: left;"} bare minimum
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"}> ∞Grpd
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/Super%E2%88%9EGrpd"} Super∞Grpd
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"}> cohomology
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"} principal bundles
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
                  %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated
                  and
                  %a.existingWikiWord{:href => "/nlab/show/twisted+bundles"} twisted bundles
              %tr
                %td{:style => "text-align: left;"}
                  +
                  %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"}> locality
                  +
                  %a.existingWikiWord{:href => "/nlab/show/locally+infinity-connected+%28infinity%2C1%29-topos"} ∞-connectedness
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"}> Smooth∞Grpd
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/SmoothSuper%E2%88%9EGrpd"} SmoothSuper∞Grpd
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization"}> geometric realization
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
                  %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory"} Chern-Weil theory
                  = succeed "," do
                    %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} Chern-Simons theory
                  %a.existingWikiWord{:href => "/schreiber/show/infinity-geometric+prequantization"} geometric quantization
              %tr
                %td{:style => "text-align: left;"}
                  +
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion"} infinitesimals
                %td{:style => "text-align: left;"} differential homotopy type theory
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion"} differential (∞,1)-topos
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+space"}> de Rham space
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+infinity-groupoid"} étale groupoid
                  %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
          %h3#homotopy_type_theory Homotopy type theory
          %p
            Traditionally a
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            regarded up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            – as
            = succeed "." do
              %em geometric homotopy types
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            as part of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy-type theory
          %p
            We discuss now some basic structures that are expressible in such bare homotopy-type theory. (The fundamentals are due to
            %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Rezk
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Lurie
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            in slices and add some aspects about higher bundle theory from (
            %a{:href => "#NSS"}> NSS
            )).
          %p
            Where useful, we indicate some of the discussion in formal
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
            %em
              %a.existingWikiWord{:href => "/nlab/show/HoTT+methods+for+homotopy+theorists"} HoTT methods for homotopy theorists
            for more along such lines.
          %h4#Cohomology Cohomology
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28infinity%2C1%29-category"} group object
            in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is a groupal
            = succeed "-homotopy" do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            there is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mover
                    %munderover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo ≃
                    %mover
                      %mo ←
                      %mi Ω
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  Grp(\mathbf{H})
                  \\stackrel{\overset{\Omega}{\leftarrow}}{\underoverset{\mathbf{B}}{\simeq}{\to}}
                  \\mathbf{H}_{\geq 1}^{*/}
          %p
            between group objects and
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28%E2%88%9E%2C1%29-topos"} connected
            homotopy types.
          #DeloopingInTypeTheory.num_remark
            %h6#remark_6 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pt
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} pt : \mathbf{B}G
              is the essentially uniqe point of the
              %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28%E2%88%9E%2C1%29-topos"} connected
              type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≔
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo ≃
                    %mi pt
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G \coloneqq \vdash (pt \simeq pt) : Type
                    \\,,
            %p
              the type of auto-equivalences of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pt
                  %annotation{:encoding => "application/x-tex"} pt
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            a group object which admits an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any object, we write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(X, \mathbf{B}^n A)
                for the space of degree-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo :
                        %mi X
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} c : X \to A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mi π
                        %mn 0
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^n(X,A) \coloneqq \pi_0 \mathbf{H}(X, \mathbf{B}^n A)
                for the degree-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %h4#PrincipalBundles Principal bundles
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
            = succeed "-cocycles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            have an equivalent geometric interpretation as
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P
                  \\\
                  \\downarrow
                  \\\
                  X
                  }
          %p
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi P
                  %mo ×
                  %mi G
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \rho : P \times G \to P
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} ∞-quotient
            of the action is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %strong Theorem
            There is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
            between the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %munderover
                      %mo →
                      %mi fib
                      %mo ≃
                    %mover
                      %mo ←
                      %munder
                        %mi lim
                        %mo →
                  %mi G
                  %mi Bund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X, \mathbf{B}G)
                  \\stackrel{\overset{\underset{\to}{\lim}}{\leftarrow}}{\underoverset{fib}{\simeq}{\to}}
                  G Bund(X)
          %p
            From left to righr the equivalence is established by sending a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X\to \mathbf{B}G
            to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
          %p
            (
            %a{:href => "#NSS"}> NSS
            )
          .num_remark
            %h6#remark_7 Remark
            %p
              With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              the type as in remark
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopingInTypeTheory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbf{B}G
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo :
                    %mi X
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi pt
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    P
                    \\;
                    \\coloneqq
                    \\;
                    x : X \vdash ( \phi(x)  \simeq  pt ) : Type
            %p And the action is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mi ρ
                            %mo :
                            %mi P
                            %mo ×
                            %mi G
                            %mo →
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo :
                            %mi X
                            %mo ;
                            %mi p
                            %mo :
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mi pt
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi g
                            %mo :
                            %mo{:stretchy => "false"} (
                            %mi pt
                            %mo ≃
                            %mi pt
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo :
                            %mi X
                            %mo ;
                            %mi g
                            %mo ∘
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; \rho : P \times G \to G
                    \\\
                    \&amp; \;\;\coloneqq
                    (( x : X; p : (\phi(x) \simeq pt)), g : (pt \simeq pt) )
                    \\mapsto
                    (x : X; g \circ \phi)
                    \\end{aligned}
          %h4#TwistedCohomology Twisted cohomology
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/ \mathbf{B}G}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
            is naturally interpreted as follows
          %ol
            %li
              %p
                a local coefficient object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo :
                      %mi E
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{c} : E \to \mathbf{B}G
                is a
                = succeed ";" do
                  %em universal bundle of local coefficients
            %li
              %p
                a domain object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbf{B}G
                is a
                = succeed ";" do
                  %em twisting bundle
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mi σ
                            %mtd
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi ϕ
                              %mo ↘
                            %mtd
                              %msub
                                %mo ⇙
                                %mo ≃
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;&amp;\stackrel{\sigma}{\to}&amp;&amp; E
                      \\\
                      \&amp; {}_{\mathllap{\phi}}\searrow &amp;\swArrow_{\simeq}&amp; \swarrow_{\mathrlap{\mathbf{c}}}
                      \\\
                      \&amp;&amp; \mathbf{B}G
                      }
              %p
                is equivalently a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
                bundle
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mo *
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \phi^* E \to X
              .maruku-equation
