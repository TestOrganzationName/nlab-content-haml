                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}(G_1 \to G_0)
                      \=
                      \\left\{
                      \\array{
                      \&amp;&amp; *
                      \\\
                      \&amp; {}^{\mathllap{g_1}}\nearrow &amp;\Downarrow^{\mathrlap{h}}&amp; \searrow^{\mathrlap{g_2}}
                      \\\
