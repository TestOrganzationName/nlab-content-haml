                            %mtr
                              %mtd
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mn 3
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo →
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi Aut
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mn 2
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %msub
                                  %mi ℤ
                                  %mn 2
                      %annotation{:encoding => "application/x-tex"} \array{ \mathbf{B}^3 U(1) &amp;\to&amp; \mathbf{B}Aut(\mathbf{B}^2 U(1)) \\ &amp;&amp; \downarrow \\ &amp;&amp; \mathbf{B}\mathbb{Z}_2 }
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten orientifold
          %h3#VielbeinFields
            %strong I)
            Geometric structure (generalized, exceptional)
          %p
            The ordinary notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            in
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            (equivalently:
            %em
              %a.existingWikiWord{:href => "/nlab/show/soldering+form"} soldering form
            or
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
          %h4#ClassOfTheTangentBundle The class of the tangent bundle
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            By definition this means that there is an
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ℝ
                    %mi n
                  %munderover
                    %mo →
                    %mo ≃
                    %mrow
                      %msubsup
                        %mi ϕ
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %msub
                    %mi U
                    %mi i
                  %mo ↪
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{ \mathbb{R}^n \underoverset{\simeq}{\phi_i^{-1}}{\to} U_i \hookrightarrow X\}
          %p
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                %annotation{:encoding => "application/x-tex"} U_i \cap U_j
            of two charts, the
            %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/coordinate+transformations"} coordinate transformations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi j
                  %mo ∘
                  %msubsup
                    %mi ϕ
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ⊂
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\phi_j\circ \phi_i^{-1}
                  \:
                  U_i \cap U_j \subset \mathbb{R}^n \to \mathbb{R}^n
          %p
            form the
            %a.existingWikiWord{:href => "/nlab/show/Jacobian+matrix"} Jacobian matrix
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi μ
                  %msub
                    %mrow
                    %mi μ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo [
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi ν
                    %msub
                      %mi ϕ
                      %mi j
                    %mo ∘
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ]
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo →
                  %msub
                    %mi GL
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  ((\lambda_{i j})^{\mu}{}_{\mu})
                  \\coloneqq
                  \\left[\frac{d}{d x^\nu} \phi_j \circ \phi_i^{-1} (x^\mu)
                  \\right]
                  \:
                  U_i \cap U_j
                  \\to
                  GL_n
          %p
            with values in invertible
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
            %a.existingWikiWord{:href => "/nlab/show/matrix+product"} matrix product
            equations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi μ
                  %msub
                    %mrow
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mrow
                      %mi j
                      %mi k
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi λ
                  %msub
                    %mrow
                    %mi ν
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi k
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi μ
                  %msub
                    %mrow
                    %mi ν
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (\lambda_{i j})^\mu{}_\lambda (\lambda_{j k})^\lambda{}_{\nu}
                  \=
                  (\lambda_{i k})^\mu{}_{\nu}
                  \\,,
          %p (here and in the following sums over an index appearing upstairs and downstairs are explicit)
          %p hence the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi j
                  %mo ⋅
                  %msub
                    %mi λ
                    %mrow
                      %mi j
                      %mi k
                  %mo =
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi k
                %annotation{:encoding => "application/x-tex"}
                  \\lambda_{i j} \cdot \lambda_{j k} = \lambda_{i k}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ∩
                  %msub
                    %mi U
                    %mi k
                  %mo ,
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(U_i \cap U_j \cap U_k, GL(n))
            of smooth
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
          %p
            This is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              condition
            for a smooth
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
            in degree 1 with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            (precisely: with coefficients in the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            ). We write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msubsup
                    %mi H
                    %mi smooth
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [(\lambda_{i j})] \in H^1_{smooth}(X, GL_n)
                  \\,.
          %p
            It is useful to reformulate this statement in the language of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                itself is a Lie groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mover
                        %mo →
                        %mo →
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \stackrel{\to}{\to} X)
                with trivial morphism structure;
            %li
              %p
                from the atlas
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                we get the corresponding
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mover
                        %mo →
                        %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo ↗
                              %mtd
                                %mo =
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi i
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mo →
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi for
                        %mspace{:width => "thinmathspace"}
                        %mi x
                        %mo ∈
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ∩
                        %msub
                          %mi U
                          %mi k
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      C(\{U_i\}) =
                      (\coprod_{i, j} U_i \cap U_j \stackrel{\to}{\to} \coprod_i U_i)
                      \=
                      \\left\{
                      \\array{
                      \&amp;&amp; (x,j)
                      \\\
                      \&amp; \nearrow &amp;=&amp; \searrow
                      \\\
                      (x,i) &amp;&amp;\to&amp;&amp; (x,k)
                      }
                      \\;\;\;
                      for\, x \in U_i \cap U_j \cap U_k
                      \\right\}
                      \\,,
              %p
                whose objects are the points in the atlas, with morphisms identifying lifts of a point in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to different charts of the atlas;
            %li
              %p
                any
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                induces its
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo =
                      %mrow
                        %mo (
                        %mi G
                        %mover
                          %mo →
                          %mo →
                        %mo *
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}G
                      \=
                      \\left(
                      G \stackrel{\to}{\to} *
                      \\right)
                      \\,.
          %p
            The above situation is neatly encoded in the existence of a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of Lie groupoids of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi λ
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo .
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ≃
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C(\{U_i\}) &amp;\stackrel{\lambda}{\to}&amp; \mathbf{B} GL(n).
                  \\\
                  {}^{\mathllap{\simeq}}\downarrow
                  \\\
                  X
                  }
                  \\,,
          %p where
          %ul
            %li
              %p
                the left morphism is
                = succeed "-wisse" do
                  %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
                %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
                of each point) an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
                (we make this more precise in a moment);
            %li
              %p
                the horizontal functor has as components the functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi λ
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} \lambda_{i j}
                and its functoriality is the cocycle condition
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi λ
                          %mrow
                            %mi i
                            %mi j
                        %mo ⋅
                        %msub
                          %mi λ
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi λ
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \lambda_{i j} \cdot \lambda_{j k} = \lambda_{i k}
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} transformation
            of smooth functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mn 1
                  %mo ⇒
                  %msub
                    %mi λ
                    %mn 2
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda_1 \Rightarrow \lambda_2 : C(\{U_i\}) \to \mathbf{B} GL(n)
            is precisely a
            %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
            between two such cocycles.
          %h4#SmoothModuliStacks Smooth moduli stacks
          %p
            We want to think of such a diagram as being directly a morphism of
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  T X \; : \; X \to \mathbf{B} GL(n) \;\; \in \mathbf{H}
          %p
            in a suitable context
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            class of a map into the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B GL(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Top
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \to B GL(n) \in Top
                  \\,.
          %p
            Evidently, for this we need to turn the
            = succeed "-wise" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
            into an actual
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} non-abelian/non-stable
            generalization of what happens in the construction of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological branes
          %p
            To make this precise, first notice that every Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mover
                    %mo →
                    %mo →
                  %msub
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = (A_1 \stackrel{\to}{\to} A_0)
            yields on each smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            a groupoid of maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  A : U \mapsto (C^\infty(U,A_1) \stackrel{\to}{\to} C^\infty(U,A_0))
                  \\,,
          %p
            the groupoid of
            %em
              smooth
              = succeed "-families" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            of elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Moreover, for every smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 1
                  %mo →
                  %msub
                    %mi U
                    %mn 2
                %annotation{:encoding => "application/x-tex"} U_1 \to U_2
            there is an evident restriction map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(U_2) \to A(U_1)
            and so this yields a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            of groupoids, hence a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi SmthMfd
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Func(SmthMfd^{op}, Grpd)
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            says that thinking of Lie groupoids as presheaves of ordinary groupoids this way does not lose information — and
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            say that it is generally a good idea.
          %p Let therefore
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SmthMfd
                    %mi op
                  %mo ,
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %mi stalkwise
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo .
                  %mi e
                  %msup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq Func(SmthMfd^{op}, Grpd)[\{stalkwise\, h.e\}^{-1}]
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} localization
            of groupoid-valued presheaves that universally turns
            = succeed "wise" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            into actual homotopy equivalences: if a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \eta : A \to B
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi SmthMfd
                    %mi op
                  %mo ,
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func(SmthMfd^{op}, Grpd)
            is such that for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
            and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} x \in U
            there is a
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi x
                  %mo ⊂
                  %mi U
                %annotation{:encoding => "application/x-tex"} U_x \subset U
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(U_x) : A(U_x) \to B(U_x)
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            has a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+inverse"} homotopy inverse
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            We call this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            the
            %em
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            of
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth groupoids
            or of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth stacks
          %p
            Discussed there are tools for describing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            concretely. For the moment we only need to know that
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
                of every
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                has a
                %a.existingWikiWord{:href => "/nlab/show/homotopy+inverse"} homotopy inverse
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %li
              %p
                if the cover is
                %em
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is a Lie group, then every morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                is presented by a
                %a.existingWikiWord{:href => "/nlab/show/anafunctor"} zig-zag
                of the form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo ←
                          %mo ≃
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} X \stackrel{\simeq}{\leftarrow} C(\{U_i\}) \to \mathbf{B}G
          %p Then we have
          %ol
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B} GL(n)
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                is precisely a smooth real vector bundle on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                a homotopy between two such morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                is precisely a smooth
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} GL(n)
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                between the two vector bundles.
          %p
            Therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}GL(n)
            regarded as an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of real vector bundles.
          %p
            Of course there is a “smaller” Lie groupoid that also classifies real vector bundles, but whose gauge transformations are restricted to be
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
          %h4#ReductionOfTheStructureGroup Reduction of the structure group
          %p
            Consider the defining inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            into the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  O(n) \hookrightarrow GL(n)
                  \\,.
          %p
            We may understand this inclusion geometrically in terms of the canonical
            %a.existingWikiWord{:href => "/nlab/show/metric"} metric
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theoretically
            as the inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            (it is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            of the underlying
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %em only
            encodes geometric information.
          %p
            The inclusion induces a corresponding inclusion (
            %a.existingWikiWord{:href => "/nlab/show/truncated+object+of+an+%28infinity%2C1%29-category"}> 0-truncated morphism
            ) of moduli stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Orth} : \mathbf{B} O(n) \to \mathbf{B} GL(n)
                  \\;\;\;
                  \\in \mathbf{H}
          %p simply by regarding it as a morphism of Lie groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (O(n) \stackrel{\to}{\to} * )
                  \\to
                  (GL(n) \stackrel{\to}{\to} * )
          %p in the evident way.
          %p
            Now we can say what a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is:
          %p
            A choice of
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            is a factorization of the above
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Orth
                  %annotation{:encoding => "application/x-tex"} \mathbf{Orth}
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi λ
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi E
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Orth
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{h}{\to}&amp;&amp; \mathbf{B} O(n)
                  \\\
                  \&amp; {}_{\mathllap{\lambda}}\searrow &amp;\swArrow_{\mathrlap{E^{-1}}}&amp; \swarrow_{\mathrlap{\mathbf{Orth}}}
                  \\\
                  \&amp;&amp; \mathbf{B}GL(n)
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p This consists of two pieces of data
          %ul
            %li
              %p
                the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
                is (by the same reasoning as for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                above) a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
                %em orthogonal transition functions
                – hence on each overlap of coordinate patches a smooth function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi h
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                      %msup
                        %mrow
                        %mi a
                      %msub
                        %mrow
                        %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo →
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      ((h_{i j}){}^a{}_b) : U_i \cap U_j \to O(n)
              %p such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mrow
                          %mi i
                          %mi j
                      %mo ⋅
                      %msub
                        %mi h
                        %mrow
                          %mi j
                          %mi k
                      %mo =
                      %msub
                        %mi h
                        %mrow
                          %mi i
                          %mi k
                    %annotation{:encoding => "application/x-tex"}
                      h_{i j} \cdot h_{j k} = h_{i k}
              %p
                on all triple overlaps of coordinate charts
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ∩
                        %msub
                          %mi U
                          %mi k
                      %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
            %li
              %p
                the homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is on each chart a function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi i
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi a
                      %msub
                        %mrow
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      E_i  = ((E_i)^a{}_\mu) : U_i \to GL(n)
              %ul
                %li
                  %p
                    such that on each overlap of coordinate charts it intertwines the transition functions
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda
                    of the tangent bundle with the new orthogonal transition functions, meaning that the equation
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mi i
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi a
                          %msub
                            %mrow
                            %mi μ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi λ
                            %mrow
                              %mi i
                              %mi j
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi μ
                          %msub
                            %mrow
                            %mi ν
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi h
                            %mrow
                              %mi i
                              %mi j
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi a
                          %msub
                            %mrow
                            %mi b
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mi j
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi b
                          %msub
                            %mrow
                            %mi ν
                        %annotation{:encoding => "application/x-tex"}
                          (E_i)^a{}_{\mu} (\lambda_{i j})^{\mu}{}_\nu
                          \=
                          (h_{i j})^a{}_b (E_j)^b{}_\nu
                  %p
                    holds. This exhibits the
                    %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
                    %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                    of
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi E
                          %annotation{:encoding => "application/x-tex"} E
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi E
                                    %mi i
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi λ
                                      %mrow
                                        %mi i
                                        %mi j
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi h
                                      %mrow
                                        %mi i
                                        %mi j
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi E
                                    %mi j
                            %mtd
                              %mo *
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      * &amp;\stackrel{E_i}{\to}&amp; *
                      \\\
                      {}^{\mathllap{\lambda_{i j}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{h_{i j}}}
                      \\\
                      * &amp;\stackrel{E_j}{\to}&amp; *
                      }
          %p
            The component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            defines an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the corresponding
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mi T
                  %mi X
                  %mover
                    %mo →
                    %mo ≃
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  E : T X \stackrel{\simeq}{\to} V
          %p
            between a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \to X
            with
            %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
            explicitly being the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            itself, hence it exhibits the
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
          %h4#ModuliSpaceOfOrhtogonalStructures Moduli space of orthogonal structures: twisted cohomology
          %p
            We consider now the space of choices of vielbein fields on a given tangent bundle, hence the
            %em
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structures"} orthogonal structures
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metrics"} Riemannian metrics
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This is usefully discussed in terms of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{c} : \mathbf{B}O(n) \to \mathbf{B}GL(n)
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n) \backslash GL(n)
          %p This means that there is a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  GL(n)/O(n) &amp;\to&amp; \mathbf{B}O(n)
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                  \\\
                  * &amp;\to&amp; \mathbf{B} GL(n)
                  }
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)/O(n)
            is
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
            with the property of sitting in such a diagram.
          %p
            We may think of this
            %em
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            as being a bundle in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            over the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}GL(n)
            with typical fiber
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)/O(n)
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated bundle
            to the smooth
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal GL(n)-bundle
            induced by the canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)\backslash GL(n)
          %p
            One basic properties of homotopy pullbacks is that they are preserved by forming
            %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
            out of any other object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\infty(X,GL(n)/O(n)) &amp;\to&amp; \mathbf{H}(X,\mathbf{B}O(n))
                  \&amp;\to&amp;
                  \\mathbf{H}(X, \mathbf{B}GL(n))
                  }
          %p
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that the underlying tangent bundle is trivializable, are given by smooth functions into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)/O(n)
          %p
            This means that if the tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            is trivializable, then the coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo \
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)\backslash GL(n)
            is the moduli space for vielbein fields on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mi trivializable
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mi SpaceOfVielbeinFieldsOn
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo \
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo \
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (T X \; trivializable)
                  \\Rightarrow
                  SpaceOfVielbeinFieldsOn(T X)
                  \=
                  \\mathbf{H}(X, O(n)\backslash GL(n)) = C^\infty(X, O(n)\backslash GL(n))
                  \\,.
          %p
            However, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            is not trivial, then this is true only locally: there is then an
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            such that restricted to each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            the moduli space of vielbein fields is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ,
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(U_i, GL(n)/ O(n))
          %p
            the tangent bundle
            %em twists
            the functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to GL(n)/O(n)
            = succeed "-_" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            = succeed "_" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %em twisting local coefficient bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
          %p We can make this more manifest by writing equivalently
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  O(n)\backslash GL(n) &amp;\to&amp; (O(n)\backslash GL(n)) // GL(n)
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}GL(n)
                  }
                  \\,,
          %p
            where now on the right we have inserted the
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            resolution of the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{c}
            as provided by the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)\backslash GL(n)
          %p The pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi T
                          %mi X
                          %msub
                            %mo ×
                            %mrow
                              %mi GL
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi T
                              %mi X
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T X \times_{GL(n)} (O(n)\backslash GL(n))
                  \&amp;\to&amp;
                  O(n)\backslash GL(n) // GL(n)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\stackrel{T X}{\to}&amp; \mathbf{B}GL(n)
                  }
          %p
            gives the non-linear
            = succeed "-associated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            = succeed "-0-cohomology\u201D," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)\backslash GL(n)
          %h4#moduli_stack_of_orthogonal_structures Moduli stack of orthogonal structures
          %p
            The above says that the space of vielbein fields is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            in the
            %a.existingWikiWord{:href => "/nlab/show/over-%28infinity%2C1%29-topos"} slice (2,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL(n)}
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Orth} : \mathbf{B}O \to \mathbf{B}GL(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %msub
                    %mi Struc
                    %mi TX
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Orth} Struc_{TX}(X)
                  \\coloneqq
                  \\mathbf{Orth}(T X)
                  \\coloneqq
                  \\mathbf{H}_{/\mathbf{B}GL(n)}(T X, \mathbf{Orth})
                  \\,.
          %p
            But also this space of choices of vielbein fields has a smooth structure, it is itself a smooth
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in the slice over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}GL(n)
            of the
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-category"} locally cartesian closed (2,1)-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi OrthStruc
                    %mrow
                      %mi T
                      %mi X
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{OrthStruc}_{T X}(X)
                  \\coloneqq
                  [T X, \mathbf{Orth}]_{\mathbf{B}GL(n)}
                  \\,.
          %p
            For more on this see also the discussion at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/general+covariance"} general covariance
          %h4#SpinConnection Differential refinement: Spin connection
          %p
            We may further refine this discussion to
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            to get genuine
            %em differential
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            = succeed "-structures." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
          %p
            Recall that the moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is presented in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            by the presheaf of groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo :
                  %mi U
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} G : U \mapsto (C^\infty(U,G) \stackrel{\to}{\to} *)
                  \\,.
          %p
            We may think of this for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            as being the groupoid of
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            on the trivial
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            valued form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U, \mathfrak{g})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo :
                  %mi U
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G_{conn} : U \mapsto (C^\infty(U,G) \times \Omega^1(U, \mathfrak{g}) \stackrel{\to}{\to} \Omega^1(U, \mathfrak{g}) )
          %p
            is that of
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} SmoothGrpd
            this the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi G
                  %msub
                    %mi Bund
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X, \mathbf{B}G_{conn})
                  \\simeq
                  G Bund_\nabla(X)
                  \\,.
          %p
            The morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Orth
                %annotation{:encoding => "application/x-tex"} \mathbf{Orth}
            has an evident differential refinement to a morphism between such differentially refined moduli stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Orth
                    %mi conn
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Orth}_{conn} : \mathbf{B}O(n)_{conn} \to \mathbf{B}GL(n)_{conn}
          %p
            by acting on the differential forms with the induced inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+Lie+algebra"} orthogonal Lie algebra
            into the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+Lie+algebra"} general linear Lie algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔬
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝔤𝔩
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{o}(n) \hookrightarrow \mathfrak{gl}(n)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of this differential refinement turns out to be the same moduli space as before
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Orth
                                  %mi conn
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  GL(n)/ O(n) &amp;\to&amp; \mathbf{B} O(n)_{conn}
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{Orth}_{conn}}}
                  \\\
                  \&amp;&amp; \mathbf{B} GL(n)_{conn}
                  }
                  \\,,
          %p
            so that the moduli space of “differential vielbein fields” is the same as that of plain vielbein fields. But we nevertheless do gain differential information: consider an
            %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
            on the tangent bundle, which is now given by a morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the moduli stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mi T
                      %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{T X} : X \to \mathbf{B}GL(n)
                  \\,.
          %p
            This is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            which locally on an atlas is given by the
            %a.existingWikiWord{:href => "/nlab/show/Christoffel+symbols"} Christoffel symbols
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi i
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Γ
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi μ
                  %mrow
                  %msup
                    %mrow
                    %mi α
                  %msub
                    %mrow
                    %mi β
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ,
                  %mi 𝔤𝔩
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_i = ((\Gamma_i)_\mu{}{}^{\alpha}{}_\beta)
                  \\in
                  \\Omega^1(U_i, \mathfrak{gl}(n))
                  \\,.
          %p
            A
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %mi T
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \nabla_{T X}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∇
                                %mi V
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi O
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mo ∇
                                  %mrow
                                    %mi T
                                    %mi X
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %msup
                                %mi E
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                        %mtd
                          %msub
                            %mo ↙
                            %mover
                              %mstyle{:mathvariant => "bold"}
                                %mi Orth
                              %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{\nabla_{V}}{\to}&amp;&amp; \mathbf{B}O_{conn}
                  \\\
                  \&amp; {}_{\mathllap{\nabla_{T X}}}\searrow
                  \&amp;\swArrow_{E^{-1}}&amp;
                  \\swarrow_{\hat {\mathbf{Orth}}}
                  \\\
                  \&amp;&amp; \mathbf{B}GL(n)_{conn}
                  }
                  \\,.
          %p
            In components over the atlas,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi V
                %annotation{:encoding => "application/x-tex"} \nabla_V
            is a “
            %a.existingWikiWord{:href => "/nlab/show/spin+connection"}> spin connection
            ” given by local 1-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi ω
                    %mi i
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ,
                  %mi 𝔬
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\omega_i \in \Omega^1(U_i, \mathfrak{o}(n))\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mi i
                  %mo =
                  %msub
                    %mi E
                    %mi i
                  %msub
                    %mi d
                    %mi dR
                  %msubsup
                    %mi E
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo +
                  %msub
                    %mi E
                    %mi i
                  %mi Γ
                  %msubsup
                    %mi E
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\omega_i = E_i d_{dR} E_i^{-1} + E_i \Gamma E_i^{-1}
          %p
            and the vielbeing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            now exhibits on each chart
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            the familiar relation between the components of the spin connection and the Christoffel-symbols:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %msup
                    %mrow
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %mo =
                  %msubsup
                    %mi E
                    %mi i
                    %mi a
                  %msub
                    %mrow
                    %mi ν
                  %msub
                    %mi d
                    %mi dR
                  %msubsup
                    %mi E
                    %mi i
                    %mi ν
                  %msub
                    %mrow
                    %mi b
                  %mo +
                  %msubsup
                    %mi E
                    %mi i
                    %mi a
                  %msub
                    %mrow
                    %mi ν
                  %msub
                    %mi Γ
                    %mi i
                  %msup
                    %mrow
                    %mi ν
                  %msub
                    %mrow
                    %mi λ
                  %msubsup
                    %mi E
                    %mi i
                    %mi λ
                  %msub
                    %mrow
                    %mi b
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega{}^a{}_b
                  \=
                  E_i^a{}_\nu d_{dR} E_i^\nu{}_b
                  +
                  E_i^a{}_\nu \Gamma_i {}^\nu{}_\lambda E_i^\lambda{}_b
                  \\,.
          %h4#PullbackOfOrthogonalStructures Pullback of orthogonal structures
          %p
            It is a familiar fact that many fields in physics “naturally pull back”. For instance a
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            on a
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbb{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f : Y \to X
            any
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            between spactimes, there is the corresponding pullback function/field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi ϕ
                    %mo :
                    %mi Y
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} f^* \phi : Y \to \mathbb{C}
          %p
            Similarly for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbf{B}G_{conn}
            a gauge field, as discussed above, it has naturally a pullback along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            given simply by forming the composite
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi ϕ
                    %mo :
                    %mi Y
                    %mover
                      %mo →
                      %mi f
                    %mi X
                    %mover
                      %mo →
                      %mi ϕ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} f^* \phi : Y \stackrel{f}{\to} X \stackrel{\phi}{\to} \mathbf{B}G_{conn}
          %p
            But the situation is a little different for
            %em twisted
            fields such as orthogonal structures/Riemannian metrics. If we think of a Riemannian metric as given by a non-degenerate rank-2
            %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            will always be a rank-2 tensor, it is not in general non-degenerate anymore – unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
          %p
            This is also nicely formulated in the language used above, in a way that has a useful generalization when we come to higher twisted structures below: since the metric is encoded not just in a plain morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi O
                  %annotation{:encoding => "application/x-tex"} h : X \to \mathbf{B}O
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi T
                                %mi X
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mi E
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi orth
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp; \stackrel{h}{\to} &amp;&amp; \mathbf{B} O
                  \\\
                  \&amp; {}_{\mathllap{T X}}\searrow &amp; \swArrow_{E}&amp; \swarrow_{\mathrlap{orth}}
                  \\\
                  \&amp;&amp; \mathbf{B} GL
                  }
          %p
            a simple precomposition with just a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f : Y \to X
            is not the right operation to send this triangle based on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to one based on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            But since this triangle is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi orth
                %annotation{:encoding => "application/x-tex"} (h,E) : T X \to \mathbf{orth}
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL}
            %em does
            pull back precisely along refinements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f : Y \to X
            to a morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL}
          %p Such a refinement is a commuting triangle of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi T
                                %mi Y
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                                %mi T
                                %mi X
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y &amp;&amp;\stackrel{f}{\to}&amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{T Y}}\searrow &amp;\swArrow_{\simeq}&amp; \swarrow_{\mathrlap{T X}}
                  \\\
                  \&amp;&amp; \mathbf{B} GL
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Y
                  %mo ≃
                  %msup
                    %mi f
                    %mo *
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T Y \simeq f^* T X
            between the tangent bundle of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            and the pullback of the tangent bundle on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
          %h4#generalized_vielbein_fields_type_ii_geometry_generalized_cy_and_uduality Generalized vielbein fields: type II geometry, generalized CY and U-duality
          %p
            The above discussion of ordinary
            %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            fields is just a special case of an analogous discussion for general
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/reduction+of+structure+groups"} reduction of structure groups
            %a.existingWikiWord{:href => "/nlab/show/generalized+vielbein"} generalized vielbein
            fields. Many geometric structures in string theory arise in this way, as indicated in the
            = succeed "." do
              %a{:href => "#TableOfTwists"} table of twists
          %p
            As one more out of these examples, we discuss in the above language of twisted smooth cohomology how a
            %em
              %a.existingWikiWord{:href => "/nlab/show/type+II+geometry"} type II geometry
            of
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            is the
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            of the
            %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"} generalized tangent bundle
            along the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d) \times O(d) \to O(d,d)
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{O}(d) \times \mathrm{O}(d)
                  \\to
                  \\mathrm{O}(d,d)
          %p
            of those
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal transformations
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            of signature
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d,d)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{O}(d,d)
            is presented as the group of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi d
                    %mo ×
                    %mn 2
                    %mi d
                  %annotation{:encoding => "application/x-tex"} 2d \times 2d
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrices
            that preserve the
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            given by the
            = succeed "-matrix" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi d
                    %mo ×
                    %mn 2
                    %mi d
                  %annotation{:encoding => "application/x-tex"} 2d \times 2d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo ≔
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %msub
                              %mi{:mathvariant => "normal"} id
                              %mi d
                        %mtr
                          %mtd
                            %msub
                              %mi{:mathvariant => "normal"} id
                              %mi d
                          %mtd
                            %mn 0
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\eta
                  \\coloneqq
                  \\left(
                  \\array{
                  0 &amp; \mathrm{id}_d
                  \\\
                  \\mathrm{id}_d &amp; 0
                  }
                  \\right)
          %p
            then this inclusion sends a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mo +
                  %mo ,
                  %msub
                    %mi A
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A_+, A_-)
            of
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
            = succeed "-matrices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mo +
                  %mo ,
                  %msub
                    %mi A
                    %mo −
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mfrac
                    %mn 1
                    %msqrt
                      %mn 2
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msub
                              %mi A
                              %mo −
                          %mtd
                            %msub
                              %mi A
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi A
                              %mo −
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi A
                              %mo −
                          %mtd
                            %msub
                              %mi A
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msub
                              %mi A
                              %mo −
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (A_+ , A_-)
                  \\mapsto
                  \\frac{1}{\sqrt{2}}
                  \\left(
                  \\array{
                  A_+ + A_- &amp; A_+ - A_-
                  \\\
                  A_+ - A_- &amp; A_+ + A_-
                  }
                  \\right)
                  \\,.
          %p
            This induces the corresponding morphism of
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi TypeII
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{TypeII}
                  \:
                  \\mathbf{B}(\mathrm{O}(d) \times \mathrm{O}(d))
                  \\to
                  \\mathbf{B} \mathrm{O}(d,d)
                  \\,.
          %p
            Forming the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            now yields the local coefficient bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi{:mathvariant => "normal"} O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi TypeII
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi{:mathvariant => "normal"} O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  O(d) \backslash O(d,d) / O(d)
                  \&amp;\to&amp;
                  \\mathbf{B}(\mathrm{O}(d) \times \mathrm{O}(d))
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{TypeII}}}
                  \\\
                  \&amp;&amp; \mathbf{B} \mathrm{O}(d,d)
                  }
                  \\,,
          %p There is also a canonical embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} GL
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{GL}(d) \hookrightarrow \mathrm{O}(d,d)
          %p
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
          %p In the above matrix presentation this is given by sending
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %msup
                              %mi a
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi T
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  a
                  \\mapsto
                  \\left(
                  \\array{
                  a &amp; 0
                  \\\
                  0 &amp; a^{-T}
                  }
                  \\right)
                  \\,,
          %p
            where in the bottom right corner we have the
            %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose
            of the inverse matrix of the invertble matrix
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
            Under this inclusion, the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            defines an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
