                    %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^{n+1}_{cl}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
