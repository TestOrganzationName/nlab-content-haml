                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            canonically associated to this composite cocycle may canonically be identified with the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            vector bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo ⊕
                    %msup
                      %mi T
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X \oplus T^* X
            %strong
              %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"} generalized tangent bundle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Therefore we may canonically consider the groupoid of
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo ⊕
                    %msup
                      %mi T
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X \oplus T^* X
            = succeed "-structures," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi TypeII
                  %annotation{:encoding => "application/x-tex"} \mathbf{TypeII}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structures"} twisted differential c-structures
          %p
            A
            %strong type II generalized vielbein
            on a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mover
                                %mo{:stretchy => "false"} (
                                %mo ˜
                              %mi T
                              %mi X
                              %mo ⊕
                              %msup
                                %mi T
                                %mo *
                              %mi X
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi T
                                %mi X
                                %mo ⊕
                                %msup
                                  %mi T
                                  %mo *
                                %mi X
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mi E
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi TypeII
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{\widetilde(T X \oplus T^* X)}{\to}&amp;&amp; \mathbf{B}(O(n) \times O(n))
                  \\\
                  \&amp; {}_{\mathllap{T X \oplus T^* X}}\searrow &amp;\swArrow_{E}&amp; \swarrow_{\mathrlap{\mathbf{TypeII}}}
                  \\\
                  \&amp;&amp; \mathbf{B} O(n,n)
                  }
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi TypeII
                  %mi Struc
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
