                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{h}{\to}&amp;&amp; \mathbf{B} PU(n)
                  \\\
                  \&amp; {}_{\mathllap{\phi}}\searrow &amp;\swArrow_{\simeq}&amp; \swarrow_{\mathrlap{\mathbf{dd}_n}}
                  \\\
                  \&amp;&amp;
                  \\mathbf{B}^2 U(1)
                  }
          %p
            is, with respect to a resolution of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
