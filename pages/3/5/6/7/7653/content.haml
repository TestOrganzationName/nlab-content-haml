                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  {\vert \mathbf{B}^n U(1) \vert}
                  \\simeq
                  B^n U(1)\simeq B^{n+1}\mathbb{Z} \simeq K(\mathbb{Z}, n+1)
          %p
            and hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
            is a smooth geometric refinement of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z}, n+1)
          %p We now apply this to the above Whitehead tower.
          %h4#SmoothWhitehead Smooth Whitehead tower
          %p We state the smooth refinement of the above Whitehead tower and then explain some aspects of how it is constructed.
          %p
            %strong Theorem
            There is a smooth geometric refinement of the
            %a{:href => "#WhiteheadTower"} above Whitehead tower
            of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} bare homotopy types
            to a tower of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth homotopy types
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-stacks"} smooth ∞-stacks
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Fivebrane
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 6
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi p
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 7
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Spin
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi p
                                %mn 1
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %msub
                            %mi ℤ
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 1
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi ℤ
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\vdots
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} Fivebrane
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} String &amp;\stackrel{\tfrac{1}{6}\mathbf{p}_2}{\to}&amp; \mathbf{B}^7 U(1)
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} Spin &amp;\stackrel{\tfrac{1}{2}\mathbf{p}_1}{\to}&amp; \mathbf{B}^3 U(1)
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} SO &amp;\stackrel{\mathbf{w}_2}{\to}&amp; \mathbf{B}^2 \mathbb{Z}_2
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} O &amp;\stackrel{\mathbf{w}_1}{\to}&amp; \mathbf{B} \mathbb{Z}_2
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{B} GL
                  }
                  \\,.
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n+1} U(1)
                is the
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                of the smooth
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
                = succeed "-stack" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundles
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi String
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} String
                is the
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+string+2-group"} smooth string 2-group
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi String
                      %annotation{:encoding => "application/x-tex"} String
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Fivebrane
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}Fivebrane
                is the delooping of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+fivebrane+6-group"} smooth fivebrane 6-group
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"} principal 6-bundles
          %p and where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \tfrac{1}{2} \mathbf{p}_1
                classifies the universal
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
                and hence identifies it with
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi String
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi Spin
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}String \to \mathbf{B}Spin
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 6
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \tfrac{1}{6} \mathbf{p}_2
                classifies the universal
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+7-bundle"} Chern-Simons circle 7-bundle
                and hence identifies it with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi Fivebrane
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi String
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}Fivebrane \to \mathbf{B}String
          %p This is constructed using essentially the following three tools for presenting presheaves of higher groupoids:
          %ol
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ξ
                      %mo :
                      %msub
                        %mi Ch
                        %mrow
                          %mo ≥
                          %mn 0
                      %mover
                        %mo →
                        %mo ≃
                      %mi sAb
                      %mo →
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"}
                      \\Xi : Ch_{\geq 0} \stackrel{\simeq}{\to} sAb \to sSet
              %p and its prolongation to presheaves
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ξ
                      %mo :
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi SmthMfd
                        %mi op
                      %mo ,
                      %msub
                        %mi Ch
                        %mrow
                          %mo ≥
                          %mn 0
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi SmthMfd
                        %mi op
                      %mo ,
                      %mi sAb
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi SmthMfd
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\Xi : [SmthMfd^{op}, Ch_{\geq 0}) \stackrel{\simeq}{\to} [SmthMfd^{op},sAb] \to [SmthMfd^{op},sSet]
              %p
                allows to use presheaves of
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
                of
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                to present presheaves of strict
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %p For instance
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Ξ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}^n U(1) \simeq \Xi( C^\infty(-,U(1))[n] )
              %p
                is equivalent to the image under the DK correspondence of the sheaf of chain complexes which is concentrated in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                on the group of
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
            %li
              %p
                Some
                %a{:href => "Dold-Kan+correspondence#StatementGeneral"} nonabelian generalizations
                of the Dold-Kan correspondence allow to use chain complexes of not entirely abelian groups –
                %em
                  %a.existingWikiWord{:href => "/nlab/show/crossed+complexes"} crossed complexes
                – to present a few more classes of
                = succeed "-groupoids." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                      %mover
                        %mo →
                        %mi δ
                      %msub
                        %mi G
                        %mn 0
                    %annotation{:encoding => "application/x-tex"}
