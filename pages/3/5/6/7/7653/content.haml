            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
