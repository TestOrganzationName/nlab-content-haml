                    }
                    \\right\}
            %p
              is equivalently a morphism of base objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi B
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_b \;\colon\; B_1 \longrightarrow B_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              together with morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ⟶
                    %msubsup
                      %mi f
                      %mi b
                      %mo *
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n \longrightarrow f_b^\ast Y_n
              into the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              of the components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Y_\bullet
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi b
                    %annotation{:encoding => "application/x-tex"} f_b
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-presheaf (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo ≔
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi seq
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}^{seq}
                    \\coloneqq
                    Func(seq, \mathbf{H})
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              with “fiberwise pre-stabilization”.
            %p
              A genuine
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
              is a
              %a.existingWikiWord{:href => "/nlab/show/prespectrum+object"} prespectrum object
              for which all the structure maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Ω
                      %mi B
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_n \stackrel{\simeq}{\longrightarrow} \Omega_B X_{n+1}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalences
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
