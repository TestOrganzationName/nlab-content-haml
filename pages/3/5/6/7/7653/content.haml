                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X, \mathbf{Fields}]
            of field configurations on a given
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mi higher
                      %mspace{:width => "thickmathspace"}
                      %mi gauge
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi el
                  %mo ∪
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi mag
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{higher\;gauge\;anomaly}
                  \\coloneqq
                  \\exp(2 \pi i \int_X \hat\mathbf{c}_{el} \cup \hat \mathbf{c}_{mag}  )
                  \:
                  [X, \mathbf{Fields}]
                  \\stackrel{}{\to}
                  \\mathbf{B} U(1)_{conn}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi el
                  %mo ∪
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi mag
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi dim
                      %mi X
                      %mo +
                      %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \hat\mathbf{c}_{el} \cup \hat \mathbf{c}_{mag} : \mathbf{Fields} \to \mathbf{B}^{dim X +2} U(1)_{conn}
            is the differential characteristic morphism induced by the
            %a.existingWikiWord{:href => "/nlab/show/differential+cup+product"} differential cup product
            (
            %a{:href => "#FSSd"}> FSSd
            ) of universal electric and magnetic currents, and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(2\pi i \int_X(-))
            is
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            refined to smooth
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi dim
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} (dim X)+1
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} infinity-Chern-Simons theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi el
                  %mo ∪
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi mag
                %annotation{:encoding => "application/x-tex"} \hat\mathbf{c}_{el} \cup \hat \mathbf{c}_{mag}
            in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            1).
          %h4#higher_gauge_fields_in_the_presence_of_magnetic_charge_current Higher gauge fields in the presence of magnetic charge current
          %p
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} Gauge theory
            starts maybe with
            %a.existingWikiWord{:href => "/nlab/show/James+Clerk+Maxwell"} Maxwell
            around 1850, who discovered, in modern language, that the
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            of the
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            on
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            is encoded in a closed
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential 2-form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in \Omega^2_{cl}(X)
          %p
            Then in the 1930s
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Paul+Dirac"} Dirac
            %a{:href => "electromagnetic+field#ChargeQuantization"} famous argument
            showed that more precisely –
            %em in the absence
            of, or
            %em outside of
            the
            %a.existingWikiWord{:href => "/nlab/show/support"} support
            of
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            %a.existingWikiWord{:href => "/nlab/show/current"} current
            – this 2-form is the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat F
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            In view of this the
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of configurations of the electromagnetic field on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            form the set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi diff
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi τ
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^2_{diff}(X) \coloneqq \tau_0 \mathbf{H}(X, \mathbf{B}U(1)_{conn})
          %p
            of differential cohomology classes in degree 2 on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Dirac’s argument works outside the support of the magnetic current, where the situation is comparatively easier to handle. But the twists and anomalies that we are concerned with here arise when one completes Dirac’s argument, and generalizes the model of the electromagnetic field to exist also over parts of spacetime where the magnetic current is non-trivial (
            %a{:href => "#Freed"}> Freed
            ). Among other things the following shows that twists by higher bundles and differential cohomology is not just something that arises in string theory, but is already present in dear-old electromagnetism.
          %p
            To see what happens in that general case, notice that the original
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
            on the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form of the electromagnetic field are:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                      %mi F
                      %mo =
                      %msub
                        %mi J
                        %mi mag
                    %annotation{:encoding => "application/x-tex"} d_{dR} F = J_{mag}
                (
                %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/current"} current
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                      %mo ⋆
                      %mi F
                      %mo =
                      %msub
                        %mi J
                        %mi el
                    %annotation{:encoding => "application/x-tex"} d_{dR} \star F = J_{el}
                (
                %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/current"} current
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            for the given
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            (the field of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %ol
            %li
              %p
                The first one is
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/kinematics"} kinematics
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi mag
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} J_{mag} = 0
                it just expresses that the cuvature 2-form is closed, which is part of the fact that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat F
                is a differential cocycle, so it is satisfied by all kinematic field configurations, meaning: all elements of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi H
                          %mi diff
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^{n+1}_{diff}(X)
            %li
              %p
                The second is
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
                of the system. The configurations that satisfy this form the
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                (
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"}> BV-BRST complex
                )
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} P \hookrightarrow [X, \mathbf{B}U(1)_{conn}]
                of the theory. For our purposes here this will not concern us, since the anomalies and twists are kinematic in nature, we work “off-shell”.
          %p
            While for experimentally observed electromagnetism it is consistent to assume that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi mag
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} J_{mag} = 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi mag
                      %mrow
                        %mi NS
                        %mn 5
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi gr
                    %mo ,
                    %msub
                      %mi ϕ
                      %mi ga
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi ω
                    %mo ∧
                    %msub
                      %mi F
                      %mi ω
                    %mo{:stretchy => "false"} ⟩
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} J^{NS5}_{mag}(\phi_{gr}, \phi_{ga}) = \langle F_\omega \wedge F_\omega\rangle -\langle F_A \wedge F_A\rangle
          %p
            But for a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n+1}_{diff}(X)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %mi F
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_{dR} F = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi F
                  %mo =
                  %msub
                    %mi J
                    %mi mag
                %annotation{:encoding => "application/x-tex"} d F  = J_{mag}
            to differential cohomology.
          %p
            (Notice for later that the natural home of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi mag
                %annotation{:encoding => "application/x-tex"} J_{mag}
            is not plain
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+cohomology"} compactly supported cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi dR
                  %mi F
                  %mo =
                  %msub
                    %mi J
                    %mi mag
                %annotation{:encoding => "application/x-tex"} d_{dR} F = J_{mag}
            is a trivialization of the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi mag
                %annotation{:encoding => "application/x-tex"} J_{mag}
            in de Rham cohomology, but not in general a trivialization of the magnetic current as an entity living in compactly supported cohomology.)
          %p
            Consider therefore now the
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi τ
                    %mn 1
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}^{n+1}_{diff}(X) \coloneqq
                  \\tau_1 \mathbf{H}(X, \mathbf{B}^n U(1)_{conn})
                  \\,,
          %p whose
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                in degree-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
                differential cohomology:
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are equivalence classes of
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
                between these, hence equivalence classes of morphisms of higher bundles
                = succeed "." do
                  %em with connection
          %p
            This “
            %a.existingWikiWord{:href => "/nlab/show/categorification"}> categorifies
            ” the cohomology set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{n+1}_{diff}(X)
            in that the letter is its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            classes of objects.
          %p
            For instance if differential cohomology is modeled by the
            %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            with
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %mo ±
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} D = d_{dR} \pm \delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi α
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msub
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat \alpha : \hat F_1 \to \hat F_2
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_{diff}^{n+1}(X)
            is a Deligne
            %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mover
                      %mi α
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo −
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D \hat \alpha = \hat F_2 - \hat F_1
          %p Or in terms of our smooth moduli stacks, this is a homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mover
                                    %mi F
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %msup
                            %mo ⇓
                            %mover
                              %mi α
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mover
                                    %mi F
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; \nearrow \searrow^{\mathrlap{\hat F_1}}
                  \\\
                  X &amp;\Downarrow^{ \hat \alpha }&amp; \mathbf{B}^n U(1)_{conn}
                  \\\
                  \&amp; \searrow \nearrow_{ \mathrlap{\hat F_2}  }
                  }
                  \\,.
          %p
            Notice that, since morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^{n+1}_{diff}(X)
            preserve the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+infinity-bundle"} higher connection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  0 \to \hat F
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^{n+1}_{diff}(X)
            is a
            %em flat section
            of the corresponding circle
            = succeed "-bundle," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  B \to \hat F
          %p
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in \Omega^n(X) \hookrightarrow \mathcal{H}^{n+1}_{diff}(X)
            is a possibly non-flat section, hence a section just of the underlying
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            (Beware of this subtlety when comparing with (
            %a{:href => "#Freed"}> Freed
            ): a differential as on the fifth line of
            %a{:href => "arxiv.org/pdf/hep-th/0011220v2.pdf#page=8"} p. 8
            there may change the curvature by an exact term, hence may not preserve the connection, in contrast to the coboundaries further below on that page and on
            = succeed "," do
              %a{:href => "arxiv.org/pdf/hep-th/0011220v2.pdf#page=9"} p. 9
          %p
            (Another reason for considering the groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^{n+1}_{diff}(X)
            is that it is needed in order to construct the
            %a.existingWikiWord{:href => "/nlab/show/quadratic+refinement"} quadratic refinement
            of the
            %a.existingWikiWord{:href => "/nlab/show/secondary+intersection+pairing"} secondary intersection pairing
            that defines the partition function of
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            (
            %a{:href => "#HopkinsSinger"}> Hopkins-Singer
            ). This underlies the discussion of flux quantization
            = succeed ".)" do
              %a{:href => "#SuGraFluxQuantization"} below
          %p
            Using this, we may improve the definition of the electromagnetic field on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %msub
                    %mi c
                    %mi mag
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c} \stackrel{\hat F}{\to} c_{mag}
                  \\,.
          %p
            of a
            %em
              magnetic charge
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msubsup
                      %mi ℋ
                      %mi diff
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat \mathbf{c} \in \mathcal{H}^{3}_{diff}(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            this is a homotopy in a diagram of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi c
                                  %mi mag
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mover
                              %mi F
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mover
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ↪
                            %mrow
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\to&amp;
                  \\\
                  {}^{\mathllap{c_{mag}}}\downarrow
                  \&amp;\swArrow_{\hat F}&amp;
                  \\downarrow^{\mathrlap{\hat \mathbf{c}}}
                  \\\
                  \\Omega^2(-) &amp;\stackrel{}{\hookrightarrow}&amp; \mathbf{B}^2 U(1)_{conn}
                  }
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat F
            is given by a Deligne cochain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_{i j}, A_i)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
            by a cochain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo ,
                  %msub
                    %mi γ
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %msub
                    %mi β
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c_{i j k}, \gamma_{i j}, \beta_i)
            then this means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi D
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo ,
                          %msub
                            %mi A
                            %mi i
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi δ
                          %mi g
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi A
                            %mi j
                          %mo −
                          %msub
                            %mi A
                            %mi i
                          %mo +
                          %msub
                            %mi d
                            %mi dR
                          %mi log
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi d
                            %mi dR
                          %msub
                            %mi A
                            %mi i
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi c
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %msub
                            %mi γ
                            %mrow
                              %mi i
                              %mi j
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi c
                            %mi mag
                          %mo −
                          %msub
                            %mi β
                            %mi i
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  D (g_{i j}, A_i)
                  \&amp; \coloneqq
                  ((\delta g)_{i j k},\; A_j - A_i + d_{dR} log g_{i j},\; d_{dR} A_i)
                  \\\
                  \&amp; =
                  ( c_{i j k}^{-1},\; -\gamma_{i j}, \;  c_{mag} - \beta_i )
                  \\end{aligned}
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat F
            is a
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
              \-
              %a.existingWikiWord{:href => "/nlab/show/twisted+infinity-bundle"} twisted bundle
            with
            %em twisted curvature
            being
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ≔
                  %mi d
                  %msub
                    %mi A
                    %mi i
                  %mo +
                  %msub
                    %mi β
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F \coloneqq d A_i + \beta_i
                  \\,.
          %p
            This now correspondingly has a twisted
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equation"} Maxwell equation
            in the presence of magnetic current:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %mi F
                    %mo =
                    %msub
                      %mi J
                      %mi mag
                  %annotation{:encoding => "application/x-tex"} d_{dR} F = J_{mag}
          %p
            While we have been discussing this here for ordinary electromagnetism, this is precisely the mechanism by which also the higher cases will work: for the
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            the analogy is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi twisted
                          %mspace{:width => "thickmathspace"}
                          %mi curvature
                        %mtd
                        %mtd
                          %msub
                            %mi d
                            %mi dR
                          %mo{:stretchy => "false"} (
                          %mi gauge
                          %mspace{:width => "thickmathspace"}
                          %mi potential
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi twist
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi d
                            %mi dR
                          %msub
                            %mi A
                            %mi i
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mtd
                          %msub
                            %mi β
                            %mi i
                        %mtd
                        %mtd
                          %mi general
                          %mi case
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %msub
                            %mi H
                            %mi i
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi d
                            %mi dR
                          %msub
                            %mi B
                            %mi i
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mtd
                          %mi CS
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ω
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi CS
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mi i
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi heterotic
                          %mspace{:width => "thickmathspace"}
                          %mi sugra
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  twisted\;curvature &amp; &amp; d_{dR}(gauge\;potential) &amp;&amp; twist
                  \\\
                  F &amp;=&amp; d_{dR} A_i &amp;+&amp; \beta_i &amp;&amp; general case
                  \\\
                  \\\
                  H_i &amp;=&amp; d_{dR} B_i &amp;+&amp; CS(\omega_i) - CS(A_i) &amp;&amp; heterotic\;sugra
                  }
                  \\,.
          %p
            Before we get there, we need to observe that working with the 1-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^{n+1}_{diff}(X)
            is not sufficient. We discuss now that we necessarily need the full
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
            and moreover its smooth refinement to the full
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth n-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X, \mathbf{B}^n U(1)_{conn}]
            in order to capture the physics situation.
          %h4#gauge_transformations Gauge transformations
          %p
            To see that we need the full higher groupoid, just consider the question: what is a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            between twisted electromagnetic fields, that are now identified with morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %msub
                    %mi c
                    %mi mag
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c} \stackrel{\hat F}{\to} c_{mag}
            as above? Clearly, for this we need the
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            of differential cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 2
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_2 \mathbf{H}(X, \mathbf{B}^n U(1)_{conn})
          %p
            to next say that the equivalenc class of a gauge transformation of twisted fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msub
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat a : \hat F_1 \to \hat F_2
            is a
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mover
                                    %mi F
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                      %mtr
                        %mtd
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mi c
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %msup
                            %mo ⇓
                            %mover
                              %mi α
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %msub
                            %mi J
                            %mi mag
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mover
                                    %mi F
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msub
                    %mi τ
                    %mn 2
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; \nearrow \searrow^{\mathrlap{\hat F_1}}
                  \\\
                  \\hat \mathbf{c} &amp;\Downarrow^{\hat \alpha}&amp; J_{mag}
                  \\\
                  \&amp; \searrow \nearrow_{\mathrlap{\hat F_2}}
                  }
                  \\;\;\;
                  \\in \tau_{2} \mathbf{H}(X, \mathbf{B}^n U(1)_{conn})
                  \\,.
          %p
            That we moreover need the full
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth n-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X, \mathbf{B}^n U(1)_{conn}]
            has several reasons, we discuss three. The third one of these is related to the higher gauge anomalies proper.
          %h4#magnetic_current_induced_by_background_fields Magnetic current induced by background fields
          %p
            The magnetic twist
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
            will depend on other field configurations that induce magnetic charge. So it is not a constant, but
            = succeed "." do
              %em varies with the fields
          %p
            (In fact, only this way is it a non-trivial stricture, for if both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat c
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi mag
                %annotation{:encoding => "application/x-tex"} c_{mag}
            are independent of the fields, the above definition of the groupoid of
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat F
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
            to that of untwisted electromagnetic fields: because
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            only depend on the connected component of the base points, up to equivalence.)
          %p
            Let therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi bg
                %annotation{:encoding => "application/x-tex"} G^{bg}
            be the gauge group of another
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi G
                    %mi conn
                    %mi bg
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G^{bg}_{conn}
            be its moduli stack of gauge field configurations. If a
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi bg
                  %annotation{:encoding => "application/x-tex"} G^{bg}
            %em induces
            magnetic current, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
            must depend on the fields, hence it should be a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi G
                    %mi conn
                    %mi bg
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [X, \mathbf{B}G^{bg}_{conn}] \to [X, \mathbf{B}^2 U(1)_{conn}]
          %p
            between these spaces of fields, and it should be a
            %em smooth
            such map. Moreover, in general this is not expected to depend specifically the specific choice of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-fields" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi bg
                  %annotation{:encoding => "application/x-tex"} G^{bg}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi G
                    %mi conn
                    %mi bg
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c} : \mathbf{B}G^{bg}_{conn} \to \mathbf{B}^2 U(1)_{conn}
          %p
            with a universal smooth map on moduli. With that given, the above picture for the
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi bg
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msubsup
                            %mi G
                            %mi conn
                            %mi bg
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mover
                              %mi F
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mover
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{\phi_{bg}}{\to}&amp; \mathbf{B}G^{bg}_{conn}
                  \\\
                  \\downarrow &amp;\swArrow_{\hat F}&amp; \downarrow^{\mathrlap{\hat \mathbf{c}}}
                  \\\
                  \\Omega^2(-) &amp;\stackrel{}{\to}&amp; \mathbf{B}^n U(1)_{conn}
                  }
                  \\,.
          %p
            We can then subsume all this and consider the smooth collection of all such twisting background fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mi bg
                %annotation{:encoding => "application/x-tex"} \phi^{bg}
            and twisted gauge fields
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat F
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            that universally completes the above diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi bg
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msubsup
                            %mi G
                            %mi conn
                            %mi bg
                          %msup
                            %mrow
                            %mi univ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %msup
                                %mover
                                  %mi F
                                  %mo{:stretchy => "false"} ^
                                %mi univ
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mover
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{Fields} &amp;\stackrel{\phi_{bg}}{\to}&amp; \mathbf{B}G^{bg}_{conn}{}^{univ}
                  \\\
                  \\downarrow &amp;\swArrow_{\hat F^{univ}}&amp; \downarrow^{\mathrlap{\hat \mathbf{c}}}
                  \\\
                  \\Omega^2(-) &amp;\stackrel{}{\to}&amp; \mathbf{B}^n U(1)_{conn}
                  }
          %h4#infinitesimal_moduli_stacks_brst_complexes Infinitesimal moduli stacks: BRST complexes
          %p
            So far we are talking about
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            and
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            on which we are evaluating an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (see below). Eventually one wants to
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantize
            such a setup. There are two issues with this: first of all the action functional needs to be well-defined in the first place, we get to in the next point. But second, once we have a well-defined action functional on gauge fields, the only way to quantize this is to invove
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
            %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            of the gauge fields.
          %p
            or ordinary gauge theory this is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            of the smooth version
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X, \mathbf{B}G_{conn}]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BRST
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  BRST  = C^\infty Lie([X, \mathbf{B}G_{conn}])
                  \\,.
          %p
            Similarly for higher gauge theory it is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroid"} L-infinity algebroid
          %h4#extended_higher_chernsimonstype_functionals Extended higher Chern-Simons-type functionals
          %p
            The anomaly line bundle to be discussed in a moment
            %a{:href => "GaugeInteractionAndChargeAnomaly"} below
            is a special case of a general construction in extended “
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"}> ∞-Chern-Simons theory
            ”. So before getting to that special case, we indicate here the general pattern.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of ordinary
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            is traditionally taken to be simply a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \Sigma_3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi cs
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %msub
                    %mi Bund
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mn 3
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp( i S_{cs}) : G Bund_\nabla(\Sigma_3)
                  \\to U(1)
          %p
            on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \Sigma_3
          %p
            First of all, since this function is
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
            we may think of it as being defined on the full moduli stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi cs
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mn 3
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp( i S_{cs}) : [\Sigma_3, \mathbf{B}G_{conn}] \to U(1)
                  \\,.
          %p This also exhibits the smoothness of the action.
          %p
            An important construction in
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            of this action functional in the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 3
                  %mo =
                  %msub
                    %mi Σ
                    %mn 2
                  %mo ×
                  %mi Interval
                %annotation{:encoding => "application/x-tex"} \Sigma_3 = \Sigma_2 \times Interval
            , which yields a holomorphic line bundle with connection on the
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            of the theory, which may be identified with the space of flat connections over a
            %em 2-dimensional
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Sigma_2
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle k-bundle with connection
            assigned to a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            %a{:href => "#DifferentialWhitehead"} Above
            we had already seen such a structure in top codimension: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} \Sigma = *
            is the point, then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} [\Sigma, \mathbf{B}G_{conn}] \simeq [*, \mathbf{B}G_{conn}] \simeq \mathbf{B}G_{conn}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} G = Spin
            %a{:href => "#DifferentialWhitehead"} above
            is precisely of this form:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Spinn
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tfrac{1}{2} \hat \mathbf{p}_1
                  \:
                  \\mathbf{B} Spinn_{conn}
                  \\to
                  \\mathbf{B}^3 U(1)
                  \\,.
          %p And indeed, as stated there, this induces the Chern-Simons action functional itself. Indeed, it induces a whole tower of higher circle bundles, in each codimension:
          %p
            The operation of fiber integration of differential forms extends to an operation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi Σ
                        %mi k
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mi k
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(2 \pi i \int_{\Sigma_k}(-))
                  \:
                  [\Sigma_k, \mathbf{B}^n U(1)_{conn}]
                  \\to
                  \\mathbf{B}^{n-k} U(1)_{conn}
                  \\,.
          %p If now
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c}
                  \:
                  \\mathbf{B}G_{conn}
                  \\to
                  \\mathbf{B}^n U(1)_{conn}
          %p
            is any universal differential characteristic map, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \Sigma_k
            is compact closed of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi Σ
                        %mi k
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mi k
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Σ
                        %mi k
                      %mo ,
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Σ
                    %mi k
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %mi i
                      %msub
                        %mo ∫
                        %mrow
                          %msub
                            %mi Σ
                            %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\exp(2 \pi i \int_{\Sigma_k} \hat \mathbf{c})
                  \:
                  [\Sigma_k, \mathbf{B}G_{conn}]
                  \\stackrel{[\Sigma_k, \hat \mathbf{c}]}{\to}
                  [\Sigma_k, \mathbf{B}^n U(1)_{conn}]
                  \\stackrel{\exp(2 \pi i \int_{\Sigma_k} (-))}{\to}
                  \\mathbf{B}^{n-k} U(1)_{conn}
          %p
            is a “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            \-extended action functional”.
          %p
            An important class of
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
            arising this way come from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
            that are
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup products
            of two other differential classes (
            %a{:href => "#FSSd"}> FSSd
            ). For instance in ordinary abelian
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            one starts with the tautological differential class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi DD
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{DD}
                  \:
                  \\mathbf{B}^{2k+1} U(1)_{conn}
                  \\to
                  \\mathbf{B}^{2k+1} U(1)_{conn}
          %p
            and then forms its
            %a.existingWikiWord{:href => "/nlab/show/differential+cup+product"} differential cup product
            (
            %a{:href => "#FSSd"}> FSSd
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo ≔
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ×
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi DD
                        %mo{:stretchy => "false"} ^
                      %mo ∪
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi DD
                        %mo{:stretchy => "false"} ^
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mn 4
                      %mi k
                      %mo +
                      %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c}
                  \\coloneqq
                  \\mathbf{B}^{2k+1} U(1)_{conn}
                  \\stackrel{}{\to}
                  \\mathbf{B}^{2k+1} U(1)_{conn} \times
                  \\mathbf{B}^{2k+1} U(1)_{conn}
                  \\stackrel{\hat \mathbf{DD} \cup \hat \mathbf{DD}}{\to}
                  \\mathbf{B}^{4k + 3} U(1)_{conn}
                  \\,.
          %p
            The action functional induced by this is that of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mi k
                    %mo +
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (4k+3)
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            which sends those
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            whose underlying bundle happens to be trivial to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Σ
                          %mrow
                            %mn 4
                            %mi k
                            %mo +
                            %mn 3
                    %mi C
                    %mo ∧
                    %msub
                      %mi d
                      %mi dR
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(2 \pi i\int_{\Sigma_{4k+3}} C \wedge d_{dR} C)
          %p
            The anomaly line bundle which we now turn to arises in this kind of way, only for the slightly more general case that the
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            involved is not given by a differential square, but by a genuine differential cup of two different cocycles: the electric and the magnetic differential cocycles.
          %h4#GaugeInteractionAndChargeAnomaly Gauge interaction and the charge anomaly
          %p
            We discuss now how the action functional of the (higher) gauge theory in the presence of
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            %a.existingWikiWord{:href => "/nlab/show/current"} current
            and
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            %a.existingWikiWord{:href => "/nlab/show/current"} current
            has in general an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} anomaly
            %em families
            of gauge fields. But by the formula for the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of sheaves/stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi U
                  %mo ↦
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi U
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi G
                    %mi conn
                    %mi bg
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi background
                  %mspace{:width => "thickmathspace"}
                  %mi gauge
                  %mspace{:width => "thickmathspace"}
                  %mi fields
                  %mspace{:width => "thickmathspace"}
                  %mi on
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo −
                  %mi parameterized
                  %mspace{:width => "thickmathspace"}
                  %mi famlily
                  %mspace{:width => "thickmathspace"}
                  %mi of
                  %mspace{:width => "thickmathspace"}
                  %mi gauge
                  %mspace{:width => "thickmathspace"}
                  %mi fields
                  %mspace{:width => "thickmathspace"}
                  %mi on
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  [X, \mathbf{Fields}] : U \mapsto
                  \\mathbf{H}(X \times U, \mathbf{B}G^{bg}_{conn})
                  \=
                  \\{
                  background\;gauge\;fields\; on\; X \times U
                  \\}
                  \=
                  \\{
                  U-parameterized\;famlily\;of\;gauge\;fields\; on\; X
                  \\}
          %p
            this means effectively to work over the
            %em smooth moduli stack of fields
            itself. Notably, the anomaly is going to be (the non-triviality of) a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle bundle with connection
            on “the space of all fields”, so we certainly need a smooth structure on that space. We indicate now how that line bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi anomaly
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{anomaly} : [X, \mathbf{Fields}]  \to \mathbf{B}U(1)_{conn}
          %p appears.
          %p
            First, the kinetic piece of the action functional is simply
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mi S
                      %mi kin
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %mi F
                    %mo ∧
                    %mo *
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(i S_{kin}(\hat F)) = \exp(i \int_X F \wedge \ast F)
          %p
            But suppose there is a charged particle with trajectory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma : S^1 \to X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(2\pi i \int_{S^1} \gamma^* A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi el
                %annotation{:encoding => "application/x-tex"} J_{el}
            be the
            %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare dual
            form. Then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %mi A
                    %mo ∧
                    %msub
                      %mi J
                      %mi el
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cdots = \exp(i \int_X A \wedge J_{el})
          %p
            This may be expressed using the
            %a.existingWikiWord{:href => "/nlab/show/Beilinson-Deligne+cup+product"} Beilinson-Deligne cup product
            and the
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %msub
                      %mo ∫
                      %mi X
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mi el
                    %mo ∪
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(2 \pi i \int_X \hat \mathbf{c}_{el} \cup \hat F)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi el
                %annotation{:encoding => "application/x-tex"} J_{el}
            to have
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of field configurations: by the formula for the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            and for forms on a stack, we are evaluating for each test manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            on families of fields over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi U
                %annotation{:encoding => "application/x-tex"} X \times U
            and then integrate out over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            But in the case where there is non-trivial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi mag
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}_{mag}
            this is no longer the case, there instead this is a trivialization of a twist
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mover
                    %mo →
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %mi i
                      %msub
                        %mo ∫
                        %mi X
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                        %mi el
                      %mo ∪
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi el
                  %mo ∪
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mi mag
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega \stackrel{\exp(2 \pi i \int_X \hat \mathbf{c}_{el} \cup \hat F)}{\to}
                  \\exp(2 \pi i \int_X \hat \mathbf{c}_{el} \cup \hat \mathbf{c}_{mag})
                  \\,.
          %p
            Moreover, this twist matters in
            %a.existingWikiWord{:href => "/nlab/show/compactly+supported+cohomology"} compactly supported cohomology
            (this is what
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            sees), where it is in general not trivialized. So the action functional is not a function, but a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of a line bundle. Its
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            is the 2-class of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mi higher
                      %mspace{:width => "thickmathspace"}
                      %mi gauge
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %mi i
                      %msub
                        %mo ∫
                        %mi X
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                        %mi el
                      %mo ∪
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                        %mi mag
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{higher\;gauge\;anomaly}
                  \:
                  [X, \mathbf{Fields}]
                  \\stackrel{
                  \\exp(2 \pi i \int_X \hat \mathbf{c}_{el} \cup \hat \mathbf{c}_{mag})
                  }
                  {
                  \\to
                  }
                  \\mathbf{B} U(1)_{conn}
          %p
            This is the
            = succeed "." do
              %em anomaly line bundle with connection on the moduli stack of fields
          %p
            For this to cancel, there needs to be a fermionic anomaly – the
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
            of the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operators"} Dirac operators
            on the fermions in the theory – of the same structure.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mi fermion
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{fermion\;anomaly}
                  \:
                  [X, \mathbf{Fields}]
                  \\to
                  \\mathbf{B} U(1)_{conn}
                  \\,.
          %p
            The total action functional (higher gauge fields and fermions) is a section of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of these two
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mi total
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo =
                  %msub
                    %mo ∇
                    %mrow
                      %mi higher
                      %mspace{:width => "thickmathspace"}
                      %mi gauge
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo ⊗
                  %msub
                    %mo ∇
                    %mrow
                      %mi fermion
                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{total\;anomaly}
                  \=
                  \\nabla_{higher\;gauge\;anomaly} \otimes \nabla_{fermion\;anomaly}  :
                  [X, \mathbf{Fields}]
                  \\to
                  \\mathbf{B} U(1)_{conn}
                  \\,.
          %p
            The action functional needs to be a flat
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %mi total
                        %mspace{:width => "thickmathspace"}
                        %mi anomaly
                  %annotation{:encoding => "application/x-tex"} \nabla_{total\;anomaly}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
          %h3#TwistedK
            %strong III)
            = succeed "-," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
            = succeed "-," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi String
                      %mi c
                  %annotation{:encoding => "application/x-tex"} String^c
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fivebrane
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Fivebrane^c
          %p
            In the
            %a{:href => "#SpinStringFivebraneStructures"} previous section
            we have considered higher differential structures originating in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            these structures receive twists originating in the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            (or representations through the unitary group of groups like
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
          %p
            Accordingly, the
            %a{:href => "#WhiteheadTower"} above Whitehead tower
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                %annotation{:encoding => "application/x-tex"} \mathbf{B}O
            has stage-wise
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary
                twistings
            = succeed "-group," do
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec"} spin^c
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/String%5Ec+2-group"} String^c 2-group
          %p
            After discussing some generalities of these higher unitary-twisted connected covers of the orthogonal group
            %a{:href => "#HigherUnitaryTwistedCovers"} below
            we then turn to discussing a list of twisted structures and their appearance in string theory:
          %table
            %thead
              %tr
                %th unitary-twisted higher orthogonal structure
                %th role in string theory
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"} twisted differential spin^c structure
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Freed-Witten+anomaly+cancellation"} Freed-Witten anomaly cancellation
                  for
                  %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II strings
                  on
                  %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} twisted differential String^c-structure
                %td{:style => "text-align: left;"}
                  flux quantization in
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11d sugra
                  %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
                  with
                  %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/twisted+differential+string+structure"} twisted differential string structure
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
                  in
                  %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/twisted+differential+fivebrane+structure"} twisted differential fivebrane structure
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
                  in
                  %a.existingWikiWord{:href => "/nlab/show/dual+heterotic+string+theory"} dual heterotic string theory
          %h4#HigherUnitaryTwistedCovers
            Higher unitary-twisted covers of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/spin%5Ec"} spin^c
            is traditionally defined by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Spin
                    %mi c
                  %mo ≔
                  %mi Spin
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Spin
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Spin^c \coloneqq Spin \times_{\mathbb{Z}_2} U(1) = (Spin \times U(1))/{\mathbb{Z}_2}
                  \\,,
          %p
            which denotes the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin \times U(1)
            by the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            induced by the common canonical
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} of order 2
          %p
            For our purposes it is useful to think of this as follows. We have the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} higher fiber bundle
            classified by the smooth
            %a.existingWikiWord{:href => "/nlab/show/second+Stiefel-Whitney+class"} second Stiefel-Whitney class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi ℤ
                            %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Spin
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B} \mathbb{Z}_2 &amp;\to&amp; \mathbf{B} Spin
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B} SO &amp;\stackrel{\mathbf{w}_2}{\to}&amp; \mathbf{B}^2 \mathbb{Z}
                  }
          %p
            and we also have the
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} higher fiber bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo ⋅
                              %mn 2
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mn 1
                                %mi mod
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi ℤ
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B} U(1) &amp;\stackrel{\cdot 2}{\to}&amp; \mathbf{B} U(1)
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{c}_1 mod 2}}
                  \\\
                  \&amp;&amp; \mathbf{B}\mathbb{Z}_2
                  }
          %p
            which is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated
            to the
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            universal
            = succeed "-bundle." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
          %p
            One finds, using the presentation of these maps as discussed
            = succeed "," do
              %a{:href => "#SmoothWhitehead"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
            is the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated bundle
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi Spin
                            %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mn 1
                                %mi mod
                                %mn 2
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %msub
                            %mi ℤ
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}Spin^c &amp;\to&amp; \mathbf{B}U(1)
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{c}_1 mod 2}}
                  \\\
                  \\mathbf{B} SO &amp;\stackrel{\mathbf{w}_2}{\to}&amp; \mathbf{B}^2 \mathbb{Z}_2
                  }
                  \\,.
          %p
            Equivalently we may write this as a
            %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
            and thus obtain the universal local
            = succeed "-coefficient" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 \mathbb{Z}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi Spin
                            %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi SO
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi w
                                  %mn 2
                                %mo −
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mn 1
                                %mi mod
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %msub
                            %mi ℤ
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}Spin^c &amp;\to&amp; \mathbf{B} (SO \times U(1))
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{w}_2 - \mathbf{c}_1 mod 2}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 \mathbb{Z}_2
                  }
          %p We may read this as saying:
          %p
            %em
              Where the moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin
            is the homotopy fiber of the smooth second Stiefel-Whitney class
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{w}_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
            is that homotopy fiber universally twisted by the smooth
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            = succeed "._" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mn 1
                    %mi mod
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}_1 mod 2
          %p In the following we consider higher analogs of this, where homotopy fibers of “orthogonal classes” are twisted by “unitary classes”.
          %p
            In particular, one step higher in the
            = succeed "," do
              %a{:href => "#WhiteheadTower"} Whitehead tower of BO
            %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontryagin+class"} first fractional Pontryagin class
            with the smooth
            %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
            to obtain the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the smooth
            %a.existingWikiWord{:href => "/nlab/show/String%5Ec+2-group"} String^c 2-group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi String
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi Spin
                          %mo ×
                          %mi SU
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 2
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mn 1
                                %mo −
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mn 2
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B} String^{\mathbf{c}_2} &amp;\to&amp; \mathbf{B}(Spin \times SU)
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\tfrac{1}{2}\mathbf{p}_1 - \mathbf{c}_2 }}
                  \\\
                  \&amp;&amp; \mathbf{B}^3 U(1)
                  }
                  \\,.
          %p
            This controls the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            as well as the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
          %p
            Before we come to that we consider another variant, since that leads to the most familiar twisting, that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
          %p
            One finds that there is also a universal local
            = succeed "-coefficient" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Spin
                            %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi W
                                  %mn 3
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Spin^c &amp;\to&amp; \mathbf{B} SO
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{W}_3}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 U(1)
                  }
                  \\,.
          %p
            Since that now lands in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
            %em one more
            unitary twist by a corresponding class. The canonical such class is the universal
            %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi dd
                %annotation{:encoding => "application/x-tex"} \mathbf{dd}
            of (stable)
            %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary
            bundles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Spin
                            %mi c
                          %msup
                            %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mi dd
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi SO
                          %mo ×
                          %mi PU
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi W
                                  %mn 3
                                %mo −
                                %mstyle{:mathvariant => "bold"}
                                  %mi dd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}(Spin^c)^{\mathbf{dd}} &amp;\to&amp; \mathbf{B} ( SO \times PU )
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\mathbf{W}_3 - \mathbf{dd}}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 U(1)
                  }
                  \\,.
          %p
            This universal local coefficient bundle controls the
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten+anomaly+cancellation"} Freed-Witten anomaly cancellation
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
          %h4#BFieldInK
            %strong a)
            Twisted differential
            = succeed "-structure:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
          %p
            We discuss aspects of the twisted smooth cohomology involved over
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten+anomaly+cancellation"} Freed-Witten anomaly cancellation
            mechanism in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
          %p
            For each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            of Lie groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U(1) \to U(n) \to PU(n)
          %p
            that exhibits the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            as a
            = succeed "-extension" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
            induces the corresponding morphism of smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} U(1) \to \mathbf{B} U(n) \to \mathbf{B} PU(n)
                  \\,.
          %p
            This is part of a
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} long fiber sequence
            which continues to the right by a
            %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi dd
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{dd}_n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi dd
                        %mi n
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} U(1) \to \mathbf{B} U(n) \to \mathbf{B} PU(n)
                  \\stackrel{\mathbf{dd}_n}{\to}
                  \\mathbf{B}^2 U(1)
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ≃
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi PU
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  [U(1) \to U(n)] &amp;\to&amp; [U(1) \to 1]
                  \\\
                  {}^{\mathllap{\simeq}}\downarrow
                  \\\
                  PU(n)
                  }
                  \\,.
          %p
            We have seen
            %a{:href => "#SmoothWhitehead"} above
            that a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbf{B}^2 U(1)
            classifies a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle
            encoded by a Cech 2-cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ϕ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo :
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ∩
                  %msub
                    %mi U
                    %mi k
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\phi_{i j k} : U_i \cap U_j \cap U_k \to U(1))
            \. This means that the universal local coefficient bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
