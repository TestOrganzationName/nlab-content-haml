                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi g
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi B
                            %mtd
                              %msup
                                %mi g
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
