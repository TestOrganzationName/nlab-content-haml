                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to \mathbf{B}(U(1) \to U(n))
            whose components read
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
