                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi traj
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi S
                                %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
