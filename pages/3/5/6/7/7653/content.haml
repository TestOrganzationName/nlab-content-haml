                        %mn 1
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Spin
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}\mathbf{p}_1 : \mathbf{B}Spin \to \mathbf{B}^3 U(1)
                is constructed (
                %a{:href => "#FSSa"}> FSSa
                ) as the
                %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
                of the canonical
                %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebra+cohomology"} L-∞ 3-cocylce
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
