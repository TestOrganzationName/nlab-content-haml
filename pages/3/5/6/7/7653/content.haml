                        %mi B
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 1
                      %mover
                        %mo →
                        %mi δ
                      %msub
                        %mi G
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}(G_1 \stackrel{\delta}{\to} G_0)
                has
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-cells
                that look like
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 1
                      %mo →
                      %msub
                        %mi G
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo *
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi g
                                        %mn 1
                                %mo ↗
                              %mtd
                                %msup
                                  %mo ⇓
                                  %mpadded{:width => "0"}
                                    %mi h
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi g
                                        %mn 2
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                              %mtd
                                %munder
                                  %mo →
