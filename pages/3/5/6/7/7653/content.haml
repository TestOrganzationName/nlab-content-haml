                                    %mi δ
                                    %mo{:stretchy => "false"} (
                                    %mi h
                                    %mo{:stretchy => "false"} )
                                    %msub
                                      %mi g
                                      %mn 2
                                    %msub
                                      %mi g
                                      %mn 1
                              %mtd
                              %mtd
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi g
