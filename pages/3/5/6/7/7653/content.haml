                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul#SSSa
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              %em
                %a.existingWikiWord{:href => "/schreiber/show/L-%E2%88%9E+algebra+connections"} L-∞ algebra connections
          %ul#SSSb
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed ",_" do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "_" do
                %a.existingWikiWord{:href => "/schreiber/show/Fivebrane+structures"} Fivebrane structures
          %ul#SatiSchreiberStasheff09
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Twisted+Differential+String+and+Fivebrane+Structures"} Twisted Differential String and Fivebrane Structures
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0910.4001"} arXiv:0910.4001
          %ul#FSSa
            %li
