                    %annotation{:encoding => "application/x-tex"} \tau_{\leq n} \exp(\mathfrak{g})
                of an
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
