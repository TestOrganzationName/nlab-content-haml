                      %mspace{:width => "thickmathspace"}
                      %mi anomaly
                %annotation{:encoding => "application/x-tex"} \nabla_{higher\;gauge\;anomaly}
            on the
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
