                                %mrow
                                  %msub
                                    %mi h
                                    %mrow
                                      %mi j
                                      %mi k
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi h
                                  %mrow
                                    %mi i
                                    %mi k
                          %mtd
                          %mtd
                            %mo *
                    %mo )
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  \&amp;&amp; (x,j)
                  \\\
                  \&amp; \nearrow &amp;\Downarrow&amp; \searrow
                  \\\
                  (x,i) &amp;&amp;\to&amp;&amp; (x,k)
                  }
                  \\right)
                  \\;\;\;
                  \\mapsto
                  \\;\;\;
                  \\left(
                  \\array{
                  \&amp;&amp; *
                  \\\
                  \&amp; {}^{\mathllap{h_{i j}(x)}}\nearrow
                  \&amp;\Downarrow^{\phi_{i j k}(x)}&amp;
                  \\searrow^{\mathrlap{h_{j k}}}
                  \\\
                  * &amp;&amp;\underset{h_{i k}}{\to}&amp;&amp; *
                  }
                  \\right)
                  \\in
