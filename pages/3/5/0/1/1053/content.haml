              = succeed "," do
                %em Differential Categories
              = succeed ")" do
                %a{:href => "https://pdfs.semanticscholar.org/82b0/f9533b451d174f407b35e1c39e2376138ac2.pdf"} pdf
          %p The antithesis interpretation is
