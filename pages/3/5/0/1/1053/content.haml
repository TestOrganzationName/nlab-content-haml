            %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
            in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
          %ul
            %li
              Stéphane Gimenez,
              %em Towards Generic Inductive Constructions inSystems of Nets
              \&amp;lbrack;
              %a{:href => "http://www.imn.htwk-leipzig.de/WST2013/papers/paper_16.pdf"}> pdf
              \&amp;rbrack;
          %p
            The
            = succeed "of" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
          %ul
            %li#Blute-Cockett-Seely06
              %a.existingWikiWord{:href => "/nlab/show/Richard+Blute"}> Richard Blute
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"} Robin Cockett
              = succeed "," do
