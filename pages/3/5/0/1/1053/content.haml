                = succeed "," do
                  %a{:href => "https://doi.org/10.1145/3531130.3532488"} doi:10.1145/3531130.3532488
                = succeed "&rbrack;" do
                  %a{:href => "https://www.irif.fr/~mellies//papers/functorial-excursion.pdf"} pdf
          %p
            The relation of dual intuitionistic linear logic and
            = succeed "-calculus" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
          %ul
            %li
              Luis Caires,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Frank+Pfenning"} Frank Pfenning
              = succeed "." do
                %em Session Types as Intuitionistic Linear Propositions
          %p Noncommutative linear logic is discussed for instance in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+Blute"}> Richard Blute
              , F. Lamarche, Paul Ruet,
              = succeed "," do
                %em Entropic Hopf algebras and models of non-commutative logic
              = succeed ")" do
                %a{:href => "http://www.emis.ams.org/journals/TAC/volumes/10/17/10-17.pdf"} pdf
          %p
