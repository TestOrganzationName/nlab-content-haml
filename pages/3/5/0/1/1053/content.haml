                  %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/summary?doi=10.1.1.83.6250"} citeseer
            %li{:id => "Melliès02"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul-Andr%C3%A9+Melli%C3%A8s"}> Paul-André Melliès
                ,
                %em Categorical models of linear logic revisited
                (2002) &amp;lbrack;
                %a{:href => "https://hal.science/hal-00154229"}> hal:00154229
                \&amp;rbrack;
            %li{:id => "Melliès09"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul-Andr%C3%A9+Melli%C3%A8s"}> Paul-André Melliès
                ,
                = succeed "," do
                  %em Categorical semantics of linear logic
                = succeed "," do
                  %em
                    %a{:href => "https://smf.emath.fr/publications/modeles-interactifs-de-calcul-et-de-comportement-de-programme"} Interactive models of computation and program behaviour
                %strong 27
                (2009) 1-196 &amp;lbrack;
                %a{:href => "https://smf.emath.fr/publications/semantique-categorielle-de-la-logique-lineaire"}> web
                ,
                = succeed "," do
                  %a{:href => "https://www.irif.fr/~mellies/papers/panorama.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Mellies-CategoricalSemanticsLinear.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul-Andr%C3%A9+Melli%C3%A8s"}> Paul-André Melliès
