                            %mo ,
                            %mi Δ
                            %mo ⊢
                            %mi Θ
                          %annotation{:encoding => "application/x-tex"} \Gamma, ?{A}, \Delta \vdash \Theta
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Δ
                        %annotation{:encoding => "application/x-tex"} \Delta
                    consist entirely of propositions of the form
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo !
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %annotation{:encoding => "application/x-tex"} !{-}
                    while
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Θ
                        %annotation{:encoding => "application/x-tex"} \Theta
                    consists entirely of propositions of the form
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ?
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %annotation{:encoding => "application/x-tex"} ?{-}
          %p
            The main point of linear logic is the restricted use of the weakening and contraction rules; if these were universally valid (applying to any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            rather than only to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} !{A}
            or
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
                    %mi A
                  %annotation{:encoding => "application/x-tex"} ?{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} !{A}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ?
                  %mi A
                %annotation{:encoding => "application/x-tex"} ?{A}
            would be equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            = succeed ";" do
              %span.newWikiWord
                noncommutative logic
                %a{:href => "/nlab/new/noncommutative+logic"} ?
          %p
            As usual, there is a theorem of
            %a.existingWikiWord{:href => "/nlab/show/cut+elimination"} cut elimination
            showing that the cut rule and identity rule follow from all other rules and the special cases of the identity rule of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⊢
                  %mi p
                %annotation{:encoding => "application/x-tex"} p \vdash p
            for a propositional variable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            The propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are (propositionally)
            %strong equivalent
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊢
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \vdash B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ⊢
                  %mi A
                %annotation{:encoding => "application/x-tex"} B \vdash A
            are both valid, which we express by writing
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≡
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \equiv B
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi &amp;
                  %annotation{:encoding => "application/x-tex"} \&amp;
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                  %annotation{:encoding => "application/x-tex"} \oplus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            are all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative"} associative
            %a.existingWikiWord{:href => "/nlab/show/identity+elements"} identity elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbf{0}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            %a.existingWikiWord{:href => "/nlab/show/commutative+operation"} commutative
            (although this fails for the multiplicative connectives if we drop the exchange rule). The additive connectives are also
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            (but the multiplicative ones are not).
          .num_remark
            %h6#remark Remark
            %p
              There is a more refined notion of equivalence, where we pay attention to specific derivations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi: A \vdash B
              of sequents, and deem two derivations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ,
                    %mi π
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \pi, \pi'
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊢
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \vdash B
              %em Lambek-equivalent
              if they map to the same morphism under any categorical semantics
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi: A \vdash B
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi B
                      %mo ⊢
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \rho: B \vdash A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi π
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S(\rho) = S(\pi)^{-1}
              under any semantics), so that the derivations exhibit an isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(A) \cong S(B)
              under any semantics
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ≡
                      %mi Lambek
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \equiv_{Lambek} B
              is strictly stronger than propositional equivalence. It should be observed that all equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≡
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \equiv B
              listed below are in fact Lambek equivalences.
          %p
            We also have
            %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive laws
            that explain the adjectives ‘additive’, ‘multiplicative’, and ‘exponential’:
          %ul
            %li
              Multiplication distributes over addition if one is a conjunction and one is a disjunction:
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ⊕
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊗
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ⊕
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊗
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \otimes (B \oplus C) \equiv (A \otimes B) \oplus (A \otimes C)
                  (and on the other side);
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⅋
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi &amp;
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⅋
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mi &amp;
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⅋
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \parr (B \&amp; C) \equiv (A \parr B) \&amp; (A \parr C)
                  (and on the other side);
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %mstyle{:mathvariant => "bold"}
                          %mn 0
                        %mo ≡
                        %mstyle{:mathvariant => "bold"}
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} A \otimes \mathbf{0} \equiv \mathbf{0}
                  (and on the other side);
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⅋
                        %mo ⊤
                        %mo ≡
                        %mo ⊤
                      %annotation{:encoding => "application/x-tex"} A \parr \top \equiv \top
                  (and on the other side).
            %li
              Exponentiation converts addition into multiplication if all are conjunctions or all are disjunctions:
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo !
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mi &amp;
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo !
                        %mi A
                        %mo ⊗
                        %mo !
                        %mi B
                      %annotation{:encoding => "application/x-tex"} !{(A \&amp; B)} \equiv !{A} \otimes !{B}
                  ;
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ?
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ⊕
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo ?
                        %mi A
                        %mo ⅋
                        %mo ?
                        %mi B
                      %annotation{:encoding => "application/x-tex"} ?{(A \oplus B)} \equiv ?{A} \parr ?{B}
                  ;
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo !
                        %mo ⊤
                        %mo ≡
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} !{\top} \equiv \mathbf{1}
                  ;
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ?
                        %mstyle{:mathvariant => "bold"}
                          %mn 0
                        %mo ≡
                        %mo ⊥
                      %annotation{:encoding => "application/x-tex"} ?{\mathbf{0}} \equiv \bot
                  \.
          %p It is also a theorem that negation (except for the negations of propositional variables) can be defined (up to equivalence) recursively as follows:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ⊥
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ≡
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (A^\perp)^\perp \equiv A
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi &amp;
                    %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ≡
                    %msup
                      %mi A
                      %mo ⊥
                    %mo ⊕
                    %msup
                      %mi B
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} (A \&amp; B)^\perp \equiv A^\perp \oplus B^\perp
              and vice versa;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ≡
                    %msup
                      %mi A
                      %mo ⊥
                    %mo ⅋
                    %msup
                      %mi B
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} (A \otimes B)^\perp \equiv A^\perp \parr B^\perp
              and vice versa;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ⊤
                      %mo ⊥
                    %mo ≡
                    %mstyle{:mathvariant => "bold"}
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \top^\perp \equiv \mathbf{0}
              and vice versa;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ⊥
                    %mo ≡
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}^\perp \equiv \bot
              and vice versa;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo !
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ≡
                    %mo ?
                    %mrow
                      %msup
                        %mi A
                        %mo ⊥
                  %annotation{:encoding => "application/x-tex"} (!{A})^\perp \equiv ?{A^\perp}
              and vice versa.
          %p
            The logical rules for
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            can then be proved.
          %p
            In this way, linear logic in the original sense (interpreted in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous+categories"} star-autonomous categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            = succeed ")." do
              %a{:href => "#HylandPaiva93"} Hyland–de Paiva 93
          %p
            We can also restrict attention to sequents with one term on either side as follows:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊢
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Gamma \vdash \Delta
            is valid if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⨂
                  %mi Γ
                  %mo ⊢
                  %mo ⅋
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \bigotimes \Gamma \vdash \parr \Delta
            is valid, where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⨂
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo ⊗
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \bigotimes(A, B, C) \coloneqq A \otimes B \otimes C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            (using implicitly that these are associative, with identity elements to handle the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/empty+sequence"} empty sequence
          %p
            We can even restrict attention to sequents with no term on the left side and one term on the right;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊢
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \vdash B
            is valid if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                  %mi A
                  %mo ⊸
                  %mi B
                %annotation{:encoding => "application/x-tex"} \vdash A \multimap B
            is valid, where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊸
                    %mi B
                    %mo ≔
                    %msup
                      %mi A
                      %mo ⊥
                    %mo ⅋
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \multimap B \coloneqq A^\perp \parr B
          %h2#variants Variants
          %p
            The logic described above is full classical linear logic. There are many important
            %a.existingWikiWord{:href => "/nlab/show/fragments"} fragments
            and variants of linear logic, such as:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+linear+logic"} multiplicative linear logic
                (MLL), which contains only
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo ,
                      %mo ⅋
                    %annotation{:encoding => "application/x-tex"} \otimes,\parr
                and their units
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathbf{1},\bot
                as well as the negation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊥
                      %annotation{:encoding => "application/x-tex"} (-)^\perp
            %li
              %p
                multiplicative-exponential linear logic (MELL), which contains only
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo ,
                      %mo ⅋
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %mo ⊥
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \otimes,\parr,\mathbf{1},\bot,(-)^\perp
                and the exponential modalities
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo !
                        %mo ,
                        %mo ?
                      %annotation{:encoding => "application/x-tex"} !,?
            %li
              %p
                multiplicative-additive linear logic (MALL), which contains everything
                %em except
                the exponential modalities
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo !
                        %mo ,
                        %mo ?
                      %annotation{:encoding => "application/x-tex"} !,?
            %li
              %p
                multiplicative intuitionistic linear logic (MILL), which contains only
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %mo ⊸
                    %annotation{:encoding => "application/x-tex"} \otimes,\mathbf{1},\multimap
                (the latter now as a primitive operation); in particular there is no longer the involutive negation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊥
                      %annotation{:encoding => "application/x-tex"} (-)^\perp
            %li
              %p
                intuitionistic linear logic (ILL), which contains all the additive connectives
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi &amp;
                      %mo ,
                      %mo ⊕
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 0
                      %mo ,
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} \&amp;,\oplus,\mathbf{0},\top
                as well as the intutionistic multiplicatives
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %mo ⊸
                    %annotation{:encoding => "application/x-tex"} \otimes,\mathbf{1},\multimap
                and the exponential
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo !
                      %annotation{:encoding => "application/x-tex"} !
            %li
              %p
                full intuitionistic linear logic (FILL), which in addition to ILL contains the multiplicative disjunction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⅋
                      %annotation{:encoding => "application/x-tex"} \parr
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ?
                      %annotation{:encoding => "application/x-tex"} ?
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⅋
                      %mo ,
                      %mo ?
                    %annotation{:encoding => "application/x-tex"} \parr,?
                is also called “full” intuitionistic linear logic.)
            %li
              %p non-commutative linear logics (braided or not)
            %li
              %p “light” and “soft” linear logics, which limit the use of ! to constrain the computational complexity of proofs
            %li
              %p
                first-order linear logic, which adds quantifiers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                    %annotation{:encoding => "application/x-tex"} \exists
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                    %annotation{:encoding => "application/x-tex"} \forall
                (sometimes denoted
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %annotation{:encoding => "application/x-tex"} \bigvee
                and
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %annotation{:encoding => "application/x-tex"} \bigwedge
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bunched+implication"} bunched implication
          %p
            One can also consider adding additional rules to linear logic. For instance, by adding the
            %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening rule
            (but not the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/affine+logic"} affine logic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relevance+logic"} relevance logic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mix+rule"} mix rule
          %p
            %a.existingWikiWord{:href => "/nlab/show/linear-non-linear+logic"} Linear-non-linear logic
            is an equivalent presentation of intuitionistic linear logic that decomposes the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            modality into an adjunction between a cartesian logic and a linear one in which cartesian variables can also appear.
          %p
            Some models of linear logic allow for a
            %em codereliction
            operation, which allows for one to take the “linear approximation” of a proof
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} !(A) \to B
            = succeed "," do
              %em differential linear logic
            = succeed ")." do
              %a{:href => "#Blute-Cockett-Seely06"} Blute–Cockett–Seely
          %h2#categorical_semantics Categorical semantics
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of linear logic. See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} relation between type theory and category theory
          %h3#autonomous_categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            \-autonomous categories
          %p
            One way to explain linear logic to a category theorist is to say that its models are
            %a.existingWikiWord{:href => "/nlab/show/%2A-autonomous+categories"} *-autonomous categories
            with extra structure (
            %a{:href => "#Seely"}> Seely, 1989, prop. 1.5
            ). (If the underlying category is a
            %a.existingWikiWord{:href => "/nlab/show/suplattice"} suplattice
            then these are commutative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantales"} quantales
            = succeed "))" do
              %a{:href => "#Yetter90"} Yetter 90
          %p
            Firstly, there is a monoidal ‘
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"}> tensor
            ’ connective
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \otimes B
            %a.existingWikiWord{:href => "/nlab/show/negation"} Negation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} A^\bot
            is modelled by the
            %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
            involution
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^*
            %a.existingWikiWord{:href => "/nlab/show/linear+implication"} linear implication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊸
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\multimap B
            corresponds to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %msup
                      %mi B
                      %mo ⊥
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} (A\otimes B^\bot)^\bot
            %a.existingWikiWord{:href => "/nlab/show/de+Morgan+dual"} de Morgan dual
            of the tensor called ‘par’, with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⅋
                    %mi B
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ⊥
                    %mo ⊗
                    %msup
                      %mi B
                      %mo ⊥
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} A \parr B = (A^\bot\otimes B^\bot)^\bot
          %p
            The ‘additive’ connectives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi &amp;
                %annotation{:encoding => "application/x-tex"} \&amp;
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                  %annotation{:encoding => "application/x-tex"} \oplus
            %a.existingWikiWord{:href => "/nlab/show/conjunction"} conjunction
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            %a{:href => "#Seely"} Seely (1989)
            notes that products are sufficient, as
            = succeed "-autonomy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
          %p
            Recall also that linear logic recaptures the notion of a resource that can be discarded or copied arbitrarily by the use of the
            %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal
            operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} !A
            denotes an ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            \-factory’, a resource that can produce zero or more
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            on the underlying
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a{:href => "https://ncatlab.org/nlab/show/!-modality"} !-modality
            for discussion.
          %p An LL sequent
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi A
                    %mi n
                  %mo ⊢
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi B
                    %mi m
                %annotation{:encoding => "application/x-tex"} A_1,\ldots,A_n \vdash B_1,\ldots,B_m
          %p is interpreted as a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi i
                  %msub
                    %mi A
                    %mi i
                  %mo →
                  %msub
                    %mo ⅋
                    %mi j
                  %msub
                    %mi B
                    %mi j
                %annotation{:encoding => "application/x-tex"} \otimes_i A_i \to \parr_j B_j
          %p
            The comonoid structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} !A
            then yields the weakening
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊗
                  %mo !
                  %mi A
                  %mo →
                  %mi Γ
                  %mo ⊗
                  %mi I
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma\otimes !A \to \Gamma \otimes I \to \Gamma
          %p and contraction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊗
                  %mo !
                  %mi A
                  %mo →
                  %mi Γ
                  %mo ⊗
                  %mo !
                  %mi A
                  %mo ⊗
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Gamma\otimes !A \to \Gamma \otimes !A \otimes !A
          %p maps. The corresponding rules are interpreted by precomposing the interpretation of a sequent with one of these maps.
          %p
            The (co)-
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential
            (unsurprisingly for a Kleisli category) is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi A
                    %mo ≅
                    %mo !
                    %mi A
                    %mo ⊸
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B^A \cong !A\multimap B
          %p
            Particular monoidal and
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            for modeling linear logic can be obtained by
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ternary+frames"} ternary frames
            %em phase spaces
            as a particular example.
          %p
            First-order linear logic is correspondingly modeled in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+hyperdoctrine"} linear hyperdoctrine
          %h3#polycategories Polycategories
          %p
            A different way to explain linear logic categorically (though equivalent, in the end) is to start with a categorical structure which lacks any of the connectives, but has sufficient structure to enable us to characterize them with universal properties. If we ignore the exponentials for now, such a structure is given by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polycategory"} polycategory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ,
                  %mi E
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,C) \to (D,E,F)
          %p
            in a polycategory correspond to sequents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi C
                  %mo ⊢
                  %mi D
                  %mo ,
                  %mi E
                  %mo ,
                  %mi F
                %annotation{:encoding => "application/x-tex"} A,B,C \vdash D,E,F
            in linear logic. The multiplicative connectives are then characterized by representability and corepresentability properties:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo →
                      %mi C
                %annotation{:encoding => "application/x-tex"} \frac{(A,B) \to C}{A\otimes B \to C}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                      %mo ⅋
                      %mi C
                %annotation{:encoding => "application/x-tex"} \frac{A \to (B,C)}{A \to B\parr C}
          %p (Actually, we should allow arbitrarily many unrelated objects to carry through in both cases.) The additives are similarly characterized as categorical products and coproducts, in a polycategorically suitable sense.
          %p Finally, dual objects can be recovered as a sort of “adjoint”:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %mrow
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi B
                        %mo *
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{(A,B) \to C}{A \to (B^*,C)}
          %p
            If all these representing objects exist, then we recover a
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %p
            One merit of the polycategory approach is that it makes the role of the structural rules clearer, and also helps explain why
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            sometimes seems like a disjunction and sometimes like a conjunction. Allowing contraction and weakening on the left corresponds to our polycategory being “left
            = succeed "\u201D;" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+multicategory"} cartesian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo ;
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ;
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(A,A; B) \to Hom(A;B)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo ;
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(;B) \to Hom(A,B)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            coincides with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi &amp;
                  %annotation{:encoding => "application/x-tex"} \&amp;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            to coincide with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                  %annotation{:encoding => "application/x-tex"} \oplus
          %p
            On the other hand, if we allow “multi-composition” in our polycategory, i.e. we can compose a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \to (B,C)
            with one
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} (B,C)\to D
            to obtain a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} A\to D
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/PROP"} PROP
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            become the same. This explains why
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            has both a disjunctive and a conjunctive aspect. Of course, if in addition to multi-composition we have the left and right cartesian properties, then all four connectives coincide (including the categorical product and coproduct) and we have an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
          %h2#game_semantics_2 Game semantics
          %p We can interpret any proposition in linear logic as a game between two players: we and they. The overall rules are perfectly symmetric between us and them, although no individual game is. At any given moment in a game, exactly one of these four situations obtains: it is our turn, it is their turn, we have won, or they have won; the last two states continue forever afterwards (and the game is over). If it is our turn (or if they have won), then they are winning; if it is their turn (or if we have won), then we are winning. So there are two ways to win: because the game is over (and a winner has been decided), or because it is forever the other players’ turn (either because the other players have no move or because every move results in the other players’ turn again).
          %p This is a little complicated, but it's important in order to be able to distinguish the four constants:
          %ul
            %li
              In
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} \top
            %li
              Dually, in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbf{0}
            %li
              In contrast, in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}
            %li
              Dually, in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \bot
          %p The binary operators show how to combine two games into a larger game:
          %ul
            %li
              In
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi &amp;
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \&amp; B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %li
              Dually, in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊕
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \oplus B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %li
              In
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \otimes B
            %li
              Dually, in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⅋
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \parr B
          %p So we can classify things as follows:
          %ul
            %li In a conjunction, they choose what game to play; in a disjunction, we have control. Whoever has control must win at least one game to win overall.
            %li In an addition, one game must be played; in a multiplication, all games must be played.
          %p
            To further clarify the difference between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            (the additive and multiplicative versions of truth, both of which we win); consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⅋
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} A \parr \top
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⅋
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A \parr \mathbf{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⅋
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} A \parr \top
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⅋
                    %mo ⊤
                    %mo ≡
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} A \parr \top \equiv \top
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⅋
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A \parr \mathbf{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            ends immediately, so play continues as in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 0
                    %mo ⅋
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{0} \parr \mathbf{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ⅋
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \bot \parr \mathbf{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A \otimes \mathbf{1}
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ≡
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \otimes \mathbf{1} \equiv A
          %p Negation is easy:
          %ul
            %li
              To play
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} A^\perp
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            There are several ways to think of the exponentials. As before, they have control in a conjunction, while we have control in a disjunction. Whoever has control of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"} !{A}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ?
                  %mi A
                %annotation{:encoding => "application/x-tex"} ?{A}
            chooses how many copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to play and must win them all to win overall. There are many variations on whether the player in control can spawn new copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            or close old copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            prematurely, and whether the other player can play different moves in different copies (whenever the player in control plays the same moves).
          %p
            Other than the decisions made by the player in control of a game, all moves are made by transmitting resources. Ultimately, these come down to the propositional variables; in the game
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to them, while they must transmit a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to us in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} p^\perp
          %p
            A game is
            %strong valid
            if we have a strategy to win (whether by putting the game in a state where we have won or by guaranteeing that it is forever their turn). The soundness and completeness of this interpretation is the theorem that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a valid game if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                  %mi A
                %annotation{:encoding => "application/x-tex"} \vdash A
            is a valid sequent. (Recall that all questions of validity of sequents can be reduced to the validity of single propositions.)
          %p
            Game semantics for linear logic was first proposed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"} Andreas Blass
            = succeed "." do
              %a{:href => "#Blass1992"} Blass (1992)
          %h2#multiple_exponential_operators Multiple exponential operators
          %p
            Much as there are many
            %a.existingWikiWord{:href => "/nlab/show/exponential+functions"} exponential functions
            (say from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
                  %annotation{:encoding => "application/x-tex"} ?
            %a.existingWikiWord{:href => "/nlab/show/logarithm"} logarithm
            to convert between them.)
          %p
            More precisely, if we add to the language of linear logic two more operators,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo ′
                %annotation{:encoding => "application/x-tex"} !'
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} ?'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
                  %annotation{:encoding => "application/x-tex"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mi A
                  %mo ≡
                  %mo !
                  %mo ′
                  %mi A
                %annotation{:encoding => "application/x-tex"} !{A} \equiv !'{A}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
                    %mi A
                    %mo ≡
                    %mo ?
                    %mo ′
                    %mi A
                  %annotation{:encoding => "application/x-tex"} ?{A} \equiv ?'{A}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi &amp;
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \&amp;'
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \bot'
            %em can
            prove that the new operators are equivalent to the old ones.
          %p
            In terms of the categorial interpretation above, there may be many comonads
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                  %annotation{:encoding => "application/x-tex"} !
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %p One sometimes thinks of the exponentials as coming from infinitary applications of the other operations. For example:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo ≔
                    %mn 1
                    %mi &amp;
                    %mi A
                    %mi &amp;
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi &amp;
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi &amp;
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} !{A} \coloneqq 1 \&amp; A \&amp; (A \otimes A) \&amp; (A \otimes A \otimes A) \&amp; \cdots
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mi &amp;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mi &amp;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mi &amp;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} !{A} \coloneqq (1 \&amp; A) \otimes (1 \&amp; A) \otimes (1 \&amp; A) \otimes \cdots
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo ≔
                    %mn 1
                    %mi &amp;
                    %mi k
                    %mi A
                    %mi &amp;
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi &amp;
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mn 3
                    %mo{:stretchy => "false"} /
                    %mn 6
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi &amp;
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} !{A} \coloneqq 1 \&amp; k A \&amp; (k^2/2) (A \otimes A) \&amp; (k^3/6) (A \otimes A \otimes A) \&amp; \cdots
              (which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} e
                      %mrow
                        %mi k
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{e}^{k A}
              in an appropriate sense), where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} n A
              means an
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi &amp;
                    %mi ⋯
                    %mi &amp;
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \&amp; \cdots \&amp; A
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a positive number such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi n
                      %mo !
                  %annotation{:encoding => "application/x-tex"} k^n/{n!}
              is always a natural number (which of course is impossible).
          %p All of these justify the rules for the exponentials, so again we see that there may be many ways to satisfy these rules.
