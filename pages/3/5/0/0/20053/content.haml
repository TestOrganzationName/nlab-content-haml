          %h2#idea Idea
          %p
            A
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              \-additive measure
            (alias τ-regular, τ-smooth) is a
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            on a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which interacts well with the topology. In particular, it has a well-defined and well-behaved
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/support"} support
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            \-additive measures can be thought of as a point of contact between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure+theory"} measure theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/valuation+%28measure+theory%29"} valuations
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/correspondence+between+measure+and+valuation+theory"} correspondence between measure and valuation theory
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.existingWikiWord{:href => "/nlab/show/Borel+subset"} Borel measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is called
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                \-additive
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                \-smooth
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                \-regular
            %a.existingWikiWord{:href => "/nlab/show/net"} net
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi λ
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi λ
                      %mo ∈
                      %mi Λ
                %annotation{:encoding => "application/x-tex"} \{U_\lambda\}_{\lambda\in\Lambda}
            of
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %munder
                    %mi sup
                    %mi λ
                  %msub
                    %mi U
                    %mi λ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo =
                  %munder
                    %mi sup
                    %mi λ
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi λ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu \big( \sup_{\lambda} U_\lambda \big)
                  \=
                  \\sup_\lambda \mu(U_\lambda) .
          %p
            This property can be considered an instance of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Scott+topology"} Scott continuity
