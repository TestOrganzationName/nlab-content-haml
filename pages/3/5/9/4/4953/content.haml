                %text#text4500{"sodipodi:linespacing" => "125%", :style => "font-size:22px;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;text-align:start;line-height:125%;writing-mode:lr-tb;text-anchor:start;fill:#000000;fill-opacity:1;stroke:none;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1;font-family:Bitstream Vera Sans;-inkscape-font-specification:Bitstream Vera Sans", :x => "388.69772", "xml:space" => "preserve", :y => "256.94373"}
                  %tspan#tspan4502{"sodipodi:role" => "line", :x => "388.69772", :y => "256.94373"} b
                %text#text4504{"sodipodi:linespacing" => "125%", :style => "font-size:22px;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;text-align:start;line-height:125%;writing-mode:lr-tb;text-anchor:start;fill:#000000;fill-opacity:1;stroke:none;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1;font-family:Bitstream Vera Sans;-inkscape-font-specification:Bitstream Vera Sans", :x => "314.53827", "xml:space" => "preserve", :y => "383.52621"}
                  %tspan#tspan4506{"sodipodi:role" => "line", :x => "314.53827", :y => "383.52621"} c
                %text#text4508{"sodipodi:linespacing" => "125%", :style => "font-size:22px;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;text-align:start;line-height:125%;writing-mode:lr-tb;text-anchor:start;fill:#000000;fill-opacity:1;stroke:none;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1;font-family:Bitstream Vera Sans;-inkscape-font-specification:Bitstream Vera Sans", :x => "475.64325", "xml:space" => "preserve", :y => "425.72037"}
                  %tspan#tspan4510{"sodipodi:role" => "line", :x => "475.64325", :y => "425.72037"} d
                %text#text4512{"sodipodi:linespacing" => "125%", :style => "font-size:22px;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;text-align:start;line-height:125%;writing-mode:lr-tb;text-anchor:start;fill:#000000;fill-opacity:1;stroke:none;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1;font-family:Bitstream Vera Sans;-inkscape-font-specification:Bitstream Vera Sans", :x => "538.29517", "xml:space" => "preserve", :y => "288.909"}
                  %tspan#tspan4514{"sodipodi:role" => "line", :x => "538.29517", :y => "288.909"} e
            %p (arrow go from left to right but are not showing up … bother!)
            %p
              We take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Sigma = \{ a,b,c,d,e\}
              and note that, starting at the left,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              depends on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              (written
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a\lt b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              until action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              has been completed. This gives a labelled
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %p
              Here the first information to encode in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is the poset structure of dependency
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi etc
                    %mo .
                    %mo{:stretchy => "false"} }
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \{(a,a),(a,b),(a,c),(a,d),(a,e),(b,b),(b,d), etc.\},
            %p then symmetrise this, and take the complement to get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} I = \{(b,c),(c,b),(d,e),(e,d),(b,e), (e,b), (c,d),(d,c)\}.
            %p
              Note this encoding does not involve the relationship given by adjacency, and hence ignore if an ‘execution sequence’ is ‘allowable’ (i.e., realistic) so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,d)
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              even though we could not first ‘do’
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              and then ‘do’
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              (unless of course
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              had already been done).
            %p
              The language (
              %span.newWikiWord>
                trace language
                %a{:href => "/nlab/new/trace+language"} ?
              ) corresponding to the model will be a subset of the
              %a.existingWikiWord{:href => "/nlab/show/trace+monoid"} trace monoid
              of the trace alphabet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Sigma, I)
              given here. It will encode allowable execution sequences but also will consider the allowable sequences (
              %em traces
              ):
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mi c
                      %mi d
                      %mi e
                    %annotation{:encoding => "application/x-tex"} a b c d e
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi c
                      %mi b
                      %mi d
                      %mi e
                    %annotation{:encoding => "application/x-tex"} a c b d e
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mi d
                      %mi c
                      %mi e
                    %annotation{:encoding => "application/x-tex"} a b d c e
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi c
                    %mi e
                    %mi b
                    %mi d
                  %annotation{:encoding => "application/x-tex"} a c e b d
              etc. to be identified.
          %h2#reference Reference
          %ul
            %li
              A Mazurkiewicz,
              %em Trace theory
              in ‘Advances in Petri Nets’, volume 255 of LNCS, Springer (1987).
