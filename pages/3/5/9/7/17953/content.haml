            %li
              %p
                Masato Arai,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Claus+Montonen"} Claus Montonen
                = succeed "," do
                  %em Vortices, Q-balls and Domain Walls on Dielectric M2-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0812.4437"} arXiv:0812.4437
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Iosif+Bena"}> Iosif Bena
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mariana+Gra%C3%B1a"} Mariana Graña
                = succeed "," do
                  %em Tachyonic Anti-M2 Branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1402.2294"} arXiv:1402.2294
          %p
            With emphasis on the role of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Page+charge"} Page charge
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+WZ+term"} Hopf WZ term
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Pilch"}> Krzysztof Pilch
              , Alexander Tyukov,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Warner"} Nicholas Warner
              = succeed "," do
                %em Flowing to Higher Dimensions: A New Strongly-Coupled Phase on M2 Branes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1506.01045"} arXiv:1506.01045
          %p
            The corresponding D2-NS5 bound state under
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Iosif+Bena"}> Iosif Bena
              , Aleksey Nudelman,
              = succeed "," do
                %em
                  Warping and vacua of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi YM
                          %mrow
                            %mn 3
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} (S)YM_{3+1}
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0005163"} arXiv:hep-th/0005163
          %p
            Via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/mass-deformed+ABJM+model"} mass-deformed ABJM model
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jaume+Gomis"}> Jaume Gomis
              , Diego Rodriguez-Gomez,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mark+Van+Raamsdonk"} Mark Van Raamsdonk
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Herman+Verlinde"} Herman Verlinde
              = succeed "," do
                %em A Massive Study of M2-brane Proposals
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0807.1074"} arXiv:0807.1074
          %p
            and identifying the polarization into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S^3
            as a
            = succeed "-version" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+sphere"} fuzzy sphere
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Horatiu+Nastase"}> Horatiu Nastase
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantinos+Papageorgakis"} Constantinos Papageorgakis
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sanjaye+Ramgoolam"} Sanjaye Ramgoolam
              = succeed "," do
                %em
                  The fuzzy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} S^2
                  structure of M2-M5 systems in ABJM membrane theories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0903.3966"} arXiv:0903.3966
          %p Review in:
          %ul
            %li#BaggerLambertMukhiPapageorgakis13
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Bagger"}> Jonathan Bagger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"} Neil Lambert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sunil+Mukhi"} Sunil Mukhi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantinos+Papageorgakis"} Constantinos Papageorgakis
              = succeed "," do
                %em Multiple Membranes in M-theory
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1203.3546"} arXiv:1203.3546
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/j.physrep.2013.01.006"} doi:10.1016/j.physrep.2013.01.006
          %h3#polarization_of_m5branes_into_mk6s Polarization of M5-branes into MK6s
          %p
            More general
            %a.existingWikiWord{:href => "/nlab/show/M-brane+polarizations"} M-brane polarizations
            and polarization of
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            into
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/MK6"} MK6
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yolanda+Lozano"}> Yolanda Lozano
                ,
                = succeed "," do
                  %em Non-commutative Branes from M-theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0012137"} arXiv:hep-th/0012137
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Iosif+Bena"}> Iosif Bena
                , Diana Vaman,
                = succeed "," do
                  %em The polarization of M5 branes and little string theories with reduced supersymmetry
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0101064"} arXiv:hep-th/0101064
          %p
            Via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ABJM+model"} ABJM model
          %ul
            %li
              %p
                Wung-Hong Huang,
                = succeed "," do
                  %em KK6 from M2 in ABJM
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1102.3357"} arXiv:1102.3357
            %li
              %p
                Wung-Hong Huang,
                %em
                  M2-KK6 System in ABJM Theory: Fuzzy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} S^3
                  and Wrapped KK6
                (
                %a{:href => "https://arxiv.org/abs/1107.2030"}> arXiv:1107.2030
                )
          %h3#relation_to_giant_gravitons Relation to giant gravitons
          %p
            On the relation of polarized branes to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/giant+gravitons"} giant gravitons
