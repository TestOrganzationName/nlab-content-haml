                %li
                  %a{:href => "#NonReducibleHeteroticGaugeBackgrounds"}
                    Non-reducible heterotic
                    = succeed "-gauge" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
