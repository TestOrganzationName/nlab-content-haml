          %h2#references References
          %h3#for_type_iia_and_mtheory For type IIA and M-theory
          %p
            The conjectured duality between
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactified
            on
            %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            times an
            %a.existingWikiWord{:href => "/nlab/show/n-torus"} n-torus
            and
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            on the
            = succeed "-torus" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+2)
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em Unity of Superstring Dualities
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9410167"} arXiv:hep-th/9410167
            %li#Witten95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , section 4 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/String+Theory+Dynamics+In+Various+Dimensions"} String Theory Dynamics In Various Dimensions
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9503124"} arXiv:hep-th/9503124
            %li#Lerche99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
                ,
                = succeed "," do
                  %em On the Heterotic/F-Theory Duality in Eight Dimensions
                = succeed "," do
                  %em Progress in String Theory and M-Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9910207"} arXiv:hep-th/9910207
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-94-010-0852-5_2"} doi:10.1007/978-94-010-0852-5_2
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Morrison"} David Morrison
                = succeed "," do
                  %em String Theory on K3 Surfaces
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brian+Greene"} Brian Greene
                %a.existingWikiWord{:href => "/nlab/show/Shing-Tung+Yau"} Shing-Tung Yau
                (eds.),
                = succeed "," do
                  %em Mirror Symmetry II
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9404151"} arXiv:hep-th/9404151
            %li#Aspinwall96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed "," do
                  %em K3 Surfaces and String Duality
                %a.existingWikiWord{:href => "/nlab/show/Shing-Tung+Yau"} Shing-Tung Yau
                (ed.):
                %em Differential geometry inspired by string theory
                1-95 (
                %a{:href => "https://arxiv.org/abs/hep-th/9611137"} arXiv:9611137
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/426102"} spire:426102
          %p Further discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed "," do
                  %em Enhanced Gauge Symmetries and K3 Surfaces
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9507012"} arXiv:hep-th/9507012
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                , C. Condeescu, G. Pradisi, F. Riccioni,
                = succeed "," do
                  %em Heterotic-Type II duality and wrapping rules
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1311.3578"} arXiv:1311.3578
          %p
            Specifically in relation to the putative
            = succeed "-classification" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
          %ul
            %li#GarciaUranga05
              Inaki Garcia-Etxebarria,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"} Angel Uranga
              = succeed "," do
                %em From F/M-theory to K-theory and back
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0510073"} arXiv:hep-th/0510073
          %p
            Specifically in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
          %ul
            %li#AtiyahWitten01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                section 6.4 of
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
                    \-Theory dynamics on a manifold of
                    = succeed "-holonomy" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} G_2
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0107177"} arXiv:hep-th/0107177
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                , Alex Kinsella,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Morrison"} David Morrison
                %em
                  Non-Perturbative Heterotic Duals of M-Theory on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                  Orbifolds
                (
                %a{:href => "https://arxiv.org/abs/2106.03886"}> arXiv:2106.03886
                )
          %p
            Specifically in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Moonshine"} Moonshine
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Miranda+Cheng"}> Miranda Cheng
              , Sarah M. Harrison, Roberto Volpato, Max Zimet,
              %em K3 String Theory, Lattices and Moonshine
              (
              %a{:href => "https://arxiv.org/abs/1612.04404"}> arXiv:1612.04404
              )
          %h3#for_ftheory For F-theory
          %p
            Discussion for
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            includes
          %ul
            %li#MorrisonVafa96a
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Morrison"}> David Morrison
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em Compactifications of F-Theory on Calabi–Yau Threefolds – I
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9602114"} arXiv:hep-th/9602114
            %li#MorrisonVafa96b
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Morrison"}> David Morrison
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em Compactifications of F-Theory on Calabi–Yau Threefolds – II
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9603161"} arXiv:hep-th/9603161
            %li#Sen96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ashoke+Sen"}> Ashoke Sen
                ,
                %em F-theory and Orientifolds
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9605150"}> arXiv:hep-th/9605150
                )
            %li#FriedmanMorganWitten97
              %p
                Robert Friedman,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em Vector Bundles And F Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9701162"} arXiv:hep-th/9701162
            %li#Aspinwall97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed "," do
                  %em M-Theory Versus F-Theory Pictures of the Heterotic String
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9707014"} arXiv:hep-th/9707014
          %p
            Review of (
            %a{:href => "#FriedmanMorganWitten97"}> Friedman-Morgan-Witten 97
            ) is in
          %ul
            %li#Donagi98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ron+Donagi"}> Ron Donagi
                ,
                %em ICMP lecture on heterotic/F-theory duality
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9802093"}> arXiv:hep-th/9802093
                )
            %li
              %p
                Björn Andreas,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} N=1
                    Heterotic/F-theory duality
                = succeed ")" do
                  %a{:href => "http://edoc.hu-berlin.de/dissertationen/physik/andreas-bjoern/PDF/Andreas.pdf"} pdf
          %p with more details in
          %ul
            %li#DonagiMarkman95
              %a.existingWikiWord{:href => "/nlab/show/Ron+Donagi"}> Ron Donagi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eyal+Markman"} Eyal Markman
              %em Spectral curves, algebraically completely integrable Hamiltonian systems, and moduli of bundles
              (
              %a{:href => "http://arxiv.org/abs/alg-geom/9507017"}> arXiv:alg-geom/9507017
