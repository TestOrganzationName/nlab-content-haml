            %h6 Proposition
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/invertible+matrices"} invertible matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z}) \subset GL_2(\mathbb{Z})
              is generated by the two elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ,
                    %mi T
                    %mo ∈
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S,T \in SL_2(\mathbb{Z})
              given by
            #eq:ModularGenerators.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mtable{:columnalign => "right right", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                          %mtd
                            %mn 0
                      %mo ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mtable{:columnalign => "right right", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                      %mo ]
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\;\coloneqq\;
                    \\left[
                    \\begin{array}{rr}
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    \\end{array}
                    \\right]
                    \\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;
                    T
                    \\;\coloneqq\;
                    \\left[
                    \\begin{array}{rr}
                    1 &amp; 1
                    \\\
                    0 &amp; 1
                    \\end{array}
                    \\right]
                    \\mathrlap{\,.}
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/finitely+presented+group"} presented
              via these generators subject to the following relations:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi S
                    %mo ,
                    %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 4
                    %mo =
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 3
                    %mo =
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi S
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi S
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SL_2(\mathbb{Z})
                    \\;\simeq\;
                    \\big\langle
                    S, T
                    \\,\big\vert\,
                    S^4 = \mathrm{e}
                    ,\,
                    (T S)^3 = \mathrm{e}
                    ,\,
                    S^2 (T S) = (T S)S^2
                    \\big\rangle
                    \\,.
            %p
          For the first statement, an early reference (without proof) is
          = succeed "," do
            %a{:href => "#Serre73"} Serre 1973 Thm. VII.2 p 78
          = succeed "." do
            %a{:href => "#Conrad"} Conrad Thm 1.1
          %a{:href => "#BlancDéserti12"} Blanc &amp; Déserti 2012 §2.1
          with reference to
          %a{:href => "#Newman72"} Newman 1972
          (proof?) and by
          %a{:href => "#Wehler21"} Wehler 2021 Rem. 2.17(1)
          following
          = succeed "." do
            %a{:href => "#KoecherKrieg07"} Koecher &amp; Krieg 2007 Remark on p. 126
          %p
            Alternatively,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
            is
            %a.existingWikiWord{:href => "/nlab/show/finitely+presented+group"} presented
            via the generators
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mtable{:columnalign => "right right", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                          %mn 1
                      %mtr
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %mtd
                          %mn 0
                    %mo ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext and
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi T
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mtable{:columnalign => "right right", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %mn 1
                    %mo ]
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  S
                  \\;\coloneqq\;
                  \\left[
                  \\begin{array}{rr}
                  0 &amp; 1
                  \\\
                  \-1 &amp; 0
                  \\end{array}
                  \\right]
                  \\;\;\;\;\;
                  \\text{and}
                  \\;\;\;\;\;
                  T
                  \\;\coloneqq\;
                  \\left[
                  \\begin{array}{rr}
                  1 &amp; 0
                  \\\
                  1 &amp; 1
                  \\end{array}
                  \\right]
                  \\mathrlap{\,.}
          %p as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                  %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mi T
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mn 4
                  %mo =
                  %mi{:mathvariant => "normal"} e
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mo =
                  %msup
                    %mi S
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  SL_2(\mathbb{Z})
                  \\;\simeq\;
                  \\big\langle
                  S\,, T
                  \\,\big\vert\,
                  S^4 = \mathrm{e}
                  ,\,
                  (S T)^3 = S^2
                  \\big\rangle
          %p
            (
            %a{:href => "#Serre80"}> Serre 1980 p. 81
            ,
            = succeed "," do
              %a{:href => "#RubinsteinGardiner79"} Rubinstein &amp; Gardiner 1979
            = succeed ")" do
              %a{:href => "#KasselTuraev08"} Kassel &amp; Turaev 2008 (A.2)
          %h3#SpinPreservingSubgroups Spin-structure preserving subgroups
          %p
            The torus admits exactly 4 distinct
            %a.existingWikiWord{:href => "/nlab/show/spin+structures"} spin structures
            (see
            = succeed ")" do
              %a{:href => "spin+structure#SpinStructuresOnClosedSurfaces"} there
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mi pp
                  %mo ,
                  %mi pa
                  %mo ,
                  %mi ap
                  %mo ,
                  %mi aa
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi T
                    %mn 2
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi C
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big\{
                  pp, pa, ap, aa
                  \\big\}
                  \\;\;
                  \\simeq
                  \\;\;
                  H_1\big(T^2;\, C_2\big)
          %p
            (with “periodic” or “antiperiodic”
            %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            for
            %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
            along two
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
            1-cycles, cf.
            = succeed ")." do
              %a{:href => "#AlvaresGauméMooreVafa86"} Alvares-Gaumé, Moore &amp; Vafa 1986 §2
          %p
            Under its canonical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixes
            the “trivial” structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pp
                %annotation{:encoding => "application/x-tex"} pp
            (called the
            %em odd
            spin structure) and
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutes
            the other 3 (the
            %em even
            spin structures)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
          %p
            The
            %a{:href => "#SandTgenerateSL2Z"} above generators
            act as (cf.
            = succeed "," do
              %a{:href => "https://mathoverflow.net/a/72770/381"} MO:a/72770
            = succeed ")" do
              %a{:href => "#BondersonRowellZhangWang18"} Bonderson, Rowell, Zhang &amp; Wang 2018 p 3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi pp
                        %mtd
                          %mo ↦
                        %mtd
                          %mi pp
                      %mtr
                        %mtd
                          %mi ap
                        %mtd
                          %mo ↦
                        %mtd
                          %mi pa
                      %mtr
                        %mtd
                          %mi pa
                        %mtd
                          %mo ↦
                        %mtd
                          %mi ap
                      %mtr
                        %mtd
                          %mi aa
                        %mtd
                          %mo ↦
                        %mtd
                          %mi aa
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi T
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi pp
                        %mtd
                          %mo ↦
                        %mtd
                          %mi pp
                      %mtr
                        %mtd
                          %mi ap
                        %mtd
                          %mo ↦
                        %mtd
                          %mi ap
                      %mtr
                        %mtd
                          %mi pa
                        %mtd
                          %mo ↦
                        %mtd
                          %mi aa
                      %mtr
                        %mtd
                          %mi aa
                        %mtd
                          %mo ↦
                        %mtd
                          %mi pa
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  S \;\colon\;
                  \\left\{
                  \\begin{array}{rcl}
                  pp &amp;\mapsto&amp; pp
                  \\\
                  ap &amp;\mapsto&amp; pa
                  \\\
                  pa &amp;\mapsto&amp; ap
                  \\\
                  aa &amp;\mapsto&amp; aa
                  \\mathrlap{\,,}
                  \\end{array}
                  \\right.
                  \\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;
                  T \;\colon\;
                  \\left\{
                  \\begin{array}{rcl}
                  pp &amp;\mapsto&amp; pp
                  \\\
                  ap &amp;\mapsto&amp; ap
                  \\\
                  pa &amp;\mapsto&amp; aa
                  \\\
                  aa &amp;\mapsto&amp; pa
                  \\mathrlap{\,.}
                  \\end{array}
                  \\right.
          %p
            Hence the subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
            which
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizes
            the
            = succeed "-spin" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi aa
                  %annotation{:encoding => "application/x-tex"} aa
            = succeed "-spin" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi aa
                  %annotation{:encoding => "application/x-tex"} aa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and the
            %em square
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi θ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo ,
                  %msup
                    %mi T
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mrow
                      %msub
                        %mi SL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_\theta
                  \\;\coloneqq\;
                  \\langle S, T^2\rangle_{SL_2(\mathbb{Z})} \subset SL_2(\mathbb{Z})
                  \\,.
          %p
            (This is a
            %a.existingWikiWord{:href => "/nlab/show/congruence+subgroup"} congruence subgroup
            of
            = succeed "=3," do
              %a.existingWikiWord{:href => "/nlab/show/index+of+a+subgroup"} index
            = succeed ")." do
              %a{:href => "#Conrad"} Conrad, Coe. 3.6 &amp; Ex. 3.7
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            by the
            %a.existingWikiWord{:href => "/nlab/show/center+of+a+group"} center
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ±
                  %mi I
                %annotation{:encoding => "application/x-tex"} \pm I
            is well-known (but canonical reference?) to be freely generated by these two elements (cf.
            = succeed ")" do
              %a{:href => "#BruillardEtAl17"} Bruillard et al 2017 Thm. 2.7
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi θ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo ±
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo ,
                  %msup
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_\theta / (\pm I)
                  \\;\simeq\;
                  \\langle S, T^2\rangle
                  \\,.
          %p
            This implies &amp;lbrack;
            %a{:href => "https://mathoverflow.net/a/490283/381"}> MO:a/490283
            \&amp;rbrack; that the subgroup itself has the following presentation:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi θ
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                  %mi S
                  %mo ,
                  %msup
                    %mi T
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mn 4
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 2
                  %mo ,
                  %msup
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi{:mathvariant => "normal"} e
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_{\theta}
                  \\;\simeq\;
                  \\big\langle
                  S, T^2
                  \\,\big\vert\,
                  S^4 = [S^2, T^2] = \mathrm{e}
                  \\big\rangle
                  \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modular+form"} modular form
