          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+hadrodynamics"} quantum hadrodynamics
            a
            %em Dalitz decay
            is the
            %a.existingWikiWord{:href => "/nlab/show/decay"} decay
            of an electrically neutral
            %a.existingWikiWord{:href => "/nlab/show/pseudoscalar+meson"} pseudoscalar meson
            into a
            %a.existingWikiWord{:href => "/nlab/show/dilepton"} dilepton
            pair and a either a
            %a.existingWikiWord{:href => "/nlab/show/photon"} photon
            (this is the original sense of
            = succeed "," do
              %a{:href => "#Dalitz51"} Dalitz 51
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/radiative+leptonic+decay"} radiative leptonic decay
            %a.existingWikiWord{:href => "/nlab/show/vector+meson"} vector meson
            (a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/semileptonic+decay"} semileptonic decay
          %h3#RadiativeLeptonicDalitzDecay Radiative leptonic Dalitz decay
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+hadrodynamics"} quantum hadrodynamics
            a
            %em Dalitz decay
            in the original sense (
            %a{:href => "#Dalitz51"}> Dalitz 51
            ) is the
            %a.existingWikiWord{:href => "/nlab/show/radiative+leptonic+decay"} radiative leptonic decay
            of an
            %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetically
            neutral
            %a.existingWikiWord{:href => "/nlab/show/pseudoscalar+meson"} pseudoscalar meson
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            into a
            %a.existingWikiWord{:href => "/nlab/show/photon"} photon
            and a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dilepton"} dilepton
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mspace{:width => "thinmathspace"}
                  %mo →
                  %mspace{:width => "thinmathspace"}
                  %mi γ
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi l
                    %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi l
                    %mo −
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P \,\to\, \gamma \,+\, l^+ \,+\, l^-
                  \\,.
          %p
            The dominant contribution to this decay is by a purely radiative decay
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi γ
                  %mo +
                  %mi γ
                %annotation{:encoding => "application/x-tex"} P \to \gamma+ \gamma
            followed by an
            %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo +
                  %msup
                    %mi e
                    %mo +
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msup
                    %mi e
                    %mo −
                %annotation{:encoding => "application/x-tex"} \gamma + e^+ + e^-
            (“Dalitz pair”) of one of the two resulting photons (which thus participates as a
            %a.existingWikiWord{:href => "/nlab/show/virtual+particle"} virtual
            %a.existingWikiWord{:href => "/nlab/show/photon"} photon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi γ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \gamma^\ast
            with
            %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
            %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mn 2
                    %mo =
                    %msubsup
                      %mi m
                      %mrow
                        %msup
                          %mi e
                          %mo +
                        %msup
                          %mi e
                          %mo −
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} q^2 = m^2_{e^+ e^-}
          %div{:style => "margin: 0px 10px 10px 0px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/DalitzDecayPseudoscalarMesonToPhoton.jpg", :width => "320px"}/
              %figcaption{:style => "text-align: center"}
                from
                %a{:href => "#Kunkel12"} Kunkel 12, p. 9
          %p
            The original and archetypical example is the
            %a.existingWikiWord{:href => "/nlab/show/decay"} decay
            of the neutral
            %a.existingWikiWord{:href => "/nlab/show/pion"} pion
            into an
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/electron"} electron
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/positron"} positron
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            and a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/photon"} photon
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi π
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo →
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi e
                    %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi e
                    %mo −
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %mi γ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi^0 \,\to\, e^+ \,+\, e^- \,+\, \gamma
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude"} Feynman amplitude
            of the process is proportional to
          #eq:FeynmanAmplitudedRadiativeDalitzDecay.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϵ
                    %mrow
                      %msub
                        %mi μ
                        %mn 1
                      %msub
                        %mi μ
                        %mn 2
                      %mi ν
                      %mi κ
                  %munder
                    %munder
                      %mrow
                        %msub
                          %mi q
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                        %msub
                          %mi ϵ
                          %mrow
                            %msub
                              %mi μ
                              %mn 2
                      %mo ⏟
                    %mi photon
                  %munder
                    %munder
                      %mrow
                        %msub
                          %mi p
                          %mi ν
                      %mo ⏟
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi scalar
                      %mrow
                        %mi meson
                  %munder
                    %munder
                      %mrow
                        %mover
