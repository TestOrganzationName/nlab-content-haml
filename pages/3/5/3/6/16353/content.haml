                %annotation{:encoding => "application/x-tex"} f \colon  X \longrightarrow \mathbb{R}^1
            with such a path, we obtain a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %msub
                    %mi γ
                    %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mn 1
                  %mo →
                  %msup
                    %mi ℝ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f\circ \gamma_x \;\colon\; \mathbb{R}^1 \to \mathbb{R}^1
            from the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            to itself. Therefore its
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mi v
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %mi γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  (D_v f)(x) \coloneqq  d (f \circ \gamma)_0
          %p
            may be identified with a
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            (measuring the rate of change of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to first order). Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \gamma_x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi x
                    %mo ∈
                    %msub
                      %mi T
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} v_x \in T_x X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi v
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_v f \;\colon\; X \longrightarrow \mathbb{R}^1
                  \\,.
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/product+rule"} product rule
            of differentiation, this assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ↦
                  %msub
                    %mi D
                    %mi v
                  %mi f
                %annotation{:encoding => "application/x-tex"} f \mapsto D_v f
            is such that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f,g \in C^\infty(X)
            two smooth functions, with pointwise product function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ⋅
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \cdot g
            then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi v
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi D
                    %mi v
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi g
                  %mo +
                  %mi f
                  %mo ⋅
                  %msub
                    %mi D
                    %mi v
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D_v(f \cdot g)
                  \\;=\;
                  D_v(f) \cdot g + f \cdot D_v(g)
                  \\,.
          %p
            This means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi v
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D_v \;\colon\; C^\infty(X) \to C^\infty(X)
            is a
            %em
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            on the algebra of smooth functions.
          %p
            Remarkably,
            %em all
            derivations on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X)
            arise this way, and for a unique vector field
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma_X(T X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext derivations on
                        %mtr
                          %mtd
                            %mtext algebra of smooth functions
                        %mtr
                          %mtd
                            %mtext on
                            %mspace{:width => "thinmathspace"}
                            %mi X
                    %mo }
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext smooth
                        %mtr
                          %mtd
                            %mtext tangent vector fields
                        %mtr
                          %mtd
                            %mtext on
                            %mspace{:width => "thinmathspace"}
                            %mi X
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\array{
                  \\text{derivations on}
                  \\\
                  \\text{algebra of smooth functions}
                  \\\
                  \\text{on}\, X
                  }
                  \\right\}
                  \\;\simeq\;
                  \\left\{
                  \\array{
                  \\text{smooth}
                  \\\
                  \\text{tangent vector fields}
                  \\\
                  \\text{on}\, X
                  }
                  \\right\}
          %p
            This is prop.
            %a.maruku-ref{:href => "#Statement"}
            below. What makes this work is the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
            %a{:href => "#Proof"} proof
            below for details.
          %p
            Notice that the concept of derivations is purely a concept of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            and
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            that goes into the definition and construction of smooth manifolds and their tangent bundles. Therefore the identification of smooth vector fields with derivations is an algebraic incarnation of an aspect of differential geometry, an identification comparable two two other such phenomena:
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"} embedding of smooth manifolds into formal duals of R-algebras
                – which identifies smooth manifolds themselves with the
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
                of their real algebras of smooth functions;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} smooth Serre-Swan theorem
                which identifies
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundles"} smooth vector bundles
                over a smooth manifold with the
                %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
                of the algebra of smooth functions.
          %p
            These statements mean that
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            has more in common with
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            than is manifest from the traditional definitions. This serves as the bases for the definition of
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifolds"} formal smooth manifolds
            and the theory of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} geometry of physics – supergeometry
          %p
            Beware however that related algebraic properties familiar from
            %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
            may break in differential geometry: For the
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+forms"} Kähler differential forms
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X)
            to come out as the expected smooth
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            one needs to refine the plain
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X)
            to the structure of a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            %em
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+forms"} Kähler differential forms
            for discussion of this issue.
          %h2#statements Statements
          #Statement.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p Write
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  for its real
                  %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} X \to \mathbb{R}^1
                  (under pointwise multiplication);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Gamma_X(T X)
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                  of smooth
                  %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi X
                      %annotation{:encoding => "application/x-tex"} T X
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
            %p
              1,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Der(C^\infty(X))
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
              of the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
            %p Then:
            %ol
              %li
                %p
                  The operation of
                  %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
                  with respect to a
                  %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\infty(X)
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  arises this way, for a unique vector field.
            %p
              Hence there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D_{(-)}
                    \\;\colon\;
                    \\Gamma_X(T X) \stackrel{\simeq}{\longrightarrow} Der(C^\infty(X))
                    \\,.
          #Proof.proof
            %h6#proof Proof
            %p
              First to discuss that vector fields induce derivations. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma_X(T X)
              be a smooth tangent vector field.
            %p
              This means first of all that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              there is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma_x \;\colon\; \mathbb{R}^1 \longrightarrow X
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi γ
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \gamma_x(0) = x
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi γ
                          %mi x
                        %msub
                          %mo
                          %mn 0
                        %mo =
                        %msub
                          %mi v
                          %mi x
                        %mo ∈
                        %msub
                          %mi T
                          %mi x
                        %mi X
                      %annotation{:encoding => "application/x-tex"} d \gamma_x_0 = v_x \in T_x X
                  \.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msup
                      %mi ℝ
                      %mn 1
