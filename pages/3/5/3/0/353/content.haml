          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#categories_of_categories"}
                  Categories of
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %a{:href => "#defn"} Definitions
