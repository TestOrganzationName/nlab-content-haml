                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sigma[X]
                  \\;=\;
                  \\tfrac{1}{45}
                  \\big(
                  7 p_2
                  \-
                  (p_1)^2
                  \\big)[X]
                  \\,.
          %h3#GStructuresOn8Manifolds G-Structures on 8-Manifolds
          %p
            We state results on
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomological
            %a.existingWikiWord{:href => "/nlab/show/obstructions"} obstructions
            to and characterization of various
            %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            on
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/8-manifolds"} 8-manifolds
          #Spin5StructureOnConnected8Manifolds.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"}> Spin(5)
                \-
                %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/8-manifolds"} 8-manifolds
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/8-manifold"} 8-manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                  %annotation{:encoding => "application/x-tex"} G =
              %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
              if and only if the following conditions are satisfied:
            %ol
              %li
                %p
                  The second and sixth
                  %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
                  (of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mphantom
                          %mi AAA
                        %msub
                          %mi w
                          %mn 6
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        w_2 \;=\; 0
                        \\,,
                        \\phantom{AAA}
                        w_6 \;=\; 0
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                  (of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (hence the
                  %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
                  of
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %a.existingWikiWord{:href => "/nlab/show/I8"} I8
                  evaluated on
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mn 8
                                %mi χ
                                %mo{:stretchy => "false"} [
                                %mi X
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mo =
                                %mn 192
                                %mo ⋅
                                %msub
                                  %mi I
                                  %mn 8
                                %mo{:stretchy => "false"} [
                                %mi X
                                %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mn 4
                                %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                                %msub
                                  %mi p
                                  %mn 2
                                %mo −
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 2
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %msub
                                  %mi p
                                  %mn 1
                                %msup
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mn 2
                                %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                                %mo{:stretchy => "false"} [
                                %mi X
                                %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        8 \chi[X]
                        \&amp;=
                        192 \cdot I_8[X]
                        \\\
                        \&amp; =
                        4
                        \\Big(
                        p_2 - \tfrac{1}{2}\big(p_1\big)^2
                        \\Big)[X]
                        \\end{aligned}
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
                  is divisible by 4:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 4
                        %mi χ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tfrac{1}{4}\chi[X] \;\in\; \mathbb{Z}
                        \\,.
          %p
            (
            %a{:href => "#CadekVanzura97"}> Čadek-Vanžura 97, Corollary 5.5
            )
          %p
            %br/
          #Spin4StructureOnClosed8dSpinManifolds.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"}> Spin(4)
                \-
                %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/8-manifolds"} 8-manifolds
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/8-manifold"} 8-manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                  %annotation{:encoding => "application/x-tex"} G =
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
            #eq:Spin4Structure.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mn 4
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mrow
                                    %mi T
                                    %mi X
                                  %mo ^
                            %mo ↗
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi T
                                %mi X
                          %mtd
                            %mi B
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mn 8
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    B Spin(4)
                    \\\
                    \&amp;
                    {}^{\mathllap{ \widehat{T X} }}
                    \\nearrow
                    \&amp;
                    \\big\downarrow
                    \\\
                    X
                    \&amp;
                    \\underset{T X}{\longrightarrow}
                    \&amp;
                    B Spin(8)
                    }
            %p if and only if the following conditions are satisfied:
            %ol
              %li
                %p
                  the sixth
                  %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  vanishes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 6
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        w_6(T X) \;=\; 0
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  vanishes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi χ
                          %mn 8
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\chi_8(T X)
                        \\;=\;
                        0
              %li
                %p
                  the
                  = succeed "-term" do
                    %a.existingWikiWord{:href => "/nlab/show/I8"} I8
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is divisible as:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 32
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %msub
                          %mi p
                          %mn 2
                        %mo −
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi p
                          %mn 1
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"}
                        \\tfrac{1}{32}
                        \\Big(
                        p_2
                        \-
                        \\big(
                        \\tfrac{1}{2}
                        \\big(
                        p_1
                        \\big)^2
                        \\big)
                        \\Big)
                        \\;\in\;
                        \\mathbb{Z}
              %li
                %p
                  there
                  %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} exists
                  an
                  %a.existingWikiWord{:href => "/nlab/show/integer"} integer
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} k \in \mathbb{Z}
                  such that
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi p
                              %mn 2
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi k
                            %mo −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %msup
                              %mrow
                                %mo (
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 2
                                %msub
                                  %mi p
                                  %mn 1
                                %mo )
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} p_2 = (2k - 1)^2 \left( \tfrac{1}{2} p_1 \right)^2
                      ;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 3
                            %mi k
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo +
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi p
                              %mn 2
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi ℤ
                          %annotation{:encoding => "application/x-tex"} \tfrac{1}{3} k (k+2) p_2[X] \;\in\; \mathbb{Z}
                      \.
            %p
              Moreover, in this case we have for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi T
                        %mi X
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{T X}
              a given
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
              as in
              %a.maruku-eqref{:href => "#eq:Spin4Structure"} (2)
              and setting
            #eq:TildeG4.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi G
                        %mo ˜
                      %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi T
                        %mi X
                      %mo ^
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 4
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde G_4
                    \\;\coloneqq\;
                    \\tfrac{1}{2}
                    \\chi_4(\widehat{T X})
                    +
                    \\tfrac{1}{4}p_1(T X)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \chi_4
              the
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B Spin(4)
              (which is an integral class, by
              = succeed ")" do
                %a{:href => "Spin4#IntegralCohomologyOfClassifyingSpace"} this Prop.
            %p the following relations:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ˜
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} \tilde G_4
                  %a.maruku-eqref{:href => "#eq:TildeG4"} (3)
                  is an integer multiple of the
                  %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontryagin+class"} first fractional Pontryagin class
                  by the factor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  from above:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi G
                            %mo ˜
                          %mn 4
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mi k
                        %mo ⋅
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi p
                          %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\widetilde G_4
                        \\;=\;
                        k \cdot \tfrac{1}{2}p_1
              %li
                %p
                  The (mod-2 reduction followed by) the
                  %a.existingWikiWord{:href => "/nlab/show/Steenrod+operation"} Steenrod operation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Sq
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} Sq^2
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi G
                            %mo ˜
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} \widetilde G_4
                  %a.maruku-eqref{:href => "#eq:TildeG4"} (3)
                  vanishes:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Sq
                          %mn 2
                        %mrow
                          %mo (
                          %msub
                            %mover
                              %mi G
                              %mo ˜
                            %mn 4
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        Sq^2
                        \\left(
                        \\widetilde G_4
                        \\right)
                        \\;=\;
                        0
              %li
                %p
                  the shifted square of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ˜
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} \tilde G_4
                  %a.maruku-eqref{:href => "#eq:TildeG4"} (3)
                  evaluated on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a multiple of 8:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
