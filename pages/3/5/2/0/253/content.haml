          %h2#examples Examples
          %ul
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
                is a bicategory in which the unitors and associator are identities. This includes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/MonCat"} MonCat
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                may be regarded as a bicategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi M
                    %annotation{:encoding => "application/x-tex"} B M
                with a single object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo •
                      %annotation{:encoding => "application/x-tex"} \bullet
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                become 1-cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo •
                      %mo →
                      %mo •
                    %annotation{:encoding => "application/x-tex"} [A]: \bullet \to \bullet
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi M
                      %annotation{:encoding => "application/x-tex"} B M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo •
                    %annotation{:encoding => "application/x-tex"} \bullet
                using the definition
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
