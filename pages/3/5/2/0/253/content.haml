          %h1#bicategories Bicategories
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#detailedDefn"} Details
              %li
