            is a
            %a.existingWikiWord{:href => "/nlab/show/%CF%83-finite+measure+space"} σ-finite measure space
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
