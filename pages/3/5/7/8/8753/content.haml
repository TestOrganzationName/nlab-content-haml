          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    X \colon \Delta^{op} \to \mathcal{C}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              The
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and morphisms between them is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo =
                    %msub
                      %mi Func
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^{\Delta^{op}}
                    \=
                    Func_\infty(\Delta^{op}, \mathcal{C})
                    \\,.
          %p
            For instance (
            %a{:href => "#Lurie"}> Lurie, def. 6.1.2.2
            ).
          .num_remark
            %h6#remark Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
