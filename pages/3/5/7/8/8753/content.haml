                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
          %h2#properties Properties
          %h3#Powering Powering over simplicial sets
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
            %a.existingWikiWord{:href => "/nlab/show/powering"} powering
            of simplicial objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            by simplicial sets.
          #PoweringByLimitOverCategoryOfSimplices.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ∈
                    %mi QCat
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \in QCat \hookrightarrow sSet
              be an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              incarnated as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \colon \Delta^{op} \to \mathcal{C}
              be a simplicial object. Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} K \in sSet
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi op
                    %mo ⟶
                    %msup
                      %mi Δ
                      %mi op
                    %mover
                      %mo ⟶
                      %mi X
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    X[K]
                    \\;\colon\;
                    \\Delta_{/K}^{op}
                    \\longrightarrow
                    \\Delta^{op}
                    \\stackrel{X}{\longrightarrow}
                    \\mathcal{C}
            %p
              for the the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              with the projection from (the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of) the
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplices"} category of simplices
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mo ←
                    %mrow
                      %mo (
                      %msubsup
                        %mi Δ
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi K
                        %mi op
                      %mo ⟶
                      %msup
                        %mi Δ
                        %mi op
                      %mover
                        %mo ⟶
                        %mi X
                      %mi 𝒞
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    X(K)
                    \\;\colon\;
                    \\underset{\leftarrow}{\lim}
                    \\left(
                    \\Delta_{/K}^{op}
                    \\longrightarrow
                    \\Delta^{op}
                    \\stackrel{X}{\longrightarrow}
                    \\mathcal{C}
                    \\right)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              over it (if it exists).
          %p
            This is discussed in (
            %a{:href => "#Lurie"}> Lurie HTT 4.2.3, notation 6.1.2.5
            ). See also around (
            %a{:href => "#LurieGood"}> Lurie 2, notation 1.1.7
            ).
          .num_remark
            %h6#remark_2 Remark
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi nd
                    %mo ↪
                    %msub
                      %mi Δ
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \Delta_{/K}^{nd} \hookrightarrow \Delta_{K}
              of the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on non-degenerate simplicies is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofinal+functor"} homotopy cofinal functor
              (as discussed there). Therefore the
              = succeed "-limit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.maruku-ref{:href => "#PoweringByLimitOverCategoryOfSimplices"}
              may equivalently be taken over this category of non-degenerate simplices.
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %msup
                      %mi Δ
                      %mn 1
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi Δ
                          %mn 0
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} K = \Delta^1 \coprod_{\Delta^0} \Delta^1
              the simplicial set consisting of two consecutive edges, we have for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in \mathcal{C}^{\Delta^\bullet}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi X
                      %mn 1
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X(K) \simeq X_1 \underset{X_0}{\times} X_1
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    X(K)
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X_1 &amp;&amp;&amp;&amp; X_1
                    \\\
                    \&amp; {}_{\mathllap{\partial_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{\partial_0}}
                    \\\
                    \&amp;&amp; X_0
                    }
                    \\,.
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} K = \Delta^n
              itself an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the powering reduces to evaluation on that simplex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X(\Delta^n) \simeq X_n
                    \\,.
            %p
              This is because the
              %a.existingWikiWord{:href => "/nlab/show/category+of+non-degenerate+simplices"} category of non-degenerate simplices
              of an
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              (namely that
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              and the
              = succeed "-limit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              with initial object is given by evaluation at that initial object.
          #EquivalenceOfConeCategoriesAndLimits.num_remark
            %h6#remark_3 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in \mathcal{C}^{\Delta^{op}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K \to K'
              the following are equivalent
            %ol
              %li
                %p
                  the induced morphism of cone
                  = succeed "-categoris" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo{:stretchy => "false"} ]
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo ′
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{X[K]} \to \mathcal{C}_{X[K']}
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              %li
                %p
                  the induced morphism of
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(K) \to X(K')
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          %p
            (The first perspective is used in (
            %a{:href => "#Lurie"}> Lurie
            ), the second in (
            %a{:href => "#Lurie2"}> Lurie2
            ).)
          .proof
            %h6#proof Proof
            %p
              In one direction: the limit is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
              in the cone category, and so is preserved by equivalences of cone categories. (This direction appears as (
              %a{:href => "#Lurie"}> Lurie, prop. 4.1.1.8
              )). Conversely, the limits is the object representing cones, and hence an equivalence of limits induces an equivalence of cone categories.
          #SlicingOverPoweringOfSimplicialObjects.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \colon \Delta^{op} \to \mathcal{C}
              be a simplicial object which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K \to K'
              is a morphism in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              which is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              and a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              %a.existingWikiWord{:href => "/nlab/show/slice-%28%E2%88%9E%2C1%29-categories"} slice-(∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mi K
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mi K
                        %mo ′
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{/X[K]}
                    \\to
                    \\mathcal{C}_{/X[K']}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              (a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            %p
              Equivalently, by remark
              = succeed "," do
                %a.maruku-ref{:href => "#SlicingOverPoweringOfSimplicialObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X(K) \to X(K')
                    \\,.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, prop. 6.1.2.6
            ).
          %h3#cohesion Cohesion
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathcal{C} = \mathbf{H}
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{op}}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "." do
              %em
                %a{:href => "cohesive+%28infinity%2C1%29-topos#SimplicialObjctsInACohesiveTopos"} cohesive (∞,1)-topos - Examples - Simplicial objects
          %h3#internal_language Internal language
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28%E2%88%9E%2C1%29-category"} locally cartesian closed (∞,1)-category
            whose
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{op}}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            %a.existingWikiWord{:href => "/nlab/show/linear+interval"} linear interval
            object. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is additionally an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta^{op}}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
            where the linear interval object exhibits the cohesion of simplicial objects. (…)
          %h3#geometric_realization_and_filtering Geometric realization and filtering
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {\vert X_\bullet \vert}
            of a simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            is, if it exists, the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            over the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X_\bullet \;\colon\; \Delta^{op} \to \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi n
                  %msub
                    %mi X
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {\vert X_\bullet \vert}
                  \\coloneqq
                  \\underset{\longrightarrow}{\lim}_n X_n
                  \\,.
          %p
            Hence the geometric realization of a cosimplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %msup
                    %mi 𝒞
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Delta^{op} \to \mathcal{C}^{op}
            – called its
            %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            – is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \Delta \to \mathcal{C}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleta"} simplicial skeleta
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi sk
                      %mn 0
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi sk
                      %mn 1
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi sk
                      %mn 2
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {\vert sk_0 X_\bullet \vert} \to {\vert sk_1 X_\bullet \vert} \to {\vert sk_2 X_\bullet \vert} \to \cdots
                  \\,.
          %p
            constitutes a
            %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtering
            on the
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            itself
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mo ≃
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi n
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi sk
                      %mi n
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {\vert X_\bullet \vert}
                  \\simeq
                  \\underset{\longrightarrow}{\lim}_n {\vert sk_n X_\bullet \vert}
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
          %h3#doldkan_correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Dold-Kan correspondence
          %p
            The following statement is the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinity-Dold-Kan+correspondence"} infinity-Dold-Kan correspondence
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              of non-negatively graded
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequences
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects+in+an+%28%E2%88%9E%2C1%29-category"} simplicial objects in an (∞,1)-category
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fun(N(\mathbb{Z}_{\geq 0}), C)
                    \\simeq
                    Fun(N(\Delta)^{op}, C)
                    \\,.
            %p
              Under this equivalence, a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is sent to the
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/geometric+realizations"} geometric realizations
              (
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"}> (∞,1)-colimits
              ) of its
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleta"} simplicial skeleta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi sk
                        %mn 0
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi sk
                        %mn 1
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi sk
                        %mn 2
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert sk_0 X_\bullet \vert} \to {\vert sk_1 X_\bullet \vert} \to {\vert sk_2 X_\bullet \vert} \to \cdots
                    \\,.
            %p
              This constitutes a
              %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtering
              on the
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi sk
                        %mi n
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert X_\bullet \vert}
                    \\simeq
                    \\underset{\longrightarrow}{\lim}_n {\vert sk_n X_\bullet \vert}
                    \\,.
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, theorem 1.2.4.1
            )
          %h2#examples Examples
          %h3#internal_category_objects Internal category objects
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/pre-category+object+in+an+%28%E2%88%9E%2C1%29-category"} pre-category object in an (∞,1)-category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is a simplicial object which satisfies the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/category+object+in+an+%28%E2%88%9E%2C1%29-category"} category object in an (∞,1)-category
                is a pre-category object which also satisfies the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
                is a category object all of whose
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are
                %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
                under composition.
