          %h2#in_abelian_sheaf_cohomology In abelian sheaf cohomology
          %p
            Traditionally the cup product is considered for abelian cohomology, such as
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            and more generally
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
          %p
            In that case all coefficient objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} A_i
            are complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} (A_i)_\bullet
            of sheaves and the pairing that one usually considers is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi A
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  (A_1)_\bullet \times (A_2)_\bullet \to (A_1 \otimes A_2)_\bullet
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi A
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %msub
                    %mo ⊕
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi p
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo −
                      %mi p
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (A_1 \otimes A_2)_n = \oplus_p (A_1)_p \otimes (A_2)_{n-p}
                  \\,.
          %p with differential
          .maruku-equation
