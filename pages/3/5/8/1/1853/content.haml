                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mo ∪
                        %mi DK
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Z
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X, DK(V_\bullet)) \times
                  \\mathbf{H}(X, DK(W_\bullet))
                  \\simeq
                  \\mathbf{H}(X, DK(V_\bullet) \times DK(W_\bullet))
                  \\stackrel{\mathbf{H}(X,\cup_{DK})}{\longrightarrow}
                  \\mathbf{H}(X, DK(Z_\bullet))
                  \\,.
          %p For example if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo •
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi n
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi W
                    %mo •
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi n
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  V_\bullet = \mathbb{Z}[n_1]
                  \\,,
                  \\;\;\;
                  W_\bullet = \mathbb{Z}[n_2]
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            concentrated in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mn 1
                %annotation{:encoding => "application/x-tex"} n_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi B
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mi ℤ
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %msub
                    %mi n
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  DK(V_\bullet) \simeq B^{n_1} \mathbb{Z} \simeq K(\mathbb{Z},n_1)
          %p
            is the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            which classifies
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            (
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"}> singular cohomology
            ) with integral coefficients in the given degree. By the nature of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
            one has
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo •
                  %mo ⊗
                  %msub
                    %mi W
                    %mo •
                  %mo ≃
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi n
                    %mn 1
                  %mo +
                  %msub
                    %mi n
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V_\bullet \otimes W_\bullet \simeq \mathbb{Z}[n_1 + n_2]
                  \\,.
          %p
            Hence we may take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mo •
                  %mo ≔
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi n
                    %mn 1
                  %mo +
                  %msub
                    %mi n
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Z_\bullet \coloneqq \mathbb{Z}[n_1 + n_2]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi id
                %annotation{:encoding => "application/x-tex"} f = id
            and we get a cup product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⌣
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi H
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %msub
                        %mi n
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\smile \;\colon\; H^{n_1}(X, \mathbb{Z}) \times H^{n_2}(X, \mathbb{Z})
                  \\to
                  H^{n_1 + n_2}(X, \mathbb{Z})
                  \\,.
          %h3#on_moore_complexes_of_cosimplicial_algebras On Moore complexes of cosimplicial algebras
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = (A^\bullet)
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial algebra
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore cochain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N^\bullet(A)
            naturally inherits the structure of a
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            under the cup product.
          %blockquote
            %p
              The general formula is literally the same as that for the case where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A^\bullet
              is functions on the singular complex of a space, which is discussed below. For the moment, see below.
          %p
            This cup product operation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N^\bullet(A)
            is not in general commutative. However, it is a standard fact that it becomes commutative after passing to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} cochain cohomology
          %p
            This suggests that the cup product should be, while not commutative, homotopy commutative in that it makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N^\bullet(A)
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra+in+an+%28%E2%88%9E%2C1%29-category"} homotopy commutative monoid object
          %p
            This in turn should mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N^\bullet(A)
            is an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-k-operad"} E-∞ operad
          %p
            That this is indeed the case is the main statement in (
            %a{:href => "#BergerFresse01"}> Berger-Fresse 01
            )
          %h3#InSingularCohomology In singular cohomology
          %p
            A special case of the cup product on Moore complexes is the complex of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
          %p
            Often in the literature by
            %em cup product
            is meant specifically the realization of the cup product on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ≔
                  %msup
                    %mi X
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi Top
                        %mo •
                %annotation{:encoding => "application/x-tex"} \Pi(X)_\bullet \coloneqq X^{\Delta_{Top}^\bullet}
            be the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplices
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} Maps(\Pi(X),R)^{\bullet}
            be the
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial ring
            of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-simplices." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore cochain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\bullet(X)
            is the cochain complex whose
            %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} cochain cohomology
            is the
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            of the space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mi p
                  %mo ∈
                  %msup
                    %mi C
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega_p \in C^p(X)
            is a function on
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Write, as usual, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi p
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [p] = \{0 \lt 1 \lt \cdots \lt p\}
            for the
            %a.existingWikiWord{:href => "/nlab/show/poset"} totally ordered set
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p+1
            elements. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo +
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mu : [p] \to [p+q]
            an injective order preserving map and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} cosimplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi d
                    %mi μ
                    %mo *
                  %mi K
                  %mo :
                  %msup
                    %mi K
                    %mi p
                  %mo →
                  %msup
                    %mi K
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                %annotation{:encoding => "application/x-tex"} d_\mu^* K : K^p \to K^{p+q}
            for the image of this map under
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            Specifically, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{N}
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo +
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} L : [p] \to [p+q]
            be the map that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i \in [p]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo +
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i \in [p+q]
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi q
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo +
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R : [q] \to [p+q]
            be the map that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i \in [q]
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo +
                    %mi q
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} i+q \in [p+q]
          %p
            Then the
            %strong cup product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⌣
                  %mo :
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\smile : C^\bullet(X) \otimes C^\bullet(X)
                  \\to C^\bullet(X)
          %p
            is the cochain map that on homogeneous elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo ∈
                  %msup
                    %mi C
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \otimes b \in C^p(X) \otimes C^q(X) \subset C^\bullet(X) \otimes C^\bullet(X)
            is defined by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⌣
                  %mi b
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi d
                    %mi L
                    %mo *
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi d
                    %mi R
                    %mo *
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a \smile b = (d_L^* a) \cdot (d_R^* b)
                  \\,.
          %blockquote
            %p
              There is some glue missing here to connect this back to the above general definition, something involving the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
          %p
            This means that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⌣
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                    %mo =
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi p
                    %mo ⋅
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi i
                          %mi p
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                  %annotation{:encoding => "application/x-tex"} (a \smile b)_{i_0, \cdots, i_{p+q}} = a_{i_0, \cdots, i_p} \cdot b_{i_p, \cdots, i_{p+q}}
          .num_prop
            %h6#proposition Proposition
            %p This cup product enjoys the following properties:
            %ul
              %li
                %p
                  it is indeed a cochain complex morphism as claimed, in that it respects the differential: for any homogeneous
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ⊗
                        %mi b
                        %mo ∈
                        %msup
                          %mi C
                          %mi p
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msup
                          %mi C
                          %mi q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a\otimes b \in C^p(X) \otimes C^q(X)
                  as above we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ⌣
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ⌣
                        %mi b
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi p
                        %mi a
                        %mo ⌣
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d(a \smile b) = (d a) \smile b + (-1)^p a \smile (d b)
                        \\,.
              %li
                %p
                  the image of the cup product on
                  %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} cochain cohomology
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⌣
                        %mo :
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\smile :  H^\bullet(C^\bullet(X))\otimes H^\bullet(C^\bullet(X)) \to H^\bullet(C^\bullet(X))
                %p
                  is associative and distributes over the addition in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi H
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi C
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} H^\bullet(C^\bullet(X))
          %p
            Accordingly, the cup product makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(C^\bullet(X)) = H^\bullet(X,R)
            into a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %strong cohomology ring
            on the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} ordinary cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p See for instance section 3.2 of
          %ul
            %li
              Hatcher,
              %em Algebraic Topology
              (
              %a{:href => "http://www.math.cornell.edu/~hatcher/AT/ATpage.html"} web
              = succeed ")" do
                %a{:href => "http://www.math.cornell.edu/~hatcher/AT/AT.pdf"} pdf
          %h3#CupProductInWhiteheadGeneralizedCohomologyTheory In Whitehead-generalized cohomology
          %p
            For the cup product in
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theories"} Whitehead-generalized cohomology theories
            is defined by the same recipe of “cocycles pre-composed by diagonal and post-composed by product operation”, one just has to observe that
            %span.newWikiWord
              symmetric smash-
              %a{:href => "/nlab/new/symmetric+monoidal+smash+product"} ?
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category+with+diagonals"} monoidal diagonals
            on
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
          #eq:SmashMonoidalDiagonalOnSuspensionSpectra.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
