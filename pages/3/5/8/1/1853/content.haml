                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo{:stretchy => "false"} (
