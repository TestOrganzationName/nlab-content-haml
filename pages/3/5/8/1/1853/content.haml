          %h2#idea Idea
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            that every notion of cohomology (e.g.
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            with coefficients in an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H(X,A) \coloneqq \pi_0 \mathbf{H}(X,A)
                  \\,.
          %p
            The
            %em cup product
            is an operation on cocycles with coefficients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} A_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A_2
            that is induced from a pairing of coefficients given by some morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo ×
                  %msub
                    %mi A
                    %mn 2
                  %mo ⟶
                  %msub
                    %mi A
                    %mn 3
                %annotation{:encoding => "application/x-tex"}
                  A_1 \times A_2 \longrightarrow A_3
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo =
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 = A_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A \times A \to A'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \times A \to A
            for a
            %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 1
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} g_1 : X \to A_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 2
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} g_2 : X \to A_2
            are two cocycles in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A_1)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A_2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi g
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo ,
                      %mi id
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo ×
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo ×
                      %msub
                        %mi g
                        %mn 2
                  %msub
                    %mi A
                    %mn 1
                  %mo ×
                  %msub
                    %mi A
                    %mn 2
                  %mo →
                  %msub
                    %mi A
                    %mn 3
                %annotation{:encoding => "application/x-tex"}
                  g_1 \cdot g_2
                  \\;\coloneqq\;
                  X \stackrel{(id,id)}{\longrightarrow}
                  X \times X
                  \\stackrel{g_1 \times g_2}{\to}
                  A_1 \times A_2
                  \\to
                  A_3
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi A
                    %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A_3)
            obtained by combining the pairing with precomposition by the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
