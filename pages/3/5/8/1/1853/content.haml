                  %a.existingWikiWord{:href => "/nlab/show/Alexander-Whitney+map"} Alexander-Whitney map
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            %li
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \otimes B
                there are canonical natural
                %a.existingWikiWord{:href => "/nlab/show/bilinear+maps"} bilinear maps
                of underlying sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      p_{A,B}
                      \\;\colon\;
                      U(A)\times U(B)
                      \\longrightarrow
                      U(A \otimes B)
          %p Using all this, then for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mo •
                  %mo ⊗
                  %msub
                    %mi W
                    %mo •
                  %mo ⟶
                  %msub
                    %mi Z
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  f \;\colon\; V_\bullet \otimes W_\bullet \longrightarrow Z_\bullet
          %p
            a given
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∪
                    %mi DK
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Z
                    %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\cup_{DK}
                  \\;\colon\;
                  DK(V_\bullet) \times DK(W_\bullet)
                  \\longrightarrow
                  DK(Z_\bullet)
          %p
            as the following
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∪
                    %mi DK
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mo •
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi W
                            %mo •
                          %mo{:stretchy => "false"} )
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
