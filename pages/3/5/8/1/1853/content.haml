                %annotation{:encoding => "application/x-tex"}
                  \\cup_{DK}
                  \\;\colon\;
                  DK(V_\bullet)\times DK(W_\bullet)
                  \=
                  U(\Gamma(V_\bullet)) \times U(\Gamma(W_\bullet))
                  \\stackrel{p_{\Gamma(V_\bullet), \Gamma(W_\bullet)} }{\to}
