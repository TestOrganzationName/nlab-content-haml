                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} W[\neg V[a]]
            is an open set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∩
                  %mi W
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} G\cap W[a] = \emptyset
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi U
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G\cup U[a] = X
          %p It appears to be unknown whether there exist regular uniform spaces that are not uniformly regular. Regularity implies uniform regularity for at least three large classes of uniform spaces: discrete ones, compact ones, and topological groups (plus, trivially, metric and gauge spaces, which are automatically uniformly regular).
          %h3#apartness Apartness
          %p
            Recall that every uniform space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has a
            %a.existingWikiWord{:href => "/nlab/show/inequality+relation"} inequality relation
            (an
            %a.existingWikiWord{:href => "/nlab/show/irreflexive"} irreflexive
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric relation
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x # y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≉
                      %mi U
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \mathbin{&amp;#8777;}_U y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is uniformly regular, then this is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comparison"} comparison
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≉
                      %mi U
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \mathbin{&amp;#8777;}_U z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∘
                  %mi V
                  %mo ⊆
                  %mi U
                %annotation{:encoding => "application/x-tex"} V \circ V \subseteq U
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi W
                    %mo ∪
                    %mi V
                    %mo =
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \neg{W} \cup V = X \times X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo ≈
                    %mi V
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \approx_V y
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %msub
                      %mo ≈
                      %mi V
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y\approx_V z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≉
                    %mi W
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \mathbin{&amp;#8777;}_W y
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %msub
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≉
                      %mi W
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y \mathbin{&amp;#8777;}_W z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo #
                  %mi y
                %annotation{:encoding => "application/x-tex"} x # y
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo #
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y # z
            %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular space
            admits an apartness relation, discussed at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular space
          %h3#locatedness Locatedness
          %p
            Uniform regularity has some nice consequences for the existence of (almost/uniformly)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/located+subsets"} located subsets
          %h3#uniform_apartness_spaces Uniform apartness spaces
          %p
            A uniformly regular uniform space can be equivalently described in terms of the
            %em complements
            of entourages, i.e. by giving notions of when two points are “at least
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            apart” rather than “at least
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            close”.
          .un_defn
            %h6#definition_2 Definition
            %p
              A
              %strong uniform apartness space
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a collection of binary relations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A\subseteq X\times X
              called
              %em anti-entourages
              such that
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∉
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (x,x)\notin A
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
                and anti-entourages
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/irreflexive+relation"} irreflexive
              %li
                For every anti-entourage
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                such that whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (x,z)\in A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ∉
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (y,z)\notin B
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} (x,y)\in B
              %li
                For every anti-entourage
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %msup
                        %mi B
                        %mi op
                    %annotation{:encoding => "application/x-tex"} A\subseteq B^{op}
                (hence, by axiom (6),
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi op
                    %annotation{:encoding => "application/x-tex"} A^{op}
                is an anti-entourage).
              %li There exists an anti-entourage (hence, by axiom (6), the empty set is an anti-entourage).
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                are anti-entourages, so is some superset of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A\cup B
                (hence, by axiom (6),
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A\cup B
                is itself).
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is an anti-entourage and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ⊆
                        %mi A
                      %annotation{:encoding => "application/x-tex"} B\subseteq A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is an anti-entourage.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a uniform space, we can make it a uniform apartness space by declaring the anti-entourages to be the sets contained in the complement of some entourage, i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an anti-entourage if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mo ¬
                  %mi U
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ∖
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \subseteq \neg U = (X\setminus U)
            for some entourage
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∘
                    %mi V
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V\circ V \subseteq U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∉
                  %mi U
                %annotation{:encoding => "application/x-tex"} (x,z)\notin U
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∉
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg((y,z)\notin V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} (x,y)\in V
            we can derive a contradiction by assuming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} (y,z)\in V
            (double negations can be removed constructively when the goal is a contradiction) and obtaining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi U
                %annotation{:encoding => "application/x-tex"} (x,y)\in U
            from
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∘
                    %mi V
                    %mo =
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V\circ V = U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∉
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (x,y)\notin V
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi U
                    %mo ∪
                    %mo ¬
                    %mi V
                    %mo ⊆
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∩
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg U \cup \neg V \subseteq \neg (U\cap V)
          %p
            Thus, any uniform space gives rise to a uniform apartness space. If our original uniform space was uniformly regular, then this uniform apartness space is again “uniformly regular” in the sense that for any anti-entourage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            there is an anti-entourage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                    %mo ∪
                    %mi B
                    %mo =
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \neg A\cup B = X\times X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mo ¬
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A\subseteq \neg U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mo ¬
                  %mi V
                %annotation{:encoding => "application/x-tex"} B = \neg V
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∪
                    %mo ¬
                    %mi V
                    %mo =
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\cup \neg V = X\times X
          %p
            (We note in passing that a uniformly regular uniform apartness space also satisfies a stronger version of axiom (2), namely that for every anti-entourage
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (x,z)\in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            we have either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} (x,y)\in B
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (y,z)\in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as in the standard axiom (2), then let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as in uniform regularity. Now given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (x,z)\in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} (y,z)\in B
            or
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∉
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (y,z)\notin C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} (x,y)\in C
            and hence
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (x,y)\in B
          %p
            In the converse direction, any uniform apartness space gives rise to a uniform space whose entourages are the supersets of the complements of the anti-entourages, and uniform regularity is again preserved. These constructions are not inverse in general, but they are in the uniformly regular case. For this it suffices to show that any entourage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in a uniformly regular uniform space contains the double-complement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mi V
                %annotation{:encoding => "application/x-tex"} \neg\neg V
            of some entourage
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in a uniformly regular uniform apartness space there is an anti-entourage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            containing
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \neg\neg A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∪
                    %mo ¬
                    %mi V
                    %mo =
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\cup \neg V = X\times X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                    %mo ∪
                    %mi B
                    %mo =
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \neg A \cup B = X\times X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We define a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            between uniform apartness spaces to be
            %em uniformly continuous
            if for every anti-entourage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} (f(x),f(y))\in B
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (x,y)\in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Unif
                  %mo →
                  %mi AUnif
                %annotation{:encoding => "application/x-tex"} Unif \to AUnif
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUnif
                    %mo →
                    %mi Unif
                  %annotation{:encoding => "application/x-tex"} AUnif \to Unif
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              The above functors form an
              %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Unif
                    %mo ⇄
                    %mi AUnif
                  %annotation{:encoding => "application/x-tex"} Unif \rightleftarrows AUnif
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
          .proof
            %h6#proof_2 Proof
            %p The unit and counit are the identity functions, which are uniformly continuous since a statement implies its double negation, and obviously satisfy the triangle identities. The adjunction is idempotent since a negated statement is equivalent to its double negation, and we have seen above that uniformly regular spaces are among the fixed points.
