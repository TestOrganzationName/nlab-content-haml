            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/regular+2-category"}> regular 2-category
                ,
                = succeed "," do
                  %span.newWikiWord
                    regular derivator
                    %a{:href => "/nlab/new/regular+derivator"} ?
                %a.existingWikiWord{:href => "/nlab/show/regular+%28%E2%88%9E%2C1%29-category"} regular (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Barr+embedding+theorem"} Barr embedding theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
          %div
