                (see
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hartogs+number"} Hartogs number
                = succeed ")." do
                  %a{:href => "http://mathoverflow.net/questions/12973/does-every-non-empty-set-admit-a-group-structure-in-zf/12988#12988"} this MO answer
            %li#EsoFunctorSplits
              %p
                That every
