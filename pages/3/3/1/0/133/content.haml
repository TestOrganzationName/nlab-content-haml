                      %mo =
                    %annotation{:encoding => "application/x-tex"} L =
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                    %annotation{:encoding => "application/x-tex"} R =
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphisms
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system+on+Set"} weak factorization system on Set
            %li
              %p
                That
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                is equivalent to its own
                = succeed "." do
