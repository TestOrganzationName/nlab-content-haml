                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_f(x, y)
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %li
              for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} a:C
              and element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:D(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi x
                    %mo :
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi id
                          %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_x:Hom_{id_a}(x, x)
            %li
              for each object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} a:C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} b:C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c:C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f:a \to b
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi b
                      %mo →
                      %mi c
                    %annotation{:encoding => "application/x-tex"} g:b \to c
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:D(a)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y:D(b)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} z:D(c)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ∘
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi c
                          %mo ,
                          %mi f
                          %mo ,
                          %mi g
                          %mo ,
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Hom
                        %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Hom
                        %mrow
                          %mi g
                          %mo ∘
                          %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)\circ_{a, b, c, f, g, x, y, z}(-):Hom_g(y, z) \times Hom_f(x, y) \to Hom_{g \circ f}(x, z)
              %p such that
            %li
              for all morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k:Hom_f(x, y)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi id
                        %mi y
                      %mo ∘
                      %mi k
                      %msub
                        %mo =
                        %mo *
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \lambda(k):id_y \circ k =_* k
            %li
              for all morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k:Hom_f(x, y)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi k
                      %mo ∘
                      %msub
                        %mi id
                        %mi x
                      %msub
                        %mo =
                        %mo *
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \rho(k):k \circ id_x =_* k
            %li
              for all morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k:Hom_f(x, y)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                      %mo :
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} l:Hom_f(y, z)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo :
                      %msub
                        %mi Hom
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m:Hom_f(z, w)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ∘
                      %mi l
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi m
                      %msub
                        %mo =
                        %mo *
                      %mi k
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi l
                      %mo ∘
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k \circ l) \circ m =_* k \circ (l \circ m)
          %p …
          %h3#abstract_definition Abstract definition
          %p
            A
            %strong displayed category
            over a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax functor
            from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Span"} Span
          %p
            Better, it is a lax
            %a.existingWikiWord{:href => "/nlab/show/double+functor"} double functor
            from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            “horizontally” with only identity vertical arrows and 2-cells, to the (pseudo) double category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            with sets as objects, functions as vertical arrows, and spans as horizontal arrows. Although this produces an equivalent notion, it is better because a
            %strong displayed functor
            is then a
            %a.existingWikiWord{:href => "/nlab/show/vertical+transformation"} vertical transformation
            between such lax double functors.
          %p
            A displayed category may equivalently be described as a
            %em
              %a.existingWikiWord{:href => "/nlab/show/normal+lax+functor"} normal
            lax functor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
            (either the bicategory or the double category, as appropriate), meaning one that strictly preserves identities. Formally, this is because
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                    %mo =
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi Span
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Prof = Mod(Span)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(-)
            denotes the double category of horizontal monads and modules, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
            is a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the inclusion of
            %a.existingWikiWord{:href => "/nlab/show/virtual+double+categories"} virtual double categories
            and
            %a.existingWikiWord{:href => "/nlab/show/normal+lax+functor"} normal (lax) functors
            into all (lax) functors; see
            = succeed "." do
              %a{:href => "#CS"} (CS, Prop. 5.14)
          %p
            Equivalently, it is a
            %a.existingWikiWord{:href => "/nlab/show/double+profunctor"} double profunctor
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the terminal double category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#correspondence_to_slices Correspondence to slices
          %p
            The category over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            corresponding to a displayed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %mi C
                  %mo →
                  %mi Span
                %annotation{:encoding => "application/x-tex"} D:C\to Span
            is the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi D
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Span
                            %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi Span
                %annotation{:encoding => "application/x-tex"} \array{ D &amp; \to &amp; Span_* \\ \downarrow &amp; &amp; \downarrow \\ C &amp; \to &amp; Span }
          %p
            Where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Span
                    %mo *
                  %mo =
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Set
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span_*=Span(Set_*)
            is the bicategory (or double category) of
            %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
            and pointed spans. This is a strict pullback, which exists in the 2-category of bicategories (or double categories) and lax functors because the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Span
                    %mo *
                  %mo →
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span_* \to Span
            is not just lax but strong. Equivalently, it is the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi D
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Prof
                            %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi Prof
                %annotation{:encoding => "application/x-tex"} \array{ D &amp; \to &amp; Prof_* \\ \downarrow &amp; &amp; \downarrow \\ C &amp; \to &amp; Prof }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Prof
                    %mo *
                %annotation{:encoding => "application/x-tex"} Prof_*
            consists of pointed categories and pointed profunctors, a pointed profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi a
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mi ⇸
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mi b
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H:(A,a_0)&amp;#8696;(B,b_0)
            being equipped with an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo ,
                    %msub
                      %mi b
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(a_0,b_0)
          %p
            This construction induces an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disp
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Disp(C) \to Cat/C
          %ul
            %li
              %p
                A displayed category factors through the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo ↪
                      %mi Span
                    %annotation{:encoding => "application/x-tex"} Set \hookrightarrow Span
                (or equivalently
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                        %mo ↪
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} Set \hookrightarrow Prof
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F:D\to C
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+opfibration"} discrete opfibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{op}
                if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a discrete fibration.
            %li
              %p
                A factorization of a displayed category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} C\to Prof
                through the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Cat
                        %mi op
                      %mo ↪
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Cat^{op} \hookrightarrow Prof
                (as co
                %a.existingWikiWord{:href => "/nlab/show/representable+profunctors"}> representable profunctors
                ) is equivalent to giving
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F:D\to C
                the structure of a
                %a.existingWikiWord{:href => "/nlab/show/cloven+fibration"} cloven
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/prefibred+category"} prefibred category
                %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
                precisely when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F:D\to C
                is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
                of a pseudofunctor.
            %li
              %p
                Similarly, factorizations through
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo ↪
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Cat\hookrightarrow Prof
                corresponds to cloven Grothendieck (pre)opfibrations.
            %li
              %p
                An arbitrary displayed category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} C\to Prof
                is a pseudofunctor if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F:D\to C
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Conduch%C3%A9+functor"} Conduché functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} Cat
          %h3#the_construction_explicitly The construction, explicitly
          %p
            As mentioned above, there is a construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                %annotation{:encoding => "application/x-tex"} \int
            turning a normal lax functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} F:C \to Prof
            into a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi F
                    %mo :
                    %mo ∫
                    %mi F
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi_F : \int F \to C
          %p
            But first, let us explictly remark how the opposite construction works. Using notation from
            = succeed "," do
              %a{:href => "#Benabou"} Benaboù’s lectures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dP
                  %mo :
                  %mi C
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} dP : C \to Prof
            associated to a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi E
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} P:E \to C
            is obtained by ‘taking fibers’. On objects, it maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi C
                %annotation{:encoding => "application/x-tex"} x:C
            to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                %annotation{:encoding => "application/x-tex"} P^{-1}x
            of objects and maps of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            mapping to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and its identity arrow, respectively. On morphisms, it maps an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f:x \to y
            to the profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi y
                    %mi op
                  %mo ×
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} P^{-1}y^{op} \times P^{-1}x \to Set
            mapping a choice of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} y'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ′
                %annotation{:encoding => "application/x-tex"} x'
            ‘lifting’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            respectively to the set of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo ♯
                  %mo :
                  %mi x
                  %mo ′
                  %mo →
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f^\sharp : x'\to y'
            that project down to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "\u2019" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            (which is defined given two objects).
          %h4#the_generalized_grothendieck_construction The generalized Grothendieck construction
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi F
                %annotation{:encoding => "application/x-tex"} \int F
            is built as follows:
          %ul
            %li
              %p
                objects are pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi C
                      %mo ,
                      %mi x
                      %mo ′
                      %mo :
                      %mi Fx
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x:C, x' : Fx)
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,x') \to (y,y')
                is given by a pair of morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %msup
                        %mi f
                        %mo ♯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,f^\sharp)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f:x \to y
                is an arrow in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo ♯
                      %mo ∈
                      %mi Ff
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\sharp \in Ff(y',x')
            %li
              %p
                identities are given by picking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi x
                      %mo :
                      %mi x
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1_x : x \to x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mn 1
                        %mi x
                        %mo ♯
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi x
                          %mo ′
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mn 1
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mi Fx
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1_x^\sharp = 1_{x'} \in F(1_x)(x',x') = \mathrm{Hom}_{Fx}(x',x')
            %li
              %p
                composition is defined componentwise: given
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %msup
                        %mi f
                        %mo ♯
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,f^\sharp) : (x,x') \to (y,y')
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ,
                        %msup
                          %mi g
                          %mo ♯
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo ,
                        %mi z
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (g,g^\sharp):(y,y') \to (z,z')
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi gf
                        %mo ,
                        %msub
                          %mi ℓ
                          %mrow
                            %mi f
                            %mo ,
                            %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo ,
                        %msup
                          %mi f
                          %mo ♯
                        %mo ,
                        %msup
                          %mi g
                          %mo ♯
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (gf, \ell_{f,g}(y', f^\sharp, g^\sharp))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo ,
                      %msup
                        %mi f
                        %mo ♯
                      %mo ,
                      %msup
                        %mi g
                        %mo ♯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (y', f^\sharp, g^\sharp)
                is the equivalence class of the coend defining the composition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fg
                      %mo ∘
                      %mi Ff
                    %annotation{:encoding => "application/x-tex"} Fg \circ Ff
                (see
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                    %annotation{:encoding => "application/x-tex"} \ell_{f,g}
                is the laxator of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
          %p
            Finally, the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi F
                %annotation{:encoding => "application/x-tex"} \pi_F
            simply discards the second component on objects and morphisms.
          %p
            One can readily observe how this construction reduces to the usual
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %h5#on_morphisms On morphisms
          %p
            The above construction is functorial and turns ‘morphisms of normal lax functors into
            = succeed "\u2019" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Cat/C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Dbl
                      %mrow
                        %mi normal
                        %mo ,
                        %mi lax
                      %mi vertical
                    %mo{:stretchy => "false"} (
                    %mi hC
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Dbl_{normal,lax}^{vertical}(hC, Cat)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hC
                %annotation{:encoding => "application/x-tex"} hC
            is the casting of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            This category has as objects normal lax
            %a.existingWikiWord{:href => "/nlab/show/double+functors"} double functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} C \to Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            is the
            %a.existingWikiWord{:href => "/nlab/show/proarrow+equipment"} proarrow equipment
            of categories, functors (in the vertical/tight direction), profunctors (in the horizontal/loose direction) and suitable natural transformations as 2-cells. The morphisms are then
            %a.existingWikiWord{:href => "/nlab/show/vertical+natural+transformations"} vertical natural transformations
            between them.
          %p
            Let’s spell out the definition of one of these vertical natural transformations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \phi : F \Rightarrow G
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi x
                    %mo :
                    %mi Fx
                    %mo →
                    %mi Gx
                  %annotation{:encoding => "application/x-tex"} \phi_x : Fx \to Gx
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x:C
          %div{:style => "text-align: center"}
            %svg{:height => "75.793pt", :version => "1.1", :viewbox => "0 0 98.072 75.793", :width => "98.072pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "TlXjgxNkE_qI1GFE8qrEGj3LPaY=-glyph0-0", :overflow => "visible"}
                    %path{:d => "", :style => "stroke:none;"}
                  %symbol{:id => "TlXjgxNkE_qI1GFE8qrEGj3LPaY=-glyph0-1", :overflow => "visible"}
