                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \mathbf{d} \omega = 0
                      (
                      %a{:href => "#ClosedG2Structure"}> closed
                      )
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msub
                              %mo ⋆
                              %mi g
                            %mi ω
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \mathbf{d} \star_g \omega = 0
                      (co-closed);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mo ∇
                          %mi g
                        %mi ω
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \nabla^g \omega = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,g)
                  has
                  %a.existingWikiWord{:href => "/nlab/show/special+holonomy"} special holonomy
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Hol
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} Hol(g) \subset G_2
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ric
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} Ric(g) = 0
                  (vanishing
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Ricci+curvature"} Ricci curvature
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} R(g) = 0
                  (vanishing
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/scalar+curvature"} scalar curvature
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \tau = 0
                  (vanishing
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of the G2-structure
            %p Here
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                  is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  is the 3-form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
