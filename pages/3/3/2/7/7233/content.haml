                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
                \-manifold
              if the following equivalent conditions hold
            %ol
              %li
                %p we have
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %mi ω
