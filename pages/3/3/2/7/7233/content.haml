                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{R}^7, \phi)
            %p
              The space of second order torsion invariants of
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
