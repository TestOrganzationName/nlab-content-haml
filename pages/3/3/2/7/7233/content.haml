          #G2manifold.num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              A manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              = succeed "," do
                %a.maruku-ref{:href => "#G2Structure"}
