              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ⋆
                          %mi g
                      %annotation{:encoding => "application/x-tex"} \star_g
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
                  of this metric;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∇
                          %mi g
