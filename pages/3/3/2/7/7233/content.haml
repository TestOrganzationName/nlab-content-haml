                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
