              = succeed "," do
                %a.maruku-ref{:href => "#ClosedG2Structure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              by
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 7
                    %munderover
                      %mo ←
                      %mi et
                      %mi f
                    %mi U
                    %munder
                      %mo →
                      %mi et
