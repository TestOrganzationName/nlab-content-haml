                  %annotation{:encoding => "application/x-tex"} (\phi_{a b c})
              the canonical components of the
              %a.existingWikiWord{:href => "/nlab/show/associative+3-form"} associative 3-form
              and with summation over repeated indices understood.
            %p
              By construction this is such that on a
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U_i \subset X)
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/definite+3-form"} definite 3-form
              = succeed "," do
                %a.maruku-ref{:href => "#Definite3Forms"}
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi u
                  %annotation{:encoding => "application/x-tex"} \phi_u
              via a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi Fr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_i \colon U_i \to Fr(X)
              and hence is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mi b
                        %mi c
                    %msubsup
                      %mi E
                      %mi i
                      %mi a
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi b
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{a b c} E_i^a \wedge E_i^b \wedge E_i^c
                    \\,.
            %p
              Conversely, given a 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in \Omega^3(X)
              such that on an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U_i \to X)
              over which the frame bundle trivializes it is of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mi b
                        %mi c
                    %msubsup
                      %mi E
                      %mi i
                      %mi a
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi b
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma|_{U_i} = \phi_{a b c} E_i^a \wedge E_i^b \wedge E_i^c
            %p
              then the
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mn 7
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(7)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} g_{i j}
              of the given local trivialization must factor through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                    %mo ↪
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 7
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 7
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_2\hookrightarrow SO(7) \hookrightarrow GL(7)
              and hence exhibit a
              = succeed "-structure:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo =
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi j
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi on
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \sigma|_{U_i} = \sigma|_{U_j} \;\;\; on \;U_i \cap U_j
              and hence
            #eq:Definite3FormsOnTwoPatches.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mi b
                        %mi c
                    %msubsup
                      %mi E
                      %mi i
                      %mi a
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi b
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi c
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mi b
                        %mi c
                    %msubsup
                      %mi E
                      %mi j
                      %mi a
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi j
                      %mi b
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi j
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi on
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{a b c} E_i^a \wedge E_i^b \wedge E_i^c
                    \=
                    \\phi_{a b c} E_j^a \wedge E_j^b \wedge E_j^c
                    \\;\;\;
                    on \; U_i \cap U_j
                    \\,.
            %p
              But by the nature of the
              = succeed "," do
                %a{:href => "vielbein#InTermsOfBasicFormsOnFrameBundle"} universal vielbein
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi j
                    %mo =
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mi E
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    E_j = g_{i j} E_i
            %p i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mi j
                      %mi a
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %msubsup
                      %mi E
                      %mi i
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    E_j^a = (g_{i j})^a{}_b E_i^b
            %p
              and hence
              %a.maruku-eqref{:href => "#eq:Definite3FormsOnTwoPatches"} (1)
              says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mi b
                        %mi c
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mi a
                        %mo ′
                        %mi b
                        %mo ′
                        %mi c
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo ′
                    %msub
                      %mrow
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi b
                        %mo ′
                    %msub
                      %mrow
                      %mi b
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi c
                        %mo ′
                    %msub
                      %mrow
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi on
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{a b c}
                    \=
                    \\phi_{a' b' c'} (g_{i j})^{a'}{}_a (g_{i j})^{b'}{}_b (g_{i j})^{c'}{}_c
                    \\;\;\;
                    on \; U_i \cap U_j
            %p
              which is precisely the defining condition for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} g_{i j}
              to take values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
            %p
              Viewed this way, the
              %a.existingWikiWord{:href => "/nlab/show/definite+3-forms"} definite 3-forms
              characterizing
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              by locally contracting with a
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
              field. For instance on a
              %a.existingWikiWord{:href => "/nlab/show/super-spacetime"} super-spacetime
              solving the
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              there is a super-4-form part of the
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              of the
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
              which is constrained to be locally of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                        %mi α
                        %mi β
                    %msubsup
                      %mi E
                      %mi i
                      %mi a
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi b
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi α
                    %mo ∧
                    %msubsup
                      %mi E
                      %mi i
                      %mi β
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{a b \alpha \beta} E_i^a \wedge E_i^b \wedge E_i^\alpha \wedge E_i^\beta
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mi a
                    %mo ,
                    %msup
                      %mi E
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mi a
                    %mo ,
                    %msup
                      %mi Ψ
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E^A)= (E^a, E^\alpha) = (E^a, \Psi^\alpha)
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super-vielbein"} super-vielbein
              = succeed "." do
                %em
                  %a{:href => "Green-Schwarz+action+functional#MembraneIn11dSuGraBackground"} Green-Schwarz action functional – Membrane in 11d SuGra Background
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariantly constant
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              = succeed "." do
                %a.maruku-ref{:href => "#G2manifold"}
          %p
            References that write
            %a.existingWikiWord{:href => "/nlab/show/definite+3-forms"} definite 3-forms
            in this form locally as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mi a
                      %mi b
                      %mi c
                  %msup
                    %mi E
                    %mi a
                  %mo ∧
                  %msup
                    %mi E
                    %mi b
                  %mo ∧
                  %msup
                    %mi E
                    %mi c
                %annotation{:encoding => "application/x-tex"} \phi_{a b c}E^a \wedge E^b \wedge E^c
            include (
            %a{:href => "#BGGG01"}> BGGG 01 (2.9)
            , …).
          %p The following is important for the analysis:
          #Definition3FormsGiveOpenSubset.num_remark
            %h6#remark_2 Remark
            %p
              The subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mo +
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 7
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ↪
                    %msup
                      %mi Λ
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 7
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Lambda^3_+(\mathbb{R}^7)^\ast \hookrightarrow \Lambda^3(\mathbb{R}^7)^\ast
              in def.
              %a.maruku-ref{:href => "#Definite3Forms"}
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/stable+form"} stable form
              (e.g.
              = succeed ")." do
                %a{:href => "#Hitchin"} Hitchin, def. 1.1
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Joyce00"} Joyce 00, p. 243
            = succeed ")" do
              %a{:href => "#Bryant05"} Bryant 05, 2.8
          .proof
            %h6#proof Proof
            %p
              By definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              as the
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizer group
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associative+3-form"} associative 3-form
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              it generates under the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mn 7
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_+(7)
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mn 7
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} GL_+(7)/G_2
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              of this as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              is 49-14 = 35. This is however already the full dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mn 7
                        %mrow
                          %mn 3
                      %mo )
                    %mo =
                    %mn 35
                  %annotation{:encoding => "application/x-tex"} \left(7 \atop 3\right) = 35
              of the space of 3-forms in 7d that the orbit sits in. Therefore (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mn 7
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_+(7)/G_2
              does not have a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
          %h3#ClosedG2Structure
            Closed
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
          #ClosedG2Structure.num_defn
            %h6#definition_2 Definition
            %p
              A
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              = succeed "," do
                %a.maruku-ref{:href => "#G2Structure"}
              %em closed
              if the definite 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              corresponding to it via prop.
              %a.maruku-ref{:href => "#G2StructureViaDefinite3Form"}
              is a closed differential form,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi σ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbf{d}\sigma = 0
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Bryant05"} Bryant 05, (4.31)
          #ClosedG2StructureByAtlas.num_prop
            %h6#proposition_2 Proposition
            %p
              For a closed
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
