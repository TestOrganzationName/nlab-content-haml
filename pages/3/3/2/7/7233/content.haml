                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^7 \underoverset{et}{f}{\leftarrow} U \underset{et}{\rightarrow} X
            %p
              such that the globally defined 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
