            whose
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            is
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under the canonical
            %a.existingWikiWord{:href => "/nlab/show/Sp%282%29"} Sp(2)
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            by left-
            %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            on homomogeneous coordinates in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℍ
                    %mn 2
                  %msub
                    %mo ≃
                    %mi ℝ
                  %msup
                    %mi ℂ
                    %mn 4
                  %mo →
                  %mi ℂ
                  %msup
                    %mi P
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{H}^2 \simeq_{\mathbb{R}} \mathbb{C}^4 \to \mathbb{C}P^3
            (
            %a{:href => "metric+cone+over+complex+projective+3-space#BryantSalamon89"}> Byant-Salamon 89
            , see also
            = succeed ")." do
              %a{:href => "metric+cone+over+complex+projective+3-space#AcharyaBryantSalamon20"} Acharya-Bryant-Salamon 20
