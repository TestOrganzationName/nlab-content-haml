                    %mi 𝔾
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c}_{conn} : X \to \mathbf{B}^n \mathbb{G}_{conn}
          %p
            modulates a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              extended
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            in that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi k
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Sigma_{k} \in \mathbf{H}
            of
            %a.existingWikiWord{:href => "/nlab/show/cohomological+dimension"} cohomological dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
