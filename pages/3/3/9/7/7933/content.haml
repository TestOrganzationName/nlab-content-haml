                    %semantics
                      %mrow
                        %mo →
                      %annotation{:encoding => "application/x-tex"} \to
                %th
                  %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
                %td{:style => "text-align: left;"}
                  –
                  %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo →
                      %annotation{:encoding => "application/x-tex"} \to
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/higher+symplectic+geometry"} higher symplectic geometry
                %td{:style => "text-align: left;"}
                  –higher geometric quantization
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo →
                      %annotation{:encoding => "application/x-tex"} \to
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/extended+quantum+field+theory"} extended quantum field theory
          %p
            Being a concept in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            but
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos theory
            (
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"}> cohesive homotopy type theory
            ).
          %p
            In this context, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi 𝔾
                    %mi conn
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{G}_{conn} \in \mathbf{H}
            for the cohesive
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any object to be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of fields or as the
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            for a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi conn
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
