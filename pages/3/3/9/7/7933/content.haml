                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(2 \pi i \int_{\Sigma}_k(-))
            applies, the
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{c}_{conn}
            to low
