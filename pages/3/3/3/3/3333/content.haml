          %h4#AsMappingSpaceObject As a mapping space object
          .num_defn
            %h6#definitionproposition Definition/Proposition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
