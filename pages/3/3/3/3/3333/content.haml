                  %annotation{:encoding => "application/x-tex"} C
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullbacks"} (∞,1)-pullbacks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \in C
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %strong free loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X
              is the
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              along itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℒ
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi Id
                                  %mo ,
                                  %mi Id
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Id
                                %mo ,
                                %mi Id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                            %mo ×
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{L} X &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(Id,Id)}}
                    \\\
                    X &amp;\stackrel{(Id,Id)}{\to}&amp; X \times X
                    }
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              This is the
              = succeed "-categorical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
              of the identity-
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo =
                    %mi Tr
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi Id
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mi Id
