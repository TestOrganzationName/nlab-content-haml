              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi Top
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1_{Top}
