                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}X =
                    Tr
                    \\left(
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{Id}}\swarrow &amp;&amp; \searrow^{\mathrlap{Id}}
                    \\\
                    X &amp;&amp;&amp;&amp; X
                    }
                    \\right)
                    \\,.
          %p
            We can also use the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coequalizer"} homotopy coequalizer
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ⇉
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \rightrightarrows \ast
          .num_defn
            %h6#definition_4 Definition
            %p
              The
              %strong free loop space object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X\in C
              is the homotopy equalizer of two copies of the identity map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⇉
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \rightrightarrows X
          %h3#InHomotopyTypeTheory In homotopy type theory
          %p
            In the literature (see
            = succeed ")" do
              %a{:href => "#References"} below
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            is defined as the homotopy pullback
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\times_{X\times X} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            is a choice of making two points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equal in two ways.” In terms of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            this heuristics becomes a theorem. In that higher categorical logic we have the expression
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi ℒ
                          %mi X
                        %mtd
                          %mo ≔
                          %mrow
                            %mo {
                            %mi x
                            %mo ,
                            %mi y
                            %mo :
                            %mi X
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo =
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi and
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo =
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo }
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mrow
                            %mo {
                            %mi x
                            %mo ,
                            %mi y
                            %mo :
                            %mi X
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathcal{L}X
                  \&amp; \coloneqq
                  \\left\{
                  x,y : X \;|\; (x = y) \, and\, (x = y)
                  \\right\}
                  \\\
                  \&amp; =
                  \\left\{
                  x,y : X \;|\; (x,x) = (y,y)
                  \\right\}
                  \\end{aligned}
                  \\,.
          %p Here on the right we have
          %ol
            %li
              %p
                the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            %li
              %p
                over the
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Id (X \times X)
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/product+type"} product type
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \times X
          %p
            See the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            in the section
            %em
              %a{:href => "http://ncatlab.org/nlab/show/homotopy+pullback#ConstructionInHomotopyTypeTheory"} Construction in homotopy type theory
            for how this is equivalent to the previous definition.
          %p
            Now since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{y:X} (x=y)
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x:X} (x=x)
          %p
            i.e. the type of points that are equal to themselves (in a specified, not necessarily reflexivity, way). This corresponds to the other definitions, as a homotopy equalizer or a powering by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          %h2#properties Properties
          %h3#HomPullModel Models by homotopy pullbacks
          %p
            To see what the definition of a free loop space object amounts to in more detail, assume that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            is modeled by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
          %p
            Then following the discussion at
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            and
            %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
            we can compute the about
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %msubsup
                    %mo ×
                    %mrow
                      %mi X
                      %mo ×
                      %mi X
                    %mi h
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\times_{X\times X}^h X
            as the ordinary
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ℒ
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Id
                                %mo ,
                                %mi Id
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi X
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi I
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi d
                                %mn 0
                              %mo ,
                              %msub
                                %mi d
                                %mn 0
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi d
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi Id
                              %mo ,
                              %mi Id
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{L}X &amp;\to&amp; &amp;\to&amp; X
                  \\\
                  \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{(Id,Id)}}
                  \\\
                  \&amp;&amp; (X \times X)^I &amp;\stackrel{(d_0,d_0)}{\to}&amp; X \times X
                  \\\
                  \\downarrow &amp;&amp;  {}^{\mathllap{(d_1,d_1)}}\downarrow
                  \\\
                  X &amp;\stackrel{(Id,Id)}{\to} &amp;  X \times X
                  \\,,
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi I
                %annotation{:encoding => "application/x-tex"} (X\times X)^I
            is a
            %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times X
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            we may take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi I
                  %mo =
                  %msup
                    %mi X
                    %mi I
                  %mo ×
                  %msup
                    %mi X
                    %mi I
                %annotation{:encoding => "application/x-tex"} (X \times X)^I = X^I \times X^I
            for a
            %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi I
                %annotation{:encoding => "application/x-tex"} X^I
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            From this description one sees that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            is built from
            %em pairs of paths
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coinciding endpoints, that are
            %em glued at their coinciding endpoint
            \. So the loops here are all built from two semi-ciricle paths.
          %h3#RelationToBasedLoops Relation to based loop space object
          %p
            The fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            over a
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : {*} \to X
            is the corresponding (based)
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega_x X
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi ℒ
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Id
                                %mo ,
                                %mi Id
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi Id
                              %mo ,
                              %mi Id
                              %mo{:stretchy => "false"} )
                        %mtd
