                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{L}X \times_X \mathcal{L}X &amp; \to &amp; \mathcal{L} X &amp; \to &amp; X\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow \\
                  \\mathcal{L} X &amp; \to &amp; X &amp; \to &amp; X\times X \\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{id} \\
                  X &amp; \to &amp; X\times X &amp; \xrightarrow{id} &amp; X\times X
                  }
          %p
            Here the bottom-left and top-right squares are the pullback defining
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %msub
                      %mo ×
                      %mi X
                    %mi ℒ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X \times_X\mathcal{L}X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %msub
                      %mo ×
                      %mi X
                    %mi ℒ
                    %mi X
                    %mo →
                    %mi ℒ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X \times_X \mathcal{L}X\to \mathcal{L}X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                  %mo →
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X\to \mathcal{L}X
            comes from transposing its defining pullback square and factoring it through itself.
          %p
            Now consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y\to X
            an object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X \times_X Y \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            but a homotopy witnessing that a certain triangle commutes, which is equivalently the homotopy in the left-hand commutative square below (which is the pullback defining
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %msub
                      %mo ×
                      %mi X
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X \times_X Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ℒ
                          %mi X
                          %msub
                            %mo ×
                            %mi X
                          %mi Y
                        %mtd
                          %mo →
                        %mtd
                          %mi ℒ
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi id
                        %mtd
                          %mi ℒ
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi id
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{ \mathcal{L}X \times_X Y &amp; \to &amp; \mathcal{L} X &amp; \xrightarrow{id} &amp; \mathcal{L}X \\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow \\
                  Y &amp; \to &amp; X &amp; \xrightarrow{id} &amp; X}
          %p
            Pasting this with the right-hand commutative square, which is the canonical automorphism of the projection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X\to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                  %msub
                    %mo ×
                    %mi X
                  %mi Y
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X \times_X Y \to Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} C/X
            (with the same underlying morphism in
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em this
            is the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            The definitiong of the right-hand commutative square above may not be obvious. It is clear when we write
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
