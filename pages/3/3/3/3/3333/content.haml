                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi g
                                  %mn 1
                                %msubsup
                                  %mi g
                                  %mn 2
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mi h
                                  %mn 1
                                %mo ,
