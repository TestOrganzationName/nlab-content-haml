                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
