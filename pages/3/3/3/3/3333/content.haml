            %p
              hence as the universal
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
