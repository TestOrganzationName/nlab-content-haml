                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    * \coprod * &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[1] &amp;\to&amp; \Delta[1]/\partial \Delta[1]
                    }
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              Informally the
              = succeed "-pushout" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo *
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mo *
                    %mo *
                  %annotation{:encoding => "application/x-tex"} * \coprod_{* \coprod *} *
              may be thought of as
            %ul
              %li
                %p
                  the disjoint union of two points
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo *
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} *_1
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo *
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} *_2
              %li
                %p
                  equipped with
                  %em two
                  non-equivalent abstract
                  %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
                  between them
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↗
                                  %msup
                                    %mo ↘
                                    %mpadded{:width => "0"}
                                      %mo ≃
                              %mtr
                                %mtd
                                  %msub
                                    %mo *
                                    %mn 1
                                %mtd
                                %mtd
                                  %msub
                                    %mo *
                                    %mn 2
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↘
                                  %msub
                                    %mo ↗
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mo ≃
                          %mo }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        S^1
                        \=
                        \\left\{
                        \\array{
                        \&amp; \nearrow \searrow^{\mathrlap{\simeq}}
                        \\\
                        *_1 &amp;&amp; *_2
                        \\\
                        \&amp; \searrow \nearrow_{\mathllap{\simeq}}
                        }
                        \\right\}
                        \\,.
            %p
              This equivalent way of modelling the circle not as a single point with an automorphism, but as two points with two isomorphisms is what connects directly to the definition of the free loop space object. This we now come to. It is also the fundamenal source of the basic structure of
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild (co)homology
              (as discussed there).
          %p
          .num_lemma
            %h6 Lemma
            %p
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+%28%E2%88%9E%2C1%29-category"} cartesian closed (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,-] : \mathbf{H} \to \mathbf{H}
                    \\,.
            %p
          .proof
            %h6#proof_2 Proof
            %p
              This is discussed at
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              in the section
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/(infinity,1)-topos#ClosedMonoidalStructure"} Closed monoidal structure
          .num_prop
            %h6#proposition Proposition
            %p
              There is a natural
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}X \simeq [S^1 , X]
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              This follows from the above by the fact (see
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/(infinity%2C1)-topos#ClosedMonoidalStructure"} closed monoidal structure on (∞,1)-toposes
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [*,X] \simeq X
                    \\,.
            %p This yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mo *
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mo *
                            %mo *
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mo ×
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mo *
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mo *
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi X
                            %msub
                              %mo ×
                              %mrow
                                %mi X
                                %mo ×
                                %mi X
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi ℒ
                            %mi X
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [S^1 ,X] &amp;\simeq [* \coprod_{* \coprod *} *, X]
                    \\\
                    \&amp; \simeq
                    [*,X] \times_{[* \coprod *, X]} [*,X]
                    \\\
                    \&amp; \simeq X \times_{X \times X} X
                    \\\
                    \&amp; \simeq \mathcal{L}X
                    \\,.
                    \\end{aligned}
          .num_prop
            %h6#corollary Corollary
            %p
              We have that the free loop space object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is equivalently the
              %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#Tensoring"} powering
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo ≃
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L} X \simeq X^{S^1}
          .proof
            %h6#proof_4 Proof
            %p
              Follows by the above from the equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi LConst
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} [LConst S^1 , X] \simeq X^{S^1}
              discussed at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %h4#CircleAction Intrinsic circle action
          %p
            By precomposition, the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            acts on free loop space of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %msup
                    %mi S
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mo ∘
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Aut(S^1) \times [S^1, X]
                  \\to
                  [S^1, S^1] \times [S^1, X] \stackrel{\circ}{\to} [S^1, X]
                  \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The connected component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S^1,S^1]
              on the identity is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %msup
                      %mi S
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Id
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    [S^1 , S^1]_{Id} \simeq S^1
          .num_defn
            %h6#definition_5 Definition
            %p We say that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %msup
                      %mi S
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Id
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo ∘
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \times [S^1, X]
                    \\simeq
                    [S^1, S^1]_{Id} \times [S^1, X]
                    \\stackrel{\circ}{\to}
                    [S^1, X]
            %p
              is the intrinsic
              %strong circle action
              on the free loop space object.
          .proof
            %h6#proof_5 Proof
            %p
              We spell out in detail what this action looks like. The reader should thoughout keep the
              = succeed "-equivalence," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Π
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} (|-| \dashv \Pi) : Top \simeq \infty Grpd
              in mind.
            %p
              We may realize the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S^1 \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi Top
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi : Top \simeq \infty Grpd
              as the [delooping]]
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
              of the additive
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
              of this object is the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{Grpd}(\mathbf{B}\mathbb{Z})
            %p
              whose
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z} \to \mathbf{B}\mathbb{Z}
              and whose
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %p
              The functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z} \to \mathbf{B}\mathbb{Z}
              correspond bijectively to group
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo →
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n\in\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    [n] : \mathbf{B}\mathbb{Z} \to \mathbf{B}\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mover
                      %mo →
                      %mi k
                    %mo •
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mover
                      %mo →
                      %mrow
                        %mi n
                        %mo ⋅
                        %mi k
                    %mo •
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\bullet \stackrel{k}{\to} \bullet) \mapsto (\bullet \stackrel{n\cdot k}{\to} \bullet).
            %p
              Natural transformations between two such endomorphisms are given by a component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \ell \in \mathbb{Z}
              such that all diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mi ℓ
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi n
                                  %mo ⋅
                                  %mi k
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi n
                                  %mo ′
                                  %mo ⋅
                                  %mi k
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mi ℓ
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bullet &amp;\stackrel{\ell}{\to}&amp; \bullet
                    \\\
                    {}^{\mathllap{n\cdot k}}\downarrow &amp;&amp; \downarrow^{\mathrlap{n' \cdot k}}
                    \\\
                    \\bullet &amp;\stackrel{\ell}{\to}&amp; \bullet
                    }
            %p
              commute in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mi n
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} n = n'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
            %p In other words we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mi ℤ
                          %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aut(\mathbf{B}\mathbb{Z}) \simeq
                    \\coprod_{[n] \in \mathbb{Z}^\times}\mathbf{B}\mathbb{Z}
                    \\,.
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mi Id
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{Id}(\mathbf{B}\mathbb{Z}) \simeq \mathbf{B}\mathbb{Z}
                    \\,.
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              corresponds to the self-mapping of the circle that fixes the basepoint and has winding number
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n\in\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              corresponds then to a rigid rotation of the loop by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              full circles
            %p
              Notably for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              we may think of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mi ℓ
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 1
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mi ℓ
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bullet &amp;\stackrel{\ell}{\to}&amp; \bullet
                    \\\
                    {}^{\mathllap{1}}\downarrow &amp;&amp; \downarrow^{\mathrlap{1}}
                    \\\
                    \\bullet &amp;\stackrel{\ell}{\to}&amp; \bullet
                    }
            %p
              as depicting the unit loop around the circle (on the left, say) and the result of translating its basepoint
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              with a single object here, every rotation of the loop is a full circle rotation, which is a bit hard to see.
          %blockquote
            %p
