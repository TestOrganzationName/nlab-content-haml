                    %mn ∞
                    %mi Grpd
                    %mover
                      %mo ↪
                      %mi LConst
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \in Top \simeq \infty Grpd \stackrel{LConst}{\hookrightarrow} \mathbf{H}
            %p
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              this is the usual topological circle. In
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              this is (the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of) the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              of the topological circle. We may think of this as the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushout"} (∞,1)-pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
