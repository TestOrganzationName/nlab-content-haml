                      %mi c
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 3
                      %mn 2
                  %mi ϕ
                  %msub
                    %mi T
                    %mrow
                      %mi a
                      %mi b
                      %mi c
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                      %mn 4
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                      %mi c
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mi β
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi χ
                    %mi α
                  %msup
                    %mi χ
                    %mi β
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_{a b c} = - \tfrac{3}{2} \phi T_{a b c} + \tfrac{c_1}{4} (\Gamma_{a b c})_{\alpha \beta} tr(\chi^\alpha \chi^\beta)
            (
            %a{:href => "#AtickDharRatra86"}> Atick-Dhar-Ratra 86, (4.22)
            )
          %p
            According to (
            %a{:href => "#BonoraBregolaLechnerPastiTonin90"}> Bonora-Bregola-Lechner-Pasti-Tonin 90
            ) in fact all these constraints follow from just
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mrow
                        %mi α
                        %mi β
                      %mi a
                    %mo ∝
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi α
                        %mi β
                      %mi a
                  %annotation{:encoding => "application/x-tex"} T^a_{\alpha \beta}  \propto \Gamma^a_{\alpha \beta}
          %p
            See also at
            = succeed "." do
