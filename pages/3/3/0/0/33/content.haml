          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#variants"} Variants
              %ul
                %li
                  %a{:href => "#as_a_section_of_decategorification"} As a section of decategorification
                %ul
                  %li
                    %a{:href => "#examples"} Examples
                %li
                  %a{:href => "#as_internalization_in_"}
                    As internalization in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mi Cat
                        %annotation{:encoding => "application/x-tex"} n Cat
                %ul
                  %li
                    %a{:href => "#examples_2"} Examples
