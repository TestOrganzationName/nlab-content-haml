            %p
              meaning that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_A
              using exclusive disjunction implies the disjunction-untruncated
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
