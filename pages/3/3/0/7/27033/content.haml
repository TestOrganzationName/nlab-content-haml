                      %mo =
                      %mrow
                        %mi A
                        %mo +
                        %mi B
                    %mi y
                  %annotation{:encoding => "application/x-tex"} A \underline{\vee} B \coloneqq \sum_{x:A + B} \prod_{y:A + B} x =_{A + B} y
            %p The first projection function of the dependent sum types yields a function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
