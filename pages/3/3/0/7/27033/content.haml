                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x \mapsto 1)(x) = (x \mapsto 0)(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              and thus a decidable subsingleton, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ↦
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ↦
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \mapsto 1) = (x \mapsto 0)
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            %p This exhausts all options for decidable subsingletons, and exhausts all possible conditions in the hypothesis.
          %h3#universe_of_types_satisfying_lpo Universe of types satisfying LPO
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            which satisfy the limited principle of omniscience:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi{:mathvariant => "normal"} LPO
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi x
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} bool
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi{:mathvariant => "normal"} bool
                    %mn 0
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  U_\mathrm{LPO} \coloneqq \sum_{A:U} \prod_{f:T(A) \to \mathrm{bool}} (\exists x:T(A).f(x) =_{\mathrm{bool}} 1) \vee
                  \\left(\prod_{x:T(A)} f(x) =_{\mathrm{bool}} 0\right)
          %p Since the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi x
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} bool
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi{:mathvariant => "normal"} bool
                    %mn 0
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{f:T(A) \to \mathrm{bool}} (\exists x:T(A).f(x) =_{\mathrm{bool}} 1) \vee
                  \\left(\prod_{x:T(A)} f(x) =_{\mathrm{bool}} 0\right)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A:U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi{:mathvariant => "normal"} LPO
                %annotation{:encoding => "application/x-tex"} U_\mathrm{LPO}
            is a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/subtype"} sub
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %h2#in_the_internal_logic In the internal logic
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/injections"} injections
          %ul
            %li
              %p
                An internal
                %em
                  %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
                is a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                such that for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} y \in A
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x = y
            %li
              %p
                The internal proposition
                %em
                  %a.existingWikiWord{:href => "/nlab/show/true"} true
                is a
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                      %annotation{:encoding => "application/x-tex"} \top
            %li
              %p
                The internal proposition
                %em
                  %a.existingWikiWord{:href => "/nlab/show/false"} false
                is the
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %li
              %p
                The internal conjunction of two internal propositions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                is the
                %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ×
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} P \times Q
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
            %li
              %p
                The internal disjunction of two internal propositions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                is the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of the
                %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} unique
                function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo !
                        %mrow
                          %mi P
                          %mo ⊎
                          %mi Q
                      %mo :
                      %mi P
                      %mo ⊎
                      %mi Q
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} !_{P \uplus Q}:P \uplus Q \to 1
                from the
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                to the
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                      %annotation{:encoding => "application/x-tex"} \top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∨
                  %mi Q
                  %mo =
                  %mi{:mathvariant => "normal"} im
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo !
                    %mrow
                      %mi P
                      %mo ⊎
                      %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P \vee Q = \mathrm{im}(!_{P \uplus Q})
          %ul
            %li
              %p
                The internal implication of two internal propositions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                is the
                %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} P \to Q
                between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
            %li
              %p
                The internal negation of an internal proposition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is the function set from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                to the
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                  %mo =
                  %mi P
                  %mo →
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \neg P = P \to \emptyset
          %ul
            %li
              %p
                An internal proposition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is a
                %a.existingWikiWord{:href => "/nlab/show/decidable+proposition"} decidable proposition
                if it comes with a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mi P
                      %mo :
                      %mi P
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \chi_P:P \to 2
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                to the
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
            %li
              %p
                An
                %em internal predicate
                on a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                with
                %a.existingWikiWord{:href => "/nlab/show/injection"} injection
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %mi P
                        %mo ↪
                        %mi A
                      %annotation{:encoding => "application/x-tex"} i:P \hookrightarrow A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
                is represented by the
                %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i^*(x)
            %li
              %p
                The internal
                %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
                of an internal predicate
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi P
                      %mo ↪
                      %mi A
                    %annotation{:encoding => "application/x-tex"} i:P \hookrightarrow A
                is the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of the
                %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} unique
                function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo !
                        %mi P
                      %mo :
                      %mi P
                      %mo →
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} !_P:P \to \top
                into the singleton
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                      %annotation{:encoding => "application/x-tex"} \top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∃
                    %mi A
                  %mi P
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo !
                    %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists_A P = \im(!_P)
          %ul
            %li
              The internal
              %a.existingWikiWord{:href => "/nlab/show/universal+quantifier"} universal quantifier
              of an internal predicate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi P
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} i:P \hookrightarrow A
              is the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              of the preimages
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∀
                    %mi A
                  %mi P
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %msup
                    %mi P
                    %mi A
                  %mo{:stretchy => "false"} |
                  %mo ∀
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \forall_A P = \{f \in P^A \vert \forall x \in A, f(x) \in i^*(x) \}
          %ul
            %li
              An internal predicate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi P
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} i:P \hookrightarrow A
              is a
              %a.existingWikiWord{:href => "/nlab/show/decidable+proposition"} decidable proposition
              if it comes with a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_P(x):i^*(x) \to 2
              into the
              %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
              for all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi P
                    %mo :
                    %mi A
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \chi_P:A \to 2
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the
              %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
          %p
            Then the
            %strong internal LPO
            for a
            %a.existingWikiWord{:href => "/nlab/show/family+of+sets"} family of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi z
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi z
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (A_z)_{z \in I}
            is the LPO for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi z
                %annotation{:encoding => "application/x-tex"} A_z
            stated in the internal logic of the set theory:
          %ul
            %li
              For any internal predicate
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi P
                      %mo ↪
                      %msub
                        %mi A
                        %mi z
                    %annotation{:encoding => "application/x-tex"} i:P \hookrightarrow A_z
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mi P
                      %mo :
                      %msub
                        %mi A
                        %mi z
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \chi_P:A_z \to 2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi A
                          %mi z
                    %mi P
                    %mo =
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo !
                      %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_{A_z} P = \im(!_P)
              has a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi A
                          %mi z
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} (\exists_{A_z} P) \to 2
              into the boolean domain.
          %p or equivalently, as
          %ul
            %li
              For any function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %msub
                        %mi A
                        %mi z
                      %mo →
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} a:A_z \to 2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %msub
                        %mi A
                        %mi z
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} P = \{x \in A_z \vert a(x) = 1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi A
                          %mi z
                    %mi P
                    %mo =
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo !
                      %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_{A_z} P = \im(!_P)
              has a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi A
                          %mi z
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} (\exists_{A_z} P) \to 2
              into the boolean domain.
          %p
            In particular, the internal LPO for the family of all
            %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
            is internal excluded middle. Similarly, given a
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is excluded middle in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            The internal versions of the limited principles of omniscience, like all internal versions of axioms, are weaker than the external version of the limited principle of omniscience, since while
            %a.existingWikiWord{:href => "/nlab/show/bounded+separation"} bounded separation
            implies that one can convert any external predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ⊢
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \in A \vdash P(x)
            on a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to an internal predicate
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \{x \in A \vert P(x)\} \hookrightarrow A
          %h2#lpo_for_the_natural_numbers LPO for the natural numbers
          %p
            The term “limited principle of omniscience”, without any specification of the set for which LPO holds, usually refers to the limited principle of omniscience for the natural numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
          %p
            The limited principle of omniscience for the natural numbers is also called
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
                for
                %a.existingWikiWord{:href => "/nlab/show/semidecidable+truth+values"} semidecidable truth values
            %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
            of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi n
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \exists n, f(n) = 1
            for some
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/boolean"} boolean
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℕ
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{N}\to \mathbf{2}
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mn 1
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Sigma^0_1
              \-
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            (
            %a{:href => "#Diener18"}> Diener 2018
            ) in the sense of the
            %span.newWikiWord
              arithmetical hierarchy
              %a{:href => "/nlab/new/arithmetical+hierarchy"} ?
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/computability+theory"} computability theory
          %h3#statements_equivalent_to_
            Statements equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} LPO
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
          %p
            Apart from the equivalent statements stated above for the LPO for a general set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Let us begin with the equivalence of the various truncated versions of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} LPO
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
            with the usual untruncated version of the
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
          %p
          .num_theorem
            %h6 Theorem
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              implies the disjunction-untruncated
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} LPO
                        %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              %br/
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given a sequnece of booleans
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi ℕ
                      %mo →
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{N} \to \mathbb{2}
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at the boolean
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/choice+operator"} choice operator
          %p
          .proof
            %h6 Proof
            %p
              See
              %a{:href => "#Rijke22"} Rijke 2022
              for a proof of the statement in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %p
          .num_theorem
            %h6 Theorem
            %p
              The disjunction-untruncated
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              implies the fully untruncated
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} LPO
                        %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              %br/
          %p
          .proof
            %h6 Proof
            %p …
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              and fully untruncated
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              are equivalent.
          %p
            Next, we have the equivalence of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} LPO
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
            with the
            %a.existingWikiWord{:href => "/nlab/show/analytic+LPO"} analytic LPO
            for various notions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %p
          .num_theorem
            %h6 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/analytic+LPO"} analytic LPO
              for the following sets of real numbers are equivalent to the LPO for the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Escardo-Simpson+real+numbers"} Escardo-Simpson real numbers
              %a.existingWikiWord{:href => "/nlab/show/HoTT+book+real+numbers"} HoTT book real numbers
              = succeed "/" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mi E
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_H
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi Σ
                    %mo ⊆
                    %msub
                      %mi ℝ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_\Sigma \subseteq \mathbb{R}_D
              which are constructed out of
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+cuts"} Dedekind cuts
              valued in the
              %a.existingWikiWord{:href => "/nlab/show/initial+sigma-frame"}
                initial
                = succeed "-frame" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ⊆
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Sigma \subseteq \Omega
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            denote the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/discrete+field"} discrete
            %a.existingWikiWord{:href => "/nlab/show/sequentially+Cauchy+complete"} sequentially Cauchy complete
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+fields"} Archimedean ordered fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            and a
            %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
            %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} up to
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} unique
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} R \in C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ′
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} R' \in C
            there exists a unique
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ′
                %annotation{:encoding => "application/x-tex"} R'
            which is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
          .num_theorem
            %h6 Theorem
            %p
              LPO for the natural numbers holds if and only if there is an object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbb{R} \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty category
          %p
            There are other equivalent statements from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/real+analysis"} real analysis
          %p
          .num_theorem
            %h6 Theorem
            %p
              %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+space"} Sequential compactness
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
              holds if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
              holds.
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every
