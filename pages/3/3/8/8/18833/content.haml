          .proof
            %h6#proof Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              is on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mrow
                        %mo (
                        %msub
                          %mi ℱ
                          %mi loc
                        %mo{:stretchy => "false"} ⟨
                        %mi g
