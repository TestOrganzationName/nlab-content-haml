          .num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
                and powers of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
            %p
              From prop.
              %a.maruku-ref{:href => "#FeynmanPerturbationSeriesAwayFromCoincidingPoints"}
              one deduces that the order in
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
              that a (
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"}> planar
              )
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              contributes to the S-matrix is given (up to a possible offset due to external vertices) by the “number of loops” in the diagram.
            %p
              In the computation of
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              for
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              %a.existingWikiWord{:href => "/nlab/show/particles"} particles
              via
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
              the
              %a.existingWikiWord{:href => "/nlab/show/scattering+matrix"} scattering matrix
              (
              %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"}> Feynman perturbation series
              ) is a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in (the
              %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              and)
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              whose contributions may be labeled by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is a finite labeled
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graph"} graph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              to which this graph contributes is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{ E(\Gamma) - V(\Gamma) }
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} V(\Gamma) \in \mathbb{N}
                  is the number of
                  %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                  of the graph
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} E(\Gamma) \in \mathbb{N}
                  is the number of
                  %a.existingWikiWord{:href => "/nlab/show/edges"} edges
                  in the graph.
            %p This comes about, according to the above, because
            %ol
              %li
                %p
                  the explicit
                  = succeed "-dependence" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℏ
                        %annotation{:encoding => "application/x-tex"} \hbar
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi g
                              %mi ℏ
                          %msub
                            %mi L
                            %mi int
                          %mo )
                        %mo =
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi k
                            %mo ∈
                            %mi ℕ
                        %mfrac
                          %mrow
                            %msup
                              %mi g
                              %mi k
                          %mrow
                            %msup
                              %mi ℏ
                              %mi k
                            %mi k
                            %mo !
                        %mi T
                        %mo{:stretchy => "false"} (
                        %munder
                          %munder
                            %mrow
                              %msub
                                %mi L
                                %mi int
                              %mi ⋯
                              %msub
                                %mi L
                                %mi int
                            %mo ⏟
                          %mrow
                            %mi k
                            %mspace{:width => "thinmathspace"}
                            %mtext factors
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        S\left(\tfrac{g}{\hbar} L_{int} \right)
                        \=
                        \\underset{k \in \mathbb{N}}{\sum} \frac{g^k}{\hbar^k k!} T( \underset{k \, \text{factors}}{\underbrace{L_{int} \cdots L_{int}}} )
              %li
                %p
                  the further
                  = succeed "-dependence" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℏ
                        %annotation{:encoding => "application/x-tex"} \hbar
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T(\cdots)
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi L
                          %mi int
                        %msub
                          %mi L
                          %mi int
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi prod
                        %mo ∘
                        %mi exp
                        %mrow
                          %mo (
                          %mi ℏ
                          %mo ∫
                          %msub
                            %mi ω
                            %mi F
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mfrac
                            %mi δ
                            %mrow
                              %mi δ
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mfrac
                            %mi δ
                            %mrow
                              %mi δ
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi L
                          %mi int
                        %mo ⊗
                        %msub
                          %mi L
                          %mi int
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        T(L_{int} L_{int}) = prod \circ \exp\left( \hbar \int \omega_{F}(x,y) \frac{\delta}{\delta \phi(x)} \otimes \frac{\delta}{\delta \phi(y)}  \right) ( L_{int} \otimes L_{int} )
                        \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \omega_F
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(x)
              the field observable at point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (where we are notationally suppressing the internal degrees of freedom of the fields for simplicity, writing them as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/scalar+fields"} scalar fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              powers).
            %p The resulting terms of the S-matrix series are thus labeled by
            %ol
              %li
                %p
                  the number of factors of the
                  %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mi int
                        %annotation{:encoding => "application/x-tex"} L_{int}
                  %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                  of the corresponding Feynman diagram and hence each contibute with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℏ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \hbar^{-1}
              %li
                %p
                  the number of integrals over the Feynman propagator
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mi F
                        %annotation{:encoding => "application/x-tex"} \omega_F
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℏ
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \hbar^1
            %p
              Now the formula for the
              %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic+of+planar+graphs"} Euler characteristic of planar graphs
              says that the number of regions in a plane that are encircled by edges, the
              %em faces
              here thought of as the number of “loops”, is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo +
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L(\Gamma) =  1 + E(\Gamma) - V(\Gamma)
                    \\,.
            %p
              Hence a planar Feynman diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              contributes with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{L(\Gamma)-1}
                    \\,.
            %p So far this is the discussion for internal edges. An actual scattering matrix element is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi ψ
                      %mi out
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi g
                          %mi ℏ
                      %msub
                        %mi L
                        %mi int
                      %mo )
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi ψ
                      %mi in
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \psi_{out} \vert S\left(\tfrac{g}{\hbar} L_{int} \right)
                    \\vert \psi_{in} \rangle
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi ψ
                      %mi in
                    %mo{:stretchy => "false"} ⟩
                    %mo ∝
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mrow
                            %msup
                              %mi ℏ
                              %mrow
                                %msub
                                  %mi n
                                  %mi in
                    %msup
                      %mi ϕ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msup
                      %mi ϕ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mi in
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi vac
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\vert \psi_{in}\rangle
                    \\propto
                    \\tfrac{1}{\sqrt{\hbar^{n_{in}}}}
                    \\phi^\dagger(k_1) \cdots \phi^\dagger(k_{n_{in}}) \vert vac \rangle
            %p
              is a state of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi in
                  %annotation{:encoding => "application/x-tex"} n_{in}
              free field quanta and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi ψ
                      %mi out
                    %mo{:stretchy => "false"} ⟩
                    %mo ∝
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mrow
                            %msup
                              %mi ℏ
                              %mrow
                                %msub
                                  %mi n
                                  %mi out
                    %msup
                      %mi ϕ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msup
                      %mi ϕ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mi out
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi vac
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\vert \psi_{out}\rangle
                    \\propto
                    \\tfrac{1}{\sqrt{\hbar^{n_{out}}}}
                    \\phi^\dagger(k_1) \cdots \phi^\dagger(k_{n_{out}}) \vert vac \rangle
            %p
              is a state of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi out
                  %annotation{:encoding => "application/x-tex"} n_{out}
              field quanta. The normalization of these states, in view of the commutation relation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi ϕ
                        %mo †
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo ∝
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} [\phi(k), \phi^\dagger(q)] \propto \hbar
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            %p
              This means that an actual
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitude"} scattering amplitude
              given by a
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi ext
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{ext}(\Gamma)
              external vertices scales as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                        %mo +
                        %msub
                          %mi E
                          %mi ext
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{L(\Gamma) - 1 + E_{ext}(\Gamma)/2 }
                    \\,.
            %p
              (For the analogous discussion of the dependence on the actual
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              given by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              = succeed ".)" do
                %a{:href => "Bogoliubov's+formula#PowersInPlancksConstant"} there
        .revisedby
