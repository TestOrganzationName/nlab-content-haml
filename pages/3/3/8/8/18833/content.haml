                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F \star_{\omega_F} G
                    \\;\coloneqq\;
                    prod \circ
                    \\exp\left(
                    \\hbar
                    \\left\langle
                    \\omega_F , \frac{\delta}{\delta \phi} \otimes \frac{\delta}{\delta \phi}
                    \\right\rangle
                    \\right)
                    (F \otimes G)
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
