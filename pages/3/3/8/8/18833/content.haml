          #TimeOrderedProductAwayFromDiagonal.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                away from the diagonal)
            %p
              Restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mrow
                        %mo (
                        %msub
                          %mi ℱ
                          %mi loc
                        %mo{:stretchy => "false"} ⟨
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ⟩
                        %mo )
                      %mi pds
                      %mrow
                        %msup
                          %mo ⊗
                          %mi k
                  %annotation{:encoding => "application/x-tex"} \left(\mathcal{F}_{loc}\langle g,j\rangle\right)^{\otimes^k}_{pds}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TuplesOfCompactlySupportedPolynomialLocalFunctionalsWithPairwiseDisjointSupport"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              that is induced by the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \omega_F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⋆
                      %mrow
                        %msub
                          %mi ω
                          %mi F
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi prod
