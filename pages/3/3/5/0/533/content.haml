                    %li
                      %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#observation"} Observation
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            A
            %em
              strict
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            is a
            %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"} strict omega-category
            all whose
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} k \gt n
            are identities.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} n Cat
            of strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-functors"} n-functors
            between them can also be defined
            %a.existingWikiWord{:href => "/nlab/show/induction"} inductively
            by
          %ul
            %li
              %p
                starting by setting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mi Cat
                      %mo :
                      %mo =
                    %annotation{:encoding => "application/x-tex"} 0 Cat :=
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %li
              %p
                noticing that
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                is canonically a (symmetric, in fact cartesian)
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                such that one can consider
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} categories enriched
                over it;
            %li
              %p
                noticing that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                any
                %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
                and
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
                closed monoidal category, also
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} V Cat
                (the category of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            %li
              %p finally setting, recursively,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mi Cat
                      %mo{:stretchy => "false"} )
                      %mi Cat
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (n+1)Cat := (n Cat) Cat
                      \\,.
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Str
                  %mi ω
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Str\omega Cat
            of strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            of the categories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} n Cat
          %h2#properties Properties
          #GauntStrictNCategories.num_defn
            %h6#definition_2 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str n Cat
              for the 1-
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/strict+n-categories"} strict n-categories
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                    %mo ↪
                    %mi Str
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    Str n Cat_{gaunt} \hookrightarrow  Str n Cat
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on the
              = succeed "," do
                %em
                  gaunt
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
              are the identities.
          %p
            This subcategory was considered in (
            %a{:href => "#Rezk"}> Rezk
            ). The term “gaunt” is due to (
            %a{:href => "#BarwickSchommerPries"}> Barwick, Schommer-Pries
            ). See prop.
            %a.maruku-ref{:href => "#GauntIs0Truncated"}
            below for a characterization intrinsic to
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          #Globes.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
              the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/globe"} globe
              is gaunt,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi k
                      %mo ∈
                      %mi Str
                      %mi n
                      %msub
                        %mi Cat
                        %mi gaunt
                      %mo ↪
                      %mo ∈
                      %mi Str
                      %mi n
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} G_k \in Str n Cat_{gaunt} \hookrightarrow \in Str n Cat
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mrow
                        %mo ≤
                        %mi n
                    %mo ↪
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{G}_{\leq n} \hookrightarrow Str n Cat_{gaunt}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
              on the
              = succeed "-globes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \leq n
            %p
              Being a
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              of a gaunt
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of a globe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi G
                      %mi k
                    %mo ↪
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \partial G_k \hookrightarrow G_k
              is gaunt, i.e. the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G_k
          #Suspension.num_defn
            %h6#definition_3 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi k
                    %mo :
                    %mi Str
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo →
                    %mi Str
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_k : Str (k) Cat \to Str (k+1) Cat
            %p
              for the “categorical suspension” functor which sends a strict
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Str
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi Str
                    %mi k
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \sigma(X) \in Str (k+1) Cat \simeq (Str k Cat)Cat
              which has precisely two objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi id
                        %mi a
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \sigma(C)(a,a) = \{id_a\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi id
                        %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \sigma(C)(b,b) = \{id_b\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \sigma(C)(b,a) = \emptyset
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma(C)(a,b) = C
                    \\,.
          %p
            We usually suppress the subscript
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and write
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mi i
                    %mo =
                    %msub
                      %mi σ
                      %mrow
                        %mi k
                        %mo +
                        %mi i
                    %mo ∘
                    %mi ⋯
                    %mo ∘
                    %msub
                      %mi σ
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ∘
                    %msub
                      %mi σ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \sigma^i = \sigma_{k+i} \circ \cdots \circ \sigma_{k+1} \circ \sigma_k
          .num_example
            %h6#example_2 Example
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/globe"} globe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G_k
              is the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi k
                    %mo =
                    %msup
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G_k = \sigma^k(G_0)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \partial G_k
              of the
              = succeed "-globe" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi G
                      %mi k
                    %mo =
                    %msup
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial G_k = \sigma^k(\emptyset)
                    \\,.
            %p
              Accordingly, the boundary inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi G
                      %mi k
                    %mo ↪
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \partial G_k \hookrightarrow G_k
              is the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo →
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \emptyset \to G_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msub
                      %mi G
                      %mi k
                    %mo ↪
                    %msub
                      %mi G
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo →
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\partial G_k \hookrightarrow G_k) = \sigma^k(\emptyset \to G_0)
                    \\,.
          .num_prop
            %h6#proposition Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                  %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              and in fact a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} locally finitely presentable category
          %p
            (
            %a{:href => "#BarwickSchommerPries"}> B-PS, lemma 3.5
            )
          .num_remark
            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A,B
              two categories, a
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                    %mo ×
                    %mi B
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} A^{op} \times B \to Set
              is equivalently a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %msub
                      %mi G
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} K \to G_1
              equipped with an identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≃
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A \simeq K_0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ≃
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} B \simeq K_1
          %p This motivates the following definition.
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-profunctor
              \/
              = succeed "-correspondence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} K \to G_k
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Str
                      %mi n
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Str n Cat
              = succeed "-correspondences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Str
                      %mi n
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Str n Cat/ G_k
          .num_defn
            %h6#definition_5 Definition
            %p
              The categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}/G_k
              of
              = succeed "-correspondences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
          %p
            (
            %a{:href => "#BarwickSchommerPries"}> B-SP, cor. 5.4
            )
          .num_remark
            %h6#remark Remark
            %p
              By standard facts, in a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
              is cartesian closed precisely if
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along all morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : Y \to X
              with codomain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              preserves
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              the section
              = succeed ")." do
                %em
                  %a{:href => "locally%20cartesian%20closed%20category#EquivalentCharacterizations"} Cartesian closure in terms of base change and dependent product
          .num_example
            %h6#example_3 Example
            %p
              Without the restriction that the codomain of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in the above is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/globe"} globe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str n Cat
              will in general fail to preserves colimits. For a simple example of this, consider the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram in
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow Cat_{(\infty,1)}
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi δ
                                  %mn 1
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mn 0
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi δ
                                  %mn 2
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta[0] &amp;\stackrel{\delta_1}{\to}&amp; \Delta[1]
                    \\\
                    {}^{\mathllap{\delta_0}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\delta_0}}
                    \\\
                    \\Delta[1] &amp;\stackrel{\delta_2}{\to}&amp; \Delta[2]
                    }
                    \\,.
            %p
              Notice that this is indeed also a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushout"} (∞,1)-pushout
              since, by remark
              = succeed "," do
                %a.maruku-ref{:href => "#GauntIs0Truncted"}
            %p
              Regard this canonically as a pushout diagram in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Cat_{/\Delta[2]}
              and consider then the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi δ
                      %mn 1
                      %mo *
                    %mo :
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \delta_1^* : Cat_{/\Delta[1]} \to Cat_{/\Delta[1]}
              along the remaining face
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 1
                      %mo :
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \delta_1 : \Delta[1] \to \Delta[2]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi ∅
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\stackrel{}{\to}&amp; \emptyset
                    \\\
                    {}^{}\downarrow &amp;&amp; \downarrow^{}
                    \\\
                    \\emptyset &amp;\stackrel{}{\to}&amp; \Delta[1]
                    }
                    \\,,
            %p which evidently no longer is a pushout.
          %p
            (See also the discussion
            = succeed ")." do
              %a{:href => "http://golem.ph.utexas.edu/category/2011/11/the_1category_of_ncategories.html#c040335"} here
          #nCatGen.num_defn
            %h6#definition_6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gen
                    %mo ↪
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gaunt
                  %annotation{:encoding => "application/x-tex"}
                    Str n Cat_{gen} \hookrightarrow Str n Cat_{gaunt}
            %p
              for the smallest
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              that
            %ol
              %li
                contains the
                %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mrow
                            %mo ≤
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_{\leq n}
                = succeed ";" do
                  %a.maruku-ref{:href => "#Globes"}
              %li
                is closed under
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Str
                        %mi n
                        %msub
                          %mi Cat
                          %mi gaunt
                      %annotation{:encoding => "application/x-tex"} Str n Cat_{gaunt}
              %li
                has all
                %a.existingWikiWord{:href => "/nlab/show/fiber+products"} fiber products
                over
                %a.existingWikiWord{:href => "/nlab/show/globes"} globes
                (equivalently: such that all
                %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
                over globes have
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/products"} products
          %p
            (
            %a{:href => "#BarwickSchommerPries"}> B-SP, def. 5.6
            )
          .num_example
            %h6#example_4 Example
            %p
              The following categories are naturally
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %msub
                      %mi Cat
                      %mi gen
                  %annotation{:encoding => "application/x-tex"} Str n Cat_{gen}
            %ul
              %li
                %p
                  the
                  = succeed "-fold" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Δ
                            %mrow
                              %mo ×
                              %mi n
                        %annotation{:encoding => "application/x-tex"} \Delta^{\times n}
              %li
                %p
                  the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Theta-category"} Theta-category
          %p
            This is discussed in more detail in
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-category"} (infinity,n)-category
            in
            = succeed "." do
              %em
                %a{:href => "%28infinity,n%29-category#PresentationByThetaSpaces"} Presentation by Theta-spaces and by n-fold Segal spaces
          #FundamentalPushouts.num_defn
            %h6#definition_7 Definition
            %p
              The following
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str n Cat
              we call the
              %strong fundamental pushouts
            %ol
              %li
                %p
                  Gluing two
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/globes"} globes
                  along their
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  gives the boundary of the
                  = succeed "-globle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (k+1)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi k
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mo ∂
                            %msub
                              %mi C
                              %mrow
                                %mi k
                                %mo −
                                %mn 1
                        %msub
                          %mi G
                          %mi k
                        %mo ≃
                        %mo ∂
                        %msub
                          %mi G
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} G_k \coprod_{\partial C_{k-1}} G_k \simeq \partial G_{k+1}
              %li
                %p
                  Gluing two
                  = succeed "-globes" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "-face" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
                  composition of the two globles
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi k
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msub
                              %mi G
                              %mi i
                        %msub
                          %mi G
                          %mi k
                      %annotation{:encoding => "application/x-tex"} G_k \coprod_{G_i} G_k
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                  of globes along non-degenerate morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                        %mo →
                        %msub
                          %mi G
                          %mi i
                      %annotation{:encoding => "application/x-tex"} G_{i+j} \to G_i
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi k
                        %mo →
                        %msub
                          %mi G
                          %mi i
                      %annotation{:encoding => "application/x-tex"} G_{i+k} \to G_i
                  is built from gluing of globes by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi G
                              %mi i
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi k
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msub
                              %mi G
                              %mi i
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi k
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msup
                              %mi σ
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mrow
                                %mi j
                                %mo −
                                %mn 1
                            %mo ×
                            %msub
                              %mi G
                              %mrow
                                %mi k
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi k
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msub
                              %mi G
                              %mi i
                        %msub
                          %mi G
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        G_{i+j} \times_{G_i} G_{i+k}
                        \\simeq
                        (G_{i+j} \coprod_{G_i} G_{i+k}) \coprod_{\sigma^{i+1}(G_{j-1} \times G_{k-1})} (G_{i+k} \coprod_{G_i} G_{i+j})
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/interval+groupoid"} interval groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mover
                          %mo →
                          %mo ≃
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a \stackrel{\simeq}{\to} b)
                  is obtained by forcing in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 3
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[3]
                  the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo →
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (0\to 2)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo →
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (1 \to 3)
                  to be identities and it is equivalent, as an
                  = succeed "-category," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 3
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo{:stretchy => "false"} }
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ∼
                        %msub
                          %mi G
                          %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta[3] \coprod_{\{0,2\} \coprod \{1,3\}} (\Delta[0] \coprod \Delta[0])
                        \\stackrel{\sim}{\to} G_0
                %p and the analog is true for all suspensions of this relation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi σ
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 3
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msup
                              %mi σ
                              %mi k
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo{:stretchy => "false"} }
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %msup
                              %mi σ
                              %mi k
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi G
                          %mi k
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %msub
                          %mi G
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ∼
                        %msub
                          %mi G
                          %mi k
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\sigma^k(\Delta[3]) \coprod_{\sigma^k\{0,2\} \coprod \sigma^k\{1,3\}} (G_k\coprod G_k)
                        \\stackrel{\sim}{\to} G_k
                        \\,.
            %p
              We say a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str n Cat
              %em preserves
              the fundamental pushouts if it preserves the first three classes of pushouts, and if for the last one the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi σ
                          %mi k
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi σ
                          %mi k
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi k
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %msub
                      %mi G
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(\sigma^k(\Delta[3])) \coprod_{i(\sigma^k\{0,2\}) \coprod i(\sigma^k\{1,3\})} (i(G_k \coprod G_k)) \to i(G_k)
              is an equivalence.
          %h2#examples Examples
          %p
            A strict 1-category is just a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} Strict 2-categories
            are important, because the
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+bicategories"} coherence theorem for bicategories
            states that every (“weak”)
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to a strict one, and also because many 2-categories, such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n\ge 3
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semistrict+categories"} semistrict categories
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
          %h2#references References
          %p
            With an eye towards the generalization to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul#Rezk
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em A cartesian presentation of weak n-categories
              (
              %a{:href => "http://arxiv.org/abs/0901.3602"}> arXiv:0901.3602
              )
          %p and in section 2 of
          %ul#BarwickSchommerPries
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Schommer-Pries"} Chris Schommer-Pries
              %em On the Unicity of the Homotopy Theory of Higher Categories
              (
              %a{:href => "http://arxiv.org/abs/1112.0040"}> pdf
              ,
              = succeed ")" do
                %a{:href => "http://prezi.com/w0ykkhh5mxak/the-uniqueness-of-the-homotopy-theory-of-higher-categories/"} unusual slides
