                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"} Nakwoo Kim
                %em Precision Microstate Counting for the Entropy of Wrapped M5-branes
                (
                %a{:href => "https://arxiv.org/abs/1905.01559"}> arXiv:1905.01559
                )
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/volume+conjecture"} volume conjecture
            by combining the 3d/3d correspondence with
            %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT"} AdS/CFT
            in these backgrounds:
          %ul
            %li
              %p
                %a{:href => "#GangKimLee14b"} Gang-Kim-Lee 14b, Section 3.2
            %li
              %p
                %a{:href => "#GangKim18"} Gang-Kim 18, around (21)
          %p
