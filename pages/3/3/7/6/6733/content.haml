            %a.existingWikiWord{:href => "/nlab/show/physical+theory"} theory
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                ,
                = succeed "," do
