                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo }
                          %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_{
                    \\left\{
                    N^{(M2)}_i, N^{(M5)}_i
                    \\right\}_{i}
                    }
              for which
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
