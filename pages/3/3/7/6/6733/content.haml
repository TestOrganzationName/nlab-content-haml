                  %msup
                    %mi ℝ
                    %mn 5
                  %mo ⫽
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1} \times ( \mathbb{R}^5 \sslash (\mathbb{Z}/2) )
            is due to
          %ul
            %li#Witten95
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Five-branes And M-Theory On An Orbifold
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9512219"} arXiv:hep-th/9512219
          %p
            Discussion in terms of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/E11"} E11
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            and
            %a.existingWikiWord{:href => "/nlab/show/current+algebra"} current algebra
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hirotaka+Sugawara"}> Hirotaka Sugawara
                ,
