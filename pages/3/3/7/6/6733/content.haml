              %em M5-branes wrapped on a spindle
              (
              %a{:href => "https://arxiv.org/abs/2105.13344"}> arXiv:2105.13344
              )
          %h3#ReferencesSigmaModelDescription
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            \-Model description
          %p
            The
            = succeed "-type" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+action+functional"} Green-Schwarz action functional
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            of the (single) M5-brane of was found in covariant form in
          %ul
            %li#PST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"}> Paolo Pasti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em
                    Covariant Action for a
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} D=11
                    Five-Brane with the Chiral Field
                %strong 398
                (1997) 41 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9701037"}> arXiv:hep-th/9701037
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(97)00188-3"} doi:10.1016/S0370-2693(97)00188-3
            %li#BLNPST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexei+Nurmagambetov"} Alexei Nurmagambetov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Covariant Action for the Super-Five-Brane of M-Theory
                %strong 78
                (1997) 4332-4334 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9701149"}> arXiv:hep-th/9701149
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevLett.78.4332"} doi:10.1103/PhysRevLett.78.4332
          %p generally following
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"}> Paul Townsend
              , section 3.3 of:
