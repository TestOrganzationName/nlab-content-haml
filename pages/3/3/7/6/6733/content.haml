                      %mfrac
                        %mn 1
                        %mn 24
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{24} p_2
          %ul
            %li#FreedHarveyMinasianMoore98
              %p
