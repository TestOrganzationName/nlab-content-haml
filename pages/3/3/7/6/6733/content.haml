                        %mfrac
                          %mn 1
                          %mrow
                            %msup
                              %mrow
                                %mo (
                                %msqrt
                                  %mrow
                                    %msup
                                      %mrow
                                        %mo (
                                        %msubsup
                                          %mi N
                                          %mi i
                                          %mrow
                                            %mo{:stretchy => "false"} (
