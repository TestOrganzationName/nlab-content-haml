              Dongmin Gang,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"} Nakwoo Kim
              = succeed "," do
                %em Aspects of Defects in 3d-3d Correspondence
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1510.05011"} arXiv:1510.05011
          %h4#wrapped_on_orbifolds Wrapped on orbifolds
          %ul
            %li
