                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0012195"} arXiv:hep-th/0012195
            %li
              %p
                Aristomenis Donos,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"} Jerome Gauntlett
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"} Nakwoo Kim
                = succeed "," do
