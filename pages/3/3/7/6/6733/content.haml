            %li#Schwarz97
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
                ,
                = succeed "," do
                  %em Coupling a Self-Dual Tensor to Gravity in Six Dimensions
                = succeed "," do
                  %a{:href => "http://cds.cern.ch/record/317663"} cds:317663
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(97)00094-4"} doi:10.1016/S0370-2693(97)00094-4
            %li#APPS97a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jaemo+Park"} Jaemo Park
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em World-Volume Action of the M Theory Five-Brane
                %strong 496
                (1997) 191-214 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9701166"}> arXiv:hep-th/9701166
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0550-3213(97)00227-7"} doi:10.1016/S0550-3213(97)00227-7
          %p Discussion of the equivalence of these superficially different action functionals is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Nurmagambetov"} Alexei Nurmagambetov
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
              = succeed "," do
                %em On the equivalence of different formulations of the M Theory five–brane
              %strong 408
              (1997) 135-141 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/9703127"}> arXiv:hep-th/9703127
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0370-2693(97)00784-3"} doi:10.1016/S0370-2693(97)00784-3
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            in
            %a.existingWikiWord{:href => "/nlab/show/super+spacetime"} super spacetime
            were derived in
          %ul
            %li#HoweSezginWest97
              %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
              = succeed "," do
                %em Covariant Field Equations of the M Theory Five-Brane
              %strong 399
              (1997) 49-59 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9702008"}> arXiv:hep-th/9702008
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0370-2693(97)00257-8"} doi:10.1016/S0370-2693(97)00257-8
          %p
            and using the
            %a.existingWikiWord{:href => "/nlab/show/superembedding+approach"} superembedding approach
            in
          %ul
            %li#HoweSezgin97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} D=11
                    ,
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo =
                          %mn 5
                        %annotation{:encoding => "application/x-tex"} p=5
                %strong 394
                (1997) 62-66 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9611008"}> arXiv:hep-th/9611008
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(96)01672-3"} doi:10.1016/S0370-2693(96)01672-3
            %li#Sorokin99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"}> Dmitri Sorokin
                , Section 5.2 of:
                = succeed "," do
                  %em Superbranes and Superembeddings
                %strong 329
                (2000) 1-101 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9906142"}> arXiv:hep-th/9906142
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-1573(99)00104-0"} doi:10.1016/S0370-1573(99)00104-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grigorios+Giotopoulos"}> Grigorios Giotopoulos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                = succeed ":" do
