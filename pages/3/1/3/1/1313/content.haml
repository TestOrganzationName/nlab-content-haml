          %h2#idea Idea
          %p
            An
            %strong exponential object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            is an
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [Y,X]
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            More generally, in a category with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            is a
            %a.existingWikiWord{:href => "/nlab/show/representing+object"} representing object
            for the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ×
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(- \times Y, X)
          %p#YetMoreGenerally
            Yet more generally, an exponential object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/representing+object"} representing object
            for the functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(X)^{y(Y)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒞
                  %mo ⟶
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y \,\colon\, \mathcal{C} \longrightarrow PSh(\mathcal{C})
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            and the latter exponentiation takes place in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
            %em
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"}> closed monoidal structure on presheaves
              ).
          %h2#definition Definition
          %p The above is actually a complete definition, but here we spell it out.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be objects of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that all binary
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            exist. (Usually,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            actually has all binary products.) Then an
            %strong exponential object
            is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            equipped with an
            %strong
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ev
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi X
                    %mi Y
                  %mo ×
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathrm{ev}\colon X^Y \times Y \to X
            which is universal in the sense that, given any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            and map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Z
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} e\colon Z \times Y \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Z
                  %mo →
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} u\colon Z \to X^Y
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ×
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %mi u
                      %mo ×
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi Y
                  %msup
                    %mi X
                    %mi Y
                  %mo ×
                  %mi Y
                  %mover
                    %mo →
                    %mi{:mathvariant => "normal"} ev
                  %mi X
                %annotation{:encoding => "application/x-tex"} Z \times Y \stackrel{u \times \mathrm{id}_Y}\to X^Y \times Y \stackrel{\mathrm{ev}}\to X
          %p
            equals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
          %p
            Equivalently, this data can be repackaged as a natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msup
                    %mi X
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ×
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom_C(-, X^Y) \cong \hom_C(- \times Y, X)
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ev
                %annotation{:encoding => "application/x-tex"} \mathrm{ev}
            is the image of the identity arrow on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} X^Y
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is known by various names, such as the
            %em exponential transpose
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda(e)
            in a hat tip to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lambda-calculus"} lambda-calculus
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of a cartesian closed category this is the operation corresponding to
            = succeed "-abstraction." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mo ♭
                %annotation{:encoding => "application/x-tex"} e^\flat
            (as in music notation), being an instance of the more general notion of
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mate"} mate
          %p
            As with other
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal construction
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} unique up to unique isomorphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distributivity+pullback"} distributivity pullback
          %h3#without_finite_products Without finite products
          %p
            In a category without finite products, an exponential object is given by an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            and a universal natural transformation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msup
                      %mi X
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(-, X^Y) \times C(-, X) \to C(-, Y)
            %a{:href => "https://github.com/punkdit/categories/blob/master/www.mta.ca/cat-dist/archive/2008/08-1#L751-L782"} this
            %a.existingWikiWord{:href => "/nlab/show/categories+mailing+list"} categories mailing list
            post by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"} Richard Garner
          %h2#related_notions Related notions
          %p
            As before, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X,Y\in C
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} X^Y
                exists, then we say that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                %strong exponentiates
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} X^Y
                exists for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is
                %strong exponentiable
                (or
                = succeed "," do
                  %em powerful
                = succeed ")." do
                  %a{:href => "http://www.emis.de/journals/TAC/volumes/23/3/23-03.pdf"} pdf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
                if it has a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                and every object is exponentiable (which requires that all binary products exist too).
            %li
              %p
                More generally, a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f\colon Y \to A
                is
                %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable
                when it is exponentiable in the
                %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} /
                        %mi A
                      %annotation{:encoding => "application/x-tex"} C/A
                %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable morphism
                for more details.
            %li
              %p
                Conversely, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} X^Y
                exists for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is
                = succeed "." do
                  %strong exponentiating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                have all binary products.) Again,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is
                %strong cartesian closed
                if it has a terminal object and every object is exponentiating. (The reader should beware that some authors say “exponentiable” for what is here called “exponentiating.”)
          %p
            Dually, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/coexponential+object"} coexponential object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an exponential object in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
            %strong
              %a.existingWikiWord{:href => "/nlab/show/cocartesian+coclosed+category"} cocartesian coclosed category
            has all of these (and an
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/frames"} frames
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            or
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocartesian+closed+category"} cocartesian closed category
          %p#WhenCIsNotCartesian
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is not cartesian but merely monoidal, then the analogous notion is that of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} left/right internal hom
          %h2#examples Examples
          %p
            Of course, in any cartesian closed category every object is exponentiable and exponentiating. In general, exponentiable objects are more common and important than exponentiating ones, since the existence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Y
                %annotation{:encoding => "application/x-tex"} X^Y
            is usually more related to properties of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            than properties of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#exponentiation_of_sets_and_of_numbers Exponentiation of sets and of numbers
          %p
            In the cartesian closed category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi S
                  %mo ∈
                  %mi Set
                %annotation{:encoding => "application/x-tex"} X,S \in Set
            to sets, their exponentiation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi S
                %annotation{:encoding => "application/x-tex"} X^S
            is the set of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S\to X
          %p
            Restricted to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mo −
                  %mo{:stretchy => "false"} |
                  %mo :
                  %mi FinSet
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} |-| : FinSet \to \mathbb{N}
            this induces an exponentiation operation on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %msup
                      %mi X
                      %mi S
                    %mo |
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left|X^S\right| = |X|^{|S|}
                  \\,.
          %p
            This exponentiation operation on numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} (-)^{(-)} : \mathbb{N} \times \mathbb{N} \to \mathbb{N}
            is therefore the
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            of the canonically defined
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of sets. It sends numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} a,b \in \mathbb{N}
            to the product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mi b
                  %mo =
                  %mi a
                  %mo ×
                  %mi a
                  %mo ×
                  %mi ⋯
                  %mo ×
                  %mi a
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mspace{:width => "thickmathspace"}
                  %mtext factors
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a^b = a \times a \times \cdots \times a \;\; (b \; \text{factors})
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} b = 0
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is the
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            When the natural numbers are embedded into larger
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
          %h3#more_examples More examples
          %ul
            %li
              In
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (the category of
              %em all
              topological spaces), the exponentiable spaces are precisely the
              %a.existingWikiWord{:href => "/nlab/show/core-compact+spaces"} core-compact spaces
              (see
              = succeed ")." do
                %a{:href => "#DayKelly"} Day and Kelly
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              %a.existingWikiWord{:href => "/nlab/show/nice+category+of+spaces"} nice categories of spaces
              are cartesian closed, so that all objects are exponentiable; note that usually the cartesian product in such categories has a slightly different topology than it does in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
          %p
            The condition that a topological space be core-compact (i.e. exponentiable) is in fact a condition on its underlying locale. More precisely, a topological space is core-compact if and only if its underlying locale is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+poset"} continuous poset
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                is exponentiable if and only if it is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+poset"} continuous poset
                (see
                = succeed ")" do
                  %a{:href => "#Hyland"} Hyland
                %em definition
                of a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+locale"} locally compact locale
                %a.existingWikiWord{:href => "/nlab/show/continuous+category"} continuous category
                and
                = succeed "." do
                  %span.newWikiWord
                    continuous ∞-category
                    %a{:href => "/nlab/new/continuous+%E2%88%9E-category"} ?
                %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
                and
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
                which are exponentiable (see
                %span.newWikiWord
                  metastably locally compact locale
                  %a{:href => "/nlab/new/metastably+locally+compact+locale"} ?
                and
                %a.existingWikiWord{:href => "/nlab/show/continuous+category"} continuous category
                as well as
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/exponentiable+topos"} exponentiable topos
            %li
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/algebraic+set+theory"} algebraic set theory
                (see
                %a.existingWikiWord{:href => "/nlab/show/category+with+class+structure"} category with class structure
                for one example) one often assumes that only small objects (and morphisms) are exponentiable. analogous to how in material
                %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
                one can talk about the class of functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Y\to X
                when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is a set and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a class, but not the other way round.
            %li
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
                with
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/context"} context
            %li
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi C
                      %annotation{:encoding => "application/x-tex"} D^C
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mi F
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \alpha:F\to G
                is exponentiable if it is
                %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformation"} cartesian
                and each component
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi c
                      %mo :
                      %mi F
                      %mi c
                      %mo →
                      %mi G
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \alpha_c:F c \to G c
                is exponentiable in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo →
                        %mi F
                      %annotation{:encoding => "application/x-tex"} H\to F
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi α
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi Π
                          %mrow
                            %msub
                              %mi α
                              %mi c
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_\alpha(H)(c) = \Pi_{\alpha_c}(H c)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo :
                      %mi c
                      %mo →
                      %mi c
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} u:c\to c'
                to obtain a map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi α
                            %mi c
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi α
                            %mrow
                              %mi c
                              %mo ′
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_{\alpha_c}(H c) \to \Pi_{\alpha_{c'}}(H c')
                we need a map
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi α
                          %mrow
                            %mi c
                            %mo ′
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mrow
                            %msub
                              %mi α
                              %mi c
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi H
                        %mi c
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \alpha_{c'}^*(\Pi_{\alpha_c}(H c)) \to H c'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                is cartesian,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi α
                          %mrow
                            %mi c
                            %mo ′
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mrow
                            %msub
                              %mi α
                              %mi c
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %msubsup
                          %mi α
                          %mi c
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mrow
                            %msub
                              %mi α
                              %mi c
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha_{c'}^*(\Pi_{\alpha_c}(H c)) \cong \alpha_c^* (\Pi_{\alpha_c}(H c))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi α
                        %mi c
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi α
                            %mi c
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi H
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \alpha_c^* (\Pi_{\alpha_c}(H c)) \to H c
                that we can compose with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mi u
                      %annotation{:encoding => "application/x-tex"} H u
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is small, then all morphisms of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Set^C
                are exponentiable, whether or not they are cartesian.)
          %p However, exponentiating objects do matter sometimes.
          %ul
            %li
              %p
                In
                = succeed "," do
                  %a{:href => "http://www.paultaylor.eu/ASD/"} Abstract Stone Duality
                %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                is exponentiating.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Toby+Bartels"} Toby Bartels
                has
                %a{:href => "http://golem.ph.utexas.edu/category/2009/01/nlab_general_discussion.html#c023187"} argued
                that
                %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
                can have a set of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth value
                = succeed "s)." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %li
              %p
                A
                %span.newWikiWord
                  dialogue category
                  %a{:href => "/nlab/new/dialogue+category"} ?
                is a
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                equipped with the non-cartesian monoidal analogue of an exponentiating object.
          %h2#properties Properties
          %p
            As with other internal homs, the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ,
                  %msup
                    %mi X
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ×
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom_C(Z,X^Y) \cong hom_C(Z \times Y,X)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            of sets. By the usual
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda
            arguments, this isomorphism can be internalized to an isomorphism in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi Y
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi Z
                  %mo ≅
                  %msup
                    %mi X
                    %mrow
                      %mi Y
                      %mo ×
                      %mi Z
                  %mo .
                %annotation{:encoding => "application/x-tex"} (X^Y)^Z \cong X^{Y\times Z}.
          %p
            Similarly,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≅
                    %msup
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X \cong X^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p Other natural isomorphisms that match equations from ordinary algebra include:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Z
                    %mo =
                    %msup
                      %mi X
                      %mi Z
                    %mo ×
                    %msup
                      %mi Y
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} (X \times Y)^Z = X^Z \times Y^Z
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mn 1
                      %mi Z
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1^Z \cong 1
              \.
          %p These show that, in a cartesian monoidal category, a product of exponentiating objects is also exponentiating.
          %p
            Now suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distributive+category"} distributive category
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mi Y
                        %mo +
                        %mi Z
                    %mo ≅
                    %msup
                      %mi X
                      %mi Y
                    %mo ×
                    %msup
                      %mi X
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} X^{Y + Z} \cong X^Y \times X^Z
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 0
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X^0 \cong 1
              \.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo +
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Y + Z
            is a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          %p
            Note that any cartesian closed category with finite coproducts must be distributive, so all of the isomorphisms above hold in any closed
            %a.existingWikiWord{:href => "/nlab/show/2-rig"} 2-rig
            (such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exponential+ideal"} exponential ideal
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exponentiable+topos"} exponentiable topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/reflexive+object"} reflexive object
          %h2#references References
          %p
            Discussion with focus on application to
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
          %ul
            %li#DayKelly
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
                = succeed "," do
                  %em On topological quotients preserved by pullback or products
                %strong 67
                3 (1970) 553 - 558 (
                %a{:href => "https://doi.org/10.1017/S0305004100045850"}> doi:10.1017/S0305004100045850
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Section 7.1 of:
                = succeed "," do
                  %em Categories and Structures
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                %strong 50
                Cambridge University Press (1994) (
                %a{:href => "https://doi.org/10.1017/CBO9780511525865"}> doi:10.1017/CBO9780511525865
                )
          %p
            Discussion for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
          %ul
            %li#Hyland
              %a.existingWikiWord{:href => "/nlab/show/Martin+Hyland"}> Martin Hyland
              ,
              %em Function Spaces in the Category of Locales.
              (
              %a{:href => "https://doi.org/10.1080/00927878108822672"}> doi:10.1080/00927878108822672
              )
          %p
            Discussion for
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoids"} internal groupoids
            in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            (
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"}> topological groupoids
            ):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Susan+B.+Niefield"}> Susan B. Niefield
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dorette+A.+Pronk"} Dorette A. Pronk
              = succeed "," do
                %em Internal groupoids and exponentiability
              %a{:href => "http://cahierstgdc.com/index.php/volume-lx/"}
                %strong LX
                4 (2019)
              (
              %a{:href => "http://cahierstgdc.com/wp-content/uploads/2019/10/Niefield-Pronk-LX-4.pdf"}> pdf
              )
          %p
            Exponentiable
            %a.existingWikiWord{:href => "/nlab/show/relational+structures"} relational structures
            are considered in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jason+Parker"}> Jason Parker
              ,
              %em Exponentiability in categories of relational structures
              (2022) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2208.07350"}> arXiv:2208:07350
              \&amp;rbrack;
