                        \\tilde X
                        \\\
                        {}^{\mathllap{\phi}}\downarrow &amp; \searrow^{\mathrlap{p_i}}
                        \\\
                        \\underset{\longrightarrow}{\lim}_i X_i
                        \&amp;\underset{p_i}{\longrightarrow}&amp;
                        X_i
                        }
              %li
                %p
                  its
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting cocone
                  (or just
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  for short) is, if it exists,
                  %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                  %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi X
                                    %mi i
                                %mtd
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msub
                                        %mi f
                                        %mi α
                                %mtd
                                %mtd
                                  %msub
                                    %mi X
                                    %mi j
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi q
                                          %mi i
                                  %mo ↘
                                %mtd
                                %mtd
                                  %msup
                                    %mo ↙
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi q
                                          %mi j
                              %mtr
                                %mtd
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %msub
                                    %munder
                                      %mi lim
                                      %mo ⟶
                                    %mi i
                                  %msub
                                    %mi X
                                    %mi i
                          %mo }
                      %annotation{:encoding => "application/x-tex"}
                        \\left\{
                        \\array{
                        X_i
                        \&amp;&amp; \underset{f_\alpha}{\longrightarrow} &amp;&amp;
                        X_j
                        \\\
                        \&amp; {}^{\mathllap{q_i}}\searrow &amp;&amp; \swarrow^{\mathrlap{q_j}}
                        \\\
                        \\\
                        \&amp;&amp; \underset{\longrightarrow}{\lim}_i X_i
                        }
                        \\right\}
                %p
                  under this diagram (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Cone"}
                  %em universal
                  or
                  %em initial
                  among all possible co-cones, in that it has the property that for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi X
                                    %mi i
                                %mtd
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msub
                                        %mi f
                                        %mi α
                                %mtd
                                %mtd
                                  %msub
                                    %mi X
                                    %mi j
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %mi q
                                        %msub
                                          %mo ′
                                          %mi i
                                  %mo ↘
                                %mtd
                                %mtd
                                  %msub
                                    %mo ↙
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %mi q
                                        %msub
                                          %mo ′
                                          %mi j
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mover
                                    %mi X
                                    %mo{:stretchy => "false"} ˜
                          %mo }
                      %annotation{:encoding => "application/x-tex"}
                        \\left\{
                        \\array{
                        X_i
                        \&amp;&amp; \underset{f_\alpha}{\longrightarrow} &amp;&amp;
                        X_j
                        \\\
                        \&amp; {}^{\mathllap{q'_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{q'_j}}
                        \\\
                        \&amp;&amp; \tilde X
                        }
                        \\right\}
                %p
                  any other
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %munder
                            %mi lim
                            %mo ⟶
                          %mi i
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo ⟶
                          %mrow
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"}
                        \\phi \;\colon\;  \underset{\longrightarrow}{\lim}_i X_i \overset{}{\longrightarrow} \tilde X
                %p
                  that factors the given co-cone through the co-limiting cocone, in that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \in I
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %msub
                          %mo ′
                          %mi i
                        %mo =
                        %mi ϕ
                        %mo ∘
                        %msub
                          %mi q
                          %mi i
                      %annotation{:encoding => "application/x-tex"}
                        q'_i = \phi \circ q_i
                %p which we depict as follows:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi X
                                  %mi i
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi q
                                      %mi i
                              %mtd
                                %msub
                                  %munder
                                    %mi lim
                                    %mo ⟶
                                  %mi i
                                %msub
                                  %mi X
                                  %mi i
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi ϕ
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msup
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi q
                                      %msub
                                        %mo ′
                                        %mi i
                            %mtr
                              %mtd
                                %mover
                                  %mi X
                                  %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X_i
                        \&amp;\overset{q_i}{\longrightarrow}&amp;
                        \\underset{\longrightarrow}{\lim}_i X_i
                        \\\
                        {}^{\mathllap{\phi}}\downarrow &amp; \swarrow^{\mathrlap{q'_i}}
                        \\\
                        \\tilde X
                        }
          %h3#ShapeOfDirectedGraph Diagrams shaped like directed graphs
          .num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/free+diagram"}> free diagram
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is a
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
              with
              %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(J)
              %strong diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:lspace => "verythinmathspace"} :
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} D\colon F(J) \to C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi D
                        %mo{:stretchy => "false"} ¯
                      %mo{:lspace => "verythinmathspace"} :
                      %mi J
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \bar{D}\colon J \to U(C)
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Quiv
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} F\colon Quiv \to Cat
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            on a quiver and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Cat
                  %mo →
                  %mi Quiv
                %annotation{:encoding => "application/x-tex"} U\colon Cat \to Quiv
            the underlying quiver of a category, which form a pair of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and its edges with morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J\to U(C)
          %h2#remarks Remarks
          %ul
            %li
              %p
                For either sort of diagram,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                may be called the
                = succeed "," do
                  %strong shape
                = succeed "," do
                  %strong scheme
                %strong index
                category or graph.
            %li
              %p
                Note that given a diagram
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo :
                        %mi J
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} D:J\to C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                is not necessarily a
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                is itself taken to be a category. This is because the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                could identify objects of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                %em generated
                by the image in the literal objects-and-morphisms sense.)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                must be a
                %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
                to make sense of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(C)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(J)
                always makes sense.
          %h2#commutative_diagrams Commutative diagrams
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is a category, then a diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} J\to C
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/commutative+diagram"} commutative
            if it factors through a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            commutes iff any two morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            that are assigned to any pair of
            %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            (i.e., with same source and target in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is a quiver, as is more common when we speak about “commutative” diagrams, then a diagram of shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            commutes if the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F(J) \to C
            factors through a thin category. Equivalently, this means that given any two parallel
            %em paths
            of arbitrary finite length (including zero) in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            have equal composites.
          %h2#examples Examples
          %ul
            %li
              %p
                The shape of the
                %strong empty diagram
                is the
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial category
                with no object and no morphism.
              %p
                Every category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                admits a unique diagram whose shape is the empty (
                %a.existingWikiWord{:href => "/nlab/show/initial+object"}> initial
                ) category, which is called the
                %strong empty diagram
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                The shape of the
                %strong terminal diagram
                is the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo *
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} J = \{*\}
                consisting of a single object and a single morphism (the identity morphism on that object).
              %p
                Specifying a diagram in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                whose shape is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo *
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{*\}
                is the same as specifying a single
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
            %li
              %p
                A diagram of the shape
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo →
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{a \to b\}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is the choice of any one
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %mi a
                          %mi b
                      %mo :
                      %msub
                        %mi X
                        %mi a
                      %mo →
                      %msub
                        %mi X
                        %mi b
                    %annotation{:encoding => "application/x-tex"} D_{a b} : X_a \to X_b
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              %p
                Notice that strictly speaking this counts as a
                %em commuting diagram
                , but is a degenerate case of a commuting diagram, since there is only a single morphism involved, which is necessarily equal to itself.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                is the quiver with one object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                and one endo-edge
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo →
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a\to a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                consists of a single
                %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo →
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a\to a
                and the zero-length path are parallel in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
            %li
              %p
                A diagram of shape the
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                indicated by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mo →
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi b
                                %mo ′
                              %mtd
                                %mo →
                              %mtd
                                %mi c
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      a &amp;\to&amp; b
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      b' &amp;\to&amp; c
                      }
                      \\right\}
              %p
                is a
                %strong commuting square
                in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi a
                      %mo ,
                      %msub
                        %mi X
                        %mi b
                      %mo ,
                      %msub
                        %mi X
                        %mrow
                          %mi b
                          %mo ′
                      %mo ,
                      %msub
                        %mi X
                        %mi c
                    %annotation{:encoding => "application/x-tex"} X_a, X_b, X_{b'}, X_c
                in C, together with a choice of (not necessarily distinct) four morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi D
                          %mrow
                            %mi a
                            %mi b
                        %mo :
                        %msub
                          %mi X
                          %mi a
                        %mo →
                        %msub
                          %mi X
                          %mi b
                      %annotation{:encoding => "application/x-tex"} D_{a b} : X_a \to X_b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %mi b
                          %mi c
                      %mo :
                      %msub
                        %mi X
                        %mi b
                      %mo →
                      %msub
                        %mi X
                        %mi c
                    %annotation{:encoding => "application/x-tex"} D_{b c} : X_b \to X_c
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi D
                          %mrow
                            %mi a
                            %mi b
                            %mo ′
                        %mo :
                        %msub
                          %mi X
                          %mi a
                        %mo →
                        %msub
                          %mi X
                          %mrow
                            %mi b
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} D_{a b'} : X_a \to X_{b'}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %mi b
                          %mo ′
                          %mi c
                      %mo :
                      %msub
                        %mi X
                        %mrow
                          %mi b
                          %mo ′
                      %mo →
                      %msub
                        %mi X
                        %mi c
                    %annotation{:encoding => "application/x-tex"} D_{b' c} : X_{b'} \to X_c
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %mi b
                          %mi c
                      %mo ∘
                      %msub
                        %mi D
                        %mrow
                          %mi a
                          %mi b
                    %annotation{:encoding => "application/x-tex"} D_{b c}\circ D_{a b}
                equals the composite
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi D
                          %mrow
                            %mi b
                            %mo ′
                            %mi c
                        %mo ∘
                        %msub
                          %mi D
                          %mrow
                            %mi a
                            %mi b
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} D_{b' c}\circ D_{a b'}
              %p One typically “draws the diagram” as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mi a
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi D
                                    %mrow
                                      %mi a
                                      %mi b
                            %mtd
                              %msub
                                %mi X
                                %mi b
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi a
                                        %mi b
                                        %mo ′
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi b
                                        %mi c
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mrow
                                  %mi b
                                  %mo ′
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi D
                                    %mrow
                                      %mi b
                                      %mo ′
                                      %mi c
                            %mtd
                              %msub
                                %mi X
                                %mi c
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X_a &amp;\stackrel{D_{a b}}{\to}&amp; X_b
                      \\\
                      {}^{\mathllap{D_{a b'}}}\downarrow &amp;&amp;
                      \\downarrow^{\mathrlap{D_{b c}}}
                      \\\
                      X_{b'} &amp;\stackrel{D_{b' c}}{\to}&amp; X_{c}
                      }
              %p
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and says that
                %em the diagram commutes
                if the above equality of composite morphisms holds.
              %p
                Notice that the original poset had, necessarily, a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo →
                      %mi c
                    %annotation{:encoding => "application/x-tex"} a \to c
                and could have equivalently been depicted as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mo →
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↘
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi b
                                %mo ′
                              %mtd
                                %mo →
                              %mtd
                                %mi c
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      a &amp;\to&amp; b
                      \\\
                      \\downarrow &amp;\searrow&amp; \downarrow
                      \\\
                      b' &amp;\to&amp; c
                      }
                      \\right\}
              %p
                in which case we could more explicitly draw its image in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mi a
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi D
                                    %mrow
                                      %mi a
                                      %mi b
                            %mtd
                              %msub
                                %mi X
                                %mi b
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi a
                                        %mi b
                                        %mo ′
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mo ↘
                                %mover
                                  %mrow
                                    %mo =
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi b
                                        %mo ′
                                        %mi c
                                    %mo ∘
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi a
                                        %mi b
                                        %mo ′
                                  %mrow
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi b
                                        %mi c
                                    %mo ∘
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi a
                                        %mi b
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi D
                                      %mrow
                                        %mi b
                                        %mi c
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mrow
                                  %mi b
                                  %mo ′
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi D
                                    %mrow
                                      %mi b
                                      %mo ′
                                      %mi c
                            %mtd
                              %msub
                                %mi X
                                %mi c
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X_a &amp;\stackrel{D_{a b}}{\to}&amp; X_b
                      \\\
                      {}^{\mathllap{D_{a b'}}}\downarrow &amp;\searrow^{\stackrel{D_{b c}\circ D_{a b}}{= D_{b' c}\circ D_{a b'}}}&amp;
                      \\downarrow^{\mathrlap{D_{b c}}}
                      \\\
                      X_{b'} &amp;\stackrel{D_{b' c}}{\to}&amp; X_{c}
                      }
            %li
              %p
                By contrast, a diagram whose shape is the
                %em quiver
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mo →
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi b
                                %mo ′
                              %mtd
                                %mo →
                              %mtd
                                %mi c
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      a &amp;\to&amp; b
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      b' &amp;\to&amp; c
                      }
                      \\right\}
              %p
                is a not-necessarily-commuting square. The free category on this quiver differs from the poset in the previous example by having
                %em two
                morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo →
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a\to c
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo →
                      %mi b
                      %mo →
                      %mi c
                    %annotation{:encoding => "application/x-tex"} a\to b\to c
                and the other by the composite
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo →
                        %mi b
                        %mo ′
                        %mo →
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a \to b'\to c
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(J)
            %li
              %p
                A pair of objects is a diagram whose shape is a
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
                with two objects.
            %li
              %p
                A pair of
                %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
                is a diagram whose shape is a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mover
                        %mo →
                        %mo →
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} J = \{a \stackrel{\to}{\to} b\}
                with two objects and two morphisms from one to the other.
              %p
                Notice that if we required
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mover
                        %mo →
                        %mo →
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{a \stackrel{\to}{\to} b\}
                to be a
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                this would necessarily make these two morphisms equal, and hence reduce this example to the one where
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi a
                        %mo →
                        %mi b
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} J = \{a \to b\}
                %em commutes
                if the two morphisms are equal.
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                is a diagram whose shape is a category with just three objects and single morphisms from one of the objects to the other two;
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi a
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi b
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi c
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      J = \left\{
                      \\array{
                      \&amp;&amp; a
                      \\\
                      \&amp; \swarrow &amp;&amp; \searrow
                      \\\
                      b &amp;&amp;&amp;&amp; c
                      }
                      \\right\}
              %p
                dually, a
                %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
                is a diagram whose shape is
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
                to the shape of a span.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi b
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi c
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                              %mtd
                              %mtd
                                %mo ↙
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi a
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      J = \left\{
                      \\array{
                      b &amp;&amp;&amp;&amp; c
                      \\\
                      \&amp; \searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; a
                      }
                      \\right\}
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
                diagram is one of the shape the
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                indicated by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi a
                                  %mn 0
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi a
                                  %mn 1
                              %mtd
                                %mo →
                              %mtd
                                %mi ⋯
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↙
                              %mtd
                                %mi ⋯
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi b
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      J =
                      \\left\{
                      \\array{
                      a_0 &amp;\to&amp; a_1 &amp;\to&amp; \cdots
                      \\\
                      \&amp; \searrow &amp; \downarrow &amp; \swarrow &amp; \cdots
                      \\\
                      \&amp;&amp; b
                      }
                      \\right\}
                      \\,,
              %p
                where the indices may range over the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
              %p This is a non-finite commuting diagram.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tower+diagram"} tower diagram
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
        .revisedby
          %p
