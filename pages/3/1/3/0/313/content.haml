                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{ X_i \}_{i \in I}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  in the category;
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
