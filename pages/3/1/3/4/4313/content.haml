                , Yi Li,
                %em D-Branes in Landau-Ginzburg models and algebraic geometry
                (arXiv:
                %a{:href => "https://arxiv.org/abs/hep-th/0210296"}> hep-th/0210296
                )
            %li#Orlov
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"}> Dmitri Orlov
                ,
                = succeed "," do
                  %em Triangulated categories of singularities and D-branes in Landau-Ginzburg models
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0302304"} arXiv:math/0302304
            %li
              %p
