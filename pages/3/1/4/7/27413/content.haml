            = succeed "." do
              %em stable
          %h3#decidable_propositions Decidable propositions
          %p
            A pair of mutually exclusive propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is
            %strong decidable
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊔
                    %msup
                      %mi P
                      %mo ⊥
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} P \sqcup P^\bot = 1
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} bool
                  %mo ≃
                  %munder
