          %p
            A pair of mutually exclusive propositions is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/stable+proposition"} stable
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo +
                    %mo ,
                    %msup
                      %mi P
                      %mo −
                    %mo{:stretchy => "false"} )
                    %msub
