                    %msup
                      %mi P
                      %mo +
                    %mo ,
                    %msup
                      %mi P
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ?(P^+, P^-) = (P^+, P^-)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Prop
