                  %msup
                    %mi P
                    %mo +
                  %mo ,
                  %msup
                    %mi P
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} !(P^+, P^-) = (P^+, P^-)
            and a pair of mutually exclusive propositions is
            %strong refutative
            if we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ?
