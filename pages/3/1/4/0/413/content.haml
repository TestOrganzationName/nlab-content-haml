                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} = \mathbb{R}^{1|1}
            %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
            of functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{X}
            is the
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            that is generated over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathbf{R})
            from a single generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            in odd degree (the canonical odd coordinate).
          %p
            The algebra of superdifferential forms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1|1}
            is the
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            generated over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R})
            from
          %ul
            %li
              %p
                a generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
                in odd degree (the canonical odd coordinate);
            %li
              %p
                a generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi x
                    %annotation{:encoding => "application/x-tex"} d x
                in odd degree (the differential of the canonical even coordinate);
            %li
              %p
                a generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} d \theta
                in even degree (the differential of the canonical odd coordinate).
          %p
            Notice in particular that while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi x
                  %mo ∧
                  %mi d
                  %mi x
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d x \wedge d x = 0
            the wedge product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi θ
                  %mo ∧
                  %mi d
                  %mi θ
                %annotation{:encoding => "application/x-tex"} d \theta \wedge d\theta
            is non-vanishing, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi θ
                %annotation{:encoding => "application/x-tex"} d \theta
            is in even degree. In fact all higher wedge powers of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi θ
                %annotation{:encoding => "application/x-tex"} d \theta
            with itself exist.
          %h2#remarks Remarks
          %ul
            %li
              %p
                Being a
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X)
                itself (even for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a usual manifold!) as the “algebra of functions” (more precisely
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/inner+hom"} inner hom
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mi X
                      %annotation{:encoding => "application/x-tex"} T[1] X
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/shifted+tangent+bundle"} shifted tangent bundle
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(T[1]X) = \Omega^\bullet(X)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                on the graded algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X)
                translates into the existence of a special odd vector field on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mi X
                      %annotation{:encoding => "application/x-tex"} T[1]X
                %strong homological vector field
                in that it is odd and the super Lie bracket of it with itself vanishes:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [d,d] = 0
            %li
              %p
                In the context of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroids"} L-infinity algebroids
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                as the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                of an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
                %a.existingWikiWord{:href => "/nlab/show/Lie+infinity-algebroid"} algebroid
                it is useful to notice that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X)
                is the corresponding
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a Lie
                = succeed "-algebroid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T[1]X
                is a Lie
                = succeed "-algebroid." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/picture+changing+operator"} picture changing operator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebroid"} super Lie algebroid
          %h2#references References
          %p Original articles:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joseph+Bernstein"}> Joseph Bernstein
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Dimitry+Leites"} Dimitry Leites
              = succeed "," do
                %em Integral forms and the Stokes formula on supermanifolds
              %strong 11
              (1977) 45–47 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF01135531"}> doi:10.1007/BF01135531
              \&amp;rbrack;
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Simone+Noja"}> Simone Noja
              ,
              = succeed "," do
                %em On the Geometry of Forms on Supermanifolds
              %strong 88
              (2023) 101999 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2111.12841"}> arXiv:2111.12841
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.difgeo.2023.101999"} doi:10.1016/j.difgeo.2023.101999
          %p
            In the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Polishchuk"}> Alexander Polishchuk
              \:
              %em De Rham cohomology for supervarieties
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2305.01858"}> arXiv:2305.01858
              \&amp;rbrack;
          %p
            Discussion in view of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"}> Roberto Catenacci
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/C.+A.+Cremonini"} C. A. Cremonini
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Simone+Noja"} Simone Noja
              %em Cohomology of Lie Superalgebras: Forms, Integral Forms and Coset Superspaces
              (
              %a{:href => "https://arxiv.org/abs/2012.05246"}> arXiv:2012.05246
              )
          %p
            Discussion with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Belopolsky"}> Alexander Belopolsky
              ,
              = succeed "," do
                %em De Rham Cohomology of the Supermanifolds and Superstring BRST Cohomology
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9609220"} arXiv:hep-th/9609220
          %p
            Geometric discussion of
            %a.existingWikiWord{:href => "/nlab/show/picture+number"} picture number
            appearing in the context of
            %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"} integration over supermanifolds
            (and originally seen in the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/NSR+superstring"} NSR superstring
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/superstring+field+theory"} superstring field theory
          %ul
            %li#Belopolsky97b
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Belopolsky"}> Alexander Belopolsky
              ,
              %em Picture changing operators in supergeometry and superstring theory
              (
              %a{:href => "https://arxiv.org/abs/hep-th/9706033"}> arXiv:hep-th/9706033
              )
          %p and further amplified in
          %ul
            %li#Witten12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , appendix D of
                %em Notes On Super Riemann Surfaces And Their Moduli
                (
                %a{:href => "http://arxiv.org/abs/1209.2459"}> arXiv:1209.2459
                )
            %li#CatenacciGrassiNoja18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Catenacci"}> Roberto Catenacci
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simone+Noja"} Simone Noja
                %em Superstring Field Theory, Superforms and Supergeometry
                (
                %a{:href => "https://arxiv.org/abs/1807.09563"}> arXiv:1807.09563
                )
