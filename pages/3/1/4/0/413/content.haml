              into the classifying sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^\bullet
              from Def.
              = succeed "." do
                %a.maruku-ref{:href => "#SuperDifferentialFormClassifying"}
          %h2#properties Properties
          %h3#integral_topforms_and_picture_number Integral top-forms and Picture number
          %p
            If a choice of
            %em integral top-forms
            is made, needed for a notion of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/integration+over+supermanifolds"} integration over supermanifolds
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/picture+number"} picture number
            = succeed "," do
              %a{:href => "#Belopolsky97b"} Belopolsky 97b
            = succeed ")," do
              %a{:href => "#Witten12"} Witten 12
            = succeed ")." do
              %a{:href => "#CatenacciGrassiNoja18"} Catenacci-Grassi-Noja 18 (5.8) to (5.12)
          %h2#Examples Examples
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo =
