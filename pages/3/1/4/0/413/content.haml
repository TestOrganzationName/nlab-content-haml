                    \\;\colon\;
                    SuperCartSp^{op}
                    \\longrightarrow
                    dgcsAlg
            %p
              with values in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              and hence a
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              over
