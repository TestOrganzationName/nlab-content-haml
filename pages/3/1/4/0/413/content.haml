                on general
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              or more generally a
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super formal smooth set
            .maruku-equation
