                    %mi SuperFormalSmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    X \;\in\; SuperFormalSmoothSet
            %p
              Then
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
