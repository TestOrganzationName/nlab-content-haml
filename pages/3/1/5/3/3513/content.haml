          %h2#idea Idea
          %p
            The
            %strong model structure for right fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi rfib
                %annotation{:encoding => "application/x-tex"} (SSet/S)_{rfib}
            is a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} SSet/S
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presents
            the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/right+Kan+fibration"} right Kan fibration
            %a.existingWikiWord{:href => "/nlab/show/fibrations+of+quasi-categories"} of quasi-categories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi rfib
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mo ≃
                  %mi RFib
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((SSet/S)_{rfib})^\circ \simeq RFib(S)
                  \\,.
          %p
            This is the
            = succeed "-analog" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Fib
                    %mi grpd
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fib_{grpd}(S)
            of
            %a.existingWikiWord{:href => "/nlab/show/category+fibered+in+groupoids"} categories fibered in groupoids
            over a category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Similarly there is an analogous
            %strong model structure for left fibrations
            that models
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+fibration"} left Kan fibration
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi SSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi lfib
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                  %mo ≃
                  %mi LFib
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((SSet/S)_{lfib})^\circ \simeq LFib(S)
                  \\,.
          %p
            The extension of this from right fibrations to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+coCartesian+fibrations"} model structure for coCartesian fibrations
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            relates this to the
            %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on functors
            that presents the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fun(S,\infty Grpd)
            (for left fibrations) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi op
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fun(S^{op},\infty Grpd)
            (for right fibrations).
          %h2#Motivation Motivation
          %p
            The following
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure is best understood with the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            in mind, which it serves to model.
          %p
            Recall from the discussion there that given a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} p : X \to S
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi op
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} S^{op} \to \infty Grpd
            that the left adjoint to the Grothendieck construction extracts from it is all encoded in the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo ◃
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi X
                  %mi S
                %annotation{:encoding => "application/x-tex"} X^{\triangleleft} \coprod_X S
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi p
                        %mtd
                          %mi S
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mo ◃
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi X
                            %mo ◃
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi X
                          %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{p}{\to}&amp; S
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X^{\triangleleft} &amp;\to&amp; X^{\triangleleft} \coprod_X S
                  }
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo ◃
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mi X
                %annotation{:encoding => "application/x-tex"} X^\triangleleft = (*) \star X
            is the
            %a.existingWikiWord{:href => "/nlab/show/join+of+quasi-categories"} join
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with the point, i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with an
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            freely adjoined to it.
          %p
            More discussion of why this is the case is at
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Grothendieck+construction#adjunction"} Adjoints to the Grothendieck construction
          %p
            The model category structure described below declares that a morphism in the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} sSet/S
            is a weak equivalence if it induces a weak equivalence of the quasi-categories given by these pushouts. So this is effectively saying that we regard a morphism of right fibration of quasi-categories as a weak equivalences, if under the left adjoint to the
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} f : X \to S
            a morphism of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo ◃
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{\triangleleft}(f)
            for the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo ↪
                        %mtd
                          %msup
                            %mi X
                            %mo ◃
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi S
                        %mtd
                          %mo →
                        %mtd
                          %mi S
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi X
                          %msup
                            %mi X
                            %mo ◃
                        %mtd
                          %mo =
                          %mo :
                          %msup
                            %mi C
                            %mo ◃
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\hookrightarrow&amp; X^{\triangleleft}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  S &amp;\to&amp; S \coprod_{X} X^{\triangleleft} &amp; =: C^{\triangleleft}(f)
                  }
          %p
            in the category
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            of simplicial sets. Call this the
            %strong left cone
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            are computed componentwise, so that the set of vertices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo ◃
                  %mo{:stretchy => "false"} (
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C^{\triangleleft}(f)_0
            is the disjoint union of the vertices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and one extra vertex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            = succeed "." do
              %strong cone point
          .num_defn
            %h6#definition_2 Definition
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, def. 2.1.4.5
              )
            %p
              The
              %strong model structure for left fibrations
              or
              %strong covariant model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi lfib
                  %annotation{:encoding => "application/x-tex"} (sSet/S)_{lfib}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} SSet/S
              is given by
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is
            %ul
              %li
                %p
                  a cofibration if the underlying morphism of simplicial sets is a cofibration in the standard
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %li
                %p a weak equivalence if the induced morphism of cones
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mo ◃
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi X
                        %mi S
                        %mo →
                        %msup
                          %mi Y
                          %mo ◃
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi Y
                        %mi S
                      %annotation{:encoding => "application/x-tex"}
                        X^{\triangleleft} \coprod_X S
                        \\to
                        Y^{\triangleleft} \coprod_Y S
                %p
                  is a weak equivalence in the Joyal
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mo ◃
                      %annotation{:encoding => "application/x-tex"} X^{\triangleleft}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mo ◃
                          %mo :
                          %mo =
                          %mo *
                          %mo ⋆
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X^{\triangleleft} := {*} \star X
          #BasicProperties.num_prop
            %h6#proposition Proposition
            %p This is a
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"}> combinatorial model category
                  \.
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, prop 2.1.4.7, 2.1.4.8
              )
            %p We have
            %ul
              %li
                %p
                  The fibrant objects are precisely the
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/left+fibration"} left fibration
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary 2.2.3.12
              %li
                %p
                  Every left anodyne morphism is an acyclic cofibration. (
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, prop 2.1.4.9
                  )
          %p An alternative characterization of this model structure is:
          #AsLocalization.num_theorem
            %h6#theorem Theorem
            %p
              The model structure for left fibrations is the left
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization"} Bousfield localization
              of the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+overcategory"} overcategory
              model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} SSet/X
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasicategories"} model structure for quasicategories
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} SSet
              at the set of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Λ
                      %mn 0
                      %mi n
                    %mo ↪
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} |
                    %mi n
                    %mo ≥
                    %mn 0
                    %mo ,
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ \Lambda^n_0 \hookrightarrow \Delta^n | n\ge 0, \Delta^n \to X \}
              indexed by all the simplices of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This is mentioned in
            = succeed "," do
              %a{:href => "#HeutsMoerdijk13"} Heuts-Moerdijk
            = succeed "." do
              %a{:href => "http://nforum.ncatlab.org/discussion/915/model-structure-for-left-fibrations/?Focus=53814#Comment_53814"} this discussion
          %h2#properties Properties
          %h3#WeakEquivalences Weak equivalences
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\to&amp;&amp; Y
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; S
                    }
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi S
                  %annotation{:encoding => "application/x-tex"} sSet_S
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              is
              %a.existingWikiWord{:href => "/nlab/show/left+fibration"} left anodyne
              is a weak equivalence in the model structure for left fibrations.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.1.4.6
          .proof
            %h6#proof Proof
            %p
              Recall from
              %a{:href => "http://ncatlab.org/nlab/show/right%2Fleft+Kan+fibration#PropRightAnodyne"} here
              that left anodyne morphisms are the weakly saturated class generated by the
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              inclusions (i.e. under
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p By the definition of weak equivalences above, this means that we need to check that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ◃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi i
                    %mi S
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ◃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi i
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    (\Lambda[n]_i)^{\triangleleft} \coprod_{\Lambda[n]_i} S
                    \\to
                    (\Delta[n])^{\triangleleft} \coprod_{\Delta[n]_i} S
            %p
              is a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %p
              Observe that this is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ◃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msubsup
                                  %mi Λ
                                  %mi i
                                  %mi n
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ◃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msup
                                  %mi Δ
                                  %mi n
                            %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[n+1]_{i+1} &amp;\to&amp; (\Lambda[n]_i)^{\triangleleft} \coprod_{\Lambda^n_i} S
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[n+1] &amp;\to&amp; (\Delta[n])^{\triangleleft} \coprod_{\Delta^n} S
                    }
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner anodyne morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Lambda[n+1]_{i+1} \to \Delta[n+1]
              and therefore a weak equivalence.
            %p
              To illustrate the above pushout property set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              for example. Start with a 2-simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ◃
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi Δ
                          %mn 2
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (\Delta^2)^{\triangleleft} \coprod_{\Delta^2} S
              is the original simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              together with a tetrahedron
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \Delta^3
              built over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              The simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ◃
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msubsup
                          %mi Λ
                          %mn 1
                          %mn 2
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (\Lambda^2_1)^{\triangleleft} \coprod_{\Lambda^2_1} S
              is accordingly the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with only two of the three faces of this tetrahedron over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              erected.
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Λ
                      %mn 2
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ◃
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi Δ
                          %mn 2
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (\Lambda^3_2) \to (\Delta^2)^{\triangleleft} \coprod_{\Delta^2} S
              identifies the horn of this tetrahedron given by these two new faces and the original face
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            %p The pushout therefore glues in the remaining face of the tetrahedron and fills it with a 3-cell.
          %h3#ChangeOfBase Change of base
          %p
            For every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mi S
                  %mo →
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} j : S \to S'
            we have the corresponding
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            on
            %a.existingWikiWord{:href => "/nlab/show/overcategories"} overcategories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi j
                    %mo !
                  %mo ⊣
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mover
                    %munder
                      %mo ←
                      %mrow
                        %msup
                          %mi j
                          %mo *
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mo !
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mrow
                    %mi S
                    %mo ′
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (j_! \dashv j^*)
                  \:
                  sSet/S \stackrel{\overset{f_!}{\to}}{\underset{j^*}{\leftarrow}}
                  sSet/{S'}
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mo !
                    %annotation{:encoding => "application/x-tex"} j_!
                is given by postcomposition of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                    %annotation{:encoding => "application/x-tex"} j^*
                is given by
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                along
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (change of base)
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              with respect to the model structures for left fibrations over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} S'
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.1.4.10
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is a
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} weak equivalence in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Joyal
                    %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark. 2.1.4.11
          %h3#GrothendieckConstruction Grothendieck construction
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-Grothendieck construction)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S = N(C)
              its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi lfib
                    %mover
                      %mo →
                      %mo ←
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (sSet/S)_{lfib} \stackrel{\leftarrow}{\to}
                    [C, sSet_{Quillen}]
            %p
              between the model structure for left fibrations over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and the
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on sSet-functors
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with values in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              equipped with the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          %p
            For more on this see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          %h2#related_concepts Related concepts
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/operad"} operadic
            generalization is the
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+dendroidal+left+fibrations"}> model structure for dendroidal left fibrations
              \.
          %h2#references References
          %p This is the content of section 2.1.4 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            There the model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi lfib
                %annotation{:encoding => "application/x-tex"} (sSet/S)_{lfib}
            is called the
            %strong covariant model structure
            and the model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi rfib
                %annotation{:encoding => "application/x-tex"} (sSet/S)_{rfib}
            the
            = succeed "." do
              %strong contravariant model structure
          %p The alternative construction as a localization is mentioned in
          %ul
            %li#HeutsMoerdijk13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gijs+Heuts"}> Gijs Heuts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                = succeed "," do
                  %em Left fibrations and homotopy colimits
                %strong 279
                (2015) 723–744 &amp;lbrack;
                %a{:href => "http://dx.doi.org/10.1007/s00209-014-1390-7"}> doi:10.1007/s00209-014-1390-7
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/1308.0704"} arXiv:1308.0704
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gijs+Heuts"}> Gijs Heuts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em Left fibrations and homotopy colimits II
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1602.01274"}> arXiv:1602.01274
                \&amp;rbrack;
          %p Further discussion:
          %ul
            %li#Stevenson15
              %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
              ,
              = succeed "," do
                %em Covariant Model Structures and Simplicial Localization
              %strong 3
              (2017) 141-202 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1512.04815"}> arXiv:1512.04815
              \&amp;rbrack;
        .revisedby
