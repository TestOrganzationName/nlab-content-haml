          #CausalOrderingTimeOrderedProductOnRegular.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                is indeed causally ordered
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                product)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
