                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_H A_2
                    \\;=\;
                    A_1 \cdot A_2
                    \\;mod\;
                    \\hbar
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                    %mo −
                    %msub
                      %mi A
                      %mn 2
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mi ℏ
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
