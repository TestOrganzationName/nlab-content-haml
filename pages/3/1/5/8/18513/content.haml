                    \\,.
          %p
            (
            %a{:href => "#Dito90"}> Dito 90
            ,
            = succeed ")" do
              %a{:href => "#DutschFredenhagen01"} Dütsch-Fredenhagen 01
          .proof
            %h6#proof_2 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              this is immediate from the general properties of the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              (
              %a{:href => "A+first+idea+of+quantum+field+theory+--+Quantization#MoyalStarProductIsFormalDeformationQuantization"}> this example
              ).
            %p
              Explicitly, consider, without restriction of generality,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Φ
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_1 = \int (\alpha_1)_a(x) \mathbf{\Phi}^a(x)\, dvol_\Sigma(x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                    %mo =
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Φ
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_2 = \int (\alpha_2)_a(x) \mathbf{\Phi}^a(x)\, dvol_\Sigma(x)
              be two linear observables. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %msub
                              %mo ⋆
                              %mi H
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                            %mo =
                            %msub
                              %mi A
                              %mn 1
                            %msub
                              %mi A
                              %mn 2
                            %mo +
                            %mi ℏ
                            %mo ∫
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mi i
                                  %mn 2
                              %msup
                                %mi Δ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msup
                                %mi H
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mfrac
                              %mrow
                                %mo ∂
                                %msub
                                  %mi A
                                  %mn 1
                              %mrow
                                %mo ∂
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Φ
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 1
                                %mo{:stretchy => "false"} )
                            %mfrac
                              %mrow
                                %mo ∂
                                %msub
                                  %mi A
                                  %mn 2
                              %mrow
                                %mo ∂
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Φ
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 2
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ℏ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi A
                              %mn 1
                            %msub
                              %mi A
                              %mn 2
                            %mo +
                            %mi ℏ
                            %mrow
                              %mo (
                              %mo ∫
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi α
                                %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo (
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mi i
                                    %mn 2
                                %msup
                                  %mi Δ
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 1
                                    %msub
                                      %mi a
                                      %mn 2
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo +
                                %msup
                                  %mi H
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 1
                                    %msub
                                      %mi a
                                      %mn 2
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi α
                                %mn 2
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ℏ
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_1 \star_H A_2
                    \&amp; =
                    A_1 A_2
                    +
                    \\hbar
                    \\int
                    \\left(
                    \\tfrac{i}{2} \Delta^{a_1 a_2}(x_1, x_2) + H^{a_1 a_2}(x_1,x_2)
                    \\right)
                    \\frac{\partial A_1}{\partial \mathbf{\Phi}^{a_1}(x_1)}
                    \\frac{\partial A_2}{\partial \mathbf{\Phi}^{a_2}(x_2)}
                    \\;mod\;
                    \\hbar^2
                    \\\
                    \&amp; =
                    A_1 A_2
                    +
                    \\hbar
                    \\left(
                    \\int
                    (\alpha_1)_{a_1}(x_1)
                    \\left(
                    \\tfrac{i}{2}\Delta^{a_1 a_2}(x_1, x_2)
                    + H^{a_1 a_2}(x_1, x_2)
                    \\right)
                    (\alpha_2)_{a_2}(x_2)
                    \\right)
                    \\;mod\;
                    \\hbar^2
                    \\end{aligned}
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              is skew-symmetric while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is symmetric is follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %msub
                              %mo ⋆
                              %mi H
                            %msub
                              %mi A
                              %mn 2
                            %mo −
                            %msub
                              %mi A
                              %mn 2
                            %msub
                              %mo ⋆
                              %mi H
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mo =
                            %mi i
                            %mi ℏ
                            %mrow
                              %mo (
                              %mo ∫
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi α
                                %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi Δ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi α
                                %mn 2
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ℏ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mi ℏ
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo {
                              %msub
                                %mi A
                                %mn 1
                              %mo ,
                              %msub
                                %mi A
                                %mn 2
                              %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_1 \star_H A_2
                    \-
                    A_2 \star_H A_1
                    \&amp; =
                    i \hbar
                    \\left(
                    \\int
                    (\alpha_1)_{a_1}(x_1)
                    \\Delta^{a_1 a_2}(x_1, x_2)
                    (\alpha_2)_{a_2}(x_2)
                    \\right)
                    \\;mod\;
                    \\hbar^2
