                              %msub
                                %mi A
                                %mn 2
                              %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_F A_2
                    \\;=\;
                    \\left\{
                    \\array{
                    A_1 \star_H A_2 &amp;\vert&amp; supp(A_1) {\vee\!\!\!\wedge} supp(A_2)
