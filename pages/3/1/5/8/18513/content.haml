              %a.existingWikiWord{:href => "/nlab/show/external+tensor+product+of+vector+bundles"} external tensor product of vector bundles
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              with itself.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E) \hookrightarrow Obs(E)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of off-shell polynomial observables onside all off-shell
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            %p
              Let moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              whose
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic differential equations
              %em
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                polynomial observable
              is the
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              of an off-shell polynomial observable along the inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mo ↪
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma}(E)_{\delta_{EL}\mathbf{L} = 0} \hookrightarrow \Gamma_\Sigma(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E,\mathbf{L}) \hookrightarrow Obs(E,\mathbf{L})
            %p
              for the subspace of all on-shell polynomial observables inside all on-shell
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            %p
              By
              %a{:href => "Green+hyperbolic+partial+differential+equation#DistributionsOnSolutionSpaceAreTheGeneralizedPDESolutions"} this prop.
              restriction yields an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              between polynomial on-shell observables and polynomial off-shell observables modulo the image of the
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟵
                      %mo ≃
                      %mtext restriction
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E,\mathbf{L})
                    \\underoverset{\simeq}{\text{restriction}}{\longleftarrow}
                    PolyObs(E)/im(P)
                    \\,.
            %p
              Finally a polynomial observable is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observable"} microcausal observable
              if each
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha^{(k)}
              as above has
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              away from those points where the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/wave+vectors"} wave vectors
              are all in the
              %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
              or all in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo ≃
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    PolyObs(E)_{mc}
                    \&amp;\hookrightarrow&amp;
                    PolyObs(E)
                    \\\
                    PolyObs(E,\mathbf{L})_{mc}
                    \\simeq
                    PolyObs(E)_{mc}/im(P)
                    \&amp;\hookrightarrow&amp;
                    PolyObs(E,\mathbf{L})
                    }
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              inside all
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
          #MoyalStarProductOnMicrocausal.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+distribution"}> Hadamard
                \-
                %a.existingWikiWord{:href => "/nlab/show/Moyal+star+product"} Moyal star product
                on
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/abstract+Wick+algebra"} abstract Wick algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mi Φ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} P \Phi = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              for the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_H
                    \\;=\;
                    \\tfrac{i}{2}\Delta + H
            %p
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              (
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+2-point+function"}> Hadamard 2-point function
              ).
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⋆
                      %mi H
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi X
                            %mn 2
                      %mi ℏ
                      %msubsup
                        %mi Δ
                        %mi H
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi a
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi b
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi dvol
                        %mi g
                      %mo )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi P
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \star_H A
                    \\;\coloneqq\;
                    prod
                    \\circ
                    \\exp\left(
                    \\int_{X^2} \hbar \Delta_H^{a b}(x_1, x_2) \frac{\delta}{\delta \mathbf{\Phi}^a(x_1)}
                    \\otimes \frac{\delta}{\delta \mathbf{\Phi}^b(x_2)} dvol_g
                    \\right)
                    (P_1 \otimes P_2)
            %p
              on
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %msub
                      %mi ℱ
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathcal{F}_{mc}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
              involved in the
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              that appear in expanding out the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              satisfy
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            %p
              Hence by the general properties of
              %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
              (
              %a{:href => "star+product#AssociativeAndUnitalStarProduct"}> this prop.
              ) this yields a
              %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the space of
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              of
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    PolyObs(E)_{mc}[ [\hbar] ] \,,\, \star_H
                    \\right)
                    \\,.
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              corresponding to the choice of
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            %p
              Moreover the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is an ideal with respect to this algebra structure, so that it descends to the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              to yield the
              %em
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    PolyObs(E,\mathbf{L})_{mc}[ [ \hbar ] ] \,,\, \star_H
                    \\right)
                    \\,.
            %p
              Finally, under
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              these are
              %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mi A
                          %mn 1
                        %msub
                          %mo ⋆
                          %mi H
                        %msub
                          %mi A
                          %mn 2
                        %mo )
                      %mo *
                    %mo =
                    %msubsup
                      %mi A
                      %mn 2
                      %mo *
                    %msub
                      %mo ⋆
                      %mi H
                    %msubsup
                      %mi A
                      %mn 1
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    A_1 \star_H A_2
                    \\right)^\ast
                    \=
                    A_2^\ast \star_H A_1^\ast
                    \\,.
          %p
            (
            %a{:href => "#Dito90"}> Dito 90
            ,
            %a{:href => "#DuetschFredenhagen00"} Dütsch-Fredenhagen 00
            = succeed "," do
              %a{:href => "#DuetschFredenhagen01"} Dütsch-Fredenhagen 01
            = succeed "," do
              %a{:href => "#HirschfeldHenselder02"} Hirshfeld-Henselder 02
            = succeed ")" do
              %a{:href => "#Collini16"} Collini 16, p. 25-26
          .proof
            %h6#proof Proof
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              (or else by
              = succeed ")," do
                %a{:href => "Hadamard+distribution#WaveFronSetsForKGPropagatorsOnMinkowski"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              has all cotangent
              %a.existingWikiWord{:href => "/nlab/show/wave+vectors"} wave vectors
              on the first variables in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              at the given base point (which itself is on the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
            %center
              %img{:src => "https://ncatlab.org/nlab/files/HadamardPropagator.png", :width => "60"}/
            %p
              and hence all those on the second variables in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
            %p
              The first variables are integrated against those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and the second against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A_2
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_2
              are disjoint from the subsets where all components are in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              or all components are in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
              %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              for partial
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of
              %a.existingWikiWord{:href => "/nlab/show/distributions+of+several+variables"} distributions of several variables
              (
              %a{:href => "product+of+distributions#PartialProductOfDistributionsOfSeveralVariables"}> this prop.
              ) is met and the star product is well defined.
            %p
              It remains to see that the star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_1 \star_H A_2
              is itself again a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observable"} microcausal observable
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
              and that it respects the ideal generated by the equations of motion. That it still satisfies the condition on the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              follows directly from the fact that the wave front set of a
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              is inside the fiberwise sum of elements of the factor wave front sets (
              %a{:href => "product+of+distributions#WaveFrontSetOfProductOfDistributionsInsideFiberProductOfFactorWaveFrontSets"}> this prop.
              ,
              = succeed ")." do
                %a{:href => ""}
            %p
              Finally the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %a.maruku-ref{:href => "#WightmanPropagatorAsKaehlerVectorSpaceStructure"}
              as in
              = succeed "." do
                %a{:href => "star+product#StarProductAlgebraOfKaehlerVectorSpaceIsStarAlgebra"} this prop.
          #WickAlgebraIsFormalDeformationQuantization.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                is
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Poisson-Peierls+bracket"} Poisson-Peierls algebra of observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Φ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} P \Phi = 0
              with
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H \;=\; \tfrac{i}{2}\Delta + H
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              (
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+2-point+function"}> Hadamard 2-point function
              ).
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⋆
                        %mi H
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( PolyObs(E,\mathbf{L})_{mc}[ [\hbar] ] \,,\, \star_H \right)
              from prop.
              %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              given by the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Poisson-Peierls+bracket"} Poisson-Peierls bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo ⊗
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo →
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} \{-,-\} \;\colon\; PolyObs(E,\mathbf{L})_{mc} \otimes PolyObs(E,\mathbf{L})_{mc}  \to PolyObs(E,\mathbf{L})_{mc}
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in PolyObs(E,\mathbf{L})_{mc}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi mod
