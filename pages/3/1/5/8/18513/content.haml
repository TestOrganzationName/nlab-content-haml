              for the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
