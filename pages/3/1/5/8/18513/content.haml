          %h3#AbstractTimeOrderedProduct Abstract time-ordered product
          #OnRegularPolynomialObservablesTimeOrderedProduct.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
