              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              from prop.
              %a.maruku-ref{:href => "#OnRegularPolynomialObservablesTimeOrderedProduct"}
              extends to a product on
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
