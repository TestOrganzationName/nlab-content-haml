          .proof
            %h6#proof_4 Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              is symmetric (
              %a{:href => "A+first+idea+of+quantum+field+theory#SymmetricFeynmanPropagator"}> this prop.
              ), the statement is a special case of
              = succeed ")." do
                %a{:href => "star+product#SymmetricContribution"} this prop.
          .num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
            %p
