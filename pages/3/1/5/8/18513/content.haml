                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              over a
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              and with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green-hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
