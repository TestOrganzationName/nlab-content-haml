          .proof
            %h6#proof_3 Proof
            %p Recall the following facts:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} \Delta_{\pm}
                  by definition are
                  %a.existingWikiWord{:href => "/nlab/show/support"} supported
                  in the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
                  = succeed "," do
