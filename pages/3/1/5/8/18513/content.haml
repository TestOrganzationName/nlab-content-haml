                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %munder
                        %mo ∫
                        %mrow
                          %mi Σ
