                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{C})
            is spelled out in (
            %a{:href => "#MillerBlichfeldtDickson16"}> Miller-Blichfeldt-Dickson 16
            ) reviewed in (
            %a{:href => "#Serrano14"}> Serrano 14, section 2
            ). The proof of the case for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2)
            given the result for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(3)
            is spelled out in
            = succeed "." do
              %a{:href => "#Keenan03"} Keenan 03, theorem 4
          %h3#FiniteSubgroupsOfO4
            Finite subgroups of
            = succeed "," do
