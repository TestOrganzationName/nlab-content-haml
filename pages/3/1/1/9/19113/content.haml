                  %a{:href => "Platonic+2-group#RelationToTheString2Group"} Relation to String 2-group
          %p
          #RestrictingTheSecondChernClassFromSU2ToFiniteSubgroup.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ADE
                    %mover
                      %mo ↪
                      %mi i
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_{ADE} \xhookrightarrow{i} Spin(3)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+subgroup+of+SU%282%29"} finite subgroup of SU(2)
              %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback in cohomology
              along the induced map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi G
                      %mi ADE
                    %mover
                      %mo →
                      %mrow
                        %mi B
                        %mi i
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B G_{ADE} \xrightarrow{B i} B SU(2)
              of
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              sends
            %ul
              %li
                the generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi H
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} c_2 \,\in\,H^4(B SU(2), \mathbb{Z}) \simeq \mathbb{Z}
                (the
                %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+class"} universal
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
            %p to
            %ul
              %li
                a generator of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi G
                        %mi ADE
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mo |
                        %msub
                          %mi G
                          %mi ADE
                        %mo |
                    %annotation{:encoding => "application/x-tex"} H^4(B G_{ADE}, \mathbb{Z}) \simeq \mathbb{Z}/\left\vert G_{ADE}\right\vert
                %a.maruku-eqref{:href => "#eq:IntegralGroupCohomologyOfFiniteSubgroupsOfSU2"} (1)
            %p
              in that the
              %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback in cohomology
              is identified with the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              from the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              to the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              that of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi ADE
                    %annotation{:encoding => "application/x-tex"} G_{ADE}
            #eq:RestrictionOf4CohomologyOfBSU2ToBGADE.maruku-equation
              %span.maruku-eq-number (3)
