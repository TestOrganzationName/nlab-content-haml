                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi G
                        %mi ADE
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\simeq H^3( \mathbb{C}^4 \sslash G_{ADE}, U(1))
                    }{
                    \\underbrace{
                    H^4_{grp}(G_{ADE}, \mathbb{Z})
                    }}
                    \\;\simeq\;
                    \\mathbb{Z}/{\vert G_{ADE} \vert }
            %p
              of Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#GroupCohomologyOfFiniteSubgroupsOfSU2"}
              %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
              of an
