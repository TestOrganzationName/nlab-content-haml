              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0010023"} arXiv:hep-th/0010023
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/universal+higher+central+extension"} universal higher central extension
            of finite subgroups of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2)
            (“
