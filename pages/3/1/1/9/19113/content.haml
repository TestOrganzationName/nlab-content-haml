                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(4)
            %a.existingWikiWord{:href => "/nlab/show/SO%284%29"} SO(4)
            and
            %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
          %p
            For classification of the finite subgroups of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(4)
            see (
            %a{:href => "#DuVal65"}> duVal 65
            ,
            = succeed ")" do
              %a{:href => "#ConwaySmith03"} Conway-Smith 03
          %p
            For finite subgroups of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
            = succeed "." do
              %a{:href => "#MFF12"} MFF 12, appendix B
          %p
            In this classification, the
            %a.existingWikiWord{:href => "/nlab/show/symmetry+group"} symmetry group
            of the
            %a.existingWikiWord{:href => "/nlab/show/120-cell"} 120-cell
            and hence that of the
            %a.existingWikiWord{:href => "/nlab/show/600-cell"} 600-cell
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi I
                  %mo ×
                  %mn 2
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} (2 I \times 2 I)/\mathbb{Z}_2
            by the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
            of the
            %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
            of two copies of the
            %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
            (
            %a{:href => "#SadocMosseri89"}> SadocMosseri 89, p. 172
            , see
