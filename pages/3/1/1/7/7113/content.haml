              implies that there exists a rational number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ′
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} r' \in \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi r
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x \lt r'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ′
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r' \lt r
            %li
              for all rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi x
                  %annotation{:encoding => "application/x-tex"} q \lt x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} x \lt r
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} q \lt r
            %li
              for all rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} q \lt r
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi x
                  %annotation{:encoding => "application/x-tex"} q \lt x
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} x \lt r
          %p We have the following results:
          %ul
            %li
              %p
                The first condition is always true because for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi F
                      %annotation{:encoding => "application/x-tex"} x \in F
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo −
                        %mn 1
                        %mo ∈
                        %mi F
                      %annotation{:encoding => "application/x-tex"} x - 1 \in F
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo −
                        %mn 1
                        %mo &lt;
                        %mi q
                        %mo &lt;
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x - 1 \lt q \lt x
            %li
              %p
                The second condition is always true because for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi F
                      %annotation{:encoding => "application/x-tex"} x \in F
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo +
                        %mn 1
                        %mo ∈
                        %mi F
                      %annotation{:encoding => "application/x-tex"} x + 1 \in F
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi r
                        %mo &lt;
                        %mi x
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} x \lt r \lt x + 1
            %li
              %p
                The fifth condition is always true because for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo &lt;
                        %mi x
                      %annotation{:encoding => "application/x-tex"} q \lt x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ′
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} q' \in \mathbb{Q}
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo &lt;
                        %mi q
                        %mo ′
                        %mo &lt;
                        %mi x
                      %annotation{:encoding => "application/x-tex"} q \lt q' \lt x
            %li
              %p
                The sixth condition is always true because for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi r
                      %annotation{:encoding => "application/x-tex"} x \lt r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ′
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} q' \in \mathbb{Q}
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi r
                        %mo ′
                        %mo &lt;
                        %mi r
                      %annotation{:encoding => "application/x-tex"} x \lt r' \lt r
            %li
              %p
                The third, fourth, and seventh conditions are always true for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
                because of transitivity of the
                %a.existingWikiWord{:href => "/nlab/show/strict+order"} strict order
                relation.
            %li
              %p
                Finally, the eighth condition says that every element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
                is located, and is true for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
                because the
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (q, \infty) \cup (-\infty, r)
                of the
                %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (q, \infty)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-\infty, r)
                is the
                %a.existingWikiWord{:href => "/nlab/show/improper+subset"} improper subset
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
          %h3#continuous_and_differentiable_structure Continuous and differentiable structure
          %p
            Every Archimedean ordered field is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+space"} differentiable space
          %h4#pointwise_continuous_functions Pointwise continuous functions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be an Archimedean ordered field. A function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi F
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f:F \to F
            is
            %strong continuous at a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} c \in F
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isContinuousAt
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi ϵ
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi x
                  %mo ∈
                  %mi F
                  %mo .
                  %mo ∃
                  %mi δ
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo −
                  %mi c
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi δ
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isContinuousAt(f, c) \coloneqq \forall \epsilon \in (0, \infty). \forall x \in F. \exists \delta \in (0, \infty). (\vert x - c \vert \lt \delta) \implies (\vert f(x) - f(c) \vert \lt \epsilon)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %strong pointwise continuous
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            if it is continuous at all points
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isPointwiseContinuous
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi c
                  %mo ∈
                  %mi F
                  %mo .
                  %mi isContinuousAt
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isPointwiseContinuous(f) \coloneqq \forall c \in F. isContinuousAt(f, c)
          %p The set of all pointwise continuous functions is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %mi F
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} |
                  %mi isPointwiseContinuous
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} C^0(F) \coloneqq \{f \in F \to F \vert isPointwiseContinuous(f)\}
          %h4#pointwise_differentiable_functions Pointwise differentiable functions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be an Archimedean ordered field. A function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi F
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f:F \to F
            is
            %strong differentiable at a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} c \in F
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isDifferentiableAt
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi isContinuousAt
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo ∃
                  %mi L
                  %mo ∈
                  %mi F
                  %mo .
                  %mo ∀
                  %mi ϵ
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi x
                  %mo ∈
                  %mi F
                  %mo .
                  %mo ∃
                  %mi δ
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi h
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi δ
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi δ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mrow
                    %mo |
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo +
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %mi h
                    %mo −
                    %mi L
                    %mo |
                  %mo &lt;
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} isDifferentiableAt(f, c) \coloneqq isContinuousAt(f, c) \times \exists L \in F. \forall \epsilon \in (0, \infty). \forall x \in F. \exists \delta \in (0, \infty). \forall h \in (-\delta, 0) \cup (0, \delta). \left| \frac{f(c + h) - f(c)}{h} - L \right| \lt \epsilon
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %strong pointwise differentiable
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            if it is differentiable at all points
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isPointwiseDifferentiable
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi c
                  %mo ∈
                  %mi F
                  %mo .
                  %mi isDifferentiableAt
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isPointwiseDifferentiable(f) \coloneqq \forall c \in F. isDifferentiableAt(f, c)
          %p The set of all pointwise differentiable functions is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %mi F
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} |
                  %mi isPointwiseDifferentiable
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
