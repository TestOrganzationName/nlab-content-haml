          %h2#definition Definition
          %h3#using_field_homomorphisms_from_the_rationals Using field homomorphisms from the rationals
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            are the
            %a.existingWikiWord{:href => "/nlab/show/initial"} initial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            there is a field homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi ℚ
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} h:\mathbb{Q}\to F
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of the ordered field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coercion"} coercion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}
            one can derive that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} q \in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            %em Archimedean
            if for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} x \in F
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} y \in F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} q\in \mathbb{Q}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mi q
                %annotation{:encoding => "application/x-tex"} x \lt q
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} q \lt y
          %h3#using_dedekind_cutlike_conditions Using Dedekind cut-like conditions
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            in an
            %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} x \in F
            which satisfies the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+cut"} Dedekind cut
            axioms:
          %ol
            %li
              there exists a rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
