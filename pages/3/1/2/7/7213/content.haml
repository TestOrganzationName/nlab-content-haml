                %mrow
                  %msub
                    %mi E
                    %mn 11
                %annotation{:encoding => "application/x-tex"} E_{11}
            with its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+representation"} fundamental representation
            is due to
          %ul
            %li#West11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
                ,
                = succeed "," do
                  %em
                    Generalised geometry, eleven dimensions and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 11
                        %annotation{:encoding => "application/x-tex"} E_{11}
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1111.1642"} arXiv:1111.1642
            %li
              %p
                Alexander G. Tumanov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 11
                        %annotation{:encoding => "application/x-tex"} E_{11}
                    must be a symmetry of strings and branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1512.01644"} arXiv:1512.01644
            %li
              %p
                Alexander G. Tumanov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 11
                        %annotation{:encoding => "application/x-tex"} E_{11}
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 11
                          %mi d
                        %annotation{:encoding => "application/x-tex"} 11d
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1601.03974"} arXiv:1601.03974
          %p
            This way that elements of
            %a.existingWikiWord{:href => "/nlab/show/cosets"} cosets
            of the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
