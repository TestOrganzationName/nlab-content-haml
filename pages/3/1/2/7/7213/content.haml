          %p Review includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
                , section 17.5 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Strings+and+Branes"} Introduction to Strings and Branes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabio+Riccioni"}> Fabio Riccioni
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 11
                        %annotation{:encoding => "application/x-tex"} E_{11}
                    and M-theory
                %a{:href => "http://www.ift.uam.es/strings07/"} Strings07
                (
                %a{:href => "http://member.ipmu.jp/yuji.tachikawa/stringsmirrors/2007/riccioni.pdf"}> pdf slides
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fabio+Riccioni"}> Fabio Riccioni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em
                    The
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
