            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Cook"}> Paul Cook
                ,
                %em Connections between Kac-Moody algebras and M-theory
                PhD thesis (
                %a{:href => "http://arxiv.org/abs/0711.3498"}> arXiv:0711.3498
                )
            %li#West16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"}> Peter West
                ,
                %em A brief review of E theory
                (
                %a{:href => "http://arxiv.org/abs/1609.06863"}> arXiv:1609.06863
                )
          %p Original articles include the following:
          %p
            The observation that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 11
                %annotation{:encoding => "application/x-tex"} E_{11}
