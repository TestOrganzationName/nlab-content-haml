                                %mi A
                                %mo ⊗
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi A
                              %mtd
                                %munderover
                                  %mo ⟶
                                  %mo ≃
                                  %mrow
                                    %msub
                                      %mi a
                                      %mrow
                                        %mi A
                                        %mo ,
                                        %mi A
                                        %mo ,
                                        %mi A
