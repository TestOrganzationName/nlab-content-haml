              ) on those that admit the structure of a
              %a.existingWikiWord{:href => "/nlab/show/finite+CW-complex"} finite CW-complex
              (a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicalCellComplex"}> def.
              ) with a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of cells).
            %p
              We say that the pointed topological
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedTopologicalFunctorCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Exc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Exc(Top_{cg})
                    \\coloneqq
                    [Top^{\ast/}_{cg,fin}, Top^{\ast/}_{cg}]
            %p
              is the category of
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/pre-excisive+functors"} pre-excisive functors
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi exc
                    %mo ≔
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msubsup
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{exc}
                    \\coloneqq
                    y(S^0)
                    \\coloneqq
                    Top^{\ast/}_{cg,fin}(S^0,-)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} functor co-represented
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} \iota_{fin}
              itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi exc
                    %mo =
                    %msub
                      %mi ι
                      %mi fin
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo ↦
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{exc} = \iota_{fin}
                    \\;\colon\;
                    K \mapsto K
                    \\,.
            %p
              We call this the standard incarnation of the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              as a pre-excisive functor.
            %p
              By prop.
              %a.maruku-ref{:href => "#DayConvolutionYieldsMonoidalCategoryStructure"}
              the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              induces the structure of a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi Exc
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∧
                        %mi Day
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi 𝕊
                        %mi exc
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    Exc(Top_{cg})
                    ,\;
                    \\wedge_{Day}
                    ,\;
                    \\mathbb{S}_{exc}
                    \\right)
            %p with
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  the
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi exc
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_{exc}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Day+convolution+product"} Day convolution product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ⊗
                          %mi Day
                      %annotation{:encoding => "application/x-tex"} \otimes_{Day}
                  from def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#TopologicalDayConvolutionProduct"}
                %p
                  called the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
                  for the model of pre-excisive functors;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  the dual operation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi Day
                      %annotation{:encoding => "application/x-tex"} [-,-]_{Day}
                  from prop.
                  = succeed "," do
                    %a.maruku-ref{:href => "#DayMonoidalStructureIsClosed"}
                %p
                  called the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
                  construction for pre-excisive functors.
          #EveryPreExcisiveFunctorIsSModule.num_remark
            %h6#remark_4 Remark
            %p
              By example
              %a.maruku-ref{:href => "#MonoidGivenByTensorUnit"}
              the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              incarnated as a pre-excisive functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi exc
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{exc}
              (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid in
              the category of pre-excisive functors (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
            %p
              Moreover, by example
              = succeed "," do
                %a.maruku-ref{:href => "#EveryObjectIsModuleOverTensorUnit"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Exc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Exc(Top_{cg})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
              %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi exc
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{exc}
              %a.existingWikiWord{:href => "/nlab/show/module+category"} module category
              over the sphere spectrum:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Exc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝕊
                      %mi exc
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Exc(Top_{cg})
                    \\simeq
                    \\mathbb{S}_{exc}Mod
                    \\,.
          %p
            We now consider restricting the domain of the pre-excisive functors of def.
            = succeed "." do
              %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
          #TopologicalDiagramCategoriesForSpectra.num_defn
            %h6#definition_17 Definition
            %p
              Define the following
              %a.existingWikiWord{:href => "/nlab/show/pointed+topologically+enriched+categories"} pointed topologically enriched
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              )
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Seq
                      %annotation{:encoding => "application/x-tex"} Seq
                  is the category whose objects are the
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                  and which has only identity morphisms and
                  %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
                  on these objects, hence the
                  %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
                  are
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Seq
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi S
                                    %mn 0
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo =
                                  %msub
                                    %mi n
                                    %mn 2
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"}
                        Seq(n_1,n_2) =
                        \\left\{
                        \\array{
                        S^0 &amp; for\; n_1 = n_2
                        \\\
                        \\ast &amp; otherwise
                        }
                        \\right.
                %p
                  The tensor product is the addition of natural numbers,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ⊗
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %annotation{:encoding => "application/x-tex"} \otimes = +
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  is 0.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                      %annotation{:encoding => "application/x-tex"} Sym
                  is the standard
                  %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeleton
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/core"} core
                  of
                  %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
                  with
                  %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
                  adjoined: its
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1, \cdots,n\}
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero
                  morphisms are
                  %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                  and the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1,\cdots,n\}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Σ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \Sigma_n
                  %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
                  are the following
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi Σ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo =
                                  %msub
                                    %mi n
                                    %mn 2
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"}
                        Sym(n_1, n_2) =
                        \\left\{
                        \\array{
                        (\Sigma_{n_1})_+ &amp; for \; n_1 = n_2
                        \\\
                        \\ast &amp; otherwise
                        }
                        \\right.
                %p
                  The tensor product is the
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                  of sets, tensor unit is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Orth
                      %annotation{:encoding => "application/x-tex"} Orth
                  has as objects finite dimenional real linear
                  %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
                  and as non-zero morphisms the
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  between these; hence the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} O(V)
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of linear spaces, the tensor unit is the 0-vector space; again we turn this into a
                  = succeed "-enriched" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Orth
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo ,
                        %msub
                          %mi V
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi O
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi V
                                    %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %mi dim
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi V
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo =
                                  %mi dim
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi V
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"}
                        Orth(V_1,V_2)
                        \\simeq
                        \\left\{
                        \\array{
                        O(V_1)_+ &amp; for \; dim(V_1) = dim(V_2)
                        \\\
                        \\ast &amp; otherwise
                        }
                        \\right.
            %p
              There is a sequence of canonical
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              pointed topological
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Seq
                          %mtd
                            %mover
                              %mo ↪
                              %mi seq
                          %mtd
                            %mi Sym
                          %mtd
                            %mover
                              %mo ↪
                              %mi sym
                          %mtd
                            %mi Orth
                          %mtd
                            %mover
                              %mo ↪
                              %mi orth
                          %mtd
                            %msubsup
                              %mi Top
                              %mrow
                                %mi cg
                                %mo ,
                                %mi fin
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                        %mtr
                          %mtd
                            %mi n
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi S
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi V
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi S
                              %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Seq
                    \&amp;\stackrel{seq}{\hookrightarrow}&amp;
                    Sym
                    \&amp;\stackrel{sym}{\hookrightarrow}&amp;
                    Orth
                    \&amp;\stackrel{orth}{\hookrightarrow}&amp;
                    Top_{cg,fin}^{\ast/}
                    \\\
                    n
                    \&amp;\mapsto&amp;
                    \\{1,\cdots, n\}
                    \&amp;\mapsto&amp;
                    \\mathbb{R}^n
                    \&amp;\mapsto&amp;
                    S^n
                    \\\
                    \&amp;&amp;
                    \&amp;&amp;
                    V
                    \&amp;\mapsto&amp;
                    S^V
                    }
                    \\,,
            %p
              into the pointed topological category of pointed compactly generated topological spaces of finite CW-type (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sym
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Σ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sym \colon (\Sigma_n)_+ \hookrightarrow (O(n))_+
              is the canonical inclusion of
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              matrices into
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
              matrices and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi orth
                    %mo{:lspace => "verythinmathspace"} :
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ↪
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} orth \colon O(V)_+ \hookrightarrow Aut(S^V)
              is on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(V)
              the
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions of the pointed
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                    %mo →
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V \to S^V
              that are induced under forming
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              from linear isometries of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              (“
              %a.existingWikiWord{:href => "/nlab/show/representation+spheres"}> representation spheres
              ”).
            %p
              Consider the sequence of restrictions of topological diagram categories, according to prop.
              %a.maruku-ref{:href => "#PullbackAlongLaxMonoidalFunctorPreservesMonoidsForDayConvolution"}
              along the above inclusions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Exc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi orth
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mi Orth
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
