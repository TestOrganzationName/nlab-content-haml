                    %semantics
                      %mrow
                        %mi e
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mn 1
                        %mo ⟶
                        %mi A
                      %annotation{:encoding => "application/x-tex"} e \;\colon\; 1 \longrightarrow A
                  (called the
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/unit"} unit
              %li
                %p
                  a morphism
