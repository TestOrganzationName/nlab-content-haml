                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi 𝒟
                            %msub
                              %mi F
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo ⊗
                                  %mi 𝒟
                                %mi f
