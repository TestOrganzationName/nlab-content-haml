                              %mo ⊗
                              %mi 𝒞
                            %mi y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F_1(x) \otimes_{\mathcal{D}} F_1(y)
                    \&amp;\overset{f(x)\otimes_{\mathcal{D}} f(y)}{\longrightarrow}&amp;
                    F_2(x) \otimes_{\mathcal{D}} F_2(y)
                    \\\
                    {}^{\mathllap{(\mu_1)_{x,y}}}\downarrow
                    \&amp;&amp;
