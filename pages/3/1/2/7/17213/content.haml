                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \otimes_{\mathcal{C}} \;\colon\; \mathcal{C} \times\mathcal{C} \to \mathcal{C}
            %p
              Then the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
                tensor product
              on the pointed topological
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
