                                %mi A
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi A
                                    %mo ⊗
                                    %mi μ
                              %mtd
                                %mi A
                                %mo ⊗
                                %mi A
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi μ
                                      %mo ⊗
                                      %mi A
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi μ
                            %mtr
                              %mtd
                                %mi A
                                %mo ⊗
                                %mi A
                              %mtd
