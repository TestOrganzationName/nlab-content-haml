                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %msub
