                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi μ
                                    %mn 2
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mi x
                                      %mo ,
                                      %mi y
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %msub
                              %mo ⊗
                              %mi 𝒞
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
