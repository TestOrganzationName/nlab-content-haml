                  %annotation{:encoding => "application/x-tex"} MonFun(\mathcal{C},\mathcal{D})
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of lax monoidal functors between monoidal categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BraidMonFun
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} BraidMonFun(\mathcal{C},\mathcal{D})
              for the category of braided monoidal functors between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
