                    Seq(n_1,n_2)
                    \\coloneqq
                    \\left\{
                    \\array{
                    S^0 &amp; if\; n_1 = n_2
                    \\\
                    \\ast &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Regard this as a pointed topologically enriched category in the unique way. The operation of addition of natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} \otimes = +
              makes this a monoidal category.
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi Seq
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in [Seq, Top_{cg}^{\ast/}]
              is an
              = succeed "-sequence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              %a.maruku-ref{:href => "#TopologicalDayConvolutionProduct"}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo ⊗
                              %mi Day
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                          %mtd
                            %mo =
                            %mover
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi n
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi n
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mi Seq
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi n
                                      %mn 2
                                %mrow
                                  %mrow
                                    %mo =
                                    %mi n
                            %mrow
                              %mo (
                              %msub
                                %mi X
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                              %mo ∧
                              %msub
                                %mi X
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 2
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (X \otimes_{Day} Y)_n
                    \&amp; =
                    \\overset{(n_1,n_2)}{\int}
                    Seq(n_1 + n_2 , n)
                    \\wedge
                    X_{n_1} \wedge X_{n_2}
                    \\\
                    \&amp; = \underset{{n_1+n_2} \atop {= n}}{\coprod} \left(X_{n_1}\wedge X_{n_2}\right)
                    \\end{aligned}
                    \\,.
          %p
            We observe now that
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#TopologicalLeftKanExtensionBCoend"}
            %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            and
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            with respect to Day convolution.
