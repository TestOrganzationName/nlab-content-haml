                    %annotation{:encoding => "application/x-tex"} A
            %p Finally one checks that these two constructions are inverses to each other, up to isomorphism.
          %h3#day_convolution Day convolution
          #TopologicalDayConvolutionProduct.num_defn
            %h6#definition_12 Definition
            %p
              Let
