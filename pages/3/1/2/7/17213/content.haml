            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              \. Moreover it satisfies the unit property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
