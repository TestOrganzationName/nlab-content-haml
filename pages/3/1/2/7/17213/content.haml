          #MonoidModuleOverItself.num_prop
            %h6#proposition_5 Proposition
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu, e)
              canonically becomes a left module over itself by setting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ≔
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \rho \coloneqq \mu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} C \in \mathcal{C}
              any object, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \otimes C
              naturally becomes a left
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
