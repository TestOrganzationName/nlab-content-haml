                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(c) &amp;\overset{\eta_c}{\longrightarrow}&amp; G(c)
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{G(f)}}
                    \\\
                    \&amp;&amp; G(d)
                    }
            %p
              each component in such a collection, respectively. These two functions being equal, hence the collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi η
                      %mi c
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \{\eta_c\}_{c\in \mathcal{C}}
              being in the equalizer, means precisley that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ,
                    %mi d
                  %annotation{:encoding => "application/x-tex"} c,d
              and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f\colon c \to d
              the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(c) &amp;\overset{\eta_c}{\longrightarrow}&amp; G(c)
                    \\\
                    {}^{\mathllap{F(f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{G(f)}}
                    \\\
                    F(d) &amp;\underset{\eta_d}{\longrightarrow}&amp; G(g)
                    }
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi η
                      %mi c
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \{\eta_c\}_{c\in \mathcal{C}}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          %p
            Conversely, example
            %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
            says that
            %a.existingWikiWord{:href => "/nlab/show/ends"} ends
            over
            %a.existingWikiWord{:href => "/nlab/show/bifunctors"} bifunctors
            of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} Maps(F(-),G(-)))_\ast
            constitute
            %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            between pointed
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
          #PointedTopologicalFunctorCategory.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              ). Define the structure of a pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              on the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}^{\ast/}]
              of pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctorsToTopk"}> exmpl.
              ) by taking the
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              to be given by the
              %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              = succeed ":" do
                %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C},Top^{\ast/}_{cg}](F,G)
                    \\;\coloneqq\;
                    \\int_{c\in \mathcal{C}} Maps(F(c),G(c))_\ast
            %p and by taking the composition maps to be the morphisms induced by the maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo ∫
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo )
                    %mo ∧
                    %mrow
                      %mo (
                      %munder
                        %mo ∫
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ∧
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∘
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi c
                            %mo ∈
                            %mi 𝒞
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\underset{c\in \mathcal{C}}{\int} Maps(F(c),G(c))_\ast
                    \\right)
                    \\wedge
                    \\left(
                    \\underset{c \in \mathcal{C}}{\int} Maps(G(c),H(c))_\ast
                    \\right)
                    \\overset{}{\longrightarrow}
                    \\underset{c\in \mathcal{C}}{\prod}
                    Maps(F(c),G(c))_\ast \wedge Maps(G(c),H(c))_\ast
                    \\overset{(\circ_{F(c),G(c),H(c)})_{c\in \mathcal{C}}}{\longrightarrow}
                    \\underset{c \in \mathcal{C}}{\prod}
                    Maps(F(c),H(c))_\ast
            %p
              by observing that these equalize the two actions in the definition of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/end"} end
            %p
              The resulting pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C},Top^{\ast/}_{cg}]
              is also called the
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
                \-
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
          %p
            First of all this yields a concise statement of the pointed topologically
            %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedYonedaLemma"}> prop.
            )
          #YonedaReductionTopological.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (topologically
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              ). For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\to Top^{\ast/}_{cg}
              a pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctor"}> def.
              ) and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
              an object, there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, Top^{\ast/}_{cg}](\mathcal{C}(c,-),\; F)
                    \\;\simeq\;
                    F(c)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-space"} hom-space
              of the pointed topological functor category, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#PointedTopologicalFunctorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} functor represented
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
            %p
              In terms of the
              %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %mi d
                        %mo ∈
                        %mi 𝒞
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{d\in \mathcal{C}}{\int} Maps(\mathcal{C}(c,d), F(d))_\ast
                    \\;\simeq\;
                    F(c)
                    \\,.
            %p
              In this form the statement is also known as
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+reduction"} Yoneda reduction
          %p
            The
            %strong proof
            of prop.
            %a.maruku-ref{:href => "#YonedaReductionTopological"}
            is essentially dual to the proof of the next prop.
            = succeed "." do
              %a.maruku-ref{:href => "#TopologicalCoYonedaLemma"}
          %p
            Now that
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            are phrased in terms of
            %a.existingWikiWord{:href => "/nlab/show/ends"} ends
            (example
            = succeed ")," do
              %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
            = succeed ")," do
              %a.maruku-ref{:href => "#YonedaReductionTopological"}
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dual
            statement involving
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/coends"} coends
          #TopologicalCoYonedaLemma.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"}> co-Yoneda lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              ). For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\to Top^{\ast/}_{cg}
              a pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctor"}> def.
              ) and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
              an object, there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(-)
                    \\simeq
                    \\overset{c \in \mathcal{C}}{\int}
                    \\mathcal{C}(c,-) \wedge F(c)
                    \\,.
            %p
              Moreover, the morphism that hence exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              as the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of the two morphisms in def.
              %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              is componentwise the canonical action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(d,c) \wedge F(c)
                    \\longrightarrow
                    F(d)
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              to the component map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(d,c) \to Maps(F(c),F(d))_{\ast}
              of the
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#MMSS00"} MMSS 00, lemma 1.6
          .proof
            %h6#proof_2 Proof
            %p
              The coequalizer of pointed topological spaces that we need to consider has underlying it a coequalizer of underlying pointed sets (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ,
              = succeed "," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LimitsAndColimitsOfPointedObjects"} prop.
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#kTopIsCoreflectiveSubcategory"} prop.
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LimitsAndColimitsOfPointedObjects"} prop.
            %p
              That is just the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{}{\to} c_0,\; x \in F(c) )
                    \\,,
            %p where two such pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mover
                      %mo →
                      %mi g
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{f}{\to} c_0,\; x \in F(c) )
                    \\,,\;\;\;\;
                    ( d \overset{g}{\to} c_0,\; y \in F(d) )
            %p are regarded as equivalent if there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %mi d
                  %annotation{:encoding => "application/x-tex"}
                    c \overset{\phi}{\to} d
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi g
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = g \circ \phi
                    \\,,
                    \\;\;\;\;\;and\;\;\;\;\;
                    y = \phi(x)
                    \\,.
            %p
              (Because then the two pairs are the two images of the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,x)
              under the two morphisms being coequalized.)
            %p
              But now considering the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} d = c_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} g = id_{c_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} f = \phi
              shows that any pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{\phi}{\to} c_0, \; x \in F(c))
            %p is identified, in the coequalizer, with the pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (id_{c_0},\; \phi(x) \in F(c_0))
                    \\,,
            %p
              hence with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x)\in F(c_0)
            %p
              This shows the claim at the level of the underlying sets. To conclude it is now sufficient (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ) to show that the topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F(c_0) \in Top^{\ast/}_{cg}
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#InitialAndFinalTopologies"}> def.
              ) of the system of component morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mover
                      %mo ∫
                      %mi c
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(d,c) \wedge F(c)
                    \\longrightarrow
                    \\overset{c}{\int} \mathcal{C}(c,c_0) \wedge F(c)
            %p which we just found. But that system includes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(c,c) \wedge F(c) \longrightarrow F(c)
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    id \;\colon\; F(c) \longrightarrow \mathcal{C}(c,c) \wedge F(c)
                    \\longrightarrow F(c)
            %p
              and so if all the preimages of a given subset of the coequalizer under these component maps is open, it must have already been open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(c)
          .num_remark
            %h6#remark Remark
            %p
              The statement of the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              in prop.
              %a.maruku-ref{:href => "#TopologicalCoYonedaLemma"}
              is a kind of
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
              of the following statement in
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
              (whence the notation with the integral signs):
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon X \to\mathbb{R}
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta(-,x_0)
              denoting the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+distribution"} Dirac distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{x \in X} \delta(x,x_0) f(x)
                    \=
                    f(x_0)
                    \\,.
          %p It is this analogy that gives the name to the following statement:
          #CoendsCommuteWithEachOther.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fubini+theorem"} Fubini theorem
                for (co)-ends)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              a pointed topologically enriched
              %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
              on a small pointed topological
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo ×
                    %msub
                      %mi 𝒞
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_1 \times \mathcal{C}_2
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#OppositeAndProductOfPointedTopologicallyEnrichedCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mi 𝒞
                          %mn 1
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 2
                        %mo )
                      %mi op
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo ×
                    %msub
                      %mi 𝒞
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\;\colon\;
                    \\left(
                    \\mathcal{C}_1\times\mathcal{C}_2
                    \\right)^{op}
                    \\times
                    (\mathcal{C}_1 \times\mathcal{C}_2)
                    \\longrightarrow
                    Top^{\ast/}_{cg}
            %p
              then its
              %a.existingWikiWord{:href => "/nlab/show/end"} end
              and
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              (def.
              = succeed ")" do
