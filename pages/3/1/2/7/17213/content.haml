                    %mo ,
                    %msub
                      %mi μ
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu_A, e_A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msub
                      %mi μ
                      %mi E
                    %mo ,
                    %mi e
                    %msub
                      %mo ′
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu_E, e'_E)
              are two commutative monoids in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
