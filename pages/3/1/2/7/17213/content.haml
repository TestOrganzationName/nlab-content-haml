              and alll
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                  %annotation{:encoding => "application/x-tex"} \mu_{x,y}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is called a
