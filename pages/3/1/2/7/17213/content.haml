                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topological
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊗
                        %mi 𝒞
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
