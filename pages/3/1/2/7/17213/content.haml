                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
