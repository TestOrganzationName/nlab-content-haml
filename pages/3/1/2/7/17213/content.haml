          .proof
            %h6#proof_5 Proof
            %p
              A homomorphism out of a free
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi C
                    %mo ⟶
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; A\otimes C \longrightarrow N
            %p
              fitting into the diagram (where we are notationally suppressing the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi f
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi μ
                                  %mo ⊗
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A \otimes C
                    \&amp;\overset{A \otimes f}{\longrightarrow}&amp;
                    A \otimes N
                    \\\
                    {}^{\mathllap{\mu \otimes id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\rho}}
                    \\\
                    A \otimes C
                    \&amp;\underset{f}{\longrightarrow}&amp;
                    N
                    }
                    \\,.
            %p Consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi ℓ
                          %mi C
                    %mn 1
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ⊗
                        %mi id
                    %mi A
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mi f
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde f
                    \\;\colon\;
                    C
                    \\underoverset{\simeq}{\ell_C}{\longrightarrow}
                    1 \otimes C
                    \\overset{e\otimes id}{\longrightarrow}
                    A \otimes C
                    \\overset{f}{\longrightarrow}
                    N
                    \\,,
            %p
              i.e. the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to the unit “in”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
