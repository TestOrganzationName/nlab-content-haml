                    \\overset{\mu \otimes id}{\longrightarrow}
                    A \otimes C
                    \\,.
            %p
              The
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            %p
