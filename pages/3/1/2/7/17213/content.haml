                    %mi Seq
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Exc(Top_{cg})
                    \\overset{orth^\ast}{\longrightarrow}
                    [Orth,Top^{\ast/}_{cg}]
                    \\overset{sym^\ast}{\longrightarrow}
                    [Sym,Top^{\ast/}_{cg}]
                    \\overset{seq^\ast}{\longrightarrow}
                    [Seq,Top^{\ast/}_{cg}]
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                    %mo ≔
                    %msup
                      %mi orth
                      %mo *
                    %msub
                      %mi 𝕊
                      %mi exc
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mo ≔
                    %msup
                      %mi sym
                      %mo *
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi Seq
                    %mo ≔
                    %msup
                      %mi seq
                      %mo *
                    %msub
                      %mi 𝕊
                      %mi sym
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Orth} \coloneqq orth^\ast \mathbb{S}_{exc}
                    \\,,
                    \\;
                    \\mathbb{S}_{Sym} \coloneqq sym^\ast \mathbb{S}_{orth}
                    \\,,
                    \\;
                    \\mathbb{S}_{Seq} \coloneqq seq^\ast \mathbb{S}_{sym}
            %p
              for the restriction of the excisive functor incarnation of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              (from def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FinitePointedCWComplexes"}
          .num_remark
            %h6#remark_5 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi exc
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{exc}
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              with repect to the
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              product on pre-excisive functors, and since it is therefore canonically a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              = succeed "," do
                %a.maruku-ref{:href => "#PullbackAlongLaxMonoidalFunctorPreservesMonoidsForDayConvolution"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi orth
                  %annotation{:encoding => "application/x-tex"} orth
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sym
                  %annotation{:encoding => "application/x-tex"} sym
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functors"} braided monoidal functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              is not braided, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{sym}
              are commutative monoids, but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Seq}
              is not commutative.
            %table
              %thead
                %tr
                  %th
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕊
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi Orth
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi Sym
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi Seq
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Seq}
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} yes
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} no
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  %td{:style => "text-align: left;"} yes
                  %td{:style => "text-align: left;"} no
                  %td{:style => "text-align: left;"} no
                  %td{:style => "text-align: left;"} no
          %p
            Therefore we may consider
            %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
            over the restrictions of
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            from def.
            = succeed "." do
              %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
          #HighlyStructuredSpectraAsDayConvolutionSModules.num_prop
            %h6#proposition_14 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi Orth
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Seq}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              and
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              (in
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                    %mi Mod
                    %mo ≃
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Orth} Mod \simeq OrthSpec(Top_{cg})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mi Mod
                    %mo ≃
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Sym} Mod \simeq SymSpec(Top_{cg})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Seq
                    %mi Mod
                    %mo ≃
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Seq} Mod \simeq SeqSpec(Top_{cg})
                    \\,.
          .proof
            %h6#proof_13 Proof
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi dia
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}
              for any of the three monoids. By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/modules+over+monoidal+functors"} modules over monoidal functors
              over the monoidal functor corresponding to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi dia
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Seq}
              they are functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Sym
                    %mo ⟶
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} X \colon Sym \longrightarrow sSet^{\ast/}
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Seq
                      %mo ⟶
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} X \colon Seq \longrightarrow sSet^{\ast/}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi p
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \wedge X_p   \longrightarrow X_{p+q}
            %p
              satisfying the evident
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              property. In the present case this action property says that these morphisms are determined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi p
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \wedge X_p  \longrightarrow X_{p+1}
            %p
              under the isomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi p
                      %mo ≃
                      %msup
                        %mi S
                        %mn 1
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi p
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^p \simeq S^1 \wedge S^{p-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              is the equivariance under the symmetric group actions in the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            %p
              Similarly, modules over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth}
              are equivalently functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi W
                    %mo ∧
                    %msub
                      %mi X
                      %mi V
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi V
                        %mo ⊕
                        %mi W
                  %annotation{:encoding => "application/x-tex"}
                    S^W \wedge X_V   \longrightarrow X_{V \oplus W}
            %p
              etc. and their functoriality embodies the
              = succeed "-equivariance" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
          %h3#for_orthogonal_spectra For orthogonal spectra
          %p
            Consider the non-full inclusion of
            %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Orth
                  %mo ↪
                  %msubsup
                    %mi Top
                    %mrow
                      %mi cg
                      %mo ,
                      %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  Orth \hookrightarrow Top^{\ast/}_{cg,fin}
          %p
            on the standard
            %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mo ∧
                          %mi n
                  %annotation{:encoding => "application/x-tex"} S^n \coloneqq (S^1)^{\wedge^n}
            %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            given by the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
            with basepoint adjoint, acting on these spheres as their canonical
            %a.existingWikiWord{:href => "/nlab/show/representation+spheres"} representation spheres
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Orth
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ,
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi O
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo +
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi n
                              %mn 1
                            %mo =
                            %msub
                              %mi n
                              %mn 2
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mi otherwise
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Orth(S^{n_1}, S^{n_2})
                  \\coloneqq
                  \\left\{
                  \\array{
                  O(n_1)_+ &amp; if \; n_1= n_2
                  \\\
                  \\ast &amp; otherwise
                  }
                  \\right.
                  \\,.
          %p
            Regard Orth as a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            with monoidal structure induced form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo ,
                  %mo ∧
                  %mo ,
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Top^{\ast/}_{cg}, \wedge, S^0)
            (via example
            = succeed ")" do
              %a.maruku-ref{:href => "#TopAsASymmetricMonoidalCategory"}
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
          %p
            Restricting the standard pre-excisive model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y(S^0)
            of the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            yields
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y(S^0)
            is the tensor unit and hence canonically a monoid, prop.
            %a.maruku-ref{:href => "#PullbackAlongLaxMonoidalFunctorPreservesMonoidsForDayConvolution"}
            says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi orth
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            is still a commutative monoid with respect to Day convolution:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CMon
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi Top
                    %mrow
                      %mi cg
                      %mo ,
                      %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo ,
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mo ⊗
                    %mi Day
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi CMon
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi Orth
                  %mo ,
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mo ⊗
                    %mi Day
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CMon([Top^{\ast/}_{cg,fin}, Top^{\ast/}_{cg}], \otimes_{Day}, y(S^0))
                  \\longrightarrow
                  CMon([Orth, Top^{\ast/}_{cg}], \otimes_{Day}, y(S^0))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝕊
                    %mi exc
                  %mo ,
                  %mi μ
                  %mo =
                  %mi id
                  %mo ,
                  %mi e
                  %mo =
                  %mi id
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝕊
                    %mi orth
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\mathbb{S}_{exc},\mu = id,e = id) \mapsto (\mathbb{S}_{orth}, \mu, e)
                  \\,.
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            is the category of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            = succeed "):" do
              %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi OrthSpec
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi 𝕊
                            %mi orth
                          %mi Mod
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %msubsup
                            %mi Top
                            %mrow
                              %mi cg
                              %mo ,
                              %mi fin
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                          %mo ,
                          %msubsup
                            %mi Top
                            %mi cg
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  OrthSpec(Top_{cg})
                  \&amp;=
                  \\mathbb{S}_{orth}Mod( [Top^{\ast/}_{cg,fin}, Top^{\ast/}_{cg}] )
                  \\end{aligned}
                  \\,,
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi orth
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            is a commutative monoid, prop.
            %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
            says that there is a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi orth
                %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{S}_{orth}}
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} OrthSpec(Top_{cg})
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
            for orthogonal spectra.
          %p
            An orthogonal
            %em
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a monoid with respect to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi orth
                  %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{S}_{orth}}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth}
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#AAlgebra"}
            = succeed "," do
              %a.maruku-ref{:href => "#AlgebrasOverAAreMonoidsUnderA"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is equivalently a monoid with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi Day
                %annotation{:encoding => "application/x-tex"} \otimes_{Day}
            and equipped with a monoid homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{orth} \longrightarrow E
            %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
            this is equivalently a functor with smash products
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Orth
                  %mo ⟶
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  E \;\colon\; Orth \longrightarrow Top^{\ast/}_{cg}
          %p equipped with a natural transformation of functors with smash product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi orth
                  %mo ⟶
                  %mi E
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S}_{orth} \longrightarrow E
                  \\,.
          %p
            In the terminology of
            %a{:href => "#MMSS00"} MMSS 00, def. 22.5
            this is an “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Orth
                %annotation{:encoding => "application/x-tex"} Orth
            \-FSP over
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth}
          %h3#symmetric_spectra Symmetric spectra
          %p Restrict further along the non-full inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo ↪
                  %mi Orth
                  %mo ↪
                  %msubsup
                    %mi Top
                    %mrow
                      %mi cg
                      %mo ,
                      %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Sym \hookrightarrow Orth \hookrightarrow Top^{\ast/}_{cg,fin}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                %annotation{:encoding => "application/x-tex"} Sym
            has the same objects, but the
            %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            are now just the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
            (with basepoint adjoint)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi n
                  %mo ↪
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma_n \hookrightarrow O(n)
                  \\,.
          %p Then proceed as for orthogonal spectra.
          %h3#for_sequential_spectra_nonexample For sequential spectra (non-example)
          %p Restrict further along
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Seq
                  %mo ↪
                  %mi Sym
                  %mo ↪
                  %mi Orth
                  %mo ↪
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Seq \hookrightarrow Sym \hookrightarrow Orth \hookrightarrow Top^{\ast/}_{cg}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Seq
                %annotation{:encoding => "application/x-tex"} Seq
            still has the same objects, the
            = succeed "-spheres," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Now the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Seq
                  %mo ⟶
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Seq \longrightarrow Top^{\ast/}_{cg}
            is no longer a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Seq
                %annotation{:encoding => "application/x-tex"} Seq
            is trivial, while on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Top
                    %mi cg
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
            it is not. Accordingly the assumption of the second clause in prop.
            %a.maruku-ref{:href => "#PullbackAlongLaxMonoidalFunctorPreservesMonoidsForDayConvolution"}
            is vialoted.
          %p
            Indeed, restricting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            along this inclusion yields the stndard sequential
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi seq
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
            which is still a monoid with respect to Day convolution, but not a commutative monoid anymore (see at
            = succeed ")" do
              %a{:href => "smash+product+of+spectra#GradedCommutativity"} smash product of spectra – graded commutativity
            %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
            is violated.
          %p
            The
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
            %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ModulesInMonoidalCategory"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
          %p
            But since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi seq
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}
            is not a commutative monoid, the assumption of prop.
            %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
            there is no induced tensor product on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕊
                    %mi seq
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} \mathbb{S}_{seq}Mod
            and hence the story ends here.
          %h2#examples_2 Examples
          %ul
            %li
              The
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
              naturally arises in FSP-form, see
              = succeed "." do
                %em
                  %a{:href => "Thom+spectrum#RingSpectrumStructure"} Thom spectrum – Properties – Ring spectrum structure
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symmetric+ring+spectrum"} symmetric ring spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
          %h2#reference Reference
          %p
            The concept was introduced (before
            %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+products+of+spectra"} symmetric smash products of spectra
            had been found) in
          %ul
            %li{:id => "B&#246;kstedt86"}
              %a.existingWikiWord{:href => "/nlab/show/Marcel+B%C3%B6kstedt"}> Marcel Bökstedt
              ,
              = succeed "." do
                %em Topological Hochschild homology
          %p Restricted to spheres as “FSPs defined on spheres” they were considered in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lars+Hesselholt"}> Lars Hesselholt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ib+Madsen"} Ib Madsen
              %em On the K-theory of finite algebras over Witt vectors of perfect fields
              (
              %a{:href => "http://www.math.uiuc.edu/K-theory/0055/"}> K-theory
              ).
          %p
            and identified there as the monoids in
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            as previously introduced by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"} Jeff Smith
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+excisive+functors"} model structure for excisive functors
            the concept was recovered in
          %ul
            %li#Lydakis98
              Lydakis,
              %em Simplicial functors and stable homotopy theory
              Preprint, available via Hopf archive, 1998 (
              %a{:href => "http://hopf.math.purdue.edu/Lydakis/s_functors.pdf"}> pdf
              )
          %p
            and in the model of
            %a.existingWikiWord{:href => "/nlab/show/connective+spectra"} connective spectra
            by
            %a.existingWikiWord{:href => "/nlab/show/Gamma-spaces"} Gamma-spaces
            in
          %ul
            %li#Lydakis98b
              Lydakis,
              = succeed "," do
                %em
                  Smash products and
                  = succeed "-spaces" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a{:href => "http://hopf.math.purdue.edu/Lydakis/smash_gamma.pdf"} pdf
          %p A systematic account is in
          %ul
            %li#MMSS00
              %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"}> Michael Mandell
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
              = succeed "," do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/mmssLMSDec30.pdf"} pdf
              = succeed ")" do
                %a{:href => "http://plms.oxfordjournals.org/content/82/2/441.short?rss=1&ssource=mfc"} publisher
          %p Based on discussion in
          %ul
            %li#EKMM97
              %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              %em Rings, modules and algebras in stable homotopy theory
              1997 (
              %a{:href => "www.math.uchicago.edu/~may/BOOKS/EKMM.pdf"}> pdf
              )
