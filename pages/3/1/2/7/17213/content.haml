                    \\,.
          .num_example
            %h6#example_8 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Seq
                  %annotation{:encoding => "application/x-tex"} Seq
              denote the category with objects the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
              and
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              on these objects:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Seq
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mn 0
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi n
                                %mn 1
                              %mo =
                              %msub
                                %mi n
                                %mn 2
                          %mtr
                            %mtd
                              %mo *
                            %mtd
