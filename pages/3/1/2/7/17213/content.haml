                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}} )
              are equipped with the structure of
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
              (def.
              = succeed ")," do
