          %h3#AlgebrasAndModules Algebras and modules
          #MonoidsInMonoidalCategory.num_defn
            %h6#definition_8 Definition
            %p
              Given a (pointed)
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topological
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              %strong
                %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid internal to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              is
            %ol
              %li
