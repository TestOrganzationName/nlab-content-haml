              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              if in addition the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
              for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} x,y \in \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
