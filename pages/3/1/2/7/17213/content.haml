              coequalizes the two induced morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ⊗
                      %mi A
                      %mo ⊗
                      %mi E
                      %munderover
                        %mphantom
                          %mi AA
                        %mo ⟶
                        %mo ⟶
                      %mi E
                      %mo ⊗
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E \otimes A \otimes E \underoverset{\longrightarrow}{\longrightarrow}{\phantom{AA}} E \otimes E
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              gives a factorization through some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mrow
                          %mi E
