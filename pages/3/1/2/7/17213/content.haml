                    \&amp;&amp;\underset{f(1_{\mathcal{C}})}{\longrightarrow}&amp;&amp;
                    F_2(1_{\mathcal{C}})
                    }
                    \\,.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MonFun
                    %mo{:stretchy => "false"} (
