              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
