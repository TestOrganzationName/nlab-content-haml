                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi Y
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {\underset{[Y,-]}{\longrightarrow}}
                    {\overset{(-) \otimes Y}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
                    \\,,
            %p
              hence if there are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(X \otimes Y, Z)
                    \\;\simeq\;
                    Hom_{\mathcal{C}}{C}(X, [Y,Z])
            %p
              for all objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Z
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X,Z \in \mathcal{C}
            %p
              Since for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X = 1
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(1,[Y,Z]) \simeq Hom_{\mathcal{C}}(Y,Z)
                    \\,,
            %p
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} [Y,Z] \in \mathcal{C}
              is an enhancement of the ordinary
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(Y,Z)
              to an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
          #TopAsASymmetricMonoidalCategory.num_example
            %h6#example_3 Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              and
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              between them, regarded as enriched in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              according to def.
              %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                  %annotation{:encoding => "application/x-tex"} \times
              of sets. The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              and
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              isomorphism are the evident (almost unnoticable but nevertheless nontrivial) canonical identifications.
            %p
              Similarly the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              of
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#kTop"}> def.
              ) becomes a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#kTopIsCoreflectiveSubcategory"} cor.
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ProductTopologicalSpace"}> exmpl.
              ). The underlying functions of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              and
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              isomorphisms are just those of the underlying sets, as above.
            %p
              Symmetric monoidal categories, such as these, for which the tensor product is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              are called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+monoidal+categories"} Cartesian monoidal categories
          #PointedTopologicalSpacesWithSmashIsSymmetricMonoidalCategory.num_example
            %h6#example_4 Example
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top_{cg}^{\ast/}
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#SmashProductOfPointedObjects"}> def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ≔
                    %mfrac
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                      %mrow
                        %mi X
                        %mo ∨
                        %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X \wedge Y \coloneqq \frac{X\times Y}{X\vee Y}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
              the pointed
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S^0
            %p
              The components of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
              and the
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              are those of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#TopAsASymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+spaces"} quotient topological spaces
              which appear in the definition of the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+spaces"} compactly generated spaces
              (but not for general pointed topological spaces) by
              = succeed "." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#SmashProductInTopcgIsAssociative"} this prop.
          #ExampleAbelianGroupsOfMonoidalCategory.num_example
            %h6#example_5 Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              with tensor product the actual
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{Z}}
              and with
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              the additive group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              and
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              isomorphism are the evident ones coming from the underlying sets, as in example
              = succeed "." do
                %a.maruku-ref{:href => "#TopAsASymmetricMonoidalCategory"}
            %p
              This is the archetypical case that motivates the notation “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              ” for the pairing operation in a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid in
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  An
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Ab, \otimes_{\mathbb{Z}}, \mathbb{Z})
                  (def.
