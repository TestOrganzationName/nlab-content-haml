                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C},Top^{\ast/}_{cg}]
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedTopologicalFunctorCategory"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
