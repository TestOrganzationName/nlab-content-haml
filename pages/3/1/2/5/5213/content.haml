            is the
            %a.existingWikiWord{:href => "/nlab/show/little+topos"} little topos
            of
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
