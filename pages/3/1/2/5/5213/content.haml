              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is equivalent to its
              %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
              this is also equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %h2#products_of_function_objects Products of function objects
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %mi Ψ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \psi : \Psi \to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi Φ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi : \Phi \to X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            two function objects on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo ×
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \psi \times \phi
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            we call the
            = succeed "." do
              %strong product of function objects
          %p
            This is computed in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            as the
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %msup
                    %mo ×
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mi ϕ
                  %mo =
                  %mi Ψ
                  %msubsup
                    %mo ×
                    %mi X
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %mi Φ
                %annotation{:encoding => "application/x-tex"}
                  \\psi \times^{\mathbf{H}/X} \phi = \Psi \times^{\mathbf{H}}_X \Phi
          %p
            and the morphism down to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the evident projection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Ψ
                          %msubsup
                            %mo ×
                            %mi X
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mi Φ
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi Ψ
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi ψ
                              %msup
                                %mo ×
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mo{:stretchy => "false"} /
                                  %mi X
                              %mi ϕ
                        %mtd
                        %mtd
                          %mi Φ
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ψ
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi ϕ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \Psi \times_{X}^{\mathbf{H}} \Phi
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\Psi &amp;&amp;\downarrow^{\psi \times^{\mathbf{H}/X} \phi}&amp;&amp; \Phi
                  \\\
                  \&amp; {}_{\mathllap{\psi}}\searrow &amp;&amp; \swarrow_{\mathrlap{\phi}}
                  \\\
                  \&amp;&amp; X
                  }
                  \\,.
          .un_example
            %h6#example_3 Example
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              we have that the
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo ⋅
                    %mi ϕ
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} |
                    %mi ϕ
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    |\psi \cdot \phi| : x \mapsto |\psi|(x) \cdot |\phi|(x)
                    \\,.
          %h2#fiber_integration Fiber integration
          %p
            For every
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} v : X \to Y
            in the ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            there is the corresponding
            %a.existingWikiWord{:href => "/nlab/show/base+change+geometric+morphism"} base change geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mo !
                  %mo ⊣
                  %msup
                    %mi v
                    %mo *
                  %mo ⊣
                  %msub
                    %mi v
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mover
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi v
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi v
                            %mo *
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi v
                          %mo !
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  (v_! \dashv v^* \dashv v_*)
                  \:
                  \\mathbf{H}/X
                  \\stackrel{\overset{v_!}{\to}}{\stackrel{\overset{v^*}{\leftarrow}}{\underset{v_*}{\to}}}
                  \\mathbf{H}/Y
          %p
            between the corresponding
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mo !
                %annotation{:encoding => "application/x-tex"} v_!
            acts simply by postcomposition with
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mo !
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Ψ
                  %mover
                    %mo →
                    %mi ψ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi Ψ
                  %mover
                    %mo →
                    %mi ψ
                  %mi X
                  %mover
                    %mo →
                    %mi v
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  v_! : (\Psi \stackrel{\psi}{\to} X) \mapsto (\Psi \stackrel{\psi}{\to} X \stackrel{v}{\to} Y)
          %p
            while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mo *
                %annotation{:encoding => "application/x-tex"} v^*
            acts by
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            along
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mo *
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Φ
                  %mover
                    %mo →
                    %mi ϕ
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo ×
                    %mi Y
                  %mi Φ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  v^* : (\Phi \stackrel{\phi}{\to} Y) \mapsto (X \times_Y \Phi)
                  \\,.
          %p
            There is a further
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mo *
                  %annotation{:encoding => "application/x-tex"} v_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mo !
                %annotation{:encoding => "application/x-tex"} v_!
            as well as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mo *
                %annotation{:encoding => "application/x-tex"} v^*
            are
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            %a.existingWikiWord{:href => "/nlab/show/Pr%28%E2%88%9E%2C1%29Cat"} Pr(∞,1)Cat
            and hence behave like linear maps on our function spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/Y
          %p
            When we think of
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            in the context of linear algebra on sheaves, we shall write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi Y
                  %mo :
                  %mo =
                  %msub
                    %mi v
                    %mo !
                %annotation{:encoding => "application/x-tex"} \int_{X/Y}  := v_!
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi Y
                  %mo ⊣
                  %msup
                    %mi v
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mover
                    %munder
                      %mo ←
                      %mrow
                        %msup
                          %mi v
                          %mo *
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∫
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi Y
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  (\int_{X/Y} \dashv v^*) :
                  \\mathbf{H}/X
                  \\stackrel{\overset{\int_{X/Y}}{\to}}{\underset{v^*}{\leftarrow}}
                  \\mathbf{H}/Y
          %p
            and call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi Y
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \int_{X/Y} \psi
            the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over the fibers of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} Y = *
            is the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            we write simply
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mi ψ
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\int_X \psi \in \mathbf{H}
          %p
            for the
            %strong integral
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            with values in the ambient
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+distribution"} Lawvere distribution
          .un_example
            %h6#example_4 Example
            %p
              Consider the ordinary
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              any set the unique
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} v : X \to *
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi Ψ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \psi : \Psi \to X
              a function object with underlying function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi Ψ
                      %mi x
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \psi : x \mapsto |\Psi_x|
              we have that the integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi X
                    %mi ψ
                    %mo :
                    %mi Ψ
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\int_X \psi : \Psi \to *
            %p has as underlying function the constant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mo ∫
                      %mi X
                    %mi ψ
                    %mo{:stretchy => "false"} |
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mo{:stretchy => "false"} |
