            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi FinSet
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    |-| : FinSet \to \mathbb{N}
            %p
              we think of this as the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo{:stretchy => "false"} |
