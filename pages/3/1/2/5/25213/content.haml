                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \vert x \vert \coloneqq \max(x, -x)
            %p
