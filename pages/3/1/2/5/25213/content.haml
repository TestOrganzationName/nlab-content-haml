                          %mi ℤ
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mi x
                    %mo ,
                    %mn 0
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
