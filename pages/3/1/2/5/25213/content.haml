            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ÷
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
