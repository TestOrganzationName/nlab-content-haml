                  %annotation{:encoding => "application/x-tex"} \mathrm{labsorp}_\mathbb{Z} \equiv \mathrm{ind}_\mathbb{Z}^{x:\mathbb{Z}.x \cdot 0 =_\mathbb{Z} 0}(\beta_\mathbb{Z}^{\cdot, 0, 0}, \lambda x:\mathbb{Z}.\mathrm{transport}_{x:\mathbb{Z}.x =_\mathbb{Z} 0}(0 \cdot x, 0 \cdot s(x), \beta_\mathbb{Z}^{\cdot, 0, s}(x)^{-1})):\prod_{x:\mathbb{Z}} 0 \cdot x =_\mathbb{Z} 0
            %p Similarly, for the right absorption law, we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \cdot 0 =_{\mathbb{Z}} 0) \simeq (s(x) \cdot 0 =_{\mathbb{Z}} 0)
            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
              across the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, s, 0}(x)^{-1}:x \cdot 0 =_\mathbb{Z} s(x) \cdot 0
            %p
              for the type family
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
