            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} transport
                      %mrow
                        %mi x
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi x
                        %msub
