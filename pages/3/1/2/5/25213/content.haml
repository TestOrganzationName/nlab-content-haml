                    %mi ℤ
                    %mo ×
                    %mi ℤ
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \max:\mathbb{Z} \times \mathbb{Z} \to \mathbb{Z}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
