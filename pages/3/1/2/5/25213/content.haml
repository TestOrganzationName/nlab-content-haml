          .num_theorem
            %h6 Theorem
            %p
              The integers type is a non-coherent
              %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
              with respect to the zero integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 0:\mathbb{Z}
              found in the
              %a.existingWikiWord{:href => "/nlab/show/introduction+rule"} introduction rule
              of the integers type and addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo ,
                    %mi y
                    %mo :
                    %mi ℤ
                    %mo ⊢
                    %mi x
                    %mo +
                    %mi y
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}, y:\mathbb{Z} \vdash x + y:\mathbb{Z}
              defined above.
          %p
          .proof
            %h6 Proof
            %p
              We define the
              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              for the
              %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
              structure of the integers type by induction on the integers type. For the case with the element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} 0:\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo :
                    %mn 0
                    %mo +
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{+, 0, 0}:0 + 0 =_\mathbb{Z} 0
              from the rules for addition. For the case with the equivalence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi ℤ
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} s:\mathbb{Z} \simeq \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is itself a dependent function of a family of equivalences,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi ℤ
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{s}:\prod_{y:\mathbb{Z}} \prod_{x:\mathbb{Z}} (y =_\mathbb{Z} x) \simeq (s(y) =_\mathbb{Z} s(x))
            %p
              Substituting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo +
                    %mi x
