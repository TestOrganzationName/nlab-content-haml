                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi z
                      %msub
                        %mo =
                        %mi ℤ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} s(0) \cdot z =_\mathbb{Z} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} transport
                      %mrow
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi z
                        %msub
                          %mo =
                          %mi ℤ
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} rinv
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
