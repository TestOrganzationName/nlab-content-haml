                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ÷
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -i(n) \div i(m) \coloneqq -i(n \div m)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ÷
