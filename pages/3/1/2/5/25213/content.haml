                    %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
          %h3#division_and_remainder Division and remainder
          .num_defn
            %h6#definition_22 Definition
            %p
              %strong Integer division
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
