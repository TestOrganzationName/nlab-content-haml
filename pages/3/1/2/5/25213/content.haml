          %h3#pseudolattice_and_metric_structure_on_the_integers Pseudolattice and metric structure on the integers
          .num_defn
            %h6#definition_17 Definition
            %p
              The
              %strong ramp function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ramp
                    %mo :
                    %mi ℤ
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathrm{ramp}:\mathbb{Z} \to \mathbb{Z}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ramp}(i(n)) \coloneqq i(n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{ramp}(-(i(n) + 1)) \coloneqq 0
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
          .num_defn
            %h6#definition_18 Definition
            %p
              The
              %strong minimum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi min
                    %mo :
                    %mi ℤ
                    %mo ×
                    %mi ℤ
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \min:\mathbb{Z} \times \mathbb{Z} \to \mathbb{Z}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi min
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi x
                    %mo −
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \min(x,y) \coloneqq x - \mathrm{ramp}(x - y)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} y:\mathbb{Z}
          .num_defn
            %h6#definition_19 Definition
            %p
              The
              %strong maximum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi max
