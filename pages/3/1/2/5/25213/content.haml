                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{transport}_{x:\mathbb{Z}.x =_\mathbb{Z} 0}(x \cdot 0, s(x) \cdot 0, \beta_\mathbb{Z}^{\cdot, s, 0}(x)^{-1}):(x \cdot 0 =_{\mathbb{Z}} 0) \simeq (s(x) \cdot 0 =_{\mathbb{Z}} 0)
            %p Thus, by induction on the integers, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo ≡
                    %msubsup
                      %mi{:mathvariant => "normal"} ind
                      %mi ℤ
                      %mrow
                        %mi x
                        %mo :
                        %mi ℤ
                        %mn .0
                        %mo ⋅
                        %mi x
                        %msub
                          %mo =
                          %mi ℤ
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo ,
                    %mi λ
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo .
