                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{rinv}_s:\prod_{x:\mathbb{Z}} s(s^{-1}(x)) =_\mathbb{Z} x
            %p
              so by
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
              across the identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rinv
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{rinv}_s(x)
              for the type family
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
