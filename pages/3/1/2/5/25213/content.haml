          .num_theorem
            %h6 Theorem
            %p
              The integers type is an
              %a.existingWikiWord{:href => "/nlab/show/absorption+magma"} absorption magma
              with respect to the zero integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 0:\mathbb{Z}
              and multiplication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo ,
                    %mi y
                    %mo :
                    %mi ℤ
                    %mo ⊢
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}, y:\mathbb{Z} \vdash x \cdot y:\mathbb{Z}
              defined above.
          %p
          .proof
            %h6 Proof
            %p
              We begin with the left absorption law, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ⋅
                    %mi x
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \cdot x =_\mathbb{Z} 0
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo :
                    %mn 0
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, 0, 0}:0 \cdot 0 =_{\mathbb{Z}} 0
            %p
              Then we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
              we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mi x
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0 \cdot x =_{\mathbb{Z}} 0) \simeq (0 \cdot s(x) =_{\mathbb{Z}} 0)
            %p
              But that’s given by
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
              across the identification
