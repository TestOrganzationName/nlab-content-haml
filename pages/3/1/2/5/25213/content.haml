                              %mo :
                              %mi ℤ
                              %mo .
                              %mi x
                              %mo ⋅
                              %mi z
                              %msub
                                %mo =
                                %mi ℤ
                              %mi x
                              %mo ⋅
                              %mi y
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo +
                          %mn 0
                          %mo ,
                          %mi y
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} runitadd
                            %mi ℤ
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %msub
                            %mi{:mathvariant => "normal"} transport
                            %mrow
                              %mi z
                              %mo :
                              %mi ℤ
                              %mo .
                              %mi x
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo +
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo =
                                %mi ℤ
                              %mi z
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ⋅
                          %mi y
                          %mo +
                          %mn 0
                          %mo ,
                          %mi x
                          %mo ⋅
                          %mi y
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} runitadd
                            %mi ℤ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ⋅
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo ∘
                          %msub
                            %mi{:mathvariant => "normal"} transport
                            %mrow
                              %mi z
                              %mo :
                              %mi ℤ
                              %mo .
                              %mi x
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo +
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo =
                                %mi ℤ
                              %mi x
                              %mo ⋅
                              %mi y
                              %mo +
                              %mi z
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ⋅
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} rabsorp
                            %mi ℤ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo +
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mi ℤ
                          %mi x
                          %mo ⋅
                          %mi y
                          %mo +
                          %mi x
                          %mo ⋅
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mi ℤ
                          %mi x
                          %mo ⋅
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi x
                          %mo ⋅
                          %mn 0
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{c}
                    \\mathrm{rdist}_\mathbb{Z}^{s, 0}(x, y) \equiv \mathrm{transport}_{z:\mathbb{Z}.x \cdot (s(y) + 0) =_\mathbb{Z} x \cdot s(y) + z}(x \cdot 0, 0, \mathrm{rabsorp}_\mathbb{Z}(x)) \circ \mathrm{transport}_{z:\mathbb{Z}.x \cdot (s(y) + 0) =_\mathbb{Z} z}(x \cdot s(y) + 0, x \cdot s(y), \mathrm{runitadd}_\mathbb{Z}(x \cdot s(y)))\\
                    \\circ \mathrm{transport}_{z:\mathbb{Z}.x \cdot z =_\mathbb{Z} x \cdot y}(s(y) + 0, s(y), \mathrm{runitadd}_\mathbb{Z}(s(y))) \circ f(x, y) \\
                    \\circ \mathrm{transport}_{z:\mathbb{Z}.x \cdot z =_\mathbb{Z} x \cdot y}(y + 0, y, \mathrm{runitadd}_\mathbb{Z}(y)) \circ \mathrm{transport}_{z:\mathbb{Z}.x \cdot (y + 0) =_\mathbb{Z} z}(x \cdot y + 0, x \cdot y, \mathrm{runitadd}_\mathbb{Z}(x \cdot y)) \\
                    \\circ \mathrm{transport}_{z:\mathbb{Z}.x \cdot (y + 0) =_\mathbb{Z} x \cdot y + z}(x \cdot 0, 0, \mathrm{rabsorp}_\mathbb{Z}(x)):(x \cdot (y + 0) =_\mathbb{Z} x \cdot y + x \cdot 0) \simeq (x \cdot (s(y) = 0) =_\mathbb{Z} x \cdot s(y) + x \cdot 0)
                    \\end{array}
            %p
              Finally, we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} y:\mathbb{Z}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} z:\mathbb{Z}
              there is an equivalence of types
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo +
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \cdot (y + z) =_\mathbb{Z} x \cdot y + x \cdot z) \simeq (x \cdot (s(y) + s(z)) =_\mathbb{Z} x \cdot s(y) + x \cdot s(z))
            %p …
          %p
          .num_defn
            %h6 Definition
            %p
              The integer number
              %strong one
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1:\mathbb{Z}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≡
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1 \equiv s(0):\mathbb{Z}
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              The integers type is a
              %a.existingWikiWord{:href => "/nlab/show/unital+magma"} unital magma
              with respect to the one integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1:\mathbb{Z}
              and multiplication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo ,
                    %mi y
                    %mo :
                    %mi ℤ
                    %mo ⊢
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}, y:\mathbb{Z} \vdash x \cdot y:\mathbb{Z}
              both defined above.
          %p
          .proof
            %h6 Proof
            %p
              We begin with the right unital laws, that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⋅
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi ℤ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \cdot s(0) =_\mathbb{Z} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 0
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, 0, s}(0):0 \cdot s(0) =_{\mathbb{Z}} 0 \cdot 0
            %p
              Concatenating with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, 0, 0}
              results in the required identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo :
                    %mn 0
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, 0, s}(0) \bullet \beta_\mathbb{Z}^{\cdot, 0, 0}:0 \cdot s(0) =_{\mathbb{Z}} 0
            %p
              Then we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
              we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \cdot s(0) =_{\mathbb{Z}} x) \simeq (s(x) \cdot s(0) =_{\mathbb{Z}} s(x))
            %p We have the family of identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo ⊢
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z} \vdash \beta_\mathbb{Z}^{\cdot, s, s}(x, 0):s(x) \cdot s(0) =_{\mathbb{Z}} x \cdot 0 + s(x + 0)
            %p Since multiplication is an absorption magma, we have identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{rabsorp}_\mathbb{Z}(x):x \cdot 0 =_\mathbb{Z} 0
            %p
              so
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} application of the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi z
                    %mo :
                    %mi ℤ
                    %mo .
                    %mi z
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda z:\mathbb{Z}.z + s(x + 0)
              to the above identification results in the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi z
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\lambda z:\mathbb{Z}.z + s(x + 0)}(x \cdot 0, 0, \mathrm{rabsorp}_\mathbb{Z}(x)):x \cdot 0 + s(x + 0) =_{\mathbb{Z}} 0 + s(x + 0)
            %p The left unit law for addition results in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{lunitadd}_\mathbb{Z}(s(x + 0)):0 + s(x + 0) =_{\mathbb{Z}} s(x + 0)
            %p and application of the successor equivalence to the right unit law results in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} runitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_s(x + 0, x, \mathrm{runitadd}_\mathbb{Z}(x)):s(x + 0) =_{\mathbb{Z}} s(x)
            %p Concatenating all the identifications leads to the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi z
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 0
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} runitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
