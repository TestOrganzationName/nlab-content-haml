                  %annotation{:encoding => "application/x-tex"} \mathrm{rabsorp}_\mathbb{Z} \equiv \mathrm{ind}_\mathbb{Z}^{x:\mathbb{Z}.0 \cdot x =_\mathbb{Z} 0}(\beta_\mathbb{Z}^{\cdot, 0, 0}, \lambda x:\mathbb{Z}.\mathrm{transport}_{x:\mathbb{Z}.x =_\mathbb{Z} 0}(x \cdot 0, s(x) \cdot 0, \beta_\mathbb{Z}^{\cdot, s, 0}(x)^{-1})):\prod_{x:\mathbb{Z}} x \cdot 0 =_\mathbb{Z} 0
            %p Thus, the integers are an absorption magma with respect to zero and multiplication.
          %p
          .num_theorem
            %h6 Theorem
            %p Multiplication in the integers type is bilinear with respect to addition.
          %p
          .proof
            %h6 Proof
            %p
              We begin with bilinearity in the right parameter of multiplication, and we prove by double induction on the integers: given an integer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi x
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \cdot (0 + 0) =_\mathbb{Z} x \cdot 0 + x \cdot 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{y:\mathbb{Z}} (x \cdot (0 + y) =_\mathbb{Z} x \cdot 0 + x \cdot y) \simeq (x \cdot (0 + s(y)) =_\mathbb{Z} x \cdot 0 + x \cdot s(y))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo +
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{y:\mathbb{Z}} (x \cdot (y + 0) =_\mathbb{Z} x \cdot y + x \cdot 0) \simeq (x \cdot (s(y) + 0) =_\mathbb{Z} x \cdot s(y) + x \cdot 0)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi ℤ
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi z
                        %mo :
                        %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo +
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi x
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{y:\mathbb{Z}} \prod_{z:\mathbb{Z}} (x \cdot (y + z) =_\mathbb{Z} x \cdot y + x \cdot z) \simeq (x \cdot (s(y) + s(z)) =_\mathbb{Z} x \cdot s(y) + x \cdot s(z))
            %p
              Now, for the first type, by application of the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi z
                    %mo :
                    %mi ℤ
                    %mo .
                    %mi x
                    %mo ⋅
                    %mi z
                  %annotation{:encoding => "application/x-tex"} \lambda z:\mathbb{Z}.x \cdot z
              on the identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mi ℤ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mo ,
                          %mn 0
                          %mo ,
                          %mn 0
                      %mo :
                      %mn 0
                      %mo +
                      %mn 0
                      %msub
                        %mo =
                        %mi ℤ
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{+, 0, 0}:0 + 0 =_\mathbb{Z} 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi x
                        %mo ⋅
                        %mi z
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\lambda z:\mathbb{Z}.x \cdot z}(0 + 0, 0, \beta_\mathbb{Z}^{+, 0, 0}):x \cdot (0 + 0) =_\mathbb{Z} x \cdot 0
            %p Similarly, by the right absorption law of multiplication, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{rabsorp}_\mathbb{Z}(x):x \cdot 0 =_\mathbb{Z} 0
            %p
              and by
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} application of the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi z
                    %mo :
                    %mi ℤ
                    %mo .
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi z
                  %annotation{:encoding => "application/x-tex"} \lambda z:\mathbb{Z}.x \cdot 0 + z
              across
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} rabsorp
                        %mi ℤ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{rabsorp}_\mathbb{Z}(x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi x
                        %mo ⋅
                        %mn 0
                        %mo +
                        %mi z
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} rabsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mi x
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\lambda z:\mathbb{Z}.x \cdot 0 + z}(x \cdot 0, 0, \mathrm{rabsorp}_\mathbb{Z}(x)):x \cdot 0 + x \cdot 0 =_\mathbb{Z} x \cdot 0 + 0
            %p By the right unit law for addition, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} runitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ⋅
                    %mn 0
                    %mo +
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{runitadd}_{\mathbb{Z}}(x \cdot 0):x \cdot 0 + 0 =_{\mathbb{Z}} x \cdot 0
            %p Thus, by concatenating identifications we have
            .maruku-equation
