                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi x
                      %msub
                        %mo =
                        %mi ℤ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} s(0) \cdot x =_\mathbb{Z} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo ⋅
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, s, 0}(0):s(0) \cdot 0 =_{\mathbb{Z}} 0 \cdot 0
            %p
              Concatenating with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, 0, 0}
              results in the required identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mn 0
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, s, 0}(0) \bullet \beta_\mathbb{Z}^{\cdot, 0, 0}:s(0) \cdot 0 =_{\mathbb{Z}} 0
            %p
              Then we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z}
              we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi x
                    %msub
                      %mo =
                      %mi ℤ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s(0) \cdot x =_{\mathbb{Z}} x) \simeq (s(0) \cdot s(x) =_{\mathbb{Z}} s(x))
            %p We have the family of identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℤ
                    %mo ⊢
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo ⋅
                    %mi x
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{Z} \vdash \beta_\mathbb{Z}^{\cdot, s, s}(0, x):s(0) \cdot s(x) =_{\mathbb{Z}} 0 \cdot x + s(0 + x)
            %p Since multiplication is an absorption magma, we have identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} labsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 0
                    %mo ⋅
                    %mi x
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{labsorp}_\mathbb{Z}(x):0 \cdot x =_\mathbb{Z} 0
            %p
              so
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} application of the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi z
                    %mo :
                    %mi ℤ
                    %mo .
                    %mi z
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda z:\mathbb{Z}.z + s(0 + x)
              to the above identification results in the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi z
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo +
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mi x
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} labsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 0
                    %mo ⋅
                    %mi x
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\lambda z:\mathbb{Z}.z + s(0 + x)}(0 \cdot x, 0, \mathrm{labsorp}_\mathbb{Z}(x)):0 \cdot x + s(0 + x) =_{\mathbb{Z}} 0 + s(0 + x)
            %p The left unit law for addition results in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 0
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{lunitadd}_\mathbb{Z}(s(0 + x)):0 + s(0 + x) =_{\mathbb{Z}} s(0 + x)
            %p and application of the successor equivalence to the left unit law results in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} runitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_s(0 + x, x, \mathrm{runitadd}_\mathbb{Z}(x)):s(0 + x) =_{\mathbb{Z}} s(x)
            %p Concatenating all the identifications leads to the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi z
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo +
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mi x
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} labsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %mi x
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, s, s}(0, x) \bullet \mathrm{ap}_{\lambda z:\mathbb{Z}.z + s(0 + x)}(0 \cdot x, 0, \mathrm{labsorp}_\mathbb{Z}(x)) \bullet \mathrm{lunitadd}_\mathbb{Z}(s(0 + x)) \bullet \mathrm{ap}_s(0 + x, x, \mathrm{lunitadd}_\mathbb{Z}(x)):s(0) \cdot s(x) =_{\mathbb{Z}} s(x)
            %p
              Similarly, by substituting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s^{-1}(x)
              in for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in the above expression, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mi ℤ
                      %mrow
                        %mo ⋅
                        %mo ,
                        %mi s
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi z
                        %mo :
                        %mi ℤ
                        %mo .
                        %mi z
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo +
                        %msup
                          %mi s
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 0
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} labsorp
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo +
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} lunitadd
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta_\mathbb{Z}^{\cdot, s, s}(0, s^{-1}(x)) \bullet \mathrm{ap}_{\lambda z:\mathbb{Z}.z + s(0 + s^{-1}(x))}(0 \cdot s^{-1}(x), 0, \mathrm{labsorp}_\mathbb{Z}(s^{-1}(x))) \bullet \mathrm{lunitadd}_\mathbb{Z}(s(0 + s^{-1}(x))) \bullet \mathrm{ap}_s(0 + s^{-1}(x), s^{-1}(x), \mathrm{lunitadd}_\mathbb{Z}(s^{-1}(x))):s(0) \cdot s(s^{-1}(x)) =_{\mathbb{Z}} s(s^{-1}(x))
            %p
              In addition, we have the right inverse
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rinv
                      %mi s
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
