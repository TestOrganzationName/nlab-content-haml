                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℤ
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{transport}_{x:\mathbb{Z}.x =_\mathbb{Z} 0}(0 \cdot x, 0 \cdot s(x), \beta_\mathbb{Z}^{\cdot, 0, s}(x)^{-1}):(0 \cdot x =_{\mathbb{Z}} 0) \simeq (0 \cdot s(x) =_{\mathbb{Z}} 0)
            %p Thus, by induction on the integers, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} labsorp
