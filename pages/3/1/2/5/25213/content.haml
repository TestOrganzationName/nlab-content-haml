                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ÷
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -i(n) \div -i(m) \coloneqq i(n \div m)
            %p
              for
