                        %mi Δ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                %annotation{:encoding => "application/x-tex"} U^{\Delta_{+}^\op}
            is a
            %a.existingWikiWord{:href => "/nlab/show/displayed+coinductive+type"} displayed coinductive type
            cogenerated by
          %ul
            %li
              %p
                a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
