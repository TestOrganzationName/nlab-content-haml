                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/triangulated+type+theory"} triangulated type theory
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/op+modality"} op modality
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %annotation{:encoding => "application/x-tex"} (-)^\op
            %a.existingWikiWord{:href => "/nlab/show/directed+univalent"} directed univalent
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo +
                  %mo ⊆
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \Delta_+ \subseteq \mathcal{S}
            of
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
            %a.existingWikiWord{:href => "/nlab/show/ordinals"} ordinals
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injections"} injections
            %strong semi-simplicial type
            is simply a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msubsup
                      %mi Δ
                      %mo +
                      %mi op
                    %mo →
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} X:\Delta_+^op \to \mathcal{S}
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-presheaf"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-presheaf
            by the directed structure identity principle on
            = succeed "-presheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
