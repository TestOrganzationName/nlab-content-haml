                %mrow
                  %mi Ψ
                %annotation{:encoding => "application/x-tex"} \Psi
            of pseudo-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            \-forms; that is, the trivial bundle is the absolute value of the pseudoscalar bundle.
          %h3#as_smooth_functors_on_paths
            As smooth functors on
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p One way to exhibit this statement nicely is:
          .standout
            %p
              A differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a smooth
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/n-functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} P_n(X) \to \mathbf{B}^n \mathbb{R}
              from the
              %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the additive
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              of real numbers.
          .query
            %p Urs, do you know where the need for orientation comes in here? I don't follow it in enough detail to see, although I intend to read Moerdijk–Reyes. —Toby
            %p
              %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
              \: I’m probably confused, but if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma_n
              is a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P_n(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_n^{-1}
              is also in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_n(X)
              and I think
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi σ
                        %mi n
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega(\sigma_n) = -\omega(\sigma_n^{-1})
            %p
              %em> Toby
              \: Between Eric's comment here and Urs's at
              = succeed "," do
                %span.newWikiWord
                  latest changes
                  %a{:href => "/nlab/new/latest+changes"} ?
            %p
              %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
              \: I think it is a good question. Maybe we should keep the query box here until the answer is incorporated in the page.
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \: here is my reply, that I originally posted at
              = succeed "." do
                %span.newWikiWord
                  latest changes
                  %a{:href => "/nlab/new/latest+changes"} ?
            %p
              The orientation of the diffential form corresponds to the inherent orientation of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
              %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
              necessarily has
              %em oriented
              = succeed "-volumes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              To get pseudo-differential forms that may be integrated also over non-oriented and possibly non-orientable manifolds one needs to consider parallel transport functors not with coefficients in just
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{R}
              coming from the
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo →
                    %mo *
                    %mo →
                    %mi ⋯
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{R} \to {*} \to \cdots \to {*})
            %p but the more refined crossed complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo →
                    %mo *
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{R} \to {*} \to \cdots \to \mathbb{Z}_2)
            %p
              where the
              = succeed "-factor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              (one can also use
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              instead of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P_n(-), \mathbf{B}^n U(1)]
              becomes the
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne complex
              and knows not just about differential forms but about
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              = succeed "-gerbes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n-1
            %p
              A little bit of discussion of this unoriented case is currently at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n=2
          %p
            Note that an
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_n(X)
            is an oriented
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Such a functor (as described in more detail at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma\colon [0,1]^n \to X
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(X)
            %a.existingWikiWord{:href => "/nlab/show/integration"} integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi n
                  %msup
                    %mi Σ
                    %mo *
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{[0,1]^n} \Sigma^* \omega
                  \\,.
          %p
            This integral in turn encodes the
            = succeed "-functoriality" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-functor:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li
              if we decompose the standard
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi n
                  %annotation{:encoding => "application/x-tex"} [0,1]^n
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mi n
                  %annotation{:encoding => "application/x-tex"} N^n
              little subcubes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo ∈
                        %msup
                          %mi ℕ
                          %mi n
                  %annotation{:encoding => "application/x-tex"} (C_k)_{k\in \mathbb{N}^n}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
            %li
              and apply the
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega(C_k)
            %li
              then by
              = succeed "-functoriality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is the composition of all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(C_k)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} ]
                            %mi n
                      %msup
                        %mi Σ
                        %mo *
                      %mi ω
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi k
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_{[0,1]^n} \Sigma^* \omega
                      \=
                      \\sum_k \omega(C_k)
                      \\,.
          %p
            Since one can let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            increase arbitrarily in this prescription –
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo →
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} N \to \infty
            – it follows that the value of the functor on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is already determined by all its values on all “infinitesimal
            = succeed "-cubes\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The notion of
            %strong differential form
            is the one that makes this precise: a differential form is a rule for assigning to each “infinitesimal
            = succeed "-cube\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p There are in turn different ways to make that last statement precise:
          %ul
            %li
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
                an “infinitesimal
                = succeed "-cube\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-tuple" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent vectors
                and a differential form is a fiberwise linear map from the
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                to the real numbers, as given below.
            %li
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
                the statement is in essence the same one, but the difference is that there the notion of “infinitesimal
                = succeed "-cube\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-cubes." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
                denotes the abstract infinitesimal
                = succeed "-cube" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %msup
                            %mi D
                            %mi n
                    %annotation{:encoding => "application/x-tex"} X^{D^n}
                of morphisms from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} D^n\to X
                is the
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and a differential form is precisely nothing but a morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi X
                        %mrow
                          %msup
                            %mi D
                            %mi n
                      %mo ×
                      %msup
                        %mi D
                        %mi n
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\omega\colon X^{D^n} \times D^n \to \mathbb{R}
              %p
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                is now the synthetic differential version of the real numbers) subject to three constraints. (These constraints can be seen as the infinitesimal analog of the
                = succeed "-functoriality" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %p This is described in detail in section 4 of
              %ul
                %li
                  Moerdijk-Reyes,
                  %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} Models for Smooth Infinitesimal Analysis
              %p
                For more on this see
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/differential+forms+in+synthetic+differential+geometry"} differential forms in synthetic differential geometry
          %h3#more_general_kinds_of_forms More general kinds of forms
          %p
            While differential forms are usually restricted to the linear case, there are also more general kinds of “differential forms” which can be integrated. See for instance
            %a.existingWikiWord{:href => "/nlab/show/absolute+differential+form"} absolute differential form
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cogerm+differential+form"} cogerm differential form
          %h2#operations_on_differential_forms Operations on differential forms
          %h3#pulling_back_forms Pulling back forms
          %p
            Given manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            and a
            %a.existingWikiWord{:href => "/nlab/show/continuously+differentiable+map"} continuously differentiable map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            defines a
            %strong pullback
            form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^*(\eta)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
          %p
            Thus, the operation that maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^*(X)
            extends to a
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Omega^*
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+transformation"} coordinate transformations
          %p
            Note that twisted and (more general) vector-valued forms cannot be pulled back so easily. One needs some extra structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to do so; see the discussion of integration of
            = succeed "-pseudoforms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            for an example.
          %h3#integration Integration of forms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            be an
            = succeed "-pseudoform" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            into a
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and thereby find its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            %a.existingWikiWord{:href => "/nlab/show/absolutely+continuous+measure"} absolutely continuous
            %a.existingWikiWord{:href => "/nlab/show/Radon+measure"} Radon measure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            arises in this way from a unique
            = succeed "-pseudoform" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            If we wish to integrate untwisted (or differently twisted or vector-valued) forms and/or forms of smaller rank, then we may do so on
            %a.existingWikiWord{:href => "/nlab/show/submanifolds"} submanifolds
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with some appropriate structure. In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself is equipped with an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            = succeed "-pseudoforms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are the same as (untwisted)
            = succeed "-forms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            for the general case.
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
              \: Should maybe this entry have a discussion on heuristics behind the usual trick in supersymmetry which asserts that the inner hom for supermanifolds, gives the statement that the algebra of smooth differential forms on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is the space of functions on the odd tangent bundle
              = succeed "?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mi T
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \Pi T M
            %p
              %em> Toby
              \: Possibly that should go at
              = succeed "?" do
                %a.existingWikiWord{:href => "/nlab/show/differential+forms+on+supermanifolds"} differential forms on supermanifolds
            %p
              %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
              \: By no means. Ordinary differential forms on ORDINARY manifolds are the same as functions on odd tangent bundle. I did not want to say anything about the generalization of differential forms on supermanifolds. So it is NOT a different notion, but a different way to define it. If going to toposes hence synthetic framework is not separated why would be separated the equality which involves a parity trick…
            %p
              %em> Toby
              \: Ah, I see; your
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              above need not be super, and it still works. Then yes, that should be mentioned here too.
          %h3#cohomology_of_forms Cohomology of forms
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            theory of smooth differential forms; we have a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mover
                    %mo →
                    %mi{:mathvariant => "normal"} d
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi{:mathvariant => "normal"} d
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi{:mathvariant => "normal"} d
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi{:mathvariant => "normal"} d
                  %mn 0
                  %mo ;
                %annotation{:encoding => "application/x-tex"} \cdots \stackrel{\mathrm{d}}\to C^\infty\Omega^2(X) \stackrel{\mathrm{d}}\to C^\infty\Omega^1(X) \stackrel{\mathrm{d}}\to C^\infty\Omega^0(X) \stackrel{\mathrm{d}}\to 0 ;
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/chain+cohomology"} chain cohomology
            of this complex is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            As smooth differential forms are the cochains in de Rham cohomolgy, the theory of integration of forms allows us to interpret
            %a.existingWikiWord{:href => "/nlab/show/relatively+compact+subspace"} relatively compact
            oriented submanifolds as chains on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            theory. Combining these, we have
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27s+theorem"} Stokes's theorem
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mo ∂
                      %mi R
                  %mi ω
                  %mo =
                  %msub
                    %mo ∫
                    %mi R
                  %mi{:mathvariant => "normal"} d
                  %mi ω
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_{\partial{R}} \omega = \int_R \mathrm{d}\omega ,
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \partial{R}
            %strong boundary
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong codifferential
            as it is dual to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"}> closed differential form
                ,
                %a.existingWikiWord{:href => "/nlab/show/exact+differential+form"} exact differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/decomposable+differential+form"} decomposable differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"}> horizontal differential form
                ,
                %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/harmonic+differential+form"} harmonic differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+form+on+a+supermanifold"} differential form on a supermanifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"}> de Rham complex
                ,
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/absolute+differential+form"}> absolute differential form
                ,
                %a.existingWikiWord{:href => "/nlab/show/cogerm+differential+form"} cogerm differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+differential+form"} holomorphic differential form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+form+with+logarithmic+singularities"} differential form with logarithmic singularities
          %h2#references References
          %h3#general General
          %p
            The concept of differential forms (and their
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/affine+spaces"} affine spaces
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            originates in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Grassmann"}> Hermann Grassmann
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Ausdehnungslehre"} Ausdehnungslehre
          %p Textbook accounts:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"} Loring Tu
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Differential+Forms+in+Algebraic+Topology"} Differential Forms in Algebraic Topology
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-3951-0"} doi:10.1007/978-1-4757-3951-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georges+de+Rham"}> Georges de Rham
                , Chapter II of:
                = succeed "," do
                  %em Differentiable Manifolds – Forms, Currents, Harmonic Forms
                = succeed "," do
                  %strong 266
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-61752-2"} doi:10.1007/978-3-642-61752-2
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Manfredo+P.+Carmo"}> Manfredo P. Carmo
                \:
                = succeed "," do
                  %em Differential Forms and Applications
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-57951-6"} doi:10.1007/978-3-642-57951-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shigeyuki+Morita"}> Shigeyuki Morita
                \:
                = succeed "," do
                  %em Geometry of Differential Forms
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/mmono-201"} ISBN:978-0-8218-1045-3
                = succeed "&rbrack;" do
                  %a{:href => "https://archive.org/details/geometryofdiffer00mori/page/n3/mode/2up"} ark:/13960/t5w70gz1g
            %li#GuilleminHaine19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Victor+Guillemin"}> Victor Guillemin
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Haine"} Peter Haine
                = succeed "," do
                  %em Differential Forms
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/11058"} doi:10.1142/11058
                = succeed "&rbrack;" do
                  %a{:href => "https://math.mit.edu/classes/18.952/2018SP/files/18.952_book.pdf"} pdf
          %p
            Exposition with eye towards applications in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tohru+Eguchi"}> Tohru Eguchi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Gilkey"} Peter Gilkey
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Hanson"} Andrew Hanson
                = succeed "," do
                  %em Gravitation, gauge theories and differential geometry
                %strong 66
                6 (1980) 213-393 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0370-1573(80)90130-1"}> doi:10.1016/0370-1573(80)90130-1
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Theodore+Frankel"}> Theodore Frankel
                , section 2.1 of:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/The+Geometry+of+Physics+-+An+Introduction"} The Geometry of Physics - An Introduction
                (1997)
          %p An introductory wiki-format textbook is
