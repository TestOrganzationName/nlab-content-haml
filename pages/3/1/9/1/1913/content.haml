                %mrow
                  %msub
                    %mi η
                    %mi I
                %annotation{:encoding => "application/x-tex"} \eta_I
            is a function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
