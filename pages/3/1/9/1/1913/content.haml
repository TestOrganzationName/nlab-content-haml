                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} generalized smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for which this definition makes sense, a
            %strong differential form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            of the
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            over
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong exterior differential form
            to be more precise. One often requires differential forms to be smooth, or at least continuous, but we will state this explicitly when we want it. A
            %strong
              differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a section of the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/exterior+power"} exterior power
            of the cotangent bundle; the
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p \geq 0
            is the
            %strong rank
            of the form. A general differential form is a
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            of differential
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            The
            %em space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty\Omega^*(X)
            of
            %em smooth
            forms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may also be defined as the
            %a.existingWikiWord{:href => "/nlab/show/universal+differential+envelope"} universal differential envelope
            of the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty\Omega^0(X)
            of smooth functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (which are the same as the smooth
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p It is generated by the smooth functions and three operations:
          %ul
            %li an associative binary operation of addition generalising the usual addition of functions,
            %li
              an associative binary operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
              (the
              %strong exterior product
              or
              = succeed ")" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
            %li
              a unary operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}
              (the
              = succeed "," do
                %strong exterior derivative
              = succeed ");" do
                %strong differential
          %p subject to these identities:
          %ul
            %li
              addition makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty\Omega^*(X)
              into an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+monoid"} abelian monoid
            %li
              both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
              distribute over addition,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathrm{d}f = 0
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}f \wedge \mathrm{d}f = 0
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∧
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo ∧
                    %mi η
                    %mo +
                    %mi f
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}(f \wedge \eta) = \mathrm{d}f \wedge \eta + f \wedge \mathrm{d}\eta
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo ∧
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} d
                    %mi f
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi η
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}(\mathrm{d}f \wedge \eta) + \mathrm{d}f \wedge \mathrm{d}\eta = 0
              ,
          %p
            in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a smooth function and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            is an arbitrary smooth form. (Note that one often drops the ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            ’ after a
            = succeed "-form;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi η
                    %mo =
                    %mi f
                    %mo ∧
                    %mi η
                  %annotation{:encoding => "application/x-tex"} f \eta = f \wedge \eta
            = succeed "\u2019" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
          %p
            Although not directly stated, it can be proved that addition makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty\Omega^*(X)
            into an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            of the
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            of smooth functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded module
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            being the
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %msup
                      %mi Ω
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty\Omega^p(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is a
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            is a
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}\omega
              is a
              = succeed "-form," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∧
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \omega \wedge \eta
              is a
              = succeed "-form." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+q)
          %p The law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi{:mathvariant => "normal"} d
                  %mi η
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathrm{d}\eta = 0
          %p
            holds for any form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is a
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            is a
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∧
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \omega \wedge \omega = 0
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is odd,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ω
                    %mo ∧
                    %mi η
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi pq
                    %mspace{:width => "thinmathspace"}
                    %mi η
                    %mo ∧
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega \wedge \eta = (-1)^{pq}\, \eta \wedge \omega
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ∧
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %mi ω
                    %mo ∧
                    %mi η
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mi ω
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}(\omega \wedge \eta) = \mathrm{d}\omega \wedge \eta + (-1)^p\, \omega \wedge \mathrm{d}\eta
              \.
          %p
            That is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty\Omega^*(X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/skew-commutative+algebra"} skew-commutative algebra
            over the ring of smooth functions, equipped with a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                %annotation{:encoding => "application/x-tex"} \mathrm{d}
            of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            skew-commutative algebra over that ring equipped with such a derivation. (Or if it doesn't, then it's because I left something out of that description.)
          %p
            More general forms (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^*(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C^1
            (once continuously differentiable) form; in general, the differential of a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} C^k
            form is a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} C^{k-1}
            form. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is not a smooth manifold but only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} C^k
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi k
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} 1 \leq k \lt \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} C^k
            differential forms can still be made to work.
          %p
            Given local coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msup
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x^1, \ldots, x^n)
            on a patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
