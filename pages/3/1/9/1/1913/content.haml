                %mrow
                  %mo{:stretchy => "false"} |
                  %mi Λ
                  %msup
                    %mo{:stretchy => "false"} |
                    %mi w
                %annotation{:encoding => "application/x-tex"} |\Lambda|^w
            associated to the character
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↦
                  %mo{:stretchy => "false"} |
