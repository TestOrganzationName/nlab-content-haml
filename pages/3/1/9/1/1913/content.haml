            is called the line bundle of
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/density"}
