          %title Sequences
          %h1#sequences Sequences
          .maruku_toc
            %ul
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#notation"} Notation
              %li
                %a{:href => "#Generalization"} Generalisations
              %ul
                %li
                  %a{:href => "#nets"} Nets
                %li
                  %a{:href => "#sequential_nets"} Sequential nets
              %li
