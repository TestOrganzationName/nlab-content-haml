      }
      
      div.dropDown:hover .hide {
      display:block;
      }
      
      div.clickDown .hide {
      display: none;
      }
      
      div.clickDown:focus {
      outline:none;
      }
      
      div.clickDown:focus .hide, div.clickDown:hover .hide {
      display: block;
      }
      
      div.clickDown .clickToReveal, div.clickDown:focus .clickToHide {
      display:block;
      }
      
