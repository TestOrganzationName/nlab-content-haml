                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_n \to B O(n)
              over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
