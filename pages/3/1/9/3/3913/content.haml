              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %ol
              %li
                %p
                  the
                  %strong unit disk bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} D(V) \to X
                  is the subbundle of elements of
                  %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≤
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \leq 1
              %li
                %p
                  the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
                    bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S(V)\to X
                  is the subbundle of elements of norm
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} = 1
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ↪
                          %mrow
                            %msub
                              %mi i
                              %mi V
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi V
                      %annotation{:encoding => "application/x-tex"} S(V) \overset{i_V}{\hookrightarrow} D(V) \hookrightarrow V
                  ;
              %li
                %p
                  the
                  %strong Thom space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Th(V)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
                  (formed in
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  (
                  %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"}> prop.
                  )) of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi V
                      %annotation{:encoding => "application/x-tex"} i_V
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi cofib
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Th(V) \coloneqq cofib(i_V)
                %p
                  canonically regarded as a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mi V
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S(V) &amp;\overset{i_V}{\longrightarrow}&amp; D(V)
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; Th(V)
                    }
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              is a general real vector bundle, then there exists an isomorphism to an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
              and the Thom space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is, up to based
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
          #ThomSpaceForRankZeroBundle.num_remark
            %h6#remark Remark
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is positive, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(V)
              is non-empty and then the Thom space is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Th(V) \simeq D(V)/S(V)
                    \\,.
            %p
              However, in the degenerate case that the
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              vanishes, hence the case that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi X
                      %mo ×
                      %msup
                        %mi ℝ
                        %mn 0
                      %mo ≃
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V = X\times \mathbb{R}^0 \simeq X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi V
                      %mo ≃
                      %mi X
                    %annotation{:encoding => "application/x-tex"} D(V) \simeq V \simeq X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} S(V) = \emptyset
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              defining the cofiber is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mi V
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
