                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Th(V)
            is a model for
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            of the total space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            The Thom space of the rank-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
            over the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
