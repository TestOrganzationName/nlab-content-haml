                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M O(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            ranges, these spaces form the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
          %h2#Definition Definition
          #ThomSpace.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"}> topological vector bundle
              ) over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} O(n)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
