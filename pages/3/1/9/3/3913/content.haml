                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Th
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S(V) &amp;\longrightarrow&amp; *
                  \\\
                  {}^{\mathllap{p}}\downarrow &amp;\swArrow&amp; \downarrow
                  \\\
                  X &amp; \longrightarrow &amp; Th(V)
                  }
          %p
            in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of the
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
