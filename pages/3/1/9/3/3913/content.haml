                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\overset{i_V}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; Th(V) \simeq X_*
                    }
                    \\,,
            %p
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(V)
              as the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the point, hence as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
