                    Th(X \times \mathbb{R}^0) = Th(X) \simeq X_+
                    \\,.
          %h2#Properties Properties
          %h3#HomotopyTheoreticNature Homotopy-theoretic nature
          #ThomSpaceOverCWComplexIsHomotopyCofiber.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(V)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpace"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyFiber"}> def.
              ) of the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(V) \longrightarrow D(V)
              of the sphere bundle into the disk bundle.
          .proof
            %h6#proof Proof
            %p
              The Thom space is defined as the ordinary
              %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(V)\to D(V)
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              inclusion, hence a cofibration in the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopQuillenModelStructure"}> thm.
              ). Therefore in this case the ordinary cofiber represents the homotopy cofiber (
              %a{:href => "#Introduction+to+Stable+homotopy+theory+--+P#HomotopyFiber"}> def.
              ).
          %p
            The equivalence to the following alternative model for this homotopy cofiber is relevant when discussing
            %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphisms"} Thom isomorphisms
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation in generalized cohomology
          #ThomSpaceOverCWEquivalentToConeOnInclusionOfComplementOf0Section.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∖
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \setminus X
              for the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of its 0-
              %a.existingWikiWord{:href => "/nlab/show/section"}> section
              \. Then the Thom space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(V)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpace"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ∖
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (V \setminus X) \hookrightarrow V
              (hence to the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo ∖
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,V \setminus X)
              in the language of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of any map out of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              represents the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of that map (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#StandardTopologicalMappingConeIsHomotopyCofiber"}> exmpl.
              ). Moreover, transformation by (weak) homotopy equivalences between morphisms induces a (weak) homotopy equivalence on their homotopy fibers (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#FiberOfFibrationIsCompatibleWithWeakEquivalences"}> prop.
              ). But we have such a weak homotopy equivalence, given by contracting away the fibers of the vector bundle:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi V
                            %mo ∖
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %msub
                                    %mi W
                                    %mi cl
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %msub
                                    %mi W
                                    %mi cl
                        %mtr
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V\setminus X &amp;\longrightarrow&amp; V
                    \\\
                    {}^{\mathllap{\in W_{cl}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\in W_{cl}}}
                    \\\
                    S(V) &amp;\hookrightarrow&amp; D(V)
                    }
                    \\,.
          %h3#behaviour_under_direct_sum_of_vector_bundles Behaviour under direct sum of vector bundles
          #ThomSpaceOfDirectSumAsQuotientOfThomSpacesOfPullbacks.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi V
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V_1,V_2 \to X
              be two real
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpace"}
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi V
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V_1 \oplus V_2 \to X
              is expressed in terms of the Thom space of the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundles"} pullback bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_2|_{D(V_1)}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_2|_{S(V_1)}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
              to the disk/sphere bundle of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_1
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi V
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Th(V_1 \oplus V_2)
                    \\simeq
                    Th(V_2|_{D(V_1)})/Th(V_2|_{S(V_1)})
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p Notice that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi V
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 2
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi Int
                            %mi D
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(V_1 \oplus V_2) \simeq D(V_2|_{Int D(V_1)}) \cup S(V_1)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi V
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 2
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi Int
                            %mi D
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mi Int
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mn 2
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi S
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S(V_1 \oplus V_2) \simeq S(V_2|_{Int D(V_1)}) \cup Int D(V_2|_{S(V_1)})
                  \.
            %p
              (Since a point at radial distance
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_1 \oplus V_2
              is a point at radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mn 1
                    %mo ≤
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r_1 \leq r
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
              and a point at radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %msup
                          %mi r
                          %mn 2
                        %mo −
                        %msubsup
                          %mi r
                          %mn 1
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \sqrt{r^2 - r_1^2}
              in
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V_1
          #SuspensionOfThomSpaces.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              then the Thom space (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpace"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ⊕
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \oplus V
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              with the trivial rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              vector bundle, is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of the Thom space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              (the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊕
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mi n
                    %mo ∧
                    %mi Th
