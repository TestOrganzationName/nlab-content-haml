                %ul
                  %li
                    %a{:href => "#general"} General
                  %li
                    %a{:href => "#DBraneChargeViaAtiyahHirzebruchSpectralSequence"} Via the Atiyah-Hirzebruch spectral sequence
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
