                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi χ
                            %mi B
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      D_Q = i! = \in KK(C(Q), C(X)_{\chi_B})
                      \\,.
          %p
            The corresponding
            %strong D-brane charge
            in KK-theory is the resulting composite (relative
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/index"} index
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi D
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi KK
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi χ
                        %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi K
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi χ
                        %mi b
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  i_!(\xi) =  D_Q(\xi) \in KK(\mathbb{C}, C(X)_{\chi_B}) \simeq K^{[\chi_b]}(X)
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                  %mo{:lspace => "verythinmathspace"} :
                  %mi KK
                  %mo →
                  %mi HL
                %annotation{:encoding => "application/x-tex"}
                  ch \colon KK \to HL
          %p
            in real cohomology/
            %a.existingWikiWord{:href => "/nlab/show/cyclic+cohomology"} cyclic cohomology
            is considered,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ch
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi Q
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ch(D_Q(\xi))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                %annotation{:encoding => "application/x-tex"} ch
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            and then pushing forward in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HL
                  %annotation{:encoding => "application/x-tex"} HL
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebraic
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck-Riemann-Roch+theorem"} Grothendieck-Riemann-Roch theorem
            this gives the
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            expression
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi χ
                            %mi B
                  %msqrt
                    %mi Todd
                  %mo ∈
                  %mi HL
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ch(D_Q(\xi))
                  \\otimes_{C(X)_{\chi_B}}
                  \\sqrt{Todd}
                  \\in HL
                  \\,,
          %p
            where on the right we have the relative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Todd+class"} Todd class
          %p
            (In (
            %a{:href => "#BMRS2"}> BMRS2, Section 4
            ) this is discussed for the untwisted case.)
          %p
            For more general discussion see at
            %em
              %a{:href => "Freed-Witten+anomaly#Details"} Freed-Witten anomaly – Details
            as well as at
            = succeed "." do
              %em
                %a{:href => "Poincar%C3%A9+duality+algebra#PropertiesKOrientationAndUmkehrMaps"} Poincaré duality algebra – Properties – K-Orientation and Umkehr maps
          %h4#DBraneChargeViaAtiyahHirzebruchSpectralSequence Via the Atiyah-Hirzebruch spectral sequence
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzeburch+spectral+sequence"} Atiyah-Hirzeburch spectral sequence
            expresses, starting from its
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E_2
            pages,
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            classes on
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as
            %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
            of certain differential acting on ordinary cohomology in all even degrees (for type IIA strings) or all odd degrees (for type IIB strings)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mn 2
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo =
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi KU
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi KU
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E_2^{p,q} = H^p(X, KU^q(\ast)) \Rightarrow KU^\bullet(X)
                  \\,.
          %p
            Discussion of D-brane charge this way is in (
            %a{:href => "#MaldacenaMooreSeiberg01"}> Maldacena-Moore-Seiberg 01
            ,
            = succeed ")." do
              %a{:href => "#EvslinSati06"} Evslin-Sati 06
