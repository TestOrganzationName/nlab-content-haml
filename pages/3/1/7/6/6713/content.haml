            is
            %a.existingWikiWord{:href => "/nlab/show/K-orientation"} K-oriented
            in that for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has a
            %a.existingWikiWord{:href => "/nlab/show/spin-structure"} spin-structure
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec-structure"} spin^c-structure
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
