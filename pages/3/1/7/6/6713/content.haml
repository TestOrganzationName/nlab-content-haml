              %ul
                %li
                  %a{:href => "#general_2"} General
                %li
                  %a{:href => "#on_orbifolds"} On orbifolds
                %li
                  %a{:href => "#ReferencesAsGSsigmaModels"}
                    As higher super-GS-WZW type
                    = succeed "-models" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi σ
                          %annotation{:encoding => "application/x-tex"} \sigma
                %li
                  %a{:href => "#DBraneChargeQuantizationInTopologicalKTheory"} D-brane charge quantization in topological K-theory
                %ul
                  %li
                    %a{:href => "#origin_and_basics"} Origin and basics
                  %li
                    %a{:href => "#twisted_equivariant_and_differential_refinement"} Twisted, equivariant and differential refinement
                  %li
                    %a{:href => "#reviews"} Reviews
                  %li
                    %a{:href => "#DBraneChargeInKTheoryReferencesConceptualProblems"} Conceptual problems
                  %li
                    %a{:href => "#for_orbifolds_in_equivariant_ktheory"} For orbifolds in equivariant K-theory
                %li
