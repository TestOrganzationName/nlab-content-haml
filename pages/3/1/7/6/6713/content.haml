                    In terms of geometric data of the
                    = succeed "-model" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi σ
                          %annotation{:encoding => "application/x-tex"} \sigma
                %li
                  %a{:href => "#AsBlackBranes"} As black branes
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#various_dimensions"} Various dimensions
                %li
                  %a{:href => "#in_the_wzw_model"} In the WZW model
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#as_fbranes_originating_from_mbranes"} As F-branes originating from M-branes
                %li
