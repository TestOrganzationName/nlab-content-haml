                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              in a certain way.
            %p
              %a{:href => "#TheHigherWZWTermsOfSuperpBranes"} Below
              we discuss that this occurs for the (properly globalized)
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+super+p-brane+sigma+models"} Green-Schwarz super p-brane sigma models
              of all the
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
              and of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1 = 1
              and so there is a 1-form connection on their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p_1 = 2
              and so there is a 2-form connection on its worldvolume, the
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+field"} self-dual higher gauge field
              in 6d.
          #TargetStackForDBranes.num_example
            %h6#example_7 Example
            %p
              For each
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} Dp-brane
              species in
              %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
              there is a pair of consecutive cocycles (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConsecutiveCocycles"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                              %mi IIA
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi μ
                                  %mi Dp
                          %mtd
                            %msup
                              %mi b
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 9
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 16
                                %mo +
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mn 16
                                  %mo ¯
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi μ
                                  %mrow
                                    %mi F
                                    %mn 1
                                  %mi IIA
                          %mtd
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathfrak{string}_{IIA} &amp;\overset{\mu_{Dp}}{\longrightarrow}&amp; b^{p+1} \mathbb{R}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{9,1\vert \mathbf{16} + \overline{\mathbf{16}}}
                    \&amp;\overset{\mu_{F1}^{IIA}}{\longrightarrow}&amp;
                    b^2 \mathbb{R}
                    }
                    \\,.
            %p
              This is by the discussion
              = succeed "." do
                %a{:href => "#TheBraneBouquet"} below
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi Dp
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ∧
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{Dp} = (C \wedge \exp(F_2))_{p+2}
            %p
              reflects the familiar D-brane coupling to the
              %a.existingWikiWord{:href => "/nlab/show/RR-fields"} RR-fields
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %msub
                        %mi C
                        %mn 2
                      %mo +
                      %msub
                        %mi C
                        %mn 4
                      %mo +
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"} C = C_2 + C_4 + \cdots
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              with
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
              %a.maruku-ref{:href => "#IIADpbranecocycles"}
              below.
            %p
              The WZW term induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi μ
                      %mrow
                        %mi F
                        %mn 1
                      %mi IIA
                  %annotation{:encoding => "application/x-tex"} \mu_{F1}^{IIA}
              is the globalization of the original term introduced by Green and Schwarz in the construction of the
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-model"} Green-Schwarz sigma-model
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            %p
              Now corollary
              %a.maruku-ref{:href => "#TildeHatGIsDifferentialModuliBundle"}
              says in this case that the Dp-brane sigma model has as target space the
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-group"} smooth super 2-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi String
                          %mi IIA
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{ String_{IIA} }
              which is an
              %a.existingWikiWord{:href => "/nlab/show/infinity-group+extension"} infinity-group extension
              of
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              by the
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
              for
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mrow
                                %msub
                                  %mi String
                                  %mi IIA
                              %mo ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 9
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 16
                                %mo +
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mn 16
                                  %mo ¯
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                  %mi Dp
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi p
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}U(1)_{conn}
                    \&amp;\longrightarrow&amp;
                    \\widetilde{ String_{IIA} }
                    \\\
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \&amp;&amp; \mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}}}
                    \&amp;\overset{\mathbf{L}_{Dp}}{\longrightarrow}&amp;
                    \\mathbf{B}(\mathbf{B}^{p}U(1)_{conn})
                    }
                    \\,.
            %p
              It follows that field configurations for the
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              given by morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo ⟶
                    %mover
                      %mrow
                        %msub
                          %mi String
                          %mi IIA
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_{p+1} \longrightarrow \widetilde{ String_{IIA} }
            %p
              are equivalently pairs, consisting of an ordinary
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 16
                        %mo +
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mn 16
                          %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \Sigma_{p+1} \longrightarrow \mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}}}
            %p
              together with a twisted 1-form connection on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              on the D-brane.
          %h3#consecutive_wzw_terms_descending_to_twisted_cocycles Consecutive WZW terms descending to twisted cocycles
          %p
            Above we considered consecutive cocycles (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ConsecutiveCocycles"}
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %a.existingWikiWord{:href => "/nlab/show/line+Lie-n+algebras"} line Lie-n algebras
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^{p+1}\mathbb{R}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          %p Below we find as examples of this general phenomenon
          %ol
            %li
              %p
                the descent of the separate
                %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
                cocycles to the RR-fields in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
                = succeed ")" do
                  %a{:href => "#F1DpCocycles"} here
            %li
              %p
                the descent of the
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                cocycle to a cocycle in degree-4
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                = succeed ")." do
                  %a{:href => "#MFluxFields"} here
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Given one stage of consecutive
            = succeed "-cocycles," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.maruku-ref{:href => "#LInfinityCocycle"}
            (e.g in the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            discussed
            = succeed ")" do
              %a{:href => "#TheBraneBouquet"} below
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi 𝔤
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi μ
                                %mn 2
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 2
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi 𝔤
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat \mathfrak{g}
                  \&amp;
                  \\stackrel{\mu_2}{\longrightarrow}
                  \&amp;
                  \\mathbf{B}\mathfrak{h}_2
                  \\\
                  {}^{\mathllap{hofib(\mu_1)}}\downarrow
                  \\\
                  \\mathfrak{g}
                  \\\
                  \&amp; {}_{\mathllap{\mu_1}}\searrow
                  \\\
                  \&amp;&amp; \mathbf{B}\mathfrak{h}_1
                  }
          %p
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi 𝔤
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathfrak{g}
            may be thought of, in a precise sense, as being a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔥
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}_1
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            This and the following statements all are the general theorems of (
            %a{:href => "#NSS12"}> Nikolaus-Schreiber-Stevenson 12
            ) specified to
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problems"} formal moduli problems
            = succeed "." do
              %a{:href => "#dcct"} dcct
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            gets an accurate impression by considering the analogous situation in that context (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+principal+bundles"} geometry of physics – principal bundles
            for detailed lecture notes that cover the following):
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}H
            its one-object
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            another Lie group (or just any
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G
                  \\\
                  \&amp; \searrow
                  \\\
                  \&amp;&amp; \mathbf{B}H
                  }
          %p
            (i.e. a morphism between the
            %a.existingWikiWord{:href => "/nlab/show/smooth+stacks"} smooth stacks
            which they represent, or equivalently a
            %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
            of Lie groupoids) classifies a smooth
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            of that bundle is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the original map.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat G
                  \\\
                  \\downarrow
                  \\\
                  G
                  \\\
                  \&amp; \searrow
                  \\\
                  \&amp;&amp; \mathbf{B}H
                  }
          %p
            This is explained in some detail at
            = succeed "." do
              %em
                %a{:href => "https://ncatlab.org/nlab/show/principal%20bundle#InA2Topos"} principal bundle – In a (2,1)-topos
          %p
            Back to the abalogous situation of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mu_2
            %em equivariant
            under the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔥
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mu_2
            does not itself already come from the base space, then it can at best be equivariant with respect to an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔥
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}_1
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔥
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathfrak{h}_2
          %p
            A first observation now is that specifying such
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is equivalent to specifying a second homotopy fiber sequence of the form as on the right of this completed diagram:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi 𝔤
                            %mo{:stretchy => "false"} ^
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi μ
                                %mn 2
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 2
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi p
                                  %mi ρ
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi 𝔤
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi 𝔥
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi ρ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat \mathfrak{g}
                  \&amp;&amp;
                  \\stackrel{\mu_2}{\longrightarrow}
                  \&amp;&amp;
                  \\mathbf{B}\mathfrak{h}_2
                  \\\
                  {}^{\mathllap{hofib(\mu_1)}}\downarrow
                  \&amp;&amp; &amp;&amp;
                  \\downarrow^{\mathrlap{hofib(p_\rho)}}
                  \\\
                  \\mathfrak{g}
                  \&amp;&amp; &amp;&amp;
                  (\mathbf{B}\mathfrak{h}_2)/\mathfrak{h}_1
                  \\\
                  \&amp; {}_{\mathllap{\mu_1}}\searrow  &amp;&amp; \swarrow_{\mathrlap{p_\rho}}
                  \\\
                  \&amp;&amp; \mathbf{B}\mathfrak{h}_1
                  }
                  \\,.
          %p
            In the simple analogous situation of
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            this comes about as follows (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+representations+and+associated+bundles"} geometry of physics – representations and associated bundles
            for detailed lecture notes on the following):
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            a smooth
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            on some
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} V/H
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the points of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mover
                    %mo ⟶
                    %mi h
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \stackrel{h}{\longrightarrow} \rho(h)(v)
            connecting any two objects that are taken to each other by the Lie group action. For example when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} V = \ast
            is the point, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"} \ast/H \simeq \mathbf{B}H
            is just the one-object
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            Lie groupoid of the Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            itself. This also shows that there is canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; V/H
                  \\\
                  \&amp; \swarrow
                  \\\
                  \\mathbf{B}H
                  }
          %p
            which is given by sending all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v\in V
            to the point, and sending each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mover
                    %mo ⟶
                    %mi h
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \stackrel{h}{\longrightarrow} \rho(h)(v)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo ⟶
                      %mi h
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \stackrel{h}{\longrightarrow} \ast
          %p
            This projection is evidently an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            and a lift of its source object to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} V/H
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of this morphism is equivalently already it
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} V/H
            that gets send to the (identity morphism on) the point, is clearly just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            itself again. Hence we conclude that the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            induced a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; V
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; V/H
                  \\\
                  \&amp; \swarrow
                  \\\
                  \\mathbf{B}H
                  }
                  \\,.
          %p
            With a little more work one may show that every homotopy fiber sequence of this form is induced this way by an action, up to equivalence. Hence actions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            are equivalently
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}H
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} V/H
            is a model for the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            of the action, and by the
            %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
            this may equivalently be written as the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi H
                  %munder
                    %mo ×
                    %mi ρ
                  %mi V
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V/H \simeq \mathbf{E}H \underset{\rho}{\times} V
                  \\,.
          %p
            Hence the statement is that the map that sends
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            the universal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            is an equivalence, not just in the context of Lie groups andLie groupoids but much more generally (in every “
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}> (infinity,1)-topos
            ”).
          %p
            Again back now to the analogous situation with
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            = succeed "-equivariance" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mu_2
            is equivalent to it descending down the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            on both sides to an
            = succeed "-homomorphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 2
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔥
                    %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔤
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔥
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔥
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mu_2/\mathfrak{h}_1
                  \\;\colon\;
                  \\mathfrak{g}
                  \\longrightarrow
                  (\mathbf{B}\mathfrak{h}_2)/\mathfrak{h}_1
          %p
            making this
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi 𝔤
                            %mo{:stretchy => "false"} ^
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi μ
                                %mn 2
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔥
                            %mn 2
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
