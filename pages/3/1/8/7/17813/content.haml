          .num_remark
            %h6#remark_20 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{h})
              in prop.
              %a.maruku-ref{:href => "#DimensionalReduction"}
              has generators in degree 1, then the operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi ϕ
                        %mo{:stretchy => "false"} ˜
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \tilde \phi^\ast
              involves sending generators in degree 0 to multiples of the ground field. This makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \phi
              a “
              %a.existingWikiWord{:href => "/nlab/show/curved+L-%E2%88%9E+algebra"}> curved
              ”
              = succeed "-homomorphism." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.maruku-ref{:href => "#DimensionalReduction"}
              to give a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              we need to regard it in the category of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔥
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              typically contains no generators of degree 1, in which case the above natural bijection exists on the category of plain
              = succeed "-homomorphisms." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
