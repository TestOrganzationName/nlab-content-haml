            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi D
                        %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
