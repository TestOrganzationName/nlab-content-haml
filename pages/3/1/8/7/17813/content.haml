                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\Omega}^1_{flat}(-,\hat {\mathfrak{g}})
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    \\mathbf{\Omega}^{p+1}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathbf{d}}
                    \\\
                    \\mathbf{\Omega}^1_{flat}(-,\mathfrak{g})
                    \&amp;\stackrel{\mu}{\longrightarrow}&amp;
                    \\mathbf{\Omega}^{p+2}_{cl}
                    }
            %p
              (hence an ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
          .proof
            %h6#proof_2 Proof
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \mapsto Hom_{dgAlg}(CE(\mathfrak{g}), \Omega^\bullet(-))
              preserves
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                  %annotation{:encoding => "application/x-tex"} CE
              is an anti-equivalence onto its image, pullbacks of (pre-)-sheaves are computed objectwise, the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              preserves pullbacks in the covariant argument).
            %p
              Observe then (see the discussion at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{p+2}_{cl} \simeq Hom_{dgAlg}(CE(b^{p+1}), \Omega^\bullet(-))
            %p we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{p+1} \simeq Hom_{dgAlg}(W(b^{p}), \Omega^\bullet(-))
                    \\,.
            %p
              With this the statement follows by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#CharacterizationOfLInfinityHomotopyFibers"}
          #ConsecutiveCocycles.num_defn
            %h6#definition_16 Definition
            %p
              We say that a pair of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycles"} L-∞ cocycles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo ,
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mu_1, \mu_2)
              is
              %em consecutive
              if the domain of the second is the extension (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"}> homotopy fiber
              ) defined by the first
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi 𝔤
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 2
                          %mtd
                            %msup
                              %mi b
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi 𝔤
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                          %mtd
                            %msup
                              %mi b
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 1
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hat {\mathfrak{g}} &amp;\stackrel{\mu_2}{\longrightarrow}&amp; b^{p_2+1}
                    \\\
                    \\downarrow
                    \\\
                    \\mathfrak{g} &amp;\stackrel{\mu_1}{\longrightarrow}&amp; b^{p_1+1}\mathbb{R}
                    }
            %p
              and if the truncated
              %a.existingWikiWord{:href => "/nlab/show/Lie+integrations"} Lie integrations
              of these cocycles via prop.
              %a.maruku-ref{:href => "#TruncatedLieIntegrationOfCocycle"}
              preserves the extension property in that also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ⟶
                    %mi G
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Ω
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mn 1
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Γ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat G \longrightarrow G \overset{\Omega \mathbf{c}_1}{\longrightarrow} \mathbf{B}^{p_1+1}(\mathbb{R}/\Gamma_1)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+homotopy+types"} smooth homotopy types
          .num_remark
            %h6#remark_7 Remark
            %p
              The issue of the second clause in def.
              %a.maruku-ref{:href => "#ConsecutiveCocycles"}
              is to do with the truncation degrees: the universal untruncated
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(-)
              preserves homotopy fiber sequences, but if there are non-trivial cocycles on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              in between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mu_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mu_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                      %mo &gt;
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_2 \gt p_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mn 2
                    %mo ≔
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{2} \coloneqq \tau_{p_2}\exp(\hat\mathfrak{g})
              (see
              = succeed ")" do
                %a{:href => "Lie+integration#Henriques"} Henriques 06, theorem 6.4
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mn 1
                    %mo ≔
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_1 \coloneqq \tau_{p_1}\exp(\mathfrak{g})
              and will hence spoil the preservation of the homotopy fibers through Lie integration.
            %p
              Notice that extending along consecutive cocycles is like the extension stages in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
          %p
            Given two consecutive
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycles"} L-∞ cocycles
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo ,
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mu_1,\mu_2)
            = succeed "," do
              %a.maruku-ref{:href => "#ConsecutiveCocycles"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
