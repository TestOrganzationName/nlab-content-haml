                              %mi e
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msup
                              %mi ψ
                              %mi β
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    e^a \wedge e^b = - e^b \wedge e^a
                    \\\
                    \\psi^\alpha \wedge \psi^\beta = + \psi^\beta \wedge \psi^\alpha
                    \\\
                    e^a \wedge \psi^\alpha = - \psi^\alpha \wedge e^a
                    \\end{aligned}
            %p
              (see at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                  %annotation{:encoding => "application/x-tex"} d_{CE}
              acts on the generators as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ψ
                              %mi α
                          %mtd
                            %mo ≔
                            %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mo ≔
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %msub
                                %mi C
                                %mrow
                                  %mi α
                                  %mi α
                                  %mo ′
                              %msup
                                %mrow
                                  %msup
                                    %mi Γ
                                    %mi a
                                %mrow
                                  %mi α
                                  %mo ′
                              %msub
                                %mrow
                                %mi β
                              %mo )
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{\mathbb{R}^{d-1,1\vert N}} \; \psi^\alpha &amp;
                    \\coloneqq
                    0
                    \\\
                    d_{\mathbb{R}^{d-1,1\vert N}} \; e^a
                    \&amp; \coloneqq \overline{\psi} \wedge \Gamma^a \psi
                    \\\
                    \&amp; \coloneqq   \left(C_{\alpha \alpha'} {\Gamma^a}^{\alpha'}{}_\beta\right)  \psi^\alpha \wedge \psi^\beta
                    \\end{aligned}
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ψ
                          %mo ¯
                        %mo ∧
                        %msup
                          %mi Γ
                          %mi a
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \overline{\psi} \wedge \Gamma^a \psi
                  denotes the
                  = succeed "-component" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} otime
                        %mi N
                        %mo →
                        %msup
                          %mi ℝ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} N \otime N \to \mathbb{R}^d
                  that comes with every
                  %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
                  applied to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∧
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \psi \wedge \psi
                  regarded as an
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo ⊗
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N \otimes N
              %li
                %p
                  hence in components (if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  representation, by
                  = succeed "):" do
                    %a{:href => "geometry+of+physics+--+supersymmetry#SpinorToVectorBilinearPairing"} this prop.
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi α
                                %mi α
                                %mo ′
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C = (C_{\alpha \alpha'})
                      is the
                      %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
                      (as discussed at
                      = succeed ");" do
                        %em
                          %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Γ
                              %mi a
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi α
                            %msub
                              %mrow
                              %mi β
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \Gamma^a = ((\Gamma^a)^{\alpha}{}_\beta)
                      are the
                      %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                      representing the
                      %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                      action on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                          %annotation{:encoding => "application/x-tex"} N
                      in the
                      %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi ψ
                              %mi α
                            %msubsup
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi α
                                %mo =
                                %mn 1
                              %mrow
                                %msub
                                  %mi dim
                                  %mi ℝ
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}_{\alpha = 1}^{dim_{\mathbb{R}}(N)}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} summation over paired indices
                  is understood.
            %p
              That this indeed yields a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              follows by the symmetry and equivariance of the bilinear spinor pairing (via
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+supersymmetry#SpinorToVectorPairing"} this prop.
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Lie(Spin(d-1,1)) \simeq \mathfrak{so}(d-1,1)
            %p
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert 1}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                \-supersymmetric
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔦𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1\vert N})
                in dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              which is the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+Lie+algebra"} semidirect product Lie algebra
              of this
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo ⋊
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N})
                    \=
                    \\mathbb{R}^{d-1,1\vert N} \rtimes \mathfrak{so}(d-1,1)
                    \\,.
            %p
              This is characterized by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N}))
              is as follows:
            %p
              it is
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              from elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi e
                            %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ψ
                            %mi α
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi odd
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
