            %p
              Similarly, define the following elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                      %mi IIB
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{string}_{IIB})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheMembraneAndStringCocycles"}
              = succeed "):" do
                %a.maruku-ref{:href => "#ConvenientSpinorBasis"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 3
                          %mtd
                            %mo ≔
                            %mi i
                            %mrow
                              %mo (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo ∧
                              %msubsup
                                %mi Γ
                                %mi a
                                %mi B
                              %msub
                                %mi Γ
                                %mn 10
                              %mi ψ
                              %mo )
                            %mo ∧
