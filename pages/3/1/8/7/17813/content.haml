          #LInfinityCocyclesAsMorphisms.num_example
            %h6#example_3 Example
            %p
              According to the
              = succeed "," do
                %a{:href => "#LInfinityCohomology"} above
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              on an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \colon \mathfrak{g} \longrightarrow b^{p+1}\mathbb{R}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie (p+2)-algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi b
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b^{p+1}\mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of this is the homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi μ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \longleftarrow CE(b^{p+1}\mathbb{R}) \colon \mu^\ast
            %p
              which manifestly picks a
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CE
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
