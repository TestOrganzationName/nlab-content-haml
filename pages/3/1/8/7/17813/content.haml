              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                      %mi IIA
                  %annotation{:encoding => "application/x-tex"} \mathfrak{string}_{IIA}
              (which in components are the same, just regarded in different contexts), then the relation between the D0-brane and the M-theory spacetime extension may be stated as follows: The following diagram is
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy Cartesian
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 10
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 32
                          %mtd
                            %mo ⟵
                          %mtd
                            %mi 𝔡
                            %mn 0
                            %mi 𝔟𝔯𝔞𝔫𝔢
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 9
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 16
                                %mo +
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mn 16
                                  %mo *
                          %mtd
