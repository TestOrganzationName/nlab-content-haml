            %em
              which is, rationally, in unstable degree-4
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
