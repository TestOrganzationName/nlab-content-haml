                      \\,.
            %li
              %p if so, then resulting triangle diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝔤
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 2
                                  %mo{:stretchy => "false"} /
                                  %msub
                                    %mi 𝔥
                                    %mn 1
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %msub
