                        %msub
                          %mrow
                          %mrow
                            %mi F
                            %mn 1
                      %mi{:mathvariant => "normal"} IIA
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mi 𝒫
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_B^\ast (\mu_{{}_{F1}}^{\mathrm{IIB}} )- p_A^\ast (\mu_{{}_{F1}}^{\mathrm{IIA}})
                    \=
                    d  \mathcal{P}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This now is the super
            = succeed "-version" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            refined formulation of
            %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
          %p
            due to
            = succeed ":" do
              %a{:href => "https://ncatlab.org/nlab/show/topological+T-duality#BunkeSchick04"} Bunke-Schick 04
          %p
            %img{:src => "https://ncatlab.org/schreiber/files/BunkeTopologicalTDuality.png", :width => "600"}/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #PullPushIso.num_prop
            %h6#proposition_29 Proposition
            %p
              %strong
                (
                %a{:href => "#FSS16b"}> Fiorenza-Sati-Schreiber 16b, prop. 64
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
              of pull-push through this
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mn 9
                      %mi{:mathvariant => "normal"} IIA
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ∘
                    %msup
                      %mi ν
                      %mo *
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mn 9
                      %mi{:mathvariant => "normal"} IIB
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi H
                      %mrow
                        %msubsup
                          %mi μ
                          %mrow
                            %mi F
                            %mn 1
                          %mi{:mathvariant => "normal"} IIA
                    %mrow
                      %mo (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 9
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mn 16
                          %mo +
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mn 16
                            %mo ¯
                      %mo ,
                      %mi 𝔩
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} KU
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⟶
                    %msub
                      %mi H
                      %mrow
                        %msubsup
                          %mi μ
                          %mrow
                            %mi F
                            %mn 1
                          %mi{:mathvariant => "normal"} IIB
                    %mrow
                      %mo (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 9
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mn 16
                          %mo +
                          %mstyle{:mathvariant => "bold"}
                            %mn 16
                      %mo ,
                      %mi 𝔩
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mi{:mathvariant => "normal"} KU
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (\pi_9^{\mathrm{IIA}})_\ast \circ \nu^\ast \circ (\pi_9^{\mathrm{IIB}})^\ast
                    \\;:\;
                    H_{\mu_{F1}^{\mathrm{IIA}}} \left( \mathbb{R}^{9,1\vert \mathbf{16} + \overline{\mathbf{16}}}, \mathfrak{l}(\mathrm{KU})  \right)
                    \\longrightarrow
                    H_{\mu_{F1}^{\mathrm{IIB}}} \left( \mathbb{R}^{9,1\vert \mathbf{16} + {\mathbf{16}}}, \mathfrak{l}(\Sigma \mathrm{KU})   \right)
            %p
              Moreover, it identifies the type IIA D-brane cocycles with those of type IIB (from def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TheDBraneCocycles"}
              = succeed ":" do
                %a.maruku-ref{:href => "#CocycleTDuality"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi f
                              %mn 2
                              %mi{:mathvariant => "normal"} IIB
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msup
                              %mi C
                              %mi{:mathvariant => "normal"} IIB
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi π
                              %mn 9
                              %mi{:mathvariant => "normal"} IIA
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo ∘
                            %msup
                              %mi ν
                              %mo *
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi π
                              %mn 9
                              %mi{:mathvariant => "normal"} IIB
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mrow
                              %mo (
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msubsup
                                %mi f
                                %mn 2
                                %mi{:mathvariant => "normal"} IIA
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %msup
                                %mi C
                                %mi{:mathvariant => "normal"} IIA
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi π
                              %mn 9
                              %mi{:mathvariant => "normal"} IIA
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mrow
                              %mo (
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi 𝒫
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi π
                                %mn 9
                                %mi{:mathvariant => "normal"} IIB
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mrow
                                %mo (
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msubsup
                                  %mi f
                                  %mn 2
                                  %mi{:mathvariant => "normal"} IIA
                                %mo{:stretchy => "false"} )
                                %mo ∧
                                %msup
                                  %mi C
                                  %mi{:mathvariant => "normal"} IIA
                                %mo )
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\exp(-f_2^{\mathrm{IIB}}) \wedge  C^{\mathrm{IIB}}
                    \&amp; =
                    (\pi_9^{\mathrm{IIA}})_\ast \circ \nu^\ast \circ (\pi_9^{\mathrm{IIB}})^\ast
                    \\left(
                    \\exp(-f_2^{\mathrm{IIA}}) \wedge C^{\mathrm{IIA}}
                    \\right)
                    \\\
                    \&amp; =
                    (\pi_9^{\mathrm{IIA}})_\ast \left(
                    \\exp(\mathcal{P}) \wedge (\pi_9^{\mathrm{IIB}})^\ast \left( \exp(-f^{\mathrm{IIA}}_2) \wedge C^{\mathrm{IIA}} \right)
                    \\right)
                    \\end{aligned}
                    \\,,
          .proof
            %h6#proof_13 Proof
            %p One checks that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mn 9
                      %mi{:mathvariant => "normal"} IIA
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mrow
                      %mo (
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝒫
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi π
                        %mn 9
                        %mi{:mathvariant => "normal"} IIB
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mrow
                        %mo (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo )
                      %mo )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mn 9
                      %mi{:mathvariant => "normal"} IIA
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msubsup
                      %mi e
                      %mn 9
                      %mi IIA
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 8
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\pi_9^{\mathrm{IIA}})_\ast \left(
                    \\exp(\mathcal{P}) \wedge (\pi_9^{\mathrm{IIB}})^\ast \left( - \right)
                    \\right)
                    \=
                    (\pi_9^{\mathrm{IIA}})_\ast(-) - e_9^{IIA} \wedge (- )\vert|_{8+1}
                    \\,.
            %p
              With this the statement follows from theorem
              = succeed "," do
                %a.maruku-ref{:href => "#CocycleTDuality"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Prop.
            %a.maruku-ref{:href => "#PullPushIso"}
            is the super
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a{:href => "https://ncatlab.org/nlab/show/topological+T-duality#BunkeSchick04"} Bunke-Schick 04, theorem 3.13
          %p
            In fact on CE-algebras this is the
            %em Buscher rules for RR-fields
          %p
            also known as
            %em Hori’s formula
            (
            %a{:href => "https://ncatlab.org/nlab/show/T-duality#Hori99"}> Hori 99
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            To see why the above
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            as in
            %a{:href => "https://ncatlab.org/nlab/show/topological+T-duality#BunkeSchick04"} Bunke-Schick 04
          %p
            follows from the
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi T
                %annotation{:encoding => "application/x-tex"} \phi_T
          %p
            it is useful to break up the doubly dimensionally reduced cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi μ
                    %mrow
                      %mi F
                      %mn 1
                      %mo ,
                      %mi Dp
                    %mrow
                      %mi IIA
                      %mo{:stretchy => "false"} /
                      %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{L}( \, \mu_{F1,Dp}^{IIA/B} \, )
          %p into the part for the fiber bundle and the part for the K-cocycles:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Lie2AlgebraTDuality.num_defn
            %h6#definition_26 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} delooped T-duality Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi 𝒯
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} B \mathcal{T}_1
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup square
              of the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi 𝒯
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                    %mi B
                    %mi ℝ
                    %mo ⊕
                    %mi B
                    %mi ℝ
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi A
                        %msub
                          %mi c
                          %mn 1
                        %mo ∪
                        %msub
