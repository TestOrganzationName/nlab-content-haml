                    \\array{
                    \\mathbb{R}^{2,1\vert \mathbf{2}}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{0\vert 2}
                    }
                    \\,.
            %ul
              %li
                %p
                  whose even part is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mn 0
                        %mo ,
                        %msub
                          %mi P
                          %mn 1
                        %mo ,
                        %msub
                          %mi P
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} P_0, P_1, P_2
              %li
                %p
                  whose odd part is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbf{2}
                %p
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(2,1) \simeq SL(2,\mathbb{R})
              %li
                %p the only non-trivial bracket is the spinor bilinear pairing
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi Q
                          %mi α
                        %mo ,
                        %mi Q
                        %msub
                          %mo ′
                          %mi β
                        %mo{:stretchy => "false"} }
                        %mo =
                        %msub
                          %mi C
                          %mrow
                            %mi α
                            %mi α
                            %mo ′
                        %msub
                          %mi Γ
                          %mi a
                        %msup
                          %mrow
                          %mrow
                            %mi α
                            %mo ′
                        %msub
                          %mrow
                          %mi β
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi P
                          %mi a
                      %annotation{:encoding => "application/x-tex"}
                        \\{Q_\alpha, Q'_\beta\}
                        \=
                        C_{\alpha \alpha'} \Gamma_a{}^{\alpha'}{}_\beta
                        \\,P^a
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi α
                        %mi β
                  %annotation{:encoding => "application/x-tex"} C_{\alpha \beta}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
          %p This phenomenon continues:
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a{:href => "#MTheoryFromTheSuperpoint"}> Huerta-Schreiber 17
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              shown on the right
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/schreiber/files/TheSpacetimeExtensions.png", :width => "350"}/
            %p
              is obtained by consecutively forming maximal central extensions invariant with respect to the maximal subgroup of automorphisms for which there are invariant cocycles at all. Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert \mathbf{N}}
              is the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbf{N}
              super-translation
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              algebra. And these subgroups are the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+groups"} Lorentz groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(d-1,1)
          .num_remark
            %h6#remark_13 Remark
            %p
              That every
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              is
              %em some
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              of some
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              is elementary. This was highlighted in (
              %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+action+functional#CAIB99"}> Chryssomalakos-Azcárraga-Izquierdo-Bueno 99, 2.1
              ). But most central extensions of superpoints are nothing like super-Minkowksi spacetimes. The point of the above proposition is to restrict attention to
              %em iterated invariant
              central extensions and to find that these single out the super-Minkowski spacetimes.
          %p
            So from studying iterated invariant
            %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+geometry"}> Lorentzian geometry
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin+geometry"}> spin geometry
                \.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+spacetimes"}> super spacetimes
                \.
          #D0Cocycle.num_example
            %h6#example_11 Example
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p The 2-cocycle that classifies the extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 10
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 32
                          %mtd
                          %mtd
                            %mn 11
                            %mi d
                            %mo ,
                            %mi N
                            %mo =
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 9
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 16
                                %mo +
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mn 16
                                  %mo ¯
                          %mtd
                          %mtd
                            %mn 10
                            %mi d
                            %mo ,
                            %mtext type IIA
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{10,1\vert \mathbf{32}} &amp;&amp; 11d, N = 1
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}}} &amp;&amp; 10d, \text{type IIA}
                    }
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mn 10
                    %mi ψ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 16
                        %mo +
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mn 16
                          %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\psi} \wedge \Gamma_{10} \psi
                    \\;\in\;
                    CE(\mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}}})
            %p
              This happens to also be the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              of the
              %a.existingWikiWord{:href => "/nlab/show/WZW-term"} WZW-term
              in the
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-model"} Green-Schwarz sigma-model
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/D0-brane"} D0-brane
              = succeed "." do
                %a.maruku-ref{:href => "#TheNatureOfTheD0Cocycle"}
          %h3#TheSuperStringAndTheSuperMembrane The super-string and the super-membrane
          #CocyclesForSuperStringAndSupermembrane.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+action+functional#AETW87"}> Achúcarro-Evans-Townsend-Wiltshire 87
                ,
                = succeed "," do
                  %a{:href => "Green-Schwarz+action+functional#AzcarragaTownsend89"} Azcárraga-Townsend 89
                = succeed ")" do
                  %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+action+functional#Brandt12-13"} Brandt 12-13
            %p
              The maximal invariant 3-cocycle on 10d
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              (according to remark
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperMinkowskiInvariantCocycles"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi F
                        %mn 1
                    %mo =
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mi a
                      %mi ψ
                      %mo )
                    %mo ∧
                    %msup
                      %mi e
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{F1} = \left(\overline{\psi} \wedge \Gamma_a \psi\right) \wedge e^a
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
              for the
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
              (
              %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+action+functional#GreenSchwarz84"}> Green-Schwarz 84
              ).
            %p
              The maximal invariant 4-cocycle on 11d
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi M
                        %mn 2
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %mi a
                          %mi b
                      %mi ψ
                      %mo )
                    %mo ∧
                    %msup
                      %mi e
                      %mi a
                    %mo ∧
                    %msup
                      %mi e
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{M2} = \tfrac{i}{2} \left(\overline{\psi} \wedge \Gamma_{a b} \psi \right) \wedge e^a \wedge e^b
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/higher+WZW+term"} higher WZW term
              for the
              %a.existingWikiWord{:href => "/nlab/show/supermembrane"} supermembrane
              (
              %a{:href => "https://ncatlab.org/nlab/show/M2-brane#BergshoeffSezginTownsend87"}> Bergshoeff-Sezgin-Townsend 87
              ).
            %p
              This classification is also known as the
              = succeed "." do
                %strong
                  old
                  %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
          %p
            The 4-cocycle here reflects the first
            %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
            in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#TheM2andM5CocyclesAsFierzIdentities"}
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mo =
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \stackrel{d}{=}
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo =
                      %annotation{:encoding => "application/x-tex"} p =
                %th 1
                %th 2
