                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    C_2
                    \&amp; \coloneqq
                    \\left(\overline{\psi} \wedge \Gamma^{10} \psi\right)
                    \\\
                    C_4
