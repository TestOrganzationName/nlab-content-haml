            %tbody
              %tr
                %td{:style => "text-align: left;"} 11
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
