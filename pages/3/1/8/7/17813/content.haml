                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi F
                                    %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
