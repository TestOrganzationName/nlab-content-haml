                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}_1 \colon \tilde G \longrightarrow \mathbf{B}^{p_1+1}(\mathbb{R}/\Gamma_1)_{conn}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ˜
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi Γ
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}_2 \colon \widetilde {\hat G} \longrightarrow \mathbf{B}^{p_2+1}(\mathbb{R}/\Gamma_2)_{conn}
          %p
            be the WZW terms obtained from the two cocycles via def.
            = succeed "." do
              %a.maruku-ref{:href => "#WZWTermFromLieIntegration"}
          #ConsecutiveWZWTermsFromConsecutiveLInfinityCocycles.num_prop
            %h6#proposition_7 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              square in
              %a.existingWikiWord{:href => "/nlab/show/smooth+homotopy+types"} smooth homotopy types
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
