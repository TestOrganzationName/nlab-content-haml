          %p
            %img{:alt => "the brane bouquet", :src => "https://ncatlab.org/schreiber/files/BraneBouquetWithDualities.jpg", :width => "700"}/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p We discuss now each aspect of this picture.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#KKReductionToIIA M/IIA-Duality via Double dimensional reduction via Cyclification
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            in 11d
          %p
            is all controled by the following
            %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
          %p
            for the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 32
                %annotation{:encoding => "application/x-tex"} \mathbf{32}
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana
            %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 10
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(10,1)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo )
                  %mo ∧
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\overline{\psi} \wedge \Gamma_{a b} \psi
                  \\right)
                  \\wedge
                  \\left(
                  \\overline{\psi} \wedge \Gamma^b \psi
                  \\right)
                  \\;= \; 0
                  \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p and
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 4
                        %mi b
                    %mi ψ
                    %mo )
                  %mo ∧
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 3
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %msub
                      %mi Γ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mn 1
                        %msub
                          %mi a
                          %mn 2
                    %mi ψ
                    %mo )
                  %mo ∧
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 3
                        %msub
                          %mi a
                          %mn 4
                        %mo{:stretchy => "false"} ]
                    %mi ψ
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\overline{\psi}
                  \\wedge
                  \\Gamma_{a_1 \cdots a_4 b}
                  \\psi
                  \\right)
                  \\wedge
                  \\left(
                  \\overline{\psi}
                  \\wedge
                  \\Gamma^{b}
                  \\psi
                  \\right)
                  \\;=\;
                  3
                  \\left(
                  \\overline{\psi}
                  \\Gamma_{[a_1 a_2}
                  \\psi
                  \\right)
                  \\wedge
                  \\left(
                  \\overline{\psi}
                  \\Gamma_{a_3 a_4]}
                  \\psi
                  \\right)
          %p
            (
            %a{:href => "geometry+of+physics+--+supersymmetry#DAuriaFre82b"}> D’Auria-Fré 82b (3.13) and (3.28)
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The first
            %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
            says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 2
                  %mspace{:width => "mediummathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo )
                  %mo ∧
                  %msup
                    %mi e
                    %mi a
                  %mo ∧
                  %msup
                    %mi e
                    %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\mu_{M2}
                  \\:\coloneqq\;
                  \\left(
                  \\tfrac{i}{2}
                  \\overline{\psi}
                  \\wedge
                  \\Gamma_{a b}
                  \\psi
                  \\right)
                  \\wedge
                  e^{a}
                  \\wedge
                  e^b
          %p
            is a 4-cocycle on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 10
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 32
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{10,1\vert \mathbf{32}}
          %p
            %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
            extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi 𝔪
                          %mn 2
                          %mi 𝔟𝔯𝔞𝔫𝔢
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 10
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} |
                              %mstyle{:mathvariant => "bold"}
                                %mn 32
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔪
                  %mn 2
                  %mi 𝔟𝔯𝔞𝔫𝔢
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi e
                              %mi a
                            %mo =
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi ψ
                              %mi α
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi h
                              %mn 3
                            %mo =
                            %msub
                              %mi μ
                              %mrow
                                %mi M
                                %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathfrak{m}2\mathfrak{brane}
                  \\\
                  \\downarrow
                  \\\
                  \\mathbb{R}^{10,1\vert \mathbf{32}}
                  }
                  \\;\;\;\;\;\;\;\;\;
                  CE(\mathfrak{m}2\mathfrak{brane})
                  \=
                  \\left\{
                  \\array{
                  d \, e^a = \overline{\psi} \wedge \Gamma^a \psi
                  \\\
                  d \, \psi^\alpha = 0
                  \\\
                  d \, h_3 = \mu_{M2}
                  }
                  \\right\}
          %p The second says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 5
                        %mo !
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 5
                    %mi ψ
                    %mo )
                  %mo ∧
                  %msup
                    %mi e
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi e
                    %mrow
                      %msub
                        %mi a
                        %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi h
                    %mn 3
                  %mo ∧
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\mu_{M5}
                  \\;\coloneqq\;
                  \\tfrac{1}{5!}
                  \\left(
                  \\overline{\psi}
                  \\wedge
                  \\Gamma_{a_1 \cdots a_5}
                  \\psi
                  \\right)
                  \\wedge
                  e^{a_1}
                  \\wedge
                  \\cdots
                  \\wedge
                  e^{a_5}
                  \\;-\;
                  \\tfrac{1}{2} h_3 \wedge \mu_{M2}
          %p
            is a 7-cocycle on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔪
                  %mn 2
                  %mi 𝔟𝔯𝔞𝔫𝔢
                %annotation{:encoding => "application/x-tex"} \mathfrak{m}2\mathfrak{brane}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔪
                  %mn 2
                  %mi 𝔟𝔯𝔞𝔫𝔢
                  %mo ⟶
                  %msup
                    %mi b
                    %mn 6
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mu_{M5}
                  \\;\colon\;
                  \\mathfrak{m}2\mathfrak{brane}
                  \\longrightarrow
                  b^6 \mathbb{R}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Equivalently, (by the discussion at
            %em
              %a{:href => "#MFluxFields"} M-Flux fields
            above)
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}(S^4)
            the
            %a.existingWikiWord{:href => "/nlab/show/rational+n-sphere"} rational 4-sphere
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 4
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi g
                              %mn 4
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi g
                              %mn 7
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msub
                              %mi g
                              %mn 4
                            %mo ∧
                            %msub
                              %mi g
                              %mn 4
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{l}(S^4))
                  \=
                  \\left\{
                  \\array{
                  d \, g_4 = 0
                  \\\
                  d \, g_7 = -\tfrac{1}{2} g_4 \wedge g_4
                  }
                  \\right\}
          %p
            then the two
            %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            together say that there is a single
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            valued cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 2
                      %mo{:stretchy => "false"} /
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 10
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mstyle{:mathvariant => "bold"}
                        %mn 32
                  %mo ⟶
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mu_{M2/M5}
                  \\;\colon\;
                  \\mathbb{R}^{10,1\vert \mathbf{32}}
                  \\longrightarrow
                  \\mathfrak{l}(S^4)
          %p
            Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 4
                %annotation{:encoding => "application/x-tex"} S^4
            is the rational coefficient for the unified M2/M5 M-flux fields.
          %p
            Now we compute what becomes of this under
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            via
            = succeed "-cyclification" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed ")" do
              %a.maruku-ref{:href => "#DimensionalReduction"}
          .num_example
            %h6#example_17 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} X = S^4
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            %p
              Its free loop algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}S^4
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔏
                    %msup
                      %mi S
                      %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi h
                                %mn 3
                            %mtd
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ω
                                %mn 4
                            %mtd
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ω
                                %mn 6
                            %mtd
                              %mo =
                              %msub
                                %mi h
                                %mn 3
                              %mo ∧
                              %msub
                                %mi ω
                                %mn 4
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi h
                                %mn 7
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %msub
                                %mi ω
                                %mn 4
                              %mo ∧
                              %msub
                                %mi ω
                                %mn 4
                          %mtr
                            %mtd
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    CE( \; \mathfrak{L}S^4 \; )
                    \\;=\;
                    \\left\{
                    \\array{
                    d\, h_3 &amp; = 0
                    \\\
                    d\, \omega_4 &amp; = 0
                    \\\
                    d\, \omega_6 &amp; = h_3 \wedge \omega_4
                    \\\
                    d\, h_7 &amp; = -\tfrac{1}{2} \omega_4 \wedge \omega_4
                    \\\
                    }
                    \\right\}
            %p
              and its cyclification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %msup
                      %mi S
                      %mn 4
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}S^4 / S^1
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔏
                    %msup
                      %mi S
                      %mn 4
                    %mo{:stretchy => "false"} /
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi h
                                %mn 3
                            %mtd
                              %mo =
                              %mn 0
                          %mtr
