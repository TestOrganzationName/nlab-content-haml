                    %mn 4
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
