                            %msub
                              %mi g
                              %mn 4
                            %mo =
                            %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE\left(
                    \\mathbb{R}_{res}^{10,1\vert \mathbf{32}}
                    \\right)
                    \\coloneqq
                    \\left(
                    CE\left(
                    \\mathbb{R}^{10,1\vert \mathbf{32}}\right)\otimes \left\langle h_3, g_4\right\rangle ,
                    {{d h_3 = g_4 - \mu_4} \atop {d g_4 = 0}}
                    \\right)
                    \\,.
          .num_prop
            %h6#proposition_17 Proposition
            %p The canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℝ
                      %mi res
                      %mrow
                        %mn 10
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 32
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 10
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 32
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}_{res}^{10,1\vert \mathbf{32}}
                    \\stackrel{\simeq}{\longrightarrow}
                    \\mathbb{R}^{10,1\vert \mathbf{32}}
            %p
              given dually by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ψ
                        %mi α
                      %mo ↦
                      %msup
                        %mi ψ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \psi^\alpha \mapsto \psi^\alpha
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi a
                      %mo ↦
                      %msup
                        %mi e
                        %mi a
                    %annotation{:encoding => "application/x-tex"} e^a \mapsto e^a
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mn 2
                    %mi 𝔟𝔯𝔞𝔫𝔢
                    %mo ⟶
                    %msup
                      %mi ℝ
