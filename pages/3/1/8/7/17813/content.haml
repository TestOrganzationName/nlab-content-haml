                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                      %mi B
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\psi}\Gamma^B_{a_1 \cdots a_p}\psi
                    \=
                    \\psi^\dagger \Gamma^B_0 \Gamma^B_{a_1 \cdots a_p} \psi
            %p
              is the sum of the corresponding pairings on two copies of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
