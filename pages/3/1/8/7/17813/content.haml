                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CorrespondenceForTDuality.num_prop
            %h6#proposition_28 Proposition
            %p
              %strong
                (
                %a{:href => "#FSS16b"}> Fiorenza-Sati-Schreiber 16b, prop. 6.2
                )
            %p
              We have a diagram of super
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %p
              %img{:src => "https://ncatlab.org/schreiber/files/LInfinityTDualityCorrespondence.png", :width => "600"}/
            %p such that on the classifying 3-cocycles
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              is given by the
              %em Poincaré form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo :
                    %mo =
                    %msubsup
                      %mi e
                      %mn 9
                      %mi{:mathvariant => "normal"} IIA
                    %mo ∧
                    %msubsup
                      %mi e
                      %mn 9
                      %mi{:mathvariant => "normal"} IIB
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{P}
                    \:=
                    e_9^{\mathrm{IIA}} \wedge e_9^{\mathrm{IIB}}
            %p as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi B
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi μ
                      %mrow
                        %msub
                          %mrow
                          %mrow
                            %mi F
                            %mn 1
                      %mi{:mathvariant => "normal"} IIB
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msubsup
                      %mi p
                      %mi A
                      %mo *
                    %mo{:stretchy => "false"} (
