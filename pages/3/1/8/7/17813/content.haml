                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                    %annotation{:encoding => "application/x-tex"} \mathbf{16}
            %p By these definition we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
