          .num_example
            %h6#example_12 Example
            %p
              By prop.
              %a.maruku-ref{:href => "#HomotopyFibersOfLInfinityCocycles"}
              the super Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                      %mi het
                  %annotation{:encoding => "application/x-tex"} \mathfrak{string}_{het}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                      %mi het
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi d
                              %msup
                                %mi e
                                %mi a
                              %mo =
                              %mover
                                %mi ψ
                                %mo ¯
                              %msup
                                %mi Γ
                                %mi a
                              %mi ψ
                              %mo ,
                              %mspace{:width => "thickmathspace"}
                              %mi d
                              %msup
                                %mi ψ
                                %mi α
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi d
                              %msub
                                %mi b
                                %mn 2
                              %mo =
                              %msubsup
                                %mi μ
                                %mrow
                                  %mi F
                                  %mn 1
                                %mi het
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo ∧
                              %msub
                                %mi Γ
                                %mi a
                              %mi ψ
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %msup
                                %mi e
                                %mi a
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{string}_{het})
                    \=
                    \\left\{
                    \\array{
                    d e^a = \overline{\psi} \Gamma^a \psi,
                    \\; d \psi^\alpha = 0
                    \\\
                    d b_2 = \mu_{F1}^{het} = (\overline{\psi} \wedge \Gamma_a \psi)\wedge e^a
                    }
                    \\right\}
            %p
              This is a super-version of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
              (
              %a{:href => "#BCSS05"} Baez-Crans-Schreiber-Stevenson 05
              which controls
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
              (
              %a{:href => "#SatiSchreiberStasheff12"}> Sati-Schreiber-Stasheff 12
              ) and the topology of the
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
              (
              %a{:href => "#FiorenzaSatiSchreiber12a"}> Fiorenza-Sati-Schreiber 12a
              ,
              = succeed ")." do
                %a{:href => "#FiorenzaSatiSchreiber12b"} 12b
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} membrane super Lie 3-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mn 2
                    %mi 𝔟𝔯𝔞𝔫𝔢
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}2\mathfrak{brane}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔪
                    %mn 2
                    %mi 𝔟𝔯𝔞𝔫𝔢
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi d
                              %msup
                                %mi e
                                %mi a
                              %mo =
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo ∧
                              %msup
                                %mi Γ
                                %mi a
                              %mi ψ
                              %mo ,
                              %mspace{:width => "thickmathspace"}
                              %mi d
                              %msup
                                %mi ψ
                                %mi α
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi d
                              %msub
                                %mi b
                                %mn 3
                              %mo =
                              %mi i
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo ∧
                              %msub
                                %mi Γ
                                %mrow
                                  %mi a
                                  %mi b
                              %mi ψ
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %msup
                                %mi e
                                %mi a
                              %mo ∧
                              %msup
                                %mi e
                                %mi b
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{m}2\mathfrak{brane})
                    \=
                    \\left\{
                    \\array{
                    d e^a = \overline{\psi} \wedge \Gamma^a \psi, \; d \psi^\alpha = 0
                    \\\
                    d b_3 = i (\overline{\psi} \wedge \Gamma_{a b} \psi) \wedge e^a \wedge e^b
                    }
                    \\right\}
            %p
              This dg-algebra was first considered in
              %a{:href => "https://ncatlab.org/nlab/show/D'Auria-Fre+formulation+of+supergravity#DAuriaFre"} D’Auria-Fré 82 (3.15)
              as a tool for constructing
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              %a.existingWikiWord{:href => "/nlab/show/Lie+3-algebras"} Lie 3-algebras
              see also
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/1003.3436"} Baez-Huerta 10
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Hence the progression of maximal invariant extensions of the superpoint continues as a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            like so:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %img{:src => "https://ncatlab.org/schreiber/files/TheFirstBraneExtensions.png", :width => "450"}/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            (While every extension displayed is an invariant
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+higher+central+extension"} universal higher central extension
            %a.existingWikiWord{:href => "/nlab/show/universal+higher+central+extensions"} universal higher central extensions
            are displayed. For instance there are string and membrane GS-WZW-terms / cocycles also on the lower dimensional super-Minkowski spacetimes (“non-critical”), e.g. the
            %a.existingWikiWord{:href => "/nlab/show/super+1-brane+in+3d"} super 1-brane in 3d
            and the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/super+2-brane+in+4d"} super 2-brane in 4d
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            But how are we to think of the
            %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetimes"} extended super Minkowski spacetimes
            geometrically?
          %p This is clarified by the following result:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #GaugeStackInsideExtendedSpacetime.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong
                (
                %a{:href => "#FSS13"}> Fiorenza-Sati-Schreiber 13, section 5
                )
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi String
                          %mi IIA
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde {String_{IIA}}
              for the
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+infinity-groupoid"} super 2-group
              that
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integrates
              the super
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                      %mi IIA
                  %annotation{:encoding => "application/x-tex"} \mathfrak{string}_{IIA}
              subject to the condition that it carries a globally defined
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma_{p+1}
              a
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mover
                        %mo ⟶
                        %mi Φ
                      %mover
                        %mrow
                          %msub
                            %mi String
                            %mi IIA
                        %mo ˜
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Σ
                                %mrow
                                  %mi p
                                  %mo +
                                  %mn 1
                              %mover
                                %mo ⟶
                                %mi ϕ
                              %msup
                                %mi ℝ
                                %mrow
                                  %mn 9
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} |
                                  %mstyle{:mathvariant => "bold"}
                                    %mn 16
                                  %mo +
                                  %mover
                                    %mstyle{:mathvariant => "bold"}
                                      %mn 16
                                    %mo ¯
                              %mo ,
                          %mtr
                            %mtd
                              %mo ∇
                              %mo ∈
                              %mi Conn
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Σ
                                %mrow
                                  %mi p
                                  %mo +
                                  %mn 1
                              %mo ,
                              %msup
                                %mi ϕ
                                %mo *
                              %msub
                                %mi μ
                                %mrow
                                  %msub
                                    %mi string
                                    %mi IIA
                              %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\Sigma_{p+1}
                    \\stackrel{\Phi}{\longrightarrow}
                    \\widetilde{String_{IIA}}
                    \\right\}
                    \\;\;\;
                    \\leftrightarrow
                    \\;\;\;
                    \\left\{
                    \\array{
                    \\Sigma_{p+1} \stackrel{\phi}{\longrightarrow} \mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}} },
                    \\\
                    \\nabla \in Conn(\Sigma_{p+1}, \phi^\ast  \mu_{string_{IIA}} )
                    }
                    \\right\}
            %p
              between “higher Sigma-model fields”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              and pairs, consisting of an ordinary sigma-model field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
