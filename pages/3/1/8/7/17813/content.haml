                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu^\ast A \in \Omega^{p+2}_{cl}(X)
                    \\,.
          #GroupOfPeriods.num_defn
            %h6#definition_11 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \colon \mathfrak{g} \longrightarrow b^{p+1}\mathbb{R}
                    \\,,
            %p
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#LInfinityCocyclesAsMorphisms"}
              %em
                group of
                %a.existingWikiWord{:href => "/nlab/show/periods"} periods
              is the
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
              additive
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ↪
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \Gamma \hookrightarrow \mathbb{R}
              of those
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              which are
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi Δ
                          %mi smth
                          %mrow
                            %mi p
                            %mo +
                            %mn 3
                    %msup
                      %mi μ
                      %mo *
                    %mi A
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\partial \Delta^{p+3}_{smth}}{\int} \mu^\ast A \in \mathbb{R}
            %p
              of the value of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed "," do
                %a.maruku-ref{:href => "#LInfinityCocyclesAsMorphisms"}
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %mi p
                        %mo +
                        %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \in \Omega^1_{flat}(\partial \Delta^{p+3}_{smth})
                    \\,,
            %p
              over the
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of the (p+3)-simplex
              (which are forms with sitting instants on the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{p+2}
          #TruncatedLieIntegrationOfCocycle.num_prop
            %h6#proposition_5 Proposition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝔤
                      %mo →
                      %msup
                        %mi b
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mu \colon \mathfrak{g} \to b^{p+1}\mathbb{R}
              = succeed "," do
                %a.maruku-ref{:href => "#LInfinityCocyclesAsMorphisms"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              %a.maruku-ref{:href => "#SimplicialLieIntegrationOfLinfinityAlgebra"}
              and remark
              = succeed "," do
                %a.maruku-ref{:href => "#LieIntegrationIsFunctorial"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ≔
                    %msub
                      %mi cosk
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G \coloneqq cosk_{p+2}\exp(\mathfrak{g})
            %p
              up to quotienting the coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              by the group of
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed "," do
                %a.maruku-ref{:href => "#GroupOfPeriods"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi p
                                %mo +
                                %mn 2
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mstyle{:mathvariant => "bold"}
                                %mi c
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi p
                                %mo +
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %mi Γ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g}) &amp;\stackrel{\exp(\mu)}{\longrightarrow}&amp;
                    \\mathbf{B}^{p+2}\mathbb{R}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}G
                    \&amp;\stackrel{\mathbf{c}}{\longrightarrow}&amp;
                    \\mathbf{B}^{p+2} (\mathbb{R}/\Gamma)
                    }
                    \\,.
          %p
            This is due to (
            %a{:href => "Lie+integration#FSS12"}> FSS 12
            ).
          %p
            Here and in the following we are freely using example
            %a.maruku-ref{:href => "#ExamplesOfLieIntegration"}
            to identify
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \exp(b^{p+1}\mathbb{R}) \simeq \mathbf{B}^{p+2}\mathbb{R}
            = succeed "." do
              %a.maruku-ref{:href => "#TruncatedLieIntegrationOfCocycle"}
          %h3#higher_maurercartan_forms Higher Maurer-Cartan forms
          #FlatModality.num_defn
            %h6#definition_12 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi L
                      %mi lwhe
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CartSp
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi L
                      %mi lwhe
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CartSp
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\flat \;\colon\; L_{lwhe} PSh(\mathrm{CartSp}, sSet) \longrightarrow L_{lwhe} PSh(\mathrm{CartSp}, sSet)
            %p
              for the operation that evaluates a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              on the point and then extends the result back as a constant presheaf. This comes with a canonical
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mo ♭
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ♭
                    %mo →
                    %mi Id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon^\flat \colon \flat \to Id
                    \\,.
          #Flatbg.num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo :
                    %mi U
                    %mo ↦
                    %mi N
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi L
                      %mi lwhe
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CartSp
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G  : U \mapsto N C^\infty(U,G) \in L_{lwhe} PSh(\mathrm{CartSp}, sSet)
            %p
              for its stacky
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              %a.existingWikiWord{:href => "/nlab/show/modulating+morphism"} modulated
              by a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \mathbf{B}G
            %p
              then a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              in the homotopy-commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo ♭
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \flat \mathbf{B}G
                    \\\
                    \&amp;{}^{\mathllap{\nabla}}\nearrow&amp; \downarrow
                    \\\
                    X &amp;\longrightarrow&amp; \mathbf{B}G
                    }
            %p
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \flat \mathbf{B}G
              is the universal moduli stack for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+connections"} flat connections
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                    %annotation{:encoding => "application/x-tex"} \flat
          #MaurerCartanForm.num_defn
            %h6#definition_13 Definition
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-group"} smooth infinity-group
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mo ♭
                    %annotation{:encoding => "application/x-tex"} \epsilon^\flat
              %a.maruku-ref{:href => "#FlatModality"}
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi G
                        %mtr
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo ♭
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi ϵ
                                    %mo ♭
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G
                    \\\
                    \\downarrow^{\mathrlap{G}}
                    \\\
                    \\flat_{dR} \mathbf{B}G &amp;\longrightarrow&amp; \flat \mathbf{B}G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\epsilon^{\flat}}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
            %p We say that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
                          %mi dR
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \flat_{dR}\mathbf{B}G
                  is the
                  %em flat de Rham coefficients
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi θ
                          %mi G
                      %annotation{:encoding => "application/x-tex"} \theta_G
                  is the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
          #MaurerCartanOnLieGroup.num_example
            %h6#example_5 Example
            %p
              In the situation of example
              %a.maruku-ref{:href => "#Flatbg"}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
              and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              denoting the Lie algebra of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
