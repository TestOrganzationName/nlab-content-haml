                            %mi ψ
                            %mo{:stretchy => "false"} )
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mover
                            %mi ψ
                            %mo ¯
                          %mo ∧
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
