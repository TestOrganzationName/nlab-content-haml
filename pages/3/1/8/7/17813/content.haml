                    \\Gamma_{a_1 \cdots a_6}
                    \\psi
                    \\right)
                    \\wedge
                    e^{a_1}
                    \\wedge
                    \\cdots
                    \\wedge
                    e^{a_6}
                    \\\
                    C_{10}
                    \&amp; \coloneqq
                    \\tfrac{1}{8!}
                    \\left(
                    \\overline{\psi}
                    \\Gamma_{a_1 \cdots a_8}
                    \\Gamma_{10}
                    \\psi
                    \\right)
                    \\wedge
                    e^{a_1}
                    \\wedge
                    \\cdots
                    \\wedge
                    e^{a_8}
                    \\\
                    C_{12}
                    \&amp; \coloneqq
                    \\tfrac{i}{10!}
                    \\left(
                    \\overline{\psi}
                    \\Gamma_{a_1 \cdots a_{10}}
                    \\psi
                    \\right)
                    \\wedge
                    e^{a_1}
                    \\wedge
                    \\cdots
                    \\wedge
                    e^{a_{10}}
