            %p Therefore the all-important correction term above.
          #SuperMinkowskiInvariantCocycles.num_remark
            %h6#remark_12 Remark
            %p
              By def.
              %a.maruku-ref{:href => "#SuperLieAlgebraCohomology"}
              the super-
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              of
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetimes"} super Minkowski spacetimes
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi e
                      %mi a
                    %mo =
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
