                      %mn 9
                      %mi B
                    %mo =
                    %mi i
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Γ
                      %mn 9
                    %msub
                      %mi Γ
                      %mn 10
                    %mo =
                    %msub
                      %mi Γ
                      %mn 9
                    %msub
                      %mi Γ
                      %mn 11
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_9^B = i \, \Gamma_9 \Gamma_{10} = \Gamma_9 \Gamma_{11}
                    \\,.
            %p
              This relation also makes it manifest that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 9
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \Gamma_9^B
              commutes not only with all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \Gamma^B_{a b}
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ≤
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} a,b \leq 8
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Γ
                        %mi a
                        %mi B
                      %msubsup
                        %mi Γ
                        %mn 9
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \Gamma_a^B\Gamma_9^B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 10
                  %annotation{:encoding => "application/x-tex"} \Gamma_{10}
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 9
                  %annotation{:encoding => "application/x-tex"} \Gamma_9
              are invariant under the IIB Spin-action, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi σ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi σ
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(-\omega^{a b}\Gamma^B_{a b}) \; \sigma_i \; \exp(\omega^{a b} \Gamma^B_{a b})
                    \=
                    \\sigma_i
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i \in \{1,2,3\}
            %p
              Conversely, rotation in the
              = succeed "-plane" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (9,10)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \Gamma_a^B
              invariant, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 4
                    %msub
                      %mi Γ
                      %mn 9
                    %msub
                      %mi Γ
                      %mn 10
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 4
                    %msub
                      %mi Γ
                      %mn 9
                    %msub
                      %mi Γ
                      %mn 10
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(- \tfrac{\alpha}{4} \Gamma_9 \Gamma_{10}) \,\Gamma_a^B\, \exp(\tfrac{\alpha}{4} \Gamma_9 \Gamma_{10})
                    \\;=\;
                    \\Gamma_a^B
                    \\,.
          #TheDBraneCocycles.num_defn
            %h6#definition_21 Definition
            %p
              %strong (the D-brane cocycles)
            %p
              Define the following elements in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
