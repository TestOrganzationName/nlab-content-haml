              %p
                with respect to the
                %a.existingWikiWord{:href => "/nlab/show/local+coefficient+bundle"} local coefficient bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi ρ
                      %annotation{:encoding => "application/x-tex"} p_\rho
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p We now work out this general prescription
          %p
            for the cocycles in the
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#RRFields RR-fields
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            By the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            above
          %p
            the type IIA
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %p
            are given by super
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            cocycles of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mi IIA
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi μ
                        %mi Dp
                  %msup
                    %mi B
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{string}_{IIA }
                  \\overset{\mu_{Dp}}{\longrightarrow}
                  B^{p+1}\mathbb{R}
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 6
                    %mo ,
                    %mn 8
                    %mo ,
                    %mn 10
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \{0,2,4,6,8,10\}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Notice that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^\bullet(B U, \mathbb{Z})
          %p
            has one generator in each even degree, the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+Chern+classes"} universal Chern classes
          %p
            Hence the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %mi KU
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{l}(KU)
          %p is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %mi KU
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mi d
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi p
                        %mo +
                        %mn 2
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo ∈
                    %mi ℤ
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{l}(KU))
                  \\;\simeq\;
                  \\left\{
                  d \omega_{2p+2} = 0
                  \\;\vert\;
                  p \in \mathbb{Z}
                  \\right\}
                  \\,.
          %p This allows to unify the D-brane cocycles
          %p
            into a single morphism of super
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                            %mi IIA
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mphantom
                                %mi AA
                              %msub
                                %mi μ
                                %mi D
                              %mphantom
                                %mi AA
                        %mtd
                        %mtd
                          %mi 𝔩
                          %mo{:stretchy => "false"} (
                          %mi KU
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
