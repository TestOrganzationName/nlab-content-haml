          .num_defn
            %h6#definition_24 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℝ
                      %mi res
                      %mrow
                        %mn 10
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mn 32
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{res}^{10,1\vert \mathbf{32}}
              for the
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
              whose
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is obtained from that of
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mrow
                      %mo (
                      %msubsup
                        %mi ℝ
                        %mi res
                        %mrow
                          %mn 10
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mn 32
                      %mo )
                    %mo ≔
                    %mrow
                      %mo (
                      %mi CE
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mrow
