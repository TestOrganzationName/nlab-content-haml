                              %mi IIA
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{10,1\vert \mathbf{32}}
                    \&amp;\longleftarrow&amp;
                    \\mathfrak{d}0\mathfrak{brane}
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    \\mathbb{R}^{9,1\vert \mathbf{16}+ \mathbf{16}^\ast }
                    \&amp;\longleftarrow&amp;
                    \\mathfrak{string}_{IIA}
                    }
                    \\,.
          .num_remark
            %h6#remark_16 Remark
            %p
              %strong (brane intersection laws)
            %p
              In addition to reflecting all the brane speciees, the above
              %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
              knows the
              = succeed ":" do
                %em brane intersection laws
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                    %mi 𝔟𝔯𝔞𝔫𝔢
                    %mo ⟶
                    %msub
                      %mi p
                      %mn 1
                    %mi 𝔟𝔯𝔞𝔫𝔢
                  %annotation{:encoding => "application/x-tex"} p_2\mathfrak{brane} \longrightarrow p_1 \mathfrak{brane}
              precisely if the given species of
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
              = succeed ")." do
                %a{:href => "#FSS13"} Fiorenza-Sati-Schreiber 13, section 3
            %p
              But recall from prop.
              %a.maruku-ref{:href => "#GaugeStackInsideExtendedSpacetime"}
              the interpretation of the
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetimes"} extended super Minkowski spacetimes
              as containing a condensate of branes sourcing the gauge field on the worldvolume of the branes that they may end on.
            %p
              In conclusion this shows that given a cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \mu_{p_1+2}
              for some super
              = succeed "-brane" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
              via its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              and then given a consecutive cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \mu_{p_2+2}
              for a
              = succeed "-brane" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mi 𝔟𝔯𝔞𝔫𝔢
                  %annotation{:encoding => "application/x-tex"} p_1 \mathfrak{brane}
              see a higher gauge field on their worldvolume of the kind sourced by boundaries of
              = succeed "-branes." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mtext spacetime
                            %mrow
                              %mtext with
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi p
                                %mn 1
                              %mtext -brane condensate
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi p
                            %mn 1
                          %mi 𝔟𝔯𝔞𝔫𝔢
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi μ
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                                  %mo +
                                  %mn 2
                        %mtd
                          %msup
                            %mi B
                            %mrow
                              %msub
                                %mi p
                                %mn 2
                              %mo +
                              %mn 2
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mrow
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo +
                                    %mn 2
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mtext spacetime
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mi d
                              %mo −
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} |
                              %mstyle{:mathvariant => "bold"}
                                %mi N
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi μ
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                                  %mo +
                                  %mn 2
                        %mtd
                          %msup
                            %mi B
                            %mrow
                              %msub
                                %mi p
                                %mn 1
                              %mo +
                              %mn 1
                          %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  {
                  \\text{spacetime}
                  \\atop
                  \\text{with}\,p_1\text{-brane condensate}
                  }
                  \&amp;&amp;&amp; p_1 \mathfrak{brane} &amp;\overset{\mu_{p_2+2}}{\longrightarrow}&amp; B^{p_2+2}
                  \\\
                  \&amp;&amp;&amp; {}^{\mathllap{hofib(\mu_{p_1+2})}}\downarrow
                  \\\
                  \\text{spacetime}
                  \&amp;&amp;&amp; \mathbb{R}^{d-1,1\vert \mathbf{N}}
                  \&amp;\underset{\mu_{p_1+2}}{\longrightarrow}&amp;
                  B^{p_1+1}\mathbb{R}
                  }
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mi 𝔟𝔯𝔞𝔫𝔢
                %annotation{:encoding => "application/x-tex"} p_1 \mathfrak{brane}
            is like the original super spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert \mathbf{N}}
            but filled with a
            %a.existingWikiWord{:href => "/nlab/show/condensation"} condensate
            of
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            While this is good, it means that at each stage of the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            we are describing
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p This we turn to now.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#Fields Fields
          %p
            In the discussion
            %a{:href => "#Branes"} above
            we discovered all the
            %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
            species of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^{p+1}\mathbb{R}
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
            classified by a previous cocycle.
          %p
            Here we discuss that all these cocycles unify into single cocycles. However, these unified cocycles are no longer in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the simple
            %a.existingWikiWord{:href => "/nlab/show/line+Lie-n+algebras"} line Lie-n algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b^{p+1}\mathbb{R}
            as in proposition
            = succeed "." do
              %a.maruku-ref{:href => "#HomotopyFibersOfLInfinityCocycles"}
          %p
            Instead they have coefficients in richer and in general non-abelian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
            theory. By a phenomenon that has been called the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+principle+of+non-abelian+cohomology"} Whitehead principle of non-abelian cohomology
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
                theory
          %ul
            %li
              %em
                %a{:href => "#TwistedGeneralizedCohomology"} Twisted generalized cohomology
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology
            is generally exhibited by classifying
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            as certain spaces (or rather as
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            of certain spaces). This connection is provided by a theory called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %ul
            %li
              %em>
                %a{:href => "#RationalHomotopyTheory"} Rational homotopy theory
              \.
          %p
            After these conceptual preliminaries, we then turn to the concrete example of the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            established
            %a{:href => "#Branes"} above
            and ask for homotopy descent of consecutive ordinary cocycles on
            %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetimes"} extended super Minkowski spacetimes
            to single but twisted generalized cocycles down on plain
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetimes"} super Minkowski spacetimes
          %p
            First we consider this for the
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            and we derive that the unified F1/Dp-brane cocycles exist with coefficients the
            %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
          %ul
            %li
              %em>
                %a{:href => "#RRFields"} RR-Fields
              \.
          %p
            In direct analogy, we then discover the corresponding rationalized coefficients for the
            %a.existingWikiWord{:href => "/nlab/show/background+fields"} background fields
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M-branes"} M-branes
            %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
            in degree 4. This we discuss in
          %ul
            %li
              %em
                %a{:href => "#MFluxFields"} M-Flux Fields
          %p
            More technically, what we show now is that there is
            %em
              homotopy
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            of
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
            down to ordinary
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            which yields cocycles in
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            for the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            and the M-flux fields (
            %a{:href => "#FSS15"}> Fiorenza-Sati-Schreiber 15
            ,
            = succeed ")." do
              %a{:href => "#FSS16a"} 16a
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#TwistedGeneralizedCohomology Twisted generalized cohomology
          %p
            There is a traditional physics story for how
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            appears on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %p
            It is often stated that a
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            coincident
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            is an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU(n)
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            in degree 1.
          %p
            But this is not quite true. In general there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ′
                %annotation{:encoding => "application/x-tex"} n'
            %a.existingWikiWord{:href => "/nlab/show/anti-D-branes"} anti-D-branes
            coinciding, carrying
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi brane
                %annotation{:encoding => "application/x-tex"} V_{brane}
            (of
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mtext anti-brane
                %annotation{:encoding => "application/x-tex"} V_{\text{anti-brane}}
            (of rank
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} n'
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mtext brane
                  %mo ,
                  %msub
                    %mi V
                    %mtext anti-brane
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (V_{\text{brane}}, V_{\text{anti-brane}})
                  \\,.
          %p
            Such pairs are also called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
          %p
            But
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            annihilate with
            %a.existingWikiWord{:href => "/nlab/show/anti-D-branes"} anti-D-branes
            (
            %a{:href => "https://ncatlab.org/nlab/show/anti+D-brane#Sen98"}> Sen 98
            ) when they are coincident and have exact opposite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton
            vector bundle. In other words, pairs as above of the special form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W,W)
            are equivalent to pairs of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∼
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (W,W)
                  \\;\sim\;
                  0
                  \\,.
          %p
            Hence the net Chan-Paton charge of coincident branes and anti-branes is really the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mtext brane
                  %mo ,
                  %msub
                    %mi V
                    %mtext anti-brane
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V_{\text{brane}}, V_{\text{anti-brane}})
            under the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            which is generated by the
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mtext brane
                  %mo ⊕
                  %mi W
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mtext anti-brane
                  %mo ⊕
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∼
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi brane
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mrow
                      %mi anti
                      %mo −
                      %mi brane
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (V_{\text{brane}} \oplus W\,,\; V_{\text{anti-brane}} \oplus W)
                  \\;\sim\;
                  (V_{brane}\,,\; V_{anti-brane})
          %p
            for all
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            (
            %a{:href => "https://ncatlab.org/nlab/show/anti+D-brane#Witten98"}> Witten 98
            ,
            = succeed ")." do
              %a{:href => "https://ncatlab.org/nlab/show/D-brane#Witten00"} Witten 00
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The additive
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            of such equivalence classes of
            %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
            is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"}> topological K-theory
              \. This behaves in many ways as
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              does, but is richer. One says that it is a
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology theory
            %em .
          %p
            Hence by this story,
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
            should take values in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/RR-fields"} RR-fields
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
            plays the role of
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            and
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            in
            %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
            also the
            %a.existingWikiWord{:href => "/nlab/show/RR-fields"} RR-fields
            must be
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            (
            %a{:href => "https://ncatlab.org/nlab/show/anti+D-brane#MooreWitten99"}> Moore-Witten 00
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            A famous fact about
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(X,\mathbb{Z})
            is that it is
            %em represented
            by
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},n)
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} B^n \mathbb{Z}
            and called
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
            then there is a
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mrow
                      %mo {
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo ⟶
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi B
                        %mi n
                      %mi ℤ
                      %mo }
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi homotopy
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,\mathbb{Z})
                  \\;\simeq\;
                  \\left\{
                  X \;\longrightarrow\; B^n \mathbb{Z}
                  \\right\}_{/homotopy}
          %p
            between
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            classes of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B^n \mathbb{Z}
          %p
            The collection of all these
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B^n \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            ranges, has the property that each is the
            %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
            of the previous one, up to
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi n
                  %mi ℤ
                  %munderover
                    %mo ⟶
                    %mtext weak hom. equivalence
                    %mo ≃
                  %msub
                    %mi Ω
                    %mo *
                  %mrow
                    %mo (
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B^n \mathbb{Z}
                  \\underoverset{\text{weak hom. equivalence}}{\simeq}{\longrightarrow}
                  \\Omega_\ast \left( B^{n+1}\mathbb{Z} \right)
                  \\,.
          %p
            More generally, in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            any sequence of
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            indexed by the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            and equipped with such
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                  %mover
                    %mo ⟶
                    %mo ≃
                  %msub
                    %mi Ω
                    %mo *
                  %mrow
                    %mo (
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  E_n \overset{\simeq}{\longrightarrow} \Omega_\ast \left(  E_{n+1} \right)
          %p
            is called a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+stable+homotopy+types"} geometry of physics – stable homotopy types
            for more on this.
          %p
            Here for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            denotes the operation of constructing the
            %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} space of continuous loops
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            from the basepoint to itself. Thought of this way, then the based loop space is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            of the base point inclusion with itself, denoted as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mo *
                  %mrow
                    %mo (
                    %mi X
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %munder
                      %mrow
                        %mo *
                        %munderover
                          %mo ×
                          %mi X
                          %mi h
                        %mo *
                      %mo ⏟
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mtext homotopy
                      %mrow
                        %mtext fiber product
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega_\ast \left( X  \right)
                  \\;\simeq\;
                  \\underset{
                  \\text{homotopy} \atop \text{fiber product}
                  }{
                  \\underbrace{
                  \\ast \underoverset{X}{h}{\times} \ast
                  }
                  }
                  \\,.
          %p
            In direct analogy to the above situation, one says for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                %annotation{:encoding => "application/x-tex"} E_\bullet
            any such
            %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
            that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            into its component space in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mrow
                      %mo {
                      %mi X
                      %mo ⟶
                      %msub
                        %mi E
                        %mi n
                      %mo }
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mtext homotopy
                %annotation{:encoding => "application/x-tex"}
                  E^n(X)
                  \\;\coloneqq\;
                  \\left\{
                  X \longrightarrow E_n
                  \\right\}_{/\text{homotopy}}
          %p
            are the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
            classes of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            i degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            One also says that the cohomology theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^\bullet(-)
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
              is
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented
            by the
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            The example of interest for D-brane charge,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
            denoted by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi KU
                %annotation{:encoding => "application/x-tex"}
                  E = KU
          %p with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi KU
                    %mrow
                      %mn 2
                      %mi n
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℤ
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi KU
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mo ≃
                  %mi U
                %annotation{:encoding => "application/x-tex"}
                  KU_{2n} \simeq (B U) \times \mathbb{Z}
                  \\;\;\,,\;\;
                  KU_{2n+1} \simeq U
          %p where
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                denotes the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/stable+unitary+group"} stable unitary group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/BU"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi U
                      %annotation{:encoding => "application/x-tex"} B U
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                for
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
          %p
            So in this case a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
            of a map of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %msub
                      %mi V
                      %mi brane
                    %mo ,
                    %msub
                      %mi n
                      %mtext anti-brane
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\left(V_{brane}, n_{\text{anti-brane}} \right)
                  \\;\colon\;
                  X \overset{}{\longrightarrow} (B U) \times \mathbb{Z}
          %p
            which gives a
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mtext brane
                %annotation{:encoding => "application/x-tex"} V_{\text{brane}}
            and the trivial vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mrow
                      %msub
                        %mi n
                        %mtext anti-brane
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^{n_{\text{anti-brane}}}
            of
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mtext anti-brane
                  %annotation{:encoding => "application/x-tex"} n_{\text{anti-brane}}
            %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundle"} virtual vector bundle
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mtext brane
                  %mo ,
                  %msup
                    %mi ℂ
                    %mrow
                      %msub
                        %mi n
                        %mtext anti-brane
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (V_{\text{brane}}, \mathbb{C}^{n_{\text{anti-brane}}})
                  \\,.
          %p
            A basic fact proven in
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            is that the K-theory class of every
            %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundle"} virtual vector bundle
            is represented by one of this form, and it is in this way that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi KU
                    %mn 0
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} KU_0 = (B U) \times \mathbb{Z}
            is the
            %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
            space for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %p
            But this is not yet the full story: Above we saw that the
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            on a D-brane is actually a
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+vector+bundle"} twisted vector bundle
            with twist given by the
            %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            sourced by a string condensate. (
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten+anomaly+cancellation"}> Freed-Witten anomaly cancellation
            ).
          %p
            Such
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
            is given by generalizing the above concept of
            %a.existingWikiWord{:href => "/nlab/show/Omega-spectra"} Omega-spectra
            by allowing the base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            to become a
            = succeed "." do
              %em classifying space of twists
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} parameterized spectrum
          %ol
            %li
              %p
                a classifying space of twists
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B G
            %li
              %p
                a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
                    in the
                    %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Top
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi B
                              %mi G
                        %annotation{:encoding => "application/x-tex"} Top_{/B G}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} E_n/G
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi G
                      %mo →
                      %msub
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mo →
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"}
                      id \;\colon\; B G \to E_n/G \to B G
              %p
                and
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                from the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
                of space inclusion of the space of twists with itself:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mo ≃
                          %mphantom
                            %mi AA
                      %msub
                        %mi Ω
                        %mrow
                          %mi B
                          %mi G
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %munder
                        %munder
                          %mrow
                            %mi B
                            %mi G
                            %munderover
                              %mo ×
                              %mrow
                                %msub
                                  %mi E
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %mo{:stretchy => "false"} /
                                %mi G
                              %mi h
                            %mi B
                            %mi G
                          %mo ⏟
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mtext homotopy
                          %mrow
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mtext fiber
                              %mrow
                                %mtext product
                    %annotation{:encoding => "application/x-tex"}
                      E_n/G
                      \\overset{\phantom{AA}\simeq\phantom{AA} }{\longrightarrow}
                      \\Omega_{B G} (E_{n+1}/G)
                      \\coloneqq
                      \\underset{\text{homotopy} \atop {\text{fiber} \atop \text{product} } }{\underbrace{
                      B G
                      \\underoverset{E_{n+1}/G}{h}{\times}
                      B G
                      }}
          %p
            To get a feeling for this definition, consider two extremal cases of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
          %ol
            %li
              %p
                An ordinary spectrum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is a parameterized spectrum over the point (i.e. no twists);
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      E
                      \\\
                      \\downarrow
                      \\\
                      \\ast
                      }
            %li
              %p
                An ordinary
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is identified with the
                %a.existingWikiWord{:href => "/nlab/show/zero-spectrum"} zero-spectrum
                parameterized over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi id
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      \\downarrow^{\mathrlap{id}}
                      \\\
                      X
                      }
          %p
            Hence a general
            %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} parameterized spectrum
            interpolates between these two extremes, it combines the
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
            represented by
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                %annotation{:encoding => "application/x-tex"} B U
            with the abelian cohomology
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
          %p
            More in detail, given a
            %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} parameterized spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "):" do
              %a{:href => "#NSS12"} NSS 12, section 4.1
          %ol
            %li
              %p
                A
                %em twist
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                for the
                = succeed "-cohomology" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi τ
                              %mo ↘
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                              %mi G
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      \&amp; {}_{\mathllap{\tau}}\searrow
                      \\\
                      \&amp;&amp; B G
                      }
              %p
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the spectrum’s classifying space of twists.
            %li
              %p
                The
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} \tau
                  \-twisted
                  = succeed "-cohomology" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is the set of
                %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
                of maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ⟶
                        %mi ϕ
                      %msub
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \overset{\phi}{\longrightarrow} E_n/G
                together with a
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi n
                        %mo ∘
                        %mi ϕ
                        %mo ≃
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} p_n \circ \phi \simeq \tau
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %mi n
                          %mo +
                          %mi τ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi X
                                %mtd
                                %mtd
                                  %mo ⟶
                                %mtd
                                %mtd
                                  %msub
                                    %mi E
                                    %mi n
                                  %mo{:stretchy => "false"} /
                                  %mi G
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mi τ
                                  %mo ↘
                                %mtd
                                %mtd
                                  %msub
                                    %mo ↙
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi p
                                          %mi n
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi B
                                  %mi G
                          %mo }
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mtext homotopy
                    %annotation{:encoding => "application/x-tex"}
                      E^{n+\tau}(X)
                      \\;\coloneqq\;
                      \\left\{
                      \\array{
                      X &amp;&amp; \longrightarrow &amp;&amp; E_n/G
                      \\\
                      \&amp; {}_{\mathllap{\tau}} \searrow &amp;&amp; \swarrow_{\mathrlap{p_n}}
                      \\\
                      \&amp;&amp; B G
                      }
                      \\right\}_{/\text{homotopy}}
            %li
              %p
                There is a
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
                (in parameterized spectra)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi E
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi E
                              %mo{:stretchy => "false"} /
                              %mi G
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                              %mi G
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      E &amp;\longrightarrow&amp; E/G
                      \\\
                      \&amp;&amp; \downarrow
                      \\\
                      \&amp;&amp; B G
                      }
              %p
                and this equivalently exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} E/G
                as the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                of an ordinary spectrum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                by a
          %p
            %a.existingWikiWord{:href => "/nlab/show/infinity-action"} coherent homotopy action
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            We now translate this situation from topological spaces to
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            via the central theorem of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#RationalHomotopyTheory Rational homotopy theory
          %p
            Recall from the discussion
            %a{:href => "#SuperLInfinityCohomologyAndFDAs"} above
            that an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            may be thought of as a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            “up to
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            higher
            = succeed "\u201D:" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-]
            regarded as a differential
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \partial \coloneqq [-]
            %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
            up to which the
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            holds
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %munderover
                    %mo ⟶
                    %mo ≃
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo ±
                  %mo{:stretchy => "false"} [
                  %mi y
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [x,[y,z]]
                  \\underoverset{\simeq}{\partial [x,y,z]}{\longrightarrow}
                  [[x,y],z] \pm [y,[x,z]]
                  \\,.
          %p
            In direct analogy, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega_\ast(X)
            (the
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            whose elements are continuous paths from the basepoint to itself) naturally is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            “up to
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            higher homotopy”.
          %p Namely
          %ul
            %li
              %p
                the operation of concatenating two loops
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ,
                      %mi β
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \alpha,\beta \colon [0,1] \to X
                to a new loop
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mrow
                          %mn 2
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      [0,1] \overset{2 \cdot(-)}{\longrightarrow} [0,2]
                      \\overset{}{\longrightarrow}
                      X
              %p
                gives it the structure of a
                %a.existingWikiWord{:href => "/nlab/show/semi-group"} semi-group
                whose
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
                law holds up to
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %li
              %p
                the constant loop gives it the structure of a
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                up to coherent homotopy, called an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
            %li
              %p the reversal of loops
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mrow
                          %mn 1
                          %mo −
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mi α
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      [0,1] \overset{1-(-)}{\longrightarrow} [0,1] \overset{\alpha}{\longrightarrow} X
              %p
                finally gives it
                %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
                up to homotopy and makes it what is called a a
                %em
                  grouplike
                  %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
                or
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                for short.
          %p
            Conversely, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            any
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            then there is an essentially unique
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi Ω
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} G \;\simeq\; \Omega B G
            (the
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
          %p
            Now in a similar manner, every double loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ω
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega_\ast(\Omega_\ast(X))
            becomes a “first order abelian”
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            by exchanging loop directons. This may be called a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            is itself an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            and so there exists an essentially unique
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mn 2
                  %mi G
                  %mo ≔
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  B^2 G \coloneqq B (B G)
          %p with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mn 2
                  %msup
                    %mi B
                    %mn 2
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G \;\simeq\; \Omega^2 B^2 G
                  \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p And so forth:
          %p
            Every triple loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 3
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega^3 X
          %p
            becomes a “second order abelian”
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
          %p by exchanging loop directons
          %p
            called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/sylleptic+%E2%88%9E-group"} sylleptic ∞-group
          %p etc.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            the maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                  %mover
                    %mo →
                    %mo ≃
                  %mi Ω
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} E_n \stackrel{\simeq}{\to} \Omega E_{n+1}
          %p
            exhbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            as an
            %a.existingWikiWord{:href => "/nlab/show/infinite+loop+space"} infinite loop space
          %p
            hence as a fully
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-group"} abelian ∞-group
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            It turns out that by a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
            version of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
          %p
            there is an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            associated with any
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ≃
                  %mi 𝔩
                  %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g} \simeq  \mathfrak{l} B G
                  \\,.
          %p or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi 𝔤
                  %mo ≃
                  %mi 𝔩
                  %msup
                    %mi B
                    %mn 2
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  B\mathfrak{g} \simeq  \mathfrak{l} B^2 G
          %p etc.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔅𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{B g})
          %p
            is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 2
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B^2 G
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            For
            %strong example
            the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  K(\mathbb{Z},n+1) \simeq B^{n+1}\mathbb{Z}
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/line+Lie-n+algebra"} line Lie-n algebra
            from above:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi B
                    %mi n
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{l}(B^{n+1} \mathbb{Z})
                  \\;\simeq\;
                  B^n \mathbb{R}
                  \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The
            %strong
              main theorem of
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            (
            %a{:href => "https://ncatlab.org/nlab/show/rational+homotopy+theory#Quillen69"}> Quillen 69
            ,
            = succeed ")" do
              %a{:href => "https://ncatlab.org/nlab/show/rational+homotopy+theory#Sullivan77"} Sullivan 77
          %p
            says that the
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mn 2
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}(B^2 G)
            equivalently reflects the
            %em
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mn 2
                  %mi G
                %annotation{:encoding => "application/x-tex"} B^2 G
          %p
            (in fact the real-ification, since we are considering
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            This means that weak equivalence between
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            that induce
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            on real-ified
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mn 2
                            %msub
                              %mi G
                              %mn 1
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi f
                                %mphantom
                                  %mi AA
                            %msup
                              %mi B
                              %mn 2
                            %msub
                              %mi G
                              %mn 2
                        %mtr
                          %mtd
                            %mtext such that:
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi B
                              %mn 2
                            %msub
