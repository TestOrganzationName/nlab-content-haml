                        %mi μ
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔥
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mu_2/\mathfrak{h}_1
                as a
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                in (
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"}> rational
                )
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
