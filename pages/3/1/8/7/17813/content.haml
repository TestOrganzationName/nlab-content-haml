              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
          %p
            By the
            %a{:href => "model+structure+for+L-infinity+algebras#HomotopyFiberProducts"} recognition theorem for L-∞ extensions
            we get:
          #b2RactionOnb2p2R.num_prop
            %h6#proposition_16 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %msub
                        %mi ℕ
                        %mi even
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}_{even}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory+of+L-%E2%88%9E+algebras"} homotopy theory of L-∞ algebras
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
