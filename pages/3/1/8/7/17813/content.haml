                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "," do
              %a.maruku-ref{:href => "#CorrectReductionOnTopologicalSpaces"}
            = succeed ":" do
              %a.maruku-ref{:href => "#GeneralReduction"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #ddReduction.num_prop
            %h6#proposition_25 Proposition
            %p
              %strong
                (
                %a{:href => "#FSS16b"}> Fiorenza-Sati-Schreiber 16b, prop. 3.8
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi 𝔤
                              %mo ^
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi π
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi 𝔤
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 2
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widehat{\mathfrak{g}}
                    \\\
                    {}^{\mathllap{\pi}}\downarrow
                    \\\
                    \\mathfrak{g}
                    \\\
                    \&amp; {}_{\mathllap{\mu_2}}\searrow
                    \\\
                    \&amp;&amp; B \mathbb{R}
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
              %a.maruku-ref{:href => "#HomotopyFibersOfLInfinityCocycles"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi e
                    %mo ,
                    %mi d
                    %mi e
                    %mo =
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\widehat{\mathfrak{g}})
                    \\simeq
                    CE(\mathfrak{g})[e, d e = \mu_2]
                    \\,.
            %p
              and hence every generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi p
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_p \in CE(\widehat{\mathfrak{g}})
              has a unique decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi p
                    %mo =
                    %msub
                      %mi β
                      %mi p
                    %mo −
                    %mi e
                    %mo ∧
                    %msub
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_p = \beta_p - e \wedge \tilde \alpha_{p-1}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \beta_p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \tilde \alpha_{p-1}
              do not involve the generator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mi p
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi 𝔤
                    %mo ≔
                    %msub
                      %mi β
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\ast(\alpha_p) \coloneqq \tilde \alpha_{p-1}
                    \\;\;\;\;\,\;
                    \\alpha_p|_{\mathfrak{g}} \coloneqq \beta_p
                    \\,.
            %p
              Under this identification any super
              = succeed "-homomorphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %mi 𝔥
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \widehat{\mathfrak{g}} \overset{\phi}{\longrightarrow} \mathfrak{h}
            %p
              hence a
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔥
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^\ast
                    \\;\colon\;
                    CE(\mathfrak{h})
                    \\longrightarrow
                    CE(\widehat{\mathfrak{g}})
            %p gives rise to a homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ⟶
                    %mi 𝔏
                    %mi 𝔤
                    %mo{:stretchy => "false"} /
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \phi
                    \\;\colon\;
                    \\mathfrak{g}
                    \\longrightarrow
                    \\mathfrak{L}\mathfrak{g}/\mathbb{R}
            %p
              which, in the notation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#Cyclification"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi ϕ
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi α
                            %mtd
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ϕ
                                %mo *
                              %mi α
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} |
                                %mi 𝔤
                          %mtr
                            %mtd
                              %mi s
                              %mi α
                            %mtd
                              %mo ↦
                              %msub
                                %mi π
                                %mo *
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ϕ
                                %mo *
                              %mi α
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi ω
                                %mn 2
                            %mtd
                              %mo ↦
                              %msub
                                %mi μ
                                %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \phi^\ast
                    \\colon
                    \\left\{
                    \\array{
                    \\alpha &amp; \mapsto (\phi^\ast \alpha)|_{\mathfrak{g}}
                    \\\
                    s \alpha &amp; \mapsto \pi_\ast(\phi^\ast \alpha)
                    \\\
                    \\omega_2 &amp; \mapsto \mu_2
