              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p The first of these two conditions is
          %p
            the super
            = succeed "-version" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
            due to
            = succeed "." do
              %a{:href => "https://ncatlab.org/nlab/show/topological%20T-duality#BouwknegtEvslinMathai04"} Bouwknegt-Evslin-Mathai 04
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %img{:src => "https://ncatlab.org/schreiber/files/CorrespondenceConditionTDuality.png", :width => "650"}/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p To understand the second condition
          %p
            pass to the correspondence super
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
