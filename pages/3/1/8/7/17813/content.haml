            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                    %msubsup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                      %mi B
                    %mi ψ
                    %mo =
                    %msup
                      %mi ψ
                      %mo †
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mi B
                    %msubsup
                      %mi Γ
                      %mrow
