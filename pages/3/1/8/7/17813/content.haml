                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %munder
                                %mrow
                                  %mi Hom
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mi 𝔤
                                    %mo ^
                                  %mo ,
                                  %mi 𝔥
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mtext original
                                %mrow
                                  %mtext cocycles
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %munderover
                              %mo ≃
                              %munder
                                %mo ⟵
                                %mi oxidation
                              %mover
                                %mo ⟶
                                %mi reduction
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi Hom
                                    %mrow
                                      %mo{:stretchy => "false"} /
                                      %mi B
                                      %mi ℝ
                                  %mo{:stretchy => "false"} (
                                  %mi 𝔤
                                  %mo ,
                                  %mi 𝔏
                                  %mi 𝔥
                                  %mo{:stretchy => "false"} /
                                  %mi ℝ
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mtext doubly
                                %mrow
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mtext dimensionally reduced
                                    %mrow
                                      %mtext cocycles
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mtext given by
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %mrow
                                %mtable
