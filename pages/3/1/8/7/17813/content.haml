                            %mrow
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mn 1
                        %mo ⇝
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \overset{\rightsquigarrow}{\mathbb{R}^{0 \vert 1}} \simeq \mathbb{R}^0
            %p
              Its maximal
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              is the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
