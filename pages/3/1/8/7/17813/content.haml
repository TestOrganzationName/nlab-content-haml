                  %annotation{:encoding => "application/x-tex"} g_{p+4}\mapsto 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
