                              %mi α
                              %mn 4
                          %msup
                            %mi ω
                            %mrow
                              %mi a
                              %mi b
                          %msub
                            %mi Γ
                            %mrow
                              %mi a
                              %mi b
                          %mo{:stretchy => "false"} )
                          %msub
                            %mi Γ
                            %mi a
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi α
                              %mn 2
