                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi F
                                    %mn 1
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 9
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} |
                              %mstyle{:mathvariant => "bold"}
                                %mn 16
                              %mo +
                              %mover
                                %mstyle{:mathvariant => "bold"}
                                  %mn 16
                                %mo ¯
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi F
                                    %mn 1
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathfrak{string}_{IIA}
                  \&amp;&amp;
                  \\stackrel{\phantom{AA}\mu_D\phantom{AA}}{\longrightarrow}
                  \&amp;&amp;
                  \\mathfrak{l}(KU)
                  \\\
                  {}^{\mathllap{hofib(\mu_{F1})}}\downarrow
                  \\\
                  \\mathbb{R}^{9,1\vert \mathbf{16}+ \overline{\mathbf{16}}}
                  \\\
                  \&amp; {}_{\mathllap{\mu_{F1}}}\searrow
                  \\\
                  \&amp;&amp;
                  \\mathbf{B}^2 \mathbb{R}
                  }
                  \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            By the above prescription, descending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi D
                %annotation{:encoding => "application/x-tex"} \mu_D
            is equivalent
          %p
            to finding a
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of super
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                            %mi IIA
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mphantom
                                %mi AA
                              %msub
                                %mi μ
                                %mi D
                              %mphantom
                                %mi AA
                        %mtd
                        %mtd
                          %mi 𝔩
                          %mo{:stretchy => "false"} (
