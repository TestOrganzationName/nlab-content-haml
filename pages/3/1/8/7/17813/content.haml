          #DimensionalReductionAbstractly.proof
            %h6#proof_11 Proof
            %p
              First observe that the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G,X]
              is the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Act
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Act_G(\mathbf{H})
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    Act_G(\mathbf{H}) \simeq \mathbf{H}_{/\mathbf{B}G}
            %p
              (from
              = succeed ")" do
                %a{:href => "#NSS12"} Nikolaus-Schreiber-Stevenson 12
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with its canonical
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast \to \mathbf{B}G)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the trivial action is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \times \mathbf{B}G \to \mathbf{B}G)
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi X
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [G,X]/G
                    \\simeq
                    [\ast, X \times \mathbf{B}G]_{\mathbf{B}G}
                    \\;\;\;\;\;
                    \\in
                    \\mathbf{H}_{/\mathbf{B}G}
                    \\,.
            %p
              Actually, this is the very definition of what
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} [G,X]/G \in \mathbf{H}_{/\mathbf{B}G}
              is to mean in the first place, abstractly. But now since the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
              is itself cartesian closed, via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    E \times_{\mathbf{B}G}(-)
                    \\;\;\;
                    \\dashv
                    \\;\;\;
                    [E,-]_{\mathbf{B}G}
            %p
              it is immediate that there is the following sequence of
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalences"} natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi G
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo ,
                            %mi X
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo *
                            %mo ,
                            %munder
                              %munder
                                %mrow
                                  %mi X
                                  %mo ×
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mi G
                                %mo ⏟
                              %mrow
                                %msup
                                  %mi p
                                  %mo *
                                %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi p
                                    %mo !
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %msub
                                    %mo ×
                                    %mrow
                                      %mstyle{:mathvariant => "bold"}
                                        %mi B
                                      %mi G
                                  %mo *
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mi hofib
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{/\mathbf{B}G}(Y, [G,X]/G)
                    \&amp; \simeq
                    \\mathbf{H}_{/\mathbf{B}G}(Y, [\ast, X \times \mathbf{B}G]_{\mathbf{B}G})
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}_{/\mathbf{B}G}(
                    Y \times_{\mathbf{B}G} \ast,
                    \\underset{p^\ast X}{\underbrace{X \times \mathbf{B}G }}
                    )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(
                    \\underset{hofib(Y)}{\underbrace{p_!(Y \times_{\mathbf{B}G} \ast)}},
                    X
                    )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(hofib(Y),X)
                    \\end{aligned}
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} p \colon \mathbf{B}G \to \ast
              denotes the terminal morphism and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                    %mo ⊣
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_! \dashv p^\ast
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              along it.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We now apply this general mechanism to the
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#DoubleDimensionalReductionLInfinity
            On super
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            By the discussion of
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %a{:href => "#RationalHomotopyTheory"} above
            we may think of
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            as
            %a.existingWikiWord{:href => "/nlab/show/rational+topological+spaces"} rational topological spaces
            and more generally as rational
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
            %a{:href => "#RRFields"} above
            we found that the
            %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
            space for
            %a.existingWikiWord{:href => "/nlab/show/RR-fields"} RR-fields
            in rational
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔩
                    %mo{:stretchy => "false"} (
                    %mi KU
                    %mo{:stretchy => "false"} /
                    %mi BU
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{l}(KU/BU(1))
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Hence in order to apply
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            to
            %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            we now specialize the above general formalization (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#GeneralReduction"}
            %strong
              cyclification of
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            (
            %a{:href => "#FSS16b"}> FSS 16b
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Cyclification.num_defn
            %h6#definition_25 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              any
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              %strong cyclification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔏
                    %mi 𝔤
                    %mo{:stretchy => "false"} /
                    %mi ℝ
                    %mo ∈
                    %mi s
                    %msub
                      %mi L
