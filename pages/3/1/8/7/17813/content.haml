                                      %mover
                                        %mi 𝔤
                                        %mo ^
                                      %mover
                                        %mo ⟶
                                        %mrow
                                      %mi 𝔥
                              %mo )
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ↔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mrow
                              %mo (
