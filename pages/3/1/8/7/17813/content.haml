            %p
              The following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            %p
              %img{:src => "https://ncatlab.org/schreiber/files/CocycleTDualityIso.png", :width => "600"}/
            %p In particular this means that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi π
                          %mn 9
                          %mrow
                            %mi IIA
                            %mo{:stretchy => "false"} /
                            %mi IIB
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mrow
                          %mo (
                          %msubsup
                            %mi μ
                            %mrow
                              %mi F
                              %mn 1
                            %mrow
                              %mi IIA
                              %mo{:stretchy => "false"} /
                              %mi IIB
                          %mo )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msubsup
                          %mi c
                          %mn 2
                          %mrow
                            %mi IIA
                            %mo{:stretchy => "false"} /
                            %mi IIB
                      %annotation{:encoding => "application/x-tex"} (\pi^{IIA/IIB}_9)_\ast \left( \mu^{IIA/IIB}_{F1} \right) = - c_2^{IIA/IIB}
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi π
                          %mn 9
                          %mi IIA
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msubsup
                          %mi e
                          %mn 9
                          %mi IIA
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
