            is the actual
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            that the
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
