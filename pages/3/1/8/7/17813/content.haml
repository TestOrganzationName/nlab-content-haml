              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              is the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} N = 1
              super-
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/superparticle"} superparticle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 0
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{0,1\vert \mathbf{1}}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{0\vert 1}
                    }
                    \\,.
            %ul
              %li
                %p
                  whose even part is spanned by one generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
              %li
                %p
                  whose odd part is spanned by one generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
