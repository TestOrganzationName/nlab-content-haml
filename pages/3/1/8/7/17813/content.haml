                              %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{deg = (1,even)}{\underbrace{e^a}}
                    \\;\;\;\;
                    and
                    \\;\;\;\;
                    \\underset{deg = (1,odd)}{\underbrace{\psi^\alpha}}
                    \\;\;\;\;
                    and
                    \\;\;\;\;
                    \\underset{deg = (1,even)}{\underbrace{\omega^{a b} = - \omega^{b a}}}
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi a
                    %mo ,
                    %msup
                      %mi ψ
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e^a, \psi^\alpha)
              as before, and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                  %annotation{:encoding => "application/x-tex"} \omega^{a b}
              the
              %a.existingWikiWord{:href => "/nlab/show/dual+basis"} dual basis
              of the induced
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              for vectro space of skew-symmetric matricces underlying the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                  %annotation{:encoding => "application/x-tex"} \omega^{a b}
              anti-commute with every generator. Finally the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi 𝔦𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} |
                            %mi N
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_{\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N})}
              acts on these generators as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi 𝔦𝔰𝔬
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ψ
                              %mi α
                          %mtd
                            %mo ≔
                            %msup
                              %mrow
                                %mo (
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mn 4
                                %msup
                                  %mi ω
                                  %mrow
                                    %mi a
                                    %mi b
                                %msub
                                  %mi Γ
                                  %mrow
                                    %mi a
                                    %mi b
                                %mi ψ
                                %mo )
                              %mi α
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 4
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Γ
                                %mrow
                                  %mi a
                                  %mi b
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi α
                              %msub
                                %mrow
                                %mi β
                              %mo )
                            %msup
                              %mi ω
                              %mrow
                                %mi a
                                %mi b
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi 𝔦𝔰𝔬
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mo ≔
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                            %mo −
                            %msup
                              %mi ω
                              %mi a
                            %msub
                              %mrow
                              %mi b
                            %mo ∧
                            %msup
                              %mi e
                              %mi b
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
