                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msub
                              %mi μ
                              %mrow
                                %mi M
                                %mn 2
                            %mo ∧
                            %msub
                              %mi μ
                              %mrow
                                %mi M
                                %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{CE} \,\underset{\text{M5-brane} \atop {\kappa\text{-symmetry flux}  }}{\underbrace{\mu_{M5}}}
                    \&amp; =
                    \\tfrac{1}{5!}
                    d_{CE}\left(
                    \\left(
                    \\overline{\psi}
                    \\wedge
                    \\Gamma_{a_1 \cdots a_5}
                    \\psi
                    \\right)
                    \\wedge
                    e_{a_1}
                    \\wedge
                    \\cdots
                    \\wedge
                    e_{a_5}
                    \\right)
                    \\;+\;
                    d_{CE} h_3 \wedge \mu_{M2}
                    \\\
                    \&amp; =
                    \\tfrac{1}{4!}
                    \\underset{
                    \\underset{\text{Fierz identity} \atop \text{D'Auria-Fre '82}}{=}
                    3
                    \\left(
                    \\overline{\psi}
                    \\wedge
                    \\Gamma_{[a_1 a_2}
                    \\psi
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\psi}
                    \\wedge
                    \\Gamma_{a_3 a_4]}
                    \\psi
                    \\right)
                    }{
                    \\underbrace{
                    \\left(
                    \\overline{\psi}
                    \\wedge
                    \\Gamma_{[a_1 \cdot a_4 a]}
                    \\psi
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\psi}
                    \\wedge
                    \\Gamma^a
                    \\psi
                    \\right)
                    }
                    }
                    \\wedge
                    e^{a_1} \wedge \cdots \wedge e^{a_4}
                    \\;+\;
                    \\tfrac{1}{2}\mu_{M2} \wedge \mu_{M2}
                    \\\
                    \&amp; =
                    \-
                    \\tfrac{1}{2}
                    \\mu_{M2} \wedge \mu_{M2}
                    +
                    \\tfrac{1}{2}
                    \\mu_{M2} \wedge \mu_{M2}
                    \\\
                    \&amp; = 0
                    \\end{aligned}
            %p
              Here the identity under the brace is the
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheM2andM5CocyclesAsFierzIdentities"}
          %p
            Notice how it is the presence of the extra higher generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mn 3
                %annotation{:encoding => "application/x-tex"} h_3
            of degree 3 in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔪
                  %mn 2
                  %mi 𝔟𝔯𝔞𝔫𝔢
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{m}2\mathfrak{brane})
            that makes prop.
            %a.maruku-ref{:href => "#TheM5BraneCocycle"}
            work.
          %p
            That the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mrow
                      %mi M
                      %mn 5
                %annotation{:encoding => "application/x-tex"} \mu_{M5}
            in def.
            %a.maruku-ref{:href => "#TheM5BraneCocycleAsACocycle"}
            is the curvature of the
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+WZW+model"} higher WZW-term
            of the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            was argued in
            %a{:href => "M5-brane#BLNPST97"} BLNPST97
          %p
            It turns out that from just prop.
            %a.maruku-ref{:href => "#TheM5BraneCocycleAsACocycle"}
            one obtains the
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            cocycles in 10d by applying
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
            constructions corresponding to
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
            %em
              %a{:href => "#DoubleDimensionalReduction"} Double dimensional reduction
            and in
            = succeed "." do
              %em
                %a{:href => "#TDuality"} T-duality
          %p
            Here for the moment we just state the resulting cocycle conditions, below as def.
            = succeed "," do
              %a.maruku-ref{:href => "#TheDBraneCocycles"}
            %a.maruku-ref{:href => "#TheIIADBraneCocycles"}
            and prop.
            = succeed "." do
              %a.maruku-ref{:href => "#TheCocyclesForTheIIBTypeDBranes"}
            %a.maruku-ref{:href => "#ConvenientSpinorBasis"}
            the well adapted bases for type IIA/IIB spinors from
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
            %em
              %a{:href => "geometry+of+physics+--+supersymmetry#InDimensions11And10And9"} Example: Spinors in dimension 11, 10 and 9
          #ConvenientSpinorBasis.num_defn
            %h6#definition_20 Definition
            %p
              %strong (basis for IIA/IIB spinors)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi γ
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi a
                        %mo =
                        %mn 0
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \{\gamma_a\}_{a = 0}^{d-1}
              be a
              %a.existingWikiWord{:href => "/nlab/show/Dirac+representation"} Dirac representation
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 16
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{16}
              of the Lorentzian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 9
                  %annotation{:encoding => "application/x-tex"} d= 9
              Clifford algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(8,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} d = 10
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 11
                  %annotation{:encoding => "application/x-tex"} d = 11
              Clifford algebra by taking the following block matrices acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 16
                    %mo ⊕
                    %msup
                      %mi ℂ
                      %mn 16
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{16} \oplus \mathbb{C}^{16}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mo ≤
                        %mn 8
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi γ
                                %mi a
                          %mtr
                            %mtd
                              %msup
                                %mi γ
                                %mi a
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi Γ
                      %mn 9
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi{:mathvariant => "normal"} I
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi{:mathvariant => "normal"} I
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi Γ
                      %mn 10
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi i
                              %mi{:mathvariant => "normal"} I
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %mi{:mathvariant => "normal"} I
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{a \leq 8}
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; \gamma^a
                    \\\
                    \\gamma^a &amp; 0
                    }
                    \\right)
                    \\;, \qquad
                    \\Gamma_9
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; \mathrm{I}
                    \\\
                    \-\mathrm{I} &amp; 0
                    }
                    \\right)
                    \\;, \qquad
                    \\Gamma_{10}
                    \\coloneqq
                    \\left(
                    \\array{
                    i \mathrm{I} &amp; 0
                    \\\
                    0 &amp; -i \mathrm{I}
                    }
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is the identity matrix.
            %p
              The unique irreducible
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spin
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spin}(10,1)
              is of real dimension 32. Under the inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spin
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi{:mathvariant => "normal"} Spin
                    %mo{:stretchy => "false"} (
                    %mn 9
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi{:mathvariant => "normal"} Spin
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Spin}(8,1) \hookrightarrow \mathrm{Spin}(9,1) \hookrightarrow \mathrm{Spin}(10,1)
            %p this representation branches as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                    %mo ↦
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo ⊕
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                      %mo ¯
                    %mo ↦
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo ⊕
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{32} \mapsto \mathbf{16}\oplus \overline{\mathbf{16}} \mapsto \mathbf{16} \oplus \mathbf{16}
                    \\,,
            %p
              where in the middle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                  %annotation{:encoding => "application/x-tex"} \mathbf{16}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\mathbf{16}}
              are the left and right chiral Majorana-Weyl representations in 10d, while on the right the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                  %annotation{:encoding => "application/x-tex"} \mathbf{16}
              is again the unique irreducible real representation in 9d. Under this branching we decompose a Majorana spinor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                  %annotation{:encoding => "application/x-tex"} \psi \in \mathbf{32}
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi ψ
                                %mn 1
                          %mtr
                            %mtd
                              %msub
                                %mi ψ
                                %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\psi
                    \=
                    \\left(
                    \\array{
                    \\psi_1
                    \\\
                    \\psi_2
                    }
                    \\right)
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 1
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                  %annotation{:encoding => "application/x-tex"} \psi_1 \in \mathbf{16}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                    %mo ∈
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \psi_2 \in \overline{\mathbf{16}}
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                    %annotation{:encoding => "application/x-tex"} \mathbf{16}
            %p
              Define another set of matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi a
                        %mo =
                        %mn 0
                      %mn 9
                  %annotation{:encoding => "application/x-tex"} \{\Gamma_a^B\}_{a = 0}^{9}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                    %mo :
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi a
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo ≤
                              %mn 8
                              %mspace{:width => "thickmathspace"}
                              %mo ,
                          %mtr
                            %mtd
                              %mrow
                                %mo (
                                %mrow
                                  %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                    %mtr
                                      %mtd
                                        %mn 0
                                      %mtd
                                        %mi{:mathvariant => "normal"} I
                                    %mtr
                                      %mtd
                                        %mi{:mathvariant => "normal"} I
                                      %mtd
                                        %mn 0
                                %mo )
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo =
                              %mn 9
                              %mspace{:width => "thickmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_a^{B}
                    \:=
                    \\left\{
                    \\array{
                    \\Gamma_a &amp; \vert \; a \leq 8\;,
                    \\\
                    \\begin{pmatrix}
                    0 &amp; \mathrm{I}
                    \\\
                    \\mathrm{I} &amp; 0
                    \\end{pmatrix}
                    \&amp;
                    \\vert \; a = 9\;.
                    }
                    \\right.
            %p
              For emphasis we write the original matrices also as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Γ
                        %mi a
                        %mi A
                      %mo :
                      %mo =
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Gamma_a^A := \Gamma_a
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mn 9
                    %annotation{:encoding => "application/x-tex"} a \leq 9
            %p Moreover we also write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo :
                    %mo =
                    %msub
                      %mi Γ
                      %mn 9
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi σ
                      %mn 2
                    %mo :
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Γ
                      %mn 9
                    %msub
                      %mi Γ
                      %mn 10
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi σ
                      %mn 3
                    %mo :
                    %mo =
                    %msub
                      %mi Γ
                      %mn 10
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_1 := \Gamma_9
                    \\;\,,\;\;\;\;\;
                    \\sigma_2 := -\Gamma_{9} \Gamma_{10}
                    \\;\,,\;\;\;\;\;
                    \\sigma_3 := \Gamma_{10}
                    \\,.
            %p
              Noice that the matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi B
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi a
                        %mo =
                        %mn 0
                      %mn 9
                  %annotation{:encoding => "application/x-tex"} \{\Gamma^B_a\}_{a = 0}^9
              in do not represent a Clifford algebra, but the product of any even number of them represents the correct such product acting on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                      %mo ⊕
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                    %annotation{:encoding => "application/x-tex"} \mathbf{16} \oplus \mathbf{16}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msubsup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\omega^{a b}\Gamma^B_{a b})
              are the elements of the
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Spin}(d-1,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                      %mo ⊕
                      %mstyle{:mathvariant => "bold"}
                        %mn 16
                    %annotation{:encoding => "application/x-tex"} \mathbf{16}\oplus \mathbf{16}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
