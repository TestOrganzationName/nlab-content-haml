          %title Fundamental super p-branes
          %p
            %br/
          %p
            %br/
          %blockquote
            %p
              this entry is one section of “
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry+and+superphysics"}> geometry of physics – supergeometry and superphysics
              ” which is one chapter of “
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"}> geometry of physics
              ”
            %p
              previous section:
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
            %p
              next section:
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+flux+quantization"} geometry of physics – flux quantization
          %p
            %br/
          %p
            A remarkable consequence of the general fact that
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            is slightly
            %a.existingWikiWord{:href => "/nlab/show/non-commutative+geometry"} non-commutative
            is that
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetimes"} super Minkowski spacetimes
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in super-
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"}> Lie algebra cohomology
            \. Generally, invariant
            = succeed "-cocycles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
            %a.existingWikiWord{:href => "/nlab/show/cosets"} cosets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            induce interesting
            %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            for
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            %a.existingWikiWord{:href => "/nlab/show/field+theories"} field theories
            with
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            of
            = succeed "," do
              %em
                fundamental
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p = 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the coset of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %em
              %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            describing a
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            that propagates on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/higher+WZW+models"} higher WZW models
            here.
          %div{:style => "float:right;margin:-50px 0px 0px 20px;"}
            %img{:src => "https://ncatlab.org/nlab/files/OldBraneScan.jpg", :width => "350"}/
          %p
            Accordingly, each of the exceptional invariant cocycles on
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            defines a
            %a.existingWikiWord{:href => "/nlab/show/super+p-brane"} super p-brane
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            %em
              fundamental
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
            and the
            %em
              fundamental
              %a.existingWikiWord{:href => "/nlab/show/supermembrane"} supermembrane
            that appear in, or rather that
            %em define
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            and
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            (“M-theory” is a “non-committal” shorthand for “membrane theory”,
            = succeed ")" do
              %a{:href => "#M-theory#NonCommittal"} (Hořava-Witten 95, p. 2
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
            = succeed ")." do
              %a{:href => "#AETW87"} Achúcarro-Evans-TownsendWiltshire 87
          %div{:style => "float:left;margin:0px 10px 0px 0px;"}
            %img{:src => "https://ncatlab.org/schreiber/files/TheSecondBraneExtensions.png", :width => "350"}/
          %p
            Now in higher generalization of how an invariant 2-cocycle on some
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/central+extension"} central
            super-
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
            of it to a higher dimensional spacetime, so every higher cocycle, i.e. every
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p+2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p \geq 1
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie (p+1)-algebra
            extension of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
            extensions defined by the cocycles for the
            %a.existingWikiWord{:href => "/nlab/show/super-string"} super-string
            and the
            %a.existingWikiWord{:href => "/nlab/show/super-membrane"} super-membrane
            make further invariant higher cocycles appear. Interpreting these in turn as
            %a.existingWikiWord{:href => "/nlab/show/higher+WZW+models"} higher WZW models
            for
            %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            it turns out that they correspond to the
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            and to the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            that appear in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
            to a tree-like structure of higher invariant extensions that may be called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/brane+bouquet"} brane bouquet
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/super+p-brane"} super p-brane
            content purely in terms of
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
            theory (
            %a{:href => "#FSS13"}> FSS 13
            ).
          %div{:style => "float:right;margin:0 0px 0px 10px;"}
            %img{:alt => "the brane bouquet", :src => "https://ncatlab.org/schreiber/files/BraneBouquetWithDualities.jpg", :width => "550"}/
          %p
            Moreover, it turns out that on
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            of
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebras"} super Lie n-algebras
            there is a natural
            %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theoretic
            operation of
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
            for the “
            %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"}> cyclification
            ”
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            (
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotiented
            by loop rotation). Applying this to the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            turns out to yield relations between the super Lie
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/dualities+in+string+theory"} dualities in string theory
            at the level of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            from
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            of the latter to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+IIB+string+theory"} type IIB string theory
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            of the latter, and its relation to
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            (
            %a{:href => "#FSS16a"}> FSS 16a
            ,
            = succeed ")." do
              %a{:href => "#FSS16b"} FSS 16b
          %p
            Notice that all this concerns
            %em fundamental
            %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            (sometimes referred to as “probe
            = succeed "-branes\u201D)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+particles"} fundamental particles
            = succeed "-branes\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/black+p-branes"} black branes
            %a.existingWikiWord{:href => "/nlab/show/black+branes"} black branes
            (that appear for notably in the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT+correspondence"} AdS/CFT correspondence
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            %a.existingWikiWord{:href => "/nlab/show/worldvolumes"} worldvolumes
            are the
            %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS state
            solutions to the
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            which express but the consistent globalization of the fundamental
            %a.existingWikiWord{:href => "/nlab/show/super+p-brane"} super p-brane
            %a.existingWikiWord{:href => "/nlab/show/sigma+models"} sigma models
            (
            %a{:href => "#BergshoeffSezginTownsend87"}> Bergshoeff-Sezgin-Townsend 87
            ), and moreover their
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            theories are but the
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            of the fundamental
            %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            about these asymptotic singular loci (
            %a{:href => "#ClausKalloshProeyen97"}> Claus-Kallosh-vanProeyen 97
            ,
            = succeed ")." do
              %a{:href => "#ClausKalloshKumarTownsend98"} Claus-Kallosh-Kumar-Townsend 98
          %div{:style => "float:left;margin:0 10px 0px 0px;"}
            %img{:alt => "the brane bouquet", :src => "https://ncatlab.org/nlab/files/TheMTheoryAmoeba.jpg", :width => "300"}/
          %p
            Hence a fair bit of the folklore structure of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            is (re-)discovered by systematic classification of the invariant higher extensions of
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetimes"} super Minkowski spacetimes
            in
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetimes"} super-Minkowski spacetimes
            are themselves already classified as the consecutive ordinary invariant extensions of just the
            %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            (we review this
            = succeed ")." do
              %a{:href => "#SuperMinowskiSpacetimes"} below
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            is (re-)discovered by a systematic classification of the consecutive invariant higher extension of the
            %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            in
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+n-algebra"} super Lie n-algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/ComputationWithYoungTableaux.jpg", :width => "300"}/
          %p
            Computationally, all the these cocycles in the
            %a.existingWikiWord{:href => "/schreiber/show/brane+bouquet"} brane bouquet
            exist due to special
            %em
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            (which we discuss
            = succeed ")," do
              %a{:href => "#FierzIdentities"} below
            %a.existingWikiWord{:href => "/nlab/show/Clebsch-Gordan+coefficients"} Clebsch-Gordan coefficients
            that express the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor-product
            operation in the
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin+groups"} spin groups
            in the given dimensions (
            %a{:href => "#DAuriaFreMainaRegge82"}> D’Auria-Fré-Maina-Regge 82
            ,
            = succeed "," do
              %a{:href => "#DAuriaFre82a"} D’Auria-Fré 82a
            = succeed "))." do
              %a{:href => "#DAuriaFre82b"} D’Auria-Fré 82b
          %p
            Hence there is a tight interplay between spinorial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            %a.existingWikiWord{:href => "/nlab/show/superalgebra"} super-algebraic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            that gives rise to a finite system of
            %a.existingWikiWord{:href => "/nlab/show/universal+exceptionalism"} exceptional
            structures: the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h1#fundamental_super_pbranes Fundamental super p-branes
          .maruku_toc
            %ul
              %li
