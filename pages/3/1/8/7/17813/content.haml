                    d_{CE} \, e^a = \overline{\psi} \wedge \Gamma^a \psi
                    \\;\;\;\,,\;\;\;
                    d_{CE} \, \psi^\alpha = 0
                    \\,.
            %p
              (also called “
              %a.existingWikiWord{:href => "/nlab/show/tau-cohomology"}> tau-cohomology
              ”).
            %p
              This may superficially look fairly trivial, but in fact it turns out to me very rich. Specifically we are interested in the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              cohomology. A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                    %annotation{:encoding => "application/x-tex"} Spin
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              %a.existingWikiWord{:href => "/nlab/show/cochain"} cochain
              in the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{d-1,1\vert M})
              is easily seen to be equivalently a sum of wedge products of the above generators, such that all indices are contracted with
              = succeed "-matrices." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi ψ
                      %mo ¯
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                    %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{p+2}
                    \\;\coloneqq\;
                    \\overline{\psi} \Gamma_{a_1 \cdots a_p} \psi
                    \\,.
            %p
              We immediately find that the differential takes these to the following expressions (using the fact that the differential is a graded
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %msub
                      %mi μ
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                          %mi b
                      %mi ψ
                      %mo )
                    %mo ∧
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msup
                        %mi Γ
                        %mi b
                      %mi ψ
                      %mo )
                    %mo ∧
                    %msup
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi e
                      %mrow
                        %msub
                          %mi p
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \mu_{p+2}
                    \\;=\;
                    p
                    \\;
                    \\left(
                    \\overline{\psi} \wedge \Gamma_{a_1 \cdots a_{p-1} b} \psi
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\psi} \wedge \Gamma^b \psi
                    \\right)
                    \\wedge
                    e^{a_1}\wedge \cdots \wedge e^{p_{p-1}}
                    \\,.
            %p
              For the these expressions to vanish, all their components have to vanish, hence all the following
              %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} quadrilinear
              expressions in the
              %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
              have to vanish identicaly:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %msub
                      %mi μ
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                          %mi b
                      %mi ψ
                      %mo )
                    %mo ∧
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msup
                        %mi Γ
                        %mi b
                      %mi ψ
                      %mo )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \mu_{p+2} = 0
                    \\;\;\;\; \Leftrightarrow
                    \\;\;\;\;
                    \\left(
                    \\overline{\psi} \wedge \Gamma_{a_1 \cdots a_{p-1} b} \psi
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\psi} \wedge \Gamma^b \psi
                    \\right)
                    \= 0
                    \\,.
          %p
            Such relation among spinors are known as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            = succeed "." do
              %em
                %a{:href => "#FierzIdentities"} Fierz identities
          %h2#FierzIdentities Fierz identities
          %p
            What are called
            %em
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            are the relations that hold between
            %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear
            expression in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            in Lorentian spacetime dimension 4,5,7, 11, then the following identity holds (example
            %a.maruku-ref{:href => "#TheM2andM5CocyclesAsFierzIdentities"}
            below):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo )
                  %mo ∧
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(\overline{\psi} \wedge \Gamma_{a b} \psi\right)
                  \\wedge
                  \\left(\overline{\psi} \wedge \Gamma^b \psi\right)
                  
                  \\;=\;
                  0
                  \\,.
          %p
            (Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{(-)}
            denotes the Majorana conjugate,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Gamma_a
            are a Clifford representations, the “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            ”-signs denotes symmetrization in the spinor components and summation over repeated indices is understood. The details of this are discussed
            = succeed ".)" do
              %a{:href => "#BilinearFierzIdentities"} below
          %p
            In
            %a{:href => "#DAuriaFreMainaRegge82"} D’Auria-Fré-Maina-Regge 82
            it was pointed out that all Fierz identities may be understood as expressing the product operation in the
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            (in some given dimension): for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{S_i\}_{i \in I}
            denoting
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            of
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
            decomposes again as a
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi i
                  %mo ⊗
                  %msub
                    %mi S
                    %mi j
                  %mo =
                  %munder
                    %mo ⊕
                    %mi k
                  %msub
                    %mi C
                    %mrow
                      %mi i
                      %mi j
                  %msup
                    %mrow
                    %mi k
                  %msub
                    %mi S
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  S_i \otimes S_j  = \underset{k}{\oplus} C_{i j}{}^k S_k
          %p
            with “
            %a.existingWikiWord{:href => "/nlab/show/Clebsch-Gordan+coefficients"}> Clebsch-Gordan coefficients
            ”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi i
                        %mi j
                    %msup
                      %mrow
                      %mi k
                  %annotation{:encoding => "application/x-tex"} C_{i j}{}^k
          %p
            For example for Lorentzian dimension 11 with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 5
                %annotation{:encoding => "application/x-tex"} (\tfrac{1}{2})^5
            denoting the unique irreducible
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
            representation, then one finds (
            %a{:href => "#DAuriaFre82b"}> D’Auria-Fré 82b, section 3
            ) that the symmetric part in the quadruple tensor product of this representation with itself decomposes as a direct sum of irreps as follows
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 5
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 5
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 5
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 5
                      %mo }
                    %mi sym
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 4
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo ⊕
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 5
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  (\tfrac{1}{2})^5
                  \\otimes
                  (\tfrac{1}{2})^5
                  \\otimes
                  (\tfrac{1}{2})^5
                  \\otimes
                  (\tfrac{1}{2})^5
                  \\right\}_{sym}
                  \\;\simeq\;
                  (0)^5
                  \\;\oplus\;
                  (1)^3 (0)^2
                  \\;\oplus\;
                  (1)^4 (0)
                  \\;\oplus\;
                  (1)^5
                  \\;\oplus\;
                  (2) (0)^4
                  \\;\oplus\;
                  (2)(1)(0)^3
                  \\;\oplus\;
                  (2)^2 (0)^3
                  \\;\oplus\;
                  (2)^2 (1)^3
                  \\;\oplus\;
                  (2)^5
          %p
            where the symbols refer to
            %a.existingWikiWord{:href => "/nlab/show/Young+diagrams"} Young diagrams
            canonically labeling representations (details are in example
            %a.maruku-ref{:href => "#11dQuadrilinearCGCoefficients"}
            below).
          %p
            The point is that the expression
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo )
                  %mo ∧
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(\overline{\psi} \wedge \Gamma_{a b} \psi\right) \wedge \left(\overline{\psi} \wedge \Gamma^b \psi\right)
            from above is a spinor quadrilinear which transforms in the vector representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 4
                %annotation{:encoding => "application/x-tex"} (1)(0)^4
            (due to its one free spacetime index). But that vector representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 4
                %annotation{:encoding => "application/x-tex"} (1)(0)^4
            is missing from the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            above, meaning that the spinor quadrilinear has vanishing components in this vector representation, hence that this expression vanishes identically.
          %p
            We discuss Fierz identities as identities among multispinorial elements of the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{d-1,1\vert N})
            of
            %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in the
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            super-
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"}> Lie algebra cohomology
            , such as those which serve as
            %a.existingWikiWord{:href => "/nlab/show/higher+WZW+terms"} higher WZW terms
            characterizing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            = succeed "." do
              %a{:href => "#CDF"} Castellani-D’Auria-Fré 82, section II.8
          %h3#BilinearFierzIdentities Bilinear Fierz identities
          %p
            Given a fixed
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi θ
                    %mi α
                  %msubsup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi α
                      %mo =
                      %mn 1
                    %mrow
                      %msub
                        %mi dim
                        %mi ℝ
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{\theta^\alpha\}_{\alpha = 1}^{dim_{\mathbb{R}}(N) }
            of the
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
            span, by construction, precisely that representation space, and hence so do the spinorial components of the
            %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
            form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mi α
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mi α
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi li
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\psi^\alpha = \mathbf{d}\theta^\alpha
                  \\;\;\;
                  \\in \Omega^{\bullet}_{li}(\mathbb{R}^{d-1,1\vert N})
                  \\simeq
                  CE(\mathbb{R}^{d-1,1\vert N})
                  \\,,
          %p
            since in the construction of
            %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                %annotation{:encoding => "application/x-tex"} \mathbf{d}
            acts on the odd coordinates just formally, by sending the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mi α
                %annotation{:encoding => "application/x-tex"} \theta^\alpha
            to the new generator named
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \mathbf{d} \theta^\alpha
          %p
            Therefore we may identify the
            %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            with the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            (over
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ≃
                  %mo{:stretchy => "false"} ⟨
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi θ
                    %mi α
                  %msubsup
                    %mo{:stretchy => "false"} ⟩
                    %mrow
                      %mi α
                      %mo =
                      %mn 1
                    %mrow
                      %msub
                        %mi dim
                        %mi ℝ
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  N  \simeq \langle \mathbf{d}\theta^\alpha \rangle_{\alpha = 1}^{dim_{\mathbb{R}}(N) }
                  \\,,
          %p
            were the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            acts on the elements on the right in the defining way (see at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \omega = \{\omega^{a b}\}
            by an angle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            acts by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi ω
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi α
                      %mn 4
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                  %mo{:stretchy => "false"} )
                  %mi ψ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  R_\omega(\psi) \coloneqq \exp(\tfrac{\alpha}{4} \omega^{a b} \Gamma_{a b} ) \psi
                  \\,.
          %p
            We may build new
            %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            from this one by forming multilinear expressions in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{d-1,1\vert N})
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mover
                            %mi ψ
                            %mo ¯
                          %mo ∧
                          %msub
                            %mi Γ
                            %mi a
                          %mi ψ
                        %mtd
                          %mo =
                          %mrow
                            %mo (
                            %msub
                              %mi C
                              %mrow
                                %mi α
                                %mi α
                                %mo ′
                            %msub
                              %mi Γ
                              %mi a
                            %msubsup
                              %mrow
                              %mi β
                              %mrow
                                %mi α
                                %mo ′
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi ψ
                            %mi α
                          %mo ∧
                          %msup
                            %mi ψ
                            %mi β
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mrow
                            %mo (
                            %msub
                              %mi C
                              %mrow
                                %mi α
                                %mi α
                                %mo ′
                            %msub
                              %mi Γ
                              %mi a
                            %msubsup
                              %mrow
                              %mi β
                              %mrow
                                %mi α
                                %mo ′
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi θ
                            %mi α
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi θ
                            %mi β
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\overline{\psi} \wedge \Gamma_a \psi
                  \&amp;=
                  \\left(C_{\alpha \alpha'} \Gamma_a{}^{\alpha'}_{\beta}\right) \, \psi^\alpha \wedge \psi^{\beta}
                  \\\
                  \&amp; =
                  \\left(C_{\alpha \alpha'} \Gamma_a{}^{\alpha'}_{\beta}\right) \, \mathbf{d}\theta^\alpha \wedge \mathbf{d}\theta^\beta
                  \\end{aligned}
          %p
            span, as the spacetime index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            ranges in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi d
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0, 1, \cdots, d-1\}
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mrow
                      %mo ⟨
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mi a
                      %mi ψ
                      %mspace{:width => "thinmathspace"}
                      %mo ⟩
                    %mrow
                      %mi a
                      %mo =
                      %mn 0
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\left\langle
                  \\,\overline{\psi} \wedge \Gamma_a \psi\,
                  \\right\rangle_{a = 0}^{d-1}
          %p
            which still carries a linear
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            = succeed "-s:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi R
                            %mi ω
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi ψ
                            %mo ¯
                          %mo ∧
                          %msub
                            %mi Γ
                            %mi a
                          %mi ψ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mover
                            %mrow
                              %mo (
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mi α
                                  %mn 4
                              %msup
                                %mi ω
                                %mrow
                                  %mi a
                                  %mi b
                              %msub
                                %mi Γ
                                %mrow
                                  %mi a
                                  %mi b
                              %mo{:stretchy => "false"} )
                              %mi ψ
                              %mo )
                            %mo ¯
                          %mo ∧
                          %msub
                            %mi Γ
                            %mi a
                          %mrow
                            %mo (
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi α
                                %mn 4
                            %msup
                              %mi ω
                              %mrow
                                %mi a
                                %mi b
                            %msub
                              %mi Γ
                              %mrow
