                  %annotation{:encoding => "application/x-tex"} \hat \mathfrak{g} \to \mathfrak{g}\stackrel{\mu}{\longrightarrow} b^{p+1}\mathbb{R}
              induces a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              diagram of the associated objects of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
              = succeed "," do
                %a.maruku-ref{:href => "#SimplicialLieIntegrationOfLinfinityAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mover
                              %mi 𝔤
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi μ
