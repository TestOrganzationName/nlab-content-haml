                    S^3 &amp;\longrightarrow&amp; S^7
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; S^4
                    }
          %p
            But since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔪
                  %mn 2
                  %mi 𝔟𝔯𝔞𝔫𝔢
                %annotation{:encoding => "application/x-tex"} \mathfrak{m}2\mathfrak{brane}
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^2 \mathbb{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mn 3
                  %mo ∧
                  %msub
                    %mi μ
                    %mn 4
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 15
                  %msub
                    %mi μ
                    %mn 7
                %annotation{:encoding => "application/x-tex"} h_3 \wedge \mu_4 + \frac{1}{15} \mu_7
            is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^2 \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant
            with respect to some natural
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^2\mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 6
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^6 \mathbb{R}
            = succeed "." do
              %a.maruku-ref{:href => "#b2RactionOnb2p2R"}
            %a.maruku-ref{:href => "#The7CocycleOnm2brane"}
            with respect to this action we need a
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of
