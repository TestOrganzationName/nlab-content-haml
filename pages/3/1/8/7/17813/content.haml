                              %mrow
                                %mn 2
                                %mi p
                                %mo +
                                %mn 2
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi b
                              %mrow
                                %mn 2
                                %mi p
                                %mo +
                                %mn 2
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi b
                              %mi p
                            %mi ℝ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msup
                              %mi b
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    b^{2p+2} \mathbb{R}
                    \\\
                    \\downarrow
                    \\\
                    b^{2p+2} \mathbb{R}/b^{p}\mathbb{R}
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    b^{p+1}\mathbb{R}
                    }
            %p
              where on
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
              in terms of our defining generating elements the horizontal map is given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi p
                        %mo +
                        %mn 4
                    %mo ↦
                    %msub
                      %mi g
                      %mrow
                        %mi p
                        %mo +
                        %mn 4
                  %annotation{:encoding => "application/x-tex"} g_{p+4}\mapsto g_{p+4}
              and the vertical map by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
