                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f([e]) \in X
              of the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi e
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} [e] \in G/H
