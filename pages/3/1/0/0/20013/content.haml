            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi G
                    %msup
                      %mi Set
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} X \in G Set^{fin}
              any
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [H]
              the
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+class"} conjugacy class
              of a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [H]
                \-mark on
