                    %mo #
                    %mi a
                  %annotation{:encoding => "application/x-tex"} b \# a
            %li
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} a \in S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} b \in S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} c \in S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo #
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \# c
              implies that either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo #
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \# b
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo #
                    %mi c
                  %annotation{:encoding => "application/x-tex"} b \# c
            %li
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} a \in S
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} b \in S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(a \# b)
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %strong tight apartness relation
            on a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            consists of
          %ul
            %li
              a type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ,
                    %mi b
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi a
                    %mo #
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} a:T, b:T \vdash a \# b \; \mathrm{type}
            %li
              a family of terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ,
                    %mi b
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi{:mathvariant => "normal"} proptrunc
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T, b:T \vdash \mathrm{proptrunc}(a, b):\mathrm{isProp}(a \# b)
            %li
              a family of terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi{:mathvariant => "normal"} irr
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝟘
                  %annotation{:encoding => "application/x-tex"} a:T \vdash \mathrm{irr}(a):(a \# a) \to \mathbb{0}
            %li
              a family of terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ,
                    %mi b
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi{:mathvariant => "normal"} sym
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo #
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T, b:T \vdash \mathrm{sym}(a, b):(a \# b) \to (b \# a)
            %li
              a family of terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ,
                    %mi b
                    %mo :
                    %mi T
                    %mo ,
                    %mi c
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi{:mathvariant => "normal"} com
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo #
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mrow
                      %mo [
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo #
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo #
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ]
                  %annotation{:encoding => "application/x-tex"} a:T, b:T, c:T \vdash \mathrm{com}(a, b, c):(a \# c) \to \left[(a \# b) + (b \# c)\right]
            %li
              a family of terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo ,
                    %mi b
                    %mo :
                    %mi T
                    %mo ⊢
                    %mi{:mathvariant => "normal"} tight
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi{:mathvariant => "normal"} isEquiv
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} idtonotapart
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T, b:T \vdash \mathrm{tight}(a, b):\mathrm{isEquiv}(\mathrm{idtonotapart}(a, b))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi T
                  %mo ,
                  %mi b
                  %mo :
                  %mi T
                  %mo ⊢
                  %mi{:mathvariant => "normal"} idtonotapart
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo =
                    %mi T
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo #
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝟘
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a:T, b:T \vdash \mathrm{idtonotapart}(a, b):(a =_T b) \to ((a \# b) \to \mathbb{0})
            is inductively defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi T
                  %mo ⊢
                  %msubsup
                    %mi β
                    %mi{:mathvariant => "normal"} idtonotapart
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi T
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} idtonotapart
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo #
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝟘
                  %mi{:mathvariant => "normal"} irr
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a:T \vdash \beta_{\mathrm{idtonotapart}}^{\mathrm{refl}_T}(a):\mathrm{idtonotapart}(a, a)(\mathrm{refl}_T(a)) =_{(a \# a) \to \mathbb{0}} \mathrm{irr}(a)
          %p
            The last condition ensures that the type is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
          %h2#properties Properties
          %h3#strongly_extensional_functions Strongly extensional functions
          %p
            Given two sets with tight apartness relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo #
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S, \#)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo #
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T, \#)
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f\colon S \to T
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/strongly+extensional+function"} strongly extensional
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo #
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \# f(y)
            implies
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \# y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            reflects apartness.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %a.existingWikiWord{:href => "/nlab/show/strongly+injective+function"} strongly injective
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo #
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \# f(y)
            is logically equivalent to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \# y
            %a.existingWikiWord{:href => "/nlab/show/contrapositive"} contrapositive
            of the both conditions imply that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            preserves equality and is an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            respectively.
          %h3#stable_and_decidable_inequality Stable and decidable inequality
          %p
            A tight apartness relation is stable if it is logically equivalent to
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} a \in S
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} b \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≠
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \neq b
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo #
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \# b
            %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
            in this case.
          %p
            A tight apartness relation is decidable if for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} a \in S
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} b \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo #
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \# b
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
          %h2#the_category_of_sets_with_tight_apartness The category of sets with tight apartness
          %p
            In the category of sets with tight apartness,
            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            between sets with tight apartness are strongly extensional functions that preserve strict inequality, or strong
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/injections"} injections
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/created+limit"} created
            by the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo #
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b) \# (x,y)
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo #
                  %mi x
                %annotation{:encoding => "application/x-tex"} a \# x
            or
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} b \# y
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete category
            = succeed "," do
              %em not
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            (or even a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            at all), because it doesn't have all infinite coproducts. (To be precise, the statement that it has all small coproducts, or even that it has a subobject classifier, seems to be equivalent to excluded middle.) Nor is it
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finitely+cocomplete"} finitely cocomplete
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotients"} quotients
          %p
            We can say, however, that it has coproducts indexed by sets with tight apartness, although to make this precise is a triviality. More interestingly, it has products indexed by sets with tight apartness; that is, it is (even
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} StrExt
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \StrExt(X,Y)
            of strongly extensional functions from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            becomes a set with tight apartness under the rule that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo #
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \# g
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo #
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \# g(x)
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
