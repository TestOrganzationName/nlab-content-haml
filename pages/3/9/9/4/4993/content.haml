                    %annotation{:encoding => "application/x-tex"} (x, U) \in E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ′
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} U' \in \Sigma
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x \in U'
              (because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a cover), and then for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ″
                      %mo =
                      %mi U
                      %mo ∩
                      %mi U
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} U'' = U \cap U'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ″
                    %mo ×
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ″
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U'' \times prin(U'')
              is an open set which contains
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \times prin(U) \subseteq E
              because for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi U
                      %mo ″
                      %mo ×
                      %mi prin
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ″
                      %mo{:stretchy => "false"} )
