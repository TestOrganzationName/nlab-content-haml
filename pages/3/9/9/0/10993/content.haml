                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo ∘
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ″
                    %mo{:stretchy => "false"} )
