                  = succeed ";" do
                    %strong underlying functor
              %li
                %p
                  for each object
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %mo{:stretchy => "false"} |
                          %mi A
                          %mo{:stretchy => "false"} |
                        %annotation{:encoding => "application/x-tex"} X \in |A|
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
