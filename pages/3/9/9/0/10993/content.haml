                    k \,\colon\, J(X) \to T \circ J(X')
                    ,\;\;\;
                    \\ell \,\colon\, J(X') \to T \circ J(X'')
            %p we have
            %p left unitality:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
