                        \\Big)
            %p
              This specific example may be understood as a special case of the general situation of relative monads induced from an actual monad (Exmp.
              = succeed "):" do
                %a.maruku-ref{:href => "#RelativeMonadsInducedByPrecomposition"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
