                  %mrow
                    %mi 𝕍
                  %annotation{:encoding => "application/x-tex"} \mathbb{V}
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %a.existingWikiWord{:href => "/nlab/show/Freyd+category"} Freyd category
              is to give a strong relative monad on the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕍
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝕍
                        %mi{:mathvariant => "normal"} op
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{V}\to [\mathbb{V}^{\mathrm{op}},\mathbf{Set}]
          %p
          .num_remark
            %h6 Example
            %p
              The
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℂ
                      %mi{:mathvariant => "normal"} op
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{C}\mapsto [{\mathbb{C}}^{\mathrm{op}},\mathbf{Set}])
              may be regarded as a
              %a.existingWikiWord{:href => "/nlab/show/relative+pseudomonad"} relative pseudomonad
              on the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi CAT
                    %annotation{:encoding => "application/x-tex"} \mathbf{Cat}\to \mathbf{CAT}
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+structures"} Yoneda structures
          %p
          .num_remark
            %h6 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/monad+with+arities"}
                monad on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf C
                with arities in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} A\subseteq \mathbf C
              is the same thing as a relative monad for the embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} A\to \mathbf C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A\subseteq E
              is required to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A\subseteq E
              is to give a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} toE
                  %annotation{:encoding => "application/x-tex"} E\toE
              preserving
              = succeed "-absolute" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
          %h3#specific_examples Specific examples
          %p
          #LinearSpan.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/linear+span"}> linear span
                )
              %br/
              We spell out the simple but maybe instructive example of the construction which sends a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              to the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              which it
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+span"} spans
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of some
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %p
              In detail, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ≔
                      %annotation{:encoding => "application/x-tex"} A \coloneqq
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ≔
                        %msub
                          %mo ∫
                          %mrow
                            %mi B
                            %mo{:lspace => "verythinmathspace"} :
                            %mi Set
                        %msub
                          %mi Vect
                          %mi B
                      %annotation{:encoding => "application/x-tex"} E \coloneqq \int_{B \colon Set} Vect_B
                  (or “
                  %a.existingWikiWord{:href => "/nlab/show/VectBund"}> VectBund
                  ”, for short, see there for more) the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
                  of
                  %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                  – hence of
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
                  over
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  (i.e. over
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi.mathscript ℋ
                            %mtr
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mtr
                              %mtd
                                %mi B
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathscr{H}
                        \\\
                        \\big\downarrow
                        \\\
                        B
                        }
                %p
                  with possibly base-changing vector bundle
                  %a.existingWikiWord{:href => "/nlab/show/maps"} maps
                  between them:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi.mathscript ℋ
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi.mathscript ℋ
                                %mo ′
                            %mtr
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mtd
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mtr
                              %mtd
                                %mi B
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi f
                              %mtd
                                %mi B
                                %mo ′
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathscr{H}
                        \&amp;\longrightarrow&amp;
                        \\mathscr{H}'
                        \\\
                        \\big\downarrow
                        \&amp;&amp;
                        \\big\downarrow
                        \\\
                        B
                        \&amp;\underset{f}{\longrightarrow}&amp;
                        B'
                        }
              %li
                %p
                  the relativization functor given by sending a set to the
                  %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
                  = succeed "-bundle" do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                #eq:FormingTrivialTensorUnitBundle.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi J
                              %mtd
                                %mo{:lspace => "verythinmathspace"} :
                              %mtd
                                %mi Set
                              %mtd
                                %mo ⟶
                              %mtd
                                %msub
                                  %mo ∫
                                  %mrow
                                    %mi B
                                    %mo{:lspace => "verythinmathspace"} :
                                    %mi Set
                                %msub
                                  %mi Vect
                                  %mi B
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                              %mtd
                                %mo ↦
                              %mtd
                                %mi B
                                %mo ×
                                %mi 𝕂
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        J
                        \&amp;\colon&amp;
                        Set
                        \&amp;\longrightarrow&amp;
                        \\int_{B \colon Set} Vect_B
                        \\\
                        \&amp;&amp;
                        B
                        \&amp;\mapsto&amp;
                        B \times \mathbb{K}
                        }
            %p
              Notice that for each
              %a.existingWikiWord{:href => "/nlab/show/map"} map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; B \to B'
              of base sets, there is a
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of functors
            #eq:BaseChangeForIndexedSetsOfVectorBundles.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi B
                    %mo ↔
                    %msub
                      %mi Vect
                      %mrow
                        %mi B
                        %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_! \dashv f^\ast \dashv f_\ast
                    \\;\;\colon\;\;
                    Vect_{B}
                    \\leftrightarrow
                    Vect_{B'}
                    \\,.
            %p
              In particular, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ′
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} S' = \ast
              the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} p_X \colon S \to \ast
              is the operation which forms the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the (
              %a.existingWikiWord{:href => "/nlab/show/fiber"}> fiber
              \-)vector spaces in the bundle, and regards the resulting
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              as a bundle over the point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi B
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi B
                    %mo ⟶
                    %msub
                      %mi Vect
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi Vect
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (p_B)_!
                    \\;\colon\;
                    Vect_B
                    \\longrightarrow
                    Vect_\ast \,=\, Vect
                    \\,.
            %p In view of this, we claim that the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mi Set
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mo ∫
                              %mrow
                                %mi B
                                %mo{:lspace => "verythinmathspace"} :
                                %mi Set
                            %msub
                              %mi Vect
                              %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi S
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi p
                              %mi B
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo !
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi B
                            %mo ×
                            %mi 𝕂
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo ≃
                                %mspace{:width => "thickmathspace"}
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                                  %mrow
                                    %mi b
                                    %mo{:lspace => "verythinmathspace"} :
                                    %mi B
                                %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q
                    \&amp;\colon&amp;
                    Set
                    \&amp;\longrightarrow&amp;
                    \\int_{B \colon Set} Vect_{B}
                    \\\
                    \&amp;&amp;
                    S
                    \&amp;\mapsto&amp;
                    (p_B)_!\big( B \times \mathbb{K} \big)
                    \\mathrlap{
                    \\;\simeq\;
                    \\underset{b \colon B}{\bigoplus} \mathbb{K}
                    }
                    }
            %p
              which may be understood as sending a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              to its
              = succeed "-" do
