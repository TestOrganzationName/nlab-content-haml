            %p
              such that, for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo ∈
                      %mo{:stretchy => "false"} |
