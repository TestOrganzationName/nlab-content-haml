            %p right unitality:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi bind
                            %mrow
                              %mi T
                              %mi J
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi η
