                    \\big)
                    \\\
                    \\;=\;
                    id_{T \circ J(X)}
                    \\end{array}
            %p associativity:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi bind
                            %mrow
                              %mi T
                              %mi J
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi bind
                            %mrow
                              %mi T
                              %mi J
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi k
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi bind
                            %mi T
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi bind
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi k
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi bind
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %msup
                            %mi bind
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi bind
                            %mrow
                              %mi T
                              %mi J
                          %mo{:stretchy => "false"} (
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %msup
                            %mi bind
                            %mrow
                              %mi T
                              %mi J
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    bind^{T J}\big(
                    bind^{T J}(\ell)
                    \\circ
                    k
                    \\big)
                    \\\
                    \\;\equiv\;
                    bind^{T}\big(
                    bind^{T}(\ell)
                    \\circ
                    k
                    \\big)
                    \\\
                    \\;=\;
                    bind^T(\ell) \circ bind^T(k)
                    \\\
                    \\;\equiv\;
                    bind^{T J}(\ell) \circ bind^{T J}(k)
                    \\end{array}
            %p
          %p
            A concrete instance of Exp.
            %a.maruku-ref{:href => "#RelativeMonadsFromActualMonads"}
            is spelled out in Exp.
            %a.maruku-ref{:href => "#LinearSpan"}
            below.
          %p
          .num_remark
            %h6 Example
            %p
              A relative monad on the embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} J \colon \mathbf{FinSet} \to \mathbf {Set}
              is equivalent to an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abstract+clone"} abstract clone
              %a.existingWikiWord{:href => "/nlab/show/finitary+monads"} finitary monads
              and single-sorted
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+theories"} algebraic theories
          %p
          .num_remark
            %h6 Example
            %p
              For a small category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℂ
                      %mi{:mathvariant => "normal"} op
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}\to [\mathbb{C}^{\mathrm{op}},\mathbf{Set}]
              is the same thing as a
              %a.existingWikiWord{:href => "/nlab/show/promonad"} promonad
              structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
          .num_remark
            %h6 Example
            %p
              Fixing a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
