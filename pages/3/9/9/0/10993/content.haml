          %p
          .num_theorem
            %h6 Theorem
            %p
              %strong
                (
                %a{:href => "#AM24"}> AM, Thm. 4.16
                )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J \colon A \to E
              be a functor. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
