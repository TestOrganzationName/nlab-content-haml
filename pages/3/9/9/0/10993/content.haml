            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %msup
                          %mi f
                          %mo †
                        %mo ∘
                        %msub
                          %mi η
                          %mi X
                      %annotation{:encoding => "application/x-tex"} f = f^\dagger \circ \eta_X
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi J
                        %mi X
                        %mo →
                        %mi T
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon J X \to T Y
                  (
                  %strong> left unitality
                  );
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi η
                          %mi X
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo †
                        %mo =
                        %msub
                          %mn 1
                          %mrow
                            %mi T
                            %mi X
                      %annotation{:encoding => "application/x-tex"} (\eta_X)^\dagger = 1_{T X}
                  (
                  %strong> right unitality
                  );
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi g
                          %mo †
                        %mo ∘
                        %mi f
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo †
                        %mo =
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} g
                          %mo †
                        %mo ∘
                        %msup
                          %mi f
                          %mo †
                      %annotation{:encoding => "application/x-tex"} (g^\dagger \circ f)^\dagger = \g^\dagger \circ f^\dagger
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi J
                        %mi X
                        %mo →
                        %mi T
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon J X \to T Y
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo{:lspace => "verythinmathspace"} :
                          %mi J
                          %mi Y
                          %mo →
                          %mi T
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} g \colon J Y \to T Z
            %p
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is canonically equipped with the structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
