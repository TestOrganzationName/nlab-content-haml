              %a{:href => "https://richardblute.ca/octoberfest-2022/"} 2022
              \&amp;lbrack;slides:
              %a{:href => "https://richardblute.files.wordpress.com/2022/10/arkor-ofest.pdf"}> pdf
              , video:
              %a{:href => "https://richardblute.files.wordpress.com/2022/10/arkor-ofest-1.mp4"}> mp4
              \&amp;rbrack;
          %p
