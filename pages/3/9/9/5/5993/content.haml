            %p
          %p
          .num_remark
            %h6 Remark
            %p
              The Pfaffian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
