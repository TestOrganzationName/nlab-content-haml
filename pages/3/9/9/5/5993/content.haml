          %h2#idea Idea
          %p
            The
            %em Pfaffian
            of a
            %a.existingWikiWord{:href => "/nlab/show/skew-symmetric+matrix"} skew-symmetric matrix
            is a
            %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = (A_{i,j})
            be a skew-symmetric
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ×
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2n \times 2n)
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            with entries in some
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %em Pfaffian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} pf(A) \in k
              is the element
            #eq:PfaffianViaSignatureOfPermutations.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mn 2
                          %mi n
                        %mspace{:width => "thinmathspace"}
                        %mi n
                        %mo !
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi σ
                            %mo ∈
                            %msub
                              %mi Sym
                              %mrow
                                %mn 2
                                %mi n
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mstyle{:displaystyle => "false"}
                        %mrow
                          %msubsup
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo =
                              %mn 1
                            %mi n
                        %msub
                          %mi A
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi i
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi i
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    pf(A)
                    \\;\coloneqq\;
                    \\frac{1}{2^n \, n!}
                    \\textstyle{\sum_{\sigma \in Sym_{2n}}}
                    sgn(\sigma)
                    \\textstyle{\prod_{i = 1}^n}
                    A_{\sigma(2i -1), \sigma(2i)}
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  runs over all
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 2n
                  elements;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sgn
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} sgn(\sigma)
                  is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of a permutation
            %p
              Expressed equivalently in terms of the
              %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              and using the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            #eq:PfaffianInTermsOfLCTensor.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mn 2
                          %mi n
                        %mi n
                        %mo !
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %msub
                          %mi j
                          %mn 1
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                        %msub
                          %mi j
                          %mn 2
                    %mi ⋯
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi i
                          %mi n
                        %msub
                          %mi j
                          %mi n
                    %msup
                      %mi ϵ
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %msub
                          %mi j
                          %mn 1
                        %msub
                          %mi i
                          %mn 2
                        %msub
                          %mi j
                          %mn 2
                        %mi ⋯
                        %msub
                          %mi i
                          %mi n
                        %msub
                          %mi j
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    pf(A)
                    \\;\coloneqq\;
                    \\frac{1}{2^n n!}
                    A_{i_1 j_1}
                    A_{i_2 j_2}
                    \\cdots
                    A_{i_n j_n}
                    \\epsilon^{ i_1 j_1 i_2 j_2 \cdots  i_n j_n }
                    \\,.
          %h2#properties Properties
          %h3#relation_to_the_determinant Relation to the determinant
          #PfaffianIsSquareRootOfDeterminant.num_prop
            %h6#proposition Proposition
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
              is
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = (A_{i,j})
              be a skew-symmetric
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo ×
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n \times 2n)
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              with entries in some
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              (or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Then the Pfaffian of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              %a.maruku-eqref{:href => "#eq:PfaffianViaSignatureOfPermutations"} (1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              of the
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            #eq:DeterminantIsPfaffianSquared.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    pf(A)
                    \\big)^2
                    \\;=\;
                    det(A)
                    \\,.
          %p
            Proofs are spelled out for instance by
            = succeed "." do
              %a{:href => "#Haber15"} Haber 2015, Sections 2 and 3
          %h3#InTermOfBerezinianIntegrals In terms of Berezinian integrals
          %p
          #PfaffianAsBerezinianIntegral.num_prop
            %h6 Proposition
            %p
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \Lambda_{2n}
              be the
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2n
              generators
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi θ
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\theta_i\}
              %a.existingWikiWord{:href => "/nlab/show/vector"} vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi θ
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec \theta
            %p
              Then the Pfaffian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} pf(A)
              is the
              %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mo ∫
                      %mspace{:width => "thinmathspace"}
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mrow
                            %msubsup
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mrow
                                %mn 2
                                %mi n
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi θ
                            %mi i
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mi exp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} ⟨
                      %mover
                        %mi θ
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mi A
                      %mo ⋅
                      %mover
                        %mi θ
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} ⟩
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                  %annotation{:encoding => "application/x-tex"}
                    pf(A)
                    \\;=\;
                    \\textstyle{\int}
                    \\,
                    \\left(
                    \\textstyle{\prod_{i=1}^{2n}}
                    \\mathrm{d}\theta_i
                    \\right)
                    \\,
                    \\exp\big(
                    \\tfrac{1}{2}
                    \\langle \vec \theta, A \cdot \vec \theta \rangle
                    \\big)
                    \\,.
            %p
          %p
          .num_remark
            %h6 Remark
            %p
            %p
              Compare this to the
              = succeed "-representation" do
                %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
