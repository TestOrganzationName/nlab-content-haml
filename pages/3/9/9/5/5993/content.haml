                          %msub
                            %mi θ
                            %mi i
                        %mo )
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %msubsup
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo =
                              %mn 1
                            %mrow
                              %mn 2
                              %mi n
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi ψ
                            %mi i
                        %mo )
                      %mspace{:width => "thinmathspace"}
