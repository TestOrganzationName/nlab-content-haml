                          %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"} pf\Big( (z_{\bullet_1} - z_{\bullet_2})^{-1} \Big)
              changes sign when swapping any pair of
              %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi r
                    %mo ↔
                    %msub
                      %mi z
                      %mi s
                  %annotation{:encoding => "application/x-tex"} z_r \leftrightarrow z_s
              (which is manifest in the Berezinian presentation, where it corresponds equivalently to instead swapping
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi θ
                        %mi r
                      %mo ↔
                      %msub
                        %mi θ
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \theta_r \leftrightarrow \theta_s
            %p
              But also the Vandermonde determinant changes sign when swapping pairs of variables (see
              = succeed ")." do
                %a{:href => "Vandermonde+determinant#SkewSymemtryUnderSwappingVariables"} there
            %ol
              %li
                %p
                  for odd filling fraction
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi q
                        %annotation{:encoding => "application/x-tex"} q
                %ol
                  %li
                    %p
                      the ordinary
                      %a.existingWikiWord{:href => "/nlab/show/Laughlin+state"} Laughlin state
                      is
                      %em skew-symmetric
                      in its arguments — as befits the
                      %a.existingWikiWord{:href => "/nlab/show/wavefunction"} wavefunction
                      of
                      %a.existingWikiWord{:href => "/nlab/show/quantum+many-body+physics"} multiple
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
                  %li
                    %p
                      the Pfaffian Moore-Read state is
                      %em symmetric
                      in its arguments — as befits the
                      %a.existingWikiWord{:href => "/nlab/show/wavefunction"} wavefunction
                      of
                      %a.existingWikiWord{:href => "/nlab/show/quantum+many-body+physics"} multiple
                      = succeed "." do
                        %a.existingWikiWord{:href => "/nlab/show/bosons"} bosons
              %li
                %p
                  for even filling fraction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                      %annotation{:encoding => "application/x-tex"} q
                  it is the other way around.
            %p
