                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} ⟩
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                  %annotation{:encoding => "application/x-tex"}
                    det(A)
                    \\;=\;
                    \\textstyle{\int}
                    \\left(
                    \\textstyle{\prod}_{i = 1}^{2n}
                    \\mathrm{d}\theta_i
                    \\right)
                    \\left(
                    \\textstyle{\prod}_{i = 1}^{2n}
                    \\mathrm{d}\psi_i
                    \\right)
                    \\,
                    \\exp\big(
                    \\langle \vec \theta, A \cdot \vec \psi \rangle
                    \\big)
                    \\,.
            %p
              The relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
