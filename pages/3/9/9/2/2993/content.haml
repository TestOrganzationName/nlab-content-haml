                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              The polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[z]
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} algebra
              on one generator (the variable
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
          .proof
            %h6#proof Proof
            %p
              By the definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+objects"} free objects
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"}
                    f : R[z] \to K
            %p
              to another algebra K are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mo *
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"}
                    \\bar f : * \to K
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              to the set underlying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar f
              to be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(z)
              = succeed "-linearity," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          .num_remark
            %h6#remark_4 Remark
            %p
              Similarly, the set of polynomials in any given
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of variables with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/symmetric+power"} symmetric power
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
          #substitution.num_remark
            %h6#remark_5 Remark
            %p
              As usual in the study of universal algebra via
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theories"} Lawvere theories
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
              whose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
              is the free algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[x_1, \ldots, x_n]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi k
                    %mo ×
                    %msub
                      %mi C
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %mi …
                    %mo ×
                    %msub
                      %mi C
                      %mrow
                        %msub
                          %mi n
                          %mi k
                    %mo →
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_k \times C_{n_1} \times \ldots \times C_{n_k} \to C_n
            %p
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %msub
                      %mi n
                      %mn 1
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi n
                      %mi k
                  %annotation{:encoding => "application/x-tex"} n = n_1 + \ldots + n_k
              ) that take a tuple of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ;
                    %msub
                      %mi q
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi q
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p; q_1, \ldots, q_k)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi q
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi q
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p(q_1(x), \ldots, q_k(x))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              under the unique algebra map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[x_1, \ldots, x_k] \to R[x_1, \ldots, x_n]
              that extends the mapping
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi j
                      %mo ↦
                      %msub
                        %mi i
                        %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi q
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x_j \mapsto i_j(q_j)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi j
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mi j
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} i_j: R[x_1, \ldots, x_{n_j}] \to R[x_1, \ldots, x_n]
              are appropriate coproduct inclusions (in the category of commutative rings), where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi l
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi x
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %mi …
                          %mo +
                          %msub
                            %mi n
                            %mrow
                              %mi j
                              %mo −
                              %mn 1
                          %mo +
                          %mi l
                    %annotation{:encoding => "application/x-tex"} i_j(x_l) = x_{n_1 + \ldots + n_{j-1} + l}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k=1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n_1 = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[x] \times R[x] \to R[x]
              is ordinary substitution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p, q) \mapsto p(q(x))
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Tall-Wraith+monoid"} Tall-Wraith monoid
          .num_remark
            %h6#remark_6 Remark
            %p
              In case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
              %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[z]
              is the
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(z)
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+fractions"} rational fractions
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The underlying
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              of the polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[z]
              on one generator is the
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
              in the category
              %a.existingWikiWord{:href => "/nlab/show/RMod"} RMod
              of
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %h3#as_differential_algebras As differential algebras
          %p
            Polynomial rings on one generator also have the structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
          .num_defn
            %h6#definition_2 Definition
            %p
              For every univariate polynomial ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[z]
              %a.existingWikiWord{:href => "/nlab/show/inductive+definition"} inductively define
              a function called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              or
              %strong
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi z
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}: R[z] \to R[z]
            %p such that
            %ul
              %li
                for all polynomials
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in R[z]
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} q \in R[z]
                and constant polynomials
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} a \in R[z]
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi z
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} b \in R[z]
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ⋅
                        %mi p
                        %mo +
                        %mi b
                        %mo ⋅
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi a
                        %mo ⋅
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi b
                        %mo ⋅
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi t
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}(a \cdot p + b \cdot q) = a \cdot \frac{\partial}{\partial z}(p) + b \cdot \frac{\partial}{\partial t}(q)
              %li
                for all polynomials
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in R[z]
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo ∈
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi z
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} q \in R[z]
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ⋅
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi p
                        %mo ⋅
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi q
                      %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}(p \cdot q) = p \cdot \frac{\partial}{\partial z}(q) + \frac{\partial}{\partial z}(p) \cdot q
              %li
                and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}(z) = 1
                %p
                  Thus the univariate polynomial ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi z
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} R[z]
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
          .num_prop
            %h6#proposition_3 Proposition
            %p
              In the multivariate polynomial ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi z
                        %mn 1
                      %mo ,
                      %msub
                        %mi z
                        %mn 2
                      %mi …
                      %msub
                        %mi z
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[z_1, z_2 \ldots z_n]
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi z
                          %mi i
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %msub
                      %mi z
                      %mn 2
                    %mi …
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %msub
                      %mi z
                      %mn 2
                    %mi …
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z_i}: R[z_1, z_2 \ldots z_n] \to R[z_1, z_2 \ldots z_n]
            %p
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
              called a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is power-associative, for every positive integer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %msub
                        %mi ℤ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}_+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi z
                    %msup
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}z^{n+1} = j(n) \circ z^{n}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %msub
                      %mi ℤ
                      %mo +
                    %mo →
                    %mi ℤ
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} j:\mathbb{Z}_+ \to \mathbb{Z} \to R[z]
              is the canonical function from the positive
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[z]
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} a \in R[z]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi z
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}a = 0
          .num_defn
            %h6#definition_3 Definition
            %p
              Given a polynomial
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in R[z]
              %strong set of antiderivatives
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              to be the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of the derivative at
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} antiderivatives
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mi q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo{:maxsize => "2.4em", :minsize => "2.4em"} |
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi z
                      %mrow
                        %mo (
                        %mi q
                        %mo )
                      %msub
                        %mo =
                        %mrow
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mi z
                          %mo{:stretchy => "false"} ]
                      %mi p
                      %mo }
                  %annotation{:encoding => "application/x-tex"} \mathrm{antiderivatives}(p) \coloneqq \left\{q \in R[z] \bigg| \frac{\partial}{\partial z}\left(q\right) =_{R[z]} p\right\}
          %h3#as_domains As domains
          %p
            In the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi k
                %annotation{:encoding => "application/x-tex"} R = k
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[x]
            has a number of useful properties. One is that it is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring. Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f, g \in R[x]
              where the leading coefficient of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a unit (e.g., if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/monic+polynomial"} monic polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ,
                    %mi r
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} q, r \in k[x]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi q
                    %mo ⋅
                    %mi g
                    %mo +
                    %mi r
                  %annotation{:encoding => "application/x-tex"} f = q \cdot g + r
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \deg(r) \lt \deg(g)
          .proof
            %h6#proof_2 Proof
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \deg(f) \lt \deg(g)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} r = f
              will suffice. Otherwise, we may argue by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \deg(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi m
                    %msup
                      %mi x
                      %mi m
                  %annotation{:encoding => "application/x-tex"} a_m x^m
              is the leading term of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi n
                    %msup
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} b_n x^n
              the leading term of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi a
                      %mi m
                    %msubsup
                      %mi b
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi x
                      %mrow
                        %mi m
                        %mo −
                        %mi n
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(x) = f(x) - a_m b_n^{-1} x^{m-n}g(x)
              has lower degree than
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ⋅
                    %mi g
                    %mo +
                    %mi r
                    %mo =
                    %mi q
                    %mo ′
                    %mo ⋅
                    %mi g
                    %mo +
                    %mi r
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} q \cdot g + r = q' \cdot g + r'
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ≠
                      %mi q
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} q \neq q'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi q
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \deg((q - q')g) = \deg(r' - r) \lt \deg(g)
              which is impossible; then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mi r
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} r = r'
              quickly follows from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mi q
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} q = q'
          .num_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is field, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unique+factorization+domain"} unique factorization domain
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
            for a proof.
          .num_cor
            %h6#corollary_2 Corollary
            %p
              For any commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
              is a
              %a.existingWikiWord{:href => "/nlab/show/root"} root
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p(x) \in R[x]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(a)
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(x)
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x - a)q(x)
              for some polynomial
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
          .proof
            %h6#proof_3 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x - a
              is monic, we may write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi r
                  %annotation{:encoding => "application/x-tex"} p(x) = (x - a)q(x) + r
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \deg(r) \lt 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is a constant. By evaluating the polynomial function at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} x = a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
          %p
            This observation may be exploited in various neat ways. One is that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x)
            is a polynomial, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
