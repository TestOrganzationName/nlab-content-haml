                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msubsup
                                  %mi Ψ
                                  %mrow
                                    %mi c
                                    %mo ,
                                    %mi d
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %msub
                              %mi hom
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hom_C(R(d), R(d))
                    \&amp;
                    \\stackrel{\Psi^{-1}_{R(d), d}}{\to}
                    \&amp; \hom_D(L(R(d)), d)
                    \\\
                    \\hom_C(f, R(d))
                    \\big\downarrow
                    \&amp; &amp;
                    \\big\downarrow \hom_D(L(f), d)
                    \\\
                    \\hom_C(c, R(d))
                    \&amp;
                    \\underset{\Psi^{-1}_{c, d}}{\to}
                    \&amp;
                    \\hom_D(L(c), d)
                    }
            %p
              Chasing the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 1_{R(d)}
              down and then across, we get
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f: c \to R(d)
              and then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ψ
                        %mrow
                          %mi c
                          %mo ,
                          %mi d
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Psi^{-1}_{c, d}(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \varepsilon_d
              and then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ε
                        %mi d
                      %mo ∘
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \varepsilon_d \circ L(f)
          %p
          .num_cor
            %h6 Corollary
            %p
              An adjunction in its
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core(Cat)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
          %h3#enriched_adjoint_functors Enriched adjoint functors
          %p
            Similarly one sees:
          #EnrichedAdjointFunctors.num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosmos+for+enrichment"} cosmos for enrichment
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/VCat"} VCat
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              is equivalently a pair
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
          %p
          .num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \,\colon\, Grp \to Set
              from
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              to
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              denote the usual
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
              generated by a set
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_X \,\colon\, X \to U(F(X))
              which is universal among functions from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the underlying set of a group, which means in turn that given a function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f: X \to U(G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \colon F(X) \to G
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi η
                          %mi X
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f = (X \stackrel{\eta_X}{\to} U(F(X)) \stackrel{U(g)}{\to} U(G))
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \eta_X
              is a component of what we call the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of the adjunction
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊣
                      %mi U
                    %annotation{:encoding => "application/x-tex"} F \dashv U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g: F(X) \to G
              and the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f: X \to U(G)
              in terms of the unit.
          %h3#AdjointInfinityOneFunctors
            Adjoint
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
