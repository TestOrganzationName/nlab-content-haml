                %a{:href => "#key_ingredients"} Key Ingredients
              %ul
                %li
                  %a{:href => "#divisible_groups"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                    \-divisible Groups
                %li
                  %a{:href => "#serretate_theory"} Serre-Tate Theory
                %li
