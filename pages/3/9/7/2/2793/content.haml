          %p Recall the main theorem.
          .un_theorem
            %h6#theorem Theorem
            %p
              %strong (J. Lurie)
            %p For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  any
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %li
                %p
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E(A)
                  is the space of oriented
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  (the realization of the topological category of elliptic curves over
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
            %p
              There exists a derived Deligne-Mumford stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mi Der
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %msup
                      %mi O
                      %mi Der
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M^{Der} = (M, O^{Der})
              such that we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi A
                    %mo ,
                    %msup
                      %mi M
                      %mi Der
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(Spec A, M^{Der})
                    \\simeq
                    E(A)
            %p
              natural in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              And
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi O
                      %mi Der
                  %annotation{:encoding => "application/x-tex"} O^{Der}
              provides the lift of Goerss-Hopkins-Miller.
          %h2#preliminaries Preliminaries
          %p
            Recall that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a commutative
            %a.existingWikiWord{:href => "/nlab/show/derived+group+scheme"} derived group scheme
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 0
                %annotation{:encoding => "application/x-tex"} F_0
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_0 A
            is an elliptic curve.
          %p
            Denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E' (A)
            the space of preoriented (derived) elliptic curves (so equipped with a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Spec
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} P^\infty \to F ( \mathrm{Spec} A )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(A)
            the space of oriented elliptic curves.
          %p
            Note that a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spec
                  %mi A
                  %mo →
                  %msup
                    %mi M
                    %mi Der
                %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A \to M^{Der}
            is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spec
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{Spec} \pi_0 A \to M_{1,1}
            and a map of rings
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Spec
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} O (\mathrm{Spec} \pi_0 A) \to A
          %h2#representability Representability
          %p In his thesis, Lurie proves the following.
          %p
            %strong Proposition.
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be a functor from connective
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %ol
            %li
              %p
                The restriction of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                to discrete rings is represented by a (classical) DM-stack
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi{:mathvariant => "normal"} Nerv
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(R) \simeq \mathrm{Nerv} X(R)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a sheaf with respect to the etale topology;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                has a good deformation theory.
          %p
            Then there exists a derived DM-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mover
                    %mi O
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X , \hat O )
            representing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            s.t.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi O
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat O (U)
            is connective for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            affine.
          %p
            %strong Examples.
          %ol
            %li
              %p
                The functor
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} E'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                has a unique preorientation. Hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} E'
                is represented by DM-stack
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi O
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (M, O' )
            %li
              %p
                The functor
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
          %p
            %strong Claim.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi O
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M, O')
            represents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ′
                %annotation{:encoding => "application/x-tex"} E'
            for all
            = succeed "-rings," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            %em Proof.
            Recall the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %msub
                    %mi τ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \to \tau_{\ge 0} A
            to the connected cover.
          %ol
            %li
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              = succeed "-ring," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Spec
                  %msub
                    %mi π
                    %mn 0
                  %msub
                    %mi τ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi τ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Spec
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom} (O' (\mathrm{Spec} \pi_0 \tau_{\ge 0} A) , \tau_{\ge 0} A ) \to \mathrm{Hom} (O' (\mathrm{Spec} \pi_0 A) , A).
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mrow
                        %mo ≥
                        %mn 0
                    %mi A
                    %mo ≃
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E' ( \tau_{\ge 0} A \simeq E' (A)
              since every elliptic curve is by definition flat.
          %p We need the following to prove the claim.
          %p
            %strong Proposition.
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ↦
                  %mi M
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi τ
                        %mrow
                          %mo ≥
                          %mn 0
                      %mi A
                  %mi A
                  %mo ,
                %annotation{:encoding => "application/x-tex"} M \mapsto M \otimes_{\tau_{\ge 0} A} A,
            from flat modules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \tau_{\ge 0} A
            to flat modules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an equivalence.
          %p
            %em Proof of proposition (sketch).
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ,
                  %mi N
                %annotation{:encoding => "application/x-tex"} M,N
            be
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} Tor
                    %mi p
                    %mrow
                      %msub
                        %mi π
                        %mo *
                      %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mo *
                  %mi M
                  %mo ,
                  %msub
                    %mi π
                    %mo *
                  %mi N
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi q
                  %mo ⇒
                  %msub
                    %mi π
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{Tor}_{p}^{\pi_* A} (\pi_* M, \pi_* N )_q \Rightarrow \pi_{p+q} (M \otimes_A N ) .
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is flat, then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} Tor
                    %mi p
                    %mrow
                      %msub
                        %mi π
                        %mo *
                      %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mo *
                  %mi M
                  %mo ,
                  %msub
                    %mi π
                    %mo *
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mo *
                  %mi N
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi A
                  %msub
                    %mi π
                    %mn 0
                  %mi M
                %annotation{:encoding => "application/x-tex"} \mathrm{Tor}_{p}^{\pi_* A} (\pi_* M , \pi_* N) = \pi_* N \otimes_{\pi_0 A} \pi_0 M
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p=0
            and 0 otherwise. Thus,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msub
                    %mo ⊗
                    %mi A
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mo *
                  %mi N
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi A
                  %msub
                    %mi π
                    %mn 0
                  %mi M
                  %mo .
                %annotation{:encoding => "application/x-tex"} \pi_* (M \otimes_A N ) \simeq \pi_* N \otimes_{\pi_0 A} \pi_0 M .
          %p So we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi{:mathvariant => "normal"} Mod
                    %mi flat
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi τ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ↔
                  %msup
                    %mi{:mathvariant => "normal"} Mod
                    %mi flat
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %mo .
                %annotation{:encoding => "application/x-tex"} F: \mathrm{Mod}^{flat} (\tau_{\ge 0} A ) \leftrightarrow \mathrm{Mod}^{flat} (A) : G .
          %p
            This is an equivalence and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            respects the monoidal structure, hence the equivalence extends to the categories of algebras and the proposition (and hence claim) is proved.
          %p
            We need to know that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                  %mi O
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \pi_i O'
            are coherent sheaves over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} M_{1,1}
            %a.existingWikiWord{:href => "/nlab/show/coherent+sheaf"} coherent sheaf
            is an assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spec
                  %mi R
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{Spec} R \to M_{1,1}
            which behaves well under finite limits. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            be the line bundle of invariant differentials on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} M_{1,1}
            so that is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %msup
                    %mi e
                    %mo *
                  %msub
                    %mi Ω
                    %mrow
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mi{:mathvariant => "normal"} Spec
                          %mi R
                  %mo .
                %annotation{:encoding => "application/x-tex"} \omega = e^* \Omega_{F |_{\mathrm{Spec} R}}.
          %p
            Recall that a preorientation determines a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi ω
                    %mo →
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta : \omega \to \pi_2 (O' )
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo ′
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi β
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} O' [ \beta^{-1} ]
            which is characterized (maybe) by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mi O
                  %mo =
                  %mi lim
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                      %mi k
                  %mi O
                  %mo ′
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi O
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                  %msup
                    %mi ω
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi k
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \pi_n O = \lim ( \pi_{n+2k} O' \otimes_{O_{1,1}} \omega^{-k} ) .
          %p
            %strong Remark.
          %ul
            %li
              This formula comes from a much simpler situation…Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be (an honest to God) ring,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x \in R
              then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi lim
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mover
                    %mo →
                    %mi x
                  %mi R
                  %mover
                    %mo →
                    %mi x
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R[x^{-1}] \simeq \lim (R \stackrel{x}{\to} R  \stackrel{x}{\to} \dots )
          %ul
            %li
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %msub
                      %mi M
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} U \to M_{1,1}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              affine,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is trivialized then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} O' (U) =A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ∈
                      %msub
                        %mi π
                        %mn 2
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \beta \in \pi_2 A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ′
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} O' [\beta^{-1} ] (U) = A [ \beta^{-1} ]
              and we get the formula above
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mi i
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_i (A [ \beta^{-1} ]) = (\pi_i A) [\beta^{-1} ]
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} U \to M_{1,1}
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(U)
            is weakly periodic, so
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi π
                    %mi n
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2 O (U) \otimes_{\pi_0 O(U)} \pi_n O(U) \to \pi_{n+2} O (U)
          %p is an equivalence.
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi O
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M, O)
              classifies oriented elliptic curve. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi{:mathvariant => "normal"} Spec
                    %mi B
                  %annotation{:encoding => "application/x-tex"} U = \mathrm{Spec} B
              be a preoriented elliptic curve over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi O
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: O' (U) = A \to B
              and this is an orientation iff
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mi B
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi B
                  %mi ω
                  %mo →
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mi B
                %annotation{:encoding => "application/x-tex"} \pi_n B \otimes_{\pi_0 B} \omega \to \pi_{n+2} B
          %p
            is an isomorphism. This map can be identified with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \times \beta
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} O(U) = A [ \beta^{-1} ]
          %h3#reduction Reduction
          %p
            %strong Claim.
            To prove the theorem it is enough to show
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo =
                      %msub
                        %mi π
                        %mn 0
                      %mi O
                      %mo ′
                      %mo →
                      %msub
                        %mi π
                        %mn 0
                      %mi O
                    %annotation{:encoding => "application/x-tex"} O_{1,1} = \pi_0 O' \to \pi_0 O
                is an isomorphism;
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                odd, the sheaf
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi n
                        %mi O
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \pi_n O =0
          %p
            %em Proof.
            Suppose (1) and (2) hold. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi{:mathvariant => "normal"} Spec
                  %mi R
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} f: \mathrm{Spec} R \to M_{1,1}
            be etale for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            discrete. We must show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Spec
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O (\mathrm{Spec} R)
            is an elliptic cohomology theory associated to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                    %mo ≃
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \pi_0 A \simeq R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spf
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mi f
                %annotation{:encoding => "application/x-tex"} \mathrm{Spf} A^{0} (\mathbb{C}P^\infty ) \simeq \hat E_f
            which follows from having an orientation.
          %h3#reducing_to_a_local_calculation Reducing to a Local Calculation
          %p
            We wish to show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mi O
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_n O = 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            odd. From above, it suffices to show that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi k
                  %mo :
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                      %mi k
                  %mi O
                  %mo ′
                  %mo ⊗
                  %msup
                    %mi ω
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi k
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mi O
                %annotation{:encoding => "application/x-tex"} f_k : \pi_{n+2k} O' \otimes \omega^{-k} \to \pi_n O
          %p
            is zero for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} im
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{im} (f_k )
            is a quotient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                      %mi k
                  %mi O
                  %mo ′
                  %mo →
                  %mi{:mathvariant => "normal"} im
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{n+2k} O' \to \mathrm{im} (f_k )
            which is coherent. Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is an etale cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
