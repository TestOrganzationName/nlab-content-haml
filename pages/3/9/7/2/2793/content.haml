                      %mi ℑ
                    %annotation{:encoding => "application/x-tex"} p^n : \mathfrak{I} \to \mathfrak{I}
                is surjective;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} ho
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} colim
                      %mspace{:width => "thickmathspace"}
                      %mi ℑ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi ℑ
                    %annotation{:encoding => "application/x-tex"} (\mathrm{ho})\mathrm{colim} \; \mathfrak{I} [p^n] \simeq \mathfrak{I}
                , where as above
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi p
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi{:mathvariant => "normal"} ho
                        %mo{:stretchy => "false"} )
                        %mi{:mathvariant => "normal"} ker
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi p
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathfrak{I} [p^n] := (\mathrm{ho}) \mathrm{ker} \; p^n
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℑ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathfrak{I}[p^n]
                is a derived commutative group scheme over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                which is finite and flat.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            is a
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbf{F}_q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathfrak{I} [p]
            is a finite
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbf{F}_q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            called the
            %em rank
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{I}
          %p
            %strong Proposition.
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathfrak{I} = E [p^\infty]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            an elliptic curve, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            has rank 2.
          %p
            One can verify the proposition over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            pretty easily; it is more subtle over a finite field. We have a derived version of the Serre-Tate theorem.
          %p
            %strong Theorem (Serre-Tate).
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_0 A
            is a complete, local, Noetherian ring and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_i A
            are finitely generated
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_0 A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            be a (derived) elliptic curve over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \pi_0 A / M
            = succeed "-categories:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that restrict to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            and
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that restrict to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E_0 [p^\infty]
          %h3#proof_of_the_classical_theorem Proof of the Classical Theorem
          %p We give a proof of the classical result, however the proof is quite formal and should carry over to the derived setting.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a ring as in the theorem such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ⋅
                  %mi R
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} N \cdot R =0
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊂
                  %mi R
                %annotation{:encoding => "application/x-tex"} I \subset R
            be a nilpotent ideal, so
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} I^{r+1} =0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 0
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} R_0 = R/I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi R
                  %mo −
                  %mi{:mathvariant => "normal"} alg
                  %mo →
                  %mi{:mathvariant => "normal"} Ab
                %annotation{:encoding => "application/x-tex"} \mathfrak{I} \colon R-\mathrm{alg} \to \mathrm{Ab}
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℑ
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi{:mathvariant => "normal"} ker
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi ℑ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℑ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo ⋅
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}_I (A) := \mathrm{ker} \; ( \mathfrak{I} (A) \to \mathfrak{I} (A / I \cdot A ) .
          %p Further, define
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℑ
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi{:mathvariant => "normal"} ker
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi ℑ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℑ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} /
                  %mi{:mathvariant => "normal"} nil
                  %mi R
                  %mo ⋅
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi ℑ
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \overline{\mathfrak{I}} (A) := \mathrm{ker} \; (\mathfrak{I}(A) \to \mathfrak{I} (A / \mathrm{nil}R \cdot A)) \subset \mathfrak{I}_I (A) .
          %p
            %strong Lemma.
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            is a formal group over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℑ
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}_I
            is annihilated by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mi r
                  %annotation{:encoding => "application/x-tex"} N^r
          %p
            %strong Proposition.
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℌ
                %annotation{:encoding => "application/x-tex"} \mathfrak{H}
            be elliptic curves or
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %msup
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} N=p^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℑ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℌ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathfrak{H}_0
            the restriction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℌ
                %annotation{:encoding => "application/x-tex"} \mathfrak{H}
            to
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} R_0
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mrow
                          %mi R
                          %mo −
                          %mi grp
                      %mo{:stretchy => "false"} (
                      %mi ℑ
                      %mo ,
                      %mi ℌ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_{R-grp} (\mathfrak{I}, \mathfrak{H})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mrow
                          %msub
                            %mi R
                            %mn 0
                          %mo −
                          %mi grp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℑ
                        %mn 0
                      %mo ,
                      %msub
                        %mi ℌ
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_{R_0-grp} (\mathfrak{I}_0 , \mathfrak{H}_0 )
                have no
                = succeed "-torsion;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Hom
                      %mo{:stretchy => "false"} (
                      %mi ℑ
                      %mo ,
                      %mi ℌ
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi{:mathvariant => "normal"} Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℑ
                        %mn 0
                      %mo ,
                      %msub
                        %mi ℌ
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Hom} (\mathfrak{I} , \mathfrak{H}) \to \mathrm{Hom} (\mathfrak{I}_0 , \mathfrak{H}_0 )
                is injective;
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi ℑ
                        %mn 0
                      %mo →
                      %msub
                        %mi ℌ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f_0 \colon \mathfrak{I}_0 \to \mathfrak{H}_0
                there is a unique homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi N
                        %mi r
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℑ
                      %mo →
                      %mi ℌ
                    %annotation{:encoding => "application/x-tex"} N^r f \colon \mathfrak{I} \to \mathfrak{H}
                which lifts
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi N
                          %mi r
                        %mo ⋅
                        %msub
                          %mi f
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} N^r \cdot f_0
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi ℑ
                        %mn 0
                      %mo →
                      %msub
                        %mi ℌ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f_0 \colon \mathfrak{I}_0 \to \mathfrak{H}_0
                lifts to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℑ
                      %mo →
                      %mi ℌ
                    %annotation{:encoding => "application/x-tex"} f \colon \mathfrak{I} \to \mathfrak{H}
                if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi N
                        %mi r
                      %mi f
                    %annotation{:encoding => "application/x-tex"} N^r f
                annihilates
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi N
                          %mi r
                        %mo{:stretchy => "false"} ]
                        %mo ⊂
                        %mi ℑ
                      %annotation{:encoding => "application/x-tex"} \mathfrak{I}[N^r] \subset \mathfrak{I}
          %p
            Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an elliptic curve over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            then the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            above is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                  %mo =
                  %mi E
                  %msub
                    %mo ×
                    %mrow
                      %mi{:mathvariant => "normal"} Spec
                      %mspace{:width => "thickmathspace"}
                      %mi R
                  %mi{:mathvariant => "normal"} Spec
                  %mspace{:width => "thickmathspace"}
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo .
                %annotation{:encoding => "application/x-tex"} E_0 = E \times_{\mathrm{Spec} \; R} \mathrm{Spec} \; R/I .
          %p Using the previous results one can prove the following alternate version of the Serre-Tate theorem.
          %p
            %strong Theorem (alternative Serre-Tate).
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a ring with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            nilpotent and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊂
                  %mi R
                %annotation{:encoding => "application/x-tex"} I \subset R
            a nilpotent ideal. Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 0
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} R_0 = R/I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and the category of triples
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msub
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ (E, E_0 [p^\infty] , \epsilon )\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an elliptic curve over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} R_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E_0 [p^\infty]
            is a
            = succeed "-divisble" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi E
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi E
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi p
                    %mn ∞
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \epsilon \colon E_0 [p^\infty] \to E[p^\infty]_0
            is a natural isomorphism.
          %h3#adding_in_completions Adding in Completions
          %p
            We really want to consider elliptic curves over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            completed by an ideal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ^
                    %mi m
                %annotation{:encoding => "application/x-tex"} \hat{R}_m
            from far above. We can reduce this problem to that of elliptic curves over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and a system of
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi m
                    %mi n
                %annotation{:encoding => "application/x-tex"} R/m^n
            by combining the Serre-Tate theorem and the following theorem of Grothendieck.
          %p
            %strong Theorem (Formal GAGA).
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X, Y
            be exceedingly nice schemes over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat Y
            be their formal completions, then there is a bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ↔
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_{R} (X,Y) \leftrightarrow \mathrm{Hom}_{\hat R} (\hat X, \hat Y).
          %h2#deformation_theory Deformation Theory
          %p
            Fix a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi q
                    %mo →
                    %msub
                      %mi M
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec} \; \mathbf{F}_q \to M_{1,1}
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} /
                    %mi k
                  %annotation{:encoding => "application/x-tex"} E_0 /k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi O
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbf{O}_k
            be the sheaf over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} M_{1,1}
            that classifies deformations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            to oriented elliptic curves over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_0 A
            a complete, local ring.
          %p
            Let us assume for the moment that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo =
                  %mi{:mathvariant => "normal"} Spec
                  %mspace{:width => "thickmathspace"}
                  %mi R
                %annotation{:encoding => "application/x-tex"} M_{1,1} = \mathrm{Spec} \; R
            (more generally we pass to an affine cover). One can show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi O
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbf{O}_k
            moreover classifies oriented
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E_0 [p^\infty]
          %h3#deformations_of_fgls_and_lubintate_spectra Deformations of FGLs and Lubin-Tate Spectra
          %p
            Recall that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                %annotation{:encoding => "application/x-tex"} F,G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a morphism is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f \in R [ [x] ]
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(0) =0
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo +
                      %mi F
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo +
                      %mi G
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X +_F Y) = f(X) +_G f(Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of characteristic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                %annotation{:encoding => "application/x-tex"} F,G
            formal group laws over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} f: F \to G
            be a morphism, then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %msup
                    %mi x
                    %mrow
                      %msup
                        %mi p
                        %mi n
                  %mo +
                  %mi …
                %annotation{:encoding => "application/x-tex"} f = x^{p^n} + \dots
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is the
            %span.newWikiWord
              height
              %a{:href => "/nlab/new/height"} ?
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a formal group law the height of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ht
                    %mspace{:width => "thickmathspace"}
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \mathrm{ht} \; F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mi F
                  %annotation{:encoding => "application/x-tex"} [p]F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            map.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            be a formal group law over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            consists of a complete local ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi M
                  %mo =
                  %mi k
                %annotation{:encoding => "application/x-tex"} B/M = k
            ) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a formal group law over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                    %mi F
                    %mo =
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} p_* F = \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi M
                %annotation{:encoding => "application/x-tex"} p: B \to B/M
            is the canonical surjection. To such deformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 1
                  %mo ,
                  %msub
                    %mi F
                    %mn 2
                %annotation{:encoding => "application/x-tex"} F_1 , F_2
            are isomorphic if there is an isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi F
                    %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f: F_1 \to F_2
            which induces the identity on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                    %msub
                      %mi F
                      %mn 1
                    %mo =
                    %msub
                      %mi p
                      %mo *
                    %msub
                      %mi F
                      %mn 2
                    %mo =
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} p_* F_1 = p_* F_2 = \Gamma
          %p
            %strong Theorem (Lubin-Tate).
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ,
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} k, \Gamma
            as above with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ht
                  %mspace{:width => "thickmathspace"}
                  %mi Γ
                  %mo &lt;
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathrm{ht} \; \Gamma \lt \infty
            then there exists a complete local ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(k, \Gamma )
            with residue field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and a formal group law over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(k, \Gamma)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi univ
                %annotation{:encoding => "application/x-tex"} F^{univ}
            which reduces to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            such that there is a bijection of sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} Deform
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom} (E(k, \Gamma) , R) \to \mathrm{Deform} (\Gamma, R) .
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi p
                  %annotation{:encoding => "application/x-tex"} k = \mathbf{F}_p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi ℤ
                    %mi p
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi u
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi u
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E(k, \Gamma) \simeq \mathbb{Z}_p [ [ u_1 , \ldots , u_{n-1} ] ]
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ht
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathrm{ht} \; \Gamma =n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi q
                  %annotation{:encoding => "application/x-tex"} k= \mathbf{F}_q
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi W
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi F
                      %mi q
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi u
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi u
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E(k, \Gamma) \simeq W\mathbf{F}_q [ [ u_1 , \ldots , u_{n-1} ] ]
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi F
                    %mi univ
                %annotation{:encoding => "application/x-tex"} E(k, \Gamma), F^{univ}
            as in the theorem, then we define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi F
                      %mo ¯
                    %mi univ
                %annotation{:encoding => "application/x-tex"} \overline{F}^{univ}
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi u
                      %mo ±
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E(k, \Gamma) [u^\pm]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} u=2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi F
                      %mo ¯
                    %mi univ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi u
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi F
                    %mi univ
                  %mo{:stretchy => "false"} (
                  %mi uX
                  %mo ,
                  %mi uY
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \overline{F}^{univ} (X,Y) = u^{-1} F^{univ} (uX , uY).
            We then define a homology theory as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mrow
                      %mi k
                      %mo ,
                      %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi u
                    %mo ±
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi MU
                        %mo *
                  %msub
                    %mi MU
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} ( E_{k,\Gamma})_* (X) = E(K,\Gamma)[ [u^\pm] ] \otimes_{MU_*} MU_* (X).
          %p
            Define a category (really a stack and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            vary)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi FG
                %annotation{:encoding => "application/x-tex"} \mathbf{FG}
            of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (k,\Gamma)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} char
                  %mspace{:width => "thickmathspace"}
                  %mi k
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} \mathrm{char} \; k =p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ht
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathrm{ht} \; \Gamma =n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi FG
                %annotation{:encoding => "application/x-tex"} \mathbf{FG}
            to multiplicative cohomology theories.
          %p
            %strong Theorem (Hopkins-Miller I).
            This functor lifts to
            = succeed "-rings." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            %strong
              The philosophy is that there should be a sheaf of
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi FG
                  %annotation{:encoding => "application/x-tex"} \mathbf{FG}
              with global sections the sphere spectrum. Then tmf and taf are low height approximations.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mn ∞
                    %mi LT
                %annotation{:encoding => "application/x-tex"} E_{\infty}^{LT}
            be the subcategory of
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mi Γ
                  %annotation{:encoding => "application/x-tex"} E_{k,\Gamma}
          %p
            %strong Theorem (Hopkins-Miller II).
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %msubsup
                    %mi E
                    %mn ∞
                    %mi LT
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi FG
                %annotation{:encoding => "application/x-tex"} \pi : E_{\infty}^{LT} \to \mathbf{FG}
            is a weak equivalence of topological categories. That is, the lift above is pretty unique.
          %p
            This implies Hopkins-Miller I by taking a Kan extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi FG
                  %mo →
                  %msub
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathbf{FG} \to E_\infty
            along the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mi LT
                    %mo ↪
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_{\infty}^{LT} \hookrightarrow E_\infty
          %h2#the_final_sprint The Final Sprint
          %p
            Let us sketch how to proceed…Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            be a
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_0 A
            complete and local. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \mathfrak{I}
            fits in an exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mover
                    %mi ℑ
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi ℑ
                  %mo →
                  %msub
                    %mi ℑ
                    %mi et
                  %mo →
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} 0 \to \hat \mathfrak{I} \to \mathfrak{I} \to \mathfrak{I}_{et} \to 0 .
          %p
            There are two cases: either the underlying elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            is super singular (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ht
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi E
                    %mn 0
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \mathrm{ht} \; E_0 =2
            ), else
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
            is ordinary.
          %h3#the_supersingular_case The Supersingular Case
          %p
            In this case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi E
                          %mn 0
                      %mo ^
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \widehat{E_0} [p^\infty] = E_0 [p^\infty]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℑ
                    %mo ^
                  %mo =
                  %mi ℑ
                %annotation{:encoding => "application/x-tex"} \widehat{\mathfrak{I}} = \mathfrak{I}
            for every deformation. Now an orientation means
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℑ
                    %mo ^
                  %mo ≃
                  %mi{:mathvariant => "normal"} Spf
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi A
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \widehat{\mathfrak{I}} \simeq \mathrm{Spf} \; A^{\mathbb{C}P^\infty}[p^\infty],
          %p
            so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi k
                      %mo ,
                      %mover
                        %mrow
                          %msub
                            %mi E
                            %mn 0
                        %mo ^
                %annotation{:encoding => "application/x-tex"} E_{k, \widehat{E_0}}
            classifies deformations to oriented
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi O
                      %mi k
                    %mo ≃
                    %msub
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mover
                          %mrow
                            %msub
                              %mi E
                              %mn 0
                          %mo ^
                  %annotation{:encoding => "application/x-tex"} \mathbf{O}_k \simeq E_{k, \widehat{E_0}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi k
                      %mo ,
                      %mover
                        %mrow
                          %msub
                            %mi E
                            %mn 0
                        %mo ^
                %annotation{:encoding => "application/x-tex"} E_{k,\widehat{E_0}}
            is even.
          %h3#the_ordinary_case The Ordinary Case
          %p This is more subtle (see DAG IV 3.4.1 for some hints).
          %p
            First we can analyze the formal part of the exact sequence and see that deformations to formal
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mover
