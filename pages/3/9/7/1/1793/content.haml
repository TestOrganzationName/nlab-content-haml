                              %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                          %mi V
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi.mathscript 𝒲
                            %mi s
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    [const(V),\, \mathscr{W}]
                    \\,\colon\,
                    [s] \;\mapsto\;
                    \\\
                    \\int_{s'}
                    \\big[
                    \\Delta(s',s)
                    \\cdot V
                    ,\,
                    \\mathscr{W}_{s'}
                    \\big]
                    \\\
                    \\;\simeq\;
                    \\Big[
                    V
                    ,\,
                    \\int_{s'}
                    (\mathscr{W}_{s'})^{\Delta(s',s)}
                    \\Big]
                    \\\
                    \\;\simeq\;
                    \\Big[
                    V
                    ,\,
                    \\mathscr{W}_s
                    \\Big]
                    \\,,
                    \\end{array}
            %p
              where we passed from
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S\cdot (-)
              to its
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %a.existingWikiWord{:href => "/nlab/show/powering"} powering
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi S
                    %annotation{:encoding => "application/x-tex"} (-)^S
              %a{:href => "hom-functor+preserves+limits#InternalHomFunctor"} internal hom preserves limits
              and then the
              %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
              in its
              = succeed "-form" do
                %a.existingWikiWord{:href => "/nlab/show/end"} end
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
            %p
              But since the objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi.mathscript 𝒲
                      %mrow
                        %mi k
                        %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V,\,\mathscr{W}_{k'} \,\in\,Ch(k)
              are cofibrant and fibrant (as all objects of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch(k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi V
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [V,-] \,\colon\, Ch(k) \to Ch(k)
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              and as such preserves weak equivalences between the fibrant objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒲
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathscr{W}_{\bullet}
              (by
              = succeed ")." do
                %a{:href => "Introduction+to+Homotopy}Theory#KenBrownLemma"} Ken Brown’s lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒲
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathscr{W}_\bullet
              is homotopically constant then so is the simplicial chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi const
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi.mathscript 𝒲
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi s
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ↦
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi V
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi.mathscript 𝒲
                        %mi s
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [const(V),\mathscr{W}] \,\colon\, [s] \,\mapsto\, [V,\, \mathscr{W}_s]
            %p
              It remains to observe that the Quillen equivalence to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(k)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+Quillen+adjunction"} monoidal Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                  %annotation{:encoding => "application/x-tex"} const
              is by aconstruction a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              and the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              (as all objects).
          %p
            %br/
          %h4#InjectiveModelStructureOnUnboundedChainComplexes Standard injective model structure on unbounded chain complexes
          %p
          #StandardInjectiveModelStructureOnUnboundedComplexes.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              the
              %a.existingWikiWord{:href => "/nlab/show/category+of+unbounded+chain+complexes"} category of unbounded chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(R Mod)
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              carries the structure of a
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
            %p
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              with
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  the
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  the (degreewise)
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/injections"} injections
            %p
          This is
          = succeed "." do
            %a{:href => "#Hovey99"} Hovey (1999), Thm. 2.3.13
          %h4#InUnboundedDegreeGeneralResults Christensen-Hovey model structures using projective classes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            with all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          %p
            %a{:href => "#ChristensenHovey"} Christensen-Hovey
            construct a family of model category structures on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
            parameterized by a choice of
            %em projective class
            \. The cofibrations, fibrations and weak equivalences all depend on the projective class.
          #ProjectiveClass.num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong projective class
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo ⊂
                    %mi ob
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} \subset ob \mathcal{A}
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ⊂
                    %mi mor
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \subset mor \mathcal{A}
              of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is precisely the collection of
                  = succeed "-epic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} \mathcal{P}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                      %annotation{:encoding => "application/x-tex"} \mathcal{P}
                  is precisely the collection of all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  such that each map in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is
                  = succeed "-epic;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
              %li
                %p
                  for each object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \to X
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} \mathcal{P}
          #TrivialProjectiveClass.num_example
            %h6#example_2 Example
            %p
              Taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo :
                    %mo =
                    %mi ob
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} := ob \mathcal{A}
              to be the class of
              %em all
              objects yields a projective class – called the
              %em trivial projective class
              \. The corresponding morphisms are the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              of all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          #PullbackProjectiveClass.num_example
            %h6#example_3 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} =
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              be the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
