                        %mi F
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv U) : \mathcal{A} \stackrel{\overset{F}{\leftarrow}}{\underset{U}{\to}} \mathcal{B}
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
              and given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒫
                    %mo ,
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{P}, \mathcal{E})
              a projective class in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              then its
              %strong pullback projective class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo *
                    %mi 𝒫
                    %mo ,
                    %msup
                      %mi U
                      %mo *
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U * \mathcal{P}, U^* \mathcal{E})
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is defined by
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi U
                        %mo *
                      %mi 𝒫
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi retracts
