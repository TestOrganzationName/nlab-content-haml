                  %annotation{:encoding => "application/x-tex"} g
              is a quasi-isomorphism.
          %h3#ExactFuncsAndQuillenFuncs Left/right exact functors and Quillen adjunctions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
            %a.existingWikiWord{:href => "/nlab/show/categories+of+chain+complexes"} categories of chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet^+(\mathcal{A})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet^+(\mathcal{B})
            be equipped with the model structure described
            %a{:href => "#GeneralResults"} above
            where fibrations are the degreewise
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
            %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
          .num_prop
            %h6#proposition Proposition
            %p If
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒜
                    %mover
                      %munder
                        %mo →
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R) : \mathcal{A} \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\to}} \mathcal{B}
            %p
              is a pair of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi Ch
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo ←
                        %mrow
                          %msubsup
                            %mi Ch
                            %mo •
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Ch_\bullet^+(L)
                    \\dashv
                    Ch_\bullet(R) : Ch_\bullet^+(\mathcal{A})
                    \\stackrel{\overset{Ch_\bullet^+(L)}{\leftarrow}}{\underset{Ch_\bullet(R)}{\to}}
                    Ch_\bullet^+(\mathcal{B})
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .proof
            %h6#proof_8 Proof
            %p
              Every functor preserves split epimorphism. Being a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              in particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              and hence preserves kernels. Using the characterization of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(-,I)
              sends monomorphisms to epimorphisms, we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves injectives because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves monomorphisms, by the adjunction isomorphism.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves all cofibrations and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              all fibrations.
          %h3#cofibrant_generation Cofibrant generation
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The injective model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ch
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch^{\geq 0}(R Mod)
              (from theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#InjectiveModelStructure"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
          %p
            This appears for instance as
            = succeed "," do
              %a{:href => "#Hovey"} Hovey, theorem 2.3.13
          %p
            For results on model structures on chain complexes that are provably not cofibrantly generated see section 5.4 of
            = succeed "." do
              %a{:href => "#ChristensenHovey"} Christensen, Hovey
          %h3#inclusion_into_simplicial_objects Inclusion into simplicial objects
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{A} =
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            be the category of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            provides a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo +
                  %mover
                    %munder
                      %mo →
                      %mi Γ
                    %mover
                      %mo ←
                      %mi N
                  %mi sAb
                %annotation{:encoding => "application/x-tex"}
                  (N \dashv \Gamma) : Ch_\bullet^+ \stackrel{\overset{N}{\leftarrow}}{\underset{\Gamma}{\to}}
                  sAb
          %p
            between the projective model structure on connective chain complexes and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial abelian groups
            %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
            along the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            over the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi sAb
                  %mover
                    %munder
                      %mo →
                      %mi U
                    %mover
                      %mo ←
                      %mi F
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (F \dashv U) : sAb \stackrel{\overset{F}{\leftarrow}}{\underset{U}{\to}}
                  sSet
                  \\,.
          %p The combined Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mi F
                  %mo ⊣
                  %mi U
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Ch
                    %mo •
                  %mover
                    %mo →
                    %mo ←
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  (N F  \dashv U \Gamma) : Ch_\bullet \stackrel{\leftarrow}{\to} sSet
          %p
            prolongs to a Quillen adjunction on the projective
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            on any
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            , which we denote by the same symbols
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mi F
                  %mo ⊣
                  %mi U
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %msub
                    %mi Ch
                    %mo •
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                  %mover
                    %mo →
                    %mo ←
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (N F  \dashv U \Gamma) : [C,Ch_\bullet]_{proj} \stackrel{\leftarrow}{\to} [C, sSet]_{proj}
                  \\,.
          %p
            With due care this descends to the
            %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
            which
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presents
            the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            into the larger context of
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            for more on this.
          %h3#cofibrations Cofibrations
          %p
            We discuss cofibrations in the
            = succeed "." do
              %a{:href => "#OnUnbounded"} model structures on unbounded complexes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            be a given projective class on an abelian category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %a.maruku-ref{:href => "#ProjectiveClass"}
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi 𝒫
                %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})_{\mathcal{P}}
            for the corresponding model structure on unbounded chain complexes, theorem
            = succeed "." do
              %a.maruku-ref{:href => "#ModelStructureOnUnboundedFromProjectiveClass"}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} C \in Ch(\mathcal{A})_{\mathcal{P}}
              is cofibrant precisely if
            %ol
              %li
                %p
                  in each degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
                  the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi n
                      %annotation{:encoding => "application/x-tex"} C_n
                  is relatively projective in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %li
                %p
                  every morphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  into a weakly contractible complex in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ch
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒫
                      %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})_{\mathcal{P}}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopic
                  to the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
          %p
            This appears as (
            %a{:href => "#ChristensenHovey"}> ChristensenHovey, lemma 2.4
            ).
          .num_prop
            %h6#proposition_4 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})_{\mathcal{P}}
              is a cofibration precisely if it is degreewise
            %ol
              %li
                %p
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
              %li
                %p
                  with cofibrant
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
          %p
            This appears as (
            %a{:href => "#ChristensenHovey"}> ChristensenHovey, prop. 2.5
            ).
          %h3#relation_to_module_spectra Relation to module spectra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            any ring, there is the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi R
                  %annotation{:encoding => "application/x-tex"} H R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebra+spectrum"} algebra spectrum
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi R
                  %annotation{:encoding => "application/x-tex"} H R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/module+spectra"} module spectra
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to chain complexes of
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
            for details.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+equivariant+chain+complexes"} model structure on equivariant chain complexes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes+of+super+vector+spaces"} model structure on chain complexes of super vector spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-modules"} model structure on dg-modules
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+chain+complexes"} (∞,1)-category of chain complexes
          %h2#References References
          %h3#for_bounded_chain_complexes For bounded chain complexes
          %p
            The projective model structure on connective chain complexes (Theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#ProjectiveModelStructure"}
          %ul
            %li#Quillen67
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , Section II.4 item 5 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopical+Algebra"} Homotopical Algebra
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0097438"} doi:10.1007/BFb0097438
          %p see also:
          %ul
            %li#DwyerSpalinski95
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Spalinski"} Jan Spalinski
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopy+theories+and+model+categories"} Homotopy theories and model categories
                (
                %a.existingWikiWord{:href => "/nlab/files/DwyerSpalinski_HomotopyTheories.pdf", :title => "pdf"}> pdf
                )
              %p
                in:
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"} I. M. James
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Algebraic+Topology"} Handbook of Algebraic Topology
                = succeed "," do
                  %a{:href => "https://www.elsevier.com/books/handbook-of-algebraic-topology/james/978-0-444-81779-2"} ISBN:9780080532981
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/B978-0-444-81779-2.X5000-7"} doi:10.1016/B978-0-444-81779-2.X5000-7
            %li#GoerssSchemmerhorn06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kirsten+Schemmerhorn"} Kirsten Schemmerhorn
                = succeed "," do
                  %em Model categories and simplicial methods
                = succeed "," do
                  %em Interactions between Homotopy Theory and Algebra
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math.AT/0609537"} arXiv:math.AT/0609537
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1090/conm/436"} doi:10.1090/conm/436
          %p
            The projective model structure on connective
            = succeed "chain" do
              %em co
            = succeed ")" do
              %a.maruku-ref{:href => "#ProjectiveModelStructureOnConnectiveCochainComplexes"}
          %ul
            %li#Hess06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"}> Kathryn Hess
                , p. 6 of
                = succeed "," do
                  %em Rational homotopy theory: a brief introduction
                = succeed "," do
                  %em
                    %a{:href => "https://jdc.math.uwo.ca/summerschool/"} Summer School on Interactions between Homotopy Theory and Algebra
                = succeed ")," do
                  %a{:href => "http://arxiv.org/abs/math.AT/0604626"} arXiv:math.AT/0604626
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Christensen"} Dan Christensen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"} William Dwyer
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                (eds.),
                = succeed "," do
                  %em Interactions between Homotopy Theory and Algebra
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1090/conm/436"} doi:10.1090/conm/436
            %li#CastiglioniCortinas03
              %p
                J. L. Castiglioni, G. Cortiñas, Def. 4.7 of:
                = succeed "," do
                  %em Cosimplicial versus DG-rings: a version of the Dold-Kan correspondence
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0306289"} arXiv:math.KT/0306289
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.jpaa.2003.11.009"} doi:10.1016/j.jpaa.2003.11.009
          %p
            Of course the description of model categories of chain complexes as (
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentations
            of) special cases of (stable)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            While the homotopical treatment of weak equivalences of chain complexes (
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"}> quasi-isomorphism
            s) in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            is at the beginning of all studies of higher categories and a “folk theorem” ever since
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"}> Andre Joyal
              , Letter to Alexander Grothendieck. April 11, 1984
          %p it seems that the injective model structure on chain complexes has been made fully explicit in print only in proposition 3.13 (according to remark 3.14 there) of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tibor+Beke"} Tibor Beke
              = succeed "," do
                %em Sheafifiable homotopy model categories
              %strong 129
              3 (2000) 447-475 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0102087"}> arXiv:math/0102087
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/S0305004100004722"} doi:10.1017/S0305004100004722
          %p
            The projective model structure is discussed after that (and shown to be a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
          %ul
            %li#Hovey99KTh
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                %em Model category structures on chain complexes of sheaves
                (1999) &amp;lbrack;
                %a{:href => "https://faculty.math.illinois.edu/K-theory/0366"}> K-theory:0366
                ,
                = succeed "," do
                  %a{:href => "https://faculty.math.illinois.edu/K-theory/0366/sheaves.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Hovey-SheavesOfChainComplexesPreprint.pdf", :title => "pdf"} pdf
            %li#Hovey01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %em Model category structures on chain complexes of sheaves
                %strong 353
                6 (2001) &amp;lbrack;
                %a{:href => "https://www.ams.org/journals/tran/2001-353-06/S0002-9947-01-02721-0"}> ams:S0002-9947-01-02721-0
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/221954"} jstor:221954
          %p An explicit proof of the injective model structure with monos in positive degree is spelled out in
          %ul
            %li#Dungan10
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Dungan"}> Gregory Dungan
              ,
              = succeed "," do
                %em Review of model categories
              = succeed "," do
                %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.696.123&rep=rep1&type=pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/DunganModelCategories.pdf", :title => "pdf"} pdf
          %p An explicit proof of the model structure on cochain complexes of abelian groups with fibrations the degreewise surjections is recorded in the appendix of
          %ul#Stel
            %li
              %a.existingWikiWord{:href => "/nlab/show/Herman+Stel"}> Herman Stel
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Stel"} ∞-Stacks and their Function Algebras – with Applications to ∞-Lie Theory
              (2010)
          %p The resolution model structures on cofibrant objects go back to
          %ul#DwyerKanStover
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"} Dan Kan
              = succeed "," do
                %em
                  An
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} E_2
                  model category structure for pointed simplicial spaces
          %p and are reviewed in
          %ul
            %li#Bousfield
              %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
              ,
              %em Cosimplicial resolutions and homotopy spectral sequences in model categories
              Geometry and Topology, volume 7 (2003)
          %h3#ForUnboundedChainComplexes For unbounded chain complexes
          %p Influential precusor discussion of homotopy theory of unbounded chain complexes (introducing notions like K-projective and K-injective complexes):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nicolas+Spaltenstein"}> Nicolas Spaltenstein
              ,
              = succeed "," do
                %em Resolutions of unbounded complexes
              %strong 65
              2 (1988) 121-154 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item?id=CM_1988__65_2_121_0"}> numdam:CM_1988__65_2_121_0
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://eudml.org/doc/89885"} eudml:89885
          %p The observation that from this one obtains a model category structure on unbounded chain complexes is due to:
          %ul
            %li#Hinich97
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
              ,
              = succeed "," do
                %em Homological algebra of homotopy algebras
              %strong 25
              10 (1997) 3291-3323 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/q-alg/9702015"}> arXiv:q-alg/9702015
              ,
              = succeed "," do
                %a{:href => "https://doi.org/10.1080/00927879708826055"} doi:10.1080/00927879708826055
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/math/0309453"} arXiv:math/0309453
          %p and maybe independently due to:
          %ul
            %li#HoveyPalmieriStrickland97
              %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Palmieri"} John Palmieri
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"} Neil Strickland
              = succeed "," do
                %em Axiomatic stable homotopy theory
              %strong 610
              (1997) &amp;lbrack;
              %a{:href => "https://bookstore.ams.org/memo-128-610"}> ISBN:978-1-4704-0195-5
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.math.rochester.edu/people/faculty/doug/otherpapers/axiomatic.pdf"} pdf
          %p
            (where the relevant insights are credited to
            = succeed ")" do
              %a{:href => "https://ncatlab.org/nlab/show/homological+algebra#Weibel94"} Weibel (1994)
          %p
            and shown to be
            %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
            in:
          %ul
            %li#SchwedeShipley98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                = succeed "," do
                  %em Algebras and modules in monoidal model categories
                %strong 80
                2 (2000) 491-511 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/9801082"}> arXiv:math/9801082
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1112/S002461150001220X"} doi:10.1112/S002461150001220X
            %li#Hovey99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                , Thm 2.3.1 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Model+Categories"} Model Categories
                %strong 63
                AMS (1999) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/surv-63-s"}> ISBN:978-0-8218-4361-1
                ,
                = succeed "," do
                  %a{:href => "https://doi.org/http://dx.doi.org/10.1090/surv/063"} doi:10.1090/surv/063
                = succeed "," do
                  %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/hovey-model-cats.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
          %p
            and shown to be (
            %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
            and in addition)
            %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
            and
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal
            in:
          %ul
            %li#Strickland20
              %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"}> Neil Strickland
              ,
              %em The model structure for chain complexes
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2001.08955"}> arXiv:2001.08955
              \&amp;rbrack;
          %p
            In the context of the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            with the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+abelian+groups"} model structure on simplicial abelian groups
          %ul
            %li#SchwedeShipley03
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em Equivalences of monoidal model categories
              %strong 3
              (2003) 287-334 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math.AT/0209342"}> arXiv:math.AT/0209342
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://projecteuclid.org/euclid.agt/1513882376"} euclid:euclid.agt/1513882376
          %p
            That the corresponding
            %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
            in unbounded chain complexes is thus a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            is
          %ul
            %li#RezkSchwedeShipley01
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em Simplicial structures on model categories and functors
              %strong 123
              3 (2001) 551-575 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0101162"}> arXiv:0101162
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.jstor.org/stable/25099071"} jstor:25099071
          %p
            Generalization to
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            of chain complexes:
          %ul
            %li#Fausk06
              %a.existingWikiWord{:href => "/nlab/show/Halvard+Fausk"}> Halvard Fausk
              ,
              %em T-model structures on chain complexes of presheaves
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0612414"}> arXiv:math/0612414
              \&amp;rbrack;
          %p The article
          %ul
            %li#ChristensenHovey
              %a.existingWikiWord{:href => "/nlab/show/Dan+Christensen"}> Dan Christensen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"} Mark Hovey
              = succeed "," do
                %em Quillen model structures for relative homological algebra
              %strong 133
              2 (2002) 261-293 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0011216"}> arXiv:math/0011216
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/S0305004102006126"} doi:10.1017/S0305004102006126
          %p discusses model structures on unbounded chain complexes with generalized notions of epimorphisms induced from “projective classes”. See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Christensen"}> Dan Christensen
              ,
              %em Derived categories and projective classes
              , (2005) (
              %a{:href => "http://hopf.math.purdue.edu/cgi-bin/generate?/Christensen/derived"}> hopf archive
              )
          %p
            Another approach is due to James Gillespie, using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cotorsion+pairs"} cotorsion pairs
          %ul
            %li#HoveyOverview
              %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
              ,
              = succeed "," do
                %em Cotorsion pairs and model categories
              = succeed ")" do
                %a{:href => "http://homepages.math.uic.edu/~bshipley/hovey.pdf"} pdf
          %p Some generalizations and simplifications of the original approach are discussed in
          %ul
            %li#Gillespie
              James Gillespie,
              = succeed "," do
                %em Kaplansky classes and derived categories
              %a{:href => "http://phobos.ramapo.edu/~jgillesp/updated%20qcsheaf.pdf"} pdf
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/bicomplexes"} bicomplexes
          %ul
            %li#MuroRoitzheim19
              %a.existingWikiWord{:href => "/nlab/show/Fernando+Muro"}> Fernando Muro
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constanze+Roitzheim"} Constanze Roitzheim
              = succeed "," do
                %em Homotopy Theory of Bicomplexes
              %strong 223
              5 (2019) 1913-1939 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1802.07610"}> arXiv:1802.07610
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2018.08.007"} doi:10.1016/j.jpaa.2018.08.007
          %p
            Finally a third approach to the unbounded case is discussed (in a context of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/mixed+motives"} mixed motives
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9d%C3%A9ric+D%C3%A9glise"} Frédéric Déglise
                = succeed "," do
                  %em Local and stable homological algebra in Grothendieck abelian categories
                %strong 11
                1 (2009) 219–260 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0712.3296"}> arXiv:0712.3296
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/homology-homotopy-and-applications/volume-11/issue-1/Local-and-stable-homological-algebra-in-Grothendieck-abelian-categories/hha/1251832567.full"} hha:1251832567
            %li#CisinskiDeglise09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9d%C3%A9ric+D%C3%A9glise"} Frédéric Déglise
                = succeed "," do
                  %em Triangulated categories of mixed motives
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0912.2110"} arXiv:0912.2110
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-030-33242-6"} doi:10.1007/978-3-030-33242-6
          %p
            A discussion of the homotopy theory of
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            of unbounded chain complex is in
          %ul
            %li#Jardine03
              %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
              ,
              = succeed "," do
                %em Presheaves of chain complexes
              = succeed "," do
                %a{:href => "https://pdfs.semanticscholar.org/360c/fd4eb76da956e0c8dd897377f6d6f342e44e.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/JardinePresheavesOfChainComplexes.pdf", :title => "pdf"} pdf
          %p
            A model structure on noncommutative
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/files/JardineModelDG.pdf", :title => "A Closed Model Structure for Differential Graded Algebras"} A Closed Model Structure for Differential Graded Algebras
              = succeed "," do
                %strong 17
