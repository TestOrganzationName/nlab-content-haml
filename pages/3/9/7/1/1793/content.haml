                    %annotation{:encoding => "application/x-tex"} U^* \mathcal{P} := \{retracts\;of\; F P | P \in \mathcal{P}\}
          #ModelStructureOnUnboundedFromProjectiveClass.num_theorem
            %h6#definitiontheorem Definition/Theorem
            %p
              Given a projective class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ProjectiveClass"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Ch(\mathcal{A})
            %ul
              %li
                %p
                  a fibration if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}(P,f)
                  is a surjection in
                  %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                  for all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo ∈
                          %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} P \in \mathcal{P}
              %li
                %p
                  a weak equivalence if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}(P,f)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ch
                        %mo{:stretchy => "false"} (
                        %mi Ab
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ch(Ab)
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo ∈
                          %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} P \in \mathcal{P}
            %p
              Then this constitutes a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure precisely if cofibrant
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                      %annotation{:encoding => "application/x-tex"} \mathcal{P}
                  is the pullback projective class (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#PullbackProjectiveClass"}
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TrivialProjectiveClass"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  that preserves countable
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
              %li
                %p (…)
            %p
              When the structure exists, it is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
          %p
            This is theorem 2.2 in
            = succeed "." do
              %a{:href => "#ChristensenHovey"} Christensen-Hovey
          %p
            We shall write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi 𝒫
                %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})_{\mathcal{P}}
            for this model category structure.
          %h4#ExamplesOfStructuresOnUnboundedComplexes Examples
          %p
            We list some examples for the model structures on chain complexes in unbounded degree discussed
            = succeed "." do
              %a{:href => "#InUnboundedDegreeGeneralResults"} above
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be an associative ring and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo =
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{A} = R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
          %ul
            %li
              %p
                %a{:href => "#CategoricalProjectiveClass"} Categorical projective class structure
            %li
              %p
                %a{:href => "#PureProjectiveClass"} Pure projective class structure
          %h5#CategoricalProjectiveClass Categorical projective class structure
          #CategoricalProjectiveClasses.num_example
            %h6#example_5 Example
            %p
              The
              %strong categorical projective class
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is the projective class (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ProjectiveClass"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              the class of
              = succeed "mands" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              has
            %ul
              %li as fibrations the degreewise surjections.
            %p
              So this reproduces the standard projective model structure from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ProjModelStructureOnUnbounded"}
          %h5#PureProjectiveClass Pure projective class structure
          .num_example
            %h6#example_6 Example
            %p
              The
              %strong pure projective class
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              summands of sums of finitely presented modules. Fibrations in the corresponding model structure are the maps that are degreewise those epimorphisms that appear in
              = succeed "-exact" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}
          %h4#gillespies_approach_using_cotorsion_pairs Gillespie’s approach using cotorsion pairs
          %p
            %a{:href => "#HoveyOverview"} Hovey
            has shown that, roughly speaking,
            %a.existingWikiWord{:href => "/nlab/show/model+structures"} model structures
            on
            %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
            correspond to cotorsion pairs. See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+model+structure"} abelian model structure
          %p
            %a{:href => "#HoveyOverview"} Gillespie
            shows that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+abelian+category"} Grothendieck abelian category
            %a.existingWikiWord{:href => "/nlab/show/cotorsion+pair"} cotorsion pair
            induces an
            %a.existingWikiWord{:href => "/nlab/show/abelian+model+structure"} abelian model structure
            on the category of (unbounded) complexes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+abelian+category"} Grothendieck abelian category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, \mathcal{E})
              is a hereditary
              %a.existingWikiWord{:href => "/nlab/show/cotorsion+pair"} cotorsion pair
              that is cogenerated by a set, such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              is a
              %span.newWikiWord
                Kaplansky class
                %a{:href => "/nlab/new/Kaplansky+class"} ?
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has enough
              = succeed "-objects." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/abelian+model+structure"} abelian model structure
              on the category of complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              such that the trivial objects are the acyclic complexes.
          %p
            Gillespie uses this result to get a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal
            %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi Qcoh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(Qcoh(X))
            %a.existingWikiWord{:href => "/nlab/show/quasi-coherent+sheaves"} quasi-coherent sheaves
            on a
            %a.existingWikiWord{:href => "/nlab/show/quasi-compact+scheme"} quasi-compact
            %a.existingWikiWord{:href => "/nlab/show/separated+scheme"} separated
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/derived+category+of+quasi-coherent+sheaves"} derived category of quasi-coherent sheaves
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Qcoh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(Qcoh(X))
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                  %msup
                    %mo ⊗
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot \otimes^{\mathbf{L}} \cdot
            (which is usually a problem due to sheaves not having enough projectives).
          %h4#cisinskideglise_approach_using_descent_structures Cisinski-Deglise approach using descent structures
          %p
            A third approach is due to
            = succeed "." do
              %a{:href => "#CisinskiDeglise"} Cisinski-Deglise
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+abelian+category"} Grothendieck abelian category
            %strong descent structures
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .num_defn
            %h6#definition_3 Definition
            %p
              For each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and integer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                    %annotation{:encoding => "application/x-tex"} n \in \mathbf{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mi E
                  %annotation{:encoding => "application/x-tex"} S^n E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mi E
                  %annotation{:encoding => "application/x-tex"} D^n E
              as follows: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (S^n E)^n = E
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and 0 elsewhere; and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (D^n E)^n = (D^n E)^{n+1} = E
              and 0 elsewhere. There are canonical morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi E
                      %mo ↪
                      %msup
                        %mi D
                        %mi n
                      %mi E
                    %annotation{:encoding => "application/x-tex"} S^{n+1} E \hookrightarrow D^n E
          .num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              be an essentially small set of objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              is called a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-cofibration
              if it is contained in the smallest class of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              that is closed under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              %a.existingWikiWord{:href => "/nlab/show/transfinite+compositions"} transfinite compositions
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi E
                      %mo →
                      %msup
                        %mi D
                        %mi n
                      %mi E
                    %annotation{:encoding => "application/x-tex"} S^{n+1} E \to D^n E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ∈
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} E \in \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-cofibrant
              if the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} 0 \to C
              is a
              = succeed "-cofibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
          .num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-local
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} E \in \mathcal{G}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi Z
                    %annotation{:encoding => "application/x-tex"} n \in \mathbf{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi K
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi D
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathbf{K}(\mathcal{A})}(E[n], C) \to Hom_{\mathbf{D}(\mathcal{A})}(E[n], C)
            %p
              is an isomorphism. Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{K}(\mathcal{A})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}(\mathcal{A})
              denote the
              %span.newWikiWord
                homotopy category of complexes
                %a{:href => "/nlab/new/homotopy+category+of+complexes"} ?
              and the
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .num_defn
            %h6#definition_6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              be a small family of complexes in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
                \-flasque
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} n \in \mathbf{Z}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ∈
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} H \in \mathcal{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi K
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathbf{K}(\mathcal{A})}(H, C[n]) = 0.
          %p Finally we define:
          .num_defn
            %h6#definition_7 Definition
            %p
              A
              %strong descent structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is a pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo ,
                      %mi ℋ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{G},\mathcal{H})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is an essentially small set of generators of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              is an essentially small set of
              = succeed "-cofibrant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              = succeed "-flasque" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            Now one defines a
            %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
            associated to any such descent structure.
          .num_theorem
            %h6#theorem_6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{G},\mathcal{H})
              be a descent structure on the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+abelian+category"} Grothendieck abelian category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
              %a.existingWikiWord{:href => "/nlab/show/cellular+model+category"} cellular
              %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
              on the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              are
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complexes"} complexes
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              are
              = succeed "-cofibrations." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p
              Also, a complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
              is
              %a.existingWikiWord{:href => "/nlab/show/fibrant"} fibrant
              if and only if it is
              = succeed "-flasque" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            We call this the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              \-model structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(\mathcal{A})
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+structure"} monoidal model structure
            %a{:href => "#CisinskiDeglise"} Cisinski-Deglise
            for the notion of a
            %strong weakly flat
            descent structure.
          .num_theorem
            %h6#theorem_7 Theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{G}, \mathcal{H})
              is a
              %em weakly flat
              descent structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal
          %h2#properties Properties
          %blockquote
            %p Beware that this entry has evolved in a way that deserves re-organization now: What follows are mainly properties of or arguments for the model structures on not-unbounded chain complexes.
          %h3#Properness Properness
          %p
            Model categories of chain complexes tend to be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+categories"} proper model categories
          %p
          #PushoutAlongDegreewiseInjectionsPreservesQuasiIosmorphism.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                along degreewise
                %a.existingWikiWord{:href => "/nlab/show/injections"} injections
                presrves
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %br/
              Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mi i
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mrow
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi po
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mi j
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{\; i \;}{\longrightarrow}&amp; B
                    \\\
                    {}^{\mathllap{f}}
                    \\big\downarrow
                    \&amp;{}^{{}_{(po)}}&amp;
                    \\big\downarrow {}^{\mathrlap{g}}
                    \\\
                    C &amp;\underset{\; j \;}{\longrightarrow}&amp; D
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} square
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+maps"} chain maps
              between (unbounded)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is a degreewise
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %p
              Then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %p
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
              , the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of a quasi-isomorphism along a degreewise
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              is again a quasi-isomorphism.
            %p
          (e.g.
          = succeed ")" do
            %a{:href => "#Strickland20"} Strickland 2020, Prop. 24
          .proof
            %h6 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of chain complexes is degreewise a pushout in the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              = succeed ")" do
                %a{:href => "abelian+category#PullbackPreservesEpimorphisms"} this Prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi n
                  %annotation{:encoding => "application/x-tex"} j_n
              is a monomorphism. Finally, the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              implies that the induced morphism of
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of chain complexes as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi i
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi cok
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mrow
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi po
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo ↪
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi j
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi D
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi cok
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A
                    \&amp;\overset{\;\;\; i \;\;\;}{\hookrightarrow}&amp;
                    B
                    \&amp;\longrightarrow&amp;
                    cok(i)
                    \\\
                    {}^{\mathllap{f}}
                    \\big\downarrow
                    \&amp;{}^{{}_{(po)}}&amp;
                    \\big\downarrow {}^{\mathrlap{g}}
                    \&amp;&amp;
                    \\big\downarrow {}^{\mathrlap{\simeq}}
                    \\\
                    C
                    \&amp;\underset{\;\;\; j \;\;\;}{\hookrightarrow}&amp;
                    D
                    \&amp;\longrightarrow&amp;
                    cok(j)
                    \\,.
                    }
            %p
