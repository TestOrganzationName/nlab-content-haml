                %a.existingWikiWord{:href => "/nlab/show/Eric+Gimon"}> Eric Gimon
                ,
                %em On the M-theory Interpretation of Orientifold Planes
                (
                %a{:href => "https://arxiv.org/abs/hep-th/9806226"}> arXiv:hep-th/9806226
                ,
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/472499"} spire:472499
            %li#AKY98
              %p
                Changhyun Ahn, Hoil Kim, Hyun Seok Yang,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi N
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(2N)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,2)
                    SCFT and M Theory on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 7
                          %mo ×
                          %mi ℝ
                          %msup
                            %mi P
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} AdS_7 \times \mathbb{R}P^4
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9808182"} arXiv:hep-th/9808182
            %li#HananyKol00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"}> Amihay Hanany
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Barak+Kol"} Barak Kol
                = succeed "," do
                  %em On Orientifolds, Discrete Torsion, Branes and M Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0003025"} arXiv:hep-th/0003025
            %li#ArgyresMaimonPelland02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philip+Argyres"}> Philip Argyres
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ron+Maimon"} Ron Maimon
                = succeed "," do
                  %em The M theory lift of two O6 planes and four D6 branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0204127"} arXiv:hep-th/0204127
              %p following
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Solutions Of Four-Dimensional Field Theories Via M Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9703166"} arXiv:hep-th/9703166
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/MO5"} MO5
            is originally discussed in
          %ul
            %li
              %p
                Keshav Dasgupta,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sunil+Mukhi"} Sunil Mukhi
                = succeed "," do
                  %em Orbifolds of M-theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9512196"} arXiv:hep-th/9512196
            %li#Witten95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Five-branes And M-Theory On An Orbifold
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9512219"} arXiv:hep-th/9512219
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andreas+Braun"}> Andreas Braun
              ,
              %em M-Theory and Orientifolds
              (
              %a{:href => "https://arxiv.org/abs/1912.06072"}> arXiv1912.06072
              )
          %p
            The classification in
            %a{:href => "#HananyKol00"} Hanany-Kol 00 (3.2)
            also appears, with more details, in Prop. 4.7 of
          %ul
            %li#HuertaSatiSchreiber18
              %a.existingWikiWord{:href => "/nlab/show/John+Huerta"}> John Huerta
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Equivariant+homotopy+and+super+M-branes"} Real ADE-equivariant (co)homotopy and Super M-branes
              (
              %a{:href => "https://arxiv.org/abs/1805.05987"}> arXiv:1805.05987
              )
          %p
            The “higher orientifold” appearing in
            %a.existingWikiWord{:href => "/nlab/show/Horava-Witten+theory"} Horava-Witten theory
            with circle 2-bundles replaced by the
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundles
            of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            is discussed towards the end of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/The+moduli+3-stack+of+the+C-field"} The E8 moduli 3-stack of the C-field in M-theory
              (
              %a{:href => "http://arxiv.org/abs/1202.2455"}> arXiv:1202.2455
              )
          %h3#orientifold_backreaction_2 Orientifold backreaction
          %ul
            %li#Verlinde00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herman+Verlinde"}> Herman Verlinde
                ,
                = succeed "," do
                  %em Holography and Compactification
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9906182"} arXiv:hep-th/9906182
            %li#GiddingsKachruPolchinski01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Giddings"}> Steven Giddings
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shamit+Kachru"} Shamit Kachru
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joseph+Polchinski"} Joseph Polchinski
                = succeed "," do
                  %em Hierarchies from Fluxes in String Compactifications
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0105097"} arXiv:hep-th/0105097
            %li#BanksBroeck06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Banks"}> Tom Banks
                , K. van den Broek,
                = succeed "," do
                  %em Massive IIA flux compactifications and U-dualities
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0611185"} arXiv:hep-th/0611185
            %li#CordovaLucaTomasiello19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clay+Cordova"}> Clay Cordova
                , G. Bruno De Luca,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alessandro+Tomasiello"} Alessandro Tomasiello
                %em New de Sitter Solutions in Ten Dimensions and Orientifold Singularities
                (
                %a{:href => "https://arxiv.org/abs/1911.04498"}> arXiv:1911.04498
                )
            %li#Junghans20
              %p
                Daniel Junghans,
                %em O-plane Backreaction and Scale Separation in Type IIA Flux Vacua
                (
                %a{:href => "https://arxiv.org/abs/2003.06274"}> arXiv:2003.06274
