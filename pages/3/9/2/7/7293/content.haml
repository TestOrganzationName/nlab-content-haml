                  P^n \;\colon\; B^k \mathbb{Z}_p \longrightarrow B^{k+n} \mathbb{Z}_{p}
                  \\,.
          %p
            Under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
