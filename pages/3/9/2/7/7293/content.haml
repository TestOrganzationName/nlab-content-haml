                      %mn 2
                    %mo →
                    %msub
                      %mi ℤ
                      %mn 4
                    %mo →
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \to \mathbb{Z}_4 \to \mathbb{Z}_2
          %h3#compatibility_with_suspension Compatibility with suspension
          %p
            The Steenrod squares are compatible with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
          %p
            Therefore the Steenrod squares are often also referred to as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stable
              %a.existingWikiWord{:href => "/nlab/show/cohomology+operations"} cohomology operations
          %h3#relation_to_massey_products Relation to Massey products
          %p
            See at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Massey+product"} Massey product
            %em
              %a{:href => "Massey+product#RelationToSteenrodSquares"} Relation to Steenrod squares
          %h3#adem_relations Adem relations
          #AdemRelations.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Adem+relations"}> Adem relations
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of Steenrod square operations satisfies the following relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sq
                      %mi i
                    %mo ∘
                    %msup
                      %mi Sq
                      %mi j
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi k
                        %mo ≤
                        %mi i
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %msub
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi j
                              %mo −
                              %mi k
                              %mo −
                              %mn 1
                          %mrow
                            %mrow
                              %mi i
                              %mo −
                              %mn 2
                              %mi k
                        %mo )
                      %mrow
                        %mi mod
                        %mn 2
                    %msup
                      %mi Sq
                      %mrow
                        %mi i
                        %mo +
                        %mi j
                        %mo −
                        %mi k
                    %mo ∘
                    %msup
                      %mi Sq
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    Sq^i \circ Sq^j
                    \=
                    \\sum_{0 \leq k \leq i/2}
                    \\left(
                    {
                    { j - k - 1 }
                    \\atop
                    { i - 2k }
                    }
                    \\right)_{mod 2}
                    Sq^{i + j -k} \circ Sq^k
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi i
                      %mo &lt;
                      %mn 2
                      %mi j
                    %annotation{:encoding => "application/x-tex"} 0 \lt i \lt 2 j
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi a
                        %mrow
                          %mi b
                      %mo )
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \left( a \atop b \right) \coloneqq 0
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt b
