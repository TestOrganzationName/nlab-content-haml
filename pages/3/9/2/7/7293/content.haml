              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
