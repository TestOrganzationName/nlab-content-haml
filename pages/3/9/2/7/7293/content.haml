                      %annotation{:encoding => "application/x-tex"} Sq^n(x \cup y) = \sum_{i + j = n} (Sq^i x) \cup (Sq^j y)
                  ;
          %p
            An analogous definition works for
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            for any
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
