                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %a.existingWikiWord{:href => "/nlab/show/exponentiation"} exponentiation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
                  %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mphantom
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \phantom{A}
          %p
            (Here passing from the left to the right column is an example of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorification
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
          %p
            But the operations on sets on the right directly generalize from
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            to general sets, hence from sets whose
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            is a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinite+cardinals"} infinite cardinals
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/transfinite+arithmetic"} transfinite arithmetic
          %h2#definitions Definitions
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|S|}
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            induce
            %a.existingWikiWord{:href => "/nlab/show/arithmetic"} arithmetic
            operations on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cardinal+numbers"} cardinal numbers
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S_2
            two sets, the
            %strong sum
            of their cardinalities is the cardinality of their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} |
                  %mo +
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo ⨿
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {|S_1|} + {|S_2|} \coloneqq {|S_1 \amalg S_2|}
                  \\,.
          %p
            More generally, given any family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                %annotation{:encoding => "application/x-tex"} (S_i)_{i: I}
            of sets indexed by a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %strong sum
            of their cardinalities is the cardinality of their disjoint union:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %mrow
                    %mo{:stretchy => "false"} |
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{i: I} {|S_i|} \coloneqq {|\coprod_{i: I} S_i|}
                  \\,.
          %p
            Likewise, the
            %strong product
            of their cardinalities is the cardinality of their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo ×
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {|S_1|} \, {|S_2|} \coloneqq {|S_1 \times S_2|}
                  \\,.
          %p
            More generally again, given any family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                %annotation{:encoding => "application/x-tex"} (S_i)_{i: I}
            of sets indexed by a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %strong product
            of their cardinalities is the cardinality of their cartesian product:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %mrow
                    %mo{:stretchy => "false"} |
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{i: I} {|S_i|} \coloneqq {|\prod_{i: I} S_i|}
                  \\,.
          %p
            Also, the
            %strong exponential
            of one cardinality raised to the power of the other is the cardinality of their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} |
                  %mo ≔
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 2
                    %mo ,
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {|S_1|}^{|S_2|} \coloneqq {|Set(S_2,S_1)|}
                  \\,.
          %p
            In particular, we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} 2^{|S|}
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(S)
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            (but not
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \Omega^{|S|}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is the cardinality of the set of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
          %p
            The usual way to define an ordering on cardinal numbers is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|S_1|} \leq {|S_2|}
            if there exists an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_1
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mn 1
                  %mo ↪
                  %msub
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ({|S_1|} \leq {|S_2|})
                  \\;:\Leftrightarrow\;
                  (\exists (S_1 \hookrightarrow S_2))
                  \\,.
          %p
            Classically, this is almost equivalent to the existence of a
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                    %mo →
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S_2 \to S_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_1
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inhabited+sets"} inhabited sets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|S_1|} \leq {|S_2|}
            if there exists a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S_2
            and a surjection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X \to S_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_1
            (or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/decidable+subset"} decidable subset
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
          %p
            This order relation is
            %a.existingWikiWord{:href => "/nlab/show/antisymmetric+relation"} antisymmetric
            (and therefore a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            %a.existingWikiWord{:href => "/nlab/show/Cantor%E2%80%93Schroeder%E2%80%93Bernstein+theorem"} Cantor–Schroeder–Bernstein theorem
            (proved by Cantor using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/well-ordering+theorem"} well-ordering theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                  %mo ↪
                  %msub
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S_1 \hookrightarrow S_2
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 2
                  %mo ↪
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_2 \hookrightarrow S_1
            exist, then a bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                  %mo ≅
                  %msub
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S_1 \cong S_2
            exists. This theorem is not constructively valid, however.
          %p
            The well-ordered cardinals are
            %a.existingWikiWord{:href => "/nlab/show/well-order"} well-ordered
            by the ordering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinal+numbers"} ordinal numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mo ≤
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \kappa \leq \lambda
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mo &lt;
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \kappa \lt \lambda
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo =
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \kappa = \lambda
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mo &lt;
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \kappa \lt \lambda
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi κ
                      %mo +
                    %mo ≤
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \kappa^+ \leq \lambda
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/successor"} successor
            of a well-ordered cardinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            is the smallest well-ordered cardinal larger than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "'s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hartog%27s+number"} Hartog's number
          %h3#remarks Remarks
          %ul
            %li
              %p
                It is traditional to write
                %a.existingWikiWord{:href => "/nlab/show/%E2%84%B5"} ℵ
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} {}_0
                for the first
                %a.existingWikiWord{:href => "/nlab/show/infinite+cardinal"} infinite cardinal
                (the cardinality of the
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℵ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \aleph_1
                for the next (the first uncountable cardinality), and so on. In this way every cardinal (assuming choice) is labeled
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℵ
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} \aleph_\mu
                for a unique
                %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi μ
                      %annotation{:encoding => "application/x-tex"} \mu
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℵ
                          %mi μ
                        %mo{:stretchy => "false"} )
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo +
                        %mo =
                        %msub
                          %mi ℵ
                          %mrow
                            %msup
                              %mi μ
                              %mo +
                      %annotation{:encoding => "application/x-tex"} (\aleph_\mu))^+ = \aleph_{\mu^+}
            %li
              %p
                For every cardinal
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 2
                        %mi π
                      %mo &gt;
                      %mi π
                    %annotation{:encoding => "application/x-tex"} 2^\pi \gt \pi
                (this is sometimes called
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Cantor%27s+theorem"} Cantor's theorem
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 2
                        %mrow
                          %msub
                            %mi ℵ
                            %mn 0
                      %mo =
                      %msub
                        %mi ℵ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} 2^{\aleph_0} = \aleph_{1}
                (or more generally whether
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 2
                          %mrow
                            %msub
                              %mi ℵ
                              %mi μ
                        %mo =
                        %msub
                          %mi ℵ
                          %mrow
                            %msup
                              %mi μ
                              %mo +
                      %annotation{:encoding => "application/x-tex"} 2^{\aleph_\mu} = \aleph_{\mu^+}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/continuum+hypothesis"} continuum hypothesis
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
          %h2#properties Properties
          .num_theorem
            %h6#theorem Theorem
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/infinite+cardinal"} infinite cardinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              we have (using the axiom of choice)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo +
                    %mi π
                    %mo =
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi + \pi = \pi
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo ⋅
                      %mi π
                      %mo =
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi \cdot \pi = \pi
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
          .proof
            %h6#proof Proof
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo ≤
                      %mi π
                      %mo +
                      %mi π
                      %mo =
                      %mn 2
                      %mo ⋅
                      %mi π
                      %mo ≤
                      %mi π
                      %mo ⋅
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi \leq \pi + \pi = 2 \cdot \pi \leq \pi \cdot \pi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo ⋅
                      %mi π
                      %mo ≤
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi \cdot \pi \leq \pi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ≅
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \cong \mathbb{N} \times \mathbb{N}
              – not the one that enumerates along successive diagonals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi y
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} x + y = k
              which are spheres in an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L^1
              %a.existingWikiWord{:href => "/nlab/show/p-norm"} metric
              (and which involves additive structure), but one which enumerates along successive spheres in an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L^\infty
              metric (which involves only order structure).
            %p
              With this hint in mind, regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              as the least
              %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              in its cardinality class (using the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/well-ordering+theorem"} well-ordering theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is a minimal counterexample to the statement. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\alpha|}^2 = {|\alpha|}
              for all ordinals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo &lt;
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \alpha \lt \pi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mn 3
                    %mo =
                    %mi π
                    %mo ×
                    %mi π
                    %mo ×
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi^3 = \pi \times \pi \times \pi
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/lexicographic+order"} lexicographic order
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi π
                      %mn 3
                    %mo :
                    %mi x
                    %mo =
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S = \{(x, y, z) \in \pi^3: x = \max(y, z)\}
            %p
              under the order inherited from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi π
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \pi^3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≅
                    %msup
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S \cong \pi^2
              as sets. Under the supposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi π
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %msup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi π
                          %mo{:stretchy => "false"} |
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} {|\pi|} \lt {|\pi|}^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is isomorphic to one of the
              %a.existingWikiWord{:href => "/nlab/show/lower+set"} initial segments
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S(a, b, c) \coloneqq \{(x, y, z) \in S: (x, y, z) \lt (a, b, c)\}
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo ,
                      %mi β
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(\alpha, \beta, \gamma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              as an ordinal less than
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi π
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo ,
                      %mi β
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo ,
                      %mi α
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi π
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\pi|} = {|S(\alpha, \beta, \gamma)|} \leq {|S(\alpha, \alpha, \alpha)|} = {|\alpha|}^2 = {|\alpha|} \lt {|\pi|}
            %p which gives a contradiction.
          .num_remark
            %h6#remark Remark
            %p
              Conversely, if (relative to ZF or any other standard set theory) we assume that any infinite set can be put in bijection with its cartesian square, then every set can be well-ordered, a result originally due to Tarski. Details may be found at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hartogs+number"} Hartogs number
          .num_cor
            %h6#corollary Corollary
            %p
              If one of two non-zero cardinals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ,
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \kappa, \lambda
              is infinite, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo +
                    %mi λ
                    %mo =
                    %mi κ
                    %mo ⋅
                    %mi λ
                    %mo =
                    %mi max
                    %mo{:stretchy => "false"} {
                    %mi κ
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \kappa + \lambda = \kappa \cdot \lambda = \max \{\kappa, \lambda\}.
          .proof
            %h6#proof_2 Proof
            %p
              Clearly,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ≤
                    %mi κ
                    %mo +
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \kappa \leq \kappa + \lambda
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ≤
                      %mi κ
                      %mo +
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda \leq \kappa + \lambda
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi max
                      %mo{:stretchy => "false"} {
                      %mi κ
                      %mo ,
                      %mi λ
                      %mo{:stretchy => "false"} }
                      %mo ≤
                      %mi κ
                      %mo +
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \max \{\kappa, \lambda\} \leq \kappa + \lambda
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo =
                      %mi max
                      %mo{:stretchy => "false"} {
                      %mi κ
                      %mo ,
                      %mi λ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mu = \max \{\kappa, \lambda\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ⋅
                    %mi λ
                    %mo ≤
                    %mi μ
                    %mo ⋅
                    %mi μ
                    %mo =
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \kappa \cdot \lambda \leq \mu \cdot \mu = \mu
            %p and similarly for addition instead of multiplication.
          %h2#references References
          %p Traditional lecture notes include
          %ul
            %li
              %p
                Alexandru Baltag,
                %em Axiomatix set theory lecture 8: Cardinal arithmetic
                (
                %a{:href => "http://www.vub.ac.be/CLWF/SS/Sets8.pdf"}> pdf
                )
            %li
              %p
                %em Cardinal arithmetic
                (
                %a{:href => "https://www.math.ksu.edu/~nagy/real-an/ap-b-card.pdf"}> pdf
                )
          %p See also
          %ul
            %li
              Planetmath,
              %em
                %a{:href => "http://planetmath.org/cardinalarithmetic"} cardinal arithmetic
          %p
            The point of view of
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            is amplified in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
              ,
              %em Categorifying cardinal arithmetic
              (
              %a{:href => "http://www.math.jhu.edu/~eriehl/arithmetic.pdf"}> pdf
              )
