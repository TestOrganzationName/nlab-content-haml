                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi I
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mo •
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi J
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; I_\bullet
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{g_\bullet}}
                    \\\
                    Y &amp;\longrightarrow&amp; J_\bullet
                    }
                    \\,.
          .num_example
            %h6#example_3 Example
            %p
              %strong (standard resolution)
            %p
              Consider the augmented
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              which is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕊
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mathbb{S} \to E
              %a.existingWikiWord{:href => "/nlab/show/Amitsur+complex"} Amitsur complex
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smashed
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow E \wedge X \stackrel{\longrightarrow}{\longrightarrow} E \wedge E \wedge X \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                    E \wedge E \wedge E \wedge X
                    \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                    \\cdots
                    \\,.
            %p
              Its corresponding
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              (the sequence whose maps are the alternating sum of the above coface maps) is an
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.maruku-ref{:href => "#EAdamsResolution"}
          %h4#adams_towers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            \-Adams towers
          #EAdamsTower.num_defn
            %h6#definition_6 Definition
            %p
              An
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                \-Adams tower
              of a spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/HoSpectra"} HoSpectra
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi κ
                                  %mn 2
                          %mtd
                            %msup
                              %mi Ω
                              %mn 2
                            %msub
                              %mi I
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi κ
                                  %mn 1
                          %mtd
                            %mi Ω
                            %msub
                              %mi I
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 0
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                            %mo =
                            %msub
                              %mi I
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi κ
                                  %mn 0
                          %mtd
                            %msub
                              %mi I
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \vdots
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p_2}}
                    \\\
                    \&amp;&amp; X_2 &amp;\stackrel{\kappa_2}{\longrightarrow}&amp; \Omega^2 I_3
                    \\\
                    \&amp;\nearrow&amp; \downarrow^{\mathrlap{p_1}}
                    \\\
                    \&amp;&amp; X_1 &amp;\stackrel{\kappa_1}{\longrightarrow}&amp; \Omega I_2
                    \\\
                    \&amp;\nearrow&amp; \downarrow^{\mathrlap{p_0}}
                    \\\
                    X
                    \&amp;\underset{}{\longrightarrow}&amp;
                    X_0 = I_0
                    \&amp;\stackrel{\kappa_0}{\longrightarrow}&amp;
                    I_1
                    }
            %p such that
            %ol
              %li
                %p
                  each hook is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
                  (hence it is a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/tower+of+homotopy+fibers"} tower of homotopy fibers
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo ⊣
                          %mi Ω
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\Sigma \dashv \Omega)
                  %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mrow
                            %msub
                              %mi p
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                      %annotation{:encoding => "application/x-tex"} \Sigma_{p_{n-1}}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Σ
                          %mi n
                        %msub
                          %mi κ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \Sigma^n \kappa_n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi I
                          %mi n
                        %mover
                          %mo ⟶
                          %mover
                            %mrow
                              %mi Σ
                              %msub
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mo ˜
                        %msup
                          %mi Σ
                          %mi n
                        %msub
                          %mi X
                          %mi n
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi Σ
                              %mi n
                            %msub
                              %mi κ
                              %mi n
                        %msub
                          %mi I
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        i_{n+1} \;\colon\; I_n \stackrel{\widetilde {\Sigma p_{n-1}}}{\longrightarrow}
                        \\Sigma^n X_n \stackrel{\Sigma^{n}\kappa_n}{\longrightarrow} I_{n+1}
                %p
                  constitute an
                  = succeed "-Adams" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed ":" do
                    %a.maruku-ref{:href => "#EAdamsResolution"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo →
                        %mi X
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                        %msub
                          %mi I
                          %mn 0
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mn 2
                        %msub
                          %mi I
                          %mn 2
                        %mover
                          %mo →
                          %mrow
                        %mi ⋯
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        0 \to X \stackrel{i_0}{\to} I_0 \stackrel{i_2}{\to} I_2 \stackrel{}{\to} \cdots
                        \\,.
            %p
              Call this the
              %em
                associated
                = succeed "-Adams" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
              of the
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              The
              %em associated inverse sequence
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi X
                      %mn 0
                    %mover
                      %mo ⟵
                      %mrow
                        %msub
                          %mi γ
                          %mn 0
                    %mi Ω
                    %msub
                      %mi C
                      %mn 1
                    %mover
                      %mo ⟵
                      %mrow
                        %msub
                          %mi γ
                          %mn 1
                    %msub
                      %mi C
                      %mn 2
                    %mo ⟵
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    X = X_0 \stackrel{\gamma_0}{\longleftarrow} \Omega C_1 \stackrel{\gamma_1}{\longleftarrow} C_2 \longleftarrow \cdots
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo ≔
                      %mi hocofib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_{k+1} \coloneqq hocofib(i_k)
          %p
            (In (
            %a{:href => "#Ravenel"}> Ravenel
            ) it is is the associated inverse sequence that is called the associated resolution.)
          %p =–
          .num_example
            %h6#example_4 Example
            %p
              Every
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#EAdamsResolution"}
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.maruku-ref{:href => "#EAdamsTower"}
              of which it is the associated
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
