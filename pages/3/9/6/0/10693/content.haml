          %h3#ViaInjectiveResolutions Via injective resolutions
          %p
            A streamlined discussion of
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/injective+resolutions"} injective resolutions
            in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            was given in (
            %a{:href => "#Miller81"}> Miller 81
            ), advertized in (
            %a{:href => "#Hopkins99"}> Hopkins 99
            ) and worked out in more detail in (
            %a{:href => "#Aramian"}> Aramian
            ).
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HoSpectra
                %annotation{:encoding => "application/x-tex"} HoSpectra
            for the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi HoSpectra
                    %mi op
                  %mo ×
