          %p
            where the summation is over all permutations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mn 1
                  %mi ⋯
                  %msub
                    %mi i
                    %mrow
                      %mi n
                      %mo −
                      %mn 2
                %annotation{:encoding => "application/x-tex"} i_1 \cdots i_{n-2}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
