                  %annotation{:encoding => "application/x-tex"} n-1
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_{n-1}(L^n)
            is the smallest normal subgroup containing the meridian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \alpha_{n-1}
            (since removing the
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \alpha_{n-1}
            to collapse) and so every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_{n-1}
            can be written as a word in alphabet of powers and conjugates of
            = succeed "." do
