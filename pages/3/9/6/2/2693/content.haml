          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#the_model_structure"} The model structure
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
