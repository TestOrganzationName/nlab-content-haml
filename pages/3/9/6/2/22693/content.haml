                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo \
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo \
                      %mi c
                      %mo =
                      %mi b
                      %mo \
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo \
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo \
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo \
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a\backslash b)\backslash c= b\backslash ((a\backslash (a\backslash a))\backslash c)
          %p
            For any element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo \
                  %mi a
                %annotation{:encoding => "application/x-tex"} a\backslash a
            is called a
            = succeed "," do
              %strong right identity element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo \
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo \
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a\backslash (a\backslash a)
            is called the
            %strong right inverse element
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %strong left multiplication
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo \
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo \
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi b
                  %annotation{:encoding => "application/x-tex"} (a\backslash (a\backslash a))\backslash b
          %p
            A
            %strong right associative quasigroup
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with a binary operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %mo ×
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} (-)/(-):G \times G \to G
            such that:
          %ul
            %li
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} /
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a/a=b/b
            %li
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} (a/a)/((a/a)/a)=a
            %li
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a/(b/c)=(a/((c/c)/c)/b
          %p
            For any element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi a
                %annotation{:encoding => "application/x-tex"} a/a
            is called a
            = succeed "," do
              %strong left identity element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi a
                %annotation{:encoding => "application/x-tex"} (a/a)/a
            is called the
            %strong left inverse element
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %strong right multiplication
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} /
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a/((b/b)/b)
          %p
            An
            %strong associative quasigroup
            is a possibly empty left and right group as defined above such that the following are true:
          %ul
            %li
              %p
                left and right identity elements are equal (i.e.
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo{:stretchy => "false"} /
                        %mi a
                        %mo =
                        %mi a
                        %mo \
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a/a = a \backslash a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                left and right inverse elements are equal (i.e.
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} /
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi a
                        %mo =
                        %mi a
                        %mo \
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo \
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a/a)/a = a\backslash (a\backslash a)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                left and right multiplications are equal (i.e.
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} /
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo \
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo \
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo \
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a/((b/b)/b) = (a\backslash (a\backslash a))\backslash b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
          %p
            This definition
            %a{:href => "https://ncatlab.org/nlab/revision/diff/heap/13"} first appeared on the heap article
            and is due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Toby+Bartels"} Toby Bartels
          %h2#pseudotorsors Pseudo-torsors
          %p
            Every left associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            has a
            %a.existingWikiWord{:href => "/nlab/show/pseudo-torsor"} pseudo-torsor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi G
                  %mo :
                  %msup
                    %mi G
                    %mn 3
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} t_G:G^3 \to G
            defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo \
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t_G(x,y,z) = x \cdot (y \backslash z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            has a
            %a.existingWikiWord{:href => "/nlab/show/pseudo-torsor"} pseudo-torsor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi H
                  %mo :
                  %msup
                    %mi H
                    %mn 3
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} t_H:H^3 \to H
            defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi z
                  %annotation{:encoding => "application/x-tex"} t_H(x,y,z) = (x / y) \cdot z
            %a.existingWikiWord{:href => "/nlab/show/torsors"} torsors
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heaps"} heaps
          %h2#category_of_associative_quasigroups Category of associative quasigroups
          %p
            An
            %strong associative quasigroup homomorphism
            is a
            %a.existingWikiWord{:href => "/nlab/show/semigroup+homomorphism"} semigroup homomorphism
            between associative quasigroups that preserves left and right quotients. Associative quasigroup homomorphisms are the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of associative quasigroups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AssocQuasiGrp
                  %annotation{:encoding => "application/x-tex"} AssocQuasiGrp
          %p
            As the category of associative quasigroups is a concrete category, there is a
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi AssocQuasiGrp
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U:AssocQuasiGrp \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %strong free associative quasigroup
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi Set
                    %mo →
                    %mi AssocQuasiGrp
                  %annotation{:encoding => "application/x-tex"} F:Set \to AssocQuasiGrp
          %p
            The
            %strong empty associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            whose underlying set is the
            %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial associative quasigroup
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strictly initial
            %strong trivial associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            whose underlying set is the
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal associative quasigroup
          %p
            The
            %strong direct product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi H
                %annotation{:encoding => "application/x-tex"} G \times H
            of associative quasigroups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(G) \times U(H)
            with an associative quasigroup structure defined componentwise by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⋅
                    %mrow
                      %mi G
                      %mo ×
                      %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %msub
                    %mo ⋅
                    %mi G
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %msub
                    %mo ⋅
                    %mi H
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_1, h_1) \cdot_{G \times H} (g_2, h_2) = (g_1 \cdot_G g_2, h_1 \cdot_H h_2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi G
                      %mo ×
                      %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} /
                    %mi G
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} /
                    %mi H
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_1, h_1) /_{G \times H} (g_2, h_2) = (g_1 /_G g_2, h_1 /_H h_2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo \
                    %mrow
                      %mi G
                      %mo ×
                      %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %msub
                    %mo \
                    %mi G
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 1
                  %msub
                    %mo \
                    %mi H
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_1, h_1) \backslash_{G \times H} (g_2, h_2) = (g_1 \backslash_G g_2, h_1 \backslash_H h_2)
          %p
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi h
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_1, h_1), (g_2, h_2) \in U(G) \times U(H)
            %a.existingWikiWord{:href => "/nlab/show/product+projections"} product projections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi G
                  %mo :
                  %mi G
                  %mo ×
                  %mi H
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} p_G: G \times H \to G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi H
                  %mo :
                  %mi G
                  %mo ×
                  %mi H
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} p_H: G \times H \to H
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                %annotation{:encoding => "application/x-tex"} p_G(g, h) = g
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi h
                %annotation{:encoding => "application/x-tex"} p_H(g,h) = h
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi G
                  %mo ×
                  %mi H
                %annotation{:encoding => "application/x-tex"} (g,h)\in G \times H
            The direct product of associative quasigroups is thus the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AssocQuasiGrp
                  %annotation{:encoding => "application/x-tex"} AssocQuasiGrp
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi G
                  %mo ×
                  %mn 1
                %annotation{:encoding => "application/x-tex"} P(G) = G \times 1
            is the
            %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AssocQuasiGrp
                %annotation{:encoding => "application/x-tex"} AssocQuasiGrp
            while the endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi G
                  %mo ×
                  %mn 0
                %annotation{:encoding => "application/x-tex"} P(G) = G \times 0
            is a
            %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
            that sends every associative quasigroup to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p
            An
            %strong associative subquasigroup
            of an associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is an associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            with an associative quasigroup
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H \hookrightarrow G
                  \\,.
          %p
            The empty associative is the initial associative subquasigroup of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            be associative quasigroups and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi G
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} f:G \to H
            be an associative quasigroup homomorphism. Then given an element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %mi H
                  %annotation{:encoding => "application/x-tex"} h \in H
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi I
                  %mo ↪
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i: I \hookrightarrow G
                  \\,.
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} g \in I
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f(g) = h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          %p
            Because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AssocQuasiGrp
                %annotation{:encoding => "application/x-tex"} AssocQuasiGrp
            has a terminal object, cartesian products, and fibers, it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete category
          %p
            Every associative quasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and associative subquasigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
            has a
            %strong
              set of left
              %a.existingWikiWord{:href => "/nlab/show/ideal+in+a+semigroup"} ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi H
                %annotation{:encoding => "application/x-tex"} G H
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and a
            %strong set of right ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi G
                %annotation{:encoding => "application/x-tex"} H G
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
