                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          #CharacterizationOfLocalObjects.num_prop
            %h6#proposition_3 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A \in [C^{op}, Set]
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              (meaning: in the
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              the induced function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(f,A) : Hom(Y,A) \to Hom(X,A)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          .proof
            %h6#proof_2 Proof
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ≃
                      %mi i
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} A \simeq i \hat A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L \dashv i)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi i
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(f, i \hat A) \simeq \mathcal{E}(L(f), A)
                    \\,.
            %p
              But by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(f)
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              Conversely, if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(f,A)
              is a bijection, define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat A := L(A)
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                    %mo :
                    %mi A
                    %mo →
                    %mi i
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon_A : A \to i L(A)
              be the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L \dashv i)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            %p
              By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              and basic properties of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi i
                    %mo →
                    %mi Id
                  %annotation{:encoding => "application/x-tex"}
                    L i \to Id
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %a.existingWikiWord{:href => "/nlab/show/zig-zag+law"} zig-zag law
              the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mi L
                        %msub
                          %mi ϵ
                          %mi A
                    %mi L
                    %mi i
                    %mi L
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mi L
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    L A \stackrel{L \epsilon_A}{\to} L i L A \stackrel{\simeq}{\to} L A
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} L \epsilon
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \epsilon_A
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p Using this it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϵ
                      %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi L
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\epsilon_A, A) : Hom(i L A, A) \stackrel{\simeq}{\to} Hom(A,A)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi A
                    %mo :
                    %mi i
                    %mi L
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} k_A : i L A \to A
              for the preimage of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi A
                  %annotation{:encoding => "application/x-tex"} id_A
              under this isomorphism, which is therefore a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \epsilon_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi A
                  %annotation{:encoding => "application/x-tex"} k_A
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi A
                  %annotation{:encoding => "application/x-tex"} k_A
              to find that it has a left inverse itself. But this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi A
                  %annotation{:encoding => "application/x-tex"} k_A
              is in fact an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and hence so is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \epsilon A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as being in the essential image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          #WeakEquivalencesDetectedOnRepresentableCodomains.num_prop
            %h6#proposition_4 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              precisely if for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} z : j(c) \to Y
              with
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi z
                      %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} z^* f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mi Y
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi z
                                    %mo *
                                  %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi z
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times_Y j(c) &amp;\to&amp; X
                    \\\
                    {}^{\mathllap{z^* f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    j(c) &amp;\stackrel{z}{\to}&amp; Y
                    }
            %p
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
          .proof
            %h6#proof_3 Proof
            %p
              Assume first that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves finite limits, it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo ×
                              %mi Y
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi L
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi z
                                    %mo *
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi L
                                  %mi f
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi L
                                %mi z
                          %mtd
                            %mi L
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L(X \times_Y j(c)) &amp;\to&amp; L X
                    \\\
                    {}^{\mathllap{L(z^* f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{L f}}
                    \\\
                    L(j(c)) &amp;\stackrel{L z}{\to}&amp; L Y
                    }
            %p
              is still a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi z
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(z^* f)
              is the pullback of the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi f
                  %annotation{:encoding => "application/x-tex"} L f
              and thus itself an isomorphism. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi z
                      %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} z^* f
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %p
              Conversely, suppose that all these pullbacks are in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              as a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over all representables mapping into it
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi z
                              %mi i
                        %mi Y
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\lim_\to}_{j(c_i) \stackrel{z_i}{\to} Y} j(c)  \stackrel{\simeq}{\to} Y
                    \\,.
            %p
              Forming the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              (such as our
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %msup
                              %mi f
                              %mo *
                            %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mrow
                                      %munder
                                        %mi lim
                                        %mo →
                                    %mi i
                                  %msubsup
                                    %mi z
                                    %mi i
                                    %mo *
                                  %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {\lim_\to}_i f^* j(c_i) &amp;\stackrel{\simeq}{\to}&amp; X
                    \\\
                    {}^{\mathllap{{\lim_\to}_i z_i^* f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    {\lim_\to}_i j(c_i)
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    Y
                    }
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves all colimits and finite limits, we also get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mrow
                                      %munder
                                        %mi lim
                                        %mo →
                                    %mi i
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mi z
                                    %mi i
                                    %mo *
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {\lim_\to}_i L(f^* j(c_i)) &amp;\stackrel{\simeq}{\to}&amp; L(X)
                    \\\
                    {}^{\mathllap{{\lim_\to}_i L(z_i^* f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{L(f)}}
                    \\\
                    {\lim_\to}_i L(j(c_i))
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    L(Y)
                    }
                    \\,.
            %p
              Since by assumption now all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi z
                      %mi i
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(z_i^* f )
              are isomorphisms, also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %msub
