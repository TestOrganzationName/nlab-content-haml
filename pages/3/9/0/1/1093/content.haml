                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W := L^{-1}(isos) \subset Mor([C^{op}, Set])
            for the
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, Set]
            that are sent to
