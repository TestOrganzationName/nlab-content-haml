          %p
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            with a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} L : [C^{op}, Set] \to \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            preserves
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo :
                  %mo =
