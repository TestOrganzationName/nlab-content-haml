              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relations"} relations
              %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible
              %a.existingWikiWord{:href => "/nlab/show/reflective+localizations"} reflective localizations
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletions"} free cocompletions
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
              localization.
            %table
              %thead
