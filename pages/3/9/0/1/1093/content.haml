                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i : Sh_J(C) \hookrightarrow
                    PSh(C)
            %p
              of those presheaves which are
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
          #SheafInclusionIsReflective.num_prop
            %h6#proposition Proposition
            %p
              Every category of sheaves is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Sh
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mi L
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv i) : Sh_J(C) \stackrel{\overset{L}{\leftarrow}}{\hookrightarrow}
                    Psh(C)
                    \\,,
            %p
              hence a
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topologies"} Grothendieck topologies
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and equivalence classes of
              %a.existingWikiWord{:href => "/nlab/show/geometric+embeddings"} geometric embeddings
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(C)
          %p
            This appears for instance as (
            %a{:href => "#Johnstone"}> Johnstone, corollary C.2.1.11
            ). See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
          .proof
            %h6#proof Proof
            %p
              Details on the first statement are at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              (there proven in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %h2#equivalent_characterizations Equivalent characterizations
          %h3#as_localizations As localizations
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The category of sheaves is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              with the weak equivalences given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                  %annotation{:encoding => "application/x-tex"} W =
              %a.existingWikiWord{:href => "/nlab/show/local+isomorphisms"} local isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Ho
                      %mrow
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mtext local isomorphisms
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(S) \simeq Ho_{PSh(S)} = PSh(C)[\text{local isomorphisms}]^{-1}
                    \\,.
            %p
              The converse is also true: for every
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L : PSh(S) \to PSh(S)
              (preserving finite limits) which is
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} left adjoint
              to the inclusion of its image, there is a Grothendieck topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              such that the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is the category of sheaves on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with respect to that topology.
          %p We spell out proofs of some of the above claims.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi ℰ
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
