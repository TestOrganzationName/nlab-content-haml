                      %mi i
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi z
                      %mi i
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {\lim_\to}_i L(z_i^* f)
              is an isomorphism and hence three sides of the above square are isomorphisms. Therefore also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(f)
              is and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
          #LocalizationInducesGrothendieckTopology.num_prop
            %h6#proposition_5 Proposition
            %p
              The collection of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              whose
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_4 Proof
            %p
              We check the list of axioms, given at
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            %ol
              %li
                %p
                  %em Pullbacks of covering sieves are covering
                  \:
                %p
                  First of all, the pullback of a sieve along a morphism of representables is still a sieve, because
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                %p
                  Next, since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  applied to the pullback sieve is the pullback of an isomorphism, hence is an isomorphism, hence the pullback sieve is in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
              %li
                %p
                  %em The maximal sieve is covering.
                  Clear:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  applied to an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %li
                %p
                  %em Two sieves cover precisely if their intersection covers.
                  This is again due to the
                  = succeed "-stability" do
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
              %li
                %p
                  %em If all pullbacks of a sieve along morphisms of a covering sieve are covering, then the original sieve was covering
                  \.
                %p
                  This is the same argument as in the second part of the proof of prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#WeakEquivalencesDetectedOnRepresentableCodomains"}
          .num_prop
            %h6#proposition_6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
          .proof
            %h6#proof_5 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#LocalizationInducesGrothendieckTopology"}
              and prop.
              %a.maruku-ref{:href => "#CharacterizationOfLocalObjects"}
              we are reduced to showing that an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              already if for all
              %em
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(f,A)
              is a bijection.
            %p (…)
          %h3#AsToposes As toposes
          %p
            Categories of sheaves are examples of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            that are
            = succeed "es:" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Giraud's axioms
          .num_prop
            %h6#proposition_7 Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Sheaf toposes
              are equivalently the
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} subtoposes
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
          %p
            This appears for instance as (
            %a{:href => "#Johnstone"}> Johnstone, corollary C.2.1.11
            ).
          %h3#AsAccessibleReflectiveSubcategories As accessible reflective subcategories
          .num_prop
            %h6#proposition_8 Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes"} sheaf toposes are equivalently the left exact reflective subcategories of presheaf toposes
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
          %h2#properties Properties
          %h3#dependence_on_the_site Dependence on the site
          .num_prop
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
