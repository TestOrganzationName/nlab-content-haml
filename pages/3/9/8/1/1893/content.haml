                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                \-typical
                = succeed "-ring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Lambda
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  equipped with an
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi A
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} F_A \colon A \to A
            %p
              such that under
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
              it becomes the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
              = succeed ":" do
                %a.maruku-ref{:href => "#FrobeniusMorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %msub
                      %mi F
                      %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝔽
                      %mi p
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi A
                    %mo ⟶
                    %msub
                      %mi 𝔽
                      %mi p
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{F}_p \otimes_{\mathbb{Z}} F_A
                    \=
                    F_p
                    \\;
                    \\colon
                    \\;
                    \\mathbb{F}_p \otimes_{\mathbb{Z}} A
                    \\longrightarrow
                    \\mathbb{F}_p \otimes_{\mathbb{Z}} A
                    \\,.
            %p
              A
              %em
                big
                = succeed "-ring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Lambda
              is a commutative ring equipped with commuting endomorphisms, one for each prime number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-typical," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %p
            This is def. 1.7 in (
            %a{:href => "#Borger08"}> Borger 08
            ), formulated for the special case of example 1.15 there (which is stated in terms of Witt vectors) and translated to
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            = succeed ")" do
              %a{:href => "#AdjointTriple"} the adjunction
          %blockquote
            %p the following originates from revision 19 but needs attention
          .num_example
            %h6#example_2 Example
            %p
              The
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/Adams+operation"} Adams operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \psi_p
              is a Frobenius lift. Moreover given any two prime numbers then their
              %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
              commute with each other.
          %p The following two theorems are crucial for the “heterodox” point of view. We will see later that in fact we do not need the torsion-freeness assumption.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              (
              %a{:href => "#Wilkerson82"}> Wilkerson 82
              )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an additively torsion-free commutative ring. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ψ
                      %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\psi_p\}
              be a commuting family of Frobenius lifts.
            %p
              Then there is a unique
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              whose
              %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
              are the given Frobenius lifts
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ψ
                        %mi p
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\psi_p\}
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              A ring morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              between two
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              = succeed "-operations)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              commutes with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
          .num_cor
            %h6#corollary Corollary
            %p
              There is an equivalence between the category of torsion-free
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
          %p Now we will argue that these statements hold for arbitrary commutative rings.
          .num_remark
            %h6#remark Remark
            %p
              a) The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} \lambda Ring
              of
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %a.existingWikiWord{:href => "/nlab/show/monadic"} monadic
              and
              %a.existingWikiWord{:href => "/nlab/show/comonadic"} comonadic
              over the category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} C Ring
              of commutative rings.
            %p
              b) The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %msub
                      %mi Ring
                      %mrow
                        %mo ¬
                        %mi tor
                  %annotation{:encoding => "application/x-tex"} \lambda Ring_{\neg tor}
              of torsion-free
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %a.existingWikiWord{:href => "/nlab/show/monadic"} monadic
              and
              %a.existingWikiWord{:href => "/nlab/show/comonadic"} comonadic
              over the category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %msub
                      %mi Ring
                      %mrow
                        %mo ¬
                        %mi tor
                  %annotation{:encoding => "application/x-tex"} C Ring_{\neg tor}
              of torsion-free commutative rings.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} i
                    %mo :
                    %mi C
                    %msub
                      %mi Ring
                      %mrow
                        %mo ¬
                        %mi tor
                    %mo ↪
                    %mi C
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} \i:C Ring_{\neg tor}\hookrightarrow C Ring
              be the inclusion. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} W^\prime
              denote this comonad on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %msub
                        %mi Ring
                        %mrow
                          %mo ¬
                          %mi tor
                    %annotation{:encoding => "application/x-tex"} C Ring_{\neg tor}
            %p
              a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ≔
                    %msub
                      %mi Lan
                      %mi i
                    %mi i
                    %mo ∘
                    %msup
                      %mi W
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mi Ring
                    %mo →
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"} W \coloneqq Lan_i i\circ W^\prime \colon C Ring\to CRing
              is a comonad.
            %p
              b) The category of coalgebras of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is equivalent to the category of
              = succeed "-rings." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            %p
              c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/big-Witt-vectors+functor"} big-Witt-vectors functor
          .num_remark
            %h6#remark_2 Remark
            %p
              The “heterodox” generalizes to arbitrary
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+domain"} Dedekind domains
              with finite residue field.
            %p
              For instance over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_p[x]
              (instead of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "-operators" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi_{f(x)}
              would have to be congruent to the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              is the size of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi p
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_p[x]/(f(x))
          %h2#examples Examples
          .num_example
            %h6#example_3 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X)
              of any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              carries the structure of a
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
