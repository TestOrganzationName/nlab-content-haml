                        %mi R
                      %annotation{:encoding => "application/x-tex"} r\in R
            %p
              where
              = succeed "and" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
