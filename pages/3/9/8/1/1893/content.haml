              maps.
          .num_example
            %h6#example Example
            %p
              There exists a
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mi t
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 1+ t R[ [t] ]
              of
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              with constant term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              where
            %p
