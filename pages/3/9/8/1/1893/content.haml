                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
          %p
            (
            %a{:href => "#Ganter07"}> Ganter 07
            ,
            = succeed ")" do
              %a{:href => "#Ganter13"} Ganter 13
          %h2#properties Properties
          %h3#FreeAndCofreeLambdaRings
            Free and co-free
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
          #AdjointTriple.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Λ
                    %mi Ring
                    %mo ⟶
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"} U \;\colon\; \Lambda Ring \longrightarrow CRing
              from
              = succeed "-rings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
              has
            %ul
              %li
                %p
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Symm
                      %annotation{:encoding => "application/x-tex"} Symm
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  given by forming the
                  %a.existingWikiWord{:href => "/nlab/show/ring+of+Witt+vectors"} ring of Witt vectors
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Symm
                    %mo ⊣
                    %mi U
                    %mo ⊣
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Λ
                    %mi Ring
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mi W
                        %mover
                          %mo ⟶
                          %mi U
                      %mover
                        %mo ←
                        %mi Symm
                    %mi CRing
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Symm \dashv U \dashv W)
                    \\;\colon\;
                    \\Lambda Ring
                    \\stackrel{\overset{Symm}{\leftarrow}}{\stackrel{\overset{U}{\longrightarrow}}{\underset{W}{\leftarrow}}}
                    CRing
                    \\,.
            %p Hence
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/rings+of+Witt+vectors"} rings of Witt vectors
                  are the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/co-free+functors"} co-free
                    Lambda-rings;
              %li
                %p
                  rings of
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
                  Lambda-rings.
          %p
            This statement appears in (
            %a{:href => "#Hazewinkel08"}> Hazewinkel 08, p. 87, p. 97, 98
            ). The right adjoint in a more general context is in (
            %a{:href => "#Borger08"}> Borger 08, prop. 1.10 (c)
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              On the level of
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
              (
              %a.existingWikiWord{:href => "/nlab/show/etale+toposes"}> etale toposes
              ) over these
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              of rings, this statement reappears as an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/etale+topos"} etale topos
              of
              %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
              to that over “
              %a.existingWikiWord{:href => "/nlab/show/F1"}> F1
              ” in
              %a.existingWikiWord{:href => "/nlab/show/Borger%27s+absolute+geometry"} Borger's absolute geometry
              (
              %a{:href => "#Borger08"}> Borger 08
              , exposition in
              = succeed ")." do
                %a{:href => "#Borger09"} Borger 09
          %h2#related_concepts Related concepts
          %ul
