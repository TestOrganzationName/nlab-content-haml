                        %mo =
                        %mi id
                      %annotation{:encoding => "application/x-tex"} \lambda^1=id
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \lambda^n(1)=0
                  , for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n\gt 1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msubsup
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi k
                            %mo =
                            %mn 0
                          %mi n
                        %msup
                          %mi λ
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                        %msup
                          %mi λ
                          %mrow
                            %mi n
                            %mo −
                            %mi k
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda^n(r+s)=\sum_{k=0}^n \lambda^k(r)\lambda^{n-k}(s)
                  , for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} r,s\in R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi P
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi λ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi …
                        %mo ,
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msup
                          %mi λ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi …
                        %mo ,
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda^n(r s)=P_n(\lambda^1(r),\dots,\lambda^n(r),\lambda^1(s),\dots,\lambda^n(s))
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} r,s\in R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi λ
                          %mi m
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi λ
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
