                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                      %mo =
                      %mi k
                  %msup
                    %mi H
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msubsup
                    %mi Ω
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi ℚ
                    %mi j
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
