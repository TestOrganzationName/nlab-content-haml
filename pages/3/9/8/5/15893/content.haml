                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{k}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{p})\otimes_{\mathbb{Q}_{p}}\mathbb{C}_{p}=\bigoplus_{i+j=k} H^{i}(X,\Omega_{X/\mathbb{Q}}^{j})\otimes_{\mathbb{Q}}\mathbb{C}_{p}(-j)
          %h2#comparison_theorems Comparison theorems
          %p
            Central to modern
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            and the
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
            of a smooth projective variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{p}
            (or more generally some finite extension of it), using the machinery of period rings, whose construction we will discuss in the next section.
          %p
            For instance, tensoring with the de Rham period ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi dR
                %annotation{:encoding => "application/x-tex"} B_{dR}
            gives us the following isomorphism between the de Rham and
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} dR
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi ℚ
                        %mi p
                  %msub
                    %mi B
                    %mi{:mathvariant => "normal"} dR
                  %mo =
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} et
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mover
                          %mi ℚ
                          %mo ¯
                        %mi p
                  %mo ,
                  %msub
                    %mi ℚ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi ℚ
                        %mi p
                  %msub
                    %mi B
                    %mi{:mathvariant => "normal"} dR
                %annotation{:encoding => "application/x-tex"} H_{\mathrm{dR}}^{i}(X)\otimes_{\mathbb{Q}_{p}} B_{\mathrm{dR}}=H_{\mathrm{et}}^{i}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{p})\otimes_{\mathbb{Q}_{p}} B_{\mathrm{dR}}
          %p
            The ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi dR
                %annotation{:encoding => "application/x-tex"} B_{dR}
            is equipped with a filtration and a Galois action. We have a way of recovering the de Rham cohomology from the
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} dR
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} et
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mover
                          %mi ℚ
                          %mo ¯
                        %mi p
                  %mo ,
                  %msub
                    %mi ℚ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi ℚ
                        %mi p
                  %msub
                    %mi B
                    %mi{:mathvariant => "normal"} dR
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Gal
                        %mrow
                          %msub
                            %mi ℚ
                            %mi p
                %annotation{:encoding => "application/x-tex"} H_{\mathrm{dR}}^{i}(X)=(H_{\mathrm{et}}^{i}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{p})\otimes_{\mathbb{Q}_{p}} B_{\mathrm{dR}})^{\mathrm{Gal}_{\mathbb{Q}_{p}}}
          %p
            Recovering the
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi crys
                %annotation{:encoding => "application/x-tex"} B_{crys}
            (which is equipped with a Frobenius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                %annotation{:encoding => "application/x-tex"} \varphi
            in addition to a filtration and Galois action), and is only possible if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has an integral model:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} et
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mover
                          %mi ℚ
                          %mo ¯
                        %mi p
                  %mo ,
                  %msub
                    %mi ℚ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi{:mathvariant => "normal"} Fil
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi H
                    %mi{:mathvariant => "normal"} dR
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi ℚ
                        %mi p
                  %msub
                    %mi B
                    %mi{:mathvariant => "normal"} crys
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi φ
                      %mo =
                      %mn 1
                %annotation{:encoding => "application/x-tex"} H_{\mathrm{et}}^{i}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{p})= \mathrm{Fil}^{0}(H_{\mathrm{dR}}^{i}(X)\otimes_{\mathbb{Q}_{p}} B_{\mathrm{crys}})^{\varphi=1}
          %h2#construction_of_period_rings Construction of period rings
          %p
            We now show how to construct
            = succeed "Let" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi dR
                    %mo .
                  %annotation{:encoding => "application/x-tex"} B_{dR}.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{C}_{p}}
            be the ring of integers of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℂ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}_{p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝕆
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                    %mo ♭
                %annotation{:encoding => "application/x-tex"} \mathbb{O}_{\mathbb{C}_{p}}^{\flat}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕆
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{O}_{\mathbb{C}_{p}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝕆
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                    %mo ♭
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathbb{O}_{\mathbb{C}_{p}}^{\flat})
            is also called
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_{inf}(\mathcal{O}_{\mathbb{C}_{p}})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %msub
                      %mi A
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \theta:A_{inf}(\mathcal{O}_{\mathbb{C}_{p}})\to \mathcal{O}_{\mathbb{C}_{p}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and taking the completion with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            gives us the ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi dR
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} B_{dR}^{+}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %msubsup
                    %mi B
                    %mi dR
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} t\in B_{dR}^{+}
            which we think of as the logarithm of the element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi ζ
                    %mo ,
                    %msup
                      %mi ζ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,\zeta,\zeta^{1/p},\ldots)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi dR
                    %mo =
                    %msubsup
                      %mi B
                      %mi dR
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi t
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} B_{dR}=B_{dR}^{+}[1/t]
          %p
            Next we show how to construct
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi crys
                  %annotation{:encoding => "application/x-tex"} B_{crys}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi inf
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_{inf}(\mathcal{O}_{\mathbb{C}_{p}})
            and invert
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} B_{dR}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of its kernel, and consider the ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mi crys
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} B_{crys}^{+}
            whose elements are power series of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %msub
                    %mi a
                    %mi n
                  %msup
                    %mi ω
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sum a_{n}\omega^{n}
            where the
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi n
                  %annotation{:encoding => "application/x-tex"} a_{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi inf
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A_{inf}(\mathcal{O}_{\mathbb{C}_{p}})[1/p]
            which converge to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            approaches infinity, with respect to the topology of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A_{inf}(\mathcal{O}_{\mathbb{C}_{p}})[1/p]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            as in the construction of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} B_{dR}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi crys
                    %mo =
                    %msubsup
                      %mi B
                      %mi crys
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi t
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} B_{crys}=B_{crys}^{+}[1/t]
          %h2#classification_of_adic_galois_representations
            Classification of
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            We can abstract the concepts discussed above and take a p-adic Galois representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (without knowing, say, if it comes from some cohomology theory). We can then define
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi dR
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ⊗
                  %msub
                    %mi B
                    %mi dR
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Gal
                        %mrow
                          %msub
                            %mi ℚ
                            %mi p
                %annotation{:encoding => "application/x-tex"} V_{dR}=(V\otimes B_{dR})^{\mathrm{Gal}_{\mathbb{Q}_{p}}}
          %p
            If the dimension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is equal to the dimension of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} V_{dR}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
            = succeed "." do
              %em de Rham
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi crys
                %annotation{:encoding => "application/x-tex"} B_{crys}
            instead of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} B_{dR}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
