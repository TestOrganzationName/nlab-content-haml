          %h2#definition Definition
          %p
            A
            %em supergroupoid
            is a
            %a.existingWikiWord{:href => "/nlab/show/1-truncated"} 1-truncated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+%E2%88%9E-groupoid"} super ∞-groupoid
          %h2#examples Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                a
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(X, \mathfrak{g})
                is a super-groupoid: over a given
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mi q
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0|q}
                with function algebra the
                %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Λ
                        %mi q
                    %annotation{:encoding => "application/x-tex"} \Lambda_q
                it assigns the ordinary
                %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
                of the ordinary
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ⊗
                        %msub
                          %mi Λ
                          %mi q
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi even
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{g} \otimes \Lambda_q)_{even}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mi q
                      %mo ↦
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ⊗
                      %msub
                        %mi Λ
                        %mi q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega^1(X, \mathfrak{g}) : \mathbb{R}^{0|q} \mapsto
                      \\Omega^1(X, (\mathfrak{g} \otimes \Lambda_q)_{even})
                      \\,.
