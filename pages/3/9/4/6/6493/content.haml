                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %annotation{:encoding => "application/x-tex"} \big[ [0], [1] \big]
            %p
          %p
            The following proposition follows on abstract grounds, but the explicit component-based proof we give is necessary in order to understand the
            = succeed "-formula" do
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in the
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to cocycles on the inertia groupoid.
          #RelationToSimplicialHomComplexIntoClassifyingSpace.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the inertia groupoid of a delooping groupoid of a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+hom+complex"} simplicial hom complex
              out of the minimal simplicial circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinimalSimplicialCircle"}
              %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W}G
              (Rem.
              = succeed "):" do
                %a.maruku-ref{:href => "#DeloopingGroupoidAndSimplicialClassifyingSpaceOfFiniteGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Λ
                    %mstyle{:mathvariant => "bold"}
