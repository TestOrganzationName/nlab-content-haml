                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is the
              %a.existingWikiWord{:href => "/nlab/show/Drinfeld+double"} Drinfeld double
              of the
              %a.existingWikiWord{:href => "/nlab/show/group+convolution+algebra"} group convolution algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
          #MinimalSimplicialCircle.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/minimal+simplicial+circle"}> minimal simplicial circle
                )
              %br/
              Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\;\coloneqq\;
                    \\Delta[1]/\partial\Delta[1]
                    \\;\;\;
                    \\in
                    \\;
                    sSet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              with exactly two non-degenerate cells,
            %ul
              %li
                %p
                  one of which in degree 0, which we denote by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [0] = [1]
              %li
                %p
                  and one in degree 1, which we denote by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %mo{:stretchy => "false"} [
                          %mn 0
