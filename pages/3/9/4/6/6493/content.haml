            (also “isotropy groups”) for points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (compare also the terminology “inertia group” for
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroups"} stabilizer subgroups
            used in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/number+theory"} number theory
            = succeed ")." do
              %a{:href => "https://en.wikipedia.org/wiki/Ramification_group#Decomposition_group_and_inertia_group"} here
          %h2#Definition Definition
          %h3#for_bare_groupoids For bare groupoids
          %p
          #InertiaGroupoid.num_defn
            %h6 Definition
            %p
              %strong (inertia groupoid)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ⇉
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq (\mathcal{G}_1 \rightrightarrows \mathcal{G}_0)
              (
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
            %ul
              %li
                %p
                  set of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              %li
                %p
                  set of
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
            %p
              one defines its
              %strong inertia groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \Lambda \mathcal{G}
              as the groupoid whose
            %ul
              %li
                %p
                  set of objects is the set of
                  %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/source"} source
                  and
                  %a.existingWikiWord{:href => "/nlab/show/target"} target
                  maps
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
