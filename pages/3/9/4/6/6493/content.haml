                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
