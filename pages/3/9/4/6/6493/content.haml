                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi x
                            %mo ∈
                            %msub
                              %mi 𝒢
                              %mn 0
                        %msub
                          %mi Aut
                          %mi 𝒢
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (\Lambda \mathcal{G})_0
                        \\;\coloneqq\;
                        \\underset{x \in \mathcal{G}_0}{\coprod}
                        Aut_{\mathcal{G}}(x)
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
