                      %mi f
                    %annotation{:encoding => "application/x-tex"} u^{-1}\circ g\circ u = f
          %p
          .num_prop
            %h6 Proposition
            %p
              The inertia groupoid (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InertiaGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (in fact
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              as
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+objects"} groupoid objects
              %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
