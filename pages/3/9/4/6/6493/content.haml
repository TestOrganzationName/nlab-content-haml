                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  (in the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive
                  %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
