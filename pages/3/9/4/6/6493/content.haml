                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{Z}
                    \\;\coloneqq\;
                    \\big(
                    \\mathbb{Z} \rightrightarrows \ast
                    \\big)
            %p
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              of the additive group of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
