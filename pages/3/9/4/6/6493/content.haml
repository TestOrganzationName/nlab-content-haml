          %p
            In the special “
            %a.existingWikiWord{:href => "/nlab/show/global+quotient+orbifold"}> global
            ” case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
