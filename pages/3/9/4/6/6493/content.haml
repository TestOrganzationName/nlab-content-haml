            %p
          %p
          .num_prop
            %h6 Proposition
            %p
              The inertia groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Lambda \mathbf{B} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi G
                      %mi ad
                    %mo ⫽
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi G
                      %mo ×
                      %mi G
                      %munderover
                        %mo ⇉
                        %mrow
                          %msub
                            %mi Ad
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi pr
                            %mn 2
                      %mi G
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda \mathbf{B}G
                    \\;\simeq\;
                    G_{ad} \sslash G
                    \\;=\;
                    \\left(
                    G \times G
                    \\underoverset
                    {Ad_{(-)}(-)}
                    {pr_2}
                    {\rightrightarrows}
                    G
                    \\right)
            %p
          This follows by immediate inspection. For more discussion see at
          %em
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space+of+a+classifying+space"} free loop space of a classifying space
          the section
          = succeed "." do
            %em
              %a{:href => "free+loop+space+of+classifying+space#ExampleDiscreteGroups"} Examples – For finite groups
          %p
          .num_prop
