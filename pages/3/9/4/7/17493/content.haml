                      %mi Π
                      %mn 2
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Pi^1_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo
                    %mo −
                %annotation{:encoding => "application/x-tex"} ^-
            (the last part is parameter-free
            = succeed "-comprehension)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Π
                      %mn 2
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Pi^1_2
            = succeed "-DC+BI," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mn 3
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma^1_3
            = succeed "-collection," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Pi_1
          %p With current technology, we are very far from having ordinal analyses of stronger systems such as full second order arithmetic, ZFC set theory, or impredicative type theories such as the calculus of (inductive) constructions.
          %h3#ordinal_notations Ordinal notations
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              is either the binary or the ternary Veblen function
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo =
                    %msub
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Omega=\Omega_1
              is the first recursively regular ordinal
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi ξ
                  %annotation{:encoding => "application/x-tex"} \Omega_\xi
              is the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is the first recursively inaccessible ordinal
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is the limit of the first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              recursively inaccessible ordinals
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is the first recursively Mahlo ordinal
          %p
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            functions are ordinal collapsing functions.
          %h3#systems_of_firstorder_arithmetic_foa Systems of first-order arithmetic (FOA)
          %p These assert some hierarchy of inductive defined sets of natural numbers.
          %ul
            %li EFA is elementary function arithmetic
            %li
              PRA is
              %a.existingWikiWord{:href => "/nlab/show/primitive+recursive+arithmetic"} primitive recursive arithmetic
            %li PA is first-order Peano arithmetic
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi{:mathvariant => "normal"} ID
                        %mo ^
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathrm{ID}}_\nu
              extends PA by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              iterated fixed points of monotone operators (not necessarily least).
            %li
              ID
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 1
                    %msup
                      %mo
                      %mo #
                  %annotation{:encoding => "application/x-tex"} _1^#
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi{:mathvariant => "normal"} ID
                        %mo ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathrm{ID}}_1
              with induction only for positive formulas.
            %li
              ID
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} _\nu
              , the theory of
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/iterated+inductive+definitions"} iterated inductive definitions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              iterated least fixed points of monotone operators.
          %p Many of the results in the table concerning these can be summarized as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi{:mathvariant => "normal"} ID
                      %mi ν
                    %mo{:stretchy => "false"} |
                  %mo =
                  %msub
                    %mi ψ
                    %mi Ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ε
                    %mrow
                      %msub
                        %mi Ω
                        %mi ν
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\vert \mathrm{ID}_\nu \vert} = \psi_\Omega(\varepsilon_{\Omega_\nu+1})
          %p
            For any of these, we get the same proof-theoretic ordinal whether we use classical or intuitionistic logic. For the ID
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mo
                    %mi ν
                %annotation{:encoding => "application/x-tex"} _\nu
            \-systems, this is due to Sieg.
          %p
            The unfolding systems U(PA) and U(ID
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mo
                    %mn 1
                %annotation{:encoding => "application/x-tex"} _1
            ) are not exactly first-order arithmetic systems, but capture what we can get by predicative reasoning based on the natural numbers or one generalized inductive definition, respectively.
          %h3#systems_of_secondorder_arithmetic_soa Systems of second-order arithmetic (SOA)
          %ul
            %li Comprehension or choice principles.
            %li
              RCA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 0
                    %msup
                      %mo
                      %mo *
                  %annotation{:encoding => "application/x-tex"} _0^*
              is the second-order version of EFA:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
              is a function symbol.
            %li WKL is weak König’s lemma.
            %li BR is the bar induction rule.
            %li BI is the bar induction axiom.
            %li ATR is arithmetical transfinite recursion.
            %li
              (M) says every true
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Π
                      %mn 3
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Pi^1_3
              sentence with parameters holds in a
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "-CA." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mn 2
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta^1_2
          %p
            A zero subscript indicates that we have the induction axiom rather than the induction scheme, except for RCA
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo
                    %mn 0
                %annotation{:encoding => "application/x-tex"} _0
            which has the
            = succeed "-induction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mn 1
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Sigma^0_1
          %h3#kripke_platek_set_theories Kripke Platek Set theories
          %ul
            %li
              KP
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is Kripke-Platek set theory, whose universe is an admissible set containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %li KPl asserts that the universe is a limit of admissible sets
            %li KPi asserts that the universe is inaccessible sets
            %li KPh asserts that the universe is hyperinaccessible: an inaccessible set and a limit of inaccessible sets
            %li KPM asserts that the universe is a Mahlo set
          %p
            A superscript zero indidcates that
            = succeed "-induction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \in
          %p About the Mahlo level: this also corresponds to inductive-recursive definitions (Dybjer-Setzer).
          %h3#martinlf_type_theories Martin-Löf type theories
          %ul
            %li CPRC is the Herbelin-Patey Calculus of Primitive Recursive Constructions.
            %li
              ML
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mi n
                  %annotation{:encoding => "application/x-tex"} _n
              is type theory without W-types with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              universes.
            %li
              ML
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mrow
                        %mo &lt;
                        %mi ω
                  %annotation{:encoding => "application/x-tex"} _{\lt\omega}
              is type theory without W-types with an infinite hierarchy of universes.
            %li MLU is type theory with a next universe operator.
            %li MLS is type theory without W-types with a superuniverse.
            %li
              ML
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} _1
              V is type theory with one universe and Aczel’s type of iterative sets.
            %li
              ML
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} _1
              W is type theory with W-types and one universe.
            %li
              ML
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mrow
                        %mo &lt;
                        %mi ω
                  %annotation{:encoding => "application/x-tex"} _{\lt\omega}
              W is type theory with W-types and an infinite hierarchy of universes (this corresponds to the type theory in Lean’s HoTT mode).
            %li MLM is Martin-Löf type theory with a Mahlo universe.
          %h3#constructive_set_theories Constructive Set theories
          %ul
            %li CZF is Aczel’s constructive set theory.
            %li REA is the regular extension axiom.
            %li CZFM is CZF with a Mahlo universe
          %h3#explicit_mathematics_systems Explicit mathematics systems
          %ul
            %li
              EM
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} _0
              is basic
              %a.existingWikiWord{:href => "/nlab/show/explicit+mathematics"} explicit mathematics
              with elementary comprehension
            %li JR is the join rule, J is the join axioms
            %li
              T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} _0
              is EM
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} _0
              +J+IG, where IG is inductive generation
          %h2#references References
          %ul
            %li
              %p Aczel, The Type Theoretic Interpretation of Constructive Set Theory, Logic Colloquium 1977.
            %li
              %p
                Arai, A sneak preview of proof theory of ordinals,
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1102.0596"} arXiv 1102.0596
            %li
              %p
                Arai, Proof theory for theories of ordinals III:
                = succeed "-reflection," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi N
                      %annotation{:encoding => "application/x-tex"} \Pi_N
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1007.0844"} arXiv 1007.0844
            %li
              %p
                Arai, An ordinal analysis of
                = succeed "-Collection," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Pi_1
                %a{:href => "https://arxiv.org/abs/2112.09871"} arXiv 2112.09871
            %li
              %p Buchholz, A simplified version of local predicativity, Proc. Proof Theory Meeting Leed ‘90.
            %li
              %p Buchholz, A Note on the Ordinal Analysis of KPM (2002).
            %li
              %p Buchholz, Feferman, Pohlers and Sieg, Iterated inductive definitions and subsystems of analysis: recent proof-theoretical studies, Lecture Notes in Mathematics 897 (1981).
            %li
              %p Dybjer and Setzer, Induction-recursion and initial algebras, APAL 124(1-3), 2003, pp. 1-47. DOI: 10.1016/S0168-0072(02)00096-9
            %li
              %p Feferman: Iterated inductive fixed-point theories: Application to Hancock’s conjecture, in: G. Metakides (ed.): Patras Logic Symposium (North-Holland, Amsterdam, (1982), 171–196.
            %li
              %p Jäger, Kahle, Setzer, and Strahm, The proof-theoretic analysis of transfinitely iterated fixed point theories, Journal of Symbolic Logic
            %li
              %p Jäger and Strahm, Fixed point theories and dependent choice. Archive for Mathematical Logic.
            %li
              %p Rathjen, Ordinal notations based on a weakly Mahlo cardinal, Archive for Mathematical Logic 29 (1990), 249-263.
            %li
              %p Rathjen, Proof-theoretic analysis of KPM, Archive for Mathematical Logic (1991).
            %li
              %p Rathjen, The Recursively Mahlo Property in Second Order Arithmetic, Mathematical Logic Quarterly 42 (1996), 59-66.
            %li
              %p Rathjen, The strength of Martin-Löf type theory with a superuniverse. Part II, 2001, AML, DOI: 10.1007/s001530000051
            %li
              %p Rathjen, The strength of Martin-Löf type theory with a superuniverse. Part I, 2000, AML, DOI: 10.1007/s001530050001
            %li
              %p
                Rathjen, An ordinal analysis of parameter free
                = succeed "-comprehension." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Π
                          %mn 2
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Pi^1_2
            %li
              %p Rathjen, The constructive Hilbert program and the limits of Martin-Löf type theory (2005), Synthese, DOI: 10.1007/s11229-004-6208-4
            %li
              %p Rathjen, Griffor and Palmgren, Inaccessibility in Constructive Set Theory and Type Theory, APAL 94 (1998), 181-200.
            %li
              %p Setzer, An upper bound for the proof theoretical strength of Martin-Löf Type Theory with W-type and one universe (2006)
            %li
              %p
                Strahm, Autonomous fixed point progressions and fixed point transfinite recursion, Proc. of Logic Colloquium ‘98, 449-464,
                %a{:href => "http://www.iam.unibe.ch/ltgpub/2000/str00a.pdf"} web
