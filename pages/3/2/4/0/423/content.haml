          .num_example
            %h6#example_15 Example
            %p
              %strong (three-sheeted covers of the circle)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/The3SheetedCoveringsOfTheCircle.png", :width => "150"}/
            %p
              There are, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
              of the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            %p
              The one from example
              %a.maruku-ref{:href => "#kForlCovringOfCircle"}
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} k = 3
              %a.existingWikiWord{:href => "/nlab/show/permutation+actions"} permutation actions
              may be seen from the pictures on the right.
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
          %p
            We are now ready to state the main theorem about the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
          #SemiLocallySimplyConnected.num_defn
            %h6#definition_15 Definition
            %p
              %strong (semi-locally simply connected)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
            %ol
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/locally+path-connected"} locally path-connected
                  if for every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  and for every
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in U \subset X
                  there exists a neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi V
                        %mo ⊂
                        %mi U
                      %annotation{:encoding => "application/x-tex"} x \in V \subset U
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  is
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#pi0"}
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
                  if every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in U \subset X
                  such that the induced morphism of
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(U,x) \to \pi_1(X,x)
                  is trivial (i.e. sends everything to the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
          #FundamentalTheoremOfCoveringSpaces.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"}> fundamental theorem of covering spaces
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} path-connected
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#pi0"}
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path connected
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SemiLocallySimplyConnected"}
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SemiLocallySimplyConnected"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Cov
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fib_x \;\colon\; Cov(X) \overset{}{\longrightarrow} \pi_1(X,x) Set
                    \\,.
            %p
              from def.
              %a.maruku-ref{:href => "#ActionOfFundamentalGroupOnFibersOfCovering"}
              that describes the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              on the set of
              %a.existingWikiWord{:href => "/nlab/show/leaves"} leaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              has the following property:
            %ol
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  %a.existingWikiWord{:href => "/nlab/show/actions"} actions
                  is in the image of the functor (one says: the functor is
                  = succeed ");" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              %li
                %p
                  for any two covering spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                        %mo ,
                        %msub
                          %mi E
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} E_1, E_2
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  then the map on
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} morphism sets
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi x
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mrow
                            %mi Cov
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo ,
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Fib
                          %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi Fib
                          %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Fib_x \;\colon\; Hom_{Cov(X)}(E_1, E_2) \longrightarrow Hom( Fib_x(E_1), Fib_x(E_2) )
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  (one says the functor is a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                  ).
            %p
              A functor with these two properties one calls an
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cov
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cov(X) \overset{\simeq}{\longrightarrow} \pi_1(X,x) Set
                    \\,.
          %p This has some interesting implications:
          %p
            Every sufficiently nice topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as above has a covering which is
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#SimplyConnected"}
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#FundamentalTheoremOfCoveringSpaces"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X)
            on itself. This is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat X \to X
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            itself may be recovered as the
            %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            of the universal covering space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Aut
                    %mrow
                      %msub
                        %mi Cov
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1(X) \simeq Aut_{Cov_{/X}}(\hat X, \hat X)
                  \\,.
          #FundamentalGroupOfTheCircle.num_example
            %h6#example_16 Example
            %p
              %strong (computing the fundamental group of the circle)
            %p
              The covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \exp(2\pi i(-)) \;\colon\; \mathbb{R}^1 \to S^1
              from example
              %a.maruku-ref{:href => "#CoveringOfCircleByRealLine"}
              is
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SimplyConnected"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %p
              It is fairly straightforward to see that the only
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              to itself over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              are given by
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              translations by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                      %mo ↪
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N} \hookrightarrow \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %mi t
                                %mo ↦
                                %mi t
                                %mo +
                                %mi n
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %mi i
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %mi i
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^1
                    \&amp;&amp;
                    \\underoverset{\simeq}{t \mapsto t + n}{\longrightarrow}
                    \&amp;&amp;
                    \\mathbb{R}^1
                    \\\
                    \&amp; {}_{\mathllap{\exp(2 \pi i(-))}}\searrow &amp;&amp; \swarrow_{\mathrlap{\exp(2 \pi i(-))}}
                    \\\
                    \&amp;&amp; S^1
                    }
                    \\,.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mrow
                        %msub
                          %mi Cov
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{Cov_{/S^1}}(\hat S^1, \hat S^1) \simeq \mathbb{Z}
            %p
              and hence the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              is the additive group of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(S^1) \simeq \mathbb{Z}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %hr/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
