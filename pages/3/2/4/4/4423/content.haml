                    \&amp; \phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = c_2(\nabla) }{
                    \\underbrace{
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) - \big( tr(F_\nabla) \big)^2  }
                    { 8 \pi^2  }
                    }}
                    \\\
                    \&amp; \phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = c_3(\nabla) }{
                    \\underbrace{
                    i
                    \\frac
                    {
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^3  \big)
                    + 3
                    \\cdot
                    tr(F_\nabla)
                    \\cdot
                    tr\big( (F_\nabla)^2 \big)
                    \-
                    \\big( tr(F_\nabla ) \big)^3
                    }
                    {48 \pi^3}
                    }}
                    \\\
                    \&amp; \phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = c_4(\nabla) }{
                    \\underbrace{
                    \\frac
                    {
                    \-6
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    + 3
                    \\cdot
                    tr\big(  (F_\nabla)^2 \big)^2
                    +
                    \\big( tr(F_\nabla) \big)^4
                    }
                    {384 \pi^4}
                    }}
                    \\\
                    \&amp; \phantom{\;=\;}
                    + \cdots
                    \\end{aligned}
            %h5#pontrjagin_forms Pontrjagin forms
            %p
              Setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} tr(F_\nabla) = 0
              in these expressions
              %a.maruku-eqref{:href => "#eq:ExplicitUnwindingOfTotalChernForm"} (5)
              yields the
              %em
                %a.existingWikiWord{:href => "/nlab/show/total+Pontrjagin+form"} total Pontrjagin form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(\nabla)
              with degree=
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 4
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 4k
              \-components the
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+forms"} Pontrjagin forms
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_{k}(\nabla)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo ∈
                                %mi ℕ
                            %munder
                              %munder
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mi k
                                  %msub
                                    %mi p
                                    %mi k
                                  %mo{:stretchy => "false"} (
                                  %mo ∇
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mi deg
                                %mo =
                                %mn 4
                                %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo ∈
                                %mi ℕ
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi c
                                    %mrow
                                      %mn 2
                                      %mi k
                                  %mo{:stretchy => "false"} (
                                  %mo ∇
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mi deg
                                %mo =
                                %mn 4
                                %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mphantom
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo =
                                %mspace{:width => "thickmathspace"}
                            %mo +
                            %munder
                              %munder
                                %mfrac
                                  %mrow
                                    %mo{:lspace => "0em", :rspace => "thinmathspace"} tr
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi F
                                      %mo ∇
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mn 2
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mrow
                                    %mn 8
                                    %msup
                                      %mi π
                                      %mn 2
                                %mo ⏟
                              %mstyle{:mathcolor => "blue"}
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mi p
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mo ∇
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mphantom
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo =
                                %mspace{:width => "thickmathspace"}
                            %mo +
                            %munder
                              %munder
                                %mfrac
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 2
                                    %mo ⋅
                                    %mi tr
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi F
                                      %mo ∇
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mn 4
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                    %mo +
                                    %mi tr
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi F
                                      %mo ∇
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mn 2
                                    %msup
                                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                      %mn 2
                                  %mrow
                                    %mn 128
                                    %msup
                                      %mi π
                                      %mn 4
                                %mo ⏟
                              %mstyle{:mathcolor => "blue"}
                                %mo =
                                %msub
                                  %mi p
                                  %mn 2
                                %mo{:stretchy => "false"} (
                                %mo ∇
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mphantom
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo =
                                %mspace{:width => "thickmathspace"}
                            %mo +
                            %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p(\nabla)
                    \&amp;
                    \\;\coloneqq\;
                    \\underset{k \in \mathbb{N}}{\sum}
                    \\underset{
                    deg = 4k
                    }{
                    \\underbrace{
                    (-1)^{k}
                    p_{k}(\nabla)
                    }
                    }
                    \\\
                    \&amp; \;=\;
                    \\underset{k \in \mathbb{N}}{\sum}
                    \\underset{
                    deg = 4k
                    }{
                    \\underbrace{
                    c_{2k}(\nabla)
                    }
                    }
                    \\\
                    \&amp; \;=\;
                    1
                    \\\
                    \&amp;
                    \\phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = - p_1(\nabla) }{
                    \\underbrace{
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    }}
                    \\\
                    \&amp;
                    \\phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = p_2(\nabla) }{
                    \\underbrace{
                    \\frac
                    {
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    +
                    tr\big(  (F_\nabla)^2 \big)^2
                    }
                    {128 \pi^4}
                    }}
                    \\\
                    \\phantom{\;=\;}
                    +
                    \\cdots
                    \\end{aligned}
            %p
              Hence the first couple of
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+forms"} Pontrjagin forms
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mfrac
                              %mrow
                                %mo{:lspace => "0em", :rspace => "thinmathspace"} tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 8
                                %msup
                                  %mi π
                                  %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %msup
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mn 2
                                %mo −
                                %mn 2
                                %mo ⋅
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 4
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 128
                                %msup
                                  %mi π
                                  %mn 4
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_1(\nabla)
                    \&amp;
                    \\;=\;
                    \-
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    \\\
                    p_2(\nabla)
                    \&amp; \;=\;
                    \\frac
                    {
                    tr\big(  (F_\nabla)^2 \big)^2
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    }
                    {128 \pi^4}
                    \\,.
                    \\end{aligned}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.5
            %h5#euler_forms Euler forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              and with the
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              again regarded as a 2-form valued
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2k) \times (2k)
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mo ≤
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    F_{\nabla}
                    \\;=\;
                    \\big(
                    (F_{\nabla})^a{}_b
                    \\big)_{1 \leq a,b, \leq 2k}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
              is its
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
              of this matrix, hence the following
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(2k)
              with summands signed by the the
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mo ±
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} sgn(\sigma) \in \{\pm 1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                        %mo ⋅
                        %mi k
                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi σ
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{2k}(\nabla)
                    \\;=\;
                    \\frac
                    {(-1)^k}
                    { (4 \pi)^k \cdot k! }
                    \\underset{\sigma}{\sum}
                    sgn(\sigma)
                    \\cdot
                    (F_{\nabla})_{\sigma(1)\sigma(2)}
                    \\wedge
                    (F_{\nabla})_{\sigma(3)\sigma(4)}
                    \\wedge
                    \\cdots
                    \\wedge
                    (F_{\nabla})_{\sigma(2k-1)\sigma(2k)}
                    \\,.
            %p
              The first of these is, using the
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              and the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi ϵ
                          %mrow
                            %mi a
                            %mi b
                            %mi c
                            %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi a
                            %mi b
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi c
                            %mi d
                      %mrow
                        %mn 32
                        %msup
                          %mi π
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_4(\nabla)
                    \\;=\;
                    \\frac
                    { \epsilon^{ a b c d} (F_{\nabla})_{a b} \wedge (F_\nabla)_{c d}  }
                    {32 \pi^2}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.7
