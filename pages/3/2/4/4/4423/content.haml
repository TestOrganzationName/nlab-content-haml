          %h2#idea Idea
          %p
            A
            %em curvature characteristic form
            is a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            naturally associated to a
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of the 1-form.
          %p
            More generally, there is a notion of curvature characteristic forms of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E-algebra"} L-∞-algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
          %h2#definition Definition
          %h3#of_connection_1forms Of connection 1-forms
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-, \cdots, -\rangle
            an
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            arguments on the Lie algebra and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            a Lie-algebra-valued 1-form with
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_A = d_{dR} A + [A \wedge A]
            %strong curvature characteristic form
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi ⋯
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle \cdots \rangle
            is the
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \wedge \cdots \wedge F_A \rangle \in \Omega^{2 n}(P)
                  \\,.
          %p
            This form is always an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exact+form"} exact form
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2 n -1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
          %p
            Notably if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            with
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the total space of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi : P \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            is an
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
            1-form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            then by the very definition of the
            = succeed "-equivariance" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the
            %em invariance
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi ⋯
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle \cdots \rangle
            it follows that the curvature form is invariant under the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and is therefore the pullback along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            of a
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2 n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_n \in \Omega^{2 n}(X)
            down on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/closed+form"} closed form
            and hence represent a class in the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/Weil+homomorphism"} Weil homomorphism
            from invariant polynomials to de Rham cohomology
          %h3#in_terms_of_lie_algebroids
            In terms of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The above description of curvature characteristic forms may be formulated in terms of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+theory"} ∞-Lie theory
            as follows.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            write
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} T P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi vert
                  %mi P
                %annotation{:encoding => "application/x-tex"} T_{vert} P
            for the
            %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and the
            %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+Lie+algebroid"} vertical tangent Lie algebroid
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inn
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} inn(\mathfrak{g})
            for the
            %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
            given by the
            %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mover
                    %mo →
                    %mi Id
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}\stackrel{Id}{\to} \mathfrak{g}
            and finally
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msup
                    %mi b
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \prod_i b^{n_i} \mathbb{R}
            for the
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E-algebra"} L-∞-algebra
            with one abelian generator for each generating
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            From the discussion at
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            we have a canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inn
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msup
                    %mi b
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} inn(\mathfrak{g}) \to \prod_i b^{n_i}\mathbb{R}
            that represents the generating invariant polynomials.
          %p
            Recall that a morphism of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                  %mo →
                  %msup
                    %mi b
                    %mi n
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  T X \to b^n \mathbb{R}
          %p
            is equivalently a closed
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            then induces the following diagram of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi T
                            %mi vert
                          %mi P
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi A
                                %mi vert
                        %mtd
                          %mi 𝔤
                        %mtd
                        %mtd
                        %mtd
                          %mi flat
                          %mi vertical
                          %mi form
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                          %mi first
                          %mi Ehresmann
                          %mi condition
                      %mtr
                        %mtd
                          %mi T
                          %mi P
                        %mtd
                          %mover
                            %mo →
                            %mi A
                        %mtd
