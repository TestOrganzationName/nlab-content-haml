            %p Here
            %ul
              %li
                %p
                  the first step uses the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
              %li
                %p
                  the second step is Prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#SmoothShapeModelityGivenBySmoothPathInfinityGroupoid"}
              %li
                %p
                  the third step uses that with
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %mi SmoothManifolds
                        %annotation{:encoding => "application/x-tex"} X \in SmoothManifolds
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi smth
                          %mi n
                        %mo ∈
                        %mi CartesianSpaces
                        %mo ↪
                        %mi SmoothManifolds
                      %annotation{:encoding => "application/x-tex"} \Delta^n_{smth} \in CartesianSpaces \hookrightarrow SmoothManifolds
                  by Def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#SmoothExtendedSimplices"}
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %msubsup
                          %mi Δ
                          %mi smth
                          %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi SmoothManifolds
                        %mover
                          %mo ↪
                          %mi y
                        %msub
                          %mi PSh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi SmoothManifolds
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \times \Delta^n_{smth} \,\in\, SmoothManifolds \xhookrightarrow{y} PSh_\infty(SmoothManifolds)
                  is still
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"} compute the colimit of presheaves objectwise
              %li
                %p
                  the fourth just makes explicit the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  in order to make manifest another appeal to the
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
                  in the fifth and sixth step;
              %li
                %p
                  the last step applies again Prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#SmoothShapeModelityGivenBySmoothPathInfinityGroupoid"}
            %p
              Since the composite of these equivalences is still
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.maruku-eqref{:href => "#eq:SmoothOkaPrincipleEquivalence"} (7)
              follows by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
          %h3#ClassificationOfPrincipalInfinityBundles
            Classification of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
          #ClassifyingSpaceAsShapeOfDelooping.num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Groups
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi SmoothGroupoids
                      %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Groups(SmoothGroupoids_\infty)
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ʃ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ʃ
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    B \mathcal{G}
                    \\;\;
                    \\coloneqq
                    \\;\;
                    \&amp;#643;
                    \\mathbf{B}
                    \\mathcal{G}
                    \\;\;
                    \\simeq
                    \\mathbf{B}
                    \&amp;#643;
                    \\mathcal{G}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
              of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
              preserves the simplicial
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              and the
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              involved in defining the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              as the realization of the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}\mathcal{G}
          %p
          .num_remark
            %h6 Remark
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \in \mathbf{H}
              of an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %mi Groups
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Groups(\mathbf{H})
              is the
              %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
              = succeed ")" do
                %a.existingWikiWord{:href => "/schreiber/show/Principal+infinity-bundles"} NSS 12
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            #eq:ModulationOfPrincipalInfinityBundles.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %msub
                      %mi PrinBund
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Groupoids
                      %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}PrinBund_X
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathbf{H}(X,\mathbf{B}\mathcal{G})
                    \\;\;\;
                    \\in
                    \\;
                    Groupoids_\infty
                    \\,.
            %p
              In particular, upon
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} 0-truncation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \tau_0
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G}
              classifies
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒢
                    %msub
                      %mi PrinBund
                      %mi X
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo ∼
                          %mi equ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Sets
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(\mathcal{G}PrinBund_X\big)_{/\sim_{equ}}
                    \\;\;
                    \\simeq
                    \\;\;
                    \\tau_0\, \mathbf{H}(X,\mathbf{B}\mathcal{G})
                    \\;\;\;
                    \\in
                    \\;
                    Sets
                    \\,.
            %p
              But for this reduced information much less than the full
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              may be necessary: A
              %em
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
              is a
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Groupoids
                        %mn ∞
                      %mover
                        %mo ↪
                        %mi Disc
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} Groupoids_\infty \xhookrightarrow{Disc} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of maps into it still correspond to
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+spaces"} paracompact topological spaces
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          %p
            Slightly coarser than plain equivalence classes of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/concordance+classes"} concordance classes
            of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "):" do
              %a{:href => "#nonabelian+cohomology#RobertsStevenson16"} Roberts-Stevenson 16, Cor. 15
          %p
          #ConcordanceClassesOfPrincipalInfinityBundles.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/concordance+classes"} concordance classes
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %mi Groups
                    %mo{:stretchy => "false"} (
                    %mi SmoothGroupoids
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Groups(SmoothGroupoids)_\infty
              and any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msub
                        %mi SMoothGroupoids
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} X \in SMoothGroupoids_\infty
              %br/
              we say that a
              %em
                %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
              between two
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                    %mo ,
                    %msub
                      %mi P
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %mi PrinBund
                    %mo{:stretchy => "false"} (
                    %mi SmoothGroupoids
                    %mo{:stretchy => "false"} |
                    %mi infty
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    P_0, P_1 \;\in\; \mathcal{G}PrinBund(SmoothGroupoids|infty)_X
            %p
              is a principal
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %msub
                      %mi PrinBund
                      %mrow
                        %mi X
                        %mo ×
                        %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat P \;\in\; \mathcal{G}PrinBund_{X \times \mathbb{R}}
            %p
              whose restriction to the points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0,1 \,\in\, \mathbb{R}
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalent
              to the given pair of bundles:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi P
                        %mo ^
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo ×
