                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [X, &amp;#643;A](U)
                    \&amp;
                    \\;\simeq\;
                    Sh_\infty(SmthMfds)
                    \\big(
                    X \times U, &amp;#643;A
                    \\big)
                    \\\
                    \&amp; \;\simeq\;
                    PSh_\infty(SmthMfds)
                    \\Big(
                    X \times U,
                    \\,
                    \\big(
                    U'
                    \\,\mapsto\,
                    \\underset{\underset{[n] \in \Delta^{\mathrm{op}}}{\longrightarrow}}{\mathrm{lim}}
                    A(U' \times \Delta^n_{\mathrm{smth}})
                    \\big)
                    \\Big)
                    \\\
                    \&amp; \;\simeq\;
                    \\underset{\underset{[n] \in \Delta^{\mathrm{op}}}{\longrightarrow}}{\mathrm{lim}}
                    PSh_\infty(SmthMfds)
                    \\Big(
                    X \times U,
                    \\,
                    \\big(
                    U'
                    \\,\mapsto\,
