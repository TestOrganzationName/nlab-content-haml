          %h1#nuclear_adjunctions Nuclear adjunctions
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#construction_of_nuclear_adjunction"} Construction of nuclear adjunction
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            A
            %strong nuclear adjunction
            or
            %strong bimonadic adjunction
            is an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            that is both
            %a.existingWikiWord{:href => "/nlab/show/monadic+adjunction"} monadic
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comonadic+adjunction"} comonadic
          %p
            One point in favour of the terminology “nuclear” over “bimonadic” is that the term
            %strong bimonadic functor
            is sometimes used in the literature for a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            that is both
            %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comonadic+functor"} comonadic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bimonads"} bimonads
          %h2#properties Properties
          %ul
            %li
              %p
                Consider an adjunction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ⊣
                        %mi G
                      %annotation{:encoding => "application/x-tex"} F \dashv G
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                and a
                %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                = succeed "-algebras," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "-coalgebras," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %a{:href => "#PavlovicHughes20"} Pavlovic–Hughes
                and below.
            %li
              %p
                Consider an adjunction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ⊣
                        %mi G
                        %mo :
                        %mi B
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} F \dashv G : B \to A
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                and a
                %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete"} Cauchy complete
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is
                %a.existingWikiWord{:href => "/nlab/show/comonadic"} comonadic
                if and only if the free–forgetful adjunction associated to the
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg%E2%80%93Moore+category"} Eilenberg–Moore category
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is nuclear. See
                = succeed "." do
                  %a{:href => "#Mesablishvili06"} Mesablishvili
          %h2#construction_of_nuclear_adjunction Construction of nuclear adjunction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo ⊣
                  %mi r
                %annotation{:encoding => "application/x-tex"} \ell \dashv r
            be an adjunction, inducing a monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg%E2%80%93Moore+category"} Eilenberg–Moore category
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                    %mo ⊣
                    %msub
                      %mi u
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} f_{T_1} \dashv u_{T_1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 2
                %annotation{:encoding => "application/x-tex"} D_2
            on the Eilenberg–Moore category. One can form the Eilenberg–Moore category of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} D_2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mrow
                        %msub
                          %mi D
                          %mn 2
                    %mo ⊣
                    %msub
                      %mi c
                      %mrow
                        %msub
                          %mi D
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} u_{D_2} \dashv c_{D_2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 3
                %annotation{:encoding => "application/x-tex"} T_3
            on the Eilenberg–Moore of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} D_2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                    %mo ,
                    %msub
                      %mi D
                      %mn 2
                    %mo ,
                    %msub
                      %mi T
                      %mn 3
                    %mo ,
                    %msub
                      %mi D
                      %mn 4
                    %mo ,
                    %msub
                      %mi T
                      %mn 5
                    %mo ,
                    %mi …
                  %annotation{:encoding => "application/x-tex"} T_1, D_2, T_3, D_4, T_5, \dots
          %p
