              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E11"} E11
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} \cdots
          %h2#properties Properties
          %h3#RepresentationsOfMaximalCompactSubalgebra Representations of maximal compact subalgebra
          %p
            In contrast to the full
            %a.existingWikiWord{:href => "/nlab/show/affine+Lie+algebra"} affine Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔢
                      %mrow
                        %mn 9
                        %mo{:stretchy => "false"} (
                        %mn 9
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{e}_{9(9)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔨
                    %mrow
                      %mn 9
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi Lie
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mrow
                      %mn 9
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{k}_{9(9)} \,\coloneqq\, Lie\big(K(E_{9(9)})\big)
            has non-
            %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            \&amp;lbrack;
            %a{:href => "#NicolaiSamtleben05"}> Nicolai &amp; Samtleben 2005
            ,
            = succeed "&rbrack;." do
              %a{:href => "#KKLN22"} KKLN22
          %p
            Specifically, under the
            %a.existingWikiWord{:href => "/nlab/show/restricted+representation"} restriction
            (“
            %a.existingWikiWord{:href => "/nlab/show/branching+rule"}> branching
            ”) of the basic representation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔢
                    %mrow
                      %mn 9
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{e}_{9(9)}
            along the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔨
                    %mrow
                      %mn 9
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi 𝔢
                    %mrow
                      %mn 9
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{k}_{9(9)} \hookrightarrow \mathfrak{e}_{9(9)}
            the first (namely:
            = succeed ")" do
              %em parabolic level zero
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
            %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} summand
            has
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+vector+space"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mi rk
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔢
                          %mn 8
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 256
                  %annotation{:encoding => "application/x-tex"} 2^{rk(\mathfrak{e}_8)} = 256
            = succeed "&rbrack;." do
              %a{:href => "#König24"} König 2024, top of p 38 and pp 41-42
          %h3#as_uduality_group_of_2d_supergravity As U-duality group of 2d supergravity
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
