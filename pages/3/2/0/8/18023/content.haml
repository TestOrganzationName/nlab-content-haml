          #RationalStableDoldKanCorrespondence.num_theorem
            %h6#theorem Theorem
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalized
                  %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} H \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/module+spectra"} module spectra
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28infinity%2C1%29-categories"} equivalent
              to that of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              over the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            .maruku-equation
