            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathrm{dgcAlg}^\bullet_k
              for the category of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} Ch
                        %mi k
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ch}^\bullet_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\mathrm{dgcAlg}^\bullet_k)_{/k[0]}
              for its
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi d
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi{:mathvariant => "normal"} dgcAlg
                        %mrow
                          %mo ≥
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} k = (k[0], d = 0) \in \mathrm{dgcAlg}^{\geq 0}
              %a.existingWikiWord{:href => "/nlab/show/augmented+algebra"} augmented
              dgc-algebras, hence for dgc-algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              equipped with a homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mi A
                      %mo :
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi d
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon_A : A \to (k[0], d = 0)
            %p Finally we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ↪
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{dgcAlg}^{\geq 0}_k
                    \\hookrightarrow
                    \\mathrm{dgcAlg}^\bullet_k
            %p
              for the full subcategory of the dgc-algebras in non-negative degree, hence for the commutative monoids in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi{:mathvariant => "normal"} Ch
                        %mrow
                          %mo ≥
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ch}^{\geq 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathrm{dgcAlg}^{\geq 0}_k)_{/k[0]}
                    \\hookrightarrow
                    (\mathrm{dgcAlg}^{\bullet}_k)_{/k[0]}
                    \\,.
          #dgcAlgChAdjunction.num_prop
            %h6#proposition_3 Proposition
            %p
              There are
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              between the categories from def.
              %a.maruku-ref{:href => "#dgcalgebras"}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mi{:mathvariant => "normal"} Sym
                    %msubsup
                      %mi{:mathvariant => "normal"} Ch
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{dgcAlg}^{\geq 0}_k
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{\mathrm{Sym}}{\longleftarrow}}
                    {\bot}
                    \\mathrm{Ch}^{\geq 0}_k
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} dgcAlg
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi U
                          %mo ∘
                          %mi{:mathvariant => "normal"} ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ϵ
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} Sym
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi k
                              %mo{:stretchy => "false"} [
                              %mn 0
                              %mo{:stretchy => "false"} ]
                    %msubsup
                      %mi{:mathvariant => "normal"} Ch
                      %mi k
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    (\mathrm{dgcAlg}^{\geq 0}_k)_{/k[0]}
                    \\underoverset
                    {\underset{U \circ \mathrm{ker}(\epsilon_{(-)})}{\longrightarrow} }
                    {\overset{\mathrm{Sym}_{/k[0]}}{\longleftarrow}}
                    {\bot}
                    \\mathrm{Ch}^{\geq 0}_k
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  forms the underlying chain complex;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} ker
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϵ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{ker}(\epsilon_{(-)})
                  forms the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/augmentation+ideal"} augmentation ideal
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Sym
                      %annotation{:encoding => "application/x-tex"} \mathrm{Sym}
                  forms the free graded-commutative dg-algebra;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} Sym
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi k
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathrm{Sym}_{/k[0]}
                  forms the free graded-commutative dg-algebra and regards it with its canonical augmentation over
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              Moreover, these are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+chain+complexes"} projective model structure on chain complexes
              and the
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+dgc-algebras"} projective model structure on dgc-algebras
              and the second with respect to the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
