              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              of spectra is the
              %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi H
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} (-)\wedge H \mathbb{Q}
              (
              %a{:href => "rationalization#RationalizationOfSpectra"}> here
              ) every rational spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
