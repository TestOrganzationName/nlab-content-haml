            %p
              Again take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{V}
              to be the category of supervector spaces. Since the left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                    %mo →
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp: \mathbf{V} \to CMon(\mathbf{V})
              preserves
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              and since the tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{V}
              provides the coproduct for commutative monoid objects, we have a natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⊕
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \exp(V \oplus W) \cong \exp(V) \otimes \exp(W).
            %p
              Examining the grade
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              component
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ⊕
                      %mi W
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \exp(V \oplus W)_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⊕
                    %mi W
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi j
                        %mo +
                        %mi k
                        %mo =
                        %mi n
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi j
                    %mo ⊗
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi W
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \exp(V \oplus W)_n = \sum_{j + k = n} \exp(V)_j \otimes \exp(W)_k.
            %p
              and now the result follows by considering the case where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ,
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V, W
              are concentrated in odd degree.
          .num_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^j(V)
              has dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mi n
                          %mi j
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \binom{n}{j}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^n(V)
              is 1-dimensional.
          .proof
            %h6#proof_2 Proof
            %p
              By induction on dimension. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \dim(V) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^0(V)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^1(V)
              are
              = succeed "-dimensional," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Lambda^n(V) = 0
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi char
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} char(k) \neq 2
            %p We then infer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Λ
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ⊕
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≅
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo =
                                %mi j
                            %msup
                              %mi Λ
                              %mi p
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mi Λ
                              %mi q
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≅
                          %mtd
                            %msup
                              %mi Λ
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo ⊕
                            %msup
                              %mi Λ
                              %mrow
                                %mi j
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda^j(V \oplus k) &amp; \cong &amp; \sum_{p + q = j} \Lambda^p(V) \otimes \Lambda^q(k) \\
                    \&amp; \cong &amp; \Lambda^j(V) \oplus \Lambda^{j-1}(V)
                    }
            %p
              where the dimensions satisfy the same recurrence relation as for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/binomial+coefficients"} binomial coefficients
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                          %mi j
                        %mo )
                      %mo =
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mi n
                          %mi j
                        %mo )
                      %mo +
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mi n
                          %mrow
                            %mi j
                            %mo −
                            %mn 1
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \binom{n+1}{j} = \binom{n}{j} + \binom{n}{j-1}
          %p
            More concretely: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi e
                    %mi n
                %annotation{:encoding => "application/x-tex"} e_1, \ldots, e_n
            is a basis for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi j
                %annotation{:encoding => "application/x-tex"} e_{n_1} \otimes \ldots \otimes e_{n_j}
            form a
            %a.existingWikiWord{:href => "/nlab/show/basis+of+a+vector+space"} basis
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mo ⊗
                        %mi j
                  %annotation{:encoding => "application/x-tex"} V^{\otimes j}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi j
                %annotation{:encoding => "application/x-tex"} e_{n_1} \wedge \ldots \wedge e_{n_j}
            denote the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of this element under the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mo ⊗
                        %mi j
                    %mo →
                    %msup
                      %mi Λ
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V^{\otimes j} \to \Lambda^j(V)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi j
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi n
                        %mi j
                %annotation{:encoding => "application/x-tex"} e_{n_1} \wedge \ldots \wedge e_{n_i} \wedge e_{n_{i+1}} \wedge \ldots \wedge e_{n_j} = -e_{n_1} \wedge \ldots \wedge e_{n_{i+1}} \wedge e_{n_i} \wedge \ldots \wedge e_{n_j}
          %p
            (consider the transposition in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi j
                %annotation{:encoding => "application/x-tex"} S_j
            which swaps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i+1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mn 1
                  %mo &lt;
                  %mi …
                  %mo &lt;
                  %msub
                    %mi n
                    %mi j
                %annotation{:encoding => "application/x-tex"} n_1 \lt \ldots \lt n_j
            as forming a spanning set for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda^j(V)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mi n
                        %mi j
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \binom{n}{j}
          .num_remark
            %h6#remark Remark
            %p
              In the case where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi char
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} char(k) = 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %mi …
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi n
                          %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} e_{n_1} \wedge \ldots \wedge e_{n_j} = 0
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi i
                    %mo =
                    %msub
                      %mi n
                      %mrow
                        %mi i
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} n_i = n_{i'}
              for some pair of distinct indices
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} i'
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} f \colon V \to V
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Λ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Λ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Lambda^n(f) \colon \Lambda^n(V) \to \Lambda^n(V),
          %p
            being an
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            on a 1-dimensional space, is given by multiplying by a scalar
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} D(f) \in k
            %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Lambda^n
            is, i.e.,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(f g) = D(f) D(g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(f)
            is called the
            %strong determinant
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h3#determinant_of_a_matrix Determinant of a matrix
          %p
            We see then that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:lspace => "verythinmathspace"} :
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} \det \colon End(V) \to k
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of multiplicative
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mi A
                  %msup
                    %mi U
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \det(U A U^{-1}) = \det(A)
          %p
            for each
            %a.existingWikiWord{:href => "/nlab/show/inverse"} invertible
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \in GL(V)
          %p
            If we choose a
            %a.existingWikiWord{:href => "/nlab/show/basis+of+a+vector+space"} basis
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            so that we have an identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi Mat
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(V) \cong Mat_n(k)
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Mat
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} \det \colon Mat_n(k) \to k
          %p or by restriction to invertible matrices with invertible determinants a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi k
                    %mo *
                %annotation{:encoding => "application/x-tex"} \det\colon GL_n(k) \to k^*
          %p
            that takes products of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            to products in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and its transform
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi A
                  %msup
                    %mi U
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} U A U^{-1}
            have the same determinant. The above map is furthermore natural in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi GL
                    %mi n
                  %mo →
                  %msup
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo *
                %annotation{:encoding => "application/x-tex"} det\colon GL_n\rightarrow -^*
            from the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            to the
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            of a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            (or more generally a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %a.existingWikiWord{:href => "/nlab/show/Field"} Field
            (or more generally
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Ring"} Ring
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
          %p By following the definitions above, we can give an explicit formula:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %msub
                        %mi S
                        %mi n
                  %mi sgn
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  \\det(A)
                  \\;=\;
                  \\sum_{\sigma \in S_n} sgn(\sigma) \prod_{i = 1}^n a_{i \sigma(i)}
                  \\;
          %p
            This may equivalently be written using the
            %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            and the
            %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            as
          #eq:DeterminantInTermsOfLCSymbol.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi a
                    %mrow
                      %mn 1
                      %msub
                        %mi j
                        %mn 1
                  %msub
                    %mi a
                    %mrow
                      %mn 2
                      %msub
                        %mi j
                        %mn 2
                  %mi ⋯
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %msub
                        %mi j
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ϵ
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                      %msub
                        %mi j
                        %mn 2
                      %mi ⋯
                      %msub
                        %mi j
                        %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\det(A)
                  \\;=\;
                  a_{1 j_1}
                  a_{2 j_2}
                  \\cdots
                  a_{n j_n}
                  \\,
                  \\epsilon^{j_1 j_2 \cdots j_n}
          %p which in turn may be re-written more symmetrically as
          #eq:DeterminantInTermsOfLCSymbols.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mn 1
                    %mrow
                      %mi n
                      %mo !
                  %msup
                    %mi ϵ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %msub
                        %mi i
                        %mn 2
                      %mi ⋯
                      %msub
                        %mi i
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %msub
                        %mi j
                        %mn 1
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi i
                        %mn 2
                      %msub
                        %mi j
                        %mn 2
                  %mi ⋯
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi i
                        %mi n
                      %msub
                        %mi j
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ϵ
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                      %msub
                        %mi j
                        %mn 2
                      %mi ⋯
                      %msub
                        %mi j
                        %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\det(A)
                  \\;=\;
                  \\frac{1}{n!}
                  \\epsilon^{ i_1 i_2 \cdots i_n }
                  \\,
                  a_{i_1 j_1}
                  a_{i_2 j_2}
                  \\cdots
                  a_{i_n j_n}
                  \\,
                  \\epsilon^{j_1 j_2 \cdots j_n}
          %h2#properties Properties
          %p
            We work over
            %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            of arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a row of column
            %a.existingWikiWord{:href => "/nlab/show/vectors"} vectors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_1, \ldots, v_n)
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                    %annotation{:encoding => "application/x-tex"} \det
                is separately linear in each column vector:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi a
                      %mi v
                      %mo +
                      %mi b
                      %mi w
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi v
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi b
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi w
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \det(v_1, \ldots, a v + b w, \ldots, v_n) = a\det(v_1, \ldots, v, \ldots, v_n) + b\det(v_1, \ldots, w, \ldots, v_n)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \det(v_1, \ldots, v_n) = 0
                whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                      %mo =
                      %msub
                        %mi v
                        %mi j
                    %annotation{:encoding => "application/x-tex"} v_i = v_j
                for distinct
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                      %annotation{:encoding => "application/x-tex"} i, j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \det(I) = 1
                , where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is the identity matrix.
          %p Other properties may be worked out, starting from the explicit formula or otherwise:
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a diagonal matrix, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \det(A)
                is the product of its diagonal entries.
            %li
              %p
                More generally, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is an upper (or lower) triangular matrix, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \det(A)
                is the product of the diagonal entries.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi k
                    %annotation{:encoding => "application/x-tex"} E/k
                is a
                %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a
                = succeed "-linear" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V \to V
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi det
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi det
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msub
                          %mo ⊗
                          %mi k
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \det(f) = \det(E \otimes_k f)
                %span.newWikiWord
                  Jordan normal form
                  %a{:href => "/nlab/new/Jordan+normal+form"} ?
                of a matrix, this means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \det(f)
                is the product of its
                %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
                (counted with multiplicity), as computed in the
                %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi t
                    %annotation{:encoding => "application/x-tex"} A^t
                is the transpose of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi det
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi A
                          %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi det
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \det(A^t) = \det(A)
          %h3#cramers_rule Cramer’s rule
          %p A simple observation which flows from these basic properties is
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (Cramer’s Rule)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_1, \ldots, v_n
              be column vectors of dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi a
                      %mi j
                    %msub
                      %mi v
                      %mi j
                    %mo .
                  %annotation{:encoding => "application/x-tex"} w = \sum_j a_j v_j.
            %p
              Then for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi j
                    %mi det
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi det
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi w
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a_j \det(v_1, \ldots, v_i, \ldots, v_n) = \det(v_1, \ldots, w, \ldots, v_n)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              occurs as the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mi th
                  %annotation{:encoding => "application/x-tex"} i^{th}
              column vector on the right.
          .proof
            %h6#proof_3 Proof
            %p This follows straightforwardly from properties 1 and 2 above.
          %p
            For instance, given a square matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \det(A) \neq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = (v_1, \ldots, v_n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in an equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋅
                  %mi a
                  %mo =
                  %mi w
                %annotation{:encoding => "application/x-tex"} A \cdot a = w
          %p
            and we easily conclude that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is invertible if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \det(A) \neq 0
          .num_remark
            %h6#remark_2 Remark
            %p
              This holds true even if we replace the field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              by an arbitrary commutative
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \det(A) \neq 0
              by the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \det(A)
              is a unit. (The entire development given above goes through,
              = succeed ".)" do
                %em mutatis mutandis
          %h3#characteristic_polynomial_and_cayleyhamilton_theorem Characteristic polynomial and Cayley-Hamilton theorem
          %p
            Given a linear endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} f: M\to M
            of a finite rank free unital module over a commutative unital ring, one can consider the zeros of the
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomial"} characteristic polynomial
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ⋅
                    %msub
                      %mn 1
                      %mi V
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \det(t \cdot 1_V - f)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cayley-Hamilton+theorem"} Cayley-Hamilton theorem
          %h3#over_the_real_numbers_volume_and_orientation Over the real numbers: volume and orientation
          %p
            A useful intuition to have for determinants of
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            matrices is that they measure
            = succeed "." do
              %em change of volume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            matrix with real entries will map a standard unit cube in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            to a parallelpiped in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            (quashed to lie in a hyperplane if the matrix is singular), and the determinant is, up to sign, the volume of the parallelpiped. It is easy to convince oneself of this in the planar case by a simple dissection of a parallelogram, rearranging the dissected pieces in the style of Euclid to form a rectangle. In algebraic terms, the dissection and rearrangement amount to applying shearing or
            %a.existingWikiWord{:href => "/nlab/show/elementary+column+operations"} elementary column operations
            to the matrix which, by the properties discussed earlier, leave the determinant unchanged. These operations transform the matrix into a diagonal matrix whose determinant is the area of the corresponding rectangle. This procedure easily generalizes to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            dimensions.
          %p
            The sign itself is a matter of interest. An invertible transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} f \colon V \to V
            is said to be
            %strong
              %a.existingWikiWord{:href => "/nlab/show/orientation"}> orientation
              \-preserving
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \det(f)
            is positive, and
            %strong orientation-reversing
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \det(f)
            is negative. Orientations play an important role throughout geometry and algebraic topology, for example in the study of orientable manifolds (where the tangent bundle as
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_+(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_+(n) \hookrightarrow GL(n)
            being the subgroup of matrices of positive determinant). See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/KO-theory"} KO-theory
          %p
            Finally, we include one more property of determinants which pertains to matrices with real coefficients (which works slightly more generally for matrices with coefficients in a
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/local+field"} local field
          %h3#AsAPolynomialInTracesofPowers As a polynomial in traces of powers
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/relation+between+determinant+and+trace"} relation between determinant and trace
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
            equals the
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
            of its
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\det(\exp(A)) = \exp(tr(A))
                  \\,.
          %p
            More generally, the determinant of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            in the
            %a.existingWikiWord{:href => "/nlab/show/traces"} traces
            of the
            %a.existingWikiWord{:href => "/nlab/show/powers"} powers
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            For
            = succeed "-matrices:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mrow
                    %mo (
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  det(A)
                  \\;=\;
                  \\tfrac{1}{2}\left( tr(A)^2 - tr(A^2) \right)
          %p
            For
            = succeed "-matrices:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                    %mo ×
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3 \times 3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 6
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 3
                    %mo −
                    %mn 3
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  det(A)
                  \\;=\;
                  \\tfrac{1}{6}
                  \\left(
                  (tr(A))^3
                  \-
                  3 tr(A^2) tr(A)
                  +
                  tr(A^3)
                  \\right)
          %p
            For
            = succeed "-matrices:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mo ×
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4 \times 4
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 4
                    %mo −
                    %mn 6
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mn 3
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mn 8
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mn 6
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mn 4
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  det(A)
                  \\;=\;
                  \\tfrac{1}{24}
                  \\left(
                  (tr(A))^4
                  \-
                  6 tr(A^2)(tr(A))^2
                  +
                  3 (tr(A^2))^2
                  +
                  8 tr(A^3) tr(A)
                  \-
                  6 tr(A^4)
                  \\right)
          %p
            Generally for
            = succeed "-matrices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
            = succeed "):" do
              %a{:href => "#KondratyukKrivoruchenko92"} Kondratyuk-Krivoruchenko 92, appendix B
          #eq:DeterminantAsPolynomialInTracesOfPowers.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %msub
                            %mi k
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi k
                            %mi n
                          %mo ∈
                          %mi ℕ
                      %mrow
                        %mrow
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi ℓ
                              %mo =
                              %mn 1
                            %mi n
                          %mi ℓ
                          %msub
                            %mi k
                            %mi ℓ
                          %mo =
                          %mi n
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi l
                      %mo =
                      %mn 1
                    %mi n
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi k
                            %mi l
                          %mo +
                          %mn 1
                    %mrow
                      %msup
                        %mi l
                        %mrow
                          %msub
                            %mi k
                            %mi l
                      %msub
                        %mi k
                        %mi l
                      %mo !
                  %msup
                    %mrow
                      %mo (
                      %mi tr
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mi l
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mrow
                      %msub
                        %mi k
                        %mi l
                %annotation{:encoding => "application/x-tex"}
                  det(A)
                  \\;=\;
                  \\underset{
                  { k_1,\cdots, k_n \in \mathbb{N} }
                  \\atop
                  { \underoverset{\ell = 1}{n}{\sum} \ell k_\ell = n }
                  }{\sum}
                  \\underoverset{ l = 1 }{ n }{\prod}
                  \\frac{ (-1)^{k_l + 1} }{ l^{k_l} k_l !  }
                  \\left(tr(A^l)\right)^{k_l}
          .proof
            %h6#proof_of_
              Proof of
              %a.maruku-eqref{:href => "#eq:DeterminantAsPolynomialInTracesOfPowers"} (3)
            %p
              It is enough to prove this for semisimple matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (matrices that are
              %a.existingWikiWord{:href => "/nlab/show/diagonalizable+matrix"} diagonalizable
              upon passing to the
              %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
              of the ground field) because this
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of matrices is
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski
              %a.existingWikiWord{:href => "/nlab/show/dense+subset"} dense
              (using for example the nonvanishing of the
              %a.existingWikiWord{:href => "/nlab/show/discriminant"} discriminant
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomial"} characteristic polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              for which the equation holds is
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            %p
              Thus, without loss of generality we may suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %a.existingWikiWord{:href => "/nlab/show/diagonal+matrix"} diagonal
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi λ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \lambda_1, \ldots, \lambda_n
              along the diagonal, where the statement can be rewritten as follows. Letting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi k
                      %mo =
                      %mi tr
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi λ
                        %mn 1
                        %mi k
                      %mo +
                      %mi …
                      %mo +
                      %msubsup
                        %mi λ
                        %mi n
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p_k = tr(A^k) = \lambda_1^k + \ldots + \lambda_n^k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi λ
                      %mi i
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi k
                              %mi n
                            %mo ∈
                            %mi ℕ
                        %mrow
                          %mrow
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi ℓ
                                %mo =
                                %mn 1
                              %mi n
                            %mi ℓ
                            %msub
                              %mi k
                              %mi ℓ
                            %mo =
                            %mi n
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi l
                        %mo =
                        %mn 1
                      %mi n
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi k
                              %mi l
                            %mo +
                            %mn 1
                      %mrow
                        %msup
                          %mi l
                          %mrow
                            %msub
                              %mi k
                              %mi l
                        %msub
                          %mi k
                          %mi l
                        %mo !
                    %msubsup
                      %mi p
                      %mi l
                      %mrow
                        %msub
                          %mi k
                          %mi l
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{i=1}^n \lambda_i = \underset{
                    { k_1,\cdots, k_n \in \mathbb{N} }
                    \\atop
                    { \underoverset{\ell = 1}{n}{\sum} \ell k_\ell = n }
                    }{\sum}
                    \\underoverset{ l = 1 }{ n }{\prod}
                    \\frac{ (-1)^{k_l + 1} }{ l^{k_l} k_l !  }
                    p_l^{k_l}
            %p
              This of course is just a
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              identity, one closely related to various of the
              %a.existingWikiWord{:href => "/nlab/show/Newton+identities"} Newton identities
              that concern symmetric polynomials in indeterminates
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x_1, \ldots, x_n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi k
                      %mo =
                      %msubsup
                        %mi x
                        %mn 1
                        %mi k
                      %mo +
                      %mi …
                      %mo +
                      %msubsup
                        %mi x
                        %mi n
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p_k = x_1^k + \ldots + x_n^k
              %a.existingWikiWord{:href => "/nlab/show/elementary+symmetric+polynomials"} elementary symmetric polynomials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi k
                    %mo =
                    %msub
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_k = \sigma_k(x_1, \ldots, x_n)
              via the generating function identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 0
                    %msub
                      %mi σ
                      %mi k
                    %msup
                      %mi t
                      %mi k
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{k \geq 0} \sigma_k t^k = \prod_{i=1}^n (1 + x_i t).
            %p Then we compute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo ≥
                                %mn 0
                            %msub
                              %mi σ
                              %mi k
                            %msup
                              %mi t
                              %mi k
                          %mtd
                            %mo =
                          %mtd
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo +
                            %msub
                              %mi x
                              %mi i
                            %mi t
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi exp
                            %mrow
                              %mo (
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi i
                                  %mo =
                                  %mn 1
                                %mi n
                              %mi log
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo +
                              %msub
                                %mi x
                                %mi i
                              %mi t
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi exp
                            %mrow
                              %mo (
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi i
                                  %mo =
                                  %mn 1
                                %mi n
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ≥
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                              %mfrac
                                %mrow
                                  %msubsup
                                    %mi x
                                    %mi i
                                    %mi k
                                %mi k
                              %msup
                                %mi t
                                %mi k
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi exp
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ≥
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                              %mfrac
                                %mrow
                                  %msub
                                    %mi p
                                    %mi k
                                %mi k
                              %msup
                                %mi t
                                %mi k
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\sum_{k \geq 0} \sigma_k t^k &amp; = &amp; \prod_{i=1}^n (1 + x_i t) \\
                    \&amp; = &amp; \exp\left(\sum_{i=1}^n \log(1 + x_i t)\right) \\
                    \&amp; = &amp; \exp\left(\sum_{i=1}^n \sum_{k \geq 1} (-1)^{k+1} \frac{x_i^k}{k} t^k \right)\\
                    \&amp; = &amp; \exp\left( \sum_{k \geq 1} (-1)^{k+1} \frac{p_k}{k} t^k\right)
                    }
            %p
              and simply match coefficients of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi n
                  %annotation{:encoding => "application/x-tex"} t^n
              in the initial and final series expansions, where we easily compute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %msub
                      %mi x
                      %mn 2
                    %mi …
                    %msub
                      %mi x
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %msub
                          %mi k
                          %mn 1
                        %mo +
                        %mn 2
                        %msub
                          %mi k
                          %mn 2
                        %mo +
                        %mi …
                        %mo +
                        %mi n
                        %msub
                          %mi k
                          %mi n
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi l
                        %mo =
                        %mn 1
                      %mi n
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi k
                          %mi l
                        %mo{:stretchy => "false"} )
                        %mo !
                    %msup
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %msub
                              %mi p
                              %mi l
                          %mi l
                        %mo )
                      %mrow
                        %msub
                          %mi k
                          %mi l
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi k
                          %mi l
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    x_1 x_2 \ldots x_n = \sum_{n = k_1 + 2k_2 + \ldots + n k_n} \prod_{l=1}^n \frac1{(k_l)!} \left(\frac{p_l}{l}\right)^{k_l} (-1)^{k_l+1}
            %p This completes the proof.
