          %h2#idea Idea
          %ul
            %li
              %p
                A
                %em functor
                is a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %li
              %p
                A functor between
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                is a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of the
                %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                %a.existingWikiWord{:href => "/nlab/show/graphs"} graphs
                that respects the
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/edges"} edges
          %p
            So, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
