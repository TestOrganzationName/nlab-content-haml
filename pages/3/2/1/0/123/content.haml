                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      F_{x,y} \;\colon\; C(x,y) \xrightarrow{\;\;} D(F(x), F(y))
              %p
                between
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
          %p such that:
          %ul
            %li
              %p
                it respects
                %a.existingWikiWord{:href => "/nlab/show/source"} source
                and
                %a.existingWikiWord{:href => "/nlab/show/target"} target
                of
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} F_1
                coincides with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} F_0
                on source and target objects;
            %li
              %p
                it respects
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(id_X) = id_{F(X)}
            %li
              %p
                it respects
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is the composite of their images.
          %p
            These last two properties are the decisive ones of a functor; they are called the
            = succeed "." do
              %strong functoriality conditions
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            (of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
          %p
            The notion of a functor is a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of that of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
          %h2#definition Definition
          %h3#external_definition External definition
          %p
            A
            %strong functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            from a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a map sending each
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} x \in C
            to an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} F(x) \in D
            and each
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f : x \to y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(f) : F(x) \to F(y)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                preserves
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(g\circ f) = F(g)\circ F(f)
                whenever the left-hand side is well-defined,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                preserves
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} x \in C
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mn 1
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(1_x) = 1_{F(x)}
          %p
            Or equivalently, since compositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi f
                  %mo =
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} g f = g\circ f
            (commuting triangles) and identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi x
                %annotation{:encoding => "application/x-tex"} 1_x
            (commuting loops) are both simple commuting diagrams, we can combine the above conditions to the single statement
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g \colon Y\to Z
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} h \colon X\to Z
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo =
                  %mi g
                  %mo ∘
                  %mi f
                  %mo .
                %annotation{:encoding => "application/x-tex"} h = g\circ f.
          %p
            In this case, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F:C\to D
            to preserve the commutative triangle means
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(h) = F(g)\circ F(f)
          %p as depicted below
          %p
            %img{:src => "http://ncatlab.org/nlab/files/functor.jpg", :width => "300"}/
          %p
            Preserving commuting triangles means
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            preserves compositions.
          %p
            Given morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g:Y\to Z
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi Z
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} h:Z\to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi X
                  %mo =
                  %mi h
                  %mo ∘
                  %mi g
                  %mo ∘
                  %mi f
                  %mo .
                %annotation{:encoding => "application/x-tex"} 1_X = h\circ g\circ f.
          %p
            In this case, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F:C\to D
            to preserve the commutative loop means
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(1_X) = F(h)\circ F(g)\circ F(f)
          %p as depicted below
          %p
            %img{:src => "http://ncatlab.org/nlab/files/commuteloop.jpg", :width => "300"}/
          %p However, it means more than that. Since any commutative loop is equal to the identity morphism, we must also have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1_{F(X)} = F(h)\circ F(g)\circ F(f)
          %p implying
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F(1_X) = 1_{F(X)}.
          %p
            Preserving commuting loops means
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            preserves identity morphisms.
          %p
            Another equivalent way to say this is that a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            is precisely a morphism of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(F) : N(C) \to N(D)
            between the
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            of these categories
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                are the 0-cells of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(D)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo :
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} N(F)_0 : N(F)_0 \to N(F)_0
                maps objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                to objects of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                are the 1-cells of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(D)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo :
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} N(F)_1 : N(F)_1 \to N(F)_1
                maps morphisms of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                to objects of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
            %li
              %p
                the identity morphisms of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                are the degenerate 1-cells of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(D)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(F)
                respects degeneracy maps means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                respects identities;
            %li
              %p
                the commuting triangles of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                are the 2-cells of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(D)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(F)
                maps 2-cells to 2-cells means that it respects commuting triangles, hence that it respects composition.
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            for more details on this.
          %p
            The functors between two categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            form themselves a category, the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C,D]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/2-category"} category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            of categories, functors and natural transformations. In other words, functors are
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %h3#InternalDefinition Internal definition
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            %a.existingWikiWord{:href => "/nlab/show/internal+categories"} internal categories
            in some ambient category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %strong internal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            is
          %ul
            %li
              %p
                a morphism of objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                      %mo :
                      %msub
                        %mi C
                        %mn 0
                      %mo →
                      %msub
                        %mi D
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} F_0 : C_0 \to D_0
                in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                a morphisms of morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %mo :
                      %msub
                        %mi C
                        %mn 1
                      %mo →
                      %msub
                        %mi D
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} F_1 : C_1 \to D_1
                in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p such that the following diagrams commute
              %ul
                %li
                  %p
                    respect for the source map:
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 1
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi s
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi s
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 0
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 0
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 0
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            C_1 &amp;\stackrel{f_1}{\to}&amp; D_1
                            \\\
                            \\downarrow^s &amp;&amp; \downarrow^s
                            \\\
                            C_0
                            \&amp;\stackrel{f_0}{\to}&amp;
                            D_0
                            }
                %li
                  %p
                    respect for the target map:
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 1
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi t
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi t
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 0
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 0
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 0
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            C_1 &amp;\stackrel{f_1}{\to}&amp; D_1
                            \\\
                            \\downarrow^t &amp;&amp; \downarrow^t
                            \\\
                            C_0
                            \&amp;\stackrel{f_0}{\to}&amp;
                            D_0
                            }
                %li
                  %p
                    respect for identities
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 0
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 0
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 0
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi i
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mi i
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 1
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            C_0 &amp;\stackrel{f_0}{\to}&amp;
                            D_0
                            \\\
                            \\downarrow^i &amp;&amp; \downarrow^i
                            \\\
                            C_1 &amp;\stackrel{f_1}{\to}&amp; D_1
                            }
                %li
                  %p
                    respect for composition
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 1
                                    %msub
                                      %mo ×
                                      %mrow
                                        %mi t
                                        %mo ,
                                        %mi s
                                    %msub
                                      %mi C
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                        %msub
                                          %mo ×
                                          %mrow
                                            %mi t
                                            %mo ,
                                            %mi s
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 1
                                    %msub
                                      %mo ×
                                      %mrow
                                        %mi t
                                        %mo ,
                                        %mi s
                                    %msub
                                      %mi D
                                      %mn 1
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mo ∘
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mo ∘
                                %mtr
                                  %mtd
                                    %msub
                                      %mi C
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mi D
                                      %mn 1
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            C_1 \times_{t,s}
                            C_1 &amp;\stackrel{f_1\times_{t,s} f_1}{\to}&amp;
                            D_1 \times_{t,s} D_1
                            \\\
                            \\downarrow^{\circ} &amp;&amp; \downarrow^{\circ}
                            \\\
                            C_1 &amp;\stackrel{f_1}{\to}&amp; D_1
                            }
          %p
            This reproduces the external definition of functors above for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            In many cases, this notion is too restrictive, and we should use internal
            %a.existingWikiWord{:href => "/nlab/show/anafunctors"} anafunctors
            instead.
          %h3#enriched_definition Enriched definition
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            but the given
            %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
            to each other, in a way that respects their composition. This is described at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"}> enriched functor
              \.
          %h3#profunctors Profunctors
          %p
            A generalization of the notion of an
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            is the notion of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
          %h3#higher_categorical_functors Higher categorical functors
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            there are corresponding higher notions of a functor, such as
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/strict+2-functor"} strict 2-functor
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %li
              %p
                See also an informal discussion about an
                = succeed "." do
                  %span.newWikiWord
                    experimental alternative definition of functor
                    %a{:href => "/nlab/new/experimental+alternative+definition+of+functor"} ?
          %h3#in_homotopy_type_theory In homotopy type theory
          %p
            Note: the
            %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
            calls a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            a “precategory” and a
            %a.existingWikiWord{:href => "/nlab/show/univalent+category"} univalent category
            a “category”, but here we shall refer to the standard terminology of “category” and “univalent category” respectively.
          %p
            The definition of a functor in homotopy type theory is a straightforward translation of the ordinary one. However, the notion of a
            %a.existingWikiWord{:href => "/nlab/show/univalent+category"} univalent category
            allows us to construct some such functors that in classical mathematics would require either the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            or the use of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/anafunctors"} anafunctors
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %strong functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F : A \to B
            consists of
          %ul
            %li
              A function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0 : A_0 \to B_0
            %li
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a,b:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi hom
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mi a
                      %mo ,
                      %mi F
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_{a,b}:hom_A(a,b) \to hom_B(F a,F b)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %li
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a:A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mn 1
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi F
                          %mi a
                    %annotation{:encoding => "application/x-tex"} F(1_a)=1_{F a}
            %li
              For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b,c: A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi hom
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:hom_A(a,b)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g:hom_A(b,c)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mi g
                  %mo ∘
                  %mi F
                  %mi f
                %annotation{:encoding => "application/x-tex"} F(g \circ f) = F g \circ F f
          %p
            Formally, the type of functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                      %mo :
                      %msub
                        %mi A
                        %mn 0
                      %mo →
                      %msub
                        %mi B
                        %mn 0
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi F
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                          %mo :
                          %mi A
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi hom
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mi a
                      %mo ,
                      %mi F
                      %mi b
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %mi F
                      %mi a
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mo ×
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi g
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mi g
                  %mo ∘
                  %mi F
                  %mi f
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"}
                  Func(A,B) \coloneqq
                  \\sum_{F_0:A_0\to B_0} \sum_{F:\prod_{a,b:A} hom_A(a,b) \to \hom_B(F a,F b)} \Big(\prod_{a:A} F(1_a) = 1_{F a}\Big) \times \Big( \prod_{a,b,c:A} \prod_{f:\hom_A(a,b)} \prod_{g:\hom_A(b,c)} F(g \circ f) = F g \circ F f\Big)
          %p
            A formal definition in
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            can be found in
            = succeed "." do
              %a{:href => "#AhrensKapulkinShulman13"} Ahrens-Kapulkin-Shulman 13
          %h2#properties Properties
          %p
            These properties come from the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
          %p
            By induction on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi idtoiso
                %annotation{:encoding => "application/x-tex"} idtoiso
            (See
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %h3#composition_of_functors Composition of functors
          %p
            For functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F:A\to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} G:B \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∘
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G \circ F : A \to C
            is given by
          %ul
            %li
              The composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mn 0
                    %mo ∘
                    %msub
                      %mi F
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (G_0 \circ F_0): A_0 \to C_0
            %li
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a,b:A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mrow
                          %mi F
                          %mi a
                          %mo ,
                          %mi F
                          %mi b
                      %mo ∘
                      %msub
                        %mi F
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mi F
                      %mi a
                      %mo ,
                      %mi G
                      %mi F
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G_{F a, F b} \circ F_{a,b}):hom_A(a,b)\to hom_C(G F a, G F b)
          %h3#lemma_929_in_hott_book Lemma 9.2.9 in HoTT book
          %p
            Composition of functors is associative
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mi F
                  %annotation{:encoding => "application/x-tex"} H(G F)=(H G)F
          %p
            %strong Proof:
            Since composition of functions is associative, this follows immediately for the actions on objects and on homs. And since hom-sets are sets, the rest of the data is automatic.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
          %h3#lemma_9210_in_hott_book Lemma 9.2.10 in HoTT book
          %p Lemma 9.2.9 is coherent, i.e. the following pentagon of equalities commutes:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mi F
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mi F
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mi F
                        %mtd
                        %mtd
                          %mo ⟶
                        %mtd
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mi F
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; (K H)(G F)
                  \\\
                  \&amp; \nearrow
                  \&amp;&amp;
                  \\searrow
                  \\\
                  ((K H) G) F
                  \&amp;&amp; &amp;&amp;
                  K (H (G F))
                  \\\
                  \\downarrow
                  \&amp;&amp; &amp;&amp;
                  \\uparrow
                  \\\
                  (K(H G)) F
                  \&amp;&amp; \longrightarrow &amp;&amp;
                  K( (H G) F)
                  }
          %h2#types_of_functors Types of functors
          %p Specific types of functors are important in applications. See for instance
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          %p
            For more background on this, see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} stuff, structure, property
          %h2#examples Examples
          %h3#morphisms_of_monoids_and_groups Morphisms of monoids and groups
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A,B
            %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ,
                  %mi H
                %annotation{:encoding => "application/x-tex"} G, H
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A, \mathbf{B}B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}H
            be the corresponding one-object
            %a.existingWikiWord{:href => "/nlab/show/category"} categories
            (as described at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}A \to \mathbf{B}B
          %p
            are canonically in bijection with monoid homomorphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G \to \mathbf{B}H
          %p
            are canonically in bijection with group homomorphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \to H
          %h3#representations Representations
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            as above, functors on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            with values in
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            are the same as linear
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Funct
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mi Vect
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Funct(\mathbf{B}G, Vect) \simeq Rep(G)
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            with the representation category.
          %h3#linear_maps Linear Maps
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B} End(U)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B} End(V)
            be one-object categories whose objects are each finite-dimensional vector space and whose morphisms are all of the linear
            %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
            on that space, i.e. one-object
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategories
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fin
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Fin Vect
          %h4#left_inverses Left Inverses
          %p
            If the linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi U
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} F:U\to V
            has a left inverse, i.e.,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo ∘
                  %mi F
                  %mo =
                  %msub
                    %mn 1
                    %mi U
                  %mo ,
                %annotation{:encoding => "application/x-tex"} F^*\circ F = 1_U,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_*:\mathbf{B} End(U)\to\mathbf{B} End(V)
          %p by defining its action on objects by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi F
                    %mo *
                  %mi U
                %annotation{:encoding => "application/x-tex"} F_*(U) = F_* U
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_*
            on the right-hand side is the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            and its action on endomorphisms by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mi f
                  %msup
                    %mi F
                    %mo *
                  %mo .
                %annotation{:encoding => "application/x-tex"} F_*(f) = F f F^*.
          %p Composition follows immediately:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mi f
                  %mi g
                  %msup
                    %mi F
                    %mo *
                  %mo =
                  %mi F
                  %mi f
                  %msup
                    %mi F
                    %mo *
                  %mi F
                  %mi g
                  %msup
                    %mi F
                    %mo *
                  %mo =
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F_*(f g) = F f g F^* = F f F^* F g F^* = F_*(f) F_*(g).
          %p
            Identity morphisms are preserved since, for any vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo *
                    %mi U
                    %mo ⊂
                    %mi V
                  %annotation{:encoding => "application/x-tex"} F_*U\subset V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo =
                  %mi F
                  %mi x
                %annotation{:encoding => "application/x-tex"} y = F x
          %p
            for some vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi U
                  %mo{:stretchy => "false"} )
                  %mi y
                  %mo =
                  %mi F
                  %mo ∘
                  %msup
                    %mi F
                    %mo *
                  %mi y
                  %mo =
                  %mi F
                  %mo ∘
                  %msup
                    %mi F
                    %mo *
                  %mo ∘
                  %mi F
                  %mi x
                  %mo =
                  %mi F
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} F_*(1_U)y = F\circ F^* y = F\circ F^*\circ F x = F x = y
          %p so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} F_*(1_U) = 1_{F_*(U)},
          %p
            as required. Hence,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_*
            is a functor.
          %h4#right_inverses Right Inverses
          %p
            If the linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi U
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} F:U\to V
            has a right inverse, i.e.,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∘
                  %msup
                    %mi F
                    %mo *
                  %mo =
                  %msub
                    %mn 1
                    %mi V
                  %mo ,
                %annotation{:encoding => "application/x-tex"} F\circ F^* = 1_V,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            is the preimage, then we can construct a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^*:\mathbf{B} End(V)\to\mathbf{B} End(U)
          %p by defining its action on objects by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi V
                %annotation{:encoding => "application/x-tex"} F^*(V) = F^*V
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            on the right-hand side is preimage, and its action on endomorphisms by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi f
                  %mi F
                  %mo .
                %annotation{:encoding => "application/x-tex"} F^*(f) = F^* f F.
          %p Composition follows immediately:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi f
                  %mi g
                  %mi F
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi f
                  %mi F
                  %msup
                    %mi F
                    %mo *
                  %mi g
                  %mi F
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F^*(f g) = F^* f g F = F^* f F F^* g F = F^*(f) F^*(g).
          %p
            Identity morphisms are preserved since, for any vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mi V
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F^*V\subset U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = F^*y
          %p
            for some vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi V
                  %mo{:stretchy => "false"} )
                  %mi x
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mo ∘
                  %mi F
                  %mi x
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mo ∘
                  %mi F
                  %mo ∘
                  %msup
                    %mi F
                    %mo *
                  %mi y
                  %mo =
                  %msup
                    %mi F
                    %mo *
                  %mi y
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} F^*(1_V)x = F^*\circ F x = F^*\circ F \circ F^* y = F^* y = x
          %p so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %msup
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^*(1_V) = 1_{F^*(V)}
          %p
            as required. Hence,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            is a functor.
          %h3#presheaves Presheaves
          %p
            Functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F : C \to Set
            with values in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            are also called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            for more on this.
          %h3#OnGeneralizedElements Functors and generalized elements
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            any other object, a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : U \to X
            may be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            (For this language applied to the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of sets, see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            of generalized elements of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            is thus the union of the
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \coprod_{U \in C} Hom_C(U,X)
          %p
            While a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            in an arbitrary category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            need not at all come to us as a function of sets, it always induces a function of sets of
            %em generalized elements
            \: it sends the generalized element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : U \to X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the generalized element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi U
                  %mover
                    %mo →
                    %mi x
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  f(x) : U \stackrel{x}{\to} X \stackrel{f}{\to} Y
          %p
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            with the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            In terms of this notation, the functoriality condition on a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F : C \to D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mover
                    %mo →
                    %mi x
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F(U \stackrel{x}{\to} X \stackrel{f}{\to} Y)
                  \=
                  F(U) \stackrel{F(x)}{\to} F(X) \stackrel{F(f)}{\to} F(Y),
          %p appears as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F(f(x)) = F(f)(F(x))
                  \\,.
          %p This can be illustrated in the following diagram:
          %p
            %img{:src => "http://ncatlab.org/nlab/files/altfunctor.jpg", :width => "300"}/
          %p
            which provides an alternative expression of the functoriality condition as simply a statement that commuting diagrams in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            map to commuting diagrams in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %h2#related_concepts Related concepts
          %ul
            %li
