          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\times(-)
              and
              %a.existingWikiWord{:href => "/nlab/show/finite+coproducts"} finite coproducts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-) + (-)
              is called (finitary)
              %strong distributive
              if for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X,Y,Z\in C
              the canonical
              %a.existingWikiWord{:href => "/nlab/show/distributivity"} distributivity
              morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo +
                    %mi X
                    %mo ×
                    %mi Z
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo +
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\times Y + X\times Z \longrightarrow X\times (Y+Z)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo +
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\times Y \to X\times (Y+Z)
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi i
                    %annotation{:encoding => "application/x-tex"} X\times i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi Y
                    %mo +
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} i\colon Y\to Y +Z
              is the coproduct injection, and dually for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Z
                      %mo →
                      %mi X
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo +
                      %mi Z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X\times Z \to X\times (Y+Z)
            %p
              Equivalently, a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with finite products and coproducts is distributive if for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} X \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X \times -
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves finite coproducts
          .num_remark
            %h6#remark Remark
            %p
              This notion is part of a hierarchy of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/distributivity+for+monoidal+structures"} distributivity for monoidal structures
              %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+categories"} distributive monoidal categories
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rig+categories"} rig categories
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+category"} linearly distributive category
              is
              %em not
              distributive in this sense.
          %p
            This axiom on binary coproducts easily implies the analogous
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n\gt 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mn 0
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} X\times 0 \to 0
          %p
            is an isomorphism for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (see Proposition
            %a.maruku-ref{:href => "#nullary"}
            below). Moreover, for a category with finite products and coproducts to be distributive, it actually suffices for there to be
            %em any
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
            family of isomorphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo +
                    %mi X
                    %mo ×
                    %mi Z
                    %mo ≅
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo +
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\times Y + X\times Z \cong X\times (Y+Z)
            = succeed ")." do
              %a{:href => "#Lack"} Lack
          %p
            A category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with finite products and all small coproducts is
            %strong infinitary distributive
            if the statement applies to all small coproducts. One can also consider
            = succeed "-distributivity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \lt\kappa
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
            with finite products is distributive, but the converse is not true.
          %h2#properties Properties
          #monic.num_prop
            %h6#proposition Proposition
            %p
              In a category with products and coproducts, if products distribute over binary coproducts, then
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %a.existingWikiWord{:href => "/nlab/show/coprojections"} coprojections
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi B
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                    %mo +
                    %mi C
                  %annotation{:encoding => "application/x-tex"} i_B: B \to B + C
              be a coproduct coprojection, and suppose given maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f, g: A \to B
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi B
                      %mi f
                      %mo =
                      %msub
                        %mi i
                        %mi B
                      %mi g
                    %annotation{:encoding => "application/x-tex"} i_B f = i_B g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mo →
                    %mi A
                    %mo ×
                    %mi B
                    %mo +
                    %mi A
                    %mo ×
                    %mi C
                  %annotation{:encoding => "application/x-tex"} i: A \times B \to A \times B + A \times C
            %p
              is monic because it has a
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mn 1
                        %mrow
                          %mi A
                          %mo ×
                          %mi B
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                      %mo ×
                      %mi B
                      %mo +
                      %mi A
                      %mo ×
                      %mi C
                      %mo →
                      %mi A
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (1_{A \times B}, \phi): A \times B + A \times C \to A \times B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi A
                      %mo ×
                      %mi C
                      %mo →
                      %mi A
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \phi: A \times C \to A \times B
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mi C
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi π
                            %mi A
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mn 1
                            %mi A
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} ⟩
                      %mi A
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \times C \stackrel{\pi_A}{\to} A \stackrel{\langle 1_A, f \rangle}{\to} A \times B
            %p
              The composite of the coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              with the canonical isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mi B
                      %mo +
                      %mi A
                      %mo ×
                      %mi C
                      %mo ≅
                      %mi A
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo +
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \times B + A \times C \cong A \times (B + C)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi A
                      %mo ×
                      %msub
                        %mi i
                        %mi B
                      %mo :
                      %mi A
                      %mo ×
                      %mi B
                      %mo →
                      %mi A
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo +
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1_A \times i_B: A \times B \to A \times (B + C)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mn 1
                        %mi A
                      %mo ,
                      %msub
                        %mi i
                        %mi B
                      %mi f
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mn 1
                        %mi A
                      %mo ,
                      %msub
                        %mi i
                        %mi B
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo +
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \langle 1_A, i_B f \rangle = \langle 1_A, i_B g \rangle: A \to A \times (B + C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi A
                    %mo ×
                    %msub
                      %mi i
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mn 1
                      %mi A
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mn 1
                      %mi A
                    %mo ,
                    %msub
                      %mi i
                      %mi B
                    %mi f
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mn 1
                      %mi A
                    %mo ,
                    %msub
                      %mi i
                      %mi B
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi A
                    %mo ×
                    %msub
                      %mi i
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mn 1
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (1_A \times i_B)\langle 1_A, f \rangle = \langle 1_A, i_B f \rangle = \langle 1_A, i_B g \rangle = (1_A \times i_B)\langle 1, g \rangle,
            %p
              whence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mn 1
                      %mi A
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mn 1
                      %mi A
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \langle 1_A, f\rangle = \langle 1_A, g\rangle: A \to A \times B
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi A
                    %mo ×
                    %msub
                      %mi i
                      %mi B
                  %annotation{:encoding => "application/x-tex"} 1_A \times i_B
              is monic. It follows that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f = g
          #nullary.num_prop
            %h6#proposition_2 Proposition
            %p
              If products distribute over binary coproducts, then products distribute over nullary coproducts (i.e., the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mn 0
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} X \times 0 \to 0
              is an isomorphism for all objects
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_2 Proof
            %p
              We show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} X \times 0
              is initial. Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mn 0
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X \times 0, Y)
              is inhabited by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mn 0
                    %mo →
                    %mn 0
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times 0 \to 0 \to Y
              for any object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 0
                    %mo +
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to 0 + 0
              coincide, the same holds for the two coprojections
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mn 0
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \times 0 \to (X \times 0) + (X \times 0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo +
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \times (0 + 0) \cong (X \times 0) + (X \times 0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mn 0
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times 0 \to Y
              coincide, since given maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi X
                      %mo ×
                      %mn 0
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g : X \times 0 \to Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                      %msub
                        %mi i
                        %mn 1
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                      %msub
                        %mi i
                        %mn 2
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f = [f, g] \circ i_1 = [f, g] \circ i_2 = g
          .num_prop
            %h6#proposition_3 Proposition
            %p
              In a distributive category, the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict
          .proof
            %h6#proof_3 Proof
            %p
              Given an arrow
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f: A \to 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi A
                    %mo :
                    %mi A
                    %mo ×
                    %mn 0
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_A: A \times 0 \to A
              is a retraction of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %mo ×
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle 1, f \rangle: A \to A \times 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a retract of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mn 0
                      %mo ≅
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} A \times 0 \cong 0
          %h2#Examples Examples
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/bicartesian+closed+category"} bicartesian closed category
            is distributive since in that case the cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} X \times -
            is a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            and then the distributivity requirement is an instance of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoints+preserve+%28co-%29limits"} preservation of colimits by left adjoints
          %ul
            %li
              %p
                the category
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %li
              %p
                any
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p But closedness is far from necessary, for example
          %ul
            %li
              the category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              with respect to forming
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
              and
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+topological+spaces"} disjoint union topological spaces
          %p is a distributive category.
          %p
            These categories have in common that they are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            of a distributive category that is not extensive is given by
          %ul
            %li
              the category of
              %a.existingWikiWord{:href => "/nlab/show/rectangular+bands"} rectangular bands
              which has objects
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              satisfying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x x = x
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x y x=x
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x,y\in X
          %p
            Since for
            %a.existingWikiWord{:href => "/nlab/show/poset"} posets
            viewed as categories, finite products and coproducts are given by
            %a.existingWikiWord{:href => "/nlab/show/meets"} meets
            and
            %a.existingWikiWord{:href => "/nlab/show/joins"} joins
            we find:
          %ul
            %li
              A
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              viewed as a category is distributive iff it is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
          %p A further non-example:
          %ul
            %li
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pfn
                  %annotation{:encoding => "application/x-tex"} Pfn
              of sets and
              %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
              has finite coproducts and products. The former given by
              %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
              as in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              and the latter by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi X
                    %mo +
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} (X\times Y)+X+Y
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} \times,+
              indicate the usual product and coproduct in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi_1,\pi_2
              given on the domains of definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (X\times Y)+X
              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} (X\times Y)+Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \pi_1((x,y))=x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \pi_1(x)=x
              (resp.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \pi_2((x,y))=y
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \pi_2(y)=y
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \empty
              is not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pfn
                  %annotation{:encoding => "application/x-tex"} Pfn
              is not distributive.
          %h2#free_distributive_categories Free distributive categories
          %p
          .num_prop
            %h6 Proposition
            %p
            %ul
              %li
                %p
                  The free distributive category on a category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  with finite products is given by the finite
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi FinCoprod
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} FinCoprod(\mathcal{C})
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinCoprod
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} FinCoprod(\mathcal{C})
                  is distributive, and induces a bijection between distributive functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinCoprod
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} FinCoprod(\mathcal{C})\to \mathcal{D}
                  and product preserving functors
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo →
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}\to \mathcal{D}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %li
                %p
                  The free distributive category on a category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is the finite
                  %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
                  of the finite
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/free+product+completion"} free product completion
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi FinCoprod
                          %mo{:stretchy => "false"} (
                          %mi FinProd
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} FinCoprod(FinProd(\mathcal{C}))
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinCoprod
                        %mo{:stretchy => "false"} (
                        %mi FinProd
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} FinCoprod(FinProd(\mathcal{C}))
                  is distributive, and induces a bijection between distributive functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinCoprod
                        %mo{:stretchy => "false"} (
                        %mi FinProd
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} FinCoprod(FinProd(\mathcal{C}))\to \mathcal{D}
                  and functors
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo →
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}\to \mathcal{D}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %p
          This is noted in
          = succeed "," do
            %a{:href => "#Cockett93"} Cockett 1993, p. 280, also Corollary 5.9
          %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"} Bob Walters
          and
          %span.newWikiWord
            Shu-Hao Sun
            %a{:href => "/nlab/new/Shu-Hao+Sun"} ?
          are named as advocates of this method. (However, note that Cockett does not insist on an initial object.)
          %p
            In particular, then, the free distributive category, which is the free distributive category on the empty category, is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+finite+sets"} category of finite sets
          %h2#incompatibilities Incompatibilities
          %p
            Distributivity, in the sense of this page, is “incompatible” with certain other “linear” structures, at least in the sense that when combined they force the category to become
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
          %p
          .num_theorem
            %h6 Theorem
            %p
              If a category is distributive, and also
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+category"} linearly distributive
              with the same cartesian product and coproduct, then it is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
          .proof
            %h6 Proof
            %p
              This can be found in
              %a{:href => "#CockettSeely92"} Cockett-Seely 92
          %p
          .num_theorem
            %h6 Theorem
            %p
              If a category has binary products that distribute over binary coproducts, and also has a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal structure
              that is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
          .proof
            %h6 Proof
            %p
              See at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive law
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/distributivity+for+monoidal+structures"} distributivity for monoidal structures
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+category"} distributive monoidal category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/bipermutative+category"} bipermutative category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+category"} linearly distributive category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/rig+category"} rig category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
