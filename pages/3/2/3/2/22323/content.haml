          %title
          %h2#overview_and_definition Overview and definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            be a congruence subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbf{Z})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M}(\Gamma)
            the graded (by the weight) algebra of modular forms with respect to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                  %annotation{:encoding => "application/x-tex"} [-,-]_n\colon(f, g)\mapsto [f,g]_n
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} f\in\mathcal{M}(\Gamma)_{2k}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi l
                %annotation{:encoding => "application/x-tex"} g\in\mathcal{M}(\Gamma)_{2l}
            is given by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo ,
                  %mi g
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi n
                  %mo :
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi r
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                      %mrow
                        %mi n
                        %mo −
                        %mi r
                    %mo )
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                        %mi l
                        %mo −
                        %mn 1
                      %mi r
                    %mo )
                  %msup
                    %mi f
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi g
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mi r
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 2
                      %mi l
                      %mo +
                      %mn 2
                      %mi n
                %annotation{:encoding => "application/x-tex"}
                  [f,g]_n := \sum_{r=0}^n (-1)^r\binom{n+2k-1}{n-r}\binom{n+2l-1}{r}f^{(r)}g^{(n-r)}\,\in \,\mathcal{M}(\Gamma)_{2k+2l+2n}
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msup
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mrow
                            %mn 2
                            %mi π
                            %mi i
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi z
                        %mo )
                      %mi r
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f^{(r)} := \left(\frac{1}{2\pi i}\frac{\partial}{\partial z}\right)^r f
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sl
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sl(2)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/transvectant"} transvectant
          %ul
            %li
              P. Gordan,
              = succeed "," do
                %em Das Zerfallen der Curven in gerade Linien
              %a{:href => "https://doi.org/10.1007/BF01446687"} doi
          %p
            %a.existingWikiWord{:href => "/nlab/show/Henri+Moscovici"} Moscovici
            and
            %a.existingWikiWord{:href => "/nlab/show/Alain+Connes"} Connes
            have constructed a sequence of Hopf algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_q
            related to geometry of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/foliation"} foliation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_q
            has deformations which may be given by universal deformation formulas, or in other words, by
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Drinfeld+twist"} Drinfeld twist
            %strong Rankin-Cohen deformations
            and are akin in structure to what is in quantum group context known as
            = succeed "s," do
              %span.newWikiWord
                Jordanian twist
                %a{:href => "/nlab/new/Jordanian+twist"} ?
            %span.newWikiWord
              Dimitri Gurevich
              %a{:href => "/nlab/new/Dimitri+Gurevich"} ?
            on (generalized) Jordanian R-matrices, and of Ogievetsky, Coll-Gerstenhaber-Giaquinto and in a closer symmetrized form by Giaquinto and Zhang. An isomorphism between (reduced) Rankin-Cohen deformation and Jordanian deformation has been exhibited by Samsonov.
          %h2#literature Literature
          %ul
            %li
              R. A. Rankin,
              = succeed "," do
                %em The construction of automorphic forms from the derivatives of a given form
            %li
              H. Cohen,
              = succeed "," do
                %em Sums involving the values at negative integers of L-functions of quadratic characters
            %li
              P. Cohen,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Don+Zagier"} Don Zagier
              = succeed "," do
                %em Automorphic pseudodifferential operators
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alain+Connes"}> Alain Connes
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Henri+Moscovici"} Henri Moscovici
              = succeed "," do
                %em Rankin-Cohen brackets and the Hopf algebra of transverse geometry
              = succeed ":1" do
                %strong 4
            %li
              R. Rochberg, X. Tang, Y. Yao,
