            %p indexed only on the even natural numbers.
          #VectorBundleAssociatedWithBfStructure.num_defn
            %h6#definition_7 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/%28B%2Cf%29-structure"} (B,f)-structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#BfStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
