                                %mrow
                                  %msub
                                    %mi f
                                    %mi n
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                        %mtr
                          %mtd
                            %mi B
