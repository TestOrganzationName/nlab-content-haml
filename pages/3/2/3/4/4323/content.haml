                  %annotation{:encoding => "application/x-tex"} E^{\mathcal{B}}_{n+1}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundleAssociatedWithBfStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi n
