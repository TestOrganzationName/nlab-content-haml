                                    %mi ℝ
                              %mo }
                          %mtd
                            %mo ⟶
                          %mtd
                            %mrow
                              %mo {
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msub
                                      %mi V
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mn 1
                                    %mo ⊂
                                    %msup
                                      %mi ℝ
                                      %mrow
                                        %mi k
                                        %mo +
                                        %mn 1
                                  %mo ,
                                %mrow
                                  %mi v
                                  %mo ∈
                                  %msub
                                    %mi V
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                              %mo }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Gr
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi Gr
