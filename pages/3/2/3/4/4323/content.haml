                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_n \colon B O(n) \to B O(n+1)
              ((
              %a{:href => "classifying+space#InclusionOfBOnIntoBOnPlusOne"}> def.
              )) in that there are
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
