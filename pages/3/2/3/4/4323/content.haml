                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi j
                              %mi n
                            %mo ∘
                            %msub
                              %mi f
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
