                = succeed "," do
                  %em Equivariant stable homotopy theory
              %p contributions by J. E. McClure.
          %p A brief exposition appears as example 3.7 in
          %ul
            %li#PontoShulman
              %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"}> Kate Ponto
