                                %mo +
                                %mi ℓ
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mrow
                                %mi k
                                %mo +
                                %mi ℓ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                            %mi O
