              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              from
              %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
