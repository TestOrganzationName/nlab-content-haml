                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo +
                            %mi ℓ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ( E (O(k)\times O(\ell))\underset{O(k)\times O(\ell)}{\times})
