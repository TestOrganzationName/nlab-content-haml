              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[-]
              forms the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
          .num_defn
            %h6#definition_10 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Σ
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    b gl_1(R) \coloneqq \Sigma gl_1(R)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of the group of units
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi gl
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} gl_1(R)
          %p
            This plays the role of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gl_1(R)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi b
                  %mo →
                  %mi b
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : b \to b gl_1(R)
            a morphism (a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            for
            = succeed "-bundles)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gl_1(R)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spec"} Spec
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} p \to b
            for the corresponding bundle: the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi p
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi b
                          %msub
                            %mi gl
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  p &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  b &amp;\stackrel{f}{\to}&amp; b gl_1(R)
                  }
                  \\,.
          %p
            Given a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi R
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \rho : R \to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi b
                  %mover
                    %mo →
                    %mi f
                  %mi b
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ρ
                  %mi b
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\rho(f) : b \stackrel{f}{\to} b gl_1(R) \stackrel{\rho}{\to} b gl_1(A)
          %p
            is that for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
          %p We write capital letters for the underlying spaces of these spectra:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ≔
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi p
                %annotation{:encoding => "application/x-tex"}
                  P \coloneqq \Sigma^\infty \Omega^\infty p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ≔
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi b
                %annotation{:encoding => "application/x-tex"}
                  B \coloneqq \Sigma^\infty \Omega^\infty b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn ∞
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  GL_1(R) \coloneqq \Sigma^\infty \Omega^\infty gl_1(R)
          #GeneralThomSpectrum.num_defn
            %h6#definition_11 Definition
            %p
              The
              %strong Thom spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi f
                  %annotation{:encoding => "application/x-tex"} M f
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi b
                    %mo →
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : b \to gl_1(R)
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushout"} (∞,1)-pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Σ
                              %mn ∞
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi R
                          %mtd
                            %mo →
                          %mtd
                            %mi R
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi Σ
                              %mn ∞
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi p
                          %mtd
                            %mo →
                          %mtd
                            %mi M
                            %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Sigma^\infty \Omega^\infty R &amp;\to&amp; R
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Sigma^\infty \Omega^\infty p &amp;\to&amp; M f
                    }
                    \\,,
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi f
                    %mo ≃
                    %mi P
                    %msub
                      %mo ∧
                      %mrow
                        %msub
                          %mi GL
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    M f \simeq P \wedge_{GL_1(R)} R
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              This means that a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi f
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} M f \to A
              is an
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_1(R)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} P \to A
            %p
              Notice that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{C}
              the
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \to GL_1(R)
              is the cocycle for a
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} P \to B
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} P \to A
              to some
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the A-
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"}> associated bundle
              \.
            %p
              Therefore the Thom spectrum may be thought of as co-
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representing
              spaces of sections of associated bundles
            %p
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi P
                    %msub
                      %mo ∧
                      %mrow
                        %msub
                          %mi GL
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(M f, A) \simeq \Gamma(P \wedge_{GL_1(R)} A)
              ”.
          %p This is made precise by the following statement.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn ∞
                            %msub
                              %mi Alg
                              %mi R
                            %mo{:stretchy => "false"} (
                            %mi M
                            %mi f
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo .
                            %mo .
                            %mo .
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo .
                            %mo .
                            %mo .
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_\infty Alg_R(M f, A) &amp;\stackrel{}{\to}&amp; (...)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\stackrel{}{\to}&amp; (...)
                    }
          %p
            This is (
            %a{:href => "#ABGHR"}> ABGHR, theorem 2.10
            ).
          %p
            This definition does subsume the
            %a{:href => "ForSphereBundles"} above
            definition of Thom spectra for
            %a.existingWikiWord{:href => "/nlab/show/sphere+bundles"} sphere bundles
            (hence also that for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R = S
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi b
                    %mo →
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon b \to gl_1(S)
              a cocycle for an
              = succeed "-bundle," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≔
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G \coloneqq \Omega^\infty g \colon B \to B GL_1(S)
            %p
              is the classifying map for a
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∈
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} B \in Top
            %p
              The Thom spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi f
                  %annotation{:encoding => "application/x-tex"} M f
              of def.
              %a.maruku-ref{:href => "#GeneralThomSpectrum"}
              is equivalent to the Thom spectrum of the spherical fibration, according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#ThomSpectrumForSphericalFibrations"}
          %p
            This is in (
            %a{:href => "#ABGHR"}> ABGHR, section 8
            ).
          %p Equivalently the Thom spectrum is characterized as follows:
          #ThomSpectrumAsHomotopyColimit.num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi R
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} \chi \colon X \to  R Line
              a map to the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-lines"} (∞,1)-lines
              inside
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} R Mod
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi lim
                      %mo →
                    %mrow
                      %mo (
                      %mi X
                      %mover
                        %mo →
                        %mi χ
                      %mi Pic
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi R
                      %mi Mod
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(\chi) \coloneqq
                    \\underset{\rightarrow}{\lim}
                    \\left(
                    X \stackrel{\chi}{\to} Pic(R) \hookrightarrow R Mod
                    \\right)
                    \\,.
            %p
              This construction evidently extendes to an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi R
                        %mi Line
                    %mo →
                    %mi R
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \colon \infty Grpd_{/R Line} \to R Mod
                    \\,.
          %p
            This is (
            %a{:href => "#ABG10"}> Ando-Blumberg-Gepner 10, def. 4.1
            ), reviewed also as (
            %a{:href => "#Wilson13"}> Wilson 13, def. 3.3
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              This is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module"} (∞,1)-module
              of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
              classified by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi χ
                      %mi Pic
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} X \stackrel{\chi}{\to} Pic(R) \hookrightarrow R Mod
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              we have for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi R
                      %mo ̲
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \underline{R} \colon X \to R Mod
              the trivial
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi R
                        %mi Mod
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo ,
                    %munder
                      %mi R
                      %mo ̲
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{[X, R Mod]}(\chi, \underline{R})
                    \\simeq
                    Hom_{R Mod}(\Gamma(\chi), R)
                    \\,.
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The section/Thom spectrum functor is the left
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Kan+extension"} (∞,1)-Kan extension
              of the canonical embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Line
                    %mo ↪
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Line \hookrightarrow R Mod
              along the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Line
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %mi R
                    %msup
                      %mi Line
                      %mi op
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi R
                        %mi Line
                  %annotation{:encoding => "application/x-tex"}
                    R Line \hookrightarrow [R Line^{op}, \infty Grpd]
                    \\simeq \infty Grpd_{/R Line}
            %p
              (where the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              on the right is given by the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi R
                        %mi Line
                    %mo →
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \infty Grpd_{/ R Line} \to R Mod
              which restricts along this inclusion to the canonical embedding.
          %p
            This observation appears as (
            %a{:href => "#Wilson13"}> Wilson 13, prop. 4.4
            ).
          %h2#properties Properties
          %h3#RingSpectrumStructure Ring spectrum structure
          %p
            The universal Thom spectrum, def.
            = succeed "," do
              %a.maruku-ref{:href => "#UniversalThomSpectrum"}
            %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            as follows.
          .num_prop
            %h6#proposition_9 Proposition
            %p There are canonical commuting diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi ℓ
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mi k
                            %mo ⊕
