            %p is a pullback square in some category then:
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f^\ast g
                  is a monomorphism;
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f^\ast g
                  is an isomorphism.
            %p
              On the other hand that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f^\ast g
              is a monomorphism does not imply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a monomorphism.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pasting+law+for+pullbacks"}> pasting law for pullbacks
                )
            %p In any category consider a diagram of the form
            %div{:style => "text-align: center"}
              %svg{:height => "87.679", :viewbox => "0 0 174.254 87.679", :width => "174.254", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
                %defs
