            %p There are three commuting squares: the two inner ones and the outer one.
            %p Suppose the right-hand inner square is a pullback, then:
            %p The square on the left is a pullback if and only if the outer square is.
          .proof
            %h6#proof Proof
            %p
              Pasting a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x \to a
              with the outer square gives rise to a commuting square over the (composite) bottom and right edges of the diagram. The square over the cospan in the left-hand inner square arising from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x \to a
              includes a morphism into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is a pullback induces the same commuting square over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo →
                    %mi e
                    %mo →
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d \to e \to f
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo →
                      %mi d
                    %annotation{:encoding => "application/x-tex"} c \to d
          .num_prop
            %h6#proposition_4 Proposition
            %p The converse implication does not hold: it may happen that the outer and the left square are pullbacks, but not the right square.
          .proof
            %h6#proof_2 Proof
            %p
              For instance let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} i\colon a \to b
              be a
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
              with
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi b
                    %mo →
                    %mi a
                  %annotation{:encoding => "application/x-tex"} p\colon b \to a
              and consider
            %div{:style => "text-align: center"}
