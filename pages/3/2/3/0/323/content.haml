          %p
            and
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is also called the
            = succeed "." do
              %strong pullback
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
            The last commutative square above is called a
            = succeed "." do
              %strong pullback square
          %p
            The concept of pullback is dual to the concept of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the same as a pushout in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %h4#nuts_and_bolts Nuts and bolts
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a category, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi a
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} f\colon a\to c
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi b
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} g\colon b\to c
            coterminal arrows in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            as below
