                                %mi Ψ
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi ω
                              %mo{:stretchy => "false"} )
                              %mi d
                              %mi t
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:displaystyle => "false"}
                            %msub
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
