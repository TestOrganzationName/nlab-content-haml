                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi t
                      %msup
                        %mi Ψ
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mo{:stretchy => "false"} )
