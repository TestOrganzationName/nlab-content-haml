                    \\\
                    X \times [0,1] &amp; \stackrel{\Psi}{\to} &amp; X
                    \\\
                    \\uparrow^{\mathrlap{(id,1)}} &amp; \nearrow_{\mathrlap{const_x}}
                    \\\
                    X
                    }
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is concentrated on the ground field in degree 0. Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              any closed form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
