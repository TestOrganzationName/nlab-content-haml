                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \leq N \in \mathbb{N}
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %strong real Stiefel manifold
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^N
              is the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            #eq:CosetRealization.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    V_k\big(\mathbb{R}^N\big)
                    \\;\coloneqq\;
                    O(N)/O(N-k)
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(N-k)
              is via the standard
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(N-k)\hookrightarrow O(N)
              as an upper right block.
          %p
          .num_remark
            %h6 Remark
            %p
              The canonical
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ↷
                    %msup
                      %mi ℝ
                      %mi N
                  %annotation{:encoding => "application/x-tex"} O(N) \curvearrowright \mathbb{R}^N
              induces a
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive action
              on the set of
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/linear+subspaces"} linear subspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k \subset \mathbb{R}^N
              equipped with an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal basis
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(N)
              is isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo −
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(N-k)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} W^\perp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N)
              is in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              to the set of
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^N
              equipped with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orthonormal+bases"} orthonormal bases
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.maruku-eqref{:href => "#eq:CosetRealization"} (1)
              serves to equip it naturally with the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          %p
            More generally, given any finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,\langle\ ,\ \rangle)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(V)
          %p
          #EOn.num_defn
            %h6 Definition
            %p
            %p
              By def.
              %a.maruku-ref{:href => "#StiefelManifold"}
              there are canonical inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi N
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N) \hookrightarrow V_k(\mathbb{R}^{N+1})
              that are compatible with the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              = succeed ")" do
                %a{:href => "Top#UniversalConstructions"} there
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi N
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E O(k)
                    \\;\coloneqq\;
                    \\underset{\longrightarrow}{\lim}_N
                    V_k(\mathbb{R}^N)
                    \\,.
            %p
          %p
            This is a model for the total space of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(k)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
          %h2#properties Properties
          %h3#homotopy_groups Homotopy groups
          %p
          #Connectedness.num_prop
            %h6 Proposition
            %p
              The Stiefel manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StiefelManifold"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo −
                        %mi k
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (N-k-1)
                  \-connected
          .proof
            %h6 Proof
            %p Observe that
            %ol
              %li
                %p
                  the coset coprojection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo −
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(N) \to O(N)/O(N-k)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                %p
                  (by
                  %a{:href => "orthogonal+group#OrthogonalGroupIsCompact"} this prop.
                  and
                  = succeed ")" do
                    %a{:href => "coset#QuotientProjectionForCompactLieSubgroupIsPrincipal"} this corollary
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  (hence:
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo −
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(N-k)
            %p
              so that we have a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    O(N-k)
                    \\longrightarrow
                    O(N)
                    \\longrightarrow
                    O(N)/O(N-k)
                    \\;\equiv\;
                    V_k(\mathbb{R}^N)
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              has, has the following structure in degrees strictly bounded above by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} N-k
              %a{:href => "orthogonal+group#InclusionOfOnIntoOkIsnMinus1Equivalence"} this prop
              (taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi N
                    %mo −
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n=N-k
              in the notation there):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi epi
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mn 0
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mn 0
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                        %mo −
                        %mn 1
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ∼
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                        %mo −
                        %mn 1
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\pi_{\bullet \lt N-k} O(N-k)
                    \\overset{epi}{\longrightarrow}
                    \\pi_{\bullet \lt N-k} O(N)
                    \\overset{0}{\longrightarrow}
                    \\pi_{\bullet \lt N-k} V_k(N)
                    \\overset{0}{\longrightarrow}
                    \\pi_{\bullet-1 \lt N-k-1} O(N-k)
                    \\overset{\sim}{\longrightarrow}
                    \\pi_{\bullet-1 \lt N-k-1} O(N)
                    \\to
                    \\cdots
                    \\,.
            %p
              This implies the claim. (Exactness of the sequence says that every element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi N
                        %mo −
                        %mi k
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{\bullet \lt N-k} V_k(\mathbb{R}^N)
              is in the kernel of zero, hence in the image of 0, hence is 0 itself.)
          %p
          .num_cor
            %h6 Corollary
            %p
              The colimiting space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi N
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E O(k) = \underset{\longleftarrow}{\lim}_N V_k(\mathbb{R}^N)
              from Def.
              %a.maruku-ref{:href => "#EOn"}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weakly+contractible+topological+space"} weakly contractible
          %p
          .proof
            %h6 Proof
            %p
              This follows from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#Connectedness"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi N
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N) \to V_k(\mathbb{R}^{N+1})
              are closed
              = succeed "-inclusions." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              %a.existingWikiWord{:href => "/nlab/show/compact+object#CompactObjectsInTop"} this Prop.
              together with the accompanying commentary there.
              %br/
          %h3#cwcomplex_structure CW-complex structure
          %p
          .num_prop
            %h6 Proposition
            %p
              The Stiefel manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N)
              admits the
              = succeed "]" do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#James59"} James 1959 p. 3
            = succeed "," do
              %a{:href => "#James76"} James 1976 p. 5 with p. 21
            = succeed "," do
              %a{:href => "#Hatcher02"} Hatcher 2002 p. 302
            = succeed ")" do
              %a{:href => "#Blaszczyk07"} Blaszczyk 2007
          %p#CellularInclusionOfStiefelManifolds
            And it should be true that with that cell structure the inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi N
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi V
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi N
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N) \hookrightarrow V_k(\mathbb{R}^{N+1})
            are subcomplex inclusions:
          %p
            According to
            = succeed "," do
              %a{:href => "#Yokota56"} Yokota 1956
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(k)\hookrightarrow SU(N)
            are cellular such that this is compatible with the group action (reviewed
            %a{:href => "http://web.stanford.edu/~kupers/liegroups.pdf"} here
            in 3.3 and 3.3.1). This implies that also the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(N) \to SU(N)/SU(N-k)
            is cellular (e.g.
            = succeed ")." do
              %a{:href => "#Hatcher02"} Hatcher 2002 p. 302
          %h3#relation_to_grassmannians_and_universal_bundles Relation to Grassmannians and universal bundles
          %p
            Similarly, the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Grassmannian+manifold"} Grassmannian manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi N
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Gr_k(\mathbb{R}^N)
                  \\;\coloneqq\;
                  O(N)/(O(k)\times O(N-k))
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi N
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi Gr
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  V_k(\mathbb{R}^N)
                  \\longrightarrow
                  Gr_k(\mathbb{R}^N)
          %p
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(k)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi N
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi ℝ
                    %mi k
                %annotation{:encoding => "application/x-tex"} V_k(\mathbb{R}^N) \times_{O(k)} \mathbb{R}^k
            a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            of
            %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo →
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} N \to \infty
            this gives a presentation of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(k)
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            and of the
            %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
            of rank
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ≃
                    %mi whe
                  %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gr_k(\infty)\simeq_{whe} B O(k)
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(k)
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            and for rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            vector bundles.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grassmannian+manifold"} Grassmannian manifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
          %h2#references References
          %p Named after:
          %ul
            %li#Stiefel35
              %a.existingWikiWord{:href => "/nlab/show/Eduard+Stiefel"}> Eduard Stiefel
              \:
              = succeed "," do
                %em
                  Richtungsfelder und Fernparallelismus in
                  = succeed "-dimensionalen" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %strong 8
              (1935/6) 3-51
          %p Further discussion:
          %ul
            %li#Saito55
              %p
                Yoshihiro Saito:
                = succeed "," do
                  %em On the homotopy groups of Stiefel manifolds
                %strong 6
                1 (1955) 39-45 &amp;lbrack;
                %a{:href => "http://projecteuclid.org/euclid.ojm/1353054734"}> euclid:ojm/1353054734
                \&amp;rbrack;
            %li#Yokota56
              %p
                I. Yokota,
                = succeed "," do
                  %em On the cells of symplectic groups
                %strong 32
                (1956) 399-400
            %li#James59
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"}> Ioan Mackenzie James
                \:
                = succeed "," do
                  %em Spaces associated with Stiefel manifolds
                = succeed "," do
                  %a{:href => "https://doi.org/10.1112/plms/s3-9.1.115"} doi:10.1112/plms/s3-9.1.115
                = succeed "&rbrack;" do
                  %a{:href => "https://webhomes.maths.ed.ac.uk/~v1ranick/papers/james4.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"}> Ioan Mackenzie James
                \:
                = succeed "," do
                  %em On the homotopy type of Stiefel manifolds
                %strong 29
                1 (1971)
            %li#James76
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"}> Ioan Mackenzie James
                \:
                = succeed "," do
                  %em The topology of Stiefel manifolds
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 1.2 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#Hatcher02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                \:
                = succeed "," do
                  %em Algebraic Topology
                = succeed "," do
                  %a{:href => "https://www.cambridge.org/gb/academic/subjects/mathematics/geometry-and-topology/algebraic-topology-1?format=PB&isbn=9780521795401"} ISBN:9780521795401
                = succeed "&rbrack;" do
                  %a{:href => "https://pi.math.cornell.edu/~hatcher/AT/ATpage.html"} webpage
            %li#Blaszczyk07
              %p
                Zbigniew Błaszczyk,
                %em
                  On cell decompositions of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(n)
                (2007) &amp;lbrack;
                %a{:href => "http://knm.mat.umk.pl/pliki/konferencje/zb_lsait3_2007.pdf"}> pdf
                \&amp;rbrack;
          %p See also:
          %ul
            %li
              Wikipedia:
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Stiefel_manifold"} Stiefel manifold
