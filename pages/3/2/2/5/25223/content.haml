                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi f
                          %mo :
                          %mi A
                          %mo →
                          %mi B
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi a
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi b
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi p
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi q
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} hId
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
