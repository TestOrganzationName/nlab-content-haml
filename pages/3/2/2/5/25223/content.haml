                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type}}{\Gamma \vdash \mathrm{puc}_{A, B}:\left(\sum_{R:A \times B \to \mathcal{P}(\mathbb{1})} \mathrm{isTotal}(R) \times \mathrm{isFunctional}(R)\right) \simeq (A \to B)}
          %p
            Because the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi 𝟙
                  %mo{:stretchy => "false"} )
