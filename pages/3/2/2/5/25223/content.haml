                          %mi a
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %msub
                        %mi refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma\vdash a:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, a)}{\Gamma\vdash K_A(a, p):\mathrm{Id}_{\mathrm{Id}_A(a, a)}(p, refl_A(a))}
          %h4#for_heterogeneous_identification_types_2 For heterogeneous identification types
          %p
            There is an axiom K for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identification+types"} heterogeneous identification types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
