            is also always a contractible type, with center of contraction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{refl}_A(a)
          %p
            Similarly, there is also an axiom K for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+heterogeneous+identification+types"} dependent heterogeneous identification types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ⊢
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
