                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi K
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
