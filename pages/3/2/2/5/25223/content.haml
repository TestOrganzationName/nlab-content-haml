            %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            = succeed "," do
