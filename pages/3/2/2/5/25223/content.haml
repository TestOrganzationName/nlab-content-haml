          %h3#uniqueness_of_identity_proofs Uniqueness of identity proofs
          %h4#for_identification_types For identification types
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            for
            %a.existingWikiWord{:href => "/nlab/show/identification+types"} identification types
            is given by the following rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi q
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} UIP
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; type \quad \Gamma \vdash a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \quad \Gamma \vdash q:\mathrm{Id}_A(a, b)}{\Gamma \vdash \mathrm{UIP}_A(a, b, p, q):\mathrm{Id}_{\mathrm{Id}_A(a, b)}(p, q)}
          %h4#for_heterogeneous_identification_types For heterogeneous identification types
          %p
            There is uniqueness of identity proofs for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identification+types"} heterogeneous identification types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi a
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi b
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi p
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi y
                          %mo :
                          %mi B
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi z
                          %mo :
                          %mi B
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi q
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} hId
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi r
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} hId
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} UIP
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo ,
                      %mi q
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} hId
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi p
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{
                  \\begin{array}{l}
                  \\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type} \\
                  \\Gamma \vdash  a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \quad \Gamma \vdash y:B \quad \Gamma \vdash z:B \\
                  \\Gamma \vdash q:\mathrm{hId}_{B}(a, b, p, y, z) \quad \Gamma \vdash r:\mathrm{hId}_{B}(a, b, p, y, z)
                  \\end{array}
                  }{\Gamma \vdash \mathrm{UIP}_{B}(a, b, p, y, z, q, r):\mathrm{Id}_{\mathrm{hId}_{B}(a, b, p, y, z)}(q, r)}
          %p
            Uniqueness of identity proofs for identification types follows from uniqueness of identity proofs for heterogeneous identification types by taking canonical element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} pt
                  %mo :
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathrm{pt}:\mathbb{1}
            of the
            %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi 𝟙
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} pt
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi 𝟙
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} pt
                    %mo ,
                    %mi{:mathvariant => "normal"} pt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}):\mathrm{Id}_{\mathbb{1}}(\mathrm{pt}, \mathrm{pt})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Id}_{A}(a, b) \simeq \mathrm{hId}_{A}(\mathrm{pt}, \mathrm{pt}, \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}), a, b)
          %p
            and because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hId}_{A}(\mathrm{pt}, \mathrm{pt}, \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}), a, b)
            is always a
            %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
            by uniqueness of identity proofs for heterogeneous identification types, it follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
