                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathrm{pt}:\mathbb{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
