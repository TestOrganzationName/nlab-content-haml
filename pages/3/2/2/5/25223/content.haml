          %h3#leibnizs_identity_of_indiscernibles Leibniz’s identity of indiscernibles
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
            %a.existingWikiWord{:href => "/nlab/show/Leibniz%27s+identity+of+indiscernibles"} Leibniz's identity of indiscernibles
            is given by the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} idOfInd
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
