            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi R
                      %mo :
                      %mi A
                      %mo ×
                      %mi B
                      %mo →
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} isTotal
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
