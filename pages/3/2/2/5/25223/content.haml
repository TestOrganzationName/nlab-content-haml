                      %mi f
                      %mo ,
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{
                  \\begin{array}{l}
                  \\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type} \\
                  \\Gamma \vdash f:A \to B \quad \Gamma \vdash a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \\
                  \\Gamma \vdash q:\mathrm{hId}_{B}(a, b, p, f(a), f(b))
                  \\end{array}
                  }{\Gamma \vdash K_{B}(f, a, b, p, q):\mathrm{Id}_{\mathrm{hId}_{B}(a, b, p, f(a), f(b))}(q, \mathrm{ap}_{B}(f, a, b, p))}
          %p
            Axiom K for identification types follows from axiom K for heterogeneous identification types by taking canonical element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} pt
                  %mo :
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathrm{pt}:\mathbb{1}
            of the
            %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟙
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi 𝟙
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} pt
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi 𝟙
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} pt
                    %mo ,
                    %mi{:mathvariant => "normal"} pt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}):\mathrm{Id}_{\mathbb{1}}(\mathrm{pt}, \mathrm{pt})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Id}_{A}(a, b) \simeq \mathrm{hId}_{A}(\mathrm{pt}, \mathrm{pt}, \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}), a, b)
          %p
            and because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hId
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hId}_{A}(\mathrm{pt}, \mathrm{pt}, \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}), a, a)
            is always a
            %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            with
            %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝟙
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{A}(f, \mathrm{pt}, \mathrm{pt}, \mathrm{refl}_{\mathbb{1}}(\mathrm{pt}))
            for element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝟙
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{1} \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Id
