            is also always a mere proposition.
          %h3#axiom_k Axiom K
          %h4#for_identification_types_2 For identification types
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/axiom+K+%28type+theory%29"} axiom K
            is given by the following rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi K
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
