                        %mi d
                        %mn 1
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(d_1 e) = g(d_1 e)
              %a.existingWikiWord{:href => "/nlab/show/graph"} induced subgraph
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              given by the equalizer vertex set.
            %p
              Moreover, every induced subgraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
              arises as an equalizer (consider the equalizer of the two embeddings of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              into the amalgamation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %msub
                        %mo +
                        %mi H
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G +_H G
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ↪
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
            %p
              Of course this is elementary, but we get much more: the quasitopos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
              is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              %a.existingWikiWord{:href => "/nlab/show/dependent+products"} dependent products
              can also be read off directly from how they work for presheaves.
          %p
            It is easy to describe
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monos
            and
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epis
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi SimpGph
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Gamma = \hom(1, -): SimpGph \to Set
            be the underlying vertex-set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          #EmbeddingOfSimpGphIntoSet.num_prop
            %h6#proposition Proposition
            %p
              The forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi SimpGph
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Gamma = \hom(1, -): SimpGph \to Set
              is faithful, in fact exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
              as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
          %p We omit the easy proof. Next we have two easy results:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflects
              monos and epis (because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is faithful).
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (because it has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              and a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo :
                  %mi SimpGph
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Gamma: SimpGph \to Set
            both preserves and reflects monos and epis. As a result, we can prove various simple exactness results in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
          .num_lemma
            %h6#lemma Lemma
            %p
              In
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SimpGph
                    %annotation{:encoding => "application/x-tex"} SimpGph
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of any mono is a mono.
          .proof
            %h6#proof_2 Proof
            %p
              Suppose we have a pushout diagram in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SimpGph
                    %annotation{:encoding => "application/x-tex"} SimpGph
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi mono
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi k
                        %mtr
                          %mtd
                            %mi G
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp; \to &amp; H \\
                    ^\mathllap{mono} \downarrow &amp; &amp; \downarrow^\mathrlap{k} \\
                    G' &amp; \to &amp; H'
                    }
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves both pushouts and monos, and since the pushout of a mono in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              is a mono, we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(k)
              is monic in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              reflects monos, this means
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is monic in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SimpGph
                    %annotation{:encoding => "application/x-tex"} SimpGph
          %p
            As already observed, there is a chain of adjoint functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mo ∇
                    %mo :
                    %mi Set
                    %mo →
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} \Delta \dashv \Gamma \dashv \nabla: Set \to SimpGph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            has a left adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi SimpGph
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Pi: SimpGph \to Set
            %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected components
            functor. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the simple graph consisting of two vertices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a, b
            with an edge between them, then there is a reflexive fork
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo :
                  %mn 1
                  %mo ⇉
                  %mi E
                  %mover
                    %mo →
                    %mo !
                  %mn 1
                %annotation{:encoding => "application/x-tex"} a, b: 1 \rightrightarrows E \stackrel{!}{\to} 1
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            is formed as a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
            of the induced diagram:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SimpGph
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SimpGph
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⇉
                  %mi SimpGph
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Π
                %annotation{:encoding => "application/x-tex"} SimpGph(1, -) \to SimpGph(E, -) \rightrightarrows SimpGph(1, -) \to \Pi
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Π
                    %mo ⊣
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Pi \dashv \Delta
              , and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves products.
          .proof
            %h6#proof_3 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves products because being a reflexive coequalizer, it is a
              %a.existingWikiWord{:href => "/nlab/show/sifted+colimit"} sifted colimit
              of product-preserving functors. For graphs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mi G
                    %mo :
                    %mi G
                    %mo →
                    %mi Δ
                    %mi Π
                    %mi G
                  %annotation{:encoding => "application/x-tex"} u G: G \to \Delta \Pi G
              which at the underlying vertex-set level sends a vertex to its connected component; if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is any set, then a graph map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi G
                    %mo →
                    %mi Δ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f: G \to \Delta S
              must send any two vertices with an edge between them to the same point, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mi u
                        %mi G
                    %mi Δ
                    %mi Π
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mi Δ
                        %mi g
                    %mi Δ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} G \stackrel{u G}{\to} \Delta \Pi G \stackrel{\Delta g}{\to} \Delta S
              for a unique map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi Π
                      %mi G
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} g: \Pi G \to S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo ⊣
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Pi \dashv \Delta
          %h3#equalizers_and_coequalizers Equalizers and coequalizers
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mover
                    %mo →
                    %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} f, g \colon G \stackrel{\to}{\to} H
            are maps in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi K
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} Eq(f, g) = i \colon K \to G
            is given at the vertex level by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(i) = Eq(\Gamma(f), \Gamma(g))
          %p
            and at the edge level by
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(x, y) \Leftrightarrow G(i(x), i(y))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                %annotation{:encoding => "application/x-tex"} x, y
            belong to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and there is an edge between them in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is
            %em full
            (at the edge level).
          %p
            Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is a regular mono in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SimpGph
                %annotation{:encoding => "application/x-tex"} SimpGph
            iff both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(i)
            is monic in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is full at the edge level (see Remark
            = succeed ")." do
              %a.maruku-ref{:href => "#quasitopos"}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coeq
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi H
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Coeq(f, g) = q \colon H \to Q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Coeq
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(q) = Coeq(\Gamma(f), \Gamma(g))
          %p
            and at the edge level by taking the image of the composite
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi H
                    %mo ↪
                    %mi Vert
                    %mo{:stretchy => "false"} (
                    %mi H
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi q
                          %mn 2
                    %mi Vert
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_H \hookrightarrow Vert(H)^2 \stackrel{q^2}{\to} Vert(Q)^2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %msub
                    %mo ∃
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mo ∧
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi y
                  %mo .
                %annotation{:encoding => "application/x-tex"} Q(x, y) \Leftrightarrow \exists_{u, v} H(u, v) \wedge q(u) = x \wedge q(v) = y.
          %p
            Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is a
            %a.existingWikiWord{:href => "/nlab/show/regular+epimorphism"} regular epimorphism
            if it is surjective at both the vertex and edge levels.
          %h3#ternary_factorization Ternary factorization
          %p
            The category of simple graphs has a
            %a.existingWikiWord{:href => "/nlab/show/ternary+factorization+system"} ternary factorization system
            as follows: each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} f \colon G \to H
            factors as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mover
                    %mo →
                    %mi q
                  %mi G
                  %mo ′
                  %mover
                    %mo →
                    %mi a
                  %mi H
                  %mo ′
                  %mover
                    %mo →
                    %mi i
                  %mi H
                %annotation{:encoding => "application/x-tex"} G \stackrel{q}{\to} G' \stackrel{a}{\to} H' \stackrel{i}{\to} H
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                is a surjection between vertex-sets and at the edge level, i.e., is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/regular+epi"} regular epi
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                induces an identity between vertex-sets (hence is
                = succeed ")," do
                  %span.newWikiWord
                    jointly monic and epic
                    %a{:href => "/nlab/new/bimorphism"} ?
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is given by an injection between vertex-sets and is full at the edge level, and (thus) is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/regular+mono"} regular mono
          %p
            The factorization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            followed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∘
                  %mi a
                %annotation{:encoding => "application/x-tex"} i \circ a
            is the (regular epi)-mono factorization, while the factorization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∘
                  %mi q
                %annotation{:encoding => "application/x-tex"} a \circ q
            followed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is the epi-(regular mono) factorization. (The fact that regular monos are stable under pushout, used to ensure that the epi-(regular mono) factorization is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
            = succeed "," do
              %em coregular category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi SimpGph
                    %mi op
                %annotation{:encoding => "application/x-tex"} SimpGph^{op}
            is
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
          %p In particular, we have the easy facts that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a mono iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                is a graph isomorphism: monos in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SimpGph
                    %annotation{:encoding => "application/x-tex"} SimpGph
                are simple graph maps that are injective on vertices and edges,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is an epi iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is a graph isomorphism: epis in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SimpGph
                    %annotation{:encoding => "application/x-tex"} SimpGph
                are simple graph maps that are surjective on vertices.
          %h3#subcategories Subcategories
          %p
            Graph theory suggests both full and wide subcategories of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SimpGph
                  %annotation{:encoding => "application/x-tex"} SimpGph
            %a.existingWikiWord{:href => "/nlab/show/the+category+of+simple+graphs+from+a+graph-theoretic+perspective"} the category of simple graphs from a graph-theoretic perspective
            for more details.
          %h3#natural_numbers_object Natural numbers object
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SimpGph
                %annotation{:encoding => "application/x-tex"} SimpGph
            has a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
