          %h2#idea Idea
          %p
            A
            %em Galois module
            %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            = succeed "-" do
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            for a
            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
            = succeed ";" do
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            If
            %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %em
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            then this is a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of
            %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and one speaks of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
          %p
            The category of
            = succeed "-modules" do
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/module"} modules
            over the
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group ring
            = succeed "." do
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[G]
          %p
            As always is the case, a group
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} G\times A\to A
            can equivalently be written as
            = succeed "." do
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\to Aut(A)
            = succeed "." do
              %em Galois representations
          %h2#properties Properties
          .num_proposition
            %h6#proposition Proposition
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ↪
                    %mi L
                  %annotation{:encoding => "application/x-tex"} K\hookrightarrow L
              be a
              %a.existingWikiWord{:href => "/nlab/show/Galois+extension"} Galois extension
              of a number field
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            %p
              Then the ring of integers
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi L
                  %annotation{:encoding => "application/x-tex"} O_L
              of this extension is a
              %a.existingWikiWord{:href => "/nlab/show/Galois+module"} Galois module
              of
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Gal
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ↪
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Gal(K\hookrightarrow L)
            %p
              (see also
              = succeed ")" do
                %span.newWikiWord
                  Hilbert-Speiser theorem
                  %a{:href => "/nlab/new/Hilbert-Speiser+theorem"} ?
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              (
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              \-adic representation)
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              be a prime number. Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ↪
                    %mover
                      %mi k
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gal(k\hookrightarrow \overline k)
              be the
              %a.existingWikiWord{:href => "/nlab/show/absolute+Galois+group"} absolute Galois group
              of a
              %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_18.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ↪
                    %mover
                      %mi k
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gal(k\hookrightarrow \overline k)\to Aut (M)
            %p
              is called an
              %em
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
                \-adic representation of
                = succeed "." do
                  %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Gal
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo ↪
                        %mover
                          %mi k
                          %mo ¯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Gal(k\hookrightarrow \overline k)
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                is either a unit dimensional
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                over the algebraic closure
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi ℚ
                          %mo ¯
                        %mi l
                    %annotation{:encoding => "application/x-tex"} \overline \mathbb{Q}_l
                or a finitely generated module over the
                %a.existingWikiWord{:href => "/nlab/show/integral+closure"} integral closure
                = succeed "." do
                  %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ℤ
                            %mo ¯
                          %mi l
                      %annotation{:encoding => "application/x-tex"} \overline \mathbb{Z}_l
            %p
              In particular the
              = succeed "-adic" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
          .num_example
            %h6#example_2 Example
            %p
              (
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              \-adic
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Tate+module"} Tate module
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              be a prime number. Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an abelian group. The
              %em
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
                \-adic Tate module
              is defined to be the limit
            .maruku-equation
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_29.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi l
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi lim
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi l
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_l(A)=lim_n \;ker (l^n)
            %p
              i.e. it is the
              %a.existingWikiWord{:href => "/nlab/show/directed+limit"} limit over the directed diagram
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(p^{n+1})\to ker(p^n)
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(p^n)
              of the multiplication-with-
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p^n
              map
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi n
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p^n:A\to A
              is called
              = succeed "-" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} p^n
              %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
              of
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_example
            %h6#example_3 Example
            %p
              (
              %em the
              Tate-module)
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi S
                  %annotation{:encoding => "application/x-tex"} k_S
              denote the separable closure of
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be the group of
              %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} roots of unity
              of
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi s
                  %annotation{:encoding => "application/x-tex"} k_s
              in
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-adic" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ↪
                    %msub
                      %mi k
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gal(k\hookrightarrow k_s)
              is called
              %em
                the
                = succeed "-adic" do
                  %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi l
                      %annotation{:encoding => "application/x-tex"} l
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              or the
              %em
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
                \-adic cyclotomic character of
                = succeed "." do
                  %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %p
              It is equivalently the Tate-module of the
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group+scheme"} multiplicative group scheme
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mu_k
            %p
              The Tate-module is endowed with the structure of a
              = succeed "-module" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mspace{:width => "thickmathspace"}
                      %mi modulo
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi a
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} z(a_n)_n=((z\; modulo\; p^n)a_n)_n
          .num_example
            %h6#example_4 Example
            %p
              (
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              \-adic
              %a.existingWikiWord{:href => "/nlab/show/Tate+module"} Tate module
              of an abelian variety)
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              be a prime number. Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be an
              %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian variety
              over a field
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi s
                  %annotation{:encoding => "application/x-tex"} k_s
              denote the separable closure of
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-valued" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi s
                    %annotation{:encoding => "application/x-tex"} k_s
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              assemble to an abelian group.
            %p
              Then there are classical results on the
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              of the Tate-module
              = succeed ":" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi l
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_l(G)
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a prime number
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mi l
                  %annotation{:encoding => "application/x-tex"} p\neq l
              we have that
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi l
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_l(G)
              is a free
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi l
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_l
              module of rank
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 2dim(G)
            %p
              A special case of the
              %a.existingWikiWord{:href => "/nlab/show/Tate+conjecture"} Tate conjecture
              can be formulated via Tate-modules:
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be finitely generated over its prime field of characteristic
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ≠
                      %mi l
                    %annotation{:encoding => "application/x-tex"} p\neq l
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A,B
              be two abelian varieties over
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_68.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi ℤ
                      %mi p
                    %mo ≃
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi l
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi T
                      %mi l
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hom(A,B)\otimes \mathbb{Z}_p\simeq hom(T_l(A),T_l(B))
            %p
              If
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a finite field or a number field the conjecture is true.
          .num_example
            %h6#example_5 Example
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/p-adic+cohomology"} l-adic cohomology
              of a smooth variety)
            %p
              Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              be a prime number. Let
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %span.newWikiWord
                smooth variety
                %a{:href => "/nlab/new/variety%7C"} ?
              over a field
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of characteristic prime to
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi s
                  %annotation{:encoding => "application/x-tex"} k_s
              denote the separable closure of
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              The
              = succeed "-adic" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is defined to be the directed limit
              = succeed "." do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mi n
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi H
                        %mi et
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi k
                            %mi s
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi l
                        %mi n
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} lim_n\; H^i_{et}(X_{k_s}, \mathbb{Z}/l^n\mathbb{Z})
            %p
              More specifically, given
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ↪
                    %msub
                      %mi k
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma\in Gal(k\hookrightarrow k_s)
              it acts on the
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi k
                          %mi s
                    %mo =
                    %mi X
                    %msub
                      %mo ⊗
                      %mi k
                    %msub
                      %mi k
                      %mi s
                  %annotation{:encoding => "application/x-tex"} X_{k_s}=X\otimes_k k_s
              via the second factor. This is an isomorphism, since
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is an automorphism, and hence
              %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \sigma^*
              on cohomology is an isomorphism.
            %p
              Note that since we have a equivalence
              = succeed "," do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi l
                      %mi A
                      %mo ≃
                      %msubsup
                        %mi H
                        %mi et
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mrow
                          %msub
                            %mi k
                            %mi s
                      %mo ,
                      %msub
                        %mi ℤ
                        %mi l
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∨
                    %annotation{:encoding => "application/x-tex"} T_l A\simeq H_{et}^1(A_{k_s}, \mathbb{Z}_l)^\vee
              %a.existingWikiWord{:href => "/nlab/show/Tate+module"} l-adic Tate module
              is a special case of the
              = succeed "-adic" do
                %math#mathml_839651cdb77c4b924036a3ffa340fd1cd4c5c752_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
