              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mi φ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \Sigma \times \{\varphi\}
            %p
              Therefore we may restrict without loss to the order-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              jets. By slight abuse of notation we still write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
