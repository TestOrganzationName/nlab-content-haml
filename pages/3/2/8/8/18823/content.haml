                    \\Gamma_\Sigma(E) &amp;\overset{p_K^k}{\longrightarrow}&amp;
                    [0,\infty)
                    \\\
                    \\Phi &amp;\mapsto&amp;  \underset{ {\vert \alpha\vert} \leq k}{max} \left( \underset{x \in K}{sup} {\vert \partial^\alpha \Phi(x)\vert}\right) \,,
                    }
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/absolute+values"} absolute values
              of the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              index by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              %a.maruku-eqref{:href => "#eq:PartialDerivativeWithManyIndices"} (?)
              with respect to any choice of
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            %p
              This makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              a
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} K \subset \Sigma
              any
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              then the sub-space of sections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi K
