                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo ,
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
