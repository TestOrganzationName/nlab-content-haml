                              %mi τ
                              %mi Σ
                            %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    LocObs(E)
                    \&amp;\overset{\tau_\Sigma}{\hookrightarrow}&amp;
                    Obs(E)
                    \\\
                    \\alpha &amp;\maptos&amp; \tau_\Sigma \alpha
                    }
                    \\,.
            %p
              This is a sub-vector space inside all observables which is however not closed under the pointwise product of observables
              %a.maruku-eqref{:href => "#eq:ObservablesPointwiseProduct"} (4)
              (unless
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} E=0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MultiLocObs
