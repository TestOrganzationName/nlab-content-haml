                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mphantom
                                  %mi A
                          %mtd
                            %mi Γ
                            %msub
                              %mo ′
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi s
