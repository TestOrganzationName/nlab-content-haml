            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                compatible with
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
            %p
