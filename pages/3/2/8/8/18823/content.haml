          .proof
            %h6#proof_7 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
