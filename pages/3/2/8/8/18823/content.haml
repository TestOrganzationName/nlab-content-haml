            %p
              for the restriction of the
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mi φ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \Sigma \times \{\varphi\}
            %p Explicitly, this means the following:
            %p
              First of all, by prop.
              %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
              the dependence of the Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
