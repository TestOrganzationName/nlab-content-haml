          #QuadraticObservables.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              whose
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/super+vector+bundle"} super
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              with itself, denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊠
                    %mi E
                    %mover
                      %mo →
                      %mrow
                    %mi Σ
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    E \boxtimes E \overset{}{\to} \Sigma \times \Sigma
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma \times \Sigma
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              with itself, whose
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over a pair of points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1,x_2)
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                    %mo ⊗
                    %msub
                      %mi E
                      %mrow
                        %msub
                          %mi x
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} E_{x_1} \otimes E_{x_2}
              of the corresponding field fibers.
            %p
              Given a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \in \Gamma_\Sigma(E)
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ⊠
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ×
                          %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ⊠
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi \boxtimes \phi \in \Gamma_{\Sigma \times \Sigma}(E \boxtimes E)
            %p
              We say that an
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    A \;\colon\; \Gamma_\Sigma(E) \longrightarrow \mathbb{C}
            %p
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic
              if it comes from a “graded-symmetric
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              observable”, namely a smooth function on the
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of
              the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              with itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ×
                        %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ⊠
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                    %mo ⟶
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    B
                    \\;\colon\;
                    \\Gamma_{\Sigma \times \Sigma}(E \boxtimes E)_{\delta_{EL}\mathbf{L} = 0}
                    \\longrightarrow
                    \\mathbb{C}
                    \\,,
            %p as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo ,
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(\Phi) = B(\Phi,\Phi)
                    \\,.
            %p
              More explicitly: By prop.
              %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              the quadratic observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is given by a
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              %a.existingWikiWord{:href => "/nlab/show/distribution+of+two+variables"} of two variables
              which in the notation of remark
              %a.maruku-ref{:href => "#LinearObservablesAsGeneralizedFunctions"}
              comes from a graded-symmetric
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              of
              %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %msub
                          %mi a
                          %mn 2
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mi Σ
                    %mo ,
                    %mi E
                    %mo ⊠
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta_{a_1 a_2} \in \mathcal{E}'(\Sigma \times \Sigma, E \boxtimes E)
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %mi Σ
                        %mo ×
                        %mi Σ
                    %msub
                      %mi β
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %msub
                          %mi a
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Φ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msup
                      %mi Φ
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(\Phi)
                    \\;=\;
                    \\int_{\Sigma \times \Sigma}
                    \\beta_{a_1 a_2}(x_1,x_2)
                    \\Phi^{a_1}(x_1) \cdot \Phi^{a_2}(x_2)\, dvol_\Sigma(x_1) dvol_\Sigma(x_2)
                    \\,.
            %p
              This notation makes manifest how the concept of quadratic observables is a generalization of that of
              %a.existingWikiWord{:href => "/nlab/show/quadratic+forms"} quadratic forms
              coming from
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
          #PolynomialObservables.num_defn
