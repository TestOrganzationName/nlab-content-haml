              between
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0 \vert 1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_{(-)}
              of the space of observables and smooth functionss out of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0 \vert 1}
              with the
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ×
                        %msub
                          %mi S
                          %mi odd
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} ]
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mo ×
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ×
                        %msub
                          %mi S
                          %mi odd
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\mathbb{R}^{0\vert 1}
                    \\overset{ A_{(-)} }{\longrightarrow}
                    [ \Gamma_\Sigma(\Sigma \times S_{odd}), \mathbb{C} ]
                    }
                    {
                    \\mathbb{R}^{0 \vert 1} \times \Gamma_\Sigma(\Sigma \times S_{odd})
                    \\longrightarrow
                    \\mathbb{C}
                    }
            %p
              Moreover, by prop.
              %a.maruku-ref{:href => "#DiracSpaceOfFieldHistories"}
              we have that the coordinate functions on the space of field histories of the Dirac bundle are given by the field observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ψ
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Psi}^\alpha(x)
              regarded in odd degree. Now a homomorphism as above has to pull back the even coordinate function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              to even coordinate functions on this Cartesian product, hence to joint even powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ψ
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Psi}^\alpha(x)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Next we discuss the restriction of these off-shell polynomial observables to the
            %a.existingWikiWord{:href => "/nlab/show/shell"} shell
            to yield
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            polynomial observables, characterized by theorem
            %a.maruku-ref{:href => "#LinearObservablesForGreeFreeFieldTheoryAreDistributionalSolutionsToTheEquationsOfMotion"}
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#PolynomialOnShellObservablesAreDistributionalSolutionsToTheEquationsOfMotion
            %strong Polynomial on-shell Observables and Distributional solutions to PDEs
          %p
            The evident
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            version of def.
            %a.maruku-ref{:href => "#PolynomialObservables"}
            is this:
          #PolynomialObservablesOnShell.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FreeFieldTheory"}
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mo ↪
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L} = 0} \hookrightarrow \Gamma_\Sigma(E)
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Observable"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    A \;\colon\; \Gamma_\Sigma(E) \longrightarrow \mathbb{C}
            %p
              is an
              %em
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
              if it is the
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              of an
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi off
                  %annotation{:encoding => "application/x-tex"} A_{off}
              according to def.
              = succeed ":" do
                %a.maruku-ref{:href => "#PolynomialObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo =
                                %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi A
                                %mi A
                                %mphantom
                                  %mi A
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi A
                                    %mi off
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_{\Sigma}(E)_{\delta_{EL}\mathbf{L} = 0} &amp;\overset{\phantom{A}A\phantom{A}}{\longrightarrow}&amp; \mathbb{C}
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{A_{off}}}
                    \\\
                    \\Gamma_\Sigma(E)
                    }
                    \\,.
            %p
              Similarly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/linear+observable"} linear observable
              or
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              etc. if it is the
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              of a
              %a.existingWikiWord{:href => "/nlab/show/linear+observable"} linear observable
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              = succeed "." do
                %a.maruku-ref{:href => "#PolynomialObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E,\mathbf{L}) \hookrightarrow Obs(E,\mathbf{L})
            %p for the subspace of polynomial on-shell observables inside all on-shell observables, and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    LinObs(E,\mathbf{L}) \hookrightarrow Obs(E,\mathbf{L})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E,\mathbf{L})_{reg} \hookrightarrow Obs(E,\mathbf{L})
            %p etc.
          %p
            While by def.
            %a.maruku-ref{:href => "#PolynomialObservablesOnShell"}
            every
            %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            induces an
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            simply by
            %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:OffShellObservablesRestrictToOnShellObservables"} (2)
            %em same
            on-shell observable. It is therefore useful to find a condition on off-shell observables that makes them equivalent to on-shell observables under restriction.
          %p
            We now discuss such precise characterizations of the off-shell polynomial observables for the case of sufficiently well behaved
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            – namely
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic differential equations
            %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
            below. The main result is theorem
            %a.maruku-ref{:href => "#LinearObservablesForGreeFreeFieldTheoryAreDistributionalSolutionsToTheEquationsOfMotion"}
            below.
          %p
            While in general the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            are not
            %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic
            – namely not in the presence of implicit
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            discussed in
            %em
              %a{:href => "#GaugeSymmetries"} Gauge symmetries
            below – it turns out that up to a suitable notion of
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            they are equivalent to those that are; this we discuss in the chapter
            %em
              %a{:href => "#GaugeFixing"} Gauge fixing
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #DistributionalDerivatives.num_defn
            %h6#definition_8 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derivatives+of+distributions"} derivatives of distributions
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/distributional+solutions+of+PDEs"} distributional solutions of PDEs
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"} formally adjoint differential operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %msup
                      %mi P
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P, P^\ast \colon \Gamma_\Sigma(E) \to \Gamma_\Sigma(E^\ast)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} distributional derivative
              of a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \Gamma'_\Sigma(E)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DistributionalSections"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the distributional section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi u
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P u \in \Gamma'_\Sigma(E^\ast)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi u
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P u
                    \\;\coloneqq\;
                    u(P^\ast(-)) \;\colon\; \Gamma_{\Sigma,cp}(E^\ast)
                    \\,.
            %p If
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi u
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P u = 0 \;\in\; \Gamma'_\Sigma(E^\ast)
            %p
              then we say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a
              %a.existingWikiWord{:href => "/nlab/show/distributional+solution"} distributional solution
              (or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+solution"} generalized solution
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
          #DistributionalPDESolutionsFromOrdinaryPDESolutions.num_example
            %h6#example_4 Example
            %p
              %strong
                (ordinary
                %a.existingWikiWord{:href => "/nlab/show/PDE"} PDE
                solutions are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+solutions+of+a+PDE"} generalized solutions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %msup
                      %mi P
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P, P^\ast \colon \Gamma_\Sigma(E) \to \Gamma_\Sigma(E^\ast)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"} formally adjoint differential operators
            %p
              Then for every
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distributional section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi Φ
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_{\Phi} \in \Gamma'_{\Sigma}(E^\ast)
              coming from an actual smooth section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_\Sigma(E)
              via prop.
              %a.maruku-ref{:href => "#NonSingularDistributionalSections"}
              the
              %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} derivative of distributions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DistributionalDerivatives"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mi u
                      %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi u
                      %mrow
                        %mi P
                        %mi Φ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P u_\Phi \;=\; u_{P \Phi}
                    \\,.
            %p
              In particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi Φ
                  %annotation{:encoding => "application/x-tex"} u_\Phi
              is a
              %a.existingWikiWord{:href => "/nlab/show/generalized+solution+of+a+PDE"} distributional solution
              to the
              %a.existingWikiWord{:href => "/nlab/show/PDE"} PDE
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is an ordinary solution:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mi u
                      %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mphantom
                      %mi AAA
                    %mo ⇔
                    %mphantom
                      %mi AAA
                    %mi P
                    %mi Φ
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P u_\Phi \;=\; 0
                    \\phantom{AAA}
                    \\Leftrightarrow
                    \\phantom{AAA}
                    P \Phi = 0
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in \Gamma_{\Sigma,cp}(E)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi P
                            %msub
                              %mi u
                              %mi Φ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi u
                              %mi Φ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi P
                              %mo *
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ∫
                            %mi u
                            %mo ⋅
                            %msup
                              %mi P
                              %mo *
                            %mi b
                            %mspace{:width => "thinmathspace"}
                            %mi dvol
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ∫
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi b
                            %mspace{:width => "thinmathspace"}
                            %mi dvol
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi u
                              %mrow
                                %mi P
                                %mi Φ
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (P u_\Phi)(b)
                    \&amp; =
                    u_\Phi(P^\ast b)
                    \\\
                    \&amp; =
                    \\int u \cdot P^\ast b \, dvol
                    \\\
                    \&amp; =
                    \\int (P u) \cdot b \, dvol
                    \\\
                    \&amp; =
                    u_{P \Phi}(b)
                    \\end{aligned}
            %p
              where all steps are by the definitions except the third, which is by the definition of
              %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally adjoint differential operator
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              and the
              %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#StokesTheorem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\Phi,b)
              in def.
              %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              does not contribute to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integral"} integral
          #AdvancedAndRetardedGreenFunctions.num_defn
            %h6#definition_9 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+Green+functions"} advanced and retarded Green functions
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \;\colon\;\Gamma_\Sigma(E) \to \Gamma_\Sigma(E^\ast)
              be a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialOperator"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/space+of+smooth+sections"} space of smooth sections
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mo ±
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{G}_{P,\pm}
                    \\;\colon\;
                    \\Gamma_{\Sigma, cp}(E^\ast)
                    \\longrightarrow
                    \\Gamma_{\Sigma, \pm cp}(E)
            %p
              from
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+smooth+sections"} spaces of smooth sections
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              to spaces of sections of causally sourced future/past support (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/advanced+or+retarded+Green+function"} advanced or retarded Green function
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %ol
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Φ
                        %mo ∈
                        %msub
                          %mi Γ
                          %mrow
                            %mi Σ
                            %mo ,
                            %mi cp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_{\Sigma,cp}(E_1)
                  we have
                #eq:AdvancedRetardedGreenFunctionIsLeftInverseToDiffOperator.maruku-equation
                  %span.maruku-eq-number (7)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo ,
                            %mo ±
                        %mo ∘
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Φ
                      %annotation{:encoding => "application/x-tex"}
                        G_{P,\pm} \circ P(\Phi) = \Phi
                %p and
                #eq:AdvancedRetardedGreenFunctionIsRightInverseToDiffOperator.maruku-equation
                  %span.maruku-eq-number (8)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo ∘
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo ,
                            %mo ±
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Φ
                      %annotation{:encoding => "application/x-tex"}
                        P \circ G_{P,\pm}(\Phi) = \Phi
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/support"} support
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo ,
                            %mo ±
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_{P,\pm}(\Phi)
                  is in the
                  %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
                  or
                  %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
                  of the support of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Φ
                        %annotation{:encoding => "application/x-tex"} \Phi
            %p
              If the advanced/retarded Green functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mrow
                        %mi P
                        %mo ±
                  %annotation{:encoding => "application/x-tex"} G_{P\pm}
              exists, then the difference
            #eq:CausalGreenFunction.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                    %mo ≔
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo −
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{G}_P \coloneqq \mathrm{G}_{P,+} - \mathrm{G}_{P,-}
            %p
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Green+hyperbolic+differential+equation#Baer14}"} Bär 14, def. 3.2, cor. 3.10
          #GreenHyperbolicDifferentialOperator.num_defn
            %h6#definition_10 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"}> Green hyperbolic differential equation
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#NormallyHyperbolicDifferentialOperator"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P
                    \\;\colon\;
                    \\Gamma_\Sigma(E)
                    \\longrightarrow
                    \\Gamma_{\Sigma}(E^\ast)
            %p
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic differential operator
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              as well as its
              %a.existingWikiWord{:href => "/nlab/show/formal+adjoint+differential+operator"} formal adjoint differential operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P^\ast
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+Green+functions"} advanced and retarded Green functions
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
          %p
            (
            %a{:href => "Green+hyperbolic+partial+differential+equation##Baer14}"}> Bär 14, def. 3.2
            ,
            = succeed ")" do
              %a{:href => "Green+hyperbolic+partial+differential+equation#Khavkine14"} Khavkine 14, def. 2.2
          %p
            The two archtypical examples of
            %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic differential equations
            are the
            %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            and the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+Green+functions"} advanced and retarded Green functions
            for these, we will work these out in detail below in
            = succeed "." do
              %em
                %a{:href => "#Propagators"} Propagators
          #GreenHyperbolicKleinGordonEquation.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                is a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic differential equation
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
              %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EquationOfMotionOfFreeRealScalarField"}
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic differential equation
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
              %a.existingWikiWord{:href => "/nlab/show/formal+adjoint+differential+operator"} formally self-adjoint
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#FormallySelfAdjointKleinGordonOperator"}
          %p
            (e. g.
            = succeed "," do
              %a{:href => "Klein-Gordon+equation#BaerGinouxPfaeffle07"} Bär-Ginoux-Pfaeffle 07
            = succeed ")" do
              %a{:href => "#Baer14"} Bär 14, example 3.3
          #GreenHyperbolicDiracOperator.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic
            %p
              The
