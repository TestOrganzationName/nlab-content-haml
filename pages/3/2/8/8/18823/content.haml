                    }
          %p
            (
            %a{:href => "Green+hyperbolic+differential+equation#Baer14}"}> Bär 14, lemma 2.15
            )
          #DistributionsWithCausalSupports.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong (distribution dualities with causally restricted supports)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %p
              Then there are the following
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
              between a)
              %a.existingWikiWord{:href => "/nlab/show/dual+spaces"} dual spaces
              of
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
              with restricted causal support (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              %a.maruku-ref{:href => "#TVSStructureOnSpacesOfSmoothSections"}
              and b) spaces of distributional sections with restricted supports, according to def.
              = succeed ":" do
                %a.maruku-ref{:href => "#DistributionalSections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msup
                              %mo{:stretchy => "false"} )
