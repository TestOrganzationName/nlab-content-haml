                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma}(E) \to \mathbb{R}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/derivative+of+a+distribution"} derivatives
                  of
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/delta-distribution"} delta
                  %a.existingWikiWord{:href => "/nlab/show/functional"} functional
                  on
                  %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
                %td{:style => "text-align: left;"}
                  def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#Observable"}
                  %a.maruku-ref{:href => "#PointEvaluationObservables"}
              %tr
                %td{:style => "text-align: left;"}
                  averaging of
                  %a.existingWikiWord{:href => "/nlab/show/field+observable"} field observable
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi α
                          %mo *
