                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi EL
                    %mi b
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Phi_{(-)})^\ast d \mathcal{S}_{b \mathbf{L}}
                    \\;=\;
                    \\int_\Sigma
                    j^\infty_\Sigma(\Phi_{(-)})^\ast (  \delta_{EL}  b \mathbf{L} )
                    \\,.
            %p
              By the assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
