            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Observable"}
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
                  (def.
