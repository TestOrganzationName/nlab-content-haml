                  %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma(\Phi_{(-)})^\ast (  \delta_{EL}   \mathbf{L} )
              vanish, which is the statement of the Euler-Lagrange equations of motion.
          #LocalObservables.num_defn
            %h6#definition_14 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+observables"}> local observables
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              are the
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal p+1-forms
            %ol
              %li
                %p
                  of compact spacetime support (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SpacetimeSupport"}
              %li
                %p
                  modulo
                  %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivatives"} total spacetime derivatives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi ℰ
                          %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    LocObs(E)
                    \\;\coloneqq\;
                    \\left(\Omega^{p+1,0}_{\Sigma,cp}(E)/(im(d))\right)\vert_{\mathcal{E}^\infty}
            %p
              which we may identify with the subspace of all observables
              %a.maruku-eqref{:href => "#eq:GlobalObservables"} (1)
              that arises as the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              under
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \tau_\Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/functionals"} functionals
              on the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:OnShellFieldHistories"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
