              we have the identification
              %a.maruku-eqref{:href => "#eq:LinearDualOfSolutionSpaceIsLinearDualOfFullSpaceModuloImageOfDifferentialOperator"} (15)
              %a.maruku-eqref{:href => "#eq:LinearOnShellObservablesAreLinearOffShellobservableModuloTheEquationsOfMotion"} (16)
            #eq:RegularLinearObservablesAreCompactlySupportedSectionsModuloImageOfP.maruku-equation
              %span.maruku-eq-number (19)
