                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                  of
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                  of
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %td{:style => "text-align: left;"}
                  def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                  %a.maruku-ref{:href => "#JetProlongation"}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/field+observable"} field observable
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Φ
                          %mi a
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{\Phi}^a(x)
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Φ
                          %mi a
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} \partial_{\mu} \mathbf{\Phi}^a(x),
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
