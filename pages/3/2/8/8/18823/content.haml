          #ActionFunctional.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo ⟶
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\longrightarrow} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
