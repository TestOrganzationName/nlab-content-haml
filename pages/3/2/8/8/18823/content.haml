                                %mo{:stretchy => "false"} |
                                %msup
                                  %mo ∂
                                  %mi α
                                %mi Φ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} |
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
