                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma,cp}(E^\ast) \to Obs(E_{scp},\mathbf{L})
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/operator-valued+distribution"} observable-valued distribution
                %td{:style => "text-align: left;"}
                  def.
                  %a.maruku-ref{:href => "#RegularLinearFieldObservables"}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mi Obs
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi μ
                              %mi c
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mo ⋆
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \left( Obs(E,\mathbf{L})_{\mu c},\, \star\right)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                        %mi Alg
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}Alg
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/non-commutative+algebra"} non-commutative algebra
                  %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                  on
                  %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
                %td{:style => "text-align: left;"}
                  def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#WickAlgebraOfFreeQuantumField"}
                  %a.maruku-ref{:href => "#GeneratingFunctionsForCorrelationFunctions"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            There are various further conditions on
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            which we will eventually consider, forming subspaces of
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariant"} gauge invariant
              observables
            (def.
            = succeed ")," do
              %a.maruku-ref{:href => "#GaugeInvariantFunctionsIntermsOfLieAlgebroids"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            (def.
            %a.maruku-ref{:href => "#LocalObservables"}
            below),
            %em Hamiltonian local observables
            (def.
            %a.maruku-ref{:href => "#HamiltonianLocalObservables"}
            below) and
            %em
              %a.existingWikiWord{:href => "/nlab/show/microcausal+functional"} microcausal observables
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#MicrocausalFunctionals"}
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            (not just the
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            subspace), called the
            = succeed "." do
              %em off-shell observables
          %p
            In the case that the
            %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            is a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            (example
            = succeed ")," do
              %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
            %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            is canonically a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            and hence it makes sense to consider
            %em
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
            off-shell observables, i.e. those observables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mi Φ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi c
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi Φ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(c \Phi) = c A(\Phi)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 1
                    %mo +
                    %msub
                      %mi Φ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(\Phi_1 + \Phi_2) = A(\Phi_1) + A(\Phi_2)
            %em
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
            in the sense of
            %a.existingWikiWord{:href => "/nlab/show/Laurent+Schwartz"} Laurent Schwartz
            (prop.
            %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
            below). This fact makes powerful tools from
            %a.existingWikiWord{:href => "/nlab/show/functional+analysis"} functional analysis
            and
            %a.existingWikiWord{:href => "/nlab/show/microlocal+analysis"} microlocal analysis
            available for the analysis of
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            (discussed
            = succeed ")." do
              %a{:href => "#MicrolocalAnalysisAndUltravioletDivergence"} below
          %p
            More generally there are the
            %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear
            off-shell observables, and these are analogously given by
            %em
              %a.existingWikiWord{:href => "/nlab/show/distributions+of+several+variables"} distributions of several variables
            (def.
            %a.maruku-ref{:href => "#PolynomialObservables"}
            below). In fully
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            one considers only the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            and in this case all
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            are in fact given by such multilinear observables (def.
            %a.maruku-ref{:href => "#LocalObservablesOnInfinitesimalNeighbourhood"}
            below).
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FreeFieldTheory"}
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            are given by a
            %a.existingWikiWord{:href => "/nlab/show/linear+differential+operator"} linear differential operator
            which behaves well in that it is “
            %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"}> Green hyperbolic
            ” (def.
            %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
            below) it follows that the actual
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
            are equivalently those off-shell observables which are
            %em
              spatially
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/distributional+solution+of+a+PDE"} distributional solutions
            to the
            %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally adjoint
            %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
            (prop.
            %a.maruku-ref{:href => "#DistributionsOnSolutionSpaceAreTheGeneralizedPDESolutions"}
            below); and this equivalence is exhibited by
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            with the
            %em
              %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
            (def.
            %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
            below):
          %p
            This is theorem
            %a.maruku-ref{:href => "#LinearObservablesForGreeFreeFieldTheoryAreDistributionalSolutionsToTheEquationsOfMotion"}
            below, which is pivotal for passing from
            %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext polynomial
                        %mtr
                          %mtd
                            %mtext on-shell
                        %mtr
                          %mtd
                            %mtext observables
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo }
                  %munderover
                    %mo ⟵
                    %mo ≃
                    %mtext restriction
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext polynomial
                        %mtr
                          %mtd
                            %mtext off-shell
                        %mtr
                          %mtd
                            %mtext observables
                        %mtr
                          %mtd
                            %mtext modulo equations of motion
                    %mo }
                  %munderover
                    %mo ⟵
                    %mo ≃
                    %mtext causal propagator
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext spatially compactly supported
                        %mtr
                          %mtd
                            %mtext distributions in several variables
                        %mtr
                          %mtd
                            %mtext which are distributional solutions
                        %mtr
                          %mtd
                            %mtext to the adjoint equations of motion
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\,\,
                  \\array{
                  \\text{polynomial}
                  \\\
                  \\text{on-shell}
                  \\\
                  \\text{observables}
                  }
                  \\,\,
                  \\right\}
                  \\underoverset{\simeq}{\text{restriction}}{\longleftarrow}
                  \\left\{
                  \\array{
                  \\text{polynomial}
                  \\\
                  \\text{off-shell}
                  \\\
                  \\text{observables}
                  \\\
                  \\text{modulo equations of motion}
                  }
                  \\right\}
                  \\underoverset{\simeq}{\text{causal propagator}}{\longleftarrow}
                  \\left\{
                  \\array{
                  \\text{spatially compactly supported}
                  \\\
                  \\text{distributions in several variables}
                  \\\
                  \\text{which are distributional solutions}
                  \\\
                  \\text{to the adjoint equations of motion}
                  }
                  \\right\}
          %p
            This fact makes, in addition, the distributional analysis of
            %a.existingWikiWord{:href => "/nlab/show/linear+differential+equations"} linear differential equations
            available for the analysis of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
            %em
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagators"} Feynman propagators
            (def.
            %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            below), which we turn to in
            %em
              %a{:href => "#Propagators"} Propagators
            below.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/functional+analysis"} functional analysis
            and
            %a.existingWikiWord{:href => "/nlab/show/microlocal+analysis"} microlocal analysis
            (
            %a{:href => "#MicrolocalAnalysisAndUltravioletDivergence"}> below
            ) of linear
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            re-expressed in
            %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution theory
            via theorem
            %a.maruku-ref{:href => "#LinearObservablesForGreeFreeFieldTheoryAreDistributionalSolutionsToTheEquationsOfMotion"}
            solves the issues that the original formulation of
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            by
            %a.existingWikiWord{:href => "/nlab/show/Schwinger-Tomonaga-Feynman-Dyson"} Schwinger-Tomonaga-Feynman-Dyson
            in the 1940s was notorious for suffering from (
            %a{:href => "Schwinger-Tomonaga-Feynman-Dyson#Feynman85SuchABunchOfWords"}> Feynman 85
            ): The
            %a.existingWikiWord{:href => "/nlab/show/normal+ordered+product"} normal ordered product
            of quantum observables in a
            %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            of observables follows from
            %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            for the
            %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
            to be well-defined (this we discuss in
            %em
              %a{:href => "#FreeQuantumFields"} Free quantum fields
            below) and the
            %em
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            freedom in the construction of the
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            is governed by the mechanism of
            %em
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
            (this we discuss in
            %em
              %a{:href => "#Renormalization"} Renormalization
            below).
          %p
            Among the polynomial on-shell observables characterized this way, the focus is furthermore on the
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
          %p
            In
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local field theory
            the idea is that both the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            as well as the observations are fully determined by their restriction to
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhoods"} infinitesimal neighbourhoods
            of spacetime points (
            %a.existingWikiWord{:href => "/nlab/show/events"}> events
            ). For the equations of motion this means that they are
            %a.existingWikiWord{:href => "/nlab/show/partial+differential+equations"} partial differential equations
            as we have seen
            = succeed "." do
              %a{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"} above
            %em at any point
            of spacetime. Now a “smooth function of the value of the field histories and their derivatives at any point” is precisely a smooth function on the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of the
            %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#JetProlongation"}
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            = succeed ")." do
              %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
          %p
            In mathematical terminology these desiderata say that the
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            in a local field theory should be precisely the “
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"}> transgressions
            ” (def.
            %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
            below) of horizontal variational
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime+support"} spacetime support
            %a.maruku-ref{:href => "#SpacetimeSupport"}
            below) to the
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            (example
            = succeed ")." do
              %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
            %a.maruku-ref{:href => "#LocalObservables"}
            below.
          %p
            A key example of a
            %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            in
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (example
            %a.maruku-ref{:href => "#ActionFunctional"}
            below). This is the
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
            of the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            itself, or rather of its product with an “
            %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
            function” that localizes its
            %a.existingWikiWord{:href => "/nlab/show/support"} support
            in a compact spacetime region. In typical cases the physical quantity whose observation is represented by the action functional is the difference of the
            %a.existingWikiWord{:href => "/nlab/show/kinetic+energy"} kinetic
            energy-momentum minus the
            %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
            of a field history averaged over the given region of spacetime.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            say that those field histories are physically realized which are
            %a.existingWikiWord{:href => "/nlab/show/critical+points"} critical points
            of this
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            observable. This is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/principle+of+extremal+action"} principle of extremal action
            (prop.
            %a.maruku-ref{:href => "#PrincipleOfExtremalAction"}
            below).
          %p In summary we find the following system of types of observables:
          %div
            %p
              %strong>
                %a.existingWikiWord{:href => "/nlab/show/types"} types
                of
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                in
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
              \:
            .maruku-equation
              %math#mathml_dc72fc1ac31759c80d4dd998a660470e72d5ea5d_1.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mtext local
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mtext field
                          %mtd
                            %mo ⟶
                          %mtd
                            %mtext linear
                          %mtd
                            %mo ⟶
                          %mtd
                            %mtext microcausal
                          %mtd
                            %mo ⟶
                          %mtd
                            %mtext polynomial
                          %mtd
                            %mo ⟶
                          %mtd
                            %mtext general
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mtext regular
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    \\text{local}
                    \\\
                    \&amp;&amp;
                    \&amp; \searrow
                    \\\
                    \\text{field}
                    \&amp;\longrightarrow&amp;
                    \\text{linear}
                    \&amp;\longrightarrow&amp;
                    \\text{microcausal}
                    \&amp;\longrightarrow&amp;
                    \\text{polynomial}
                    \&amp;\longrightarrow&amp;
                    \\text{general}
                    \\\
                    \&amp;&amp;
                    \&amp; \nearrow
                    \\\
                    \&amp;&amp;
                    \\text{regular}
                    }
          %p
            In the chapter
            %em
              %a{:href => "#FreeQuantumFields"} Free quantum fields
            we will see that the space of all
            %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
            is too large to admit
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            is too small to contain the usual
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            terms for
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#RegularPolynomialLocalObservablesAreNecessarilyLinear"}
            %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
            (def.
            %a.maruku-ref{:href => "#MicrocausalObservable"}
            below) is in between these two extremes, and evades both of these obstacles.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Given the concept of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            to be in some definite
            %em
              %a.existingWikiWord{:href => "/nlab/show/state"} state
            so that the
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            quantities take some definite value, reflecting the properties of that state.
          %p
            Whatever formalization for
            %em
              %a.existingWikiWord{:href => "/nlab/show/states"} states
            of a
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            one considers, at the very least the
            %a.existingWikiWord{:href => "/nlab/show/space+of+states"} space of states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi States
                %annotation{:encoding => "application/x-tex"} States
            should come with a pairing
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Obs
                          %mo ⊗
                          %mi States
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi 𝒞
                      %mtr
                        %mtd
                          %mrow
                            %mo (
                            %mi A
                            %mo ,
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ⟩
                            %mo )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %mi A
                          %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Obs \otimes States &amp; \longrightarrow&amp;  \mathcal{C}
                  \\\
                  \\left( A , \langle - \rangle \right) &amp;\mapsto&amp; \langle A \rangle
                  }
          %p
            which reads in an
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            quantity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a state, to be denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle
            %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle A \rangle
            which is the “value of the observable quantity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in the case that the physical system is in the state
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -\rangle
          %p
            One might imagine that it is fundamentally possible to pinpoint the exact
            %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            that the
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            is found in. From this perspective, fixing a
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            should simply mean to pick such a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo ∈
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_{\Sigma}(E)_{\delta_{EL}\mathbf{L} = 0}
            in the
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mi Φ
                %annotation{:encoding => "application/x-tex"} \langle -\rangle_{\Phi}
            for this state, its pairing map with the
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            would simply be
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            of the observable, being a function on the field history space, on that particular element in this space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mi Φ
                  %mo ≔
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi Φ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle A \rangle_{\Phi} \coloneqq A(\Phi)
                  \\,.
          %p
            However, in the practice of
            %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
            a field history can never be known precisely, without remaining uncertainty. Moreover,
            %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            (to which we finally come
            = succeed ")," do
              %a{:href => "#Quantization"} below
            %a.existingWikiWord{:href => "/nlab/show/states"} states
            to be a kind of
            %a.existingWikiWord{:href => "/nlab/show/probability+distributions"} probability distributions
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle A \rangle
            of a state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle - \rangle
            with an observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a kind of
            %em
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
            of the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            averaged with respect to this probability distribution. Specifically, if the observable quantity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is (a smooth approximation to) a
            %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic function
            of a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊂
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mn 0
                %annotation{:encoding => "application/x-tex"} S \subset \Gamma_{\Sigma}(E)_{\delta_{EL}\mathbf{L} = 0}
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %a.existingWikiWord{:href => "/nlab/show/probability"} probability
            to find the
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            in that subset of field histories.
          %p
            But, moreover, the
            %a.existingWikiWord{:href => "/nlab/show/superposition+principle"} superposition principle
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            says that the actually observable observables are only those of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo *
                  %mi A
                %annotation{:encoding => "application/x-tex"} A^\ast A
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo *
                %annotation{:encoding => "application/x-tex"} A^\ast
            the image under the star-operation on the
            %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
            of observables.
          %p
            This finally leads to the definition of
            %em
              %a.existingWikiWord{:href => "/nlab/show/states"} states
            in def.
            %a.maruku-ref{:href => "#StateOnAStarAlgebra"}
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#GeneralObservables
            %strong General observables
          #Observable.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/observables"}> observables
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)_{\delta_{EL} \mathbf{L} = 0}
              its
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
            %p
              Then the
              %em
                space of
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super formal smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi ℂ
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    Obs(E,\mathbf{L})
                    \\;\coloneqq\;
                    \\left[
                    \\Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L} = 0}
                    \\,,\,
                    \\mathbb{C}
                    \\right]
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %p
              Similarly there is the space of
              %em off-shell observables
            #eq:GlobalObservables.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi ℂ
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Obs(E)
                    \\;\coloneqq\;
                    \\left[
                    \\Gamma_\Sigma(E)
                    \\,,\,
                    \\mathbb{C}
                    \\right]
                    \\,.
            %p
              Every off-shell observables induces an on-shell observable by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            #eq:OffShellObservablesRestrictToOnShellObservables.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo =
                            %mn 0
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Obs(E)
                    \\overset{(-)_{\delta_{EL}\mathbf{L} = 0}}{\longrightarrow}
                    Obs(E,\mathbf{L})
            %p
              similarly we may consider the observables on the sup-spaces of field histories with restricted causal support according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi scp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi scp
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ℂ
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    Obs(E_{scp})
                    \\;\coloneqq\;
                    \\left[ \Gamma_{\Sigma,scp}(E), \mathbb{C}  \right]
            %p and
            #eq:SpaceOfObservablesOnFieldHistoriesOfSpatiallyCompactSupport.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi scp
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi scp
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mo ,
                      %mi ℂ
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    Obs(E_{scp}, \mathbf{L})
                    \\;\coloneqq\;
                    \\left[ \Gamma_{\Sigma,scp}(E)_{\delta_{EL} \mathbf{L} = 0}, \mathbb{C}  \right]
            %p
              for the spaces of (off-shell) observables on
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              with spatially compact support (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Observables form a
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              under pointwise product:
            #eq:ObservablesPointwiseProduct.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Obs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi Obs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Obs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mn 1
                            %mo ,
                            %msub
                              %mi A
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %mo ⋅
                            %msub
                              %mi A
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Obs(E) \otimes Obs(E) &amp;\overset{(-)\cdot (-)}{\longrightarrow}&amp; Obs(E)
                    \\\
                    (A_1, A_2) &amp;\mapsto&amp; A_1 \cdot A_2
                    }
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (A_1 \cdot A_2)(\Phi_{(-)}) \coloneqq A_1(\Phi_{(-)}) \cdot A_2(\Phi_{(-)})
                    \\,,
            %p
              where on the right we have the product in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %p
              (Suitable subspaces of observables will in addition carry other products, notably
              %a.existingWikiWord{:href => "/nlab/show/non-commutative+algebra"} non-commutative algebra
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              %em
                %a{:href => "#FreeQuantumFields"} Free quantum fields
              and
              %em
                %a{:href => "#QuantumObservables"} Quantum observables
              below.)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Observables on bosonic fields
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a purely
              %a.existingWikiWord{:href => "/nlab/show/bosonic"} bosonic
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              in
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L} = 0}
              is a
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Obs
                      %mrow
                        %mi E
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                  %annotation{:encoding => "application/x-tex"} A \in Obs_{E,\mathbf{L}}
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DiffeologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                    %mo ⟶
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\;\colon\;
                    \\Gamma_\Sigma(E)_{\delta_{EL} \mathbf{L} = 0}
                    \\longrightarrow
                    \\mathbb{C}
                    \\,.
            %p
              Explicitly, by def.
              %a.maruku-ref{:href => "#SmoothSet"}
              (and similarly by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is for each
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              (generally:
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              function of plots
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi U
                                %mo ×
                                %mi Σ
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi Φ
                                      %mrow
                                        %mo{:stretchy => "false"} (
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mi E
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi pr
                                        %mn 2
                                %mo ↘
                              %mtd
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mi fb
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi Σ
                        %mo }
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟶
                      %mrow
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi U
                      %mo →
                      %mi ℂ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_U
                    \\;\colon\;
                    \\left\{
                    \\array{
                    U \times \Sigma &amp;&amp; \overset{\Phi_{(-)}}{\longrightarrow} &amp;&amp; E
                    \\\
                    \&amp; {}_{\mathllap{pr_2}}\searrow &amp;&amp;  \swarrow_{\mathrlap{fb}}
                    \\\
                    \&amp;&amp; \Sigma
                    }
                    \\right\}_{\delta_{EL}\mathbf{L} = 0}
                    \\;\overset{}{\longrightarrow}\;
                    \\left\{
                    U \to \mathbb{C}
                    \\right\}
                    \\,.
            %p
              %strong Observables on fermionic fields
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has purely
              %a.existingWikiWord{:href => "/nlab/show/fermionic"} fermionic
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FermionicBosonicFields"}
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DiracFieldBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Σ
                    %mo ×
                    %msub
                      %mi S
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} E = \Sigma\times S_{odd}
              then the only
              %a.existingWikiWord{:href => "/nlab/show/global+element"} points
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Obs
                        %mi E
                    %annotation{:encoding => "application/x-tex"} Obs_{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 0
                    %mo →
                    %msub
                      %mi Obs
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^0 \to Obs_E
              are observables depending on an even power of
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi θ
                    %mo ↦
                    %mi θ
                    %mi Ψ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ⟶
                    %msub
                      %mi Obs
                      %mrow
                        %mi E
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                  %annotation{:encoding => "application/x-tex"}
                    (\theta \mapsto \theta \Psi)
                    \\;\colon\;
                    \\mathbb{R}^{0\vert 1}
                    \\longrightarrow
                    Obs_{E,\mathbf{L}}
            %p
              whose component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Psi}
              is a section of the even-graded field bundle, regarded in odd degree, via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#DiracSpaceOfFieldHistories"}
              %a.maruku-ref{:href => "#DiracFieldPolynomialObservables"}
              below.
          %p The most basic kind of observables are the following:
          #PointEvaluationObservables.num_example
            %h6#example Example
            %p
              %strong
                (point evaluation observables –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              happens to be a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              in even degree (i.e. bosonic) with
              %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi^a)
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi \;\in \; \Gamma_\Sigma(E)
            %p
              has components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Φ
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Phi^a)
              which are
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %p
              Then for every index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} x \in \Sigma
              in
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              (every
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/event"} event
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
