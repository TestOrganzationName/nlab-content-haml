          %p#LocalObservablesByTransgression
            %strong Local observables
          %p
            We now discuss the sub-class of those
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            which are “
            %a.existingWikiWord{:href => "/nlab/show/local+field+theory"}> local
            ”.
          #SpacetimeSupport.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/spacetime+support"}> spacetime support
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \subset \Sigma
              let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi S
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %msub
                                  %mi ι
                                  %mi S
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J^\infty_\Sigma(E)\vert_S
                    \&amp;\overset{\iota_S}{\hookrightarrow}&amp;
                    J^\infty_\Sigma(E)
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    S &amp;\hookrightarrow&amp; \Sigma
                    }
            %p
              be the corresponding restriction of the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              The
              %em spacetime support
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi supp
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp_\Sigma(A)
              of a
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^\bullet(J^\infty_\Sigma(E))
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of the maximal subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \subset \Sigma
              such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the jet bundle restrited to this subset does not vanishes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi supp
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi Σ
                    %mo{:stretchy => "false"} |
                    %msubsup
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                      %mo *
                    %mi A
                    %mo ≠
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    supp_\Sigma(A) \coloneqq Cl( \{ x \in \Sigma |  \iota_{\{x\}}^\ast A \neq 0 \} )
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mi A
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi r
                          %mo ,
                          %mi s
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi supp
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mtext is compact
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ↪
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi r
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{r,s}_{\Sigma,cp}(E)
                    \\coloneqq
                    \\left\{
                    A \in \Omega^{r,s}_\Sigma(E)
                    \\;\vert\;
                    supp_\Sigma(A) \, \text{is compact}
                    \\right\}
                    \\;\hookrightarrow\;
                    \\Omega^{r,s}_\Sigma(E)
            %p
              for the subspace of differential forms on the jet bundle whose spacetime support is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+subspace"} compact subspace
          #TransgressionOfVariationalDifferentialFormsToConfigrationSpaces.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi r
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_r \hookrightarrow \Sigma
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              of dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} r \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              restricted to its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi Σ
                          %mi r
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma_r}(E)
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldHistoriesOnInfinitesimalNeighbourhoodOfSubmanifoldOfSpacetime"}
            %p
              Then the operation of
              %em
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi r
                  %annotation{:encoding => "application/x-tex"} \Sigma_r
              is the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mrow
                      %mo (
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi Σ
                            %mi r
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{\Sigma_r}
                    \\;\colon\;
                    \\Omega^{\bullet,\bullet}_{\Sigma,cp}(E)
                    \\overset{  }{\longrightarrow}
                    \\Omega^\bullet\left(
                    \\Gamma_{\Sigma_r}(E)
                    \\right)
            %p
              that sends a variational differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^{\bullet,\bullet}_{\Sigma,cp}(E)
              to the differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Σ
                          %mi r
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi Σ
                          %mi r
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_r}A\in \Omega^\bullet(\Gamma_{\Sigma_r}(E))
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ModuliOfSDifferentialForms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ×
                    %msub
                      %mi N
                      %mi Σ
                    %msub
                      %mi Σ
                      %mi r
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_{(-)}(-) \;\colon\; U \times N_\Sigma \Sigma_r \longrightarrow E
            %p
              assigns the differential form given by first forming the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along the family of
              %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma(\Phi_{(-)})
              followed by the
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi r
                    %annotation{:encoding => "application/x-tex"} \Sigma_r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi Σ
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Σ
                          %mi r
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\tau_{\Sigma}A)_\Phi
                    \\;\coloneqq\;
                    \\int_{\Sigma_r}  (j^\infty_\Sigma(\Phi_{(-)}))^\ast A
                    \\;\in\;
                    \\Omega^\bullet(U)
                    \\,.
          #TransgressionToDimensionrSupportedOnHorizontalrForms.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                to dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                picks out horizontal
                = succeed "-forms)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
            %p
              In def.
              %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              we regard
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi r
                  %annotation{:encoding => "application/x-tex"} \Sigma_r
              as an operation defined on differential forms of all degrees, which vanishes except on forms of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi r
                  %annotation{:encoding => "application/x-tex"} \Sigma_r
              vanishes except on the subspace
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi r
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
