                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_{\Sigma,cp}(E^\ast)
