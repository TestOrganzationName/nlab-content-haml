            #eq:ComparisonMorphismFromOrdinaryBVComplexToLocalObservables.maruku-equation
              %span.maruku-eq-number (28)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mi Σ
