                        %mi cp
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
