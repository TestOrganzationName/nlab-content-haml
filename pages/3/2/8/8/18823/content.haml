                    \\iota_{(-)}\delta_{EL} \mathbf{L}
                    \\;\colon\;
                    \\Gamma_{\Sigma,cp}( J^\infty_\Sigma T_\Sigma E,\varphi)[-1]
                    \\longrightarrow
                    \\Omega^{p+1,0}_{\Sigma,cp}(E,\varphi)
                    \\,.
            %p
              If we use the
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
