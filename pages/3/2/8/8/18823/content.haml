              on the order of field derivatives is bounded by some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              on some
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
