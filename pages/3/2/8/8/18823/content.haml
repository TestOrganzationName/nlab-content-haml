                        %mi scp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi fcp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi pcp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi tcp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma'_{\Sigma,cp}(E^\ast) ,
                    \\Gamma'_{\Sigma,\pm cp}(E^\ast) ,
                    \\Gamma'_{\Sigma,scp}(E^\ast) ,
                    \\Gamma'_{\Sigma,fcp}(E^\ast) ,
                    \\Gamma'_{\Sigma,pcp}(E^\ast) ,
                    \\Gamma'_{\Sigma,tcp}(E^\ast)
                    \\;\subset\;
                    \\Gamma'_{\Sigma}(E^\ast) .
          %p
            (
            %a{:href => "Green+hyperbolic+differential+operator#Sanders12"}> Sanders 13
            ,
            = succeed ")" do
              %a{:href => "Green+hyperbolic+differential+operator#Baer14"} Bär 14
          %p
            As before in prop.
            %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
            the actual
            %a.existingWikiWord{:href => "/nlab/show/smooth+sections"} smooth sections
            yield examples of distributional sections, and all distributional sections arise as
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limits
            of integrations against smooth sections:
          #NonSingularDistributionalSections.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"}> non-singular distributional sections
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi cp
                    %mo ,
                    %mo ±
                    %mi cp
                    %mo ,
                    %mi scp
                    %mo ,
                    %mi tcp
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} s \in \{cp, \pm cp, scp, tcp\}
              be any of the
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              conditions from def.
              = succeed "." do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
            %p
              Then the operation of regarding a
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+section"} smooth section
              of the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              as a
              %a.existingWikiWord{:href => "/nlab/show/functional"} functional
              on sections with this support property is a
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
              inclusion into the
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              of distributional sections from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#DistributionalSections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mphantom
                                  %mi A
                                %msub
                                  %mi u
