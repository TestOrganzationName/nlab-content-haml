              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              this way.
          #StateOnAStarAlgebra.num_defn
            %h6#definition_18 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"}> state on a star-algebra
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{A}, (-)^\ast)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarAlgebraOfObservables"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              to the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Obs
                      %mi Σ
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -\rangle
                    \\;\colon\;
                    Obs_\Sigma \longrightarrow \mathbb{C}
            %p such that
            %ol
              %li
                %p
                  (linearity) this is a complex-
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"}> linear map
                  \:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo ⟨
                          %msub
                            %mi c
                            %mn 1
                          %msub
                            %mi A
                            %mn 1
                          %mo +
                          %msub
                            %mi c
                            %mn 2
                          %msub
                            %mi A
                            %mn 2
                          %mo ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi A
                          %mn 1
                        %mo{:stretchy => "false"} ⟩
                        %mo +
                        %msub
                          %mi c
                          %mn 2
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"}
                        \\left\langle
                        c_1 A_1 + c_2 A_2
                        \\right\rangle
                        \\;=\;
                        c_1 \langle A_1 \rangle + c_2 \langle A_2 \rangle
              %li
                %p
                  (positivity) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %mi Obs
                      %annotation{:encoding => "application/x-tex"} A \in Obs
                  we have that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msup
                          %mi A
                          %mo *
                        %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo ≥
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"}
                        \\langle A^\ast A \rangle \geq 0 \;\in\; \mathbb{R}
                %p
                  where on the left
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
