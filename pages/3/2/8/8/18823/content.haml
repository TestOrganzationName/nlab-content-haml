                %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
                on the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            %p
              Prop.
              %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
              says in particular that the operation of
              %em
                %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              in an
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              is “localized” to a cohomological statement on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ,
                    %msub
                      %mi α
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_1, \alpha_2 \;\in\; \Omega^{\bullet,\bullet}_\Sigma(E)
            %p
              be two
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+forms"} variational differential forms
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (hence one less than the
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              Then the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              says that
            #eq:IntegrationByPartsCohomologicallyOnJetBundle.maruku-equation
              %span.maruku-eq-number (21)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi α
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (d \alpha_1) \wedge \alpha_2
                    \\;=\;
                    \- (-1)^{deg(\alpha_1)} \alpha_1 \wedge ( d \alpha_2 )
                    \\;\;
                    d( \alpha_1 \wedge \alpha_2 )
                    \\;\in\;
                    \\Omega^{p+1,\bullet}_\Sigma(E)
                    \\,,
            %p
              hence that we may “throw over” the spacetime derivative from the factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha_1
              to the factor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \alpha_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mn 1
                      %mo ∧
                      %msub
                        %mi α
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d (\alpha_1 \wedge \alpha_2)
              %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
              this last term vanishes under
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} \tau_\sigma
              to a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              without
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi α
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %mi d
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma( d \alpha_1) \wedge \alpha_2 )
                    \\;=\;
                    \- (-1)^{deg(\alpha_1)}
                    \\tau_\Sigma( \alpha_1 \wedge d \alpha_2 )
                    \\,,
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msubsup
                      %mi j
                      %mi σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi α
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo ∫
                      %mi Σ
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi d
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\Sigma}{\int}
                    (d j^\infty_\sigma(\alpha_1)) \wedge j^\infty_\Sigma(\alpha_2)
                    \\;=\;
                    \- (-1)^{deg(\alpha_1)}
                    \\underset{\Sigma}{\int}
                    j^\infty_\Sigma(\alpha_1) \wedge d j^\infty_\Sigma(\alpha_2)
                    \\,.
            %p
              This last statement is the statement of
              %em
                %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              under an integral.
            %p
              Notice that these
              %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
              (and hence the actual
              = succeed "-rule)" do
                %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \alpha_1 \wedge \alpha_2
              has compact spacetime support, while the “cohomological” avatar
              %a.maruku-eqref{:href => "#eq:IntegrationByPartsCohomologicallyOnJetBundle"} (21)
              of this relation on the jet bundle holds without such a restriction.
          #VariationOfTheActionFunctional.num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variation
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionFunctional"}
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+variational+derivative"} Euler-Lagrange variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL} \mathbf{L}
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi 𝒮
                      %mrow
                        %mi b
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \mathcal{S}_{b \mathbf{L}}
                    \\;=\;
                    \\tau_\Sigma( b \delta_{EL}\mathbf{L} )
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By the second statement of prop.
              %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %msub
                              %mi 𝒮
                              %mrow
                                %mi b
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                          %mtd
                            %mo =
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \mathcal{S}_{b \mathbf{L}}
                    \&amp; =
                    \\tau_\Sigma( \delta ( b \mathbf{L} )  )
                    \\end{aligned}
                    \\,,
            %p
              Moreover, by prop.
              %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo =
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi δ
                              %mi EL
                            %mi b
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo +
                            %mi d
                            %msub
                              %mi Θ
                              %mrow
                                %mi BFV
                                %mo ,
                                %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi δ
                              %mi EL
                            %mi b
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo{:stretchy => "false"} )
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi τ
                                    %mi Σ
                                  %mo{:stretchy => "false"} (
                                  %mi d
                                  %msub
                                    %mi Θ
                                    %mrow
                                      %mi BFV
                                      %mo ,
                                      %mi b
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \&amp; =
                    \\tau_\Sigma( \delta_{EL} b \mathbf{L} + d \Theta_{BFV,b} )
                    \\\
                    \&amp; =
                    \\tau_\Sigma( \delta_{EL} b \mathbf{L} ) + \underset{= 0}{\underbrace{\tau_\Sigma( d \Theta_{BFV,b} )}}
                    \\end{aligned}
                    \\,,
            %p
              where the second term vanishes by the first statement of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
          #PrincipleOfExtremalAction.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/principle+of+extremal+action"}> principle of extremal action
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi 𝒮
                      %mrow
                        %mi b
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                  %annotation{:encoding => "application/x-tex"} d \mathcal{S}_{b\mathbf{L}}
              of the
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationOfTheActionFunctional"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi \in \Gamma_\Sigma(E)
            %p
              for all
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switchings"} adiabatic switchings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\Sigma)
              constant on some subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} \subset \Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CutoffFunctions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_{(-)} \;\colon\; U \longrightarrow \Gamma_\Sigma(E)
            %p
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              which, as functions on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              solves the
