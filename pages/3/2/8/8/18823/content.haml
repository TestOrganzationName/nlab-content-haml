          #StarAlgebra.num_defn
            %h6#definition_17 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"}> star algebra
                )
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/star+ring"} star ring
              is a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              equipped with
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi R
                        %mo ⟶
                        %mi R
                      %annotation{:encoding => "application/x-tex"} (-)^\ast \;\colon\; R \longrightarrow R
            %p such that
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/involution"}> involution
                  )
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mo =
                          %mi id
                        %annotation{:encoding => "application/x-tex"} ((-)^\ast)^\ast = id
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"}> antihomomorphism
                  )
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo =
                            %msup
                              %mi b
                              %mo *
                            %msup
                              %mi a
                              %mo *
                          %annotation{:encoding => "application/x-tex"} (a b)^\ast = b^\ast a^\ast
                      for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi a
                            %mo ,
                            %mi b
                            %mo ∈
                            %mi R
                          %annotation{:encoding => "application/x-tex"} a,b \in R
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msup
                              %mn 1
                              %mo *
                            %mo =
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 1^\ast = 1
                      \.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of star-rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (R_1, (-)^\ast) \longrightarrow (R_2, (-)^\dagger)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi R
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; R_1 \longrightarrow R_2
            %p
              which respects the star-
              %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo ∘
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \circ (-)^\ast \;=\; (-)^\dagger \circ f
                    \\,.
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              over a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
              star-ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              in an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              such that the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↪
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"}
                    R \hookrightarrow \mathcal{A}
            %p is a star-homomorphism.
          #StarAlgebraOfObservables.num_example
            %h6#examples Examples
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/complex+number"}> complex number
                \-valued
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                are
                %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
                under pointwise product and pointwise
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              carry the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/star-ring"} star-ring
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarAlgebra"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            %p
              Given any space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with values in the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              carries the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              over the star-ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %p
              In particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
