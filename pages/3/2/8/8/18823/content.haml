            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo ∀
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mi 𝒪
