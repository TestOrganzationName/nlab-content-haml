                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi b
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Phi_{(-)})^\ast
                    d \mathcal{S}_{b \mathbf{L}}
                    \\;=\;
                    \\int_\Sigma
                    b
                    j^\infty_\Sigma(\Phi_{(-)})^\ast (  \delta_{EL}   \mathbf{L} )
                    \\,.
            %p
              This vanishes at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              precisely if all components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
