                          %mrow
                            %mrow
                              %mi K
                              %mspace{:width => "thinmathspace"}
                              %mtext compact
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi K
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{\Sigma,cp}(E)
                    \\;\coloneqq\;
                    \\underset{\underset{ {K \subset \Sigma} \atop {K\, \text{compact}} }{\longrightarrow}}{\lim}
                    \\Gamma_{\Sigma,K}(E)
            %p etc.
          %p
            (
            %a{:href => "space+of+sections#Baer14"}> Bär 14, 2.1
            )
          #DistributionalSections.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+smooth+sections"} spaces of smooth sections
              with restricted support from def.
              %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              structures of
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
              via def.
              = succeed "." do
                %a.maruku-ref{:href => "#TVSStructureOnSpacesOfSmoothSections"}
              %a.existingWikiWord{:href => "/nlab/show/dual+topological+vector+spaces"} dual topological vector spaces
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ′
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma'_{\Sigma}( E ^*)
                    \\;\coloneqq\;
                    (\Gamma_{\Sigma,cp}(E))^*
                    \\,.
            %p
              This is called the space of
              %em distributional sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} {E}^*
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support of a distributional section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp(u)
              is the set of points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              such that for every neighbourhood of that point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              does not vanish on all sections with support in that neighbourhood.
            %p
              Imposing the same restrictions to the
              %a.existingWikiWord{:href => "/nlab/show/supports+of+distributions"} supports of distributional sections
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ,
                        %mo ±
                        %mi cp
