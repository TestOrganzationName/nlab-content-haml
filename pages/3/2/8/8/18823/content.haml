                    \\hookrightarrow
                    Obs(E)
            %p
              for the smallest subalgebra of observables, under the pointwise product
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ObservablesPointwiseProduct"} (4)
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/multilocal+observables"} multilocal observables
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of the (multi-)
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              with the
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynomialObservables"}
            #eq:InclusionOfPolynomialLocalObservablesIntoPolynomialObservables.maruku-equation
              %span.maruku-eq-number (22)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyLocObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PolyMultiLocObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mtext dense
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PolyLocObs(E)
                    \\hookrightarrow
                    PolyMultiLocObs(E)
                    \\overset{\text{dense}}{\hookrightarrow}
                    PolyObs(E)
                    \\hookrightarrow
                    Obs(E)
          .num_example
            %h6#example_11 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#RealScalarFieldBundle"}
            %p
              A typical example of
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\Sigma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              this observable takes as value the integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma(b \phi)(\Phi) \;=\;  \int_\Sigma \Phi(x) b(x) dvol_\Sigma(x)
                    \\,.
          .num_example
            %h6#example_12 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              for
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty(\Sigma)
              a
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of the universal
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetFaraday"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              times the
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LocalObservables"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %a.maruku-eqref{:href => "#eq:TensorFaraday"} (?)
              of the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              averaged over spacetime.
          %p
            For the construction of the
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
            it will be important to notice that the
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            between
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            and
            %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            is very small:
          #RegularPolynomialLocalObservablesAreNecessarilyLinear.num_example
            %h6#example_13 Example
            %p
              %strong
