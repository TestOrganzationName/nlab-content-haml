            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/regular+observables"} regular
                %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/operator-valued+distribution"} observable-valued distributions
            %p
