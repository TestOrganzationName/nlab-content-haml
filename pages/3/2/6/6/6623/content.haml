            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            (preserves
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            of
            %a.existingWikiWord{:href => "/nlab/show/cospans"} cospans
            in which one of the cospan arrows is
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            preserves monos. A helpful example to keep in mind is the covariant power-set functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} P: Set \to Set
          .un_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi X
                    %mo →
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \theta: X \to T X
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebra
              structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i: U \hookrightarrow X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
              %strong inductive
              if in the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi H
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi θ
                        %mtr
                          %mtd
                            %mi T
                            %mi U
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi T
                                %mi i
                          %mtd
                            %mi T
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H &amp; \stackrel{j}{\to} &amp; X \\
                    \\downarrow &amp; &amp; \downarrow^\mathrlap{\theta} \\
                    T U &amp; \underset{T i}{\to} &amp; T X
                    }
            %p
              the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              (note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is monic since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              preserves monos).
            %p
              A coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \theta)
              is
              %strong well-founded
              if the only inductive subobject of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself.
          %p
            %strong Example:
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an initial algebra for the endofunctor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha: T X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is invertible, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            carries a coalgebra structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo =
                    %msup
                      %mi α
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi X
                    %mo →
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \theta = \alpha^{-1}: X \to T X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i: U \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi θ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \theta)
            is well-founded.
          %p
            Our goal in this article is to show that one can perform inductive arguments and recursive constructions in the abstract context of well-founded coalgebras. An interesting challenge is to make precise what is meant by a recursive construction of a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \phi: X \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            from the ground up, as it were. Stages in the recursive construction of a morphism will be
            %em partial
            maps, defined as usual as spans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi D
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; D &amp; &amp; \\
                  \&amp;  ^\mathllap{i} \swarrow &amp; &amp; \searrow^\mathrlap{f} \\
                  A &amp; &amp; &amp; &amp; B
                  }
          %p
            for which the arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is
            = succeed "." do
              %em monic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            preserves the pulling back of monos, it carries partial maps to partial maps and also preserves partial map composition.
          %p We denote a partial map by a dashed arrow
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo ⤏
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \dashrightarrow B
          %p
            (generally without explicitly mentioning the domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h3#connection_with_initial_algebras Connection with initial algebras
          %p
            One way of constructing the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+algebra+of+an+endofunctor"} initial algebra of an endofunctor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi α
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \alpha: T X \to X)
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            together with an isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi Y
                    %mo ≅
                    %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \xi: Y \cong T Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            consider the system of well-founded subcoalgebras of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
          %p
            The connection with initial algebras goes a little further. Firstly, an initial
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %em
              Peano
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            in the sense of the following definition:
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi α
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \alpha: T X \to X)
              is
              %em semi-Peano
              if every
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i: Y \hookrightarrow X
              is an isomorphism, and
              %em Peano
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is an isomorphism.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is initial and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i: Y \to X
            is a subalgebra, then there is a unique algebra map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} r: X \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mi r
                  %mo =
                  %msub
                    %mn 1
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i r = 1_X: X \to X
            by initiality, whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mi r
                  %mi i
                  %mo =
                  %mi i
                %annotation{:encoding => "application/x-tex"} i r i = i
            and then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mi i
                  %mo =
                  %msub
                    %mn 1
                    %mi Y
                  %mo :
                  %mi Y
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} r i = 1_Y: Y \to Y
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is monic. Hence initial algebras are semi-Peano, and Peano by Lambek’s theorem.
          %p
            Secondly, a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi E
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} T: E \to E
            induces, for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mo *
                    %mo :
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_\ast: E/X \to E/ T X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi θ
                  %mo :
                  %mi X
                  %mo →
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \theta: X \to T X)
            is a coalgebra, we may form an endofunctor on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E/X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi T
                        %mo *
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi T
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %msup
                        %mi θ
                        %mo *
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} E/X \stackrel{T_\ast}{\longrightarrow} E/ T X \stackrel{\theta^\ast}{\longrightarrow} E/X
          %p
            and of course the terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} 1_X: X \to X
            is automatically and uniquely a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mo *
                    %msub
                      %mi T
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \theta^\ast T_\ast
          .num_prop
            %h6#proposition Proposition
            %p
              A subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i: U \to X
              of a
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \theta)
              is inductive precisely when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi θ
                        %mo *
                      %msub
                        %mi T
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \theta^\ast T_\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} 1_X
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E/X
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is well-founded precisely when the terminal
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi θ
                        %mo *
                      %msub
                        %mi T
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \theta^\ast T_\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} 1_X
              is semi-Peano.
          %h2#examples Examples
          %h3#wellfounded_relations Well-founded relations
          %p
            The prototype of the notion of well-founded coalgebra is a well-founded
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} P: Set \to Set
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            corresponds to a coalgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi X
                    %mo →
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \theta: X \to P X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≺
                  %mi x
                %annotation{:encoding => "application/x-tex"} y \prec x
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y \in \theta(x)
            %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} well-founded relation
            for more information.
          %p Most of the constructions of this article are well-illustrated by checking them against the background of this prototypical case.
          %h2#induction_and_recursion Induction and recursion
          %p
            “One
            %em proves
            things by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %em defines
            things by
            = succeed ".\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            by induction, say a proof of a
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            or
            %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(x)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            varies over a domain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} i: U \hookrightarrow X
            defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is an inductive subset with respect to a relation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is universally true on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            A recursive construction on the other hand involves a
            %em dependency
            on prior stages of the construction. A typical application is to define a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f: X \to A
            by recursion with respect to a well-founded relation, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            is specified in three stages:
          %ul
            %li
              %p
                Consider the collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo :
                      %mi y
                      %mo ≺
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \theta(x) = \{y: y \prec x\}
                of all elements preceding
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
            %li
              %p
                Pass to the values
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y)
                defined earlier in the construction, giving a subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi y
                      %mo ≺
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} P(f)(\theta(x)) = \{f(y): y \prec x\}
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                Apply a given operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \phi: P(A) \to A
                to this subset
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi θ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (P(f) \circ \theta)(x)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(x)
          %p
            In the last step, the operation may be only partially defined on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself may be only partially defined;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            is defined only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi((P(f) \circ \theta) (x))
            is defined “when we call for it”.
          %p
            An inductive argument is used to show that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (to the extent that it exists, of course) is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi ϕ
                  %mo ∘
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi θ
                  %mo .
                %annotation{:encoding => "application/x-tex"} f = \phi \circ P(f) \circ \theta.
          %p
            Letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ↓
                  %mi x
                %annotation{:encoding => "application/x-tex"} \downarrow x
            denote the down-closure of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            (and containing
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi X
                  %mo :
                  %msub
                    %mo ∃
                    %mrow
                      %mi g
                      %mo :
                      %mo{:stretchy => "false"} ↓
                      %mi x
                      %mo →
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo =
                  %mi ϕ
                  %mo ∘
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x \in X: \exists_{g: \downarrow x \to A} (g = \phi \circ P(g) \circ \theta)\}
          %p
            whence the existence of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f: X \to A
            satisfying the recursive equation might indeed be proven by appeal to an inductive argument.
          %p
            However, notice that this set is defined by a construction in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p It is nevertheless true that one can prove, in rather considerable generality, both an induction principle and recursion theorem for well-founded coalgebras; this will occupy us in the following sections.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} well-founded relation
          %h2#references References
          %ul#Taylor99
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"}> Paul Taylor
              ,
              %em Practical Foundations of Mathematics
              , Cambridge University Press (1999).
          %ul#Taylor96
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"}> Paul Taylor
              ,
              %em Towards a unified treatment of induction
              , I: the general recursion theorem (1996). (
              %a{:href => "http://www.paultaylor.eu/ordinals/towuti.pdf"}> pdf
              )
