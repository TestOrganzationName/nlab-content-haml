          %h2#idea Idea
          %p
            Given a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            boxes/of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            the
            %em hook length formula
            expresses both
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/number"} number
                of
                %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
                of shape
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                of the
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                of
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} Sym(n)
                labelled by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                (i.e. of the
                %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^{(\lambda)}
          %p in terms of the lengths of all “hooks” inside the Young diagram;
          %p
            similarly, the
            %em
              %a.existingWikiWord{:href => "/nlab/show/hook-content+formula"} hook-content formula
            expresses both
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/number"} number
                of
                %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
                of shape
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                of the
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                of
                %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"} SU(n)
          %p in terms of the length of all hooks and the “content” of all of the boxes.
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/hook+length+formula"} hook length formula
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/hook-content+formula"} hook-content formula
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/number"} number
                    of
                    %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/number"} number
                    of
                    %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableaux"} semistandard Young tableaux
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    of
                    %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
                    %a.existingWikiWord{:href => "/nlab/show/Specht+module"} of
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} Sym(n)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    of
                    %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
                    of
                    %a.existingWikiWord{:href => "/nlab/show/SL%28n%29"} SL(n)
          %h2#preliminaries Preliminaries
          %p
            Given a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %em hook
            at any one of its boxes is the collection of boxes to the right and below that box, and including the box itself. We write “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ℓ
                  %msub
                    %mi hook
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \ell hook_\lambda
            ” for the
            %em length
            of such a hook, i.e. for the number of boxes it contains. Formally:
          %p
          #HookLength.num_defn
            %h6 Definition
            %p
              %strong (hook length)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mn 1
                    %mo ≥
                    %mi ⋯
                    %mo ≥
                    %msub
                      %mi λ
                      %mrow
                        %mi rows
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda = (\lambda_1 \geq \cdots \geq \lambda_{rows(\lambda)})
              be a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi rows
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, rows(\lambda)\}
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi λ
                          %mi i
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} j \in \{1, \cdots, \lambda_i\}
            %p
              the
              %em hook length
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %msub
                      %mi hook
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mi i
                    %mo −
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %msub
                      %mo ′
                      %mi j
                    %mo −
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\ell hook_\lambda(i,j)
                    \\;\coloneqq\;
                    1 +
                    (\lambda_i - j) + (\lambda'_j - i)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \lambda'
              denotes the
              %em conjugate partition
              (see
              = succeed ")." do
                %a{:href => "Young+diagram#Conjugation"} there
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi i
                    %mo −
                    %mi j
                  %annotation{:encoding => "application/x-tex"} \lambda_i - j
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %msub
                      %mo ′
                      %mi j
                    %mo −
                    %mi i
                  %annotation{:encoding => "application/x-tex"} \lambda'_j - i
              are commonly referred to as the
              %em arm length
              and
              %em leg length
              of box
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i,j)
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (numbers of (semi-)standard Young tableaux)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %mi Part
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda \in Part(n)
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %msub
                        %mi ℕ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}_+
            %ul
              %li
                %p
                  the number of
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
                #eq:NumberOfStandardYoungTableauxOfFixedShape.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo |
                          %msub
                            %mi sYTableaux
                            %mi λ
                          %mo |
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi ℕ
                          %mo +
                      %annotation{:encoding => "application/x-tex"}
                        \\left\vert sYTableaux_\lambda\right\vert
                        \\;\in\;
                        \\mathbb{N}_+
              %li
                %p
                  the number of
                  %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
                  with bounded entries
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mrow
                              %mi i
                              %mi j
                          %mo ≤
                          %mi N
                        %annotation{:encoding => "application/x-tex"} T_{i j} \leq N
                #eq:NumberOfSemiStandardYoungTableauxOfFixedShape.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo |
                          %msub
                            %mi ssYTableaux
                            %mi λ
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                          %mo |
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi ℕ
                          %mo +
                      %annotation{:encoding => "application/x-tex"}
                        \\left\vert ssYTableaux_\lambda(N)\right\vert
                        \\;\in\;
                        \\mathbb{N}_+
            %p
              of shape
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
          %h2#details Details
          %h3#counting_standard_young_tableaux Counting standard Young tableaux
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong (hook length formula for standard Young tableaux)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              (
              %a.existingWikiWord{:href => "/nlab/show/Young+diagram"}> Young diagram
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (boxes), the number
              %a.maruku-eqref{:href => "#eq:NumberOfStandardYoungTableauxOfFixedShape"} (1)
              of
              %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
              of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              equals the
              %a.existingWikiWord{:href => "/nlab/show/factorial"} factorial
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              over the
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} product
              of the hook lengths (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HookLength"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            #eq:HookLengthFormulaCountingNumberOfStandardYoungTableau.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi sYTableaux
                        %mi λ
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi n
                        %mo !
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} )
                        %mi ℓ
                        %msub
                          %mi hook
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\vert
                    sYTableaux_\lambda
                    \\right\vert
                    \\;=\;
                    \\frac{
                    n!
                    }{
                    \\prod_{(i,j)} \ell hook_\lambda(i,j)
                    }.
            %p
          %p
            This is due to
            = succeed "." do
              %a{:href => "#FrameRobinsonThrall54"} Frame, Robinson &amp; Thrall 54
            = succeed "," do
              %a{:href => "#Stanley99"} Stanley 99, Cor. 7.21.6
            = succeed "." do
              %a{:href => "#Sagan01"} Sagan 01 Thm. 3.10.2
          %h3#measuring_dimension_of_irreps_of_
            Measuring dimension of irreps of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym(n)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of the
            %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym(n)
            that is labelled by a given
            %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            (the
            %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^{(\lambda)}
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+symmetric+group"} representation theory of the symmetric group
            %a.existingWikiWord{:href => "/nlab/show/standard+Young+tableaux"} standard Young tableaux
            of shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo |
                    %msub
                      %mi sYTableaux
                      %mi λ
                    %mo |
                %annotation{:encoding => "application/x-tex"}
                  dim(S^{(\lambda)})
                  \\;=\;
                  \\left\vert
                  sYTableaux_\lambda
                  \\right\vert
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Sagan01"} Sagan, Thm. 2.6.5
          %p
            and hence is also given by the hook length formula
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:HookLengthFormulaCountingNumberOfStandardYoungTableau"} (3)
          #eq:HookLengthFormulaMeasuresDimensionOfIrrepOfSymmetricGroup.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %mi n
                      %mo !
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                      %mi ℓ
                      %msub
                        %mi hook
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  dim(S^{(\lambda)})
                  \\;=\;
                  \\frac{
                  n!
                  }{
                  \\prod_{(i,j)} \ell hook_\lambda(i,j)
                  }
                  \\,.
          %p
            This is actually the statement of
            = succeed "." do
              %a{:href => "#FrameRobinsonThrall54"} Frame, Robinson, &amp; Thrall 54, Thm. 1
            = succeed "." do
              %a{:href => "#James78"} James 78, Thm. 20.1
          %h3#ForSemiStandardYoungTableaux Counting semi-standard Young tableaux
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong (hook length formula for semi-standard Young tableaux)
              %br/
              Given
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/partition"} partition
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Young+diagram"}> Young diagram
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  (boxes),
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                  %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo ∈
                          %msub
                            %mi ℕ
                            %mo +
                        %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}_+
            %p
              the number
              %a.maruku-eqref{:href => "#eq:NumberOfSemiStandardYoungTableauxOfFixedShape"} (2)
              of semi-standard Young tableaux of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              and entries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \leq N
              (
              %a{:href => "semistandard+Young+tableau#eq:RelationToSchurPolynomialsOfFinitelyManyVariables"} hence
              the value of the
              %a.existingWikiWord{:href => "/nlab/show/Schur+polynomial"} Schur polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_\lambda(x_1, \cdots, x_N)
              at
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} x_i = 1
            #eq:TheHookLengthFormulaForSemistandardYoungTableaux.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi ssYTableaux
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi s
                      %mi λ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %munder
                      %munder
                        %mrow
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mn 1
                        %mo ⏟
                      %mpadded{:lspace => "-50%width", :width => "0"}
                        %mrow
                          %mi N
                          %mspace{:width => "thickmathspace"}
                          %mi arguments
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mi N
                        %mo −
                        %mi i
                        %mo +
                        %mi j
                      %mrow
                        %mi ℓ
                        %msub
                          %mi hook
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\vert
                    ssYTableaux_\lambda(N)
                    \\right\vert
                    \\;=\;
                    s_\lambda
                    \\big(
                    \\underset{
                    \\mathclap{
                    N\; arguments
                    }
                    }{
                    \\underbrace{
                    1, \cdots, 1
                    }
                    }
                    \\big)
                    \\;=\;
                    \\underset{(i,j)}{\prod}
                    \\frac{
                    N - i + j
                    }{
                    \\ell hook_\lambda(i,j)
                    }
                    \\,.
            %p
          %p Here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi content
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi j
                  %mo −
                  %mi i
                %annotation{:encoding => "application/x-tex"}
                  content(i,j) \;\coloneqq\; j - i
          %p
            is also called the
            %em content
            of the box
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j)
            %a.maruku-eqref{:href => "#eq:TheHookLengthFormulaForSemistandardYoungTableaux"} (5)
            is also called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/hook-content+formula"} hook-content formula
            (“hook length and box content”):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %msub
                      %mi ssYTableaux
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo |
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi s
                    %mi λ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %munder
                    %munder
                      %mrow
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mn 1
                      %mo ⏟
                    %mpadded{:lspace => "-50%width", :width => "0"}
                      %mrow
                        %mi N
                        %mspace{:width => "thickmathspace"}
                        %mi arguments
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mfrac
                    %mrow
                      %mi N
                      %mo +
                      %mi content
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi ℓ
                      %msub
                        %mi hook
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left\vert
                  ssYTableaux_\lambda(N)
                  \\right\vert
                  \\;=\;
                  s_\lambda
                  \\big(
                  \\underset{
                  \\mathclap{
                  N\; arguments
                  }
                  }{
                  \\underbrace{
                  1, \cdots, 1
                  }
                  }
                  \\big)
                  \\;=\;
                  \\underset{(i,j)}{\prod}
                  \\frac{
                  N + content(i,j)
                  }{
                  \\ell hook_\lambda(i,j)
                  }
                  \\,.
          %h3#measuring_of_dimension_of_irreps_of_
            Measuring of dimension of irreps of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n, \mathbb{C})
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of the
            %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^{(\lambda)}
            of the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n, \mathbb{C})
            that is labelled by a given
            %a.existingWikiWord{:href => "/nlab/show/Young+diagram"} Young diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            (see at
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+general+linear+group"} representation theory of the general linear group
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:TheHookLengthFormulaForSemistandardYoungTableaux"} (5)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mfrac
                    %mrow
                      %mi N
                      %mo +
                      %mi content
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi ℓ
                      %msub
                        %mi hook
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  dim\big(V^{(\lambda)}\big)
                  \\;=\;
                  \\underset{(i,j)}{\prod}
                  \\frac{
                  N + content(i,j)
                  }{
                  \\ell hook_\lambda(i,j)
                  }
          %p
            This appears as
            %a{:href => "#Sternberg94"} Sternberg 94 (C.27)
