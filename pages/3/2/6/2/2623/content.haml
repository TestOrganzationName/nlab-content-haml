              in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ExtensionOfDitstributionsPointFixedAndChoice"} (9)
            %p
              We will construct that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              in terms of these projections
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi ρ
                    %annotation{:encoding => "application/x-tex"} p_\rho
            %p First consider some convenient shorthand:
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒵
                        %mrow
                          %mo ≤
                          %mi n
                      %mo ≔
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mn 1
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
