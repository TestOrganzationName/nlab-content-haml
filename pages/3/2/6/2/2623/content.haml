                            %mover
                              %mi k
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} (
                                %mi p
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %munder
                              %mi lim
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi ϵ
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mn 0
