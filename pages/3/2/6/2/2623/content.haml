            %p
              We proceed by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Since by definition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_0 = const_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} T_1 = id
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Z_0 = const_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 1
