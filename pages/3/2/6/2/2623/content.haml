                            %mo +
                            %msub
                              %mi O
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi rg
                              %mi ρ
                            %mo ∘
                            %msub
                              %mi 𝒮
                              %mrow
                                %msup
                                  %mi ρ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %msub
                                  %mi ρ
                                  %mi vac
                            %mo ∘
                            %msubsup
                              %mi rg
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 1
                            %mo +
                            %msub
                              %mi O
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi rg
                              %mi ρ
                            %mrow
                              %mo (
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                              %msub
                                %mi 𝒮
                                %mrow
                                  %msup
                                    %mi ρ
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %msub
                                    %mi ρ
                                    %mi vac
                              %mrow
                                %mo (
                                %msubsup
                                  %mi rg
                                  %mi ρ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %mo +
                                %msubsup
                                  %mi rg
                                  %mi ρ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi rg
                              %mi ρ
                            %mrow
                              %mo (
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                              %mrow
                                %mo (
                                %msub
