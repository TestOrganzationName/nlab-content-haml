                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi sp
                        %mo ,
                        %mi ρ
                        %mo =
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho^{ 2 dim(sp) }  \Delta_{F, 1/\rho, sp}( \rho x )
                    \\;=\;
                    \\Delta_{F,sp, \rho = 1}(x)
                    \\,.
            %p
              Typically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              rescales a
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameter, in which case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi sp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(sp)
              is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              of the field species
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sp
                    %annotation{:encoding => "application/x-tex"} sp
            %p Let finally
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi σ
                                  %mi ρ
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mi sp
                              %mi a
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi dim
                                %mo{:stretchy => "false"} (
                                %mi sp
                                %mo{:stretchy => "false"} )
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mi a
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ρ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    PolyObs(E)
                    \&amp;
                    \\overset{
                    \\sigma_\rho
                    }{\longrightarrow}
                    \&amp;
                    PolyObs(E)
                    \\\
                    \\mathbf{\Phi}_{sp}^a(x)
                    \&amp;\mapsto&amp;
                    \\rho^{- dim(sp)} \mathbf{\Phi}^a( \rho^{-1} x )
                    }
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              given on
              %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Phi
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Phi}^a(x)
              by
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \rho^{-1}
              followed by multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              taken to the negative power of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              as an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %p
              This constitutes an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mrow
                      %mo (
                      %msub
                        %mi ℝ
                        %mo +
                      %mo ,
                      %mo ⋅
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    RG
                    \\coloneqq
                    \\left(
                    \\mathbb{R}_+, \cdot
                    \\right)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
              (under
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              %em
                %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              for the given choice of field species and
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameters.
          %p
            (
            %a{:href => "#Duetsch18"}> Dütsch 18, def. 3.19
            )
          #ScalarFieldMassDimensionOnMinkowskiSpacetime.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi m
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,m}
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
              for
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              parameter
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m \in (0,\infty)
              %a.existingWikiWord{:href => "/nlab/show/Green+function"} Green function
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            %p
              Let the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mo +
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RG \coloneqq (\mathbb{R}_+, \cdots)
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \rho \in \mathbb{R}_+
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ,
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi m
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %msup
                          %mi ρ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\rho , \Delta_{F,m})
                    \\mapsto
                    \\Delta_{F,\rho^{-1}m}(\rho (-))
                    \\,.
            %p Then we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %msup
                          %mi ρ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 2
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{F,\rho^{-1}m}(\rho (-))
                    \\;=\;
                    \\rho^{-(p+1) + 2}
                    \\Delta_{F,1}(x)
            %p
              and hence the corresponding
              %a.existingWikiWord{:href => "/nlab/show/mass+dimension"} mass dimension
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ScalingTransformations"}
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mtext scalar field
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
