                    \\mathcal{Z}_{\lt k}
                    \\;\coloneqq\;
                    \\underset{
                    n \in \{1, \cdots, k-1\}
                    }{\sum}
                    \\frac{1}{n!} Z_n
            %p
              is the truncation of the
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
              to degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \lt k
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{S} \circ \mathcal{Z}_{\lt k}
              is still an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme (by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CausalFactorizationSatisfiedByCompositionOfSMatrixWithVertexRedefinition"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_k
              are
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              (by
              = succeed ")." do
                %a{:href => "S-matrix#TimeOrderedProductsFromSMatrixScheme"} this example
            %p
              So as we solve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ′
                    %mo =
                    %mi 𝒮
                    %mo ∘
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}' = \mathcal{S} \circ \mathcal{Z}
              inductively in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              the expressions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{\lt k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %mi 𝒵
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z})_{\lt k}
              agree and are both time-ordered products. By
              %a{:href => "S-matrix#RenormalizationIsInductivelyExtensionToDiagonal"} this prop.
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_{k}
              agree away from the diagonal. This means that their difference
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Z_k
              is supported on the diagonal, and hence is indeed local.
          %p
            In conclusion this establishes the following pivotal statement of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
          #PerturbativeRenormalizationMainTheorem.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
                –
                %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H)
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (
              %a{:href => "S-matrix#VacuumFree"}> this def.
              ).
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒵
                      %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                  under
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %li
                %p
                  the set of
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} ("re"-)normalization schemes
                  (
                  %a{:href => "S-matrix#LagrangianFieldTheoryPerturbativeScattering"}> this def.
                  ,
                  = succeed ")" do
                    %a{:href => "S-matrix#calSFunctionIsRenormalizationScheme"} this remark
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
                  “field independence” (
                  %a{:href => "S-matrix#BasicConditionsRenormalization"}> this prop.
                  ) is a
                  %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                  over this group, hence equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
                  in that
                %ol
                  %li
                    %p
                      the set of
                      %a.existingWikiWord{:href => "/nlab/show/S-matrix+schemes"} S-matrix schemes
                      is
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  %li
                    %p
                      any two
                      %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                      %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} ("re"-)normalization schemes
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒮
                            %annotation{:encoding => "application/x-tex"} \mathcal{S}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒮
                            %mo ′
                          %annotation{:encoding => "application/x-tex"} \mathcal{S}'
                      are related by a
                      %em unique
                      %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒵
                          %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                      via
                      = succeed ":" do
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒮
                            %mo ′
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒮
                            %mo ∘
                            %mi 𝒵
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\mathcal{S}' \;=\; \mathcal{S} \circ \mathcal{Z}
                            \\,.
            %p
              This group is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
            %p
              Typically one imposes a set of
              %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"} renormalization conditions
              (
              %a{:href => "S-matrix#RenormalizationConditions"}> this def.
              ) and considers the corresponding
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
              preserving these conditions.
          .proof
            %h6#proof_12 Proof
            %p
              The
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              and
              %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
              is given by prop.
              %a.maruku-ref{:href => "#CausalFactorizationSatisfiedByCompositionOfSMatrixWithVertexRedefinition"}
              and prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
              in theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ExistenceRenormalization"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h4#UVRegularizationViaZ UV-Regularization via Conterterms
          %p
            While
            %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#ExistenceRenormalization"}
            %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
            in prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            (theorem
            = succeed ")," do
              %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
            %em difference
            between any two such choices as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            itself should have an incarnation in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
          %p
            This may be realized via a construction of
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            in terms of
            %em
              %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-regularization
            (prop.
            %a.maruku-ref{:href => "#UVRegularization"}
            below): For any choice of “
            %a.existingWikiWord{:href => "/nlab/show/UV-cutoff"}> UV-cutoff
            ”, given by an approximation of the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi F
                %annotation{:encoding => "application/x-tex"} \Delta_F
            by
            %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mi F
                      %mo ,
                      %mi Λ
                %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
            (def.
            %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            below) there is a unique “
            %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"}> effective S-matrix
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
            induced at each cutoff scale (def.
            %a.maruku-ref{:href => "#SMatrixEffective"}
            below). While the “UV-limit”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi Λ
                      %mo →
                      %mn ∞
                  %msub
                    %mi 𝒮
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \underset{\Lambda \to \infty}{\lim} \mathcal{S}_\Lambda
            does not in general exist, it may be “regularized” by applying suitable
            %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counter
            %a.maruku-ref{:href => "#TermCounter"}
            below) the coresponding UV-divergences.
          %p
            This perspective of
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization via
            via
            %em
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
            is often regarded as the primary one. Its elegant proof in prop.
            %a.maruku-ref{:href => "#UVRegularization"}
            below, however relies on the
            %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
            via inductive
            %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
            and uses the same kind of argument as in the proof of the
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CutoffsUVForPerturbativeQFT.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"}> UV cutoffs
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (according to
              = succeed ")," do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Δ
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H = \tfrac{i}{2}(\Delta_+ - \Delta_-) + H
              is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              inducing the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo ∈
                    %mi Γ
                    %msub
                      %mo ′
                      %mrow
                        %mi Σ
                        %mo ×
                        %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ⊠
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_F \in \Gamma'_{\Sigma \times \Sigma}(E_{\text{BV-BRST}} \boxtimes E_{\text{BV-BRST}})
            %p
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi F
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi Δ
                        %mo −
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_F = \tfrac{i}{2}(\Delta_+ + \Delta_-) + H
            %p
              Then a choice of
              %em
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
                for
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum is a collection of
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              parameterized by
              %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ×
                                %mi Σ
                                %mo ,
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo ⊠
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Λ
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (0, \infty)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\Gamma_{\Sigma \times \Sigma,cp}(E_{\text{BV-BRST}} \boxtimes E_{\text{BV-BRST}})
                    \\\
                    \\Lambda &amp;\mapsto&amp; \Delta_{F,\Lambda}
                    }
            %p such that:
            %ol
              %li
