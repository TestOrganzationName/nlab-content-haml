                        %mo +
                        %mn 1
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} K_{n+1,\Lambda}
              vanishes as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \Lambda \to \infty
            %p
              First regarding the locality of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
