                            %mi α
                            %mo ∈
                            %msup
                              %mi ℕ
                              %mi n
                        %mrow
                          %mrow
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi α
                              %mo{:stretchy => "false"} |
