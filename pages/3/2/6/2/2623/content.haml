              (
              %a{:href => "A+first+idea+of+quantum+field+theory#SpacetimeSupport"}> this def.
              ) we have
            %ol
              %li
                %p (local additivity)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
