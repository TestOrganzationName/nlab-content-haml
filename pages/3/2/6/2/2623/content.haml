                        %mi 𝒵
                        %mi Λ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_\infty(g S_{int} + j A)
