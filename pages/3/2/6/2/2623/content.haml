              into
              %a.maruku-eqref{:href => "#eq:CountertermOrderByOrderInTermsOfCorrectionTerm"} (16)
              we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
