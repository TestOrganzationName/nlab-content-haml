            %p
              exists and is an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              with the given
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            %p In this case the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mrow
                                %mi counter
                                %mo ,
                                %mi Λ
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo +
                              %mi j
                              %mi A
                              %mo )
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi 𝒵
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi Loc
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ⟨
                            %msup
                              %mi g
                              %mn 2
                            %mo ,
                            %msup
                              %mi j
                              %mn 2
                            %mo ,
                            %mi g
                            %mi j
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_{counter, \Lambda}
                    \&amp; \coloneqq
                    \\left(
                    g S_{int} + j A
                    \\right)
                    \\;-\;
                    \\mathcal{Z}_{\Lambda}(g S_{int} + j A)
                    \\;\;\;\;\;\in\;
                    Loc(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g^2, j^2, g j\rangle
                    \\end{aligned}
            %p
              (which by the axiom “perturbation” in
              %a{:href => "Stückelberg-Petermann+renormalization+group#InteractionVertexRedefinition"} this def.
              is at least of second order in the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              %em
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              at cutoff scale
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒵
                      %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
