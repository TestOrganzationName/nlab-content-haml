              and the
              %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mrow
