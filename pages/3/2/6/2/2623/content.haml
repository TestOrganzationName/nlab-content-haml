              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
