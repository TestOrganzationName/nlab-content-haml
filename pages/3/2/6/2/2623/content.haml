          #ScalingDegreeOfDistributionsBasicProperties.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (basic properties of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree of distributions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#RescaledDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
              is finite:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sd
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} sd(u) \lt \infty
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ScalingDegree"}
            %ol
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo ∈
                          %msup
                            %mi ℕ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \alpha \in \mathbb{N}^n
                  %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial
                  %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} derivative of distributions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \partial_\alpha
                  increases scaling degree at most by
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi α
                            %mo{:stretchy => "false"} |
                        %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert }
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mi α
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≤
                        %mspace{:width => "thickmathspace"}
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"}
                        deg(\partial_\alpha u) \;\leq\; deg(u) + {\vert \alpha\vert}
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo ∈
                          %msup
                            %mi ℕ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \alpha \in \mathbb{N}^n
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                  with the smooth coordinate functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mi α
                      %annotation{:encoding => "application/x-tex"} x^\alpha
                  decreases scaling degree at least by
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi α
                            %mo{:stretchy => "false"} |
                        %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert }
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mi α
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≤
                        %mspace{:width => "thickmathspace"}
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"}
                        deg(x^\alpha u) \;\leq\; deg(u) - {\vert \alpha\vert}
              %li
                %p
                  Under
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+distributions"} tensor product of distributions
                  their scaling degrees add:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sd
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ⊗
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi sd
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi sd
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        sd(u \otimes v) \leq sd(u) + sd(v)
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ∈
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} v \in \mathcal{D}'(Y)
                  another distribution on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mo ⊂
                          %msup
                            %mi ℝ
                            %mrow
                              %mi n
                              %mo ′
                        %annotation{:encoding => "application/x-tex"} Y \subset \mathbb{R}^{n'}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi k
                      %annotation{:encoding => "application/x-tex"} deg(f u) \leq deg(u) - k
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in C^\infty(X)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f^{(\alpha)}(0) = 0
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi α
                            %mo{:stretchy => "false"} |
                          %mo ≤
                          %mi k
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} \leq k-1
          %p
            (
            %a{:href => "#BrunettiFredenhagen00"}> Brunetti-Fredenhagen 00, lemma 5.1
            ,
            = succeed ")" do
              %a{:href => "#Duetsch18"} Dütsch 18, exercise 3.34
          .proof
            %h6#proof_5 Proof
            %p
              The first three statements follow with manipulations as in example
              %a.maruku-ref{:href => "#NonSingularDistributionsScalingDegree"}
              and example
              = succeed "." do
                %a.maruku-ref{:href => "#DerivativesOfDeltaDistributionScalingDegree"}
            %p For the fourth…
          #ScalingDegreeOfProductDistribution.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product distribution
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u,v \in \mathcal{D}'(\mathbb{R}^n)
              be two
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              such that
            %ol
              %li
                %p
                  both have finite
                  %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ScalingDegree"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"}
                        deg(u), deg(v) \lt \infty
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                  is well-defined
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mi v
                        %mo ∈
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        u v \in \mathcal{D}'(\mathbb{R}^n)
                %p
                  (in that their
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
                  satisfy
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
            %p
              then the product distribution has
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              bounded by the sum of the separate degrees:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(u v)
                    \\;\leq\;
                    deg(u) + deg(v)
                    \\,.
          %p
            With the concept of
            %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree of distributions
            in hand, we may now discuss
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
          #ExtensionOfDistributions.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"}> extension of distributions
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⊂
                      %mi ι
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} X \overset{\iota}{\subset} \hat X
              be an inclusion of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              of some
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restriction of distributions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi ι
                          %mo *
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}'(\hat X)
                    \\overset{\iota^\ast}{\longrightarrow}
                    \\mathcal{D}'(X)
                    \\,.
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
              %em
                %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
              is a distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat u \in \mathcal{D}'(\hat X)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota^\ast \hat u
                    \\;=\;
                    u
                    \\,.
          #ExtensionUniqueNonPositiveDegreeOfDivergence.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (unique
                %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
                with negative
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n \setminus \{0\})
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              on the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the origin, with
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              at the origin
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(u) \lt 0
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              has a
              %em unique
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat u \in \mathcal{D}'(\mathbb{R}^n)
              to the origin with the same degree of divergence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(\hat u) = deg(u)
                    \\,.
          %p
            (
            %a{:href => "#BrunettiFredenhagen00"}> Brunetti-Fredenhagen 00, theorem 5.2
            ,
            = succeed ")" do
              %a{:href => "#Duetsch18"} Dütsch 18, theorem 3.35 a)
          .proof
            %h6#proof_6 Proof
            %p Regarding uniqueness:
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} {\hat u}^\prime
              are two extensions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %msup
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ^
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} deg(\hat u) = deg({\hat u}^\prime)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \{0\}
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support
              at the origin
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \{0\} \subset \mathbb{R}^n
              %a{:href => "point-supported+distribution#PointSupportedDistributionsAreSumsOfDerivativesOfDeltaDistibutions"} this prop.
              this implies that it is a linear combination of
              %a.existingWikiWord{:href => "/nlab/show/derivative+of+a+distribution"} derivatives
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} supported
              at the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi α
                        %mo ∈
                        %msup
                          %mi ℕ
                          %mi n
                    %msup
                      %mi c
                      %mi α
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    {\hat u}^\prime - \hat u
                    \\;=\;
                    \\underset{
                    {\alpha \in \mathbb{N}^n}
                    }{\sum}
                    c^\alpha \partial_\alpha \delta_0
            %p
              for constants
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi c
                        %mi α
                      %mo ∈
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} c^\alpha \in \mathbb{C}
              %a{:href => "scaling+degree+of+a+distribution#DerivativesOfDeltaDistributionScalingDegree"} this example
              the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              of these
              %a.existingWikiWord{:href => "/nlab/show/point-supported+distributions"} point-supported distributions
              is non-negative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo ≥
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg( \partial_\alpha \delta_0)
                    \=
                    {\vert \alpha\vert} \geq 0
                    \\,.
            %p
              This implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi c
                      %mi α
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c^\alpha = 0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p Regarding existence:
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    b \in C^\infty_{cp}(\mathbb{R}^n)
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \leq 1
              and
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on 1 over a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of the origin. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo ≔
                    %mn 1
                    %mo −
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi \coloneqq 1 - b \;\in\; C^\infty(\mathbb{R}^n)
            %center
              %img{:src => "https://ncatlab.org/nlab/files/PointExtensionOfDistributions.png"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Duetsch18"} Dütsch 18, p. 108
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_\lambda(x)
                    \\coloneqq
                    \\chi(\lambda x)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \chi_\lambda u
              has
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support of a distribution
              on a
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of the origin, we may extend it by zero to a distribution on all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_\lambda u \in \mathcal{D}'(\mathbb{R}^n)
                    \\,.
            %p
              By construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} xhi
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \xhi_\lambda u
              coincides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              away from a neighbourhood of the origin, which moreover becomes arbitrarily small as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              increases. This means that if the following
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mrow
                        %mi λ
                        %mo →
                        %mn ∞
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"}
                    \\hat u
                    \\;\coloneqq\;
                    \\underset{\lambda \to \infty}{\lim}
                    \\chi_\lambda u
            %p
              then it is an extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %p
              To see that the limit exists, it is sufficient to observe that we have a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b\in C^\infty_{cp}(\mathbb{R}^n)
              the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi u
                    %mo −
                    %msub
                      %mi χ
                      %mi n
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo +
                    %msub
                      %mi χ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\chi_{n+1} u - \chi_n u)(b)
                    \\;=\;
                    u(b)( \chi_{n+1} + \chi_n )
            %p becomes arbitrarily small.
            %p
              It remains to see that the unique extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              thus established has the same scaling degree as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              = succeed ")." do
                %a{:href => "#BrunettiFredenhagen00"} Brunetti-Fredenhagen 00, p. 24
          #SpaceOfPointExtensions.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (space of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/point-extensions+of+distributions"} point-extensions of distributions
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n \setminus \{0\})
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} degree of divergence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} deg(u) \lt \infty
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              does admit at least one
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExtensionOfDistributions"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat u \in \mathcal{D}'(\mathbb{R}^n)
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(\hat u) = deg(u)
                    \\,.
            %p
              Moreover, any two such extensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} {\hat u}^\prime
              differ by a linear combination of
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial
              %a.existingWikiWord{:href => "/nlab/show/derivatives+of+distributions"} derivatives of distributions
              of order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \leq deg(u)
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta_0
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} supported
              at the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
