                    \\,.
            %p We need to show that the
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒮
                      %mrow
                        %msub
                          %mi ρ
                          %mi vac
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mn 1
                    %mo +
                    %msub
                      %mi O
                      %mn 2
                    %mo{:stretchy => "false"} )
