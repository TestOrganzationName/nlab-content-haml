                    \\big(
                    \\mathbb{Z}[(\text{-})\cdot(\text{-})]
                    \\big)
                    }
                    \&amp;
                    N_\bullet
                    \\big(
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \\\
                    (g)_p
                    \\otimes
                    (g')_q
                    \&amp;\mapsto&amp;
                    \\displaystyle{
                    \\underset{
                    \\mathclap{
                    sh \in Sh(p,q)
                    }
                    }{\sum}
                    }
                    \\;
                    sgn(sh)
                    \\,
                    \\big(
                    g,g', sh
                    \\big)
                    \&amp;\mapsto&amp;
                    \\Big(
                    \\displaystyle{
                    \\underset{
                    \\mathclap{
                    sh \in Sh(p,q)
                    }
                    }{\sum}
                    }
                    \\;
                    sgn(sh)
                    \\Big)
                    \\,
                    (g \cdot g')_{p + q}
                    \\mathrlap{\,.}
                    }
            %p
          %h2#references References
          %p Original sources:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Moore"}> John Moore
                ,
                %em Homotopie des complexes monoïdaux, I.
                Séminaire Henri Cartan
                %strong 7
                2 (1954-1955), Exposé
                %strong 18
                (
                %a{:href => "http://www.numdam.org/item?id=SHC_1954-1955__7_2_A8_0"}> numdam:SHC_1954-1955__7_2_A8_0
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Moore"}> John Moore
                ,
                = succeed "," do
                  %em Semi-simplicial complexes and Postnikov systems
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Moore"}> John Moore
                ,
                = succeed "," do
                  %em Semi-simplicial Complexes, seminar notes
          %p There is also a never published
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+C.+Moore"}> John C. Moore
              ,
              = succeed "." do
                %em Algebraic homotopy theory
              = succeed "&rbrack;" do
                %a{:href => "https://dmitripavlov.org/scans/moore-algebraic-homotopy-theory.pdf"} pdf
          %p A proof by Cartan is in
          %ul
            %li
              Cartan,
              %em Quelques questions de topologies
              seminar, 1956-57
          %p A standard textbook reference for the abelian version is
          %ul
            %li#GoerssJardine
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Rick Jardine
              %em
                %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
          %p Notice that these authors write “normalized chain complex” for the complex that elsewhere in the literature would be called just “Moore complex”, whereas what Goerss–Jardine call “Moore complex” is sometime maybe just called “alternating sum complex”.
          %p See also
          %ul
            %li#SchwedeShipley03
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              %em Equivalences of monoidal model categories
              , Algebr. Geom. Topol. 3 (2003), 287–334 (
              %a{:href => "http://arxiv.org/abs/math.AT/0209342"}> arXiv:math.AT/0209342
              ,
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.agt/1513882376"} euclid:euclid.agt/1513882376
          %p A discussion with an emphasis of the generalization to non-abelian simplicial groups is in section 1.3.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Crossed+Menagerie"} Crossed Menagerie
          %p
            The discusson of the
            %a.existingWikiWord{:href => "/nlab/show/hypercrossed+complex"} hypercrossed complex
            structure on the Moore complex of a general simplicial group is in
          %ul
            %li#Carrasco-Cegarra
              %a.existingWikiWord{:href => "/nlab/show/Pilar+Carrasco"}> P. Carrasco
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Antonio+Cegarra"} A. M. Cegarra
              %em Group-theoretic Algebraic Models for Homotopy Types
              , J. Pure Appl. Alg., 75, (1991), 195–235
              %a{:href => "https://doi.org/10.1016/0022-4049(91)90133-M"} https://doi.org/10.1016/0022-4049(91)90133-M
