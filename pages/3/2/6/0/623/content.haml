                                  %mo −
                          %mtd
                            %msub
                              %mi N
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo ⊗
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi N
                                  %mo •
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mi ℤ
                                %mo{:stretchy => "false"} [
                                %mo{:stretchy => "false"} (
                                %mtext -
                                %mo{:stretchy => "false"} )
                                %mo ⋅
