              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              of def.
              %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
              and the second is the degenerate cells from def.
              = succeed "." do
                %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
          .proof
            %h6#proof_3 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#NormalizedIntoModuloDegeneraciesIsIsomorpism"}
              there is an
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              to the diagonal composite in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %mi N
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A)
                    \\\
                    {}^{\mathllap{i}}\uparrow &amp; \nearrow
                    \\\
                    N A
                    }
                    \\,.
            %p
              This hence exhibits a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splitting
              of the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              given by the quotient by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mi A
                    %annotation{:encoding => "application/x-tex"} D A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi D
                            %mi A
                          %mtd
                            %mo ↪
                          %mtd
                            %mi C
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %msub
                                  %mpadded{:width => "0"}
                                    %mo ≃
                                  %mi iso
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi N
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; D A &amp;\hookrightarrow &amp; C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A) &amp;\to &amp; 0
                    \\\
                    \&amp;&amp; &amp;&amp; {}^{\mathllap{i}}\uparrow &amp; \swarrow_{\mathrlap{\simeq}_{iso}}
                    \\\
                    \&amp;&amp; &amp;&amp; N A
                    }
                    \\,.
          %p
          #EMTheorem.num_theorem
            %h6 Theorem
            %p
              %strong (Eilenberg-MacLane)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mi A
                    %mo ↪
                    %mi C
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    i \colon N A \hookrightarrow C A
            %p
              of the normalized chain complex, def.
              %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
              into the full alternating face map complex, def.
              = succeed "," do
                %a.maruku-ref{:href => "#AlternatingFaceMapComplex"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              and in fact a natural chain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D_\bullet(X)
              is
              %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null-homotopic
              (a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+chain+complex"} contractible chain complex
          %p
            (
            %a{:href => "#GoerssJardine"}> Goerss-Jardine, theorem III 2.4
            )
          .proof
            %h6#proof_4 Proof
            %p
              Following the proof of (
              %a{:href => "#GoerssJardine"}> Goerss-Jardine, theorem III 2.1
              ) we look for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} j \lt n
              at the groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi j
                    %mo ≔
                    %msubsup
                      %mo ∩
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi j
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    N_n(A)_j \coloneqq  \cap_{i=0}^j ker (d_i) \subset A_n
            %p and similarly at
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi j
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi s
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ≤
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi A
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    D_n(A)_j = \{s_{i}\}_{i \leq j}(A_{n-1}) \subset A_n
                    \\,,
            %p
              the subgroup generated by the first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              degeneracies.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} j= n-1
              these coincide with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_n(A)
              and with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D_n(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              that the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi j
                    %mo ↪
                    %msub
                      %mi A
                      %mi n
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    N_n(A)_j \hookrightarrow A_n \stackrel{}{\to} A_n/D_n(A)_j
            %p
              is an isomorphism of all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} j \lt n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} j = n-1
              this is then the desired result.
            %p (…)
          .num_cor
            %h6#corollary_2 Corollary
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (C A) \longrightarrow (C A)/(D A)
            %p
              from its alternating face maps complex, def.
              = succeed "," do
                %a.maruku-ref{:href => "#AlternatingFaceMapComplex"}
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
          .proof
            %h6#proof_5 Proof
            %p
              Consider the pre-composition of the map with the inclusion of the normalized chain complex, def.
              = succeed "." do
                %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %mi N
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A)
                    \\\
                    {}^{\mathllap{i}}\uparrow &amp; \nearrow
                    \\\
                    N A
                    }
            %p
              By theorem
              %a.maruku-ref{:href => "#EMTheorem"}
              the vertical map is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              and by prop.
              %a.maruku-ref{:href => "#NormalizedIntoModuloDegeneraciesIsIsomorpism"}
              the composite diagonal map is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              property, it follows that also the map in question is a quasi-isomorphism.
          %h3#equivalence_of_categories Equivalence of categories
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of def.
              %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
              restricts on
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+groups"} simplicial abelian groups
              to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi sAb
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N \colon
                    sAb \stackrel{\simeq}{\longrightarrow} Ch_\bullet^+(A)
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/sAb"} sAb
              and the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              in non-negative degree.
          %p
            This is the statement of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          %h3#homology_and_homotopy_groups Homology and homotopy groups
          %p
            Notice that the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            underlying any
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (as described there) is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"}
                  \\pi_n(G) \;\;\; n \in \mathbb{N}
          %p
            for the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} simplicial homotopy group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in this case also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(G)
            is indeed canonically a group, not just a set.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a simplicial abelian group there are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_n(A,0) \simeq H_n(N A) \simeq H_n(A)
            %p
              between the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} simplicial homotopy group
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              groups of the unnormalized and of the normalized chain complexes.
          .proof
            %h6#proof_6 Proof
            %p
              The first isomorphism follows with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
              %a{:href => "#EMTheorem"} Eilenberg-MacLane theorem
              above.
          .num_remark
            %h6#remark_4 Remark
            %p
              Both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sAb
                  %annotation{:encoding => "application/x-tex"} sAb
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet^+
              are naturally
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              given by those morphisms that induce
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} simplicial homotopy group
              and on all
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              groups, respectively. So the above statement says that the Moore complex functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              respects these weak equivalences.
            %p
              In fact, it induces an equivalence of categories also on the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              with respect to the standard
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structures that refine the structures of categories of weak equivalences. All this is discussed at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          %h3#HypercrossedComplex Hypercrossed complex structure
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The Moore complex of a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              is naturally a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hypercrossed+complex"} hypercrossed complex
          %p
            This has been established in (
            %a{:href => "#Carrasco-Cegarra"}> Carrasco-Cegarra
            ). In fact, the analysis of the Moore complex and what is necessary to rebuild the simplicial group from its Moore complex is the origin of the abstract motion of hypercrossed complex, so our stated proposition is almost a tautology!
          %p
            Typically one has pairings
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %msub
                      %mi G
                      %mi p
                    %mo ×
                    %mi N
                    %msub
                      %mi G
                      %mi q
                    %mo →
                    %mi N
                    %msub
                      %mi G
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} N G_p \times N G_q \to N G_{p+q}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Conduch%C3%A9+decomposition+theorem"} Conduché decomposition theorem
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hypercrossed+complex"} hypercrossed complex
          %p These Moore complexes are easily understood in low dimensions:
          %ul
            %li
              %p
                Suppose that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is a simplicial group with Moore complex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mi G
                      %annotation{:encoding => "application/x-tex"} N G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %msub
                        %mi G
                        %mi k
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N G_k = 1
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k\gt 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 1
                      %mo ,
                      %msub
                        %mi G
                        %mn 0
                      %mo ,
                      %msub
                        %mi d
                        %mn 1
                      %mo ,
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G_1,G_0,d_1,d_0)
                has the structure of a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
                %a.existingWikiWord{:href => "/nlab/show/interchange+law"} interchange law
                is satisfied since the corresponding equation in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
                is always the image of an element in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} N G_2
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi P
                        %mo ,
                        %mi δ
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (C,P,\delta, a)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %msub
                          %mi G
                          %mn 0
                        %mo =
                        %msub
                          %mi G
                          %mn 0
                        %mo =
                        %mi P
                      %annotation{:encoding => "application/x-tex"} N G_0 = G_0 = P
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %msub
                          %mi G
                          %mn 1
                        %mo ≅
                        %mi C
                      %annotation{:encoding => "application/x-tex"} N G_1 \cong C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo =
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \partial = \delta
                and the action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                translates to an action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %msub
                        %mi G
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} N G_0
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} N G_1
                using conjugation by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s_0(p)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %msub
                        %mi G
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} p\in G_0
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi N
                        %msub
                          %mi G
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} c\in N G_1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi s
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mi c
                      %msub
                        %mi s
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi p
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo .
                    %annotation{:encoding => "application/x-tex"} a(p)(c) = s_0(p)c s_0(p)^{-1}.
            %li
              %p
                Suppose next that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %msub
                        %mi G
                        %mi k
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N G_k = 1
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} k \gt 2
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-crossed+module"} 2-crossed module
          %h2#Examples Examples
          %p
          #ChainsOnThe1Simplex.num_remark
            %h6 Example
            %p
              %strong (chain on the 1-simplex)
              %br/
              Consider the 1-
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
              regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\Delta[1]]
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              which in each degree is the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the simplices in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
            %p This simplicial abelian group starts out as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mrow
                      %mo (
                      %mi ⋯
                      %mover
                        %mover
                          %mover
                            %mo ⟶
                            %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %msup
                        %mi ℤ
                        %mn 4
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %msup
                        %mi ℤ
                        %mn 3
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mo ∂
                              %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mo ∂
                              %mn 0
                      %msup
                        %mi ℤ
                        %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[\Delta[1]]
                    \=
                    \\left(
                    \\cdots
                    \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                    \\mathbb{Z}^4 \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                    \\mathbb{Z}^3 \stackrel{\overset{\partial_0}{\longrightarrow}}{\underset{\partial_1}{\longrightarrow}} \mathbb{Z}^2
                    \\right)
            %p (where we are indicating only the face maps for notational simplicity).
            %p
              Here the first
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 2
                      %mo =
                      %mi ℤ
                      %mo ⊕
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2 = \mathbb{Z}\oplus \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of two copies of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo ≃
                    %mrow
                      %mo {
                      %mi a
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi b
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi ℤ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}^2 \simeq \left\{ a \cdot (0) + b \cdot (1) | a,b \in \mathbb{Z}\right\}
                    \\,.
            %p
              The second
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 3
                    %mo ≃
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^3 \simeq \mathbb{Z}\oplus \mathbb{Z}\oplus \mathbb{Z}
              is the abelian group generated from the three (!) 1-simplicies in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0\to 1)
              and the two degenerate cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0 \to 0)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1 \to 1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 3
                    %mo ≃
                    %mrow
                      %mo {
                      %mi a
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi b
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi c
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ∈
                      %mi ℤ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}^3 \simeq \left\{ a \cdot (0\to 0) + b \cdot (0 \to 1) + c \cdot (1 \to 1) | a,b,c \in \mathbb{Z}\right\}
                    \\,.
            %p The two face maps act on the basis 1-cells as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo →
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_1 \colon (i \to j) \mapsto (i)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo →
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_0 \colon (i \to j) \mapsto (j)
                    \\,.
            %p
              Now of course most of the (infinitely!) many simplices inside
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
              are degenerate. In fact the only non-degenerate simplices are the two 0-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1)
              and the 1-cell
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0 \to 1)
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\Delta[1]]
              is simply this:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %mi ⋯
                      %mo →
                      %mn 0
                      %mo →
                      %mn 0
                      %mo →
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mn 1
                            %mrow
                              %mo −
                              %mn 1
                          %mo )
                      %msup
                        %mi ℤ
                        %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (C (\mathbb{Z}[\Delta[1]])) / D (\mathbb{Z}[\Delta[1]]))
                    \=
                    \\left(
                    \\cdots
                    \\to
                    0
                    \\to
                    0
                    \\to
                    \\mathbb{Z}
                    \\stackrel{\left(1 \atop -1\right)}{\longrightarrow}
                    \\mathbb{Z}^2
                    \\right)
                    \\,.
            %p
              Notice that alternatively we could consider the topological 1-simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta^1 = [0,1]
              and its
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing(\Delta^1)
              in place of the smaller
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}(Sing(\Delta^1))
              of that. The corresponding alternating face map chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\mathbb{Z}(Sing(\Delta^1)))
              is “huge” in that in each positive degree it has a free abelian group on uncountably many generators. Quotienting out the degenerate cells still leaves uncountably many generators in each positive degree (while every singular
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is “thin”, only those whose parameterization is as induced by a degeneracy map are actually regarded as degenerate cells here). Hence even after normalization the singular simplicial chain complex is “huge”. Nevertheless it is quasi-isomorphic to the tiny chain complex found above.
          %p
          #NormalizedChainsOnEZTwo.num_remark
            %h6 Example
            %p
              %strong
                (normalized chain complex of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} E\mathbb{Z}_2
              %br/
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \,\equiv\, \mathbb{Z}/2\mathbb{Z}
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              we denote by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0, 1\}
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              (see
              = succeed ")" do
                %a{:href => "simplicial+classifying+space#eq:SimplicialClassifyingSpaceAsNerve"} here
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                    %munderover
                      %mo ⇉
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mtext -
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W \mathbb{Z}_2
                    \\;=\;
                    N\big(
                    \\mathbf{E} \mathbb{Z}_2
                    \\big)
                    \\;\equiv\;
                    N\big(
                    \\mathbb{Z}_2 \times \mathbb{Z}_2
                    \\underoverset
                    {pr_2}
                    {(\text{-})\cdot(-)}
                    {\rightrightarrows}
                    \\mathbb{Z}_2
                    \\big)
                    \\,.
            %p
              Forming degree-wise
              %a.existingWikiWord{:href => "/nlab/show/linear+spans"} linear spans
              gives a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ab
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}\big[
                    W \mathbb{Z}_2
                    \\big]
                    \\;\;
                    \\in
                    \\;\;
                    Ab^{\Delta^{op}}
                    \\,.
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              denoted
            #eq:NormalizedChainsOnWZTwo.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
