                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi p
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ′
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi q
                          %mtd
                            %mo ↦
                          %mtd
                            %mstyle{:displaystyle => "true"}
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mpadded{:lspace => "-50%width", :width => "0"}
                                  %mrow
                                    %mi sh
                                    %mo ∈
                                    %mi Sh
                                    %mo{:stretchy => "false"} (
                                    %mi p
                                    %mo ,
                                    %mi q
                                    %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mi sgn
                              %mo{:stretchy => "false"} (
                              %mi sh
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi g
                              %mo ,
                              %mi g
                              %mo ′
                              %mo ,
                              %mi sh
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mstyle{:displaystyle => "true"}
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mpadded{:lspace => "-50%width", :width => "0"}
                                  %mrow
                                    %mi sh
                                    %mo ∈
                                    %mi Sh
                                    %mo{:stretchy => "false"} (
                                    %mi p
                                    %mo ,
                                    %mi q
                                    %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mi sgn
                              %mo{:stretchy => "false"} (
