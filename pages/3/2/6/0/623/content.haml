                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %munder
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi qiso
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_\bullet\,\mathbb{Z}[W \mathbb{Z}_2]
                    \\xrightarrow[\;qiso\;]{}
                    N_\bullet\,\mathbb{Z}[\ast]
                    \\,.
            %p
              This reflects the
              %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"} contractible homotopy type
              of both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E \mathbb{Z}_2
              (the total space of the
              = succeed ")" do
                %a{:href => "simplicial+principal+bundle#UniversalSimplicialBundle"}
                  universal principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} S^\infty
          %p
          #NormalizedChainDGAlgebraOnEZTwo.num_remark
            %h6 Example
            %p
              %strong
                (normalized chain dg-algebra of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} E\mathbb{Z}_2
            %p
              On the normalized chain complex of Ex.
              = succeed "," do
                %a.maruku-ref{:href => "#NormalizedChainsOnEZTwo"}
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} W \mathbb{Z}_2
              induces a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+ring"} simplicial ring
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              = succeed "\u201D)" do
                %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ring
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}\big[
                    W \mathbb{Z}_2
                    \\big]
                    \\;\;
                    \\in
                    \\;\;
                    Ring^{\Delta^{op}}
                    \\,.
            %p
              Since the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Ab
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo →
                    %msub
                      %mi Ch
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} N_\bullet \,\colon\, Ab^{\Delta^{op}} \to Ch_{\geq 0}
              is (see
              = succeed ")" do
                %a{:href => "monoidal+Dold-Kan+correspondence#ChainsIsLaxMonoidal"} here
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              via the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} N_\bullet\big( \mathbb{Z}[W \mathbb{Z}_2] \big)
              the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %p To write this out, denote the two generators in each degree by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℤ
                      %mrow
                        %mn 0
                        %mi ⋯
                    %mo ⊕
                    %msub
                      %mi ℤ
                      %mrow
                        %mn 1
                        %mi ⋯
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (0), (1)
                    \\;\in\;
                    \\mathbb{Z}_{0\cdots}
                    \\oplus
                    \\mathbb{Z}_{1\cdots}
                    \\;=\;
                    N_n\big( \mathbb{Z}[W \mathbb{Z}_2] \big)
                    \\,.
            %p
              The non-degenerate cells of the tensor product simplicial group are similarly labeled (via
              = succeed ")" do
                %a{:href => "product+of+simplices#NonDegenerateSimplicesInProductOfSimplices"} this Prop.
            %ol
              %li
                %p
                  a pair of first elements of
                  = succeed "-sequences" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n+1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{0,1\}
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p, q)
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/shuffle"} shuffle
            %p hence:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sh
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} }
                      %mn 2
                    %mo ×
                    %msub
                      %mo ⊔
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                        %mo =
                        %mi n
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mi n
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mi n
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo ⊗
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi W
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    (g, g'), sh
                    \\big)
                    \\;\in\;
                    \\mathbb{Z}
                    \\big[
                    \\{0,1\}^2
                    \\times
                    \\sqcup_{p+q = n}
                    Sh(p,q)
                    \\big]
                    \\;\simeq\;
                    N_{n}
                    \\Big(
                    \\mathbb{Z}\big[
                    W \mathbb{Z}_2
                    \\times
                    W \mathbb{Z}_2
                    \\big]
                    \\Big)
                    \\;\simeq\;
                    N_{n}
                    \\Big(
                    \\mathbb{Z}\big[
                    W \mathbb{Z}_2
                    \\big]
                    \\otimes
                    \\mathbb{Z}\big[
                    W \mathbb{Z}_2
                    \\big]
                    \\Big)
                    \\,.
            %p One immediately finds that on these generators the induced product map is just the group operation, independent of the shuffle:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi N
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo ⊗
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi N
                                  %mo •
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mi ℤ
                                %mo{:stretchy => "false"} [
                                %mo{:stretchy => "false"} (
                                %mtext -
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mtext -
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ]
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %msub
                              %mi N
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi g
                            %mo ,
                            %mi g
                            %mo ′
                            %mo ,
                            %mi sh
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ⋅
                            %mi g
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N_\bullet
                    \\big(
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\otimes
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \&amp;
                    \\xrightarrow{
                    N_\bullet
                    \\big(
                    \\mathbb{Z}[(\text{-})\cdot(\text{-})]
                    \\big)
                    }
                    \&amp;
                    N_\bullet
                    \\big(
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \\\
                    \\big(
                    g, g', sh
                    \\big)
                    \&amp;\mapsto&amp;
                    (g \cdot g')
                    \\mathrlap{\,.}
                    }
            %p
              Composed with the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
              this gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi N
                              %mo •
                            %mspace{:width => "thinmathspace"}
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi W
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ⊗
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi N
                              %mo •
                            %mspace{:width => "thinmathspace"}
                            %mi ℤ
                            %mo{:stretchy => "false"} [
