                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ⋅
                              %mi g
                              %mo ′
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi p
