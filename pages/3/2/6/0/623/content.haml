                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                  %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\big(
                    N_\bullet
                    \\,
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \\otimes
                    \\big(
                    N_\bullet
                    \\,
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \&amp;\xrightarrow{\phantom{----}}&amp;
                    N_\bullet
                    \\big(
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\otimes
                    \\mathbb{Z}[W \mathbb{Z}_2]
                    \\big)
                    \&amp;
                    \\xrightarrow{
