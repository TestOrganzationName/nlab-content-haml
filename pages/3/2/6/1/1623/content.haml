          %ul
            %li
              %p K-theory (Bunke-Schick)
            %li
              %p
                MU-bordisms (unitary bordisms)
                %br>/
                (Bunke-Schröder-Schick-Wiethaupts; and from there Landweber exact cohomology theories)
          %p
            %strong uniqueness theorem (Bunke-Schick)
            (Simons-Sullivan proved this for ordinary integral cohomology)
          %p
            assume
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo *
                %annotation{:encoding => "application/x-tex"} E^*
            is
            = succeed "," do
              %em rationally even
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_50.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi pt
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ℚ
                  %mo =
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi for
                  %mi odd
                  %mi k
                %annotation{:encoding => "application/x-tex"}
                  E^k(pt)\otimes \mathbb{Q} = 0 \;\; for odd k
          %p plus one further technical assumption
          %p
            then any two smooth extensions
            = succeed "," do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
