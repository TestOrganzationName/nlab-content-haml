            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_145.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            into a solution of the quantum master equation
          %p this requires machinery of counter-terms, Wilsonian effective actions, to even define the quantum master equation
          %blockquote
            %p see Kevin Costello’s book linked to on hos website for details
          %p
            %strong theorem
            (joint with O. Gwilliam)
          %p (“wave” version)
          %p conssider the scalar field theory, with an action of the form
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_146.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo ∫
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mi ϕ
                  %mo +
                  %msup
                    %mi m
                    %mn 2
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi arbitrary
                  %mi local
                  %mi higher
