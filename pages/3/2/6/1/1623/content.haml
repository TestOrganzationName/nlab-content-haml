          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_83.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
