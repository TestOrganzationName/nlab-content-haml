            by
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_59.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Embed
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mi n
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
