                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ℤ
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \hat E_{flat}^* = E \mathbb{R}/\mathbb{Z}^{\bullet -1}
          %p
            %strong remark
            it’s not evident hot to obtain more structure like multiplication
          %p
            %strong theorem
            using geometric models, multiplicative smooth extensions with
            = succeed "-integration" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
