                %annotation{:encoding => "application/x-tex"}
                  Embed(D^n, M) \times Enb(\bar D^n \coprod \cdots \coprod \bar D^n, \bar D^n)
          %ul
            %li
              %p what is the classical analog of a factorization algebra?
            %li
              %p and how do we get classical QFT?
          %p
            %strong basic idea
          %p factorization algebras form a symmetric monoidal category
          %p
            so we can look at
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            in the category of factorization algebras
          %p
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi F
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F, F'
            are factorization algebras, then
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_61.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊗
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (F\otimes F')(B) = F(B) \otimes F'(B)
          %p
            %strong def
            a
            %strong classical factorization algebra
            is a commutative algebra in the category of factorization algebras
          %p
            recall, an
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E_\infty
            object in
            = succeed "-algebras" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
            = succeed "-algebra" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p idea of how to associate a classical factorization algebra to a classical field theory is as follows
          %p
            suppose we have classical field theory, e.g. space of fields is section of a vector bundle
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} E \to M
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_66.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  S : \Gamma(M,E) \to \mathbb{R}
          %p is the classical action
          %p
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is local: obtained by
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi int
                %annotation{:encoding => "application/x-tex"} int
            of a Lagrangian
          %p
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ⊂
                  %mi M
                %annotation{:encoding => "application/x-tex"} B  \subset M
            is a ball, let
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_70.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mi ϕ
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi interior
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mi such
                    %mi that
                    %mi ϕ
                    %mi satisfies
                    %mi Euler
                    %mo −
                    %mi Lagrange
                    %mi equations
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  EL(B) =
                  \\left\{
                  \\phi \in \Gamma(interior(B), E)
                  such that \phi satisfies Euler-Lagrange equations
                  \\right\}
          %blockquote
            %p Freed: notice that you are doing here classical QFT in Euclidean signature Costello: yes
          %p
            %strong rough idea
          %p
            the classical factorization algebra
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
