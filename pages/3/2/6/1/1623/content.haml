                    %mi of
                  %annotation{:encoding => "application/x-tex"} \{lifts of
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_151.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
