                  + arbitrary local higher terms
          %p use the above theorem, around the 0-solution
          %p
            Let
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_147.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
