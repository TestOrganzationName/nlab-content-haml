          %p with diffeential including YM action
          %p
            %strong theorem
            if we take the derived space of solutions to the EL equations, looking infinitesimally near a fixed solution, then we find a
            = succeed "-algebra" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_143.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
