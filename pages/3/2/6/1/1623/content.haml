                %annotation{:encoding => "application/x-tex"} T^{(n)} \to T^{(n-1)} \to \cdots \to T^{(1)} \to pt
          %p
            where
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_153.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
