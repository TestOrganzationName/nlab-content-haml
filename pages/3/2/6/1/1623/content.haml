            = succeed "X_S" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_150.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
