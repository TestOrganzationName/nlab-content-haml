          %p
            so
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_157.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi lim
                    %mi n
                  %msup
                    %mi T
                    %mi n
