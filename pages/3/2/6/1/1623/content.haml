                  S^{(k)}
            is a local function, but this is non-canonical
          %p
            %strong more sophisticated version
          %p
            consider any reasonable classical theory, with its classical factorization algebra
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_160.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi S
                %annotation{:encoding => "application/x-tex"} X_S
          %p
            let
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_161.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Q
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi simplicial
                  %mi set
                  %mi of
                  %mi possible
                  %mi quantizations
                  %mi defined
                  %mi mod
                  %msup
                    %mi ℏ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Q^{(n)}(X_S) = simplicial set of possible quantizations defined mod \hbar^{n+1}
          %p
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_162.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Der
                    %mi loc
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Der_{loc}(X_S)
            is the cochain complex of derivations of
            = succeed "," do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_163.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi S
                  %annotation{:encoding => "application/x-tex"} X_S
            = succeed "-structure" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_164.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} P_0
          %p theorem
          %p there exists a sequence of simplicial sets
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_165.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                  %mo →
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi pt
                %annotation{:encoding => "application/x-tex"}
                  T^{(n)} \to T^{(n-1)}
                  \\to
                  \\cdots \to
                  T^{(1)}
                  \\to pt
          %p
            with maps
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_166.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Q
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^{(n)} \to Q^{(n)}(X_S)
          %p
            such that
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_167.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^{(n)}
            fits into a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy fiber diagram
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_168.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi T
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi T
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi obstruction
                        %mtd
                          %msub
                            %mi Der
                            %mi loc
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi S
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T^{(n)}
                  \&amp;\to&amp;
                  0
                  \\\
                  \\downarrow
                  \&amp;&amp;
                  \\downarrow
                  \\\
                  T^{n-1} &amp;\stackrel{obstruction}{\to}&amp; Der_{loc}(X_S)[2]
                  }
          %p
            so we get obstructions; for instance for
            = succeed "-theory" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_169.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \phi^4
            = succeed "-function" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_170.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
          %p
            %strong theorem
            Let
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_171.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            be a simple Lie algebra. Then there is a quantization of Yang-Mills theory on
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_172.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            which is “renormalizable” (behaves well with respect to scaling)
          %p the set of quantizations is 1-dimensional term by term
          %p
            The set of such quantizations is
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_173.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℏ
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \hbar \mathbb{R}[\![\hbar]\!]
          %p
            %strong correlation functions
          %p Where do correlation functions appear?
          %p
            If
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_174.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a factorization algebra on
            = succeed "," do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_175.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi S
                  %annotation{:encoding => "application/x-tex"} M_S
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_176.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi measurements
                  %mi we
                  %mi can
                  %mi make
                  %mi on
                  %mi the
                  %mi ball
                  %mi B
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} F(B) = \{measurements we can make on the ball B\}
          %p
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_177.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %msub
                    %mi B
                    %mn 2
                  %mo ⊂
                  %mi B
                %annotation{:encoding => "application/x-tex"} B_1, B_2 \subset B
            are disjoint, the maps
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_178.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  F(B_1)\otimes F(B_2) \to F(B)
          %p is defined by doing both observations
          %p correlation functions should be cochain maps
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_179.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ⋯
                  %mo ⊗
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\langle
                  F(B_1) \otimes \cdots \otimes F(B_n) \to \mathbb{R}
                  \\rangle
          %p
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_180.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_1, \cdots, B_n
            are disjoint, if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_181.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi i
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_i \in F(B_i)
          %p then
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_182.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi O
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi O
                    %mi n
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\langle O_1, \cdots, O_n\rangle
          %p
            is a measurement of how to observe
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_183.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi i
                %annotation{:encoding => "application/x-tex"} O_i
            correlations
          %p
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_184.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %msub
                    %mi B
                    %mn 2
                  %mo ⊂
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} B_1, B_2 \subset \tilde B
            the diagram
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_185.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi ⋯
                          %mo ⊗
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi B
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} ⟨
                              %mi ⋯
                              %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mi ℝ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mrow
                              %mo{:stretchy => "false"} ⟨
                              %mi ⋯
                              %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi B
                            %mo{:stretchy => "false"} ˜
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi B
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi ⋯
                          %mo ⊗
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi B
                            %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F(B1) \otimes \cdots \otimes F(B_n)
                  \&amp;\stackrel{\langle \cdots \rangle}{\to}&amp;
                  \\mathbb{R}
                  \\\
                  \\downarrow &amp;&amp; \uparrow^{\langle \cdots \rangle}
                  \\\
                  F(\tilde B) \otimes F(B_3) \otimes \cdots \otimes F(B_n)
                  }
          %p should commute (operator product expansion)
          %p we can consider correlation functions with coefficients in any cochain complex, we require they must satisfy this equation
          %p
            %strong def
            (Beilinson-Drinfeld)
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_186.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi homotopy
                  %mi universal
                  %mi recipient
                  %mi of
                  %mi correlation
                  %mi functions
                %annotation{:encoding => "application/x-tex"}
                  CH_\bullet(M,F)
                  \=
                  homotopy universal recipient of correlation functions
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_187.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                  %msub
                    %mi colim
                    %mrow
                      %msub
                        %mi B
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %msub
                        %mi B
                        %mi n
                      %mo ⊂
                      %mi M
                      %mi disjoint
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ⋯
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \= colim_{B_1, \cdots B_n \subset M disjoint}
                  F(B_1) \otimes \cdots F(B_n)
          %p (Kevin Walker (blob homology), Jacob Lurie (topological chiral homology))
          %p
            %strong lemma
            for a massive scalar field,
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_188.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  CH_\bullet(M,F) \simeq \mathbb{R}[\![\hbar]\!]
          %p in general
          %p
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_189.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CH_\bullet(M,F)
            looks like measures on the space of critical points of the classical action
          %p
            if we perturb around isolated critical points,
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_190.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  CH_\bullet(M,F)
                  \=
                  \\mathbb{R}[\![\hbar]\!]
          %p in this situation correlation functions exist and are unique
          %p general program: correlation functions define a measure on the space of classical solutions
          %p (Feynman graphs appear here as homotopies between operads, or something, see his book)
          %hr/
          %p
            %a.existingWikiWord{:href => "/nlab/show/Oberwolfach+Workshop%2C+June+2009+--+Monday%2C+June+8"}> Previous day
            —
            %a.existingWikiWord{:href => "/nlab/show/Oberwolfach+Workshop%2C+June+2009+--+Strings%2C+Fields%2C+Topology"} Main workshop page
            —
