                  EL(B) = \{Harmonic functions on the interior of B\}
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_86.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi B
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi n
                  %mo ,
                  %mi ℝ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi S
                        %mi n
                %annotation{:encoding => "application/x-tex"}
                  O(EL(B)) = \prod_{n \geq 0} Hom(EL(B)^{\otimes n}, \mathbb{R})^{S_n}
          %p
            where Hom means continuous linear maps, and where
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            is the completed tensor product
          %p
            later, for more complex examples, what we really want to do is to take the
            %em derived
            space of EL solutions
          %p
            %strong question
          %p Why does this classical factorization algebra want to become just a factorization algebra?
          %p recall that fact-algebras form a symmetric monoidal category
          %p
            the
            = succeed "-" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E_0
            %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            is defined by
          %ul
            %li
              %p
                %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} E_0(n) = \emptyset
                for
                %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
            %li
              %p
                %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi pt
                    %annotation{:encoding => "application/x-tex"} E_0(0) = pt
          %p
            so for instance an
            = succeed "-algebra" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E_0
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Vect
            is a vector space with an element
          %p
            forgot to mention that factorization algebras need to have a unit, a section
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            on
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_95.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(M)
            which is a unit for the product
          %p
            So: an
            = succeed "-algebra" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_96.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E_0
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_97.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi graded
                          %mi commutative
                          %mi algebra
                          %mi with
                          %mi Poisson
                          %mi bracket
                          %mi of
                          %mi deg
                          %mo +
                          %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi quantize
                        %mtd
                          %msub
                            %mi E
                            %mn 0
                          %mo −
                          %mi algebras
                          %mo{:stretchy => "false"} (
                          %mi in
                          %mi co
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi chain
                          %mi complex
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mi es
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi Poisson
                        %mtd
                          %mover
                            %mo →
                            %mi quantize
                        %mtd
                          %msub
                            %mi E
                            %mn 1
                          %mo −
                          %mi algebras
                      %mtr
                        %mtd
                          %mi graded
                          %mi comm
                          %mi algebra
                          %mi with
                          %mi Poisson
                          %mi bracket
                          %mi of
                          %mi deg
                          %mo −
                          %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi quantize
                        %mtd
                          %msub
                            %mi E
                            %mn 2
                          %mo −
                          %mi algebras
                      %mtr
                        %mtd
                          %mi graded
                          %mi comm
                          %mi algebra
                          %mi with
                          %mi Poisson
                          %mi bracket
                          %mi of
                          %mi deg
                          %mo −
                          %mn 2
                        %mtd
                          %mover
                            %mo →
                            %mi quantize
                        %mtd
                          %msub
                            %mi E
                            %mn 3
                          %mo −
                          %mi algebras
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  graded commutative algebra with Poisson bracket of deg +1
                  \&amp;\stackrel{quantize}{\to}&amp;
                  E_0-algebras (in co[[chain complex]]es)
                  \\\
                  Poisson &amp;\stackrel{quantize}{\to}&amp; E_1-algebras
                  \\\
                  graded comm algebra with Poisson bracket of deg -1
                  \&amp;\stackrel{quantize}{\to}&amp;
                  E_2-algebras
                  \\\
                  graded comm algebra with Poisson bracket of deg -2
                  \&amp;\stackrel{quantize}{\to}&amp;
                  E_3-algebras
                  }
          %p
            Beilinson and Drinfeld define an operad over (i.e. in the category of cochain complex moudles over) the ring of formal power series over
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_98.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℏ
                %annotation{:encoding => "application/x-tex"} \hbar
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_99.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}[\![\hbar]\!]
          %p as follows:
          %ul
            %li
              %p
                generated by
                = succeed "," do
                  %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_100.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋅
                      %annotation{:encoding => "application/x-tex"} \cdot
            %li
              %p
                %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_101.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-,-\}
                a Poisson bracket of deg +1
            %li
              %p
                with differential
                %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_102.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℏ
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} d(-) = \hbar \{-,-\}
          %p
            call this the
            %strong BD operad
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_103.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BD
                  %mo{:stretchy => "false"} /
                  %mi ℏ
                  %mi BD
                  %mo =
                  %mi operad
                  %mi of
                  %mi commutative
                  %mi algebras
                  %mi with
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mi of
                  %mi deg
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  BD/\hbar BD = operad of commutative algebras with \{-,-\} of deg +1
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_104.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi BD
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} ]
                  %mi ℝ
                  %mo{:stretchy => "false"} (
                  %mi ℏ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  H_\bullet(BD(n) \otimes_{\mathbb{R}[\![\hbar]\!]} \mathbb{R}(\hbar))  = 0
          %p so
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_105.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BD
                  %msub
                    %mo ⊗
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} ]
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  BD \otimes_{\mathbb{R}[\![\hbar]\!]} \mathbb{R}[\![\hbar]\!]
                  \\simeq E_0
          %p
            %strong
              rant on
              %a.existingWikiWord{:href => "/nlab/show/BV-theory"} BV-theory
              termionology
          %p
            framed
            = succeed "," do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_106.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
            %em BV-operad
            has
            %strong nothing
            to do with the
            %a.existingWikiWord{:href => "/nlab/show/BV-theory"} BV-theory
          %p
            instead: the BD-operad from above is the one related to
            %a.existingWikiWord{:href => "/nlab/show/BV-theory"} BV-theory
          %p
            %strong def
            the
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_107.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 0
                %annotation{:encoding => "application/x-tex"} P_0
            (or
            = succeed ")" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_108.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Poisson
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Poisson_0
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_109.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mi of
                  %mi deg
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \{-,-\} of deg 1
          %p
            so
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_110.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 0
                  %mo =
                  %mi BD
                  %mo{:stretchy => "false"} /
                  %mi ℏ
                %annotation{:encoding => "application/x-tex"} P_0 = BD/\hbar
          %p
            %strong general fact
          %p
            let
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_111.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a manifold, and
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_112.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi M
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f : M \to \mathbb{R}
            a function, then
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_113.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi derived
                  %mi critical
                  %mi locus
                  %mi of
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(derived critical locus of f)
            is a
            = succeed "-operad" do
              %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_114.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} P_0
          %p
            derived critical locus has as functions the
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_115.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi Λ
                    %mn 2
                  %mi T
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo ∨
                      %mi d
                      %mi f
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi Λ
                    %mi T
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo ∨
                      %mi d
                      %mi f
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi Λ
                    %mo •
                  %mi T
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\Gamma(M,\Lambda^2 T M)
                  \\stackrel{\vee d f}{\to}
                  \\Gamma(M,\Lambda^ T M)
                  \\stackrel{\vee d f}{\to}
                  O(M)
                  \=
                  \\Gamma(M, \Lambda^\bullet T M)
          %p
            here
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_116.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi k
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} \Lambda^k T M
            is in degree
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_117.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi k
                %annotation{:encoding => "application/x-tex"} -k
            with differential
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_118.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                  %mi d
                  %mi f
                %annotation{:encoding => "application/x-tex"} \vee d f
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_119.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi Λ
                    %mo •
                  %mi T
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma(M, \Lambda^\bullet T M)
          %p has Schouten bracket, which is of degree +1
          %p
            This “wants to become”
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_120.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 0
                %annotation{:encoding => "application/x-tex"} E_0
          %p
            %strong observation
            if
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_121.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_122.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi crit
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(crit^n(f))
