          %p
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_159.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
