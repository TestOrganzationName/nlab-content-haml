            then
          .maruku-equation
            %math#mathml_43c142bd26492806eb706aa0500abcb194dae6d7_158.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 1
