          %h2#idea Idea
          %p
            A
            %em symmetric monoidal functor
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            between
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal categories
            that is a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            which respects the symmetry on both sides.
          %h2#definition Definition
          %p
            A (lax)
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : (C,\otimes) \to (D, \otimes)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
