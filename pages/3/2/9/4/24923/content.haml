            %a.existingWikiWord{:href => "/nlab/show/logical+qbits"} logical qbits
            in
            %a.existingWikiWord{:href => "/nlab/show/triples"} triples
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physical+qbits"} physical qbits
          %h4#idea_2 Idea
          %p
            Here the
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LogicalQBit
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi QBit
                  %mo ⊗
                  %mi QBit
                  %mo ⊗
                  %mi QBit
                %annotation{:encoding => "application/x-tex"}
                  LogicalQBit
                  \\;\coloneqq\;
                  QBit \otimes QBit \otimes QBit
          %p
