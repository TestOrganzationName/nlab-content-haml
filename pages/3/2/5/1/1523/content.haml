          %h2#idea Idea
          %p
            The
            = succeed "," do
              %strong extended natural number system
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℕ
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            together with an extra number representing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity"} infinity
          %h2#definition Definition
          %p
            Classically,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            of the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            of natural numbers and a
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\infty\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}} = \{0,1,2,\ldots,\infty\} .
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %strong extended natural number
            is an
            %a.existingWikiWord{:href => "/nlab/show/infinite+sequence"} infinite sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %a.existingWikiWord{:href => "/nlab/show/binary+digits"} binary digits
            (each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} x_i = 1
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi j
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} x_j = 1
            for any
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≤
                    %mi i
                  %annotation{:encoding => "application/x-tex"} j \leq i
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monotone+function"} monotone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is identified with a sequence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            followed by
            = succeed "s," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "s." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %em not
            constructively valid that every natural number is either finite or infinite, but it is valid that any that is not finite is infinite, while
            %a.existingWikiWord{:href => "/nlab/show/Markov%27s+principle"} Markov's principle
            is the converse.
          %h2#universal_property Universal property
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            comes naturally equipped with a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pred
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mn 1
                  %mo +
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} pred\colon \bar{\mathbb{N}} \to 1 + \bar{\mathbb{N}}
            as defined below:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pred
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi x
                            %mo =
                            %mn 0
                            %mo ,
                        %mtr
                          %mtd
                            %mi n
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi x
                            %mo =
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                        %mtr
                          %mtd
                            %mn ∞
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi x
                            %mo =
                            %mn ∞
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  pred(x) = \begin{cases}
                  *      &amp; if\; x = 0 ,\\
                  n      &amp; if\; x = n + 1 ,\\
                  \\infty &amp; if\; x = \infty .\end{cases}
          %p
            Thus, it is a
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            for the endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo +
                  %mi X
                %annotation{:encoding => "application/x-tex"} H(X) = 1 + X
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/terminal+coalgebra"} terminal coalgebra
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mn 1
                    %mo +
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p\colon S \to 1 + S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi corec
                    %mi S
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} corec_S p\colon S \to \bar{\mathbb{N}}
            such that
