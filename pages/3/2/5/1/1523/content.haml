                %use{:x => "183.869271", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph5-1", :y => "48.449085"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "190.525924", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph3-1", :y => "46.778063"}
              %path{:d => "M -40.516089 -34.061805 L 14.697073 -34.061805 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997625,0,0,-0.997625,94.634708,45.335498)"}
              %path{:d => "M -2.487492 2.868992 C -2.033289 1.146151 -1.019161 0.335632 -0.00111844 -0.00110529 C -1.019161 -0.333927 -2.033289 -1.148361 -2.487492 -2.867287 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997625,0,0,-0.997625,109.536272,79.315304)"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "71.724249", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph4-6", :y => "73.874556"}
                %use{:x => "77.59122", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph4-3", :y => "73.874556"}
                %use{:x => "81.706945", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph4-4", :y => "73.874556"}
                %use{:x => "86.400123", "xlink:href" => "#DlMCI6dwl2yZcT0dvp2zfOWW1KI=-glyph4-7", :y => "73.874556"}
          %p
            commutes. Indeed,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi corec
                    %mi S
                  %mi p
                %annotation{:encoding => "application/x-tex"} corec_S p
            is defined corecursively by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi corec
                    %mi S
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} corec_S p(a) = 0
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} p(a) = *
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} pred
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} corec
                    %mi S
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} corec
                    %mi S
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi a
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pred(\corec_S p(a)) = \corec_S p(a^\prime)
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi a
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p(a) = a^\prime \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            is
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            to the
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            in its guise as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
          %p
            You can think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi corec
                    %mi S
                  %mi p
                %annotation{:encoding => "application/x-tex"} corec_S p
            as mapping an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to the maximum number of times that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            can be applied in succession, starting from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            as a possible value. At the other extreme, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} p(a) = *
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            cannot be applied at all to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            before leaving
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi corec
                      %mi S
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} corec_S p(a) = 0
          %p
            Note that this universal property also holds constructively (which is why we can be sure that the constructive definition above is correct). We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pred
                %annotation{:encoding => "application/x-tex"} pred
            constructively as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pred
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi x
                              %mn 0
                            %mo =
                            %mn 1
                            %mo ,
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo ,
                            %mi …
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi x
                              %mn 0
                            %mo =
                            %mn 0
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  pred(x) = \begin{cases}
                  *                &amp; if\; x_0 = 1 ,\\
                  (x_1,x_2,\ldots) &amp; if\; x_0 = 0 .\end{cases}
          %p
            One can thus use this universal property to define an
            %em
              extended natural numbers
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            inside of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %h2#formalization_in_proof_assistants Formalization in proof assistants
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/proof+assistant"} proof assistant
          %pre.coq
            %code.coq
              :preserve
                CoInductive conat : Set :=
                | cozero : conat
                | cosucc : conat -> conat.
                
                CoFixpoint omega : conat := cosucc omega.          %h2#topology Topology
          %p
            We may naturally give
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+structure"} topology
            giving it the structure of a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            %a.existingWikiWord{:href => "/nlab/show/fan+theorem"} fan theorem
            or pass to a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
          %p
            We may define the topology simply (and constructively) as follows: a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
            if, whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \infty \in G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} m \in G
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ≥
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m \geq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            just when almost every finite number also belongs to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            In this way,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/Alexandroff+compactification"} Alexandroff compactification
            of the
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mo ∈
                  %mi G
                  %mo ∈
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \infty \in G \in \mathcal{U}
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            alone contains almost every point, and only finitely many more open sets are needed.
          %p
            It is sometimes convenient to represent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            as a
            %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
            of the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 2
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                %annotation{:encoding => "application/x-tex"} 2^{-n}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            becomes the real number
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi x
                      %mi i
                    %msup
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2} {\sum_{i=0}^\infty x_i 2^{-i}}
                  ,
          %p
            which always converges. Another common representation uses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1/(n+1)
            instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi n
                  %annotation{:encoding => "application/x-tex"} 1/2^n
          %p
            Given any topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/infinite+sequence"} infinite sequence
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be thought of as a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from the discrete space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/convergent+sequence"} converges
            iff this map can be extended to a continuous map on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℕ
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            is sometimes called the
            = succeed "." do
              %strong universal convergent sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is at least
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sequentially+Hausdorff+space"} sequentially Hausdorff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            contains more information than a sequence in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with the property of convergence.)
          %p
            This may all be generalised from sequences to other
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
            %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{D}
            by adjoining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            and taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⊆
                  %mi D
                %annotation{:encoding => "application/x-tex"} G \subseteq D
            as a neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            owns almost all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %h2#in_higher_category_theory In higher category theory
          %p
            Concepts in
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            often come in
            = succeed "-versions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is an extended natural number. (Sometimes it’s also possible to give
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            a few negative values as well; see
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/negative+thinking"} negative thinking
            = succeed "-version" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-versions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-version" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
          %h2#in_constructive_mathematics In constructive mathematics
          %p
            The claim that every extended natural number is either finite or infinite is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi LPO
                %annotation{:encoding => "application/x-tex"} LPO
            ) for natural numbers. On the other hand, the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LPO
                %annotation{:encoding => "application/x-tex"} LPO
            for extended natural numbers is simply true; given any function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℕ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\mathbb{N}}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1\}
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %a{:href => "#Escardo"} Escardó (2011)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
          %h2#references References
          %ul#Escardo
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+Escard%C3%B3"} Martín Escardó
              (2011) via constructivenews,
              %a{:href => "http://www.cs.bham.ac.uk/~mhe/papers/omniscient-2011-07-06.pdf"} Infinite sets that satisfy the principle of omniscience in all varieties of constructive mathematics
              (pdf)
