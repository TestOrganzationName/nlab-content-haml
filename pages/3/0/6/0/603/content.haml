                                  %mn 1
                                %msub
                                  %mo ⊔
                                  %mrow
                                    %msub
                                      %mi D
                                      %mi glue
                                %msub
                                  %mi D
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mi ϕ
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi D
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo ×
                                  %mrow
                                    %mi K
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi D
                                      %mi glue
                                    %mo{:stretchy => "false"} )
                                %mi D
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi D
                                  %mn 2
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo →
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
                                %msub
