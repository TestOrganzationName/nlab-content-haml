                            %msub
                              %mi D
                              %mi glue
                        %msub
                          %mi D
                          %mn 2
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat F \in K(\overline{D_1 \sqcup_{D_{glue}} D_2})
              given by the
              %a.existingWikiWord{:href => "/nlab/show/end"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mi d
                        %mo ∈
                        %msub
                          %mi D
                          %mn 1
                        %msub
                          %mo ⊔
                          %mrow
                            %msub
                              %mi D
