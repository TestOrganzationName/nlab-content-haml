                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F \in K(D_1 \sqcup_{D_{glue}} D_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi D
                      %mn 1
                    %msub
                      %mo ⊔
                      %mrow
                        %msub
                          %mi D
                          %mi glue
                    %msub
                      %mi D
                      %mn 2
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D_1 \sqcup_{D_{glue}} D_2 \to C
              canonically extends to a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %msub
                          %mi D
                          %mn 1
                        %msub
