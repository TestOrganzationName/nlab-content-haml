                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mrow
                                    %mi K
                                    %mo{:stretchy => "false"} (
                                    %mi Y
                                    %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi D
                                  %mn 1
                                %msub
                                  %mo ⊔
                                  %mrow
                                    %msub
                                      %mi D
