              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ⊗
                    %mo ⊥
                    %mo =
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bottom \otimes \bottom = \bottom
          .un_defn
            %h6#definition Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
