                                %msub
                                  %mi D
                                  %mi glue
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        K(\overline{D_1 \sqcup_{D_{glue}} D_2} )
                        \&amp;&amp;&amp;\stackrel{K(Y)}{\to}&amp; K(D_1 \sqcup_{D_{glue}} D_2)
                        \\\
