                  = succeed "-valued" do
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Posets
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} \overline{Posets}
                .maruku-equation
