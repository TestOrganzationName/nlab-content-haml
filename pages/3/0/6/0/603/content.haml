                              %mtd
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi K
                                    %mo{:stretchy => "false"} (
                                    %mi Y
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi K
                                %mo{:stretchy => "false"} (
