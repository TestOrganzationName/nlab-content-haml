                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ⊩
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi suc
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                %annotation{:encoding => "application/x-tex"}
