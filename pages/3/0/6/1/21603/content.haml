                          %mo ⊩
                          %mi Nat
                          %mspace{:width => "2em"}
                          %mi x
                          %mo :
                          %mi Nat
                          %mo ⊢
                          %mi C
                          %mo{:stretchy => "false"} [
                          %mi x
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mi type
                      %mtr
                        %mtd
                          %mi c
                          %mo ⊩
                          %mi C
                          %mo{:stretchy => "false"} [
                          %mi zro
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mi x
                          %mo :
                          %mi Nat
                          %mo ,
                          %mi h
                          %mo :
                          %mi C
                          %mo{:stretchy => "false"} [
                          %mi x
                          %mo{:stretchy => "false"} ]
                          %mo ⊢
                          %mi c
                          %mo ⊩
                          %mi C
                          %mo{:stretchy => "false"} [
                          %mi suc
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                    %mrow
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
