                  \\end{gathered}
          %h3#booleans Booleans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi b
                      %mo ⊩
                      %mi Bool
                      %mspace{:width => "2em"}
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi tru
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "2em"}
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi fls
                      %mo{:stretchy => "false"} ]
                    %mrow
                      %mi c
                      %mo ⊩
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\frac{b \Vdash Bool \qquad
                  c \Vdash C[tru] \qquad
                  c \Vdash C[fls]}
                  {c \Vdash C[b]}
