                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mn 2
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %msub
                          %mi c
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{\!c_1 c_2}{}^{ b_1 b_2 } \rho_{b_1 b_2}
                    \\;=\;
                    \-
                    2\rho_{c_1 c_2}
                    \\,.
            %p
          %p
          .proof
            %h6 Proof
            %p
              Equation
              %a.maruku-eqref{:href => "#eq:FirstImplicationOf11dGravitinoEquation"} (2)
              follows immediately by Clifford contraction:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mspace{:width => "negativethinmathspace"}
                        %mi a
                    %msup
                      %mi Γ
                      %mrow
                        %mi a
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 9
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{\!a} \Gamma^{a b_1 b_2} \,\rho_{b_1 b_2}
                    \\;=\;
                    9 \, \Gamma^{b_1 b_2} \,\rho_{b_1 b_2}
            %p
              Equation
              %a.maruku-eqref{:href => "#eq:SecondImplicationOf11dGravitinoEquation"} (3)
              follows by the contraction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi Γ
                            %mrow
                              %mspace{:width => "negativethinmathspace"}
                              %mi c
                              %mi a
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ρ
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 18
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi Γ
                            %mi b
                          %msub
                            %mi ρ
                            %mrow
                              %mi c
                              %mi b
                          %mspace{:width => "thickmathspace"}
                          %mo +
                          %mspace{:width => "thickmathspace"}
                          %mn 8
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi Γ
                            %mrow
                              %mi c
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                          %msub
                            %mi ρ
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Gamma_{\!c a} \Gamma^{a b_1 b_2} \, \rho_{b_1 b_2}
                    \\;=\;
                    18 \, \Gamma^{b} \rho_{ c b }
                    \\;+\;
                    8 \, \Gamma^{c b_1 b_2} \rho_{b_1 b_2}
                    \\end{array}
            %p
              and using that the second summand vanishes by assumption
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GravitinoEquationIn11dSugra"} (1)
            %p
              For equation
              %a.maruku-eqref{:href => "#eq:ThirdImplicationOf11dGravitinoEquation"} (4)
              we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %mi a
                              %mo ′
                          %msub
                            %mi ρ
                            %mrow
                              %mi a
                              %mo ′
                              %mi b
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi Γ
                            %mi a
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %mo ′
                          %msub
                            %mi ρ
                            %mrow
                              %mi a
                              %mo ′
                              %mi b
                          %mo −
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %mo ′
                          %msup
                            %mi Γ
                            %mi a
                          %msub
                            %mi ρ
                            %mrow
                              %mi a
                              %mo ′
                              %mi b
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %mo ′
                          %msup
                            %mi Γ
                            %mi a
