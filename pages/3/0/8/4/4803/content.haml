            %h6 Proposition
            %p
              %strong (implications of 11d gravitino equation)
            %p
              We have the following implications of the gravitino equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %mi a
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma^{a b_1 b_2} \rho_{b_1 b_2} \;=\; 0
              %a.maruku-eqref{:href => "#eq:GravitinoEquationIn11dSugra"} (1)
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            #eq:FirstImplicationOf11dGravitinoEquation.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{b_1 b_2} \, \rho_{b_1 b_2} \;=\; 0
            #eq:SecondImplicationOf11dGravitinoEquation.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{b_1} \, \rho_{b_1 b_2} \;=\; 0
            #eq:ThirdImplicationOf11dGravitinoEquation.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi a
                        %mo ′
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %mi a
                        %mo ′
                        %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %msup
                      %mi ρ
                      %mi a
                    %msub
                      %mrow
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{a a'} \, \rho_{a' b} \;=\; - \rho^a{}_b
            #eq:FourthImplicationOf11dGravitinoEquation.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mspace{:width => "negativethinmathspace"}
                        %msub
                          %mi c
                          %mn 1
                        %msub
                          %mi c
                          %mn 2
                    %msup
                      %mrow
                      %mrow
                        %msub
                          %mi b
