          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            the term
            %em gravitino
            refers to the
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} superpartner
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
            %a.existingWikiWord{:href => "/nlab/show/Rarita-Schwinger+field"} Rarita-Schwinger field
            of
            %a.existingWikiWord{:href => "/nlab/show/spin"} spin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 3/2
            that appears in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            a
            %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            is a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            on
            %a.existingWikiWord{:href => "/nlab/show/super+spacetime"} super spacetime
            locally given by a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+differential+form"} Lie algebra-valued differential form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
