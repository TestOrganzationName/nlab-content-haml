                              %mi b
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %msup
                            %mi Γ
                            %mi a
                          %msup
                            %mi Γ
                            %mrow
                              %mi a
                              %mo ′
                          %msub
                            %mi ρ
                            %mrow
                              %mi a
                              %mo ′
                              %mi b
                          %mo −
                          %msup
                            %mi η
                            %mrow
                              %mi a
                              %mi a
                              %mo ′
                          %msub
                            %mi ρ
                            %mrow
                              %mi a
                              %mo ′
                              %mi b
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %msup
                            %mi ρ
                            %mi a
                          %msub
                            %mrow
                            %mi b
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Gamma^{a a'}\rho_{a' b}
                    \\\
                    \\;=\;
                    \\tfrac{1}{2}
                    \\big(
                    \\Gamma^a \Gamma^{a'} \rho_{a' b}
                    \-
                    \\Gamma^{a'} \Gamma^a \rho_{a' b}
                    \\big)
                    \\\
                    \\;=\;
                    \-
                    \\tfrac{1}{2}
                    \\Gamma^{a'} \Gamma^a \rho_{a' b}
                    \\\
                    \\;=\;
                    \\tfrac{1}{2}
                    \\Gamma^a \Gamma^{a'} \rho_{a' b}
                    \-
                    \\eta^{a a'} \rho_{a' b}
                    \\\
                    \\;=\;
                    \-\rho^a{}_b
                    \\,,
                    \\end{array}
            %p
              where in the second and fourth step we used
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SecondImplicationOf11dGravitinoEquation"} (3)
            %p
              For
              %a.maruku-eqref{:href => "#eq:FourthImplicationOf11dGravitinoEquation"} (5)
              we consider this contraction:
