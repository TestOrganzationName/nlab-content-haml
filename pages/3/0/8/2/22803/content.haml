                              %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} logical conjunction
                            %a.existingWikiWord{:href => "/nlab/show/and"} and
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/join"}> join
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/logical+disjunction"} logical disjunction
                            %a.existingWikiWord{:href => "/nlab/show/or"} or
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/compact+element"} compact element
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/lattice+of+subobjects"} lattice of subobjects
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/complete+lattice"}> complete lattice
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/algebraic+lattice"} algebraic lattice
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"}> distributive lattice
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/completely+distributive+lattice"} completely distributive lattice
                        %a.existingWikiWord{:href => "/nlab/show/canonical+extension"} canonical extension
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/first-order+hyperdoctrine"}> first-order
                          ,
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+hyperdoctrine"} Boolean
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/coherent+hyperdoctrine"} coherent
                          %a.existingWikiWord{:href => "/nlab/show/tripos"} tripos
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/frame"}> frame
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                  %h2#theorems Theorems
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#classical_definition"} Classical definition
                %li
                  %a{:href => "#with_the_join_operation"} With the join operation
                %li
                  %a{:href => "#with_the_ramp_function"} With the ramp function
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#jaffardohmkaplansky_theorem"} Jaffard-Ohm-Kaplansky theorem
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em lattice-ordered abelian group
            or
            %em l-group
            is an
            %a.existingWikiWord{:href => "/nlab/show/ordered+abelian+group"} ordered abelian group
            whose
            %a.existingWikiWord{:href => "/nlab/show/order"} order
            forms a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
            %a.existingWikiWord{:href => "/nlab/show/top"} top
            or
            %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
            elements, because otherwise the only such object is the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
          %h2#definition Definition
          %h3#classical_definition Classical definition
          %p
            A
            %strong lattice-ordered abelian group
            or
            %strong abelian l-group
            is an
            %a.existingWikiWord{:href => "/nlab/show/ordered+group"} ordered abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mo ≤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G,\le)
            such that every
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} a,b \in G
            admits a
            %a.existingWikiWord{:href => "/nlab/show/meet"} meet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∧
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \wedge b
            in the
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            (
            %a{:href => "#Gilmer92"}> Gilmer 1992
            , p. 158).
          %h3#with_the_join_operation With the join operation
          %p
            A
            %strong lattice-ordered abelian group
            or
            %strong abelian l-group
            is an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with a binary
            %a.existingWikiWord{:href => "/nlab/show/join"} join
            operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo ×
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} (-)\vee(-)\colon G \times G \to G
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mo ∨
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G, \vee)
            is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+magma"} commutative
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
          %ul
            %li
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} a \in G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} b \in G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} c \in G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∨
                    %mi b
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \vee b = b
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo +
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} (a + c) \vee (b + c) = b + c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo +
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo +
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                    %mo +
                    %mi b
                  %annotation{:encoding => "application/x-tex"} (c + a) \vee (c + b) = c + b
          %p The meet is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∧
                  %mi b
                  %mo ≔
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi a
                  %mo ∨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  a \wedge b \coloneqq -(-a \vee -b),
          %p the ramp function is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi a
                  %mo ∨
                  %mn 0
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ramp(a) \coloneqq a \vee 0,
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo{:stretchy => "false"} |
                  %mo ≔
                  %mi a
                  %mo ∨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\vert a \vert \coloneqq a \vee -a
                  \\,.
          %p
            The order relation is defined as in all pseudolattices:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≤
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \leq b
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi a
                    %mo ∧
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = a \wedge b
          %h3#with_the_ramp_function With the ramp function
          %p
            The following
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic
            definition is from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"} Peter Freyd
          %p
            A
            %strong lattice-ordered abelian group
            or
            %strong l-group
            is an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ramp
                  %mo :
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} ramp:G \to G
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  a = ramp(a) - ramp(-a)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo −
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ramp(a - ramp(b)) = ramp(ramp(a) - ramp(b))
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/join"} join
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %mo ×
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} (-)\vee(-):G \times G \to G
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∨
                  %mi b
                  %mo ≔
                  %mi a
                  %mo +
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo −
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  a \vee b \coloneqq a + ramp(b - a)
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/meet"} meet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %mo ×
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} (-)\wedge(-):G \times G \to G
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∧
                  %mi b
                  %mo ≔
                  %mi a
                  %mo −
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo −
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  a \wedge b \coloneqq a - ramp(a - b)
          %p and the absolute value is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo{:stretchy => "false"} |
                  %mo ≔
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ramp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\vert a \vert \coloneqq ramp(a) + ramp(-a)
          %p
            The order relation is defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≤
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \leq b
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ramp
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} ramp(a - b) = 0
          %h2#examples Examples
          %ul
            %li
              %p
                All
                %a.existingWikiWord{:href => "/nlab/show/total+order"} totally ordered
                abelian groups, such as the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %li
              %p
                An example of a lattice-ordered abelian group that is not totally ordered is the abelian group of
                %a.existingWikiWord{:href => "/nlab/show/Gaussian+integers"} Gaussian integers
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ramp
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} ramp(1) \coloneqq 1
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ramp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi i
                      %annotation{:encoding => "application/x-tex"} ramp(i) \coloneqq i
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                be an integral domain,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(R)
                its field of fraction and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(R)
                its group of units. The
                %em group of divisibility
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                (
                %a{:href => "#Gilmer92"}> Gilmer 1992
                , p.174), denoted
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(R)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                          %mo \
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      D(R) = \frac{F(R) \backslash \{0\}}{U(R)}
              %p
                The abelian group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(R)
                becomes an ordered abelian group if we define an order as follows: for every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi rU
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi sU
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} rU(R),sU(R) \in D(R)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi rU
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi sU
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} rU(R) \le sU(R)
                iff
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sr
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} sr^{-1} \in R
          %p
          .num_prop
            %h6 Proposition
            %p
              [Gilmer 1992, p.174] Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be an integral domain. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(R)
              is a lattice-ordered abelian group iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/GCD+domain"} GCD domain
          %h2#jaffardohmkaplansky_theorem Jaffard-Ohm-Kaplansky theorem
          %p
          .num_theorem
            %h6 Theorem
            %p
              [Gilmer 1992, p.215] Every lattice-ordered abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is order-isomorphic to the group of divisibility of a
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout domain
              i.e. there exists a Bézout domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and a group isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi G
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:G \rightarrow D(R)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≤
                      %mi h
                      %mo ⇔
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \le h \Leftrightarrow f(g) \le f(h)
