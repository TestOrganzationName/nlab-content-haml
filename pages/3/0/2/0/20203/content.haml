                    In terms of
                    = succeed "-structure" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi G
                          %annotation{:encoding => "application/x-tex"} G
                %li
                  %a{:href => "#ReferencesWithSpin7Structure"}
                    With
                    = succeed "-structure" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mn 7
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Spin(7)
                %li
                  %a{:href => "#with_structure_2"}
                    With
                    = succeed "-structure" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Sp
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi Sp
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Sp(2)\cdot Sp(1)
                %li
                  %a{:href => "#wittens_dark_fantasy"} Witten’s Dark Fantasy
                %li
                  %a{:href => "#m2brane_spacetimes"} M2-brane spacetimes
                %li
                  %a{:href => "#mtheory_on_"}
                    M-theory on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mn 3
                          %mo ×
                          %mi K
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} K3 \times K3
          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            which are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/8-manifolds"} 8-manifolds
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            this is KK-compactification to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/3d+supergravity"} 3d supergravity
          %p
            Typically this is considered with a
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            on the compactification fiber from
            %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
            %em
              M-theory on
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29-manifolds"} Spin(7)-manifolds
            (see the references
            = succeed ")." do
              %a{:href => "#ReferencesWithSpin7Structure"} below
            %a.existingWikiWord{:href => "/nlab/show/G2-structure"} G2-structure
            yields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G2-manifolds"} M-theory on G2-manifolds
          %h2#properties Properties
          %h3#cfield_tadpole_cancellation_condition C-field tadpole cancellation condition
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} compactified
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/8-manifold"} 8-manifold
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            %a.existingWikiWord{:href => "/nlab/show/tadpole+cancellation"} tadpole cancellation
            for the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            (see also at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/C-field+tadpole+cancellation"} C-field tadpole cancellation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mrow
                      %mi M
                      %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %munder
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 48
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi p
                          %mn 2
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msubsup
                          %mi p
                          %mn 1
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi X
                          %mn 8
                        %mo{:stretchy => "false"} ]
                      %mo ⏟
                    %mrow
                      %msub
                        %mi I
                        %mn 8
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 8
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  N_{M2}
                  \\;+\;
                  \\tfrac{1}{2} \big( G_4[X^{(8)}]\big)^2
                  \\;=\;
                  \\underset{
                  I_8(X^8)
                  }{
                  \\underbrace{
                  \\tfrac{1}{48}\big( p_2 - \tfrac{1}{2}p_1^2  \big)[X^{8}]
                  }
                  }
                  \\;\;\;\;
                  \\in
                  \\mathbb{Z}
                  \\,,
          %p where
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mrow
                          %mi M
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} N_{M2}
                is the net number of
                %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
                in the spacetime (whose
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
                appears as points in
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 8
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X^{(8)}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} G_4
                is the
                = succeed "/flux" do
                  %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
                is the
                %a.existingWikiWord{:href => "/nlab/show/first+Pontryagin+class"} first Pontryagin class
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
                the
                %a.existingWikiWord{:href => "/nlab/show/second+Pontryagin+class"} second Pontryagin class
                combining to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/I8"} I8
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mn 8
                %annotation{:encoding => "application/x-tex"} X^{8}
            has
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29-structure"} Spin(7)-structure
              (hence in particular if it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo =
                  %annotation{:encoding => "application/x-tex"} SU(4) =
              = succeed "-structure)" do
                %a.existingWikiWord{:href => "/nlab/show/Spin%286%29"} Spin(6)
          %p or
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29-structure"} Sp(2).Sp(1)-structure
          %p then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi p
                    %mn 2
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 4
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi χ
                %annotation{:encoding => "application/x-tex"}
                  \\tfrac{1}{2}\big( p_2 - \tfrac{1}{4}(p_1)^2  \big)
                  \\;=\;
                  \\chi
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            (see
            %a{:href => "Spin7-manifold#CharacteristicClassesForSpinStructure"} this Prop.
            and
            = succeed "," do
              %a{:href => "quaternion-Kähler+manifold#CharacteristicClassesForSpin5Spin3Structure"} this Prop.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mrow
                      %mi M
                      %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %mi χ
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mn 8
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  N_{M2}
                  \\;+\;
                  \\tfrac{1}{2} \big( G_4[X^{(8)}]\big)^2
                  \\;=\;
                  \\tfrac{1}{24}\chi[X^8]
                  \\;\;\;\;
                  \\in
                  \\mathbb{Z}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \chi[X]
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            For references see
            = succeed "." do
              %a{:href => "C-field+tadpole+cancellation#References"} there
          %p
            %br/
          %h3#RelationToFTheory Relation to F-theory
          %p
            If the 8-dimensional
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            themselves are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+fibrations"} elliptic fibrations
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on these 8-manifolds is supposedly
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-dual
            to
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactified
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 3+1
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dimensions"} dimensions
          %p
            In particular, if there is an
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} filling
            the base 2+1-dimensional spacetime, this is supposedly
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-dual
            to a 3+1-dimensional spacetime filling
            %a.existingWikiWord{:href => "/nlab/show/D3-brane"} D3-brane
            in
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            (e.g.
            = succeed ")" do
              %a{:href => "#CondeescuMicuPalti14"} Condeescu-Micu-Palti 14, p. 2
          %p
            For more on this see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/F%2FM-theory+on+elliptically+fibered+Calabi-Yau+4-folds"} F/M-theory on elliptically fibered Calabi-Yau 4-folds
            and at
            %em
              %a.existingWikiWord{:href => "/nlab/show/F-theory+on+Spin%287%29-manifolds"} F-theory on Spin(7)-manifolds
            and at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Witten%27s+Dark+Fantasy"} Witten's Dark Fantasy
          %p
            (
            %a{:href => "#BonettiGrimmPugh13a"}> Bonetti-Grimm-Pugh 13a
            ,
            = succeed "," do
              %a{:href => "#BonettiGrimmPugh13b"} Bonetti-Grimm-Pugh 13b
            = succeed ")" do
              %a{:href => "#Pugh"} Pugh
          %p
            %br/
          %h3#BlackM2BranesAndExotic7Spheres Black M2-branes and Exotic 7-spheres
          %p
            The discovery of
            %a.existingWikiWord{:href => "/nlab/show/exotic+7-spheres"} exotic 7-spheres
            proceeded via
            %a.existingWikiWord{:href => "/nlab/show/8-manifolds"} 8-manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            to the
            %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi X
                    %msub
                      %mo ≃
                      %mi homeo
                    %msup
                      %mi S
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \partial X \simeq_{homeo} S^7
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            with its canonical
            %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
            (for more see
            = succeed ")." do
              %a{:href => "8-manifold#ExoticBoundary7Spheres"} there
          %p
            Hence when regarded from the point of view of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+on+8-manifolds"} M-theory on 8-manifolds
            %a.existingWikiWord{:href => "/nlab/show/near+horizon+limits"} near horizon limits
            of peculiar
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 1
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2,1} \times X
          %p
            See also
            = succeed "." do
              %a{:href => "#MorrisonRPlesser99"} Morrison-Plesser 99, section 3.2
          %h3#RelationToJTwistedCohomotopy Relation to J-twisted Cohomotopy
          %p
            On a
            %a.existingWikiWord{:href => "/nlab/show/spin-manifold"} spin-manifold
            %a.existingWikiWord{:href => "/nlab/show/8-manifold"} of dimension 8
            a choice of topological
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
            is equivalently a choice of
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+Cohomotopy+cohomology+theory"} twisted Cohomotopy cohomology theory
            = succeed ")" do
              %a.existingWikiWord{:href => "/schreiber/show/Twisted+Cohomotopy+implies+M-theory+anomaly+cancellation"} FSS 19, 3.4
          %ol
            %li
              %p
                the standard
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                %a.existingWikiWord{:href => "/nlab/show/structures"} structures
                on the
                %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
                (see
                = succeed ")" do
                  %a{:href => "7-sphere#CosetSpaceRealization"} here
            %li
              %p
                the fact that
                %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
                are the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
                of the maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi H
                      %mo →
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B H \to B G
                of the corresponding
                %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
                (see
                = succeed ")" do
                  %a{:href => "coset#ForInfinityGroups"} here
          %p
            %img{:src => "/nlab/files/ExceptionalSpheres.jpg", :width => "730px"}/
          %h2#related_concepts Related concepts
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
                of
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+a+circle"} M-theory on a circle
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+8-manifolds"}> M-theory on 8-manifolds
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+Spin%287%29-manifolds"} on Spin(7)-manifolds
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
