              %a.existingWikiWord{:href => "/nlab/show/Mirjam+Cvetic"}> Mirjam Cvetic
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Heckman"} Jonathan Heckman
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gianluca+Zoccarato"} Gianluca Zoccarato
              %em Geometric Unification of Higgs Bundle Vacua
              (
              %a{:href => "https://arxiv.org/abs/2003.13682"}> arXiv:2003.13682
              )
          %h3#with_structure_2
            With
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(2)\cdot Sp(1)
          %p
            M-theory on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/HP%5E2"} HP^2
            %a.existingWikiWord{:href => "/nlab/show/quaternion-K%C3%A4hler+manifold"} quaternion-Kähler manifold
            of dimension 8 with
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29"} Sp(2).Sp(1)
          %ul
            %li#AtiyahWitten01
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  \-Theory dynamics on a manifold of
                  = succeed "-holonomy" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} G_2
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0107177"} arXiv:hep-th/0107177
          %p
            and argued to be
            %a.existingWikiWord{:href => "/nlab/show/duality+in+string+theory"} dual
            to
            %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G2-manifolds"} M-theory on G2-manifolds
            in three different ways, which in turn is argued to lead to a possible
            %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            of
            %a.existingWikiWord{:href => "/nlab/show/confinement"} confinement
            in the resulting 4d
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            (see
            %a{:href => "M-theory+on+G2-manifolds#Confinement"} there
            for more).
          %p See also
          %ul
            %li#FSS19b
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Twisted+Cohomotopy+implies+M-theory+anomaly+cancellation"} Twisted Cohomotopy implies M-theory anomaly cancellation
              (
              %a{:href => "https://arxiv.org/abs/1904.10207"}> arXiv:1904.10207
              )
          %h3#wittens_dark_fantasy Witten’s Dark Fantasy
          %p
            For more on the following see at
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Witten%27s+Dark+Fantasy"} Witten's Dark Fantasy
          %p
            An argument for
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative
            non-
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            4d
            %a.existingWikiWord{:href => "/nlab/show/string+phenomenology"} string phenomenology
            with fundamentally vanishing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            %a.existingWikiWord{:href => "/nlab/show/M-theory+on+8-manifolds"} M-theory on 8-manifolds
            decompactified at strong coupling to 4d via
            %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
            (recall the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/super+2-brane+in+4d"} super 2-brane in 4d
          %ul
            %li#Witten00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , p. 7 of:
                = succeed "," do
                  %em The Cosmological Constant From The Viewpoint Of String Theory
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/972507"} DM2000
                = succeed "," do
                  %em Sources and detection of dark matter and dark energy in the universe 2000
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-ph/0002297"} arXiv:hep-ph/0002297
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-3-662-04587-9"} doi:10.1007/978-3-662-04587-9
              %p (see p. 7)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Strong coupling and the cosmological constant
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9506101"} arXiv:hep-th/9506101
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , Section 3 of
                = succeed "," do
                  %em Some Comments On String Dynamics
                %a{:href => "https://cds.cern.ch/record/305869"} Strings95
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9507121"}> arXiv:hep-th/9507121
                )
          %p
            The realization of this scenario in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/F-theory+on+Spin%287%29-manifolds"} F-theory on Spin(7)-manifolds
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
                , Section 4.3 of:
                = succeed "," do
                  %em Evidence for F-Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9602022"} arxiv:hep-th/9602022
            %li#BonettiGrimmPugh13a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Federico+Bonetti"}> Federico Bonetti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Grimm"} Thomas Grimm
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tom+Pugh"} Tom Pugh
                = succeed "," do
                  %em
                    Non-Supersymmetric F-Theory Compactifications on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 7
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(7)
                    Manifolds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1307.5858"} arXiv:1307.5858
            %li#BonettiGrimmPugh13b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Federico+Bonetti"}> Federico Bonetti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Grimm"} Thomas Grimm
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eran+Palti"} Eran Palti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tom+Pugh"} Tom Pugh
                = succeed "," do
                  %em
                    F-Theory on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 7
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(7)
                    Manifolds: Weak-Coupling Limit
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1309.2287"} arXiv:1309.2287
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Heckman"}> Jonathan Heckman
                , Craig Lawrie, Ling Lin,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gianluca+Zoccarato"} Gianluca Zoccarato
                = succeed "," do
                  %em F-theory and Dark Energy
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1811.01959"} arXiv:1811.01959
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1002/prop.201900057"} doi:10.1002/prop.201900057
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Heckman"}> Jonathan Heckman
                , Craig Lawrie, Ling Lin, Jeremy Sakstein,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gianluca+Zoccarato"} Gianluca Zoccarato
                %em Pixelated Dark Energy
                (
                %a{:href => "https://arxiv.org/abs/1901.10489"}> arXiv:1901.10489
                )
