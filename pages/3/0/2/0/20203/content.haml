          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed ",(" do
                  %em An Analysis of Fluxes by Duality
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/0504036"} arXiv:hep-th/0504036
                = succeed ")" do
                  %a{:href => "https://inspirehep.net/literature/679724"} spire:679724
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Aspinwall"}> Paul Aspinwall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Renata+Kallosh"} Renata Kallosh
                = succeed "," do
                  %em
                    Fixing All Moduli for M-Theory on
