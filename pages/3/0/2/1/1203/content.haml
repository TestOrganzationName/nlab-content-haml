              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            as the
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            of all
            %a.existingWikiWord{:href => "/nlab/show/ordered+integral+domain"} ordered integral subdomains
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
