                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
          %h3#rational_numbers Rational numbers
          %p
            If one has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/trichotomous"} trichotomous
            %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %a.existingWikiWord{:href => "/nlab/show/subfield"} subfield
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            is equal to the
            %a.existingWikiWord{:href => "/nlab/show/improper+subset"} improper subset
            of
            = succeed "." do
