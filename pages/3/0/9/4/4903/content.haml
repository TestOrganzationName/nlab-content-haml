                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = \infty Sh(C)
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
