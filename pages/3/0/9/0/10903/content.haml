                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            We discuss here structures (constructions) that may be defined and studied within an indexed monoidal
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#TheCanonicalComodality Exponential modality and Fock spaces
          %p
            The original axiomatics for
            %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            in (
            %a{:href => "#Girard87"}> Girard 87
            ) contain in addition to the structures corresponding to a (
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"}> star-autonomous
            )
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            a certain (co-)
            %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            traditionally denoted “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            ”, the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
          %p
            In (
            %a{:href => "#Benton95"}> Benton 95, p.9,15
            ,
            = succeed ")" do
              %a{:href => "#Bierman95"} Bierman 95
            = succeed "))" do
              %a{:href => "#Barber97"} Barber 97, p. 21 (26)
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for this modality identifies it with the
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            that is induced from a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+adjunction"} strong monoidal adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ⊣
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mover
                    %munder
                      %mo ⟶
                      %mi Ω
                    %mover
                      %mo ←
                      %mi Σ
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  (\Sigma \dashv \Omega)
                  \\;\colon\;
                  Mod(\ast)
                  \\stackrel{\overset{\Sigma}{\leftarrow}}{\underset{\Omega}{\longrightarrow}}
                  \\mathcal{C}
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(\ast)
            which interprets the given
            %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            and a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            If there is only the
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒞
                  %mo ⟶
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma \;\colon\; \mathcal{C} \longrightarrow Mod(\ast)
            without possibly a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            = succeed ")" do
              %a{:href => "#Barber97"} Barber 97, p. 21 (27)
            %em
              structural
              %a.existingWikiWord{:href => "/nlab/show/fragment"} fragment
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
          %p
            In (
            %a{:href => "#PontoShulman12"}> Ponto-Shulman 12
            ) it is observed that this in turn is canonically induced if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(\ast)
            is the
            %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            over the trivial context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            of a dependent linear type theory (
            %a.existingWikiWord{:href => "/nlab/show/indexed+closed+monoidal+category"}> indexed closed monoidal category
            ) with category of contexts being
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #Sigma.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mi MonCat
                  %annotation{:encoding => "application/x-tex"} Mod \colon \mathcal{C}^{op} \to MonCat
              be an indexed monoidal
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              an object, set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %msub
                      %mn 1
                      %mi X
                    %mo ∈
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(X) \coloneqq \underset{X}{\sum} 1_X
                    \\in Mod(\ast)
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; Y \longrightarrow X
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi Y
                    %msub
                      %mn 1
                      %mi Y
                    %mover
                      %mo →
                      %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mn 1
                      %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϵ
                          %mi f
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %msub
                      %mn 1
                      %mi X
                    %mo =
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(f)
                    \\coloneqq
                    \\Sigma(Y)
                    \=
                    \\underset{Y}{\sum} 1_Y
                    \\stackrel{\simeq}{\to}
                    \\underset{X}{\sum} \underset{f}{\sum} f^\ast 1_X
                    \\stackrel{\underset{X}{\sum}(\epsilon_f)}{\longrightarrow}
                    \\underset{X}{\sum} 1_X
                    \=
                    \\Sigma(X)
                    \\,.
          %p
            (In the typical kind of model this means to assign to a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the linear space of
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of the trivial
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            over it.)
          #SigmaFunctor.num_prop
            %h6#proposition_7 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#Sigma"}
              gives a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma
                    \\;\colon\;
                    \\mathcal{C}
                    \\longrightarrow
                    Mod(\ast)
          %p
            This is (
            %a{:href => "#PontoShulman12"}> Ponto-Shulman 12, (4.3)
            ).
          .num_remark
            %h6#remark_4 Remark
            %p
              Below in example
              %a.maruku-ref{:href => "#SigmaFunctorAsSecondaryTransform"}
              we see that the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              in prop.
              %a.maruku-ref{:href => "#SigmaFunctor"}
              is a special case of a general construction of secondary integral transforms in an indexed monoidal
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p This suggests the following definition.
          #SemanticsForExponentialModality.num_defn
            %h6#definition_6 Definition
            %p
              Given an indexed monoidal
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              from prop.
              %a.maruku-ref{:href => "#SigmaFunctor"}
              has a strong monoidal
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega \colon Mod(\ast) \longrightarrow \mathcal{C}
            %p
              we refer to the
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ⊣
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma \dashv \Omega)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mo ≔
                    %mi Σ
                    %mo ∘
                    %mi Ω
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \! \coloneqq \Sigma \circ \Omega \colon Mod(\ast) \to Mod(\ast)
                    \\,.
            %p
              as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
              in the conjectural
              %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
              over the point whose semantics is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mod(\ast)
          .num_remark
            %h6#remark_5 Remark
            %p
              The condition in def.
              %a.maruku-ref{:href => "#SemanticsForExponentialModality"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (and its relative/dependent versions) has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              may also be understood as saying that the dependent linear type theory satisfies the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+comprehension"} axiom of comprehension
              %em
                %a{:href => "http://ncatlab.org/nlab/show/axiom+of+separation#ExamplesDependentLinearTypeTheory"} comprehension – Examples – In dependent linear type theory
              for more.
          %h3#dependent_linear_demorgan_duality Dependent linear deMorgan duality
          #LinearNegation.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes
              a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{D} \coloneqq [-,1]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              given by internal hom into the unit object. Syntactically this corresponds to the
              %em
                linear
                %a.existingWikiWord{:href => "/nlab/show/negation"} negation
              operation.
          #DependentLinearDeMorganDuality.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong (dependent linear de Morgan duality)
            %p
              In an indexed monoidal
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "," do
                %a.maruku-ref{:href => "#LinearNegation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mi 𝔻
                    %mo ≃
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{f}{\prod} \mathbb{D}
                    \\simeq
                    \\mathbb{D} \underset{f}{\sum}
          %p
            For proof see
            %a{:href => "Wirthm&#252;ller%20context#ComparisonOfPushForwardsAndWirthmuelleriso"} here
            at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wirthm%C3%BCller+context"} Wirthmüller context
          %h3#PrimaryIntegralTransform Primary integral transforms
          #PolynomialFunctorsAndCorrespondences.num_defn
            %h6#definition_8 Definition
            %p
              Given an indexed monoidal
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo →
                      %mi SymMonCat
                    %annotation{:encoding => "application/x-tex"} Mod\colon \mathcal{C}^{op}\to SymMonCat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1, X_2
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              then a
              %strong
                linear
                %a.existingWikiWord{:href => "/nlab/show/polynomial+functor"} polynomial functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P \colon Mod(X_1) \to Mod(X_2)
            %p is a functor of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi g
                    %msubsup
                      %mi f
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    P \simeq \underset{f_2}{\sum} \underset{g}{\prod} f_1^\ast
            %p
              for a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y &amp;\stackrel{g}{\longrightarrow}&amp; Z
                    \\\
                    \&amp; {}^{\mathllap{f_1}}\swarrow  &amp; &amp;&amp; &amp; \searrow^{\mathrlap{f_2}}
                    \\\
                    X_1
                    \&amp;&amp;
                    \&amp;&amp;
                    \&amp;&amp;
                    X_2
                    }
                    \\,.
            %p
              If here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} g = id
              then this diagram is a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;  Z
                    \\\
                    \&amp; {}^{\mathllap{f_1}}\swarrow  &amp; &amp; \searrow^{\mathrlap{f_2}}
                    \\\
                    X_1
                    \&amp;&amp;
                    \&amp;&amp;
                    X_2
                    }
            %p
              and the resulting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msubsup
                      %mi f
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P \simeq \underset{f_2}{\sum}f_1 ^\ast
              is called a
              %strong linear polynomial functor
              or
              = succeed "." do
                %strong
                  primary
                  %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
          .num_prop
            %h6#proposition_9 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              as above, then the primary integral transform through it is equivalent to the pull-tensor-push operation through the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %mo ∘
                    %msubsup
                      %mi f
                      %mn 1
                      %mo *
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %mo ∘
                    %mrow
                      %mo (
                      %msub
                        %mrow
                          %mo (
                          %msub
                            %mi f
                            %mn 1
                          %mo ,
                          %msub
                            %mi f
                            %mn 2
                          %mo )
                        %mo !
                      %mrow
                        %mo (
                        %msub
                          %mn 1
                          %mi Z
                        %mo )
                      %mo ⊗
                      %mrow
                        %mo (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo )
                      %mo )
                    %mo ∘
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{f_2}{\sum} \circ f_1^\ast
                    \\simeq
                    \\underset{p_2}{\sum}
                    \\circ
                    \\left( \left(f_1,f_2\right)_!\left(1_Z\right) \otimes \left(-\right)\right)
                    \\circ
                    p_1^\ast
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"} Frobenius reciprocity
          %h3#FundamentalClasses Fundamental classes
          #FiberwiseFundamentalClass.num_defn
            %h6#definition_9 Definition
            %p
              A
              %em fiberwise twisted fundamental class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [f]
              on a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a choice of dualizable object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo ∈
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tau \in Mod(Y)
                  (the
                  = succeed ");" do
                    %em twist
              %li
                %p a choice of equivalence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi f
                        %msup
                          %mi f
                          %mo *
                        %msub
                          %mn 1
                          %mi X
                        %mover
                          %mo ⟶
                          %mo ≃
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mi f
                        %msup
                          %mi f
                          %mo *
                        %mi τ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{f}{\sum} f^\ast 1_X
                        \\stackrel{\simeq}{\longrightarrow}
                        \\underset{f}{\prod} f^\ast \tau
                        \\,.
          %p
            In this form this is stated in (
            %a{:href => "#Schreiber14"}> Schreiber 14
            ).
          #FundamentalClassFromAmbidexterity.num_remark
            %h6#remark_6 Remark
            %p
              A special case of def.
              %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
              is obtained when the twist vanishes,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \tau = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi f
                      %mo ≃
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \sum_f \simeq \prod_f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              coincide to form an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous adjunction
              = succeed ")." do
                %a{:href => "#HopkinsLurie"} Hopkins-Lurie
          .num_remark
            %h6#remark_7 Remark
            %p
              In view of dependent linear de Morgan duality, prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DependentLinearDeMorganDuality"}
              %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
              is equivalently a choice of equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mn 1
                      %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %mi 𝔻
                    %mi τ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{f}{\sum} f^\ast 1_X
                    \\stackrel{\simeq}{\longrightarrow}
                    \\mathbb{D}\underset{f}{\sum} f^\ast \mathbb{D}\tau
                    \\,,
            %p hence an identification of the dependent sum of the unit with the dual of the dependent sum of the twist.
          #WirthmullerIsomorphism.num_prop
            %h6#proposition_10 Proposition
            %p
              A twisted fiberwise fundamental class
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [f]
              = succeed "," do
                %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in Mod(X)
              a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %mi 𝔻
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{D} \underset{f}{\sum} f^\ast \mathbb{D}(A\otimes \tau)
                    \\simeq
                    \\underset{f}{\sum}f^\ast A
                    \\,.
          %p
            This is the “
            %a{:href => "Wirthm&#252;ller%20context#ComparisonOfPushForwardsAndWirthmuelleriso"}> Wirthmüller isomorphism
            ”.
          #ComponentOfFiberwiseClass.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [f]
              a twisted fiberwise fundamental class and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              dualizable, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi τ
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi 𝔻
                          %mrow
                            %msub
                              %mi ϵ
                              %mrow
                                %mi 𝔻
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo ⊗
                                %mi τ
                                %mo{:stretchy => "false"} )
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    [f]_A
                    \\;\colon\;
                    A \otimes \tau
                    \\stackrel{\mathbb{D}_{\epsilon_{\mathbb{D}(A \otimes \tau)}}}{\longrightarrow}
                    \\mathbb{D} \underset{f}{\sum} f^\ast (\mathbb{D}(A\otimes \tau))
                    \\stackrel{\simeq}{\longrightarrow}
                    \\underset{f}{\sum}f^\ast A
            %p
              for the composite of the linear dual of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi f
                      %mo ⊣
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\sum_f \dashv f^\ast)
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} adjunction counit
              and the Wirthmüller isomorphism, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#WirthmullerIsomorphism"}
          .num_remark
            %h6#remark_8 Remark
            %p
              The key point is that the morphism in def.
              %a.maruku-ref{:href => "#ComponentOfFiberwiseClass"}
              goes in the reverse direction of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} adjunction counit
              = succeed "." do
                %a{:href => "#SecondaryIntegralTransforms"} below
          %h3#SecondaryIntegralTransforms Secondary integral transforms
          #IntegralKernel.num_defn
            %h6#definition_11 Definition
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Z
                    \\\
                    \&amp; {}^{\mathllap{f_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{f_2}}
                    \\\
                    X_1
                    \&amp;&amp; &amp;&amp;
                    X_2
                    }
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#PolynomialFunctorsAndCorrespondences"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              for it is the choice of
            %ol
              %li
                %p
                  two dualizable objects
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mi i
                          %mo ∈
                          %mi Mod
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi i
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A_i \in Mod(X_i)
              %li
                %p a morphism between their pullbacks to the correspondence space:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi f
                          %mn 1
                          %mo *
                        %msub
                          %mi A
                          %mn 1
                        %mover
                          %mo ⟵
                          %mi K
                        %msubsup
                          %mi f
                          %mn 2
                          %mo *
                        %msub
                          %mi A
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f_1^\ast A_1 \stackrel{K}{\longleftarrow} f_2^\ast A_2
                        \\,.
          #SIT.num_defn
            %h6#definition_12 Definition
            %p Given
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mover
                          %mo ⟵
                          %mrow
                            %msub
                              %mi f
                              %mn 1
                        %mi Z
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mn 2
                        %msub
                          %mi X
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} X_1 \stackrel{f_1}{\longleftarrow} Z \stackrel{f_2}{\longrightarrow} X_2
                  as in def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#PolynomialFunctorsAndCorrespondences"}
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  as in def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#IntegralKernel"}
              %li
                %p
                  a
                  = succeed "-twisted" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi τ
                        %annotation{:encoding => "application/x-tex"} \tau
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi f
                          %mn 2
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [f_2]
                  as in def.
                  %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
            %p
              we say that the induced
              %em secondary integral transform
              is the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Z
                    %mi Ξ
                    %mi d
                    %msub
                      %mi μ
                      %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %msub
                      %mi A
                      %mn 1
                    %mo ⟶
                    %mi 𝔻
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo ⊗
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_Z \Xi d \mu_f
                    \\;\colon\;
                    \\mathbb{D} \underset{X_1}{\sum} A_1
                    \\longrightarrow
                    \\mathbb{D}\underset{X_2}{\sum} (A_2\otimes \tau)
            %p
              which is the dual (the image under
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔻
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}(-)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo ⟵
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %msub
                              %mi X
                              %mn 1
                        %msub
                          %mi ϵ
                          %mrow
                            %msub
                              %mi A
                              %mn 1
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %msubsup
                      %mi f
                      %mn 1
                      %mo *
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo ←
                      %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi Z
                    %msubsup
                      %mi f
                      %mn 1
                      %mo *
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo ⟵
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi Z
                        %mi K
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi Z
                    %msubsup
                      %mi f
                      %mn 2
                      %mo *
                    %msub
                      %mi A
                      %mn 2
                    %mover
                      %mo ←
                      %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msubsup
                      %mi f
                      %mn 2
                      %mo *
                    %msub
                      %mi A
                      %mn 2
                    %mover
                      %mo ⟵
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %msub
                              %mi X
                              %mn 2
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi f
                          %mn 2
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %msub
                              %mi A
                              %mn 2
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo ⊗
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X_1}{\sum} A_1
                    \\stackrel{\underset{X_1}{\sum}\epsilon_{A_1}}{\longleftarrow}
                    \\underset{X_1}{\sum}
                    \\underset{f_1}{\sum}
                    f_1^\ast A_1
                    \\stackrel{\simeq}{\leftarrow}
                    \\underset{Z}{\sum}f_1^\ast A_1
                    \\stackrel{\underset{Z}{\sum} K}{\longleftarrow}
                    \\underset{Z}{\sum}f_2^\ast A_2
                    \\stackrel{\simeq}{\leftarrow}
                    \\underset{X_2}{\sum}\underset{f_2}{\sum} f_2^\ast A_2
                    \\stackrel{\underset{X_2}{\sum}[f_2]_{A_2}}{\longleftarrow}
                    \\underset{X_2}{\sum} (A_2\otimes \tau)
                    \\,,
            %p
              where the morphism on the left is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} adjunction counit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
          %p
            In this form this appears in (
            %a{:href => "#Schreiber14"}> Schreiber 14
            ). Specialized to the ambidextrous case of remark
            = succeed "," do
              %a.maruku-ref{:href => "#FundamentalClassFromAmbidexterity"}
            = succeed ")." do
              %a{:href => "#HopkinsLurie"} Hopkins-Lurie
          .num_remark
            %h6#remark_9 Remark
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟵
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %mi Z
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1 \stackrel{f_1}{\longleftarrow} Z \stackrel{f_2}{\longrightarrow} X_2
              may be thought of as a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              of “paths” or “trajectories” that connect points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_2
              to points in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
              %a.maruku-ref{:href => "#SIT"}
              is a linear map that takes functions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_2
              to functions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              by pointwise forming a sum over paths connecting these points and adding all the contributions of the given
              %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              along these paths.
            %p
              This is conceptually just how the
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              in
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              is supposed to work, only that mostly it doesn’t, due to lack of a proper definition. However, at least some path integrals for
              %a.existingWikiWord{:href => "/nlab/show/topological+field+theories"} topological field theories
              may be realized as secondary integral transforms of the above kind.
            %p
              Notice that while in
              %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
              the (
              %a.existingWikiWord{:href => "/nlab/show/comonad"}> co-
              )
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^\ast \sum_f \dashv f^\ast \prod_f)
              are pronounced as
              %em
                %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
              and
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \prod_f f^\ast
              appearing above, via def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
              = succeed "," do
                %em randomness
              %em
                %a.existingWikiWord{:href => "/nlab/show/function+monad"} function monad
              for more.
          #SigmaFunctorAsSecondaryTransform.num_example
            %h6#example_3 Example
            %p
              Consider the special case def.
              %a.maruku-ref{:href => "#SIT"}
              where the right leg of the correspondence is the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Z
                    \\\
                    \&amp; {}^{\mathllap{f}}\swarrow &amp;&amp; \searrow^{\mathrlap{=}}
                    \\\
                    X &amp;&amp; &amp;&amp; Z
                    }
            %p and where the integral kernel is the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mn 1
                          %mi Z
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi id
                      %mi Z
                      %mo *
                    %msub
                      %mn 1
                      %mi Z
                    %mo =
                    %msub
                      %mn 1
                      %mi Z
                    %mo →
                    %msub
                      %mn 1
                      %mi Z
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mn 1
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K = id_{1_Z} \colon id_Z^\ast 1_Z = 1_Z \to 1_Z = f^\ast 1_X
                    \\,.
            %p
              Then the associated secondary integral transform, def.
              = succeed "," do
                %a.maruku-ref{:href => "#SIT"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %msub
                      %mn 1
                      %mi X
                    %mover
                      %mo ⟵
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %msub
                            %mi ϵ
                            %mi f
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mn 1
                      %mi X
                    %mover
                      %mo ⟵
                      %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi Z
                    %msub
                      %mn 1
                      %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X}{\sum} 1_X
                    \\stackrel{\underset{\epsilon_f}{\sum}}{\longleftarrow}
                    \\underset{X}{\sum} \underset{f}{\sum} f^\ast 1_X
                    \\stackrel{\simeq}{\longleftarrow}
                    \\underset{Z}{\sum} 1_Z
                    \\,.
            %p
              This is just the
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed ":" do
                %a.maruku-ref{:href => "#Sigma"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %msub
                      %mo ∫
                      %mi Z
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %msub
                      %mi μ
                      %mi f
                    %mo =
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{D}\int_Z id \, d\mu_f
                    \=
                    \\Sigma(f)
                    \\;
                    \\colon
                    \\;
                    \\Sigma(Z)
                    \\stackrel{\Sigma(f)}{\longleftarrow}
                    \\Sigma(X)
                    \\,.
          .num_prop
            %h6#proposition_11 Proposition
            %p
              Given a correspondence with integral kernel as in example
              = succeed "," do
                %a.maruku-ref{:href => "#MatrixAsIntegralKernel"}
              %a.maruku-ref{:href => "#SIT"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi X
                          %mn 1
                        %mo{:stretchy => "false"} |
                    %mo ⟵
                    %msup
                      %mi k
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi X
                          %mn 2
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    k^{\vert X_1\vert}
                    \\longleftarrow
                    k^{\vert X_2\vert}
            %p represented by that matrix.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/type+theory"}> type theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+type"} stable homotopy type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type+theory"} geometric homotopy type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
          %h2#References References
          %p
            Plain
            %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            originates in
          %ul#Girard87
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Yves+Girard"}> Jean-Yves Girard
              ,
              = succeed "," do
                %em Linear logic
              = succeed ")" do
                %a{:href => "http://iml.univ-mrs.fr/~girard/linear.pdf"} pdf
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical interpretation
            of Girard’s
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                  %annotation{:encoding => "application/x-tex"} !
            %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            as a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            is due to
          %ul
            %li
              P. N. Benton, G. M. Bierman,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hyland"} Martin Hyland
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Valeria+de+Paiva"} Valeria de Paiva
              = succeed "," do
                %em Term assignment for intuitionistic linear logic
          %p
            and that this is naturally to be thought of as arising from a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+adjunction"} monoidal adjunction
            between the closed
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            and a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            is due to
          %ul
            %li#Bierman95
              %p
                G. Bierman,
                %em On Intuitionistic Linear Logic
                PhD thesis, Computing Laboratory, University of Cambridge, 1995 (
                %a{:href => "http://research.microsoft.com/~gmb/papers/thesis.pdf"}> pdf
                )
            %li#Benton95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nick+Benton"}> Nick Benton
                ,
                = succeed "," do
                  %em A mixed linear and non-linear logic: Proofs, terms and models
                = succeed "," do
                  %em Computer Science Logic. CSL 1994
                %strong 933
                \&amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BFb0022251"}> doi:10.1007/BFb0022251
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/BentonLinearLogic.pdf", :title => "pdf"} pdf
          %p A review of all this and further discussion is in
          %ul
            %li#Barber97
              Andrew Graham Barber,
              = succeed "," do
                %em Linear Type Theories, Semantics and Action Calculi
              = succeed "," do
                %a{:href => "http://www.lfcs.inf.ed.ac.uk/reports/97/ECS-LFCS-97-371/&#8206;"} web
              = succeed ")" do
                %a{:href => "http://www.lfcs.inf.ed.ac.uk/reports/97/ECS-LFCS-97-371/ECS-LFCS-97-371.pdf"} pdf
          %p
            The 1-categorical version of
            %a.existingWikiWord{:href => "/nlab/show/indexed+closed+monoidal+categories"} indexed closed monoidal categories
            is discussed in
          %ul
            %li#Shulman08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                ,
                = succeed "," do
                  %em Framed bicategories and monoidal fibrations
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0706.1286"} arXiv:0706.1286
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/20/18/20-18abs.html"} TAC
            %li#PontoShulman12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"}> Kate Ponto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
                = succeed "," do
                  %em Duality and traces for indexed monoidal categories
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1211.1555"} arXiv:1211.1555
            %li#Shulman12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                ,
                %em Enriched indexed categories
                (
                %a{:href => "http://arxiv.org/abs/1212.3914"}> arXiv:1212.3914
                )
          %p
            Comments on the formalization of secondary
            %a.existingWikiWord{:href => "/nlab/show/integral+transforms"} integral transforms
            and
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            in an indexed monoidal
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#Schreiber14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Quantization+via+Linear+homotopy+types"} Quantization via Linear homotopy types
                (
                %a{:href => "http://arxiv.org/abs/1402.7041"}> arXiv:1402.7041
                )
            %li#HopkinsLurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"}> Michael Hopkins
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Ambidexterity+in+K%28n%29-Local+Stable+Homotopy+Theory"} Ambidexterity in K(n)-Local Stable Homotopy Theory
