          .query
            %p
              Although probably those examples should be moved to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/indexed+monoidal+category"} indexed monoidal category
          %h3#slices_of_a_topos Slices of a topos
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi op
                    %mo →
                    %mi CartMonCat
                    %mo →
                    %mi MonCat
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/(-)} \colon \mathbf{H}^{op} \to CartMonCat \to MonCat
              of
              %a.existingWikiWord{:href => "/nlab/show/slice+toposes"} slice toposes
              is an indexed monoidal category, hence an indexed monoidal
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          .num_remark
            %h6#remark Remark
            %p
              This example for dependent linear type theory is extremely “non-linear”. For instance, it has almost no
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/dualizable+objects"} dualizable objects
              = succeed ")" do
                %a.maruku-ref{:href => "#SIT"}
          %p We now pass gradually to more and more linear examples.
          %h3#PointedObjects Parameterized pointed objects
          %p A first step away from the Cartesian example above towards more genuinely linear types is the following.
          #PointedObjectsInSlice.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi X
                    %mo ≔
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_X \coloneqq \mathbf{H}_{/X}^{X/}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∧
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \wedge_X
              this is a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mi X
                      %mo ,
                      %msub
                        %mo ∧
                        %mi X
                      %mo ,
                      %mi X
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}_X, \wedge_X, X \coprod X)
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              any
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              restricts to a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mi Y
                    %mo ⟶
                    %msub
                      %mi 𝒞
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^\ast \colon \mathcal{C}_Y \longrightarrow \mathcal{C}_X
              and this makes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi op
                    %mo ⟶
                    %mi MonCat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{/(-)}^{(-)/}
                    \\;\colon\;
                    \\mathbf{H}^{op}
                    \\longrightarrow
                    MonCat
            %p an indexed monoidal category.
          %p
            This appears as (
            %a{:href => "#Shulman08"}> Shulman 08, examples 12.13 and 13.7
            ) and (
            %a{:href => "#Shulman12"}> Shulman 12, example 2.33
            ).
          .proof
            %h6#proof Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              any
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              then the
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mo ⟶
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} f^\ast \colon \mathbf{H}_{/Y} \longrightarrow \mathbf{H}_{/X}
              preserves pointedness, and the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} f_! \colon \mathbf{H}^{X/} \longrightarrow \mathbf{H}^{Y/}
              preserves co-pointedness. These two functors hence form an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mo !
                      %mo ⊣
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi 𝒞
                        %mi X
                      %mo ⟶
                      %msub
                        %mi 𝒞
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} (f_! \dashv f^\ast) \colon \mathcal{C}_X \longrightarrow \mathcal{C}_Y
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in the under-over category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}^{X/}
              are computed as colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              with an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              adjoined, and since by the
              %a.existingWikiWord{:href => "/nlab/show/Giraud+axioms"} Giraud axioms
              in the
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              preserves these colimits, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mi Y
                    %mo →
                    %msub
                      %mi 𝒞
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^\ast \colon \mathcal{C}_Y \to \mathcal{C}_X
              preserves colimits. Finally by the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_Y
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              has also a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi 𝒞
                        %mi X
                      %mo →
                      %msub
                        %mi 𝒞
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} f_\ast \colon \mathcal{C}_X \to \mathcal{C}_Y
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              observe that the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              is, by the discussion there, given by a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              over
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              and
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is also a
              %a.existingWikiWord{:href => "/nlab/show/strong+closed+functor"} strong closed functor
              observe that the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              on
              %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              is, by the discussion there, a
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of cartesian internal homs. These are preserved by the above case, and the fiber product is preserved since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              preserves all limits. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              preserves also the internal homs of pointed objects.
          %h3#ParameterizedModules Parameterized modules
          %p
            The examples of genuinely linear objects in the sense of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            are the following.
          #IndexedMonoidalCategoryOfModuleBundles.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} E Mod
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X\in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi Mod
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mo ×
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi X
                            %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    E Mod(X) \coloneqq Func(X, E Mod) \simeq (E Mod)^{\times_{\vert X \vert}}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (regarded as a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} E Mod
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over the
              %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              this is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msup
                        %mi Mod
                        %mo ⊗
                    %annotation{:encoding => "application/x-tex"} E Mod^{\otimes}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Set
                      %mi op
                    %mo ⟶
                    %mi SymMonCat
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E Mod \;\colon\; Set^{op} \longrightarrow SymMonCat
                    \\,.
            %p which is an indexed monoidal category.
          #MatrixAsIntegralKernel.num_example
            %h6#example_2 Example
            %p
              In the context of prop.
              %a.maruku-ref{:href => "#IndexedMonoidalCategoryOfModuleBundles"}
              consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} E = k
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mi Mod
                    %mo ≃
                    %msub
                      %mi Vect
                      %mi k
                  %annotation{:encoding => "application/x-tex"} k Mod \simeq Vect_k
              is the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X \in Set
              a set, an
              = succeed "-dependent" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mod(X)\simeq Vect_k(X)
              is just a collection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert X\vert}
              vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} A_x
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi FinSet
                    %mo ↪
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X \in FinSet \hookrightarrow Set
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              and
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              operations coincide and produce the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of vector spaces:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi A
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi X
                    %mi A
                    %mo ≃
                    %munder
                      %mo ⊕
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %msub
                      %mi A
                      %mi x
                    %mo ∈
                    %msub
                      %mi Vect
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X}{\sum} A \simeq \underset{X}{\prod} A \simeq
                    \\underset{x\in X}{\oplus} A_x
                    \\in Vect_k(\ast)
                    \\,.
            %p
              Under this identification every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Mor(Set)
              with finite fibers carries a canonical untwisted fiberwise fundamental class, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiberwiseFundamentalClass"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi canonical
                    %annotation{:encoding => "application/x-tex"} [f]_{canonical}
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X_1 \times X_2
                    \\\
                    \&amp; {}^{\mathllap{p_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{p_2}}
                    \\\
                    X_1 &amp;&amp; &amp;&amp; X_2
                    }
            %p
              a product corrrespondence of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
              %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              on this, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#IntegralKernel"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi i
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi X
                            %mi i
                    %annotation{:encoding => "application/x-tex"} A_i = 1_{X_i}
              = succeed "-array" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi X
                          %mn 1
                        %mo{:stretchy => "false"} |
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi X
                          %mn 2
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert X_1\vert}\times {\vert X_2\vert}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mrow
                          %mo •
                          %mo ,
                          %mo •
                    %annotation{:encoding => "application/x-tex"} K_{\bullet,\bullet}
          %h3#ParameterizedModuleSpectra Parametrized module spectra
          %p
            The example of parameterized modules
            %a{:href => "#ParameterizedModules"} above
            has an evident generalization from
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            to
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            with
            %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian
            %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
            refined to
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories+of+%E2%88%9E-modules"} (∞,1)-categories of ∞-modules
            = succeed "-terminology" do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
                %th
                  %a.existingWikiWord{:href => "/nlab/show/brave+new+algebra"} brave new algebra
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞
                  %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
                  spectrum
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian
                  %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%E2%88%9E-modules"} (∞,1)-category of ∞-modules
          #ParameterizedModuleSpectraAreAnIndexedMonoidalCategory.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              spectrum and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} E Mod
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%E2%88%9E-modules"} (∞,1)-category of ∞-modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E Mod(X) \coloneqq Func(X,E Mod)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (regarded as an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} E Mod
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              structure. Equipped with the
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              this is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msup
                      %mi Mod
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} E Mod^\otimes
              This construction yields an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi Mod
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mi op
                    %mo ⟶
                    %msub
                      %mi SymMonCat
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    E Mod \;\colon\; \infty Grpd^{op} \longrightarrow SymMonCat_\infty
            %p
              This is an indexed monoidal
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            (
            %a{:href => "#HopkinsLurie"}> Hopkins-Lurie
            ,
            = succeed ")" do
              %a{:href => "#Schreiber14"} Schreiber 14
          .num_remark
            %h6#remark_2 Remark
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} E = \mathbb{S}
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mi Mod
                    %mo ≃
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}Mod \simeq Spectra
              is just the plain
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+spectra"} (∞,1)-category of spectra
              and then the above is the theory of plain
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
            %p
              In this case the corresponding
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              is the
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-topos"} tangent (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(\infty Grpd)
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %em ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
              remains to be explored.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              = succeed "-functor," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed "," do
                %a.maruku-ref{:href => "#Sigma"}
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.maruku-ref{:href => "#ParameterizedModuleSpectraAreAnIndexedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty
              followed by
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of spectra with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(X) \simeq \Sigma^\infty(X)\wedge E
                    \\,.
            %p
              This is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "-spectrum" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              This construction does have a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \Omega^\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
