                          %msup
                            %mi N
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} 1/N^2
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1801.02696"} arXiv:1801.02696
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Micha+Berkooz"}> Micha Berkooz
                , Prithvi Narayan,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joan+Sim%C3%B3n"} Joan Simón
                = succeed "," do
