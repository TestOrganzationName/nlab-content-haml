            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weight+systems+on+chord+diagrams+in+physics"} weight systems on chord diagrams in physics
          %h4#for_jtgravitysyk_model For JT-gravity/SYK model
          %p
            Discussion of (
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"}> Lie algebra
            \-)
            %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
            on
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            encoding
            %a.existingWikiWord{:href => "/nlab/show/SYK+model"} SYK model
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/single+trace+observables"} single trace observables
          %ul
            %li
              %p
                Antonio M. García-García, Yiyang Jia, Jacobus J. M. Verbaarschot,
                = succeed "," do
                  %em
                    Exact moments of the Sachdev-Ye-Kitaev model up to order
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
