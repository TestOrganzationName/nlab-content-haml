          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/statistical+physics"} statistical physics
            %em single trace operator
            is an
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            %a.existingWikiWord{:href => "/nlab/show/correlator"} correlator
            on
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+representation"} adjoint representation
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/scalar+fields"} scalar fields
            %a.existingWikiWord{:href => "/nlab/show/random+variables"} random variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi ϕ
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{\phi_i\}_{i \in I}
            (notationally subsuming
            %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
            of fields) which is built from the elementary
            %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \mathbf{\Phi}_i
            as a
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            over the
            %a.existingWikiWord{:href => "/nlab/show/matrix+product"} matrix product
            of a finite string of them:
          #eq:ASingleTraceObservable.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %msub
                        %mi i
                        %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi Tr
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ⋅
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 2
                  %mo ⋅
                  %mi ⋯
                  %mo ⋅
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}_{i_1, \cdots i_n}
                  \\;=\;
                  Tr\big(
                  \\mathbf{\Phi}_{i_1}
                  \\cdot
                  \\mathbf{\Phi}_{i_2}
                  \\cdot
                  \\cdots
                  \\cdot
                  \\mathbf{\Phi}_{i_n}
                  \\big)
          %p
            or more generally as
            %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
            thereof.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \phi_i
            indeed take values in the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+representation"} adjoint representation
            of a given
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            in the expression
            %a.maruku-eqref{:href => "#eq:ASingleTraceObservable"} (1)
            ensures that this
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariant"} gauge invariant
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariant"} gauge invariant
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            are hence
            %em
              %a.existingWikiWord{:href => "/nlab/show/multi-trace+operators"} multi-trace operators
            which are
            %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
            of products of single-trace observables (i.e.
            %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            of single-trace observables).
          %h2#properties Properties
          %h3#CorrespondenceToStringsUnderAdSCFT Correspondence to strings under AdS/CFT
          %p
            Single trace operators/observables in
            %a.existingWikiWord{:href => "/nlab/show/conformal+field+theories"} conformal field theories
            such as
            %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theories"} super Yang-Mills theories
            play a special role in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} AdS-CFT correspondence
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            excitations on the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/AdS+spacetime"} AdS
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            side of the correspondence, where, curiously, the “string of characters/letters” in the argument of the trace gets literally mapped to a
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            in
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            (see the references
            = succeed ")." do
              %a{:href => "#ReferencesRelationToStringExcitations"} below
          %p
            From
            = succeed "," do
              %a{:href => "#Polyakov02"} Polyakov 02
            %em letter
            and
            = succeed "," do
              %em words
          %blockquote
            %p The picture which slowly arises from the above considerations is that of the space-time gradually disappearing in the regions of large curvature. The natural description in this case is provided by a gauge theory in which the basic objects are the texts formed from the gauge-invariant words. The theory provides us with the expectation values assigned to the various texts, words and sentences.
          %blockquote
            %p These expectation values can be calculated either from the gauge theory or from the strongly coupled 2d sigma model. The coupling in this model is proportional to the target space curvature. This target space can be interpreted as a usual continuous space-time only when the curvature is small. As we increase the coupling, this interpretation becomes more and more fuzzy and finally completely meaningless.
          %p
            From
            = succeed "," do
              %a{:href => "#BerensteinMaldacenaNastase02"} Berenstein-Maldacena-Nastase 02
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            for the elementary
            %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
            (“letters”)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Φ
                %annotation{:encoding => "application/x-tex"} \mathbf{\Phi}
            above:
          %blockquote
            %p
              In summary, the “string of
              = succeed "s\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              carries one unit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              which is one unit of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo +
                    %annotation{:encoding => "application/x-tex"} p_+
              %a.existingWikiWord{:href => "/nlab/show/string+bit+model"} string bit model
              where each bit is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              operator.
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/CFT"} CFT
            side these
            %em
              %a.existingWikiWord{:href => "/nlab/show/BMN+operators"} BMN operators
            of fixed length (of “letters”) are usefully identified as
            %a.existingWikiWord{:href => "/nlab/show/spin+chains"} spin chains
            which, with the
            %a.existingWikiWord{:href => "/nlab/show/dilatation+operator"} dilatation operator
            regarded as their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            %a.existingWikiWord{:href => "/nlab/show/integrable+systems"} integrable systems
            (
            %a{:href => "#MinahanZarembo02"}> Minahan-Zarembo 02
            ,
            = succeed ")." do
              %a{:href => "#BeisertStaudacher03"} Beisert-Staudacher 03
          %p This integrability allows a detailed matching between
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/single+trace+operators"}> single trace operators
                \/
                %a.existingWikiWord{:href => "/nlab/show/BMN+operators"} BMN operators
                in
                %a.existingWikiWord{:href => "/nlab/show/D%3D4+N%3D4+super+Yang-Mills+theory"} D=4 N=4 super Yang-Mills theory
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical
                %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
                on
                %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} AdS5
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ×
                    %annotation{:encoding => "application/x-tex"} \times
                %a.existingWikiWord{:href => "/nlab/show/5-sphere"} S5
          %p
            under
            %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT+duality"} AdS/CFT duality
            (
            %a{:href => "#BeisertFrolovStaudacherTseytlin03"}> Beisert-Frolov-Staudacher-Tseytlin 03
            , …). For review see
            = succeed "," do
              %a{:href => "#BBGK04"} BBGK 04
            = succeed "." do
              %a{:href => "#BeisertEtAl10"} Beisert et al. 10
          %p (…)
          %h3#relation_to_weight_systems_on_chord_diagrams Relation to weight systems on chord diagrams
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
