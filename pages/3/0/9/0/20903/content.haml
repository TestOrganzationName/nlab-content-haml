                  %mi C
                  %mo ∈
                  %mi 𝔤
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} C \in \mathfrak{g}Mod
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebra"} metric Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi ϕ
