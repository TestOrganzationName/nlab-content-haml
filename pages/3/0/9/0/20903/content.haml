                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\phi_a\}
            a
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ϕ
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\phi^a\}
            denoting the dual basis, those single trace operators involving only metric pairs of fields, such as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Tr
                    %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ⋅
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo ⋅
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ⋅
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mrow
                      %msub
                        %mi a
                        %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}
                  \\;\coloneqq\;
                  Tr_C
                  \\big(
                  \\mathbf{\Phi}_{a_1}
                  \\cdot
                  \\mathbf{\Phi}_{a_2}
                  \\cdot
                  \\mathbf{\Phi}^{a_1}
                  \\cdot
                  \\mathbf{\Phi}^{a_2}
                  \\big)
          %p
            (using
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on the
            %a.existingWikiWord{:href => "/nlab/show/chord+diagram"} chord diagram
            that expresses the index pairing.
          %p
            Such binary pairings inside the trace are induced notably after statistical averaging in the
            %a.existingWikiWord{:href => "/nlab/show/SYK+model"} SYK model
            and related systems, and has been argued to appear generically for
            %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT"} dual
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            of
            %a.existingWikiWord{:href => "/nlab/show/black+hole+thermodynamics"} black hole thermodynamics
            (
            %a{:href => "#BerkoozNarayanSimon18"}> Berkooz-Narayan-Simón 18, Section 2.1
            ).
          %p
            For more on this see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weight+systems+on+chord+diagrams+in+physics"} weight systems on chord diagrams in physics
          %h2#examples Examples
          %h3#SingleTraceObservablesAsWeightSystemsOnChordDiagrams
            Shape of D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            \-fuzzy funnels
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/WeightSystemsAsShapeObservabesOnFuzzySphere.jpg", :width => "400"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observables"} single trace observables
            on the
            = succeed "-sections" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B2%29+brane+intersection"} Dp-D(p+2) brane intersection
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnels"} fuzzy funnels
            are given by
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            (following
            = succeed "," do
              %a{:href => "#RamgoolamSpenceThomas04"} Ramgoolam-Spence-Thomas 04
            = succeed "," do
              %a{:href => "#McNamaraPapageorgakis05"} McNamara-Papageorgakis 05
            %a{:href => "#McNamara06"} McNamara 06, Section 4
            for review).
          %p
            %br/
          %p
            While in the commutative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            function on the
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            are equal
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi N
                      %mo →
                      %mn ∞
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %msup
                    %mi R
                    %mrow
                      %mn 2
                      %mi k
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 4
                  %mi π
                  %mspace{:width => "thinmathspace"}
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\underset{N\to \infty}{\lim}
                  \\int_{S^2_N} R^{2 k}
                  \\;=\;
                  4 \pi
                  \\,;
          %p
            for
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            there is an ordering ambiguity: In fact, the number of functions on the
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            at
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            that all go to the same function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} R^{2k}
            in the
            %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            grows rapidly with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            At
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = 1
            there is the single radius observable
            %a.maruku-eqref{:href => "#eq:RadiusOfFuzzy2Sphere"} (?)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %msup
                    %mi R
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi X
                    %mi i
                  %mo ⋅
                  %msub
                    %mi X
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 4
                  %mi π
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi N
                      %msqrt
                        %mrow
                          %msup
                            %mi N
                            %mn 2
                          %mo −
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\int_{S^2_N} R^2
                  \\;=\;
                  \\int_{S^2_N}
                  \\underset{i}{\sum} X_i \cdot X_i
                  \\;=\;
                  4 \pi \tfrac{ N }{ \sqrt{N^2 -1} }
          %p
            At
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k = 2
            there are, under the integral
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:FuzzyS2Integration"} (?)
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msubsup
                            %mi S
                            %mi N
                            %mn 2
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \int_{S^2_N} \underset{i,j}{\sum} X_i X_i X_j X_j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msubsup
                            %mi S
                            %mi N
                            %mn 2
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \int_{S^2_N} \underset{i,j}{\sum} X_i X_j X_j X_i
          %p
            (Here we are using that under the integral/trace, a
            %a.existingWikiWord{:href => "/nlab/show/cyclic+permutation"} cyclic permutation
            of the factors in the integrand does not change the result).
          %p
            Similarly for higher
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            that appears here is familiar in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/knot+theory"} knot theory
          %p
            Every ordering of operators, up to cyclic permutation, in the
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observable"} single trace observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tr
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi R
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} Tr(R^2)^n
            is encoded in a
            %a.existingWikiWord{:href => "/nlab/show/chord+diagram"} chord diagram
            and the value of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observable"} single trace observable
            is the value of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} Lie algebra weight system
            on this chord diagram.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/string+bit+model"} string bit model
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/multi-trace+operator"} multi-trace operator
          %h2#references References
          %h3#general General
          %p (…)
          %h3#ReferencesRelationToStringExcitations Correspondence to string excitations under AdS/CFT
          %p
            The correspondence of single trace operators to
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            excitations under the
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} AdS-CFT correspondence
            originates with these articles:
          %ul
            %li#Polyakov02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Polyakov"}> Alexander Polyakov
                ,
                = succeed "," do
                  %em Gauge Fields and Space-Time
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0110196"} arXiv:hep-th/0110196
            %li#BerensteinMaldacenaNastase02
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Berenstein"}> David Berenstein
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
                = succeed "," do
