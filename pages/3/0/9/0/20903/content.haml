                = succeed "," do
                  %em Review of AdS/CFT Integrability: An Overview
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1012.3982"} arXiv:1012.3982
          %h3#relation_to_weight_systems_on_chord_diagrams_2 Relation to weight systems on chord diagrams
          %p
            A general relation between
            %a.existingWikiWord{:href => "/nlab/show/single+trace+operators"} single trace operators
            for
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            on
            %a.existingWikiWord{:href => "/nlab/show/black+hole+thermodynamics"} black hole thermodynamics
            and
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on
