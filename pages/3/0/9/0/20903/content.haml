                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Staudacher"} Matthias Staudacher
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alessandro+Torrielli"} Alessandro Torrielli
                = succeed "," do
