          %title
          %p
            Michael Barr is the Peter Redpath Emeritus Professor of Pure Mathematics at McGill University. Although his earlier work was in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %p
            He is on the editorial boards of Mathematical Structures in Computer Science and the electronic journal
            = succeed "," do
              %em Homology, Homotopy and Applications
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Jon+Beck"} Jon Beck
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            %a.existingWikiWord{:href => "/nlab/show/monadicity+theorem"} monadicity
            criteria and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
          %ul
            %li
              %a{:href => "http://en.wikipedia.org/wiki/Michael_Barr_%28mathematician%29"} Wikipedia entry
          %h2#selected_writings Selected writings
          %p See also:
          %ul
            %li
              personal list of publications:
              %a{:href => "https://www.math.mcgill.ca/barr/"} web page
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %em Cohomology of commutative algebra I
              = succeed "," do
                %a{:href => "https://www.math.mcgill.ca/barr/papers/thes.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Barr-CohomologyThesis.pdf", :title => "pdf"} pdf
          %p see also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em A cohomology theory for commutative algebra I
                %strong 16
                (1965) 1379–1384 &amp;lbrack;
                %a{:href => "https://www.ams.org/journals/proc/1965-016-06/S0002-9939-1965-0193119-3"}> doi:1965-016-06/S0002-9939-1965-0193119-3
                ,
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/comcoh1.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-CohomologyCommutativeI.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em A cohomology theory for commutative algebra II
                %strong 16
                (1965) 1385–1391 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/2035937"}> jstor:2035937
                ,
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/comcoh2.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-CohomologyCommutativeII.pdf", :title => "pdf"} pdf
          %p
            and in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em Cohomology in tensored categories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-642-99902-4_17"} doi:10.1007/978-3-642-99902-4_17
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/ctc.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-CohomologyTensored.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em Shukla cohomology and triples
                %strong 5
                2 (1967) 222–231 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0021-8693(67)90036-1"}> doi:10.1016/0021-8693(67)90036-1
                ,
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/shukla.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-ShuklaCohomology.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                %em Harrison homology, Hochschild homology and triples
                J. Algebra
                %strong 8
                3 (1968) 314–323 &amp;lbrack;
                %a{:hrf => "https://doi.org/10.1016/0021-8693(68)90062-8"}> doi:10.1016/0021-8693(68)90062-8
                ,
                = succeed "," do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/harr-hoch.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Barr-HarrHochAndTriples.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %em Cohomology and obstructions: commutative algebras
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Seminar+on+Triples+and+Categorical+Homology+Theory"} Seminar on Triples and Categorical Homology Theory
                = succeed "," do
                  %strong 80
                %strong 18
                (2008) 357–374 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18abs.html"}> TAC:18
                ,
                = succeed "," do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.mcgill.ca/barr/papers/obstruct.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            in
            %a.existingWikiWord{:href => "/nlab/show/universal+algebra"} universal algebra
            and (
            %a.existingWikiWord{:href => "/nlab/show/cohomology"}> co-
            )
            %a.existingWikiWord{:href => "/nlab/show/homology"}> homology
            \-theory:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/H.+Applegate"}> H. Applegate
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/M.+Barr"} M. Barr
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J.+Beck"} J. Beck
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/F.+W.+Lawvere"} F. W. Lawvere
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/F.+E.+J.+Linton"} F. E. J. Linton
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E.+Manes"} E. Manes
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/M.+Tierney"} M. Tierney
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/F.+Ulmer"} F. Ulmer
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Seminar+on+Triples+and+Categorical+Homology+Theory"} Seminar on Triples and Categorical Homology Theory
              %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"} Beno Eckmann
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/LNM+80"} LNM 80
              %strong 18
              (2008) 1-303 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18abs.html"}> TAC:18
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebraic
            %a.existingWikiWord{:href => "/nlab/show/structures"} structures
            (such as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            (“triples”, cf.
            %em
              %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
            and
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/canonical+resolution"} canonical resolution
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jon+Beck"} Jon Beck
                = succeed "," do
                  %em Homology and Standard Constructions
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Seminar+on+Triples+and+Categorical+Homology+Theory"} Seminar on Triples and Categorical Homology Theory
                = succeed "," do
                  %strong 80
                %strong 18
                (2008) 186-248 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18abs.html"}> TAC:18
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18.pdf"} pdf
            %li
