          %p
            A
            = succeed "," do
              %strong dg-algebra
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
          %ol
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                which is in addition
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
                and a
                %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
                in a compatible way (with the
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                being of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                    %annotation{:encoding => "application/x-tex"} \pm
                1);
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                in the
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                of (possibly unbounded)
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
                or
                = succeed "es" do
                  %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                by the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
          %p
            For the case of chain complexes we also speak of
            = succeed "." do
              %strong chain algebras
          %p
            For the case of cochain complexes we also speak of
            = succeed "." do
              %strong cochain algebras
          %p Recall
          %ul
            %li
              %p that the standard tensor product on (co)chain complexes is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo +
                          %mi j
                          %mo =
                          %mi n
                      %msub
                        %mi A
                        %mi i
                      %mo ⊗
                      %msub
                        %mi B
                        %mi j
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (A\otimes B)_n = \sum_{i+j=n} A_i\otimes B_j,
              %p
                with the differential
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi A
                            %mo ⊗
                            %mi B
                        %mo =
                        %msub
                          %mi d
                          %mi A
                        %mo ⊗
                        %mi B
                        %mo +
                        %mi A
                        %mo ⊗
                        %msub
                          %mi d
                          %mi B
                      %annotation{:encoding => "application/x-tex"} d_{A\otimes B} = d_A\otimes B + A\otimes d_B
            %li
              %p
                that a
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                in a
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is an object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                together with a morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋅
                      %mo :
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      \\cdot : A \otimes A \to A
              %p that is unital and associative in the obvious sense.
          %p
            This implies that a dg-algebra is, more concretely, a graded algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            equipped with a linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} d : A \to A
            with the property that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∘
                      %mi d
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d\circ d = 0
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
                homogeneous of degree
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi a
                    %annotation{:encoding => "application/x-tex"} d a
                is of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k+1
                (for monoids in cochain complexes) or of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k-1
                (for monoids in chain complexes)
            %li
              %p
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a,b \in A
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                homogeneous of degree k the
                %strong graded Leibniz rule
                holds
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ⋅
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi b
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mi a
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d (a \cdot b) = (d a) \cdot b + (-1)^k a \cdot (d b)
                \.
          %p
            The dg-algebras form a category,
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
          %h3#detailed_component_definition Detailed component definition
          %h4#pregraded_algebras Pre-graded algebras
          %p
            A
            %em
              pre-graded algebra- (pre-ga) or
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is a pre-gvs,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi p
                  %mo .
                  %msub
                    %mi A
                    %mi q
                  %mo ⊆
                  %msub
                    %mi A
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                %annotation{:encoding => "application/x-tex"} A_p.A_q \subseteq A_{p+q}
            for any
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p,q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pre
                    %mi GA
                  %annotation{:encoding => "application/x-tex"} pre GA
          %p
            An
            %em augmentation
            of a pre-ga,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo :
                    %mi A
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \varepsilon : A \to k
            %em augmentation ideal
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\varepsilon)
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mi ε
                %annotation{:encoding => "application/x-tex"} ker \varepsilon
            and will also be denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\varepsilon)
            is called an
            = succeed "." do
              %em augmented pre-ga
          %p
            A morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi ε
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(A,\varepsilon)\to (A',\varepsilon')
            of augmented pre-gas is a homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f : A \to A'
            (thus of degree zero) such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo =
                    %mi ε
                    %mo ′
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \varepsilon = \varepsilon ' f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pre
                    %mi ε
                    %mi GA
                  %annotation{:encoding => "application/x-tex"} pre \varepsilon GA
          %h4#tensor_product Tensor product
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            are two pre-gas, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A\otimes A'
            is a pre-ga with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi a
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ⊗
                  %mi b
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi a
                          %mo ′
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} |
                      %mi b
                      %mo{:stretchy => "false"} |
                  %mi a
                  %mi b
                  %mo ⊗
                  %mi a
                  %mo ′
                  %mi b
                  %mo ′
                %annotation{:encoding => "application/x-tex"} (a\otimes a')(b\otimes b') = (-1)^{|{a^'} | |b|} a b \otimes a' b'
          %p
            for homogeneous
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b \in A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ′
                    %mo ,
                    %mi b
                    %mo ′
                    %mo ∈
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} a', b' \in A'
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo ,
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon, \varepsilon
            are augmentations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            respectively, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo ⊗
                  %mi ε
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \varepsilon\otimes \varepsilon'
            is an augmentation of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A\otimes A'
          %h4#derivations Derivations
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a pre-ga. An
            %em (algebra) derivation
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} p\in \mathbb{Z}
            is a linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo ∈
                  %msub
                    %mi Hom
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta \in Hom_p(A,A)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi ab
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mi b
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                  %mi a
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta(ab) = \theta(a)b + (-1)^{p|a|}a\theta(b)
          %p
            for homogeneous
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b \in A
          %p
            A derivation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            of an augmented algebra,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi ε
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, \varepsilon)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mi θ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \varepsilon \theta = 0
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Der
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Der_p(A)
            be the vector space of derivations of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mi p
                  %msub
                    %mi Der
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Der(A) = \bigoplus_p Der_p(A)
            is a pre-gvs.
          %h4#nb N.B.
          %p
            In the case of upper gradings, an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Der
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Der_p(A)
            sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A^n
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo −
                        %mi p
                  %annotation{:encoding => "application/x-tex"} A^{n-p}
          %h4#predgas Pre-DGAs
          %p
            A
            %em differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            on an (augmented) pre-ga is a derivation of the (augmented) algebra of degree -1 such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo ∘
                    %mo ∂
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial\circ\partial = 0
          %p
            The pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\partial)
            is called a
            %em pre-differential graded algebra
            (pre-dga). If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is augmented, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\partial)
            will be called an
            %em augmented pre-dga
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pre
                    %mi ε
                    %mi dga
                  %annotation{:encoding => "application/x-tex"} pre \varepsilon dga
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\partial)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mo ∂
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A',\partial')
            are pre-dgas, then
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mo ∂
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\partial)\otimes (A',\partial')
          %p
            A morphism of pre-dgas (or pre-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            \-dgas) is a morphism which is both of pre-gdvs and of pre-gas (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            as well if used). This gives categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pre
                  %mi DGA
                %annotation{:encoding => "application/x-tex"} pre DGA
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pre
                    %mi ε
                    %mi DGA
                  %annotation{:encoding => "application/x-tex"} pre \varepsilon DGA
          %h4#commutative_graded_algebras_cga Commutative graded algebras (CGA)
          %p
            A pre-ga
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is said to be
            %em
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebra"} graded commutative
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ab
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} |
                      %mi b
                      %mo{:stretchy => "false"} |
                  %mi ba
                %annotation{:encoding => "application/x-tex"} ab = (-1)^{|a||b|}ba
            for each pair,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a, b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of homogeneous degree.
          %p Commutativity is preserved by tensor product.
          %p
            We get obvious full subcategories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pre
                  %mi CDGA
                %annotation{:encoding => "application/x-tex"} pre CDGA
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pre
                  %mi ε
                  %mi CDGA
                %annotation{:encoding => "application/x-tex"} pre \varepsilon CDGA
            corresponding to the case with differentials.
          %h4#cdgas CDGAs
          %p
            A cdga is a
            %strong negatively
            graded pre-cdga (in upper grading),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi p
                      %mo ≥
                      %mn 0
                  %msup
                    %mi A
                    %mi p
                  %mo .
                %annotation{:encoding => "application/x-tex"} A= \bigoplus_{p\geq 0} A^p.
          %p
            There is an augmented variant, of course. These definitions give categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CDGA
                  %annotation{:encoding => "application/x-tex"} CDGA
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
          %h4#connectivity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-connectivity
          %p
            An
            = succeed "cdga" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,d)
            is
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-connected
            (resp.
            %em
              cohomologically
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mi p
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \bar{A}^p = 0
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} p\leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi p
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \overline{H(A,d)}^p = 0
            for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} p\leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CDGA
                    %mi n
                %annotation{:encoding => "application/x-tex"} CDGA^n
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CDGA
                      %mrow
                        %mi c
                        %mi n
                  %annotation{:encoding => "application/x-tex"} CDGA^{c n}
          %h4#filtrations Filtrations
          %p
            A filtration on a pre-ga,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %mi A
                    %mo ⊆
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"} F_p A \subseteq F_{p+1}A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                  %mi A
                  %mo .
                  %msub
                    %mi F
                    %mi n
                  %mi A
                  %mo ⊆
                  %msub
                    %mi F
                    %mrow
                      %mi p
                      %mo +
                      %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"} F_p A.F_n A \subseteq F_{p+n}A
            (and, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is differential, also
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi F
                      %mi p
                    %mi A
                    %mo ⊆
                    %msub
                      %mi F
                      %mi p
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \partial F_p A \subseteq F_p A
          %h5#example_word_length_filtration Example: Word length filtration.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an augmented pre-ga and denote by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ¯
                    %mi p
                  %mo :
                  %msup
                    %mo ⨂
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \bar{\mu}^p : \bigotimes^{p+1}\bar{A} \to \bar{A},
          %p
            the iterated multiplication. The
            = succeed "," do
              %strong decreasing word length filtration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi p
                  %mi A
                %annotation{:encoding => "application/x-tex"} F^p A
            is given by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mn 0
                  %mi A
                  %mo =
                  %mi A
                  %mo ,
                  %mspace{:width => "1em"}
                  %msup
                    %mi F
                    %mi p
                  %mi A
                  %mo =
                  %mi Im
                  %msup
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ¯
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi if
                  %mi p
                  %mo ≥
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} F^0 A = A, \quad F^p A = Im\bar{\mu}^{(p-1)}  if p\geq 1.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} /
                  %mi Im
                  %mover
                    %mi μ
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} Q(A) = \bar{A}/Im\bar{\mu}
            is the
            %em space of indecomposables
            of A.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\partial)
            is an augmented pre-dga,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi p
                  %mi A
                %annotation{:encoding => "application/x-tex"} F^p A
            is stable under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            and we get
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(\partial)
            is a differential on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(A)
            and hence we get a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mi pre
                  %mi ε
                  %mi DGA
                  %mo →
                  %mi pre
                  %mi DGVS
                  %mo .
                %annotation{:encoding => "application/x-tex"} Q: pre \varepsilon DGA\to pre DGVS.
          %h4#free_gas__the_tensor_algebra
            Free GAs:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(V)
          %p
            Given a pre-gvs,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⨂
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 0
                    %msup
                      %mi V
                      %mrow
                        %mo ⊗
                        %mi n
                  %annotation{:encoding => "application/x-tex"} T(V) = \bigotimes_{n\geq 0}V^{\otimes n}
          %p
            The augmentation sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to 0.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo ⊗
                      %mi n
                %annotation{:encoding => "application/x-tex"} V^{\otimes n}
            is given the tensor product grading, and the multiplication is given by the tensor product.
          .lemma
            %h6#lemma_classical_freeness_of___is_a_left_adjoint
              Lemma (classical: freeness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a left adjoint)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a pre-ga and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi V
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f: V\to A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \hat{f} :T(V)\to A
          %h4#free_cgas_
            Free CGAs:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge V
          %p This is the tensor product of the exterior algebra on the odd elements and the symmetric algebra on the even ones:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                  %mo =
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                  %msub
                    %mi V
                    %mrow
                      %mn 2
                      %mi p
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                  %msub
                    %mi V
                    %mrow
                      %mn 2
                      %mi p
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \bigwedge V = E(\bigoplus V_{2p+1})\otimes S(\bigoplus V_{2p}).
          %p
            It satisfies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⊕
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bigwedge(V \oplus W) \cong (\bigwedge V)\oplus (\bigwedge W)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a pre-cga, any morphism,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi V
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f : V\to A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \bar{f} :\bigwedge V \to A
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi e
                    %mi α
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (e_\alpha)_{\alpha \in I}
            is a homogeneous basis for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            may be written
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi e
                    %mi α
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mo ∈
                      %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigwedge((e_\alpha)_{\alpha \in I})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi e
                    %mi α
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mo ∈
                      %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T((e_\alpha)_{\alpha \in I})
            respectively.
          %p
            %strong Note:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(V)
                is a non-commutative polynomial algebra,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \bigwedge V
                is a commutative polynomial algebra.
          %h4#word_length_filtrations_on__and_
            Word length filtrations on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge V
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(V)
          %p
            On
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge V
            (resp.
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(V)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                  %mover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi k
                  %mi V
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \bigwedge V = \bigoplus_{k\geq 0}\bigwedge^k V,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi k
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge^k V
            is the subspace generated by all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi v
                    %mi k
                %annotation{:encoding => "application/x-tex"} v_1\wedge \ldots \wedge v_k
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_1 \in V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo =
                    %msup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mo ≥
                        %mi p
                    %mi V
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi k
                        %mo ≥
                        %mi p
                    %msup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mi k
                    %mi V
                  %annotation{:encoding => "application/x-tex"} F^p  \bigwedge V = \bigwedge^{\geq p} V = \bigoplus_{k\geq p}\bigwedge^k V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi V
                    %mrow
                      %mo ⊗
                      %mi k
                %annotation{:encoding => "application/x-tex"} T^k (V) = V^{\otimes k}
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi T
                      %mrow
                        %mo ≥
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi k
                        %mo ≥
                        %mi p
                    %msup
                      %mi T
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^p T(V) = T^{\geq p}(V) = \bigoplus_{k\geq p} T^k (V)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\bigwedge V,d)
            is a pre-cdga, which is free as a pre-cga on a fixed
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is the sum of derivations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi k
                %annotation{:encoding => "application/x-tex"} d_k
            defined by the condition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mi k
                    %mi V
                  %annotation{:encoding => "application/x-tex"} d_k (V) \subseteq \bigwedge^k V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(\bigwedge V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d_1
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d_1
            (resp.
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_2
            %em linear part
            (resp.
            = succeed ")" do
              %em quadratic part
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %h4#sum_and_product_of_cdgas Sum and Product of CDGAs.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,d)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A',d')
            are two cdgas, their (categorical)
            %em sum
            (i.e. coproduct) is their tensor product,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi d
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,d)\otimes(A',d' )
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi d
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,d)\oplus (A',d' )
          %h4#koszul_convention Koszul convention
          %p
            Given a permutation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of a graded object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, \ldots, x_p)
            = succeed "," do
              %em Koszul sign
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon(\sigma)
            is defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi x
                    %mi p
                  %mo =
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi x
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi …
                  %mo ∧
                  %msub
                    %mi x
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x_1\wedge \ldots \wedge x_p = \varepsilon(\sigma)x_{\sigma(1)} \wedge \ldots \wedge x_{\sigma(p)}
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bigwedge(x_1, \ldots, x_p )
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varepsilon(\sigma)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            does not suffice to define it as it depends also on the degrees of the various
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
          %h3#terminology Terminology
          %p
            Baues (in his book on
            = succeed ")" do
              %a{:href => "#Baues"}
                %em Algebraic Homotopy
            %strong chain algebra
            for positively graded differential algebras and
            %strong cochain algebras
            for the negatively graded ones. This seems to be a very useful convention.
          %h3#enrichment_of_dgalgebras_over_dgcoalgebras Enrichment of dg-algebras over dg-coalgebras
          %p
            Given a dg-coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a dg-algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} C\to B
            admits a dg-algebra structure using the coproduct on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and product on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %strong convolution algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and is denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C,B]
          %p The resulting functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %msup
                    %mi dgCoalg
                    %mi op
                  %mo ×
                  %mi dgAlg
                  %mo →
                  %mi dgAlg
                %annotation{:encoding => "application/x-tex"} [-,-]: dgCoalg^op \times dgAlg \to dgAlg
          %p
            is a part of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunction+in+two+variables"} adjunction in two variables
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▹
                  %mo :
                  %mi dgCoalg
                  %mo ×
                  %mi dgAlg
                  %mo →
                  %mi dgAlg
                %annotation{:encoding => "application/x-tex"} \triangleright: dgCoalg\times dgAlg\to dgAlg
          %p (the Sweedler product) and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo :
                  %msup
                    %mi dgAlg
                    %mi op
                  %mo ×
                  %mi dgAlg
                  %mo →
                  %mi dgCoalg
                %annotation{:encoding => "application/x-tex"} \{-,-\}:dgAlg^op\times dgAlg\to dgCoalg
          %p (the Sweedler hom).
          %p
            Taken together, these three functors turn the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            of dg-algebras into an
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            over the
            %a.existingWikiWord{:href => "/nlab/show/closed+symmetric+monoidal+category"} closed symmetric monoidal category
            of dg-coalgebras.
          %p
            See
            %a{:href => "#AnelJoyal"} Anel and Joyal
            for more information.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
          %h3#model_category_structure Model category structure
          %p
            There is a standard
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            = succeed ".See" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dgAlg
                  %annotation{:encoding => "application/x-tex"} dgAlg
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
          %h3#cosimplicial_algebras Cosimplicial algebras
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
            effectively identifies non-negatively graded
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            algebras with simplicial algebras, and non-negatively graded
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            algebras with
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial algebra
          %p
            Since cosimplicial algebras have a fundamental interpretation dual to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-space"} ∞-space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-quantity"} ∞-quantity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"}> rational homotopy theory
              \.
          %h3#dgcoalgebra dg-coalgebra
          %p
            Dually, a
            %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            in
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
          %h3#homological_smoothness Homological smoothness
          %p
            A dga
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/homologically+smooth+dga"} homologically smooth
            if as a dg-bimodule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo
                    %mi A
                  %msub
                    %mi A
                    %mi A
                %annotation{:encoding => "application/x-tex"} _A A_A
            over itself it has a bounded resolution by finitely generated projective dg-bimodules.
          %h3#formal_dgalgebra Formal dg-algebra
          %p
            A dg-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/formal+dg-algebra"} formal dg-algebra
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and its
            %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} chain (co)homology
            (regarded as a dg-algebra with trivial differential)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(A)
            are quasi-isomorphic, that is, that there exists a chain of dg-algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo :
                  %msub
                    %mi A
                    %mn 0
                  %mo ,
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi A
                    %mi k
                  %mo =
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A=:A_0,A_1,\ldots,A_k=H(A)
            such that there is a
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} A_{i-1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} A_i
            in some direction for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 1\leq i\leq k
