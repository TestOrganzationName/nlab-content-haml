                          %mn 1
                        %mo →
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} c: C_1 \times_{C_0} C_1 \to C_1
          %p
            such that the following
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
