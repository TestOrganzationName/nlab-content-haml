                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}
              is finitely complete. Then, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat(\mathbf{E})
              is the category of models for a
              %a.existingWikiWord{:href => "/nlab/show/limit+sketch"} limit sketch
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat(\mathbf{E})
              is also finitely complete.
            %p
              Now suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}
              is finitely complete and cartesian closed. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \Delta_3
              denote the category of nonempty ordinals up to and including the ordinal with 4 elements. We have a full and faithful embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mrow
                        %msubsup
                          %mi Δ
                          %mn 3
                          %mi op
                  %annotation{:encoding => "application/x-tex"} N \colon Cat(\mathbf{E}) \to \mathbf{E}^{\Delta_3^{op}}
            %p
              where the codomain category is cartesian closed. Indeed, the exponential of two objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
