                        %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cat(\mathbf{E})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
