          %p
            %a{:href => "#LT2022"} Lack and Tendas
            give criteria for a
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
          %ul
            %li
              is a
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed
              category
            %li
              has a
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              and finite
              %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
            %li
              has a strong
              %a.existingWikiWord{:href => "/nlab/show/separator"} separator
              consisting of
              %a.existingWikiWord{:href => "/nlab/show/dualizable+objects"} dualizable objects
            %li
              has for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B
              and morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} z : I \to A \otimes B
              some dualizable object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi P
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x: P \to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %msup
                      %mi P
                      %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y: P^\ast \to A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mi i
                  %annotation{:encoding => "application/x-tex"} z = (x \otimes y) i
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi I
                    %mo →
                    %mi P
                    %mo ⊗
                    %msup
                      %mi P
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i: I \to P \otimes P^\ast
              is the unit.
