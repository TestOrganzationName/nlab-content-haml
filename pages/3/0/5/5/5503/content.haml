              %semantics
                %mrow
                  %mi ZFC
                %annotation{:encoding => "application/x-tex"} ZFC
            or as (relatively mild) conditions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            %em (… clarify …)
          %h6#gdels_completeness_theorem Gödel’s completeness theorem
          %p
            Given a first-order theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in some language
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is consistent iff there is a model of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            — that is, iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ⊧
                  %mi T
                %annotation{:encoding => "application/x-tex"} M\models T
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} M\in V
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/completeness+theorem"} completeness theorem
          %h6#gdels_compactness_theorem Gödel’s compactness theorem
          %p
            Under the same hypotheses,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is consistent iff every finite subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is consistent; expressed semantically, a theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            has a model iff every finite subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            has a model.
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/compactness+theorem"} compactness theorem
          %h6#o_ultraproduct_theorem Łoś ultraproduct theorem
          %p
            %em (…think of a good way to state this…)
          %p
            See at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%C5%81o%C5%9B+ultraproduct+theorem"} Łoś ultraproduct theorem
          %h5#corollaries_worth_thinking_about Corollaries worth thinking about
          %p It follows that first-order theories are quite permissive; or in other words that they’re inefficient at pinning down particular structures.
          %p
            For example, consider the complete first-order theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi ω
                    %mo ,
                    %mo ∈
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(V_\omega,\in)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo &lt;
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\lt)
            %em expands
            the language (coresponding to an injective morphism of operads) to include constant symbols
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi x
                %annotation{:encoding => "application/x-tex"} c_x
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of finite size
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n + 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi ω
                  %mo ,
                  %mo ∈
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊧
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi ω
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi c
                    %mi x
                  %mo ∈
                  %msub
                    %mi c
                    %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo &lt;
                  %mi y
                  %mo ;
                  %mi x
                  %mo ,
                  %mi y
                  %mo ∈
                  %mi s
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (V_\omega,\in,0,1,\cdots,n)\models Th(V_\omega,\in)\cup \{c_x\in c_y \mid x\lt y;x,y\in s\}
          %p
            so that the
            %em finite extensions
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi ω
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Th(V_\omega,\in)
            by suborders of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are all consistent; by compactness, the fully extended theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi ω
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi c
                    %mi x
                  %mo ∈
                  %msub
                    %mi c
                    %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo &lt;
                  %mi y
                  %mo ;
                  %mi x
                  %mo ,
                  %mi y
                  %mo ∈
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Th(V_\omega,\in)\cup \{c_x\in c_y \mid x\lt y;x,y\in X\}
            is also consistent; thus by completeness there is a structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ϵ
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi c
                    %mi x
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\epsilon,\cdots,c_x,\cdots)
            such that *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo ⊧
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi ω
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\epsilon)\models Th(V_\omega,\in)
            *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi x
                  %mi ϵ
                  %msub
                    %mi c
                    %mi y
                %annotation{:encoding => "application/x-tex"} c_x\epsilon c_y
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\lt y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          %p
            By a similar argument, (if ZFC is consistent) there are models
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M'
            of classical set theory satisfying the (higher-order) property that the natural numbers object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mrow
                      %mi M
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \omega_{M'}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M'
            includes your favourite total order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo &lt;
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\lt)
            %em as a suborder
            — of course,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M'
            isn’t allowed to
            %em know
            this — notably, there is
            %strong no object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
