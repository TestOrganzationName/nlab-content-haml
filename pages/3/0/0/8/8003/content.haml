                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  K^{Seg} C \coloneqq \{N \widebar C_{S_\bullet^n}\}
                  \\,.
          %p
            This is the
            = succeed "." do
              %em
                K-theory spectrum of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
            (
            %a{:href => "#ElmendorfMandell06"}> Elmendorf-Mandell, def. 4.3
            )
          %h2#properties Properties
          %h3#monoidal_functoriality Monoidal functoriality
          #MonoidalFunctoriality.num_prop
            %h6#proposition Proposition
            %p
              The construction of K-theory spectra of permutative categories constitutes a
              %a.existingWikiWord{:href => "/nlab/show/multifunctor"} multifunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PermCat
                    %mo ⟶
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{K}
                    \\;\colon\;
                    PermCat
                    \\longrightarrow
                    Spectra
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
              of
              %a.existingWikiWord{:href => "/nlab/show/permutative+categories"} permutative categories
              (under
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Deligne+tensor+product"} Deligne tensor product
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              (under
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            %p Hence for a multilinear functor of permutative categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒜
                      %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi 𝒜
                      %mi n
                    %mo ⟶
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\;\colon\;
                    \\mathcal{A}_1 \times \cdots \times \mathcal{A}_n
                    \\longrightarrow
                    \\mathcal{B}
            %p
              there is a compatibly induced morphism of K-
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              out of the
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒜
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒜
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{K}(\mathcal{A}_1)
                    \\wedge
                    \\cdots
                    \\wedge
                    \\mathbb{K}(\mathcal{A}_n)
                    \\longrightarrow
                    \\mathbb{K}(\mathcal{B})
                    \\,.
            %p
              This implies that the construction further extends to a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PermCat
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} PermCat Cat
              of
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              over the
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
              of
              %a.existingWikiWord{:href => "/nlab/show/permutative+categories"} permutative categories
              to that of
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕂
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PermCat
                    %mi Cat
                    %mo ⟶
                    %mi Spectra
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{K}_\bullet
                    \\;\colon\;
                    PermCat Cat \longrightarrow Spectra Cat
            %p
              which applies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              to each
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
          %p
            (
            %a{:href => "#May80"}> May 80, theorem 1.6, Theorem 2.1
            ,
            = succeed "," do
              %a{:href => "#ElmendorfMandell04"} Elmendorf-Mandell 04, theorem 1.1
            %a{:href => "#Guillou10"} Guillou 10, Theorem 1.1
          %h2#Examples Examples
          #OrdinaryAlgebraicKTheoryFromPermutativeCategoryOfProjectiveModules.num_example
            %h6#example Example
            %p
              %strong
                (ordinary
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %mi R
                    %msub
                      %mi Mod
                      %mi pr
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = R Mod_{pr}
              its
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutative+category"} permutative category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi R
                    %msubsup
                      %mi Mod
                      %mi fin
                      %mi pr
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    K (R Mod^{pr}_{fin}) \;\simeq\; K R
            %p
              is the classical
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
              spectrum of the ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            (e.g.
            = succeed ")." do
              %a{:href => "#ElmendorfMandell04"} Elmendorf-Mandell 04, p. 10
          #StableCohomotopyIsKTheoryOfFinSet.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
                is K-theory of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} =
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              be a
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              of the category of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutative+category"} permutative category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi FinSet
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"}
                    K(FinSet) \;\simeq\; \mathbb{S}
            %p
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
              called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
          %p
            (due to
            = succeed "," do
              %a{:href => "#Segal74"} Segal 74, Prop. 3.5
            = succeed ")" do
              %a{:href => "#Priddy73"} Priddy 73
          #StableCohomotopyIsAlgebraicKTheoryOverFieldWithOneElement.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
                as
                %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
                over the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"} field with one element
            %p
              Since (
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"}> pointed
              )
              %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
              may be regarded as the modules over the “
              %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"}> field with one element
              ”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
              (see
              = succeed ")," do
                %a{:href => "field+with+one+element#Modules"} there
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 1
                    %mi Mod
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi FinSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{F}_1 Mod
                    \\;=\;
                    FinSet^{\ast/}
            %p
              one may read example
              %a.maruku-ref{:href => "#StableCohomotopyIsKTheoryOfFinSet"}
              in view of example
              %a.maruku-ref{:href => "#OrdinaryAlgebraicKTheoryFromPermutativeCategoryOfProjectiveModules"}
              as saying that
              %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
              is the algebraic K-theory of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"} field with one element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %msub
                      %mi 𝔽
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K \mathbb{F}_1 \;=\; \mathbb{S}
                    \\,.
            %p
              This perspective is highlighted for instance in (
              %a{:href => "#Deitmar06"}> Deitmar 06, p. 2
              ,
              = succeed ")." do
                %a{:href => "#Guillot06"} Guillot 06
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K-theory+of+a+bipermutative+category"} K-theory of a bipermutative category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory+of+a+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} algebraic K-theory of a symmetric monoidal (∞,1)-category
          %h2#references References
          %ul
            %li#Quillen70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                ,
                = succeed "," do
                  %em Cohomology of groups
            %li#Quillen
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                ,
                %em On the group completion of a simplicial monoid
            %li#Priddy73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stewart+Priddy"}> Stewart Priddy
                ,
                = succeed "," do
                  %em Transfer, symmetric groups, and stable homotopy theory
                = succeed "," do
                  %em Higher K-Theories
                = succeed ")" do
                  %a{:href => "https://link.springer.com/content/pdf/10.1007/BFb0067060.pdf"} pdf
            %li#Segal74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em Catgeories and cohomology theories
                = succeed ")" do
                  %a{:href => "http://ncatlab.org/nlab/files/SegalCategoriesAndCohomologyTheories.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %em The spectra associated to permutative categories
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/23.pdf"} pdf
            %li#May13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} E_\infty
                    \-Spaces, group completions, and permutative categories
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                (ed.)
                = succeed "," do
                  %em New Developments in Topology
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/13.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511662607.008"} doi:10.1017/CBO9780511662607.008
            %li#May80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %em Pairings of categories and spectra
            %li#DwyerKan80
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                = succeed "," do
                  %em Simplicial localization of categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                = succeed "," do
                  %em Permutative categories as a model of connective stable homotopy
                %a.existingWikiWord{:href => "/nlab/show/Birgit+Richter"} Birgit Richter
                (ed.)
                = succeed "," do
                  %em Structured Ring spectra
            %li#ElmendorfMandell04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                = succeed "," do
                  %em Rings, modules and algebras in infinite loop space theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0403403"} arXiv:math/0403403
            %li#ElmendorfMandell09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                = succeed "," do
                  %em Permutative categories, multicategories, and algebraic K-theory
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0710.0082"} arXiv:0710.0082
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.agt/1513797088"} euclid:1513797088
            %li#Guillou10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+Guillou"}> Bertrand Guillou
                ,
                = succeed "," do
                  %em Strictification of categories weakly enriched in symmetric monoidal categories
          %p
            The interpretation of
            %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
            as the algebraic K-theory over the
            %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"} field with one element
            is adopted in
          %ul
            %li#Deitmar06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Deitmar"}> Anton Deitmar
                ,
                %em
                  Remarks on zeta functions and K-theory over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                (
                %a{:href => "https://arxiv.org/abs/math/0605429"}> arXiv:math/0605429
                )
            %li#Guillot06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Guillot"}> Pierre Guillot
                ,
                %em Adams operations in cohomotopy
                (
                %a{:href => "https://arxiv.org/abs/math/0612327"}> arXiv:0612327
                )
          %p
            The generalization of K-theory of permutative categories to
            %a.existingWikiWord{:href => "/nlab/show/Mackey+functors"} Mackey functors
            is discussed in
          %ul
            %li#BohmannOsorno14
              %a.existingWikiWord{:href => "/nlab/show/Anna+Marie+Bohmann"}> Anna Marie Bohmann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ang%C3%A9lica+Osorno"} Angélica Osorno
              = succeed "," do
                %em Constructing equivariant spectra via categorical Mackey functors
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1405.6126"} arXiv:1405.6126
          %p
            Generalization to
            %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+homotopy+theory"} equivariant stable homotopy theory
            and
            %a.existingWikiWord{:href => "/nlab/show/G-spectra"} G-spectra
            is discussed in
          %ul
            %li#GuillouMay12
              %a.existingWikiWord{:href => "/nlab/show/Bert+Guillou"}> Bert Guillou
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              %em
                Permutative
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              (
              %a{:href => "http://arxiv.org/abs/1207.3459"}> arXiv:1207.3459
              )
