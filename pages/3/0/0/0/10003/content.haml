              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            which
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presents
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "," do
              %a{:href => "Borel+model+structure#CofibrantReplacementAndHomotopyQuotientsFixedPoints"} there
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
            is computed as the hom-space out of plain
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            out of the total space of the simplicial
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
