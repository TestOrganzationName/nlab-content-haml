          %p
            Composition extends to
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
          .num_prop
            %h6 Proposition
            %p
              If the
              = succeed "-maps" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponentiable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Poly
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Poly}(\mathcal{E})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+multicategory"} representable multicategory
              = succeed ")" do
                %a{:href => "#Garner2019"} Garner, 2019
          %h2#related_topics Related topics
          %ul
            %li
              %p
                Polynomial endofunctors are important in the definition of
                %a.existingWikiWord{:href => "/nlab/show/W-types"} W-types
                in categories.
            %li
              %p
                Polynomial functors are a special case of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/parametric+right+adjoint"} parametric right adjoints
            %li
              %p
                Polynomial functors can be defined using
                %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphisms"} exponentiable morphisms
                in a category that may not be locally cartesian closed. See also
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/distributivity+pullback"} distributivity pullback
            %li
              %p
                Kripke frames
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R,S)
                (with a transition relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                of arity
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
                are
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %em modal similarity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
                are coalgebras of a functor of the form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ↦
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi d
                            %mo ∈
                            %mi t
                        %mi P
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mi arity
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X\mapsto \product_{d\in t} P(S^{arity(d)})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo :
                      %mi X
                      %mo ↦
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Prop
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K:X\mapsto P(Prop)\times P(X)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Prop
                    %annotation{:encoding => "application/x-tex"} Prop
                is the set of propositional variables of the logic in consideration. In particular, all the functors appearing here are polynomial functors. So, at least in some aspects, the study of modal logics reduces to the study of (certain) polynomial functors.
          %h2#examples_2 Examples
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/symmetric+polynomial"}> symmetric polynomial
              ,
              %a.existingWikiWord{:href => "/nlab/show/elementary+symmetric+polynomial"} elementary symmetric polynomial
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial+monad"} polynomial monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial+comonad"} polynomial comonad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tambara+functor"} Tambara functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial+%28infinity%2C1%29-functor"} polynomial (infinity,1)-functor
          %h2#references References
          %p The standard reference, which considers dependent (multivariate) polynomial functors, is:
          %ul
            %li#GK
              %a.existingWikiWord{:href => "/nlab/show/Nicola+Gambino"}> Nicola Gambino
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"} Joachim Kock
              = succeed "," do
                %em Polynomial functors and polynomial monads
              = succeed ")." do
                %a{:href => "https://arxiv.org/abs/0906.4931"} arXiv:0906.4931
          %p
            The relation of plain polynomial functors to
            %a.existingWikiWord{:href => "/nlab/show/trees"} trees
            is discussed in
          %ul
            %li#Kock
              %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
              ,
              = succeed "," do
                %em Polynomial functors and trees
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0807.2874"} arXiv:0807.2874
          %p
            The category,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Poly
                  %annotation{:encoding => "application/x-tex"} Poly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            and its application to
            %a.existingWikiWord{:href => "/nlab/show/dynamical+systems"} dynamical systems
            is considered in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Spivak"}> David Spivak
                ,
                = succeed "," do
                  %em Poly: An abundant categorical setting for mode-dependent dynamics
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2005.01894"} arXiv:2005.01894
            %li#FMLS
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Finster"}> Eric Finster
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Samuel+Mimram"} Samuel Mimram
                %em A Cartesian Bicategory of Polynomial Functors in Homotopy Type Theory
                (
                %a{:href => "https://arxiv.org/abs/2112.14050"}> arXiv:2112.14050
                ).
          %p Talks on polynomial functors are available at
          %ul
            %li
              %p
                %em> Workshop on Polynomial Functors
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Topos+Institute"} Topos Institute
                = succeed ")" do
                  %a{:href => "https://toposinstitute.github.io/p-func-workshop/2021/"} website
            %li
              %p
                %em> Workshop on Polynomial Functors 2
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Topos+Institute"} Topos Institute
                = succeed ")" do
                  %a{:href => "https://topos.site/events/p-func-workshop/"} website
          %p
            Monograph on polynomial functors in view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+systems+theory"} categorical systems theory
          %ul
            %li#SpivakPoly
              %a.existingWikiWord{:href => "/nlab/show/David+Spivak"}> David Spivak
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nelson+Niu"} Nelson Niu
              %em Polynomial Functors: A General Theory of Interaction
              \&amp;lbrack;
              %a{:href => "https://topos.site/poly-course/"}> webpage
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://topos.site/poly-book.pdf"} pdf
          %p
            Generalization to
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            and
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            is discussed in
          %ul#vdBergMoerdijk13
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
                ,
                = succeed "," do
                  %em Data types with symmetries and polynomial functors over groupoids
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1210.0828"} arXiv:1210.0828
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"} Rune Haugseng
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"} Joachim Kock
                = succeed "," do
                  %em ∞-Operads as Analytic Monads
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1712.06469"} arXiv:1712.06469
            %li#Weber14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Weber"}> Mark Weber
                ,
                %em Operads as polynomial 2-monads
                (
                %a{:href => "https://arxiv.org/abs/1412.7599"}> arXiv:1412.7599
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benno+van+den+Berg"}> Benno van den Berg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em W-types in Homotopy Type Theory
                (
                %a{:href => "https://arxiv.org/abs/1307.2765"}> arXiv:1307.2765
                )
          %ul
            %li#DAL24
              %span.newWikiWord>
                Stefania Damato
                %a{:href => "/nlab/new/Stefania+Damato"} ?
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"} Thorsten Altenkirch
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Axel+Ljungstr%C3%B6m"} Axel Ljungström
              %em Formalising inductive and coinductive containers
              (
              %a{:href => "https://arxiv.org/abs/2409.02603"}> arXiv:2409.02603
              )
          %p See also
          %ul#KJBM
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Batanin"} Michael Batanin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jean-Fran%C3%A7ois+Mascari"} Jean-François Mascari
              = succeed "," do
                %em Polynomial functors and opetopes
              = succeed "," do
                %strong 224
              %a{:href => "https://arxiv.org/abs/0706.1033"} arXiv:0706.1033
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/j.aim.2010.02.012"} doi
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yde+Venema"}> Yde Venema
                ,
                = succeed "," do
                  %em Algebras and Coalgebras
                = succeed "," do
                  %em Handbook of modal logic
            %li#Weber2015
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Weber"}> Mark Weber
                ,
                = succeed "," do
                  %em Polynomials in categories with pullbacks
                = succeed ":16" do
                  %strong 30
                = succeed ")" do
                  %a{:href => "http://tac.mta.ca/tac/volumes/30/16/30-16abs.html"} journal
            %li
              %p
                Charles Walker,
                = succeed "," do
                  %em Universal properties of polynomials
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1806.10477"} arXiv:1806.10477
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                = succeed "," do
                  %em Polynomials as spans
                = succeed ")" do
                  %a{:href => "http://cahierstgdc.com/wp-content/uploads/2020/04/STREET-LXI-2.pdf"} pdf
            %li#Garner2019
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %em Polynomial comonads and comodules
                = succeed "," do
                  %a{:href => "https://www.math.uwo.ca/faculty/kapulkin/seminars/hottestfiles/Garner-2019-12-11-HoTTEST.pdf"} slides
                = succeed "&rbrack;" do
                  %a{:href => "https://www.youtube.com/watch?v=tW6HYnqn6eI"} video
            %li#ElmHaug
              %p
                Elden Elmanto,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"} Rune Haugseng
                %em On distributivity in higher algebra I: The universal property of bispans
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2010.15722"}> arXiv:2010.15722
                \&amp;rbrack;
          %p
            Using
            %a.existingWikiWord{:href => "/nlab/show/wreath+products+of+groups"} wreath products of groups
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/I.+G.+Macdonald"}> I. G. Macdonald
