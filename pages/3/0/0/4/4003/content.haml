          %h2#idea Idea
          %p
            The concept of a
            %em polynomial functor
            is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of that of a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
          %p
            Polynomial endo-functors are used to encode a class of
            %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
            called
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/W-types"} W-types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polynomial+monads"} polynomial monads
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
            %strong polynomial
            is a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mover
                    %mo ←
                    %mi f
                  %mi X
                  %mover
                    %mo →
                    %mi g
                  %mi Y
                  %mover
                    %mo →
                    %mi h
                  %mi Z
                %annotation{:encoding => "application/x-tex"} W \overset{f}{\leftarrow} X \overset{g}{\to} Y \overset{h}{\to} Z
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em bispans
            (cf.
            = succeed ")." do
              %a{:href => "#ElmHaug"} Elmanto &amp; Haugseng
            %strong polynomial functor
            is the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi W
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi f
                        %mo *
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Π
                        %mi g
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Σ
                        %mi h
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Z
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C/W
                  \\overset{f^*}{\to}
                  C/X
                  \\overset{\Pi_g}{\to}
                  C/Y
                  \\overset{\Sigma_h}{\to}
                  C/Z
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi g
                %annotation{:encoding => "application/x-tex"} \Pi_g
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi h
                %annotation{:encoding => "application/x-tex"} \Sigma_h
            are the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            and
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            operations, right and left adjoint respectively to
            %a.existingWikiWord{:href => "/nlab/show/pullback#PullbackFunctor"} pullback functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                %annotation{:encoding => "application/x-tex"} g^*
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mo *
                  %annotation{:encoding => "application/x-tex"} h^*
          %p
            When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} W=Z
            = succeed "." do
              %strong polynomial endofunctor
          %p
            Sometimes this general notion is called a
            %strong dependent polynomial functor
            (also
            %strong typed
            or
            %strong colored
            (
            %a{:href => "#FMLS"}> FMLS, p. 68
            )), with “polynomial (endo)functor” reserved for the “one-variable” case, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %mi Z
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} W=Z=1
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            The data
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            that specify a polynomial functor is sometimes referred to as a
            %strong container
            (or an
            = succeed "," do
              %strong indexed container
            %em container
            reserved for the case
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi Z
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} W=Z=1
            %em container
            is used as a synonym for “polynomial functor”. Sometimes the data
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ,
                  %mi h
                %annotation{:encoding => "application/x-tex"} f,g,h
            are instead referred to as a
            %strong polynomial
            to distinguish them from the “polynomial functor” they determine.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is an identity, the functor is sometimes called a
            %strong linear functor
            or a
            = succeed "." do
              %strong linear polynomial functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is not locally cartesian closed; all it needs are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable morphism
          %h2#examples Examples
          %h3#ExamplesOnSets On sets
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            \=
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            the polynomial functor induced from a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo ←
                    %mrow
                  %mi X
                  %mover
                    %mo ⟶
                    %mi g
                  %mi Y
                  %mover
                    %mo ⟶
                    %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\ast \stackrel{}{\leftarrow} X \stackrel{g}{\longrightarrow} Y
                  \\stackrel{}{\longrightarrow} \ast
          %p is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↦
                  %msub
                    %mi P
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi X
                        %mi y
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S \mapsto P_g(S) = \coprod_{y \in Y} S^{X_y}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi y
                %annotation{:encoding => "application/x-tex"} X_y
            is the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %msub
                        %mi X
                        %mi y
                %annotation{:encoding => "application/x-tex"} S^{X_y}
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            of
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            from the fiber to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            of the set on the right is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi P
                      %mi g
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi X
                        %mi y
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"}
                  {\vert P_g(S)\vert}
                  \=
                  \\sum_{y \in Y} {\vert S\vert}^{\vert X_y\vert}
          %p
            and it is in this sense that the concept of a polynomial functor is a kind of
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of that of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
          %p On the other hand, the dependent polynomial functor associated to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                  %mi X
                  %mover
                    %mo ⟶
                    %mi id
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A \stackrel{p_1}{\leftarrow} X \stackrel{id}{\longrightarrow} X
                  \\stackrel{p_2}{\longrightarrow} B
          %p acts by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi a
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                  %mo ↦
                  %msub
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi a
                          %mo ∈
                          %mi A
                      %msub
                        %mi S
                        %mi a
                      %mo ×
                      %msub
                        %mi X
                        %mrow
                          %mi a
                          %mi b
                      %mo )
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (S_a)_{a \in A}
                  \\mapsto
                  \\left(\coprod_{a \in A} S_a \times X_{a b} \right)_{b \in B}
                  \\,.
          %p
            Under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            acting on
            %a.existingWikiWord{:href => "/nlab/show/vectors"} vectors
            (with entries in the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
          %h3#ExamplesOnLextensiveCats In a general lextensive category
          %p
            Taking the fibres in the previous example to be finite and uniformly bounded (in the sense that all the fibres have size at most
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi n
                        %mo ≤
                        %mi N
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi Y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi n
                        %mo ≤
                        %mi N
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \coprod_{n \leq N} \{y\in Y\mid |g^{-1}(y)| = n \} = \coprod_{n \leq N} Y_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} g^{-1}(y) \simeq \{1,\ldots,|g^{-1}(y)|\}
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y\in Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi g
                %annotation{:encoding => "application/x-tex"} P_g
            is naturally isomorphic to the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↦
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mi N
                  %msub
                    %mi Y
                    %mi n
                  %mo ×
                  %msup
                    %mi S
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S \mapsto  \coprod_{n=0}^N Y_n\times S^n\,,
          %p
            as the hom-set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo ≃
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^{\{1,\ldots,n\}} \simeq S^n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lextensive+category"} lextensive category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            %em polynomial
            endofunctors, strictly speaking.
          .num_prop
            %h6#proposition Proposition
            %p
              Literal polynomial endofunctors on an
              %a.existingWikiWord{:href => "/nlab/show/lextensive+category"} lextensive category
              are polynomial endofunctors.
          .proof
            %h6#proof Proof
            %p
              Note that in an arbitrary lextensive category there is little guarantee that any dependent products exist. However, the right adjoint to the pullback functor associated to an iterated
              %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \coprod_{k=1}^n A\to A
              does exist for any lextensive category. And this is all that is needed.
            %p
              Consider the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %mi N
                    %mrow
                      %mo (
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi k
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi Y
                        %mi n
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %munderover
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi n
                            %mo =
                            %mn 1
                          %mi N
                        %msub
                          %mo ∇
                          %mrow
                            %msub
                              %mi Y
                              %mi n
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mi N
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\coprod_{n=1}^N \left(\coprod_{k=1}^n Y_n \right) \stackrel{\coprod_{n=1}^N \nabla_{Y_n}}{\longrightarrow} \coprod_{n=0}^N Y_n
            %p
              The pullback along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %msub
                          %mi Y
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \nabla_{Y_n}
              of an arbitrary map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f\colon T\to Y_n
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi k
                          %mo =
                          %mn 1
                        %mi n
                      %mi T
                      %mover
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi k
                              %mo =
                              %mn 1
                            %mi n
                          %mi f
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi k
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \coprod_{k=1}^n T \stackrel{\coprod_{k=1}^n f}{\longrightarrow} \coprod_{k=1}^n Y_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %msub
                          %mi Y
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \nabla_{Y_n}
              of an arbitrary map can be written as the composite of dependent product functors, which are themselves coproducts of dependent product along the ordinary codiagonal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mi n
                      %mo ⊔
                      %msub
                        %mi Y
                        %mi n
                      %mo →
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Y_n \sqcup Y_n \to Y_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊔
                    %mi T
                    %mover
                      %mo ⟶
                      %mrow
                        %mi f
                        %mo ⊔
                        %mi g
                    %msub
                      %mi Y
                      %mi n
                    %mo ⊔
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S\sqcup T \stackrel{f\sqcup g}{\longrightarrow} Y_n \sqcup Y_n
              along the codiagonal can be easily checked to be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi Y
                            %mi n
                      %mi T
                      %mo →
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S\times_{Y_n} T \to Y_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %msub
                              %mi Y
                              %mi n
                  %annotation{:encoding => "application/x-tex"} \Pi_{\nabla_{Y_n}}
              exists, and it remains to calculate what the polynomial functor associated to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is.
            %p
              This can be done summand-by-summand, i.e., for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} n\in \{1,\ldots, N\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %msub
                              %mi Y
                              %mi n
                    %mo{:stretchy => "false"} (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi Y
                      %mi n
                    %mo ×
                    %mi S
                    %mo →
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi n
                    %mo ×
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_{\nabla_{Y_n}} (\coprod_{k=1}^n Y_n \times S \to \coprod_{k=1}^n Y_n) = (Y_n\times S^n \to Y_n)\,,
            %p
              which follows from the description of the pullback along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %msub
                          %mi Y
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \nabla_{Y_n}
              and the defining properties of products, coproducts, and their interactions in a lextensive category. There is a boundary case, namely that corresponding to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n=0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %msub
                        %mi Y
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \to Y_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ×
                      %mi S
                      %mo =
                      %mn 0
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0\times S = 0 \to 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Y_0
            %p
              The final dependent product gives the output of the polynomial functor, which is the literal polynomial we started with, namely
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %mi N
                      %msub
                        %mi Y
                        %mi n
                      %mo ×
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \coprod_{n=0}^N Y_n\times S^n
          %p
            In the above proof, the only place that the existence of arbitrary pullbacks in a lextensive category was used is in constructing the general dependent product along the codiagonal. Obviously one still needs finite products, just to get off the ground. For the purposes of expressing the literal polynomial as a polynomial functor, this dependent product only needs to be applied to the projection map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ⊔
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi S
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ⊔
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y\sqcup Y) \times S \to (Y\sqcup Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mrow
                      %msub
                        %mo ∇
                        %mrow
                          %msub
                            %mi Y
                            %mi n
                %annotation{:encoding => "application/x-tex"} \Pi_{\nabla_{Y_n}}
            may not exist in a general
            %em extensive
            category with binary products, the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mrow
                      %msub
                        %mo ∇
                        %mrow
                          %msub
                            %mi Y
                            %mi n
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ⊔
                  %mi Y
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Pi_{\nabla_{Y_n}}\circ (Y\sqcup Y)^*
            does. The extent to which such an endofunctor deserves to be called a polynomial endofunctor is up for debate.
          %p
            In a lextensive category with
            %em countable
            coproducts (and the corresponding compatibility with pullbacks), for instance an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinitary+pretopos"} infinitary pretopos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↦
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi Y
                    %mi n
                  %mo ×
                  %msup
                    %mi S
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S \mapsto  \coprod_{n=0}^\infty Y_n\times S^n\,,
          %p with practically identical proof and no additional assumptions.
          %h2#the_2category_of_polynomial_functors The 2-category of polynomial functors
          %p
            Any polynomial functor, as defined above, is automatically equipped with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensorial+strength"} tensorial strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are regarded as tensored over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in the canonical way. The following theorem is proven in
            = succeed ":" do
              %a{:href => "#GK"} Gambino–Kock
          .num_theorem
            %h6#theorem Theorem
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
              whose objects are the objects of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              are diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mover
                      %mo ←
                      %mi f
                    %mi X
                    %mover
                      %mo →
                      %mi g
                    %mi Y
                    %mover
                      %mo →
                      %mi h
                    %mi Z
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} W \overset{f}{\leftarrow} X \overset{g}{\to} Y \overset{h}{\to} Z,
            %p and whose 2-morphisms are diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi id
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi W
                          %mtd
                          %mtd
                            %mi X
                            %mo ′
                            %msub
                              %mo ×
                              %mrow
                                %mi Y
                                %mo ′
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                          %mtd
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                            %mo ′
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ &amp; &amp; X &amp; \to &amp; Y \\
                    \&amp; \swarrow &amp; \uparrow &amp; &amp; \mathllap{id}\uparrow &amp; \searrow\\
                    W &amp;&amp; X' \times_{Y'} Y &amp; \to &amp; Y &amp;&amp; Z\\
                    \&amp;\nwarrow &amp; \downarrow &amp; &amp; \downarrow &amp; \nearrow \\
                    \&amp;&amp; X' &amp; \to &amp; Y'. }
            %p
              This bicategory is equivalent to the 2-category whose objects are slice categories of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
            In particular, “being polynomial” is a mere
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} property
            of a strong functor between slice categories. That is, the data
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            are uniquely determined, up to isomorphism, by the strong functor they generate. (Note that the property of “being polynomial” depends on a prior identification of the domain and codomain as being slice categories of some specified ambient category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Z
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Z
                %annotation{:encoding => "application/x-tex"} C/Z \to C/Z
            might be polynomial when its domain and codomain are regarded as slice categories of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Z
                %annotation{:encoding => "application/x-tex"} C/Z
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            — this happens when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %mi Z
                %annotation{:encoding => "application/x-tex"} W=Z
            but
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi g
                    %mo ≠
                    %mi f
                  %annotation{:encoding => "application/x-tex"} h g \neq f
          %p
            Note that the above bicategory contains, as a locally full sub-bicategory, the usual bicategory of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lack%27s+coherence+theorem"} Lack's coherence theorem
          %p
            There is a particular subclass of the 2-morphisms in this bicategory that is also interesting: a 2-morphism corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformation"} cartesian natural transformation
            if and only if the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ′
                  %msub
                    %mo ×
                    %mrow
                      %mi Y
                      %mo ′
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X' \times_{Y'} Y \to X
            is an isomorphism. Since anything isomorphic to a pullback is a pullback, in this case the diagram can be drawn more simply by omitting the upper square and merely asking that the lower square
            %em be
            a pullback.
          %p
            Furthermore, this bicategory is actually the horizontal bicategory of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/framed+bicategory"} framed bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo →
                  %mi W
                  %mo ′
                %annotation{:encoding => "application/x-tex"} W\to W'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo →
                  %mi Z
                  %mo ′
                %annotation{:encoding => "application/x-tex"} Z\to Z'
            on the left and right.
          %h2#the_multicategory_of_singlevariable_polynomials The multicategory of single-variable polynomials
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be a category with (chosen) pullbacks and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            be a class of morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            called
            = succeed "." do
              %em display maps
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Poly
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Poly}(\mathcal{E})
            %a{:href => "#Garner2019"} Garner, 2019
            and attributed to
            = succeed "," do
              %a{:href => "#Weber2015"} Weber, 2015
          %ul
            %li
              %p
                objects are
                = succeed "-maps" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} p \colon E \rightarrow B
                (that is, polynomials
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                        %mo ←
                        %mi E
                        %mo →
                        %mi B
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} * \leftarrow E \rightarrow B \rightarrow *
            %li
              %p
                nullary morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \sigma \colon () \rightarrow p
                are sections of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
