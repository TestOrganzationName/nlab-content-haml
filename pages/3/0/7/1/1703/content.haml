                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  C(U) &amp;\to&amp; \mathbf{B}G
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(U)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of a
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \to X
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{E}G
            is the
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundle"} universal principal 2-bundle
            (
            %a{:href => "#RS"}> RS
            ). This says that principal 2-bundles are classified by
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            with coefficients in
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
          %h2#properties Properties
          %h3#Classification Classification
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well pointed topological 2-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo :
                    %mo =
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G := \bar W G
              for its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} |
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    B G := \vert \mathbf{B}G\vert \in Top
            %p
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              is a classifying space for topological
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a (sufficiently nice…)
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is naturally in bijections with the set of
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              classes of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to B G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X, \mathbf{B}G) \simeq [X, B G]
                    \\,.
          %p
            This appears as (
            %a{:href => "#BaezStevenson"}> BaezStevenson, theorem 1
            ). It is also a special case of the analogous theorem for topological
            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} principal infinity-bundles
            in (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson
            ).
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
              with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \pi_0 G
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G_0 \to \pi_0 G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/submersion"} submersion
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are in natural bijection with equivalence classes of topological
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as a topological 2-group)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi smooth
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X, \mathbf{B}G) \simeq H_{smooth}(X, \mathbf{B}G)
            %p
              induced by the natural
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %p
            This appears as (
            %a{:href => "#NikolausWaldorf11"}> Nikolaus-Waldorf 11, prop. 4.1
            ).
          .num_cor
            %h6#corollary Corollary
            %p
              For
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi G
                      %mo =
                      %mo{:stretchy => "false"} |
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} B G = \vert \mathbf{B}G\vert
          %h2#connections Connections
          %p
            An ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            may be equipped with a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            by refining the cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  X \to \mathbf{B} G
          %p to a cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  P_1(X) \to \mathbf{B} G
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_1(X)
            is the
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Similarly, 2-bundles may be equipped with connections by refining their cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}H
            to cocycles out of a higher path groupoid. Details on this are at
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
          %h2#examples Examples
          %h3#tfolds T-Folds
          %p
            Principal 2-bundles for the
            %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} T-duality 2-group
            serve to model
            %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
            in
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            (
            %a{:href => "#NikolausWaldorf18"}> Nikolaus-Waldorf 18
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            %li
              %p
                %strong principal 2-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
                \/
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/principal+2-connection"} principal 2-connection
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/central+extension+of+groupoids"} central extension of groupoids
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/line+2-bundle"} line 2-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+3-bundle"} principal 3-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/2-gerbe"} 2-gerbe
                \/
                %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-gerbe"} ∞-gerbe
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
          %h2#references References
          %p
            The general description of higher bundles internal to generalized spaces modeled as
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
              ,
              %em Cocycle categories
              (
              %a{:href => "http://arxiv.org/abs/math.AT/0605198"}> pdf
              ) .
          %p
            The above situation of ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            is section 2.1
            %em
              %a.existingWikiWord{:href => "/nlab/show/torsor"} Torsors
              for
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              of groups
            in that article. The generalization to principal 2-bundles and
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            is then briefly indicated in section 2.2,
            %em Diagrams and torsors
            \.
          %p
            The point is that in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of topological or smooth or whatever
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            (i.e. in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            on our category of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} test spaces
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            that arises as the
            %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} homotopy fiber
            of a classifying morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
            (a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/2-anafunctor"} anafunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\to&amp; \mathbf{B}G
                  }
                  \\,.
          %p
            This may be modeled by the pullback of the
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundle"} universal principal 2-bundle
            as described in
          %ul#RS
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Michael+Roberts"} David Michael Roberts
              %em The inner automorphism 3-group of a strict 2-group
              (
              %a{:href => "http://arxiv.org/abs/0708.1741"}> arXiv
              )
          %p
            As ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
            cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi X
                  %mover
                    %mo →
                    %mo ≃
                  %mo ←
                  %mi Y
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                %annotation{:encoding => "application/x-tex"} g : X \stackrel{\simeq}{\to}\leftarrow Y \to \mathbf{B}H
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            %a.existingWikiWord{:href => "/nlab/show/torsors"} torsors
            equipped with 2-group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
          %p
            Maybe the earliest explicit description of a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/geometric+definition+of+higher+category"} geometric definition of higher category
            is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Glenn"}> Paul Glenn
              ,
              = succeed "," do
                %em Realization of cohomology classes in arbitrary exact categories
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0022-4049(82)90094-9"} doi:10.1016/0022-4049(82)90094-9
          %p
            This describes
            %a.existingWikiWord{:href => "/nlab/show/torsors"} torsors
            over
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            in terms of the corresponding
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
          %p
            This theory of higher bundles and
            %a.existingWikiWord{:href => "/nlab/show/gerbes"} gerbes
            was made to look manifestly like a systematic
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorification
            of the familiar description of ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            in terms of cocycles and local trivializations in
          %ul
            %li
              Luca Mauri, PhD thesis, 1998 (
              %a{:href => "http://home.aubg.bg/faculty/aganchev/Category%20Theory/Mauri%20%28papers%29/mauri-2.pdf"}> pdf
              );
          %p An abridged version is
          %ul
            %li
              L. Mauri, M. Tierney,
              %em Two-descent, two-torsors and local equivalence
              , J. Pure Appl. Algebra 143 (1999), 313–327.
          %p The first article in the differential-geometric context was
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Toby+Bartels"}> Toby Bartels
              ,
              %em 2-Bundles
              (
              %a{:href => "http://arxiv.org/abs/math.CT/0410328"}> arXiv
              ,
              = succeed ")" do
                %a{:href => "http://toby.bartels.name/2bundles/"} web
          %p
            One should notice that if one uses categories internal to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaves
            %a.existingWikiWord{:href => "/nlab/show/anafunctors"} anafunctors
            used as morphisms between these simplicial presheaves represent precisely the morphisms the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            using the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            or, more lightweight, the structure of a Brown
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            on
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            A description of higher principal bundles (see also
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            appears in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
              , Z. Luo,
              = succeed "," do
                %em Higher principal bundles
              = succeed "," do
                %a{:href => "http://www.math.uiuc.edu/K-theory/0681/cocycles6.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/S0305004105008911"} doi:10.1017/S0305004105008911
          %p
            The relation of such 2-categorical constructions of 2-bundles to the one of simplicially modeled
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bakovic"}> Igor Bakovic
              ,
              %em Bigroupoid 2-torsors
              (
              %a{:href => "http://edoc.ub.uni-muenchen.de/9209/1/Bakovic_Igor.pdf"}> pdf
              ).
          %p Still more explicit descriptions of these constructions are given in
          %ul
            %li
              Christoph Wockel,
              %em A global perspective to gerbes and their gauge stacks
              (
              %a{:href => "http://arxiv.org/abs/0803.3692"}> arXiv
              ) .
          %p
            These constructions either work internal to
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            or internal to some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            More generally, a principal 2-bundle is a (
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} 2-truncated
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/site"} site
          %p This is for instance in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Behrang+Noohi"}> Behrang Noohi
              , E. Aldrovandi,
              = succeed "," do
                %em Butterflies II: Torsors for 2-group stacks
              %a{:href => "http://arxiv.org/abs/0910.1818"} arXiv
          %p
            Notice that
            %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
            is just another word for (internal)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          %p Classification results of principal 2-bundles are in
          %ul#BaezStevenson
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              %em The classifying space of a topological 2-group
              Algebraic Topology
              %p
                Abel Symposia, 2009, Volume 4, 1-31 (
                %a{:href => "http://arxiv.org/abs/0801.3843"}> arXiv:0801.3843
                )
          %ul#RobertsStevenson
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Michael+Roberts"}> David Michael Roberts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              %em Simplicial principal bundles in parametrized spaces
              (
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#StevensonRoberts"}> web
              )
          %p An extensive discussion of various models of principal 2-bundles is in
          %ul
            %li#NikolausWaldorf11
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"} Konrad Waldorf
              = succeed "," do
                %em Four Equivalent Versions of Non-Abelian Gerbes
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1103.4815"} arXiv:1103.4815
              = succeed ")" do
                %a{:href => "https://msp.org/pjm/2013/264-2/p04.xhtml"} DOI: 10.2140/pjm.2013.264.355
          %p
            For a comprehensive account in the general context of
            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} principal infinity-bundles
            see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Principal+%E2%88%9E-bundles+--+theory%2C+presentations+and+applications"} Principal ∞-bundles – theory, presentations and applications
              (
              %a{:href => "http://arxiv.org/abs/1207.0248"}> arXiv:1207.0248
              ,
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1207.0249"} arXiv:1207.0249
          %p
            For more references see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/principal+2-connection"} principal 2-connection
          %p
            The example for structure group the
            %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} T-duality 2-group
            is discussed, as a formalization of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
          %ul
            %li#NikolausWaldorf18
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"} Konrad Waldorf
              %em Higher geometry for non-geometric T-duals
              (
              %a{:href => "https://arxiv.org/abs/1804.00677"} arXiv:1804.00677
        .revisedby
          %p
