          %h2#idea Idea
          %p
            A
            %em principal 2-bundle
            is the generalization of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            over a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to a principal structure over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = AUT(H)
            the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of a group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            (see
            %a.existingWikiWord{:href => "/nlab/show/gerbe+%28general+idea%29"} gerbe (general idea)
            for more background.). An
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+gerbe"} nonabelian bundle gerbe
            is a model for the total space of an
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(H)
          %p
