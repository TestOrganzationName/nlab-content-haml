                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#original_definition"} Original definition
              %li
                %a{:href => "#definition_using_sieves"} Definition using sieves
              %li
                %a{:href => "#Saturation"} Saturation
              %li
                %a{:href => "#Examples"} Examples
              %ul
                %li
                  %a{:href => "#topology_on_open_subsets_of_a_topological_space"} Topology on open subsets of a topological space
                %li
                  %a{:href => "#regular_topology"} Regular topology
                %li
                  %a{:href => "#extensive_topology"} Extensive topology
