                %annotation{:encoding => "application/x-tex"} \mathrm{Cond}\infty\mathrm{Grpd}
            of condensed infinity-groupoids is a locally small
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-category"} locally cartesian closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-pretopos"} (infinity,1)-pretopos
          %p
