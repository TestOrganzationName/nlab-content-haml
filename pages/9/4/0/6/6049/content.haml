            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 5
                      %mo ,
                      %mn 1
                  %mo ×
                  %msub
                    %mi ℝ
                    %mi ϕ
                  %mo ×
                  %msup
                    %mi S
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1} \times \mathbb{R}_\phi \times S^0
            must be the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of two
            %a.existingWikiWord{:href => "/nlab/show/KK-monopoles"} KK-monopoles
            of
            = succeed "," do
