            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            with
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
