            = succeed ":" do
              %a{:href => "#Fazzi17"} Fazzi 17, p. 38
          %blockquote
            %p
              The NS5-D6 Hanany–Witten setup engineering six-dimensional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
