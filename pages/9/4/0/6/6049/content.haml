            (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            the section
            = succeed ")." do
              %em
                %a{:href => "4-sphere#QuaternionAction"} SU(2)-action
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ADE
                  %annotation{:encoding => "application/x-tex"} G_{ADE}
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            has precisely two
            %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo ↪
                    %msup
                      %mi S
                      %mn 4
                    %mo →
                    %msup
                      %mi S
