          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#GaiottoTomasiello14"} Gaiotto-Tomasiello 14
          %p
            Subject to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/s-rule"} s-rule
          %center
            %img{:src => "https://ncatlab.org/nlab/files/D6D8BraneIntersectionsSubjetToSRule.jpg", :width => "600"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#Fazzi17"} Fazzi 17
          %center
            %img{:src => "https://ncatlab.org/nlab/files/D6D8BraneIntersectionWithImplicitSRume.jpg", :width => "600"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#GKSTY02"} GKSTY 02
          %p
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnel"} fuzzy funnel
