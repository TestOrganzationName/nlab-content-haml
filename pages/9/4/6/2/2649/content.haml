          %h2#idea Idea
          %p
            A connected object is a generalisation of the concept of
            %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected space
            from
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            to an arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
          %h2#definitions Definitions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
          #ConnectedObject.num_defn
            %h6#definition Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is called
              %em connected
              if the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(X, -) \,\colon\, \mathcal{C} \to Set
                    \\,.
            %p
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
          .num_remark
            %h6#remark Remark
            %p
              By definition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,-)
              preserves binary coproducts if the canonically defined morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo +
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y) + \mathcal{C}(X,Z) \to \mathcal{C}(X,Y + Z)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
          %p
          #InitialObjectIsNotConnected.num_remark
            %h6 Remark
            %p
              %strong (initial object is not connected)
              %br/
              By Def.
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectedObject"}
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                  %annotation{:encoding => "application/x-tex"} \varnothing
              of a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %em not
              connected:
            %p
              Because,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo ∅
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(\varnothing, -) \,\colon\, \mathcal{C} \to Set
              is, by definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
              %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
              with value the
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \ast \,\in\, Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X , Y \,\in\, \mathcal{C}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo ∅
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ⊔
                    %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≠
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mo ⊔
                    %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo ∅
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo ∅
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\big(
                    \\varnothing
                    ,\,
                    X \sqcup Y
                    \\big)
                    \\;\simeq\;
                    \\ast
                    \\;\;
                    \\neq
                    \\;\;
                    \\ast \sqcup \ast
                    \\;\simeq\;
                    \\mathcal{C}
                    (\varnothing,\, X)
                    \\sqcup
                    \\mathcal{C}
                    (\varnothing,\, Y)
                    \\;\;\;
                    \\in
                    \\;
                    Set
                    \\,.
            %p
              One may understand this as part of the pattern by which degenerate objects may be “
              %a.existingWikiWord{:href => "/nlab/show/too+simple+to+be+simple"}> too simple to be simple
              ”. For example, also the
              %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
              should not be considered connected, see
              %a{:href => "connected+space#ConnectedEmptySpace"} this remark
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected space
              \.
            %p
          .num_remark
            %h6#remark_2 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/infinitary+extensive+category"} infinitary extensive category
              then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ob(\mathcal{C})
              to be connected it is enough to require that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,-)
              preserves
              %em binary
              coproducts. This is theorem
              %a.maruku-ref{:href => "#RespectForBinaryCoproductsIsSufficient"}
              below.
          %h2#properties Properties
          %h3#characterization_in_terms_of_coproducts Characterization in terms of coproducts
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an infinitary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
          %p
          #RespectForBinaryCoproductsIsSufficient.num_prop
            %h6 Proposition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is connected, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectedObject"}
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \hom(X, -) \colon C \to Set
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              binary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
          %p
          .proof
            %h6 Proof
            %p The “only if” is clear, so we just prove the “if”.
            %p
              We first show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, -)
              preserves the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, -)
              preserves the binary product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo +
                      %mn 0
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X + 0 = X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, X) + \hom(X, 0) \to \hom(X, X)
            %p
              is a bijection of sets, where the restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, X)
              is also a bijection of sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mo :
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} id: \hom(X, X) \to \hom(X, X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, 0)
              to be empty.
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Y
                      %mi α
                    %mo :
                    %mi α
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{Y_\alpha: \alpha \in A\}
              be a set of objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi α
                    %msub
                      %mi Y
                      %mi α
                  %annotation{:encoding => "application/x-tex"} f\colon X \to \sum_\alpha Y_\alpha
            %p
              factors through a unique inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi α
                      %mo :
                      %msub
                        %mi Y
                        %mi α
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi α
                      %msub
                        %mi Y
                        %mi α
                    %annotation{:encoding => "application/x-tex"} i_\alpha: Y_\alpha \to \sum_\alpha Y_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi α
                    %mo ≔
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_\alpha \coloneqq f^\ast (Y_\alpha)
              exists and the canonical map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi α
                    %msub
                      %mi U
                      %mi α
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sum_\alpha U_\alpha \to X
              is an isomorphism. We will treat it as the identity.
            %p Now all we need is to prove the following.
            %ul
              %li
                Claim:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msub
                        %mi U
                        %mi α
                    %annotation{:encoding => "application/x-tex"} X = U_\alpha
                for exactly one
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi β
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} U_\beta = 0
            %p
              Indeed, for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msub
                      %mi U
                      %mi α
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi β
                        %mo ≠
                        %mi α
                    %msub
                      %mi U
                      %mi β
                  %annotation{:encoding => "application/x-tex"} id\colon X \to U_\alpha + \sum_{\beta \neq \alpha} U_\beta
            %p
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, -)
              preserves binary coproducts. In others words, either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi U
                      %mi α
                  %annotation{:encoding => "application/x-tex"} X = U_\alpha
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi β
                        %mo ≠
                        %mi α
                    %msub
                      %mi U
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X = \sum_{\beta \neq \alpha} U_\beta
              (and the other is
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi α
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} U_\alpha = 0
              for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi α
                    %msub
                      %mi U
                      %mi α
                  %annotation{:encoding => "application/x-tex"} X = \sum_\alpha U_\alpha
              would be
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \hom(X, 0) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi U
                      %mi α
                  %annotation{:encoding => "application/x-tex"} X = U_\alpha
              for at least one
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi α
                    %mo ∩
                    %msub
                      %mi U
                      %mi β
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} U_\alpha \cap U_\beta = 0
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ≠
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \alpha \neq \beta
          %p
          .num_remark
            %h6 Remark
            %p
              This above proof of Prop.
              %a.maruku-ref{:href => "#RespectForBinaryCoproductsIsSufficient"}
              is not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msub
                        %mi U
                        %mi α
                    %annotation{:encoding => "application/x-tex"} X = U_\alpha
              %a.existingWikiWord{:href => "/nlab/show/Markov%27s+principle"} Markov's principle
              applies to
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p From the proof above, we extract a result useful in its own right, giving an alternative definition of connected object.
          %p
          #InExtensiveCategoryCOnnectedObjectsArePrimitiveUnderCoproduct.num_prop
            %h6 Proposition
            %p
              %strong (in extensive categories connected objects are primitive under coproduct)
              %br/
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in an
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
              is connected, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectedObject"}
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              decomposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %mi U
                      %mo +
                      %mi V
                    %annotation{:encoding => "application/x-tex"} X \simeq U + V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is not the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          %p
          #ProofThatInExtensiveCategoryCOnnectedObjectsArePrimitiveUnderCoproduct.proof
            %h6 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is connected and consider an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mo ∼
                    %msub
                      %mi X
                      %mn 1
                    %mo ⊔
                    %msub
