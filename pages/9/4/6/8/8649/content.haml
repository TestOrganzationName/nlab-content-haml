                  = succeed "," do
                    %em D-branes in orbifold singularities and equivariant K-theory
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/9812226"} arXiv:hep-th/9812226
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Gaberdiel"}> Matthias Gaberdiel
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bogdan+Stefanski"} Bogdan Stefanski
                  = succeed "," do
                    %em Dirichlet Branes on Orbifolds
