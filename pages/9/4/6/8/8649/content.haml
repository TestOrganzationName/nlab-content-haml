              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"} Nigel Hitchin
