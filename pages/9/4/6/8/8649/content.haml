              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %center
            %img{:src => "https://ncatlab.org/nlab/files/AtiyahHitchinChargeQuantizationII.jpg", :width => "640"}/
