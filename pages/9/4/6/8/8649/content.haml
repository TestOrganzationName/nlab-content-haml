                %em Constraints on the topology of Type IIB string theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2403.04127"}> arXiv:2403.04127
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://inspirehep.net/literature/2767009"} InSpire:2767009
          %div
            %h3#DBraneChargeQuantizationInTopologicalKTheory D-brane charge quantization in topological K-theory
            %p
              On the conjectural
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/D-brane+charge+quantization+in+topological+K-theory"} D-brane charge quantization in topological K-theory
            %h4#origin_and_basics Origin and basics
            %p
              The idea that
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
              have
              %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
              in
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              originates with the observation that their charge expressed in
              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
              %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
              resembles the image of a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            %ul
              %li#GreenHarveyMoore97
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jeffrey+A.+Harvey"} Jeffrey A. Harvey
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                  = succeed "," do
                    %em I-Brane Inflow and Anomalous Couplings on D-Branes
                  %strong 14
                  (1997) 47-52 [
                  %a{:href => "https://doi.org/10.1088/0264-9381/14/1/008"}> doi:10.1088/0264-9381/14/1/008
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/hep-th/9605033"} arXiv:hep-th/9605033
              %li#MinasianMoore97
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"}> Ruben Minasian
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                  = succeed "," do
                    %em K-theory and Ramond-Ramond charge
                  = succeed "," do
                    %a{:href => "https://doi.org/10.1088/1126-6708/1997/11/002"} doi:10.1088/1126-6708/1997/11/002
                  = succeed "]" do
                    %a{:href => "http://arxiv.org/abs/hep-th/9710230"} arXiv:hep-th/9710230
            %p Further early discussion:
            %ul
              %li#Witten98
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                  ,
                  = succeed "," do
                    %em D-Branes And K-Theory
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/hep-th/9810188"} arXiv:hep-th/9810188
                  = succeed "]" do
