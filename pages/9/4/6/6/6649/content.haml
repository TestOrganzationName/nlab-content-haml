          %h2#idea Idea
          %p
            A class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            of
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            is
            %em saturated
            if it is closed under the “construction” of other limits out of limits in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            be a
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \Phi\colon D\to V
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            may be different for different elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p
            Any such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \Phi\colon D\to V
            can serve as a
            %em weight
            for defining the
            %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
            of a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D\to C
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              \-complete
            if it admits all such limits, for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \Phi\in\mathcal{X}
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "-complete" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              \-continuous
            if it preserves all such limits.
          %p
            The
            %strong saturation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            is the class of all weights
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \Phi\colon D\to V
            (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            small) such that
          %ol
            %li
              Any
              = succeed "-complete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-weighted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
            %li
              Any
              = succeed "-continuous" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-weighted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
          %p It is an open question whether the second condition is implied by the first in general.
          %p
            Finally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            is
            %strong saturated
            if it is its own saturation.
          %h3#the_conical_case The conical case
          %p
            When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V=Set
            %em conical
            limits, i.e. limits whose weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Phi\colon D\to Set
            is the constant functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi D
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta_D 1
            at the terminal set. These give the classical notion of
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p
            In this case, we may consider instead classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \mathcal{J}
            of small categories; we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            for the class of weights
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Δ
                      %mi C
                    %mn 1
                    %mo{:stretchy => "false"} |
                    %mi C
                    %mo ∈
                    %mi 𝒥
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ \Delta_C 1 | C \in \mathcal{J}\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            lies in the
            %strong saturation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \mathcal{J}
            if the weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi D
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta_D 1
            lies in the saturation of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \mathcal{J}
            is
            %strong saturated
            if it is its own saturation.
          %p
            Note that in practically all cases, the saturation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            will contain weights that are not of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi D
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta_D 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} V=Set
            there are nontrivial saturated classes of
            %em weights
            that do not contain any nontrivial
            %em conical
            weights, such as the saturation of the weight for “cartesian squares”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A\times A
          %p
            However, for conical weights the answer to the above open question is known to be affirmative. On the one hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            is a class of
            = succeed "-weights" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "-complete" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            = succeed "-complete," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi D
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta_D 1
            = succeed "-continuous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            = succeed "-continuous." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi D
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta_D 1
            %a{:href => "#AK"} AK
            for a proof of this.
          %p
            On the other hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \mathcal{J}
            is a class of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is a
            = succeed "-weight" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "-complete" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            = succeed "-complete," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            = succeed "-continuous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            = succeed "-continuous." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi 𝒥
                %annotation{:encoding => "application/x-tex"} \Delta_{\mathcal{J}}
            we consider a class of weights all of which take only nonempty sets as values. See
            %a{:href => "#KP"} KP
            for a proof of this.
          %h2#characterization Characterization
          %p
            The main theorem of
            %a{:href => "#AK"} AK
            (which introduced the notion under the name “closure”) is the following.
          .un_theorem
            %h6#theorem Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \Phi\colon D\to V
              lies in the saturation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              if and only if it lies in the closure of the
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              under
              = succeed "-weighted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi D
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [D,V]
          %h2#examples Examples
          %p
            The following examples are all for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V=Set
          %ul
            %li
              %p
                The class of small
                %a.existingWikiWord{:href => "/nlab/show/products"} products
                is not saturated; its saturation includes all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi D
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta_D 1
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                has local initial objects. Similarly, the class of finite products is not saturated; the saturation of this coincides with the saturation of the finite class containing only
                %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
                and binary products.
            %li
              %p
                The class of
                %a.existingWikiWord{:href => "/nlab/show/L-finite+limits"} L-finite limits
                is saturated with respect to conical weights (but not in the sense of the definition above); it is the saturation of the class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            %li
              %p
                The class of
                %a.existingWikiWord{:href => "/nlab/show/connected+limits"} connected limits
                is saturated with respect to conical weights. It is the saturation of the class consisting of
                %a.existingWikiWord{:href => "/nlab/show/wide+pullbacks"} wide pullbacks
                and equalizers. Similarly, the class of L-finite connected limits is the saturation of the finite class of pullbacks and equalizers. See also
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                and
                %a.existingWikiWord{:href => "/nlab/show/wide+pullback"} wide pullback
                for their saturations.
          %p
            There are also interesting examples for other
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %ul
            %li
              %p
                When
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/PIE-limits"} PIE-limits
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/flexible+limits"} flexible limits
                %a.existingWikiWord{:href => "/nlab/show/semiflexible+limits"} semiflexible limits
                are saturated. The first class is, essentially by definition, the saturation of the class containing products,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/inserters"} inserters
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equifiers"} equifiers
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/splitting+of+idempotents"} splitting of idempotents
            %li
              %p
                When
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} V=F
                is the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functors"} fully faithful functors
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/F-category"} F-category
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                      %annotation{:encoding => "application/x-tex"} w
                %a.existingWikiWord{:href => "/nlab/show/rigged+weight"} rigged weights
                is saturated (for any of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                        %mo =
                        %mi p
                      %annotation{:encoding => "application/x-tex"} w=p
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi l
                      %annotation{:encoding => "application/x-tex"} l
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                denoting pseudo, lax, or colax).
            %li
              %p
                For any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %a.existingWikiWord{:href => "/nlab/show/absolute+colimits"} absolute colimits
                is saturated. When
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} V=Set
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splitting of idempotents
          %p It is also worth mentioning some non-examples.
          %ul
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} V=Set
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
                is not saturated; its saturation is the class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/L-finite+limits"} L-finite limits
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %a.existingWikiWord{:href => "/nlab/show/strict+pseudo-limits"} strict pseudo-limits
                is not saturated; it does not even contain the representables. (The same is true for strict lax limits.) It is unclear precisely what its saturation looks like.
          %h2#references References
          %ul
            %li#AK
              %p
                M. H. Albert and
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
                = succeed "," do
                  %em The closure of a class of colimits
                %strong 51
                (1988) 1-17 [
                %a{:href => "https://doi.org/10.1016/0022-4049(88)90073-4"}> doi:10.1016/0022-4049(88)90073-4
                ]
            %li#KP
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                and
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"} Robert Paré
                = succeed "," do
                  %em A note on the Albert-Kelly paper ‘The closure of a class of colimits’
                = succeed "]" do
                  %a{:href => "https://doi.org/10.1016/0022-4049(88)90074-6"} doi;10.1016/0022-4049(88)90074-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
                and V. Schmitt,
                = succeed "," do
                  %em Notes on enriched categories with colimits of some class
                %a{:href => "http://www.tac.mta.ca/tac/volumes/14/17/14-17abs.html"} tac:14-17
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/math/0501383"} arXiv:math/0501383
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                ,
                %em
                  Free colimit completion in
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                \&amp;lbrack
                %a{:href => "https://arxiv.org/abs/2210.08582"}> arXiv:2210.08582
                \&amp;rbrack (2022).
