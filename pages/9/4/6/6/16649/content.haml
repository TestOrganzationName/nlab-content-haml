          %h2#definition Definition
          %p
            The
            %em exponent
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(G)
          %ul
            %li
              %p
                the least
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi g
                          %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} g^n = 1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+element"} identity element
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} g \in G
            %li
              %p
                hence the
                %a.existingWikiWord{:href => "/nlab/show/least+common+multiple"} least common multiple
                of the
                %a.existingWikiWord{:href => "/nlab/show/order+of+a+group+element"} orders
                of the group elements.
          %p
            Here “least” should, by all rights, refer to the
            %em divisibility order
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ≤
                  %mi n
