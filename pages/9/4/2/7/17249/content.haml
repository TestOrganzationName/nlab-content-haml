            %p
              If we abbreviate (this follows conventions familiar in discussion of
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/transgression+in+group+cohomology"} transgression in group cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
