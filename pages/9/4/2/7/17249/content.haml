            %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine (2009), p. 20
          %p
          #NerveOfCategoriesPreservesMappingObjects.num_prop
            %h6 Proposition
            %p
              %strong (simplicial nerve intertwines function complexes with functor categories)
              %br/
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ,
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}, \mathcal{A}
              be
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps(\mathcal{X}, \mathcal{A})
              for their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Cat
                      %mi sm
                    %mo ⟶
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    N \;\colon\; Cat^{sm} \longrightarrow sSet
              this is
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
              to the function complex (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FunctionComplexOfSimplicialSets"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+nerves"} simplicial nerves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\big(
                    Maps(\mathcal{X},\,\mathcal{A})
                    \\big)
                    \\;\simeq\;
                    Maps
                    \\big(
                    N(\mathcal{X})
                    ,\,
                    N(\mathcal{A})
                    \\big)
                    \\,.
            %p
          (For the proof see
          %a{:href => "nerve#NerveOfCategoriesPreservesMappingObjects"} here
          at
          = succeed ".)" do
            %em
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
          %h2#examples Examples
          %h3#general_2 General
          %p
          #MappingComplexBetweenNervesOfGroupoids.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/simplicial+mapping+complex"} simplicial mapping complex
                between
                %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(\mathcal{G}_i)
              the
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi SimplicialSets
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    N(\mathcal{G}_1),
                    \\,
                    N(\mathcal{G}_2)
                    \\big]
                    \\;\;
                    \\simeq
                    \\;\;
                    N
                    \\big(
                    Func(\mathcal{G}_1, \, \mathcal{G}_2)
                    \\big)
                    \\;\;\;
                    \\in
                    \\;
                    SimplicialSets
            %p
          %h3#nerves_of_inertia_groupoids Nerves of inertia groupoids
          %p
          #EvaluationMapOnNervesOfInertiaGroupoids.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
                on
                %a.existingWikiWord{:href => "/nlab/show/function+complexes"} function complexes
                which are
                %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/inertia+groupoids"} inertia groupoids
              %br/
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              for its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
              version
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi G
                      %mo ⇉
                      %mo *
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G \,\coloneqq\,\big(G \rightrightarrows \ast \big)
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of this groupoid is the canonical model for the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N \mathbf{B}G \,=\, \overline{W}G
                    \\,.
              The
              %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda \mathbf{B}G
                    \\;\coloneqq\;
                    Maps\big(
                    \\mathbf{B}\mathbb{Z}
                    ,\,
                    \\mathbf{B}G
                    \\big)
            %p
              is also known as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/inertia+groupoid"} inertia groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              of this functor groupoid is the following
              %a.existingWikiWord{:href => "/nlab/show/function+complex"} function complex
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              (using Prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#NerveOfCategoriesPreservesMappingObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi Λ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N \Lambda \mathbf{B}G
                    \\;\coloneqq\;
                    Maps\big(
                    N \mathbf{B}\mathbb{Z}
                    ,\,
                    N \mathbf{B}G
                    \\big)
                    \\;\simeq\;
                    Maps\big(
                    S
                    ,\,
                    N \mathbf{B}G
                    \\big)
                    \\,.
            %p Here in the second step we introduced the simplicial set
            #eq:MinimalSimplicialCircle.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\;\coloneqq\;
                    \\Delta[1]/\partial \Delta[1]
                    \\;\;\;
                    \\in
                    \\;
                    sSet
                    \\,,
            %p
              which is the
              %a.existingWikiWord{:href => "/nlab/show/minimal+model"} minimal model
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 1
                    %mo ↠
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\ell \;\coloneqq\; [0,1] \in \Delta[1]_1 \twoheadrightarrow S_1
            %p
              We now describe in detail the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              on the simplicial
              %a.existingWikiWord{:href => "/nlab/show/function+complex"} function complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps\big(
                    S
                    ,\,
                    N \mathbf{B}G
                    \\big)
                    \\,.
            %p To that end, we denote by
            #eq:CellInNerveOfInertiaGroupoid.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi γ
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ⋯
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi N
                    %mi{:mathvariant => "normal"} Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\gamma
                    ;\,
                    g_{n-1}
                    ,\,
                    g_{n-2}
                    ,\,
                    \\cdots
                    ,\,
                    g_{0}
                    \\big)
                    \\;\; \in \;\;
                    \\mathrm{Hom}
                    \\big(
                    S \times \Delta[n]
                    ,\,
                    \\overline{W}G
                    \\big)
                    \\;\simeq\;
                    \\Big(
                    N
                    \\mathrm{Map}
                    \\big(
                    { \mathbf{B}\mathbb{Z} }
                    ,\,
                    { \mathbf{B}G }
                    \\big)
                    \\Big)_{n}
            %p
              the
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/inertia+groupoid"} inertia groupoid
              that corresponds to the sequence of natural transformation which start at the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} Hom
                      %mi{:mathvariant => "normal"} Grp
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma
                    \\,\in\,
                    G
                    \\,\simeq\,
                    \\mathrm{Hom}_{\mathrm{Grp}}(\mathbb{Z}, G)
                    \\,\simeq\,
                    \\mathrm{Hom}\big(
                    \\mathbf{B}\mathbb{Z}
                    ,\,
                    \\mathbf{B}G
                    \\big)
            %p
              and successively have components
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %mi n
                          %mo −
                          %mo •
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g_{n-\bullet} \in G
            %blockquote
              %p
                Throughout we are writing “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Hom
                    %annotation{:encoding => "application/x-tex"} Hom
                ” for
                %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                and “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Map
                    %annotation{:encoding => "application/x-tex"} Map
                ” for
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
                and we keep tacitly going back and forth through the
                %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
                in
                = succeed "." do
