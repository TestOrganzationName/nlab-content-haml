                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X \stackrel{\simeq_{qi}}{\to} X^\bullet
              is equivalently an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi X
                    %mo ↪
                    %msup
                      %mi X
                      %mn 0
                    %mo →
                    %msup
                      %mi X
