                of chain complexes.
          .proof
            %h6#proof_4 Proof
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mo •
                    %annotation{:encoding => "application/x-tex"} h_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mo •
                  %annotation{:encoding => "application/x-tex"} g_\bullet
              such as to obtain a short exact sequence of chain complexes, hence degreewise a short exact sequence, in the two row.
            %p
              To construct this, let for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo ≔
                    %msub
                      %mi A
                      %mi n
                    %mo ⊕
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    B_n \coloneqq A_n \oplus C_n
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              and let the top horizontal morphisms be the canonical inclusion and projection maps of the direct sum.
            %p
              Then let (in
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              notation)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi g
                                %mn 0
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi A
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi g
                                %mn 0
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi B
                      %mo )
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    g_0 =
                    \\left(
                    \\array{
                    (g_0)_A
                    \&amp;
                    (g_0)_B
                    }
                    \\right)
                    \: A_0 \oplus C_0 \to B
            %p be given in the first component by the given composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi A
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %mi A
                    %mover
                      %mo ↪
                      %mi i
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (g_0)_A : A_0 \oplus C_0 \stackrel{}{\to} A_0 \stackrel{f_0}{\to} A \stackrel{i}{\hookrightarrow} B
            %p and in the second component we take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi C
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                    %mover
                      %mo →
                      %mi ζ
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (g_0)_C : A_0 \oplus C_0 \to C_0 \stackrel{\zeta}{\to} B
            %p to be given by a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ζ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi h
                                  %mn 0
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp; {}^{\mathllap{\zeta}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                    \\\
                    C_0 &amp;\stackrel{h_0}{\to}&amp; C
                    }
                    \\,,
            %p
              which exists by the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              of the
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is a projective resolution) against the
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : B \to C
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            %p In total this gives, in degree 0,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                          %mtd
                            %mo ↪
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                            %mo ⊕
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi g
                                    %mn 0
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi A
                                  %mo ,
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi g
                                    %mn 0
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi C
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↙
                              %mi ζ
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi h
                                    %mn 0
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ↪
                              %mi i
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_0 &amp;\hookrightarrow&amp; A_0 \oplus C_0 &amp;\to&amp; C_0
                    \\\
                    {}^{\mathllap{f_0}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{((g_0)_A, (g_0)_C)}}\downarrow &amp;\swarrow_{\zeta}&amp; \downarrow^{\mathrlap{h_0}}
                    \\\
                    A &amp;\stackrel{i}{\hookrightarrow}&amp; B &amp;\stackrel{p}{\to}&amp; C
                    }
                    \\,.
            %p
              Then let the
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} B_\bullet
              be given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi k
                      %mrow
                        %msub
                          %mi B
                          %mo •
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi d
                                %mi k
                                %mrow
                                  %msub
                                    %mi A
                                    %mo •
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi k
                              %msub
                                %mi e
                                %mi k
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msubsup
                                %mi d
                                %mi k
                                %mrow
                                  %msub
                                    %mi C
                                    %mo •
                      %mo )
                    %mo :
                    %msub
                      %mi A
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ⊕
                    %msub
                      %mi C
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi A
                      %mi k
                    %mo ⊕
                    %msub
                      %mi C
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    d_k^{B_\bullet}
                    \=
                    \\left(
                    \\array{
                    d_k^{A_\bullet} &amp; (-1)^k e_k
                    \\\
                    0 &amp; d_k^{C_\bullet}
                    }
                    \\right)
                    \:
                    A_{k+1} \oplus C_{k+1}
                    \\to
                    A_k \oplus C_k
                    \\,,
            %p
              where the
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi e
                        %mi k
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{e_k\}
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              as follows. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0
              be a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi e
                                    %mn 0
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                        %mtr
                          %mtd
                            %mi ζ
                            %mo ∘
                            %msubsup
                              %mi d
                              %mn 0
                              %mrow
                                %msub
                                  %mi C
                                  %mo •
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi C
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi A
                          %mtd
                            %mo ↪
                            %mi B
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp;&amp; A_0
                    \\\
                    \&amp; &amp; {}^{\mathllap{e_0}}\nearrow &amp; \downarrow^{\mathrlap{f_0}}
                    \\\
                    \\zeta \circ d^{C_\bullet}_0 \colon &amp; C_1 &amp;\stackrel{}{\to}&amp; A &amp;\hookrightarrow B&amp;
                    }
            %p
              which exists since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C_1
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A_0 \to A
              is an epimorphism by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet
              being a projective resolution. Here we are using that, by exactness, the bottom morphism indeed factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as indicated, because the definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              and the chain complex property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                            %mo ∘
                            %mi ζ
                            %mo ∘
                            %msubsup
                              %mi d
                              %mn 0
                              %mrow
                                %msub
                                  %mi C
                                  %mo •
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mn 0
                            %mo ∘
                            %msubsup
                              %mi d
                              %mn 0
                              %mrow
                                %msub
                                  %mi C
                                  %mo •
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                            %mo ∘
                            %msub
                              %mi h
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p \circ \zeta \circ d^{C_\bullet}_0
                    \&amp;=
                    h_0 \circ d^{C_\bullet}_0
                    \\\
                    \&amp; = 0 \circ h_1
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
            %p
              Now, in the induction step, assuming that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} e_{n-1}
              has been been found satisfying the chain complex property, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi n
                  %annotation{:encoding => "application/x-tex"} e_n
              be a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi e
                                    %mi n
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi d
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                                    %mrow
                                      %msub
                                        %mi A
                                        %mo •
                        %mtr
                          %mtd
                            %msub
                              %mi e
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi n
                              %mrow
                                %msub
                                  %mi C
                                  %mo •
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi d
                              %mrow
                                %mi n
                                %mo −
                                %mn 2
                              %mrow
                                %msub
                                  %mi A
                                  %mo •
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi d
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                              %mrow
                                %msub
                                  %mi A
                                  %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp;&amp; A_n
                    \\\
                    \&amp; &amp; {}^{\mathllap{e_{n}}}\nearrow &amp; \downarrow^{\mathrlap{d^{A_\bullet}_{n-1}}}
                    \\\
                    e_{n-1}\circ d_n^{C_\bullet} \colon &amp; C_{n+1} &amp;\stackrel{}{\hookrightarrow}&amp; ker(d^{A_\bullet}_{n-2}) = im(d^{A_\bullet}_{n-1})) &amp;\to&amp; A_{n-1}
                    }
                    \\,,
            %p
              which again exists since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} C_{n+1}
              is projective. That the bottom morphism factors as indicated is the chain complex property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} e_{n-1}
              inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi d
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mrow
                          %msub
                            %mi B
                            %mo •
                    %annotation{:encoding => "application/x-tex"} d^{B_\bullet}_{n-1}
            %p
              To see that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mrow
                        %msub
                          %mi B
                          %mo •
                  %annotation{:encoding => "application/x-tex"} d^{B_\bullet}
              defined this way does indeed square to 0, notice that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi n
                      %mrow
                        %msub
                          %mi B
                          %mo •
                    %mo ∘
                    %msubsup
                      %mi d
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mrow
                        %msub
                          %mi B
                          %mo •
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
