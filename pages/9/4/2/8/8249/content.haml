            %ul
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ∈
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} N \in \mathcal{A}
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi n
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∀
                        %mi n
                        %mo ≥
                        %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        L_n F(N) = 0 \;\;\;\; \forall n \geq 1
                        \\,.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ∈
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} N \in \mathcal{A}
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mi n
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
