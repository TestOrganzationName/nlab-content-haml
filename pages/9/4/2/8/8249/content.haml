                    %mi 𝒜
                    %mo ,
                    %mi 𝒜
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}, \mathcal{A}'
              be two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo =
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} = R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ′
                    %mo =
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}' = R'
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
