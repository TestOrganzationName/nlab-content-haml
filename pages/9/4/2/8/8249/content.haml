                    %msup
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(X) \hookrightarrow F(X^0) \to F(X^1) \to \cdots
            %p is an exact sequence. But this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
