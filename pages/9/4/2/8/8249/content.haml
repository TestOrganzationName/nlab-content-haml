                    %mo →
                    %mi ⋯
                    %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X \hookrightarrow X^0 \to X^1 \to \cdots.
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is left exact, then it preserves this exact sequence by the definition of left exactness, and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
