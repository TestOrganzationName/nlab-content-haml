                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}_\bullet(\mathcal{A}')
              and generally does not factor through the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒟
                        %mo •
