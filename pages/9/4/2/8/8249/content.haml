                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi h
                                    %mo •
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi i
