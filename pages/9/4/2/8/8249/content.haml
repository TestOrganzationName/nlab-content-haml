                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            embeds into its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective
            %a.existingWikiWord{:href => "/nlab/show/cochain+complexes"} cochain complexes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi 𝒜
                  %mo →
