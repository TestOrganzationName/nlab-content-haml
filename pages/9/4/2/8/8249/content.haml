                  %annotation{:encoding => "application/x-tex"} B
              and the definition of an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(A) \simeq 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(B) \simeq 0
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 0
                    %mo →
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to 0 \to R^n F(C) \to 0
            %p
              which imply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(C)\simeq 0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is acyclic.
            %p
              Similarly, the third condition is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi R
                        %mn 1
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} R^1 F(A) \simeq 0
          #FAcyclicResolution.num_example
            %h6#example_2 Example
            %p
              The
              = succeed "-projective/injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed ")" do
                %a.maruku-ref{:href => "#FProjectivesResolution"}
              %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
              as in example
              %a.maruku-ref{:href => "#FAcyclicObjectsAreFProjectiveObjects"}
              are called
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  \-acyclic resolutions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} enough injectives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A} \to \mathcal{B}
            be an
            %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
            %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
            with
            %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo •
                    %mi F
                  %annotation{:encoding => "application/x-tex"} R_\bullet F
            = succeed "." do
              %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                  %mo ⊂
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{I} \subset \mathcal{A}
            be a subcategory of
            = succeed "-injective" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %a.maruku-ref{:href => "#FInjectives"}
          #FPreservesNullnessOfFInjectiveComplexes.num_lemma
            %h6#lemma_3 Lemma
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℐ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^\bullet \in Ch^\bullet(\mathcal{I}) \subset Ch^\bullet(\mathcal{A})
              is
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              to 0,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X^\bullet \stackrel{\simeq_{qi}}{\to} 0,
            %p
              then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X^\bullet) \in Ch^\bullet(\mathcal{B})
              is quasi-isomorphic to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(X^\bullet) \stackrel{\simeq_{qi}}{\to} 0
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Consider the following collection of
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              obtained from the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X^\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi X
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 0
                    %msup
                      %mi X
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 1
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X^0 \stackrel{d^0}{\to} X^1 \stackrel{d^1}{\to} im(d^1) \to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 2
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to im(d^1) \to X^2 \stackrel{d^2}{\to} im(d^2) \to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mn 3
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 3
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to im(d^2) \to X^3 \stackrel{d^3}{\to} im(d^3) \to 0
            %p
              and so on. Going by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              through this list and using the second condition in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FInjectives"}
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi d
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(d^n)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}
              %a.maruku-ref{:href => "#FInjectives"}
              says that all the sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(im(d^n)) \to F(X^n+1) \to F(im(d^{n+1})) \to 0
            %p
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} exact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(X^0)\to F(X^1) \to F(X^2) \to \cdots
            %p
              is exact, and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X^\bullet)
              is quasi-isomorphic to 0.
          #DerivedFFromFInjectiveResolution.num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
              an object with
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %msubsup
                        %mi I
                        %mi F
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A \stackrel{\simeq_{qi}}{\to} I_F^\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#FProjectivesResolution"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    R^n F(A) \simeq H^n(F(I_F^\bullet))
            %p
              between the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              evaluated on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              applied to the
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi I
                        %mi F
                        %mo •
                    %annotation{:encoding => "application/x-tex"} I_F^\bullet
          .proof
            %h6#proof_9 Proof
            %p
              By
              = succeed "," do
                %a{:href => "https://ncatlab.org/schreiber/show/Introduction+to+Homological+algebra#ExistenceOfInjectiveResolutions"} this prop.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %msup
                        %mi I
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A \stackrel{\simeq_{qi}}{\to} I^\bullet
              = succeed "," do
                %a{:href => "https://ncatlab.org/schreiber/show/Introduction+to+Homological+algebra#InjectiveResolutionOfCodomainRespectsMorphisms"} this prop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo →
                    %msup
                      %mi I
                      %mo •
                  %annotation{:encoding => "application/x-tex"} I^\bullet_F \to I^\bullet
              such that the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ≃
                                  %mi qi
                          %mtd
                            %msubsup
                              %mi I
                              %mi F
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ≃
                                  %mi qi
                          %mtd
                            %msup
                              %mi I
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{\simeq_{qi}}{\to}&amp; I_F^\bullet
                    \\\
                    \\downarrow^{\mathrlap{id}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    A &amp;\stackrel{\simeq_{qi}}{\to}&amp; I^\bullet
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutes
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ch
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch^\bullet(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              property of
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a quasi-isomorphism.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(f) \in Ch^\bullet(\mathcal{A})
              be the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo •
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I^\bullet \to Cone(f)
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              into it. By the explicit formulas for mapping cones, we have that
            %ol
              %li
                %p
                  there is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F(Cone(f)) \simeq Cone(F(f))
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi ℐ
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cone(f) \in Ch^\bullet(\mathcal{I})\subset Ch^\bullet(\mathcal{A})
                  (because
                  = succeed "-injective" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            %p
              The first implies that we have a
              %a.existingWikiWord{:href => "/nlab/show/homology+exact+sequence"} homology exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to H^n(I^\bullet) \to H^n(I_F^\bullet) \to H^n(Cone(f)^\bullet)
                    \\to H^{n+1}(I^\bullet) \to H^{n+1}(I_F^\bullet) \to H^{n+1}(Cone(f)^\bullet) \to \cdots
                    \\,.
            %p
              Observe that, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f^\bullet
              a quasi-isomorphism,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(f^\bullet)
              is quasi-isomorphic to 0. Therefore, the second item above implies (with lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#FPreservesNullnessOfFInjectiveComplexes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(Cone(f))
              is quasi-isomorphic to 0. This finally means that the above homology exact sequence consists of exact pieces of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to (R^n F(A)\coloneqq H^n(I^\bullet) \stackrel{\simeq}{\to} H^n(I_F^\bullet) \to 0
                    \\,.
          %h3#derived_adjoint_functors Derived adjoint functors
          .num_note
            %h6#observation Observation
            %p If
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒜
                    %mover
                      %munder
                        %mo →
                        %mi F
                      %mover
                        %mo ←
                        %mi G
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G) : \mathcal{A}
                    \\stackrel{\overset{G}{\leftarrow}}{\underset{F}{\to}}
                    \\mathcal{B}
            %p
              is a pair of
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
          %p (…)
          %h3#preservation_of_further_limits_and_colimits Preservation of further limits and colimits
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒜
                    %mo →
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A} \to \mathcal{B}
              be an
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              with codomain an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/additive+and+abelian+categories"} AB5-category
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functors"} left derived functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi n
                    %mi F
                  %annotation{:encoding => "application/x-tex"} L_n F
              preserve
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
              precisely if filtered colimits of
              %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
          %p
            See
            = succeed "." do
              %a{:href => "http://mathoverflow.net/questions/97658/left-derived-functors-commute-with-filtered-colimits"} here
