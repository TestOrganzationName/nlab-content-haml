          #ProlongationOfFunctorToChainComplexes.num_defn
            %h6#definition_3 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi 𝒜
                      %mo →
                      %mi 𝒜
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F : \mathcal{A} \to \mathcal{A}'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ch_\bullet(F) \colon Ch_\bullet(\mathcal{A}) \to Ch_\bullet(\mathcal{A}')
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/categories+of+chain+complexes"} categories of chain complexes
              (its “prolongation”) by applying it to each
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              and to all the diagrams in the definition of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopies"} chain homotopies
              and hence it passes to the quotient given by the strong
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{K}(F) \colon \mathcal{K}(\mathcal{A}) \to \mathcal{K}(\mathcal{A}')
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}'
              have
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}_\bullet(\mathcal{A})
                    \\simeq
                    \\mathcal{K}_\bullet(\mathcal{P}_{\mathcal{A}})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℐ
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}^\bullet(\mathcal{A}) \simeq \mathcal{K}^\bullet(\mathcal{I}_{\mathcal{A}})
            %p
              etc. Accordingly, one wants to
              %em derive
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_\bullet(\mathcal{A}) \to \mathcal{D}_\bullet(\mathcal{A}')
              between these derived categories. It is immediate to achieve this on the domain category, since there we can simply precompose and form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo →
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi 𝒦
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\to
                    \\mathcal{D}_\bullet(\mathcal{A})
                    \\simeq
                    \\mathcal{K}_\bullet(\mathcal{P}_{\mathcal{A}})
                    \\hookrightarrow
