                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R^0 F(X) \coloneqq ker(F(X^0) \to F(X^1)) \simeq F(X)
                    \\,.
          %p The following immediate consequence of the definition is worth recording:
          #LeftDerivedFunctorOnProjectiveVanishes.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be an
