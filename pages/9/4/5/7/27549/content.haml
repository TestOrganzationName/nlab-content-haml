          %h2#idea Idea
          %p
            A
            %em quadratic Gauss sum
            is a sum of square-powers of primitive
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/roots+of+unity"} roots of unity
          #eq:BasicQuadraticGaussSum.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi s
                      %mo =
                      %mn 0
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                  %msup
                    %mi e
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mn 2
                            %mi π
                            %mi{:mathvariant => "normal"} i
                          %mi k
                      %msup
                        %mi s
                        %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext for
                  %mspace{:width => "thickmathspace"}
                  %mi k
                  %mo ∈
                  %msub
                    %mi ℕ
                    %mrow
                      %mi &gt;
                      %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{s = 0}^{k-1}
                  e^{
                  \\tfrac{2 \pi \mathrm{i}}{k}
                  s^2
                  }
                  \\;\;
                  \\in
                  \\;
                  \\mathbb{C}
                  \\,,
                  \\;\;\;\;\;\;
                  \\text{for} \; k \in \mathbb{N}_{&gt; 0}
                  \\,.
          %p
            A
            %em generalized Gauss sum
            is a variant of this expression, admitting other prefectors or powers of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            in the exponent.
