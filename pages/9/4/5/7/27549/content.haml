          %p
          #EvaluationOfQuadraticGaussSum.num_prop
            %h6 Proposition
            %p
              %strong (evaluation of the quadratic Gauss sum)
              %br/
              The basic quadratic Gauss sum
              %a.maruku-eqref{:href => "#eq:BasicQuadraticGaussSum"} (1)
              evaluates to:
            #eq:EvaluationFormulaOfQuadraticGaussSum.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo =
                        %mn 0
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mi k
                        %msup
                          %mi s
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mo{:stretchy => "false"} )
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 0
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} i
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 3
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{s = 0}^{k-1}
                    e^{
                    \\tfrac{2 \pi \mathrm{i}}{k}
                    s^2
                    }
                    \\;\;
                    \=
                    \\;\;
                    \\left\{
                    \\begin{array}{ccl}
                    (1 + \mathrm{i}) \sqrt{k} &amp;\vert&amp; k = 0 \;mod\; 4
                    \\\
                    \\sqrt{k} &amp;\vert&amp; k = 1 \;mod\; 4
                    \\\
                    0 &amp;\vert&amp; k = 2 \;mod\; 4
                    \\\
                    \\mathrm{i} \sqrt{k} &amp;\vert&amp; k = 3 \;mod\; 4
                    \\mathrlap{\,.}
                    \\end{array}
                    \\right.
            %p
          The original proof is due to
          = succeed "," do
            %a{:href => "#Gauss1811"} Gauss 1811
          = succeed "," do
            %a{:href => "#Dirichlet35"} Dirichlet 1835
          = succeed "." do
            %a{:href => "#Dirichlet1871"} Dirichlet 1871
          = succeed "," do
            %a{:href => "#Lang70"} Lang 1970 p 87
          = succeed "," do
            %a{:href => "#BerndtEvans81"} Berndt &amp; Evans 1981
          = succeed "," do
            %a{:href => "#Doyle16"} Doyle 2016 (1.1)
          = succeed "," do
            %a{:href => "#MurtyPathak17"} Ram Murty &amp; Pathak 2017 Thm. 1.1
          = succeed "." do
            %a{:href => "#Taylor22"} Taylor 2022 Thm. 1.16
          %p
            For odd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            we have more generally:
          %p
          #EvaluationOfQuadraticGaussSumWithFactor.num_prop
            %h6 Proposition
            %p
              %strong (evaluation of the quadratic Gauss sum with multiple exponents)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mn 2
                    %mi ℕ
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \in 2\mathbb{N} + 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}
              we have
            #eq:EvaluationFormulaOfQuadraticGaussSum.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo =
                        %mn 0
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mi k
                        %mi q
                        %msup
                          %mi s
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} |
                    %mi k
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo =
                        %mn 0
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mi k
                        %msup
                          %mi s
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mo{:stretchy => "false"} )
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 0
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} |
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %mphantom
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi q
                                %mo{:stretchy => "false"} |
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} |
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi{:mathvariant => "normal"} i
                            %msqrt
                              %mi k
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi k
                            %mo =
                            %mn 3
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mn 4
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{s = 0}^{k-1}
                    e^{
                    \\tfrac{2 \pi \mathrm{i}}{k}
                    q
                    s^2
                    }
                    \\;\;=\;\;
                    (q \vert k)
                    \\sum_{s = 0}^{k-1}
                    e^{
                    \\tfrac{2 \pi \mathrm{i}}{k}
                    s^2
                    }
                    \\;\;
                    \=
                    \\;\;
                    \\left\{
                    \\begin{array}{lcl}
                    
                    \\,
                    (1 + \mathrm{i}) \sqrt{k} &amp;\vert&amp; k = 0 \;mod\; 4
                    \\\
                    (q \vert k)
                    \\,
                    \\sqrt{k} &amp;\vert&amp; k = 1 \;mod\; 4
                    \\\
                    \\phantom{(q \vert k)}
                    \\;
                    0 &amp;\vert&amp; k = 2 \;mod\; 4
                    \\\
                    (q \vert k)
                    \\,
                    \\mathrm{i} \sqrt{k} &amp;\vert&amp; k = 3 \;mod\; 4
                    \\mathrlap{\,,}
                    \\end{array}
                    \\right.
            %p
              where “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a \vert b)
              ” is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+symbol"} Jacobi symbol
          (
          %a{:href => "#Lang70"}> Lang 1970 “QS 4” (p 86)
          , cf. also
          %a{:href => "#Doyle16"} Doyle 2016 (1.1)
          but beware of typos there)
          %h3#PropertiesOfQuadraticGaussSumWithHalvedExponents Qudratic Gauss sum with halved exponents
          %p
          #EvaluationOfQuadraticGaussSumWithHalvedExponents.num_prop
            %h6 Proposition
            %p
              %strong (evaluation of quadratic Gauss sum with halved exponents)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mn 2
                    %msub
                      %mi ℕ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} k \in 2 \mathbb{N}_{\gt 0}
              the quadratic Gauss sum with halved exponents evaluates to:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mi k
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo =
                        %mn 0
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mi k
                        %msup
                          %mi s
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mi π
                        %mi{:mathvariant => "normal"} i
                        %mo{:stretchy => "false"} /
                        %mn 4
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{1}{\sqrt{k}}
                    \\sum_{s = 0}^{k-1}
                    e^{
                    \\tfrac{\pi \mathrm{i}}{k}
                    s^2
                    }
                    \\;\;
                    \=
                    \\;\;
                    e^{\pi \mathrm{i}/4}
            %p
          The following proofs are given in
          %a{:href => "https://math.stackexchange.com/a/4232289/58526"} MO:a/4232289
          (using Prop.
          = succeed ")," do
            %a.maruku-ref{:href => "#EvaluationOfQuadraticGaussSum"}
          %a{:href => "https://mathoverflow.net/a/489863/381"} MO:a/489863
          (using Prop.
          = succeed ")," do
            %a.maruku-ref{:href => "#ReciprocityForQuadraticGaussSumWithHalvedExponents"}
          %a{:href => "https://mathoverflow.net/a/489956/381"} MO:a/489956
          (using Prop.
          = succeed ")." do
            %a.maruku-ref{:href => "#TheLandsbergSchaarIdentity"}
          .proof
            %h6 Proof
            %p
              Using the ordinary quadratic Gauss evaluation (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvaluationOfQuadraticGaussSum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≔
                    %mi k
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    r \coloneqq k/2 \,\in\, \mathbb{N}
              and compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 0
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                  %mi k
                              %msup
                                %mi s
                                %mn 2
                        %mtd
                          %mo ≡
                        %mtd
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 0
                            %mrow
                              %mn 2
                              %mi r
                              %mo −
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mn 2
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                  %mrow
                                    %mn 4
                                    %mi r
                              %msup
                                %mi s
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 0
                            %mrow
                              %mn 2
                              %mi r
                              %mo −
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %mo +
                          %mspace{:width => "thinmathspace"}
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 2
                              %mi r
                            %mrow
                              %mn 4
                              %mi r
                              %mo −
                              %mn 1
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mn 2
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                  %mrow
                                    %mn 4
                                    %mi r
                              %msup
                                %mi s
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 0
                            %mrow
                              %mn 4
                              %mi r
                              %mo −
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mn 2
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                  %mrow
                                    %mn 4
                                    %mi r
                              %msup
                                %mi s
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo +
                          %mi{:mathvariant => "normal"} i
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msqrt
                            %mrow
                              %mn 4
                              %mi r
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} /
                              %mn 4
                          %mspace{:width => "thinmathspace"}
                          %msqrt
                            %mrow
                              %mn 2
                              %mi r
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} /
                              %mn 4
                          %mspace{:width => "thinmathspace"}
                          %msqrt
                            %mi k
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    \\sum_{s=0}^{k-1}
                    \\,
                    e^{
                    \\tfrac
                    { \pi \mathrm{i}}
                    { k }
                    s^2
                    }
                    \&amp;\equiv&amp;
                    \\sum_{s=0}^{2r-1}
                    \\,
                    e^{
                    \\tfrac
                    {2 \pi \mathrm{i}}
                    { 4r }
                    s^2
                    }
                    \\\
                    \&amp;=&amp;
                    \\tfrac{1}{2}
                    \\Big(
                    \\sum_{s=0}^{2r-1}
                    \\,+\,
                    \\sum_{s=2r}^{4r-1}
                    \\Big)
                    \\,
                    e^{
                    \\tfrac
                    {2 \pi \mathrm{i}}
                    { 4r }
                    s^2
                    }
                    \\\
                    \&amp;=&amp;
                    \\tfrac{1}{2}
                    \\sum_{s=0}^{4r-1}
                    \\,
                    e^{
                    \\tfrac
                    {2 \pi \mathrm{i}}
                    { 4r }
                    s^2
                    }
                    \\\
                    \&amp;=&amp;
                    \\tfrac{1}{2}
                    (1 + \mathrm{i}) \, \sqrt{4r}
                    \\\
                    \&amp;=&amp;
                    e^{\pi \mathrm{i}/4} \, \sqrt{2r}
                    \\\
                    \&amp;=&amp;
                    e^{\pi \mathrm{i}/4} \, \sqrt{k}
                    \\,,
                    \\end{array}
            %p where the steps are, in order of appearance:
            %ol
              %li
                %p
                  definition of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi r
                        %annotation{:encoding => "application/x-tex"} r
              %li
                %p
                  observing that the summands are
                  = succeed "-periodic," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi r
                        %annotation{:encoding => "application/x-tex"} 2r
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi π
                                  %mi{:mathvariant => "normal"} i
                                %mrow
                                  %mn 2
                                  %mi r
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 2
                            %mi r
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi π
                                  %mi{:mathvariant => "normal"} i
                                %mrow
                                  %mn 2
                                  %mi r
                            %msup
                              %mi n
                              %mn 2
                        %msup
                          %mi e
                          %mrow
                            %mn 2
                            %mi π
                            %mi{:mathvariant => "normal"} i
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mi r
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi e
                          %mrow
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi π
                                  %mi{:mathvariant => "normal"} i
                                %mrow
                                  %mn 2
                                  %mi r
                            %msup
                              %mi n
                              %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        e^{
                        \\tfrac{\pi \mathrm{i}}{2r}
                        (n + 2r)^2
                        }
                        \\;=\;
                        e^{
                        \\tfrac{\pi \mathrm{i}}{2r}
                        n^2
                        }
                        e^{
                        2\pi \mathrm{i}
                        ( n + r )
                        }
                        \\;=\;
                        e^{
                        \\tfrac{\pi \mathrm{i}}{2r}
                        n^2
                        }
                        \\,,
              %li
                %p collecting summands,
              %li
                %p
                  the classical evaluation formula
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:EvaluationFormulaOfQuadraticGaussSum"} (3)
              %li
                %p rearranging factors,
              %li
                %p
                  definition of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi r
                        %annotation{:encoding => "application/x-tex"} r
            %p
              Alternatively, using reciprocity laws like the Landsberg-Schaar identity
              = succeed ":" do
                %a{:href => "#LandsbergSchaarIdentity"} below
            %p
              The statement is the immediate special case of Prop.
              %a.maruku-ref{:href => "#TheLandsbergSchaarIdentity"}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≡
                    %mi r
                    %mo ≔
                    %mi k
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} q \equiv r \coloneqq k/2
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ≡
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p \equiv 1
            %p
              Similarly, from Prop.
              %a.maruku-ref{:href => "#ReciprocityForQuadraticGaussSumWithHalvedExponents"}
              we immediately get:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %msqrt
                                %mi k
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi s
                              %mo =
                              %mn 0
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %msup
                            %mi e
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                  %mi k
                              %msup
                                %mi s
                                %mn 2
                        %mtd
                          %mo ≡
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo ,
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} /
                              %mn 4
                          %mspace{:width => "thinmathspace"}
                          %mover
                            %mrow
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 0
                              %mo ,
                              %mi k
                              %mo{:stretchy => "false"} )
                            %mo ¯
                      %mtr
                        %mtd
                        %mtd
                          %mo ≡
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} /
                              %mn 4
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    \\tfrac{1}{\sqrt{k}}
                    \\sum_{s = 0}^{k-1}
                    e^{
                    \\tfrac{\pi \mathrm{i}}{k}
                    s^2
                    }
                    \&amp;\equiv&amp;
                    G(k,0,1)
                    \\\
                    \&amp;=&amp;
                    e^{ \pi \mathrm{i}/4 }
                    \\,
                    \\overline{G(1,0,k)}
                    \\\
                    \&amp;\equiv&amp;
                    e^{ \pi \mathrm{i}/4 }
                    \\mathrlap{\,.}
                    \\end{array}
            %p
          %h3#LandsbergSchaarIdentity Landsberg-Schaar identity
          %p The ordinary Gauss sums and those with halved exponents are related by:
          %p
          #TheLandsbergSchaarIdentity.num_prop
            %h6 Proposition
            %p
              %strong (Landsberg-Schaar identity)
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} p, q \in \mathbb{N}_{\gt 0}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mi p
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mn 2
                        %mi π
                        %mi{:mathvariant => "normal"} i
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi q
                            %mi p
                        %msup
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %msup
                            %mi e
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} /
                              %mn 4
                        %msqrt
                          %mrow
                            %mn 2
                            %mi q
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mrow
                        %mn 2
                        %mi q
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi π
                        %mi{:mathvariant => "normal"} i
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi p
                            %mrow
                              %mn 2
                              %mi q
                        %msup
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{1}{\sqrt{p}}
                    \\sum_{n = 0}^{p-1}
                    \\,
                    e^{
                    2 \pi \mathrm{i}
                    \\tfrac{q}{p}n^2
                    }
                    \\;\;=\;\;
                    \\tfrac
                    { e^{\pi \mathrm{i}/4} }
                    { \sqrt{2q} }
                    \\sum_{n = 0}^{2q - 1}
                    \\,
                    e^{
                    \-\pi \mathrm{i}
                    \\tfrac{p}{2q} n^2
                    }
                    \\,.
            %p
          (
          %a{:href => "#Schaar1850"}> Schaar 1850
          ,
          = succeed "," do
            %a{:href => "#DymMcKean72"} Dym &amp; McKean 1972 §4.6
          = succeed "," do
            %a{:href => "#ArmitageRogers2000"} Armitage &amp; Rogers 2000
          = succeed ")" do
            %a{:href => "#Ustinov22"} Ustinov 2022
          %p Yet more generally:
          %p
          #ReciprocityForQuadraticGaussSumWithHalvedExponents.num_prop
            %h6 Proposition
            %p
              %strong (reciprocity for generalized quadratic Gauss sum with halved exponents)
              %br/
              The expressions
            #eq:QuadraticGaussSumWithHalvedExponents.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mi c
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mrow
                        %mi c
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mi c
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi a
                        %msup
                          %mi n
                          %mn 2
                        %mo +
                        %mn 2
                        %mi b
                        %mi n
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mo ,
                    %mi c
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo &gt;
                        %mn 0
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %mo ∈
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi a
                    %mi c
                    %mo ∈
                    %mn 2
                    %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G(a,b,c)
                    \\;\coloneqq\;
                    \\tfrac{1}{\sqrt{c}}
                    \\sum_{n=0}^{c-1}
                    \\,
                    e^{
                    \\tfrac{\pi \mathrm{i}}{c}
                    \\big(
                    a n^2
                    +
                    2 b n
                    \\big)
                    }
                    \\,,
                    \\;\;\;\text{for}\;\;
                    a, c \in \mathbb{N}_{\gt 0}
                    ,\,
                    b \in \mathbb{Z}
                    ,\,
                    a c \in 2 \mathbb{N}
                    \\,.
            %p satisfy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mi π
                              %mi{:mathvariant => "normal"} i
                            %mn 4
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msup
                                %mi b
                                %mn 2
                            %mrow
                              %mi a
                              %mi c
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi b
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    G(a,b,c)
                    \\;=\;
                    e^{
                    \\big(
                    \\tfrac{\pi \mathrm{i}}{4}
                    \-
                    \\tfrac{b^2}{a c}
                    \\big)
                    }
                    \\;
                    \\overline{G(c,b,a)}
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}
              denotes
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
          This is proven by
          = succeed "." do
            %a{:href => "#Harcos"} Harcos
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/quadratic+reciprocity"} quadratic reciprocity
          %h2#references References
          %p
            The original proof of Prop.
            %a.maruku-ref{:href => "#EvaluationOfQuadraticGaussSum"}
            is due to
