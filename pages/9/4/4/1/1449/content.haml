          %h2#idea Idea
          %p
            The notion of
            %em power object
            generalizes the notion of
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            to an arbitrary category with
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finite limits
            %strong power object
            of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            is
          %ul
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \Omega^c
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∈
                        %mi c
                      %mo ↪
                      %mi c
                      %mo ×
                      %msup
                        %mi Ω
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \in_c \hookrightarrow c \times \Omega^c
          %p such that
          %ul
            %li
              for every other object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              and every
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ↪
                    %mi c
                    %mo ×
                    %mi d
                  %annotation{:encoding => "application/x-tex"} r \hookrightarrow c \times d
              there is a unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi r
                    %mo :
                    %mi d
                    %mo →
                    %msup
                      %mi Ω
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \chi_r : d \to \Omega^c
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi r
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mo ∈
                            %mi c
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi c
                          %mo ×
                          %mi d
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi Id
                                %mi c
                              %mo ×
                              %msub
                                %mi χ
                                %mi r
                        %mtd
                          %mi c
                          %mo ×
                          %msup
                            %mi Ω
                            %mi c
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  r &amp;\to&amp; \in_c
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  c \times d
                  \&amp;\stackrel{Id_c \times \chi_r}{\to}&amp;
                  c \times \Omega^c
                  }
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            may lack some finite limits, then we may weaken that condition as follows:
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has all
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                (but may lack products), then equip each of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∈
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \in_c
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                with a jointly monic pair of morphisms, one to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                and one to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \Omega^c
                or
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                must then be the joint pullback
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
