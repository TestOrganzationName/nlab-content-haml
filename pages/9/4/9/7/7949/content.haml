                          %mo ≃
                          %mi y
                        %annotation{:encoding => "application/x-tex"} f(x) \simeq y
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi im
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} im_2(f)
                  is the groupoid whose objecs are those of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and whose morphisms are equivalence classes of morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha,\beta \in Mor(X)
                  are equivalent if they have the same domain and codomain in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(\alpha) = f(\beta)
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi im
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msub
                              %mi im
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} im_2(f)\to im_1(f)
                      is the identity on objects and the canonical inclusion on sets of morphisms;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo →
                            %msub
                              %mi im
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} X \to im_2(f)
                      is the identity on objects and the defining
                      %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                      map on sets of morphisms.
          .proof
            %h6#proof_3 Proof
            %p
              Evidently
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} im_1(f) \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              (
              %a.existingWikiWord{:href => "/nlab/show/isofibration"}> isofibration
              ) and so the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              over every point is given by the 1-categorical
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mi y
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi im
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi y
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F_y &amp;\to&amp; im_1(y)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\stackrel{y}{\to}&amp; Y
                    }
                    \\,.
            %p
              If there is no
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f(x) \simeq y
              then fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi y
                  %annotation{:encoding => "application/x-tex"} F_y
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              then the fiber is the groupoid with that one object and all morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              on that object which are mapped to the identity morphism, which by construction is only the identity morphism itself, hence the fiber is the point. Hence indeed the homotopy fibers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} im_1(f) \to Y
              are
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated"} (-1)-truncated
              objects and the map from homotopy fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im_1(f)
              is their (-1)-truncation.
            %p
              Next, the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} im_2(f) \to Y
              over a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              are the groupoids whose objects are pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, (f(x) \to y))
              and whose morphisms are pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 1
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi α
                                  %mo{:stretchy => "false"} ]
                            %mtd
                              %msub
                                %mi x
                                %mn 2
                          %mtr
                            %mtd
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi y
                            %mtd
                              %mo =
                            %mtd
                              %mi y
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    x_1 &amp;\stackrel{[\alpha]}{\to}&amp; x_2
                    \\\
                    f(x_1) &amp;\stackrel{f(\alpha)}{\to}&amp; f(x_2)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    y &amp;=&amp; y
                    }
                    \\right)
                    \\,.
            %p
              Notice first that the above is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,(f(x) \to y))
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mover
                      %mi to
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi α
                        %mo{:stretchy => "false"} ]
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \stackrel{[\alpha]}{to} x
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi id
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(\alpha) = id_{f(x)}
              and so there is precisely one such, namely the equivalence class of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi x
                    %annotation{:encoding => "application/x-tex"} id_x
            %p
              Notice second that the homotopy fibers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself have the same form, only that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi x
                      %mn 1
                    %mo →
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \alpha \colon x_1 \to x_2
              appears itself, not as its equivalence class. Also if two objects in the homotopy fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              are connected by a morphism, then by construction so they are in the homotopy fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} im_2(f) \to Y
              and hence the latter is indeed the
              %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
              of the former.
          .num_remark
            %h6#remark_2 Remark
            %p
              The factroization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msub
                      %mi im
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi im
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to im_2(f) \to im_1(f) \to Y
              of prop.
              %a.maruku-ref{:href => "#FactorizationOf1FunctorsBetween1Groupoids"}
              exhibits a
              %em
                %a.existingWikiWord{:href => "/nlab/show/ternary+factorization+system"} ternary factorization system
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
          .num_remark
            %h6#remark_3 Remark
            %p
              This situation can also be considered from the perspective of the formalization of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} stuff, structure, property
              = succeed "." do
                %em
                  %a{:href => "stuff%2C+structure%2C+property#AFactorizationSystem"} A factorization system
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/image"}> image
                ,
                %a.existingWikiWord{:href => "/nlab/show/coimage"} coimage
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+image"} homotopy image
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+system"} Postnikov system
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/k-ary+factorization+system"} k-ary factorization system
          %h2#references References
          %p
            Discussion of
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              , section 7.6 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
          %p
            A construction of
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            using only
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pushouts"} homotopy pushouts
            and specifically
            %a.existingWikiWord{:href => "/nlab/show/join+of+topological+spaces"} joins
            (instead of more general
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/higher+inductive+types"} higher inductive types
          %ul
            %li#Rijke17
              %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
              ,
              %em The join construction
              (
              %a{:href => "https://arxiv.org/abs/1701.07538"}> arXiv:1701.07538
              )
