          %title 3d Gravity and Chern-Simons theory
          %h3#3dGravityAndChernSimonsTheoryReferences 3d Gravity and Chern-Simons theory
          %p
            On 3-dimensional (
            %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"}> quantum
            )
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            (
            %a.existingWikiWord{:href => "/nlab/show/general+relativity"}> general relativity
            ) with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            with non-
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+groups"} gauge groups
          %p
            The original articles on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/3d+gravity"} 3d gravity
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            and discovering its
            %a.existingWikiWord{:href => "/nlab/show/holography"} holographic
            relation to a
            %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            (well before
            %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT"} AdS/CFT
            was conceived from
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Deser"}> Stanley Deser
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Roman+Jackiw"} Roman Jackiw
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gerard+%27t+Hooft"} Gerard 't Hooft
                = succeed "," do
                  %em Three-dimensional Einstein gravity: Dynamics of flat space
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0003-4916(84)90085-X"} doi:10.1016/0003-4916(84)90085-X
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Deser"}> Stanley Deser
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Roman+Jackiw"} Roman Jackiw
                = succeed "," do
                  %em Three-dimensional cosmological gravity: Dynamics of constant curvature
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/0003-4916(84)90025-3"} doi:10.1016/0003-4916(84)90025-3
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/192694"} spire:192694
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Roman+Jackiw"}> Roman Jackiw
                ,
                = succeed "," do
                  %em Lower dimensional gravity
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/0550-3213(85)90448-1"} doi:10.1016/0550-3213(85)90448-1
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/204694"} spire:204694
            %li
              %p
                J. D. Brown,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"} Marc Henneaux
                = succeed "," do
                  %em Central charges in the canonical realization of asymptotic symmetries: An example from three dimensional gravity
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01211590"} doi:10.1007/BF01211590
            %li
              %p
                A. Achucarro,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em A Chern-Simons Action for Three-Dimensional anti-De Sitter Supergravity Theories
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/0370-2693(86)90140-1"} doi:10.1016/0370-2693(86)90140-1
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/21208"} spire:21208
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                ,
                = succeed "," do
                  %em Inducing Liouville theory from topologically massive gravity
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(91)90558-F"} doi:10.1016/0550-3213(91)90558-F
            %li
              %p
                O. Coussaert,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"} Marc Henneaux
                = succeed "," do
                  %em The asymptotic dynamics of three-dimensional Einstein gravity with a negative cosmological constant
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/gr-qc/9506019"} arXiv:gr-qc/9506019
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+QFT"} non-perturbative
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of 3-dimensional gravity, via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantization+of+3d+Chern-Simons+theory"} quantization of 3d Chern-Simons theory
          %ul
            %li#Witten88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em (2+1)-Dimensional Gravity as an Exactly Soluble System
                %strong 311
                (1988) 46. [
                %a{:href => "https://doi.org/10.1016/0550-3213(88)90143-5"} doi:10.1016/0550-3213(88)90143-5
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herman+Verlinde"}> Herman Verlinde
                ,
                = succeed "," do
                  %em Conformal field theory, two-dimensional quantum gravity and quantization of Teichmüller space
                %strong 337
                3 (1990) 652-680 [
                %a{:href => "https://doi.org/10.1016/0550-3213(90)90510-K"}> doi:10.1016/0550-3213(90)90510-K
                ]
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                ,
                = succeed "," do
                  %em Lectures in (2+1)-Dimensional Gravity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/gr-qc/9503024"} arXiv:gr-qc/9503024
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                ,
                = succeed "," do
                  %em Quantum Gravity in 2+1 Dimensions
                = succeed ")" do
                  %a{:href => "http://www.cambridge.org/de/academic/subjects/physics/cosmology-relativity-and-gravitation/quantum-gravity-21-dimensions"} publisher
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                ,
                = succeed "," do
                  %em Quantum Gravity in 2+1 Dimensions: The Case of a Closed Universe
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/gr-qc/0409039"} arXiv:gr-qc/0409039
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                ,
                %em
                  %a{:href => "http://www.physics.ucdavis.edu/Text/Carlip.html#2+1"} My Research – (2+1)-Dimensional quantum gravity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Laura+Donnay"}> Laura Donnay
                ,
                = succeed "," do
                  %em Asymptotic dynamics of three-dimensional gravity
                = succeed "," do
                  %em Eleventh Modave Summer School in Mathematical Physics
                %strong 271
                (2016)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1602.09021"} arXiv:1602.09021
                %a{:href => "https://doi.org/10.22323/1.271.0001"} doi:10.22323/1.271.0001
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wout+Merbis"}> Wout Merbis
                ,
                %em Chern-Simons-like Theories of Gravity
                (
                %a{:href => "https://arxiv.org/abs/1411.6888"}> arXiv:1411.6888
                )
            %li
              %p
                Chen-Te Ma,
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} AdS_3
                  Einstein Gravity and Boundary Description: Pedagogical Review
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://arxiv.org/abs/2310.04665"} arXiv:2310.04665
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p Further developments:
          %ul
            %li#Witten
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                %em Three-dimensional gravity revisited
                (2007) [
                %a{:href => "http://arxiv.org/abs/0706.3359"}> arXiv:0706.3359
                ]
            %li
              %p
