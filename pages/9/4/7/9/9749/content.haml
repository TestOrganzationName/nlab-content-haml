                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,h) \xrightarrow{m} (\mathbb{R}_{\infty}, \mathbb{E}_{\bullet}(id_{\mathbb{R}_{\infty}})
