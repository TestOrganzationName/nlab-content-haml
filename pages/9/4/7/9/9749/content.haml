          .num_lemma
            %h6 Lemma
            %p
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \epsilon_A
              is a
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .proof
            %h6 Proof
            %p
              The property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \epsilon_A(\delta_a)=a
              follows from the preceding corollary. To prove the property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                    %mo ∘
                    %msub
                      %mi μ
                      %mi A
                    %mo =
                    %msub
                      %mi ϵ
                      %mi A
                    %mo ∘
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϵ
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon_A \circ \mu_A = \epsilon_A \circ G(\epsilon_A)
              compose both sides of that equation by a countably affine measurable map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mi m
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A \xrightarrow{m} \mathbb{R}_{\infty}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi A
                      %mi m
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mrow
                          %mi P
                          %mo ∈
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} G
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi 𝔼
                        %mi P
