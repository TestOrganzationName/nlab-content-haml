                      %mi m
                      %mo{:stretchy => "false"} )
                      %mi dQ
                    %annotation{:encoding => "application/x-tex"} \int_A m \, d(\mu_X(Q)) = \int_{P \in \G(A)} \mathbb{E}_{P}(m) dQ
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              coseparates, i.e, the set of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi m
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A  \xrightarrow{m} \mathbb{R}_{\infty}
              are jointly monic on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              A more detailed proof can be found in (
              %a{:href => "#Sturtz25"}> Sturtz 25
              ).
          %p
          .num_lemma
            %h6 Lemma
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ∈
                        %mi ob
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} A \in_{ob} \mathbf{Std}_{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi m
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A \xrightarrow{m} \mathbb{R}_{\infty}
              yields a morphism of
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} G
                    %annotation{:encoding => "application/x-tex"} \G
          .proof
            %h6 Proof
            %p
              By Corollary 3.9 the affine measurable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                    %mo =
                    %msub
                      %mi 𝔼
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon_A =\mathbb{E}_{\bullet}(id_A)
              is the unique morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              such that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
