              commutes.
            %p
              To prove this note that the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(X)
              is, by Lemma 3.7, an object in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              is also an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∘
                    %mi h
                  %annotation{:encoding => "application/x-tex"} m \circ h
              is an affine measurable map and hence an arrow in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi ℝ
                          %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ∘
                    %msub
                      %mi μ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo ∘
                    %mi h
                    %mo ∘
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{E}_{\bullet}(id_{\mathbb{R}_{\infty}}) \circ G(m) \circ G(h) = m \circ (h \circ \mu_X) = m \circ h \circ G(h).
            %p
              Now note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(h)
              is an epimorphism (onto) because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is an epimorphism. Consequently, cancelling the term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(h)
              on the right in the preceding equation shows that the right-hand side of the square in the diagram commutes.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is a morphism of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in G(X)
              that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi 𝔼
                        %mi P
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m( h(P)) = \mathbb{E}_P(m)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝔼
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} h(P) \in m^{-1}\big(\mathbb{E}_P(m)\big)
            %p
              or equivalently,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi m
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h(P) \in m^{-1}( \tilde{P}(m) )
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi m
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} X \xrightarrow{m} \mathbb{R}_{\infty}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi m
                        %mo ∈
                        %msubsup
                          %mi ℝ
                          %mn ∞
                          %mi A
                        %mo{:stretchy => "false"} |
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \bigcap_{m \in \mathbb{R}_{\infty}^A|} m^{-1}(\tilde{P}(m)) \ne \emptyset.
            %p
              Consequently
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              lies in the category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            %p
              The fact that every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Alg
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{Alg}_G
              is a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              follows from Lemma 3.1. Hence we have shown that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Alg
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{Alg}_G
              is a subcategory of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              is a subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Alg
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{Alg}_G
              yields the result.
          %p
            Concerning
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            algebras, the above method of using generalized points can be used to obtain similar results. (
            %a{:href => "#Doberkat03"}> Doberkat 03
            ) gives a different representation for the algebras of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "-algebras.)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} h:P(X) \rightarrow X
            such that the ‘fibres’ are convex and closed, and such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \delta_x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(X)
            to be sent to a compact subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            As an example of
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            Fix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⊂
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
            as a bounded, closed, and convex subset of the Euclidean space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mo ⋆
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} x_{\star} \in \mathbb{R}^n
            is called a barycenter of the probability measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau \in P(X)
            iff, for all linear functionals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mo ⋆
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi X
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi d
                  %mi τ
                %annotation{:encoding => "application/x-tex"} g(x_{\star}) = \int_X g(x) d\tau
            holds. Since every linear functional on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            is given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} g(\cdot)=\langle x, \cdot \rangle
            for a unique
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %msub
                    %mi x
                    %mo ⋆
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi y
                      %mo ∈
                      %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ⟩
                  %mi d
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \langle x, x_{\star} \rangle = \int_{y \in  X} \langle x, y\rangle d\tau
            holds.
          %p
          .num_lemma
            %h6 Lemma
            %p
              The barycenter of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau \in P(X)
              exists, it is uniquely determined, and it is an element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(\tau)
              be the barycenter of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo ∈
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau \in P(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,h)
              is an algebra for the
              = succeed "-monad." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
          %p
            Finally, we note that Doberkat points out that for discrete Polish space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is disconnected, and hence there can be no continuous map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} P{X} \rightarrow \mathbf{X}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#related_constructions Related constructions
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monads+of+probability%2C+measures%2C+and+valuations"} monads of probability, measures, and valuations
          %h3#voevodskys_work Voevodsky’s work
          %p
            %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
            has also worked on a category theoretic treatment of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            = succeed "," do
              %span.newWikiWord
                mathematical biology
                %a{:href => "/nlab/new/mathematical+biology"} ?
          %p
            See
            %a{:href => "http://www.math.miami.edu/anno/voevodsky.htm"} Miami Talk abstract
          %blockquote
            %p …a categorical study of probability theory where “categorical” is understood in the sense of category theory. Originally, I developed this approach to probability to get a better understanding of the constructions which I had to deal with in population genetics. Later it evolved into something which seems to be also interesting from a purely mathematical point of view. On the elementary level it gives a category which is useful for the work with probabilistic constructions involving complicated combinations of stochastic processes of different types. On a more advanced level, applying in this context the old idea of a functor as a generalized object one gets a better view of the relationship between probability and the theory of (pre-)ordered topological vector spaces.
          %p
            A talk in Moscow (20 Niv 2008, in Russian) can be viewed
            = succeed "," do
              %a{:href => "http://www.mi.ras.ru/index.php?c=obs_sem/&l=1"} here
            = succeed "." do
              %a{:href => "http://www.mi.ras.ru/media/335_full.wmv"} wmv 223.6 Mb
          %blockquote
            %p In early 60-ies Bill Lawvere defined a category whose objects are measurable spaces and morphisms are Markov kernels. I will try to show how this category allows one to think about many of the notions of probability theory in categorical terms and to connect probabilistic objects to objects of other types through various functors.
          %p
            Voevodsky’s unfinished
            %a{:href => "http://www.math.ias.edu/Voevodsky/voevodsky-publications_abstracts.html#markov"} notes on categorical probability theory
            have been released posthumously.
          %h3#panangadens_monad Panangaden’s monad
          %p
            %a.existingWikiWord{:href => "/nlab/show/Prakash+Panangaden"} Prakash Panangaden
            in
            %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/summary?doi=10.1.1.52.4840"} Probabilistic Relations
            defines the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SRel
                %annotation{:encoding => "application/x-tex"} SRel
            (stochastic
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sigma-field"} -field
            %a.existingWikiWord{:href => "/nlab/show/morphism"} Morphisms
            are conditional probability densities or stochastic kernels. So, a morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi Σ
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ( X, \Sigma_X)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi Σ
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ( Y, \Sigma_Y)
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo ×
                  %msub
                    %mi Σ
                    %mi Y
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} h: X \times \Sigma_Y \to [0, 1]
            such that
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi B
                    %mo ∈
                    %msub
                      %mi Σ
                      %mi Y
                    %mo .
                    %mi λ
                    %mi x
                    %mo ∈
                    %mi X
                    %mo .
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall B \in \Sigma_Y . \lambda x \in X . h(x, B)
              is a bounded measurable function,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi x
                    %mo ∈
                    %mi X
                    %mo .
                    %mi λ
                    %mi B
                    %mo ∈
                    %msub
                      %mi Σ
                      %mi Y
                    %mo .
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall x \in X . \lambda B \in \Sigma_Y . h(x, B)
              is a subprobability measure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \Sigma_Y
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ⋅
                  %mi h
                %annotation{:encoding => "application/x-tex"} k \cdot h
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            is defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ⋅
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mi Y
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi d
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k \cdot h)(x, C) = \int_Y  k(y, C)h(x, d y)
          %p Panangaden’s definition differs from Giry’s in the second clause where subprobability measures are allowed, rather than ordinary probability measures.
          %p
            Panangaden emphasises that the mechanism is similar to the way that the category of relations can be constructed from the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of the powerset functor over the category of sets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SRel
                %annotation{:encoding => "application/x-tex"} SRel
            is the Kleisli category of the functor over the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurable function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
          %p
            What is gained by the move from probability measures to subprobability measures? One motivation seems to be to model probabilistic processes from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo +
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X + Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            you eventually end up. This relates to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SRel
                %annotation{:encoding => "application/x-tex"} SRel
            being traced.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MeasureSpaces
                  %annotation{:encoding => "application/x-tex"} MeasureSpaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %mi Meas
                    %mo →
                    %mi Meas
                  %annotation{:encoding => "application/x-tex"} 1 + -: Meas \to Meas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo +
                  %mi X
                %annotation{:encoding => "application/x-tex"} 1 + X
            is a subprobability measure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} 1 + -
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monads+of+probability%2C+measures%2C+and+valuations"} monads of probability, measures, and valuations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/measure"}> measure
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pushforward+measure"} pushforward measure
                %a.existingWikiWord{:href => "/nlab/show/convex+mixture"} convex mixture
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/measure+theory"}> measure theory
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
                %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Radon+monad"}> Radon monad
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/distribution+monad"} distribution monad
                %a.existingWikiWord{:href => "/nlab/show/extended+probabilistic+powerdomain"} extended probabilistic powerdomain
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/categorical+probability"}> categorical probability
                ,
                %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"}> Markov kernel
                ,
                %a.existingWikiWord{:href => "/nlab/show/Stoch"} Stoch
          %h2#history History
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            underlying the Giry monad was originally developed
            = succeed "," do
              %a{:href => "#Lawvere62"} by Lawvere in 1962
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint pair
            gives rise to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
          %p
            Lawvere’s construction was written up as an
            %a{:href => "#Lawvere62"} appendix to a proposal
            to the Arms Control and Disarmament Agency, set up by President Kennedy as part of the State Department to handle planning and execution of certain treaties with the Soviet Union. This appendix was intended to provide a reasonable framework for arms control verification protocols (
            %a{:href => "#Lawvere20"}> Lawvere 20
            ).
          %p
            At that time, Lawvere was working for a “think tank” in California, and the purpose of the proposal was to provide a means for verifying compliance with limitations on nuclear weapons. In the 1980’s,
            %a.existingWikiWord{:href => "/nlab/show/Mich%C3%A8le+Giry"} Michèle Giry
            was collaborating with another French mathematician at that time who was also working with the French intelligence agency, and she was able to obtain a copy of the appendix. Giry then developed and extended some of the ideas in the appendix (
            %a{:href => "#Giry80"}> Giry 80
            )
          %p
            %a.existingWikiWord{:href => "/nlab/show/Gian-Carlo+Rota"} Gian-Carlo Rota
            had also (somehow) obtained a copy of
            = succeed "," do
              %a{:href => "#Lawvere62"} the appendix
          %p
            From
            = succeed ":" do
              %a{:href => "#Lawvere20"} Lawvere 20
          %blockquote
            %p I’d like to say that the idea of the category of probabilistic mappings, the document corresponding to that was not part of a seminar, as some of the circulations say, essentially it was the document submitted to the arms control and disarmament agency after suitable checking that the Pentagon didn’t disagree with it. Because of the fact that for arms control agencies as a side responsibility the forming of arms control agreements and part of these agreements must involve agreed upon protocols of verification. So the idea of that paper did not provide such protocols, but it purported to provide reasonable framework within which such protocol can be formulated.
          %h2#references References
          %p The idea originates with
          %ul
            %li#Lawvere62
              %p
                %a.existingWikiWord{:href => "/nlab/show/W.+Lawvere"}> W. Lawvere
                ,
                = succeed "," do
                  %em The category of probabilistic mappings
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/lawvereprobability1962.pdf", :title => "Lawvere Probability 1962"} Lawvere Probability 1962
              %p (notice that the statement of origin on p.1 is wrong)
          %p and was picked up and published in:
          %ul
            %li#Giry80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mich%C3%A8le+Giry"}> Michèle Giry
                ,
                = succeed "," do
                  %em A categorical approach to probability theory
                %strong 915
                Springer 1982 (
                %a{:href => "https://doi.org/10.1007/BFb0092872"}> doi:10.1007/BFb0092872
                )
              %blockquote
                %p
                  (there are allegedly a few minor
                  %a.existingWikiWord{:href => "/nlab/show/analysis"} analytically
                  incorrect points and gaps in proofs, observed by later authors).
          %p
            Historical comments on the appearance of
            %a{:href => "#Lawvere62"} Lawvere 62
            are made in
          %ul
            %li#Lawvere20
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"}> Bill Lawvere
              , video discussion, 6 June 2020 (in the talk “The algebra of statistical theories and models” by Evan Patterson, at
              = succeed "," do
                %a{:href => "http://perimeterinstitute.ca/personal/tfritz/2019/cps_workshop/"} Categorical Probability and Statistics
              %p
                (
                %a{:href => "http://www.youtube.com/watch?v=BhKaHAY8Ec8&t=60m21s"}> YouTube video, timestamp 1:00:20
                )
          %p
            According to
            = succeed "," do
              %a{:href => "#Burroni09"} E. Burroni (2009)
          %ul
            %li
              O. de la Tullaye,
              = succeed "." do
                %em L’intégration considérée comme l’algèbre d’un triple
          %p The article
          %ul
            %li#VanBelle21
              %a.existingWikiWord{:href => "/nlab/show/Ruben+Van+Belle"}> Ruben Van Belle
              ,
              %em Probability monads as codensity monads
              (2021)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "https://arxiv.org/abs/2111.01250"} arXiv:2111.01250
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            shows, in effect, that the Giry monad restricted to countable measurable spaces (with the discrete
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} |
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Meas
                    %mi c
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Meas
                %annotation{:encoding => "application/x-tex"} G|: \mathbf{Meas}_c \rightarrow \mathbf{Meas}
            which has the codensity monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            are ‘’sufficient’‘ in some sense. Indeed, the full subcategory of Polish spaces consisting of the single object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            of all natural numbers with the powerset
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pol
                %annotation{:encoding => "application/x-tex"} Pol
            \- every continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P{X} \rightarrow X
            is completely determined by its values on the countable dense subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P{X}
          %p The article
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kirk+Sturtz"}> Kirk Sturtz
              ,
              = succeed "," do
                %em Categorical Probability Theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "http://arxiv.org/abs/1406.6030"} arXiv:1406.6030
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            views probability measures via double dualization, restricted to weakly averaging affine maps. A more satisfactory description of probability measures arises from recognizing the need for viewing them as weakly-averaging countably affine maps, obtained by double dualizing into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Giry+monad#algebras_over_the_giry_monad"} above
          %ul
            %li#Sturtz25
              %a.existingWikiWord{:href => "/nlab/show/Kirk+Sturtz"}> Kirk Sturtz
              ,
              = succeed "," do
                %em
                  Deriving the Giry algebras on standard Borel spaces using
                  = succeed "-generalized" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℝ
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "https://arxiv.org/abs/2409.14861"} arXiv:2409.14861
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p Some corrections from an earlier version of the Categorical Probability Theory article, were pointed out in
          %ul
            %li#Avery14
              %a.existingWikiWord{:href => "/nlab/show/Tom+Avery"}> Tom Avery
              ,
              = succeed "," do
                %em Codensity and the Giry monad
              %strong 220
              3 (2016) 1229-1251 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1410.4432"}> arXiv:1410.4432
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2015.08.017"} doi:10.1016/j.jpaa.2015.08.017
          %p Apart from these papers, there are similar developments in
          %ul
            %li
              %p
                Franck van Breugel,
                = succeed "," do
                  %em The metric monad for probabilistic nondeterminism
            %li#Doberkat03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ernst-Erich+Doberkat"}> Ernst-Erich Doberkat
                ,
                %em Characterizing the Eilenberg-Moore algebras for a monad of stochastic relations
                (
                %a{:href => "https://eldorado.tu-dortmund.de/bitstream/2003/2717/1/147.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ernst-Erich+Doberkat"}> Ernst-Erich Doberkat
                ,
                = succeed "," do
                  %em Kleisli morphisms and randomized congruences
                %a{:href => "https://doi.org/10.1016/j.jpaa.2007.03.003"} https://doi.org/10.1016/j.jpaa.2007.03.003
            %li
              %p
                N. N. Cencov,
                = succeed "," do
                  %em Statistical decisions rules and optimal Inference
                = succeed "," do
                  %strong 53
          %p
            (blog comment) Cencov’s “category of statistical decisions” coincides with Giry’s (Lawvere’s) category. I (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ←
                %annotation{:encoding => "application/x-tex"} \leftarrow
            somebody) have the sense that Cencov discovered this category independently of Lawvere although years later.
          %ul
            %li
              %p
                category cafe related to Giry monad:
                = succeed "," do
                  %a{:href => "http://golem.ph.utexas.edu/category/2007/02/category_theoretic_probability.html"} category theoretic probability
                %a{:href => "http://golem.ph.utexas.edu/category/2009/09/coalgebraic_modal_logic.html"} coalgebraic modal logic
            %li
              %p
                Samson Abramsky et al.
                = succeed "," do
                  %em Nuclear and trace ideals in tensored ∗-Categories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/9805102"} arxiv:math/9805102
          %p There is also relation with work of Jacobs et al.
          %ul
            %li
              %p
                Robert Furber,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"} Bart Jacobs
                = succeed "," do
                  %em Towards a categorical account of conditional probability
                %a{:href => "http://arxiv.org/abs/1306.0831"} arxiv:1306.0831
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"}> Bart Jacobs
                ,
                = succeed "," do
                  %em Probabilities, distribution monads and convex categories
              %p
                Computer Science 412(28) (2011) pp.3323–3336.
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/j.tcs.2011.04.005"} https://doi.org/10.1016/j.tcs.2011.04.005
                = succeed ")" do
                  %a{:href => "http://www.cs.ru.nl/B.Jacobs/PAPERS/triangle.pdf"} preprint
          %p
            J. Culbertson and K. Sturtz use the Giry monad in their categorical approach to
            %a.existingWikiWord{:href => "/nlab/show/Bayesian+reasoning"} Bayesian reasoning
            and inference (both articles contain further references to the categorical approach to probability theory):
          %ul
            %li
              %p
                Jared Culbertson and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kirk+Sturtz"} Kirk Sturtz
                = succeed "," do
                  %em A categorical foundation for Bayesian probability
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1205.1488"} arXiv:1205.1488
            %li
              %p
                Jared Culbertson and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kirk+Sturtz"} Kirk Sturtz
                = succeed "," do
                  %em Bayesian machine learning via category theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1312.1445"} arxiv:1312.1445
            %li#Burroni09
              %p
                Elisabeth Burroni,
                = succeed "," do
                  %em Lois distributives. Applications aux automates stochastiques
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/22/7/22-07abs.html"} journal page
          %p
            where she derives stochastic
            %a.existingWikiWord{:href => "/nlab/show/automata"} automata
            as algebras for a suitable
            %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive law
            on the monoid and Giry monads.
          %p B. Fong has a section on the Giry monad in his paper on Bayesian networks:
          %ul
            %li
              Fong:
              = succeed "," do
                %em Causal Theories - A Categorical Perspective on Bayesian Networks
              %a{:href => "http://arxiv.org/abs/1301.6201"} 1301.6201
          %p See also:
          %ul
