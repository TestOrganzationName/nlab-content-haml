                    %mi X
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi m
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mn ∞
                    %mo ,
                    %msub
                      %mi 𝔼
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi ℝ
