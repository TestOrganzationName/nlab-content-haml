                      %mi p
                      %mi i
                    %msub
                      %mi x
                      %mi i
                    %mo :
                    %mo =
                    %mi h
                    %mo{:stretchy => "false"} (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi p
                      %mi i
                    %msub
                      %mi δ
