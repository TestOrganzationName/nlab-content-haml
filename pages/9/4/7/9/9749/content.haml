                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_{\bullet}(id_A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi ℝ
                          %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_{\bullet}(id_{\mathbb{R}_{\infty}})
              are
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is a morphism of those algebras.
          %p
          .num_lemma
            %h6 Lemma
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_{\bullet}(id_A)
              is natural in the argument
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6 Proof
            %p The proof is straightforward using the previous lemma.
          %p
            Using the naturality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔼
                %annotation{:encoding => "application/x-tex"} \mathbb{E}
            we obtain an adjunct pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mover
                      %mo →
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std} \xrightarrow{\hat{G}} \mathbf{Std}_{Cvx}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mi Cvx
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi 𝒰
                        %mi Cvx
                  %mstyle{:mathvariant => "bold"}
                    %mi Std
                %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}  \xrightarrow{\mathcal{U}_{Cvx}} \mathbf{Std}
            which forgets the convex space structure, with the natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔼
                %annotation{:encoding => "application/x-tex"} \mathbb{E}
            as the counit of the adjunction. The composite functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒰
                      %mi Cvx
                    %mo ∘
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}_{Cvx} \circ \hat{G} = G
          %p
            Since the Giry monad factors through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            it follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            is a subcategory of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Alg
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{Alg}_{G}
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Alg
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx} = \mathbf{Alg}_{G}
              \.
          .proof
            %h6 Proof
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,h)
              is a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Alg
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{Alg}_G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a convex space structure so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mo ∩
                      %mstyle{:mathvariant => "bold"}
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std} \cap \mathbf{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              we only need to verify that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
