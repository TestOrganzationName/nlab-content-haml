                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              must satisfy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
