                    %mo{:stretchy => "false"} ^
                %msub
                  %mstyle{:mathvariant => "bold"}
                    %mi Std
                  %mi Cvx
              %annotation{:encoding => "application/x-tex"} \mathbf{Std} \xrightarrow{\hat{G}} \mathbf{Std}_{Cvx}
          which is the Giry monad functor with codomain
          = succeed "," do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %msub
                  %mstyle{:mathvariant => "bold"}
                    %mi Std
                  %mi Cvx
                %mover
                  %mo →
                  %mrow
                    %msub
                      %mi 𝒰
                      %mi Cvx
                %mstyle{:mathvariant => "bold"}
                  %mi Std
              %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx} \xrightarrow{\mathcal{U}_{Cvx}} \mathbf{Std}
          which forgets the convex space structure, we obtain a factorization of the
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi G
              %annotation{:encoding => "application/x-tex"} G
          monad. (This will be an adjoint factorization once we prove some more facts.)
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              denote the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              consisting of the single object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Std
                            %mi Cvx
                            %mi op
                        %mtd
                          %mover
                            %mo →
                            %mi 𝒴
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Set
                            %mi ℛ
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Std
                            %mi Cvx
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %mo •
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbf{Std}_{Cvx}^{op} &amp; \xrightarrow{\mathcal{Y}} &amp; \mathbf{Set}^{\mathcal{R}} \\
                    A &amp; \mapsto &amp; \mathbf{Std}_{Cvx}(A, \bullet)
                    \\end{array}
            %p is a full and faithful functor.
          .proof
            %h6 Proof
            %p
              In the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              every affine measurable function is determined by its value on points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mover
                        %mo →
                        %mi a
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 1 \xrightarrow{a} A
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              lies in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Std
                        %mi Cvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              as a coseparator, the faithful property holds. The fullness property follows from Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#ff"}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \delta_a
            denote the Dirac measure at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
          .num_cor
            %h6 Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
              then there exists a unique affine measurable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϵ
                          %mi A
                    %mi A
                  %annotation{:encoding => "application/x-tex"} G(A) \xrightarrow{\epsilon_A} A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \epsilon_A(\delta_a)=a
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                    %mover
                      %mo →
                      %mi ι
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathcal{R} \xrightarrow{\iota} \mathbf{Std}_{Cvx}
              denote the inclusion functor. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} ↓
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} A\downarrow \iota
              denote the slice category of arrows
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mi m
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A \xrightarrow{m} \mathbb{R}_{\infty}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} ↓
                    %mi ι
                    %mover
                      %mo →
                      %mi π
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} A \downarrow \iota \xrightarrow{\pi} \mathcal{R}
              denote the projection functor. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mi A
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} ↓
                    %mi ι
                    %mover
                      %mo →
                      %mi π
                    %mi ℛ
                    %mover
                      %mo →
                      %mi ι
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_A = A \downarrow \iota \xrightarrow{\pi} \mathcal{R} \xrightarrow{\iota} \mathbf{Std}_{Cvx}
              the theorem is equivalent to saying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi lim
                    %msub
                      %mi 𝒟
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A = \lim \mathcal{D}_A
              with the projection map at component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              being
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
            %p
              Consider the cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_A
              with vertex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(A)
              and natural transformation components
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔼
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi 𝔼
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi ℝ
                            %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} G
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{E}_{\bullet}(m) = \mathbb{E}_{\bullet}(id_{\mathbb{R}_{\infty}}) \circ \G(m)
