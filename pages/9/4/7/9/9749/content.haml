            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
          %h3#algebras_over_the_giry_monad_on_standard_spaces Algebras over the Giry Monad on Standard spaces
          %p
            We can’t say much about the
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
