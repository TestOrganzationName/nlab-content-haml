            is a
            %a.existingWikiWord{:href => "/nlab/show/superconvex+space"} superconvex space
            with the structure defined pointwise: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
