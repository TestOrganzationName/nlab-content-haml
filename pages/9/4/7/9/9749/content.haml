                  %mi a
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi dP
                %annotation{:encoding => "application/x-tex"} m(\mathbb{E}_{P}(id_A)) = \int_A m(a) \, dP
            for all countably affine measurable functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
