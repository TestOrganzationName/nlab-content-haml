                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{P}(\sum_{i} f_i) = \tilde{P}(\lim_n g_n) = \lim_n \{\tilde{P}(g_n)\} = \lim_n \sum_{i=1}^n \tilde{P}(f_i) = \sum_i \tilde{P}(f_i)
          %p
            We say an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Std
                  %mo ∩
                  %mstyle{:mathvariant => "bold"}
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std} \cap \mathbf{Cvx}
            satisfies the fullness property if and only if for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P \in G(A)
            the property
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "true"}
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi m
                          %mo ∈
                          %msubsup
                            %mi ℝ
                            %mn ∞
                            %mi A
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ∈
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "1em"}
                    %mo ∀
                    %mi m
                    %mo ∈
                    %msubsup
                      %mi ℝ
                      %mn ∞
                      %mi A
                    %mo{:stretchy => "false"} }
                    %mo ≠
                    %mi ∅
                %annotation{:encoding => "application/x-tex"}
                  \\displaystyle{ \bigcap_{m \in \mathbb{R}_{\infty}^A}} m^{-1}\big(\tilde{P}(m)\big) = \{a \in A \, | \, \tilde{P}(m)=m(a) \quad \forall m \in \mathbb{R}_{\infty}^A\} \ne \emptyset
          %p holds.
          %p
          #ff.num_lemma
            %h6 Lemma
            %p
              Every
              = succeed "-generalized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{P}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              which satisfies the fullness property is a point, i.e,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %msub
                      %mi ev
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \tilde{P} =ev_a
              for a unique element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mi a
                  %annotation{:encoding => "application/x-tex"} ev_a
              is the evaluation map at the point
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
          .proof
            %h6 Proof
            %p
              Since the fullness property is satisfied there exist at least one element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{P}(m)=m(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mo ∩
                    %mstyle{:mathvariant => "bold"}
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std} \cap \mathbf{Cvx}
              is coseparated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
              there is at most one element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              satisfying, for all affine measurable maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mi m
                      %msub
                        %mi ℝ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A \xrightarrow{m} \mathbb{R}_{\infty}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{P}(m)=m(a)
              %br/
          %p
            Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Std
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            to be the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Std
                  %mo ∩
                  %mstyle{:mathvariant => "bold"}
                    %mi Cvx
                %annotation{:encoding => "application/x-tex"} \mathbf{Std} \cap \mathbf{Cvx}
            consisting of those objects which satisfy the fullness property.
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\infty}
            is an object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℝ
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi 𝔼
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi ℝ
                            %mn ∞
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi ℝ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} G(\mathbb{R}_{\infty}) \xrightarrow{\mathbb{E}_{\bullet}(id_{\mathbb{R}_{\infty}})} \mathbb{R}_{\infty}
            is easily verified to be a
            = succeed "-algebra.)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            We now proceed to show that for every standard space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(X)
            is an object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Std
                      %mi Cvx
                  %annotation{:encoding => "application/x-tex"} \mathbf{Std}_{Cvx}
          %p
          .num_lemma
            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi 𝔽
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \sigma(\mathbb{F}))
              be a standard space. Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ∈
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} G
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q \in \G^2(X)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "true"}
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                          %mrow
                            %mi U
                            %mo ∈
                            %mi 𝔽
                      %msubsup
                        %mi ev
                        %mi U
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mover
                        %mi Q
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ev
                        %mi U
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo =
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \displaystyle{ \bigcap_{U \in \mathbb{F}}} ev_U^{-1}\big( \tilde{Q}(ev_U) \big) = \mu_X(Q)
            %p
          .proof
            %h6 Proof
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi Q
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ev
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi R
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi μ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi U
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    ev_U^{-1}\big( \tilde{Q}(ev_U) \big) = \{R \in G(X) \, | \, R(U)=\mu_X(Q)[U] \}
            %p
              so taking the intersection over all elements in the generating field (with a basis) yields the result using the well known result if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a standard space and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi R
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P,R \in G(X)
              satisfy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(U)=R(U)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝔽
                  %annotation{:encoding => "application/x-tex"} U \in \mathbb{F}
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mi R
                    %annotation{:encoding => "application/x-tex"} P=R
          %p
          .num_lemma
            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi 𝔽
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \sigma(\mathbb{F}))
              be a standard space. Then every affine measurable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi m
                    %msub
                      %mi ℝ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} G(X) \xrightarrow{m} \mathbb{R}_{\infty}
              is a countable affine sum of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi λ
                      %mi i
                    %msub
                      %mi ev
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} m = \sum_i \lambda_i ev_{U_i}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi i
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \lambda_i \in V
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∈
                      %mi 𝔽
                    %annotation{:encoding => "application/x-tex"} U_i \in \mathbb{F}
          .proof
            %h6 Proof
            %p
              The superconvex space structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(X)
              is defined by the countable family of equations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mi U
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi p
                      %mi i
                    %msub
                      %mi P
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi p
                      %mi i
                    %msub
                      %mi P
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U( \sum_{i=1}^{\infty} p_i P_i) = \sum_{i=1}^{\infty}p_i P_i(U)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi 𝔽
                    %annotation{:encoding => "application/x-tex"} U \in \mathbb{F}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ev
                      %mi U
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi U
                        %mo ∈
                        %mi 𝔽
                  %annotation{:encoding => "application/x-tex"} \{ev_U\}_{U \in \mathbb{F}}
              therefore defines a countable affine map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi λ
                            %mi j
                          %msub
