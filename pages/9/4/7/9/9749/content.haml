          %h2#idea Idea
          %p
            The
            %em Giry monad
            (
            %a{:href => "#Giry80"}> Giry 80
            , following
            = succeed ")" do
              %a{:href => "#Lawvere62"} Lawvere 62
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of suitable
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            which sends each suitable space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the space of suitable
            %a.existingWikiWord{:href => "/nlab/show/probability+measures"} probability measures
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            It is one of the main examples of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+monad"} probability monad
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
          %h2#definition Definition
          %p
            The
            %em Giry monad
            is defined on the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measurable+spaces"} measurable spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(X)
            of all
            %a.existingWikiWord{:href => "/nlab/show/probability+measures"} probability measures
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            endowed with the
            %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              \-algebra
            generated by the set of all the
            %a.existingWikiWord{:href => "/nlab/show/evaluation+maps"} evaluation maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  ev_U \colon G(X) \to [0,1]
          %p
            sending a probability measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            ranges over all the measurable sets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            to the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+measure"} Dirac measure
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
