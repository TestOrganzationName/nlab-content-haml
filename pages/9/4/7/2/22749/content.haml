          %title Irreflexive comparison
          %h1#irreflexive_comparison Irreflexive comparison
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#preorder_of_an_irreflexive_comparison"} Preorder of an irreflexive comparison
              %li
                %a{:href => "#examples"}  Examples
              %ul
                %li
                  %a{:href => "#connected_irreflexive_comparisons"} Connected irreflexive comparisons
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            Just as
            %a.existingWikiWord{:href => "/nlab/show/preorders"} preorders
            generalise
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/total+orders"} total orders
            %em irreflexive comparisons
            should generalise
            %a.existingWikiWord{:href => "/nlab/show/apartness+relations"} apartness relations
            and
            %a.existingWikiWord{:href => "/nlab/show/strict+total+orders"} strict total orders
          %h2#definitions Definitions
          %p
            An
            %strong irreflexive comparison
            on a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a (binary)
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that is both
            %a.existingWikiWord{:href => "/nlab/show/irreflexive+relation"} irreflexive
            and a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comparison"} comparison
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \lt x
              is always false;
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x \lt z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo &lt;
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y \lt z
          %h2#properties Properties
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            equipped with an irreflexive comparison is a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            as the set of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi TV
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %annotation{:encoding => "application/x-tex"} TV^\op
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            of the
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} poset
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth values
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi TV
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                %annotation{:encoding => "application/x-tex"} TV^\op
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/co-Heyting+algebra"} co-Heyting algebra
          %h3#preorder_of_an_irreflexive_comparison Preorder of an irreflexive comparison
          %p An important part of an irreflexive comparison is that it is a preorder.
          %p
          .num_theorem
            %h6 Theorem
            %p The negation of an irreflexive comparison is transitive.
          %p
          .proof
            %h6 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/contrapositive"} contrapositive
              of comparison says that
            %blockquote
              %p
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                      %annotation{:encoding => "application/x-tex"} z
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \lt y
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y \lt z
                is false, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x \lt z
                is false.
            %p
              By one of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+laws"} de Morgan's laws
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo &lt;
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y \lt z
              is false is logically to equivalent to that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(x \lt y)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo &lt;
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(y \lt z)
            %blockquote
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo &lt;
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(x \lt y)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo &lt;
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \neg(y \lt z)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo &lt;
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(x \lt z)
            %p which is precisely transitivity for the negation of the irreflexive comparison.
          %p
          .num_theorem
            %h6 Theorem
            %p The negation of an irreflexive comparison is reflexive.
          %p
          .proof
            %h6 Proof
            %p
              Irreflexivity states that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (x \lt x)
              is true, which is precisely reflexivity for the negation of the strict weak order.
          %p
          .num_theorem
            %h6 Theorem
            %p The negation of an irreflexive comparison is a preorder.
          %p
          .num_cor
            %h6 Corollary
            %p
              The incomparability relation of a strict weak order,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo &lt;
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo &lt;
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg (x \lt y) \wedge \neg (y \lt x)
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p
          .proof
            %h6 Proof
            %p
              For every preorder,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ≤
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ≤
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \leq y) \wedge (y \leq x)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (x \lt y)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo &lt;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (x \lt y) \wedge \neg (y \lt x)
              is an equivalence relation.
          %p
          .num_theorem
            %h6 Theorem
            %p
              If the irreflexive comparison is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+relation"} connected relation
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
          %p
          .proof
            %h6 Proof
            %p
              The connectedness condition states that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo &lt;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (x \lt y) \wedge \neg (y \lt x)
              implies equality, which is precisely the antisymmetry condition for the negation of the strict weak order, implying that its negation is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
          %p
          .num_theorem
            %h6 Theorem
            %p
              If the irreflexive comparison is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p
          .proof
            %h6 Proof
            %p
              The symmetry condition of the apartness relation states that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt y
              implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo &lt;
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y \lt x
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo &lt;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(y \lt x)
              implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(x \lt y)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                    %annotation{:encoding => "application/x-tex"} \lt
              %a.existingWikiWord{:href => "/nlab/show/symmetric+preorder"} symmetric preorder
              is the same thing as an equivalence relation, which means that the negation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
              is an equivalence relation.
          %p
          .num_theorem
            %h6 Theorem
            %p
              If the irreflexive comparison is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equality+relation"} equality relation
          %p
          .proof
            %h6 Proof
            %p This follows from the previous two theorems.
          %h2#examples  Examples
          %ul
            %li
              %p
                If an irreflexive comparison satisfies symmetry (if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \lt y
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo &lt;
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y \lt x
                then it is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            %li
              %p
                If an irreflexive comparison is asymmetric (if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \lt y
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo &lt;
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \neg(y \lt x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \lt y
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo &lt;
                        %mi z
                      %annotation{:encoding => "application/x-tex"} y \lt z
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi z
                      %annotation{:encoding => "application/x-tex"} x \lt z
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+weak+order"} strict weak order
            %li
              %p
                Connected versions of the above result in
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relations"} tight apartness relations
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+total+orders"} strict total orders
          %h3#connected_irreflexive_comparisons Connected irreflexive comparisons
          %ul
            %li
              %p
                An irreflexive comparison that is also a
                %a.existingWikiWord{:href => "/nlab/show/connected+relation"} connected relation
                (if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \lt y
                is false and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo &lt;
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y \lt x
                is false, then
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x = y
                = succeed "." do
                  %strong connected irreflexive comparison
            %li
              %p
                If the set has a
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≠
                      %annotation{:encoding => "application/x-tex"} \neq
                %strong strongly connected
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \neq y
                implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \lt y
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo &lt;
                        %mi x
                      %annotation{:encoding => "application/x-tex"} y \lt x
