              to itself).
          %h4#CWPresentationByDifferentialFormData Presentation by differential form data
          %p
            In order to compute the
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mi Field
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C Field(X)
            more explicitly, we follow the discussion at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            arising from
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            is given.
          %p Write now
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ≔
                  %msub
                    %mi 𝔢
                    %mn 8
                  %mo ×
                  %msub
                    %mi 𝔢
                    %mn 8
                  %mo ×
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mn 10
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g} \coloneqq \mathfrak{e}_8 \times \mathfrak{e}_8 \times \mathfrak{so}(10,1)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≔
                  %msub
                    %mi E
                    %mn 8
                  %mo ×
                  %msub
                    %mi E
                    %mn 8
                  %mo ×
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 10
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \coloneqq E_8 \times E_8 \times Spin(10,1)
            and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ≔
                  %msub
                    %mi μ
                    %mrow
