                    %annotation{:encoding => "application/x-tex"} p_2
                the
                %a.existingWikiWord{:href => "/nlab/show/second+Pontryagin+class"} second Pontryagin class
                combining to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/I8"} I8
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mn 8
                %annotation{:encoding => "application/x-tex"} X^{8}
            has
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29-structure"} Spin(7)-structure
              (hence in particular if it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo =
                  %annotation{:encoding => "application/x-tex"} SU(4) =
              = succeed "-structure)" do
                %a.existingWikiWord{:href => "/nlab/show/Spin%286%29"} Spin(6)
          %p or
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29-structure"} Sp(2).Sp(1)-structure
          %p then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi p
                    %mn 2
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 4
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi χ
                %annotation{:encoding => "application/x-tex"}
                  \\tfrac{1}{2}\big( p_2 - \tfrac{1}{4}(p_1)^2  \big)
                  \\;=\;
                  \\chi
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            (see
            %a{:href => "Spin7-manifold#CharacteristicClassesForSpinStructure"} this Prop.
            and
            = succeed "," do
              %a{:href => "quaternion-Kähler+manifold#CharacteristicClassesForSpin5Spin3Structure"} this Prop.
          #eq:DasguptaMukhiConditionInTermsOfEuler.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mrow
                      %mi M
                      %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %mi χ
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mn 8
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  N_{M2}
                  \\;=\;
                  \-
                  \\tfrac{1}{2} \big( G_4[X^{(8)}]\big)^2
                  \\;+\;
                  \\tfrac{1}{24}\chi[X^8]
                  \\;\;\;\;
                  \\in
                  \\mathbb{Z}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \chi[X]
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#Models Models
          %p
            One proposal for a mathematical model of the C-field is as a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in a
            = succeed "-shifted" do
              %a.existingWikiWord{:href => "/nlab/show/Wu+class"} Wu class
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            in degree 4:
          %ul
            %li
              %a{:href => "#DFMmodel"} The DFM model
          %p
            Another proposal is that the C-field is simply a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-
            %a.existingWikiWord{:href => "/nlab/show/twisted+Cohomotopy"} twisted Cohomotopy
            (
            %a.existingWikiWord{:href => "/nlab/show/Hypothesis+H"}> Hypothesis H
            ):
          %ul
            %li
              %a{:href => "#ModelByTwistedCohomotopy"} C-field charge quantization in J-twisted Cohomotopy
          %h3#DFMmodel The DFM-model
          %h4#construction_via__gauge_fields
            Construction via
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 8
                %annotation{:encoding => "application/x-tex"} E_8
            gauge fields
          %p
            In (
            %a{:href => "#DiaconescuFreedMoore03"}> DFM, section 3
            ) the following definition is considered and argued to be a good model of the supergravity
            = succeed "-field." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          #NatureOfE8.num_note
            %h6#note Note
            %p
              The
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi E
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} B E_8
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/E8"} E8
              satisfy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mi B
                    %msub
                      %mi E
                      %mn 8
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                              %mo{:stretchy => "false"} |
                              %mi i
                              %mo =
                              %mn 4
                          %mtr
                            %mtd
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mi i
                              %mo ≠
                              %mn 4
                              %mo ,
                              %mi i
                              %mo ≤
                              %mn 15
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_i B E_8 =
                    \\left\{
                    \\array{
                    \\mathbb{Z} | i = 4
                    \\\
                    0 | i \neq 4, i \leq 15
                    }
                    \\right.
                    \\,.
            %p
              Therefore for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                    %mo ≤
                    %mn 15
                  %annotation{:encoding => "application/x-tex"} dim X \leq 15
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mn 8
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^1(X, E_8)
                    \\simeq
                    H^4(X, \mathbb{Z})
                    \\,.
          #DFMDefinitionOfCField.num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mi X
                      %mo &lt;
                      %mn 15
                    %annotation{:encoding => "application/x-tex"} dim X \lt 15
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msup
                        %mi H
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in H^4(X, \mathbb{Z})
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/E8"} E8
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              which represents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              under the above isomorphism.
            %p Write then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}(X) \in Grpd
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/object"}> object
                  s are triples
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mo ∇
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (P,\nabla,c)
                  where
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi P
                          %annotation{:encoding => "application/x-tex"} P
                      is one of the chosen
                      = succeed "-bundles," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi E
                                %mn 8
                            %annotation{:encoding => "application/x-tex"} E_8
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ∇
                          %annotation{:encoding => "application/x-tex"} \nabla
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                      on
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi P
                            %annotation{:encoding => "application/x-tex"} P
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo ∈
                            %msup
                              %mi Ω
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} c \in \Omega^3(X)
                      is a degree-3
                      %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
                      on
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                            %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                  s
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 1
                        %mo ,
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 2
                        %mo ,
                        %msub
                          %mi c
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega : (P, \nabla_1, c_1) \to (P, \nabla_2, c_2)
                %p
                  are parameterized by their source and target triples together with a closed 3-form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ∈
                        %msubsup
                          %mi Ω
                          %mi ℤ
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega \in \Omega^3_{\mathbb{Z}}(X)
                  with integral
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/period"} period
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 2
                        %mo −
                        %msub
                          %mi c
                          %mn 1
                        %mo =
                        %mi CS
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∇
                          %mn 1
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi ω
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        c_2 -c_1 = CS(\nabla_1,\nabla_2) + \omega
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CS
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∇
                          %mn 1
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CS(\nabla_1, \nabla_2)
                  is the relative
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
                  corresponding to the linear path of connections from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \nabla_1
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \nabla_2
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ω
                          %mn 2
                        %mo ∘
                        %msub
                          %mi ω
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 1
                        %mo ,
                        %msub
                          %mi C
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ω
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 2
                        %mo ,
                        %msub
                          %mi C
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ω
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %msub
                          %mo ∇
                          %mn 3
                        %mo ,
                        %msub
                          %mi C
                          %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (\omega_2 \circ \omega_1 )
                        \:
                        (P,\nabla_1, C_1)
                        \\stackrel{\omega_1}{\to}
                        (P, \nabla_2, C_2)
                        \\stackrel{\omega_2}{\to}
                        (P, \nabla_3, C_3)
                %p is given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mn 1
                        %mo +
                        %msub
                          %mi ω
                          %mn 2
                        %mo +
                        %mo{:stretchy => "false"} ⟨
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∇
                          %mn 2
                        %mo −
                        %msub
                          %mo ∇
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∇
                          %mn 3
                        %mo −
                        %mo ∇
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\omega_1 + \omega_2 + \langle (\nabla_2-\nabla_1)\wedge(\nabla_3-\nabla2) \rangle
                        \\,.
          %p
            See (
            %a{:href => "#DiaconescuFreedMoore03"}> DFM, (3.22), (3.23)
            ).
          %p
            Here we think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as equipped with a
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian structure
            and
            %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            and think of each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ∇
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P,\nabla,C)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{E}(X)
            as inducing an degree-4 cocycle in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            with
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            4-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mrow
                      %mo ∇
                      %mo ,
                      %mi c
                  %mo =
                  %mi tr
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mn 1
                    %mn 2
                  %mi tr
                  %msub
                    %mi R
                    %mi ω
                  %mo ∧
                  %msub
                    %mi R
                    %mi ω
                  %mo +
                  %mi d
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}_{\nabla,c} = tr F_\nabla \wedge F_\nabla - \frac{1}{2} tr R_\omega \wedge R_\omega + d c
                  \\,.
          %p
            Notice that with the normalization implicit here the second terms is one half of the image of something in integral cohomology. So this is not itself a differential character, but can be regarded as “shifted differential character”: a trivialization of the trivial 5-character with global connection 4-form given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %mi tr
                    %msub
                      %mi R
                      %mi ω
                    %mo ∧
                    %msub
                      %mi R
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2} tr R_\omega \wedge R_\omega
            %a{:href => "#DFMOrientationAndFractionalClasses"} below
            for more on this.
          #DFModelHomotopyGroups.num_prop
            %h6#claim Claim
            %p
              The above groupoid has
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo ≃
                        %msubsup
                          %mi H
                          %mi diff
                          %mn 4
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0 \simeq H^4_{diff}(Y)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mo ∇
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi H
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(-,(\nabla,c)) \simeq H^2(Y, U(1))
                  \.
          %p
            The first, the set of connected components (gauge equivalence classes of
            = succeed "-fields)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            in degree 4 of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_0
            is naturally a
            %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
            over this abelian group: the torsor of
            = succeed "-shifted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %mi tr
                    %msup
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}tr R^2
          %p
            The second, the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
          %h4#DFMOrientationAndFractionalClasses Orientation and fractional classes
          %p
            Ordinarily, given a
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo ×
                    %msub
                      %mi E
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} Spin \times E_8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} P \to Y
            with first fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ≔
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\lambda \coloneqq \frac{1}{2}p_1(P)
          %p
            and second
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≔
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  a \coloneqq c_2(P)
          %p
            the
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            class in
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi dR
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi λ
                    %mi dR
                  %mo ∈
                  %msubsup
                    %mi H
                    %mi dR
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a_{dR} + \frac{1}{2} \lambda_{dR} \in H_{dR}^4(Y)
                  \\,.
          %p
            Since in general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda = \frac{1}{2}p_1(P)
            is not further divisible in integral cohomology, this means that this cannot be the curvature of any
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/differential+character"} differential character
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle with connection
          %p
            See (
            %a{:href => "#DiaconescuFreedMoore03"}> DFM 03, section 12.1
            ,
            = succeed ")" do
              %a{:href => "#FSS12"} FSS 12
          %h4#restriction_to_the_boundary Restriction to the boundary
          %p
            By
            %a{:href => "#DiaconescuFreedMoore03"} DFM, section 12
            on a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            with boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mo ∂
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X = \partial Y
            we are to impose
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo ∂
                        %mi Y
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} C|_{\partial Y} = 0
          %p
            See the discussion
            %a{:href => "#RestrictionToBoundaryInChernWeil"} below
            for how this reproduces the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            for heterotic
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            on the boundary.
          %h3#description_in_chernweil_theory
            Description in
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Some remarks on ways to regard the
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+theory"} ∞-Chern-Weil theory
          %h4#abstract_definition Abstract definition
          %p
            We shall consider the sum of two
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            fields, whose curvature is the image in de Rham cohomology of the proper integral class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi a
                  %mo −
                  %mi λ
                %annotation{:encoding => "application/x-tex"} 2 a - \lambda
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            that in the
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                %annotation{:encoding => "application/x-tex"} \mathbf{H} \coloneqq
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            the circle 3-bundles with local 3-form connection over an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} Y \in \mathbf{H}
            (for instance a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}(Y, \mathbf{B}^3 U(1))
            that is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msubsup
                            %mi H
                            %mi dR
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi curv
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 4
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}_{diff}(Y, \mathbf{B}^3 U(1)) &amp;\to&amp; H^4_{dR}(Y)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{H}(Y, \mathbf{B}^3 U(1))
                  \&amp;\stackrel{curv}{\to}&amp;
                  \\mathbf{H}(Y, \mathbf{\flat}_{dR} \mathbf{B}^4 U(1))
                  }
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            (Recall from the discussion there that if desired one may pass to the canonical presentation of this by the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            over
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            and that in this explicit presentation we may replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi dR
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^4_{dR}(Y)
            with the more familiar
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi cl
