                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^3 U(1)
            replaced by the difference of the differentially refined second
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            of
            %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            and the first fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mi Field
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C Field(Y)
            = succeed "-field," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          #AbstractDefOfCField.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} Y \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mi Field
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} C Field(Y) \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              be the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mi Field
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 4
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi Spin
                            %mo ×
                            %msub
                              %mi E
                              %mn 8
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
