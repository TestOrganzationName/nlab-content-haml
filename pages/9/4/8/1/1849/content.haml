                            %mn 1
                            %mn 48
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi p
                          %mn 2
                        %mo −
                        %mo{:stretchy => "false"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi p
                          %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi X
                          %mn 8
                        %mo{:stretchy => "false"} ]
                      %mo ⏟
                    %mrow
                      %msub
                        %mi I
                        %mn 8
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 8
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ∈
                    %mo !
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  N_{M2}
                  \\;+\;
                  \\tfrac{1}{2} \big( G_4[X^{(8)}]\big)^2
                  \\;=\;
