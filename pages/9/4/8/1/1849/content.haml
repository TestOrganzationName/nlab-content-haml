                        %mi 𝔢
                        %mn 8
                  %mo +
                  %msub
                    %mi μ
                    %mrow
                      %msub
                        %mi 𝔢
                        %mn 8
                  %mo −
                  %msub
                    %mi μ
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %mn 10
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mu \coloneqq \mu_{\mathfrak{e}_8} + \mu_{\mathfrak{e}_8} - \mu_{\mathfrak{so}(10,1)}
          %p
            for the sum of the canonical
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            with the respective
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔢
                    %mn 8
                  %mo ×
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mn 10
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{e}_8 \times \mathfrak{so}(10,1)
                  \\to \mathfrak{g}
          %p
            for the canonical
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            embedding Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
