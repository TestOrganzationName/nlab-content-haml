                            %mo ,
                            %mo{:stretchy => "false"} [
                            %munder
                              %mi lim
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi j
                                  %mo ∈
                                  %mi 𝒥
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ⊗
                            %munder
                              %mi lim
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi j
                                  %mo ∈
                                  %mi 𝒥
                            %mi Y
