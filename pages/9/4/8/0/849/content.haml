            is inherited by
            = succeed "-functors:" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
          #InternalHomPreservesLimits.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/internal+hom-functor+preserves+limits"}> internal hom-functor preserves limits
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#InternalHomBifunctor"}
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in the second variable, and sends colimits in the first variable to limits:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %munder
                      %mi lim
                      %munder
                        %mo ⟵
                        %mrow
                          %mi j
                          %mo ∈
                          %mi 𝒥
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟵
                        %mrow
                          %mi j
                          %mo ∈
                          %mi 𝒥
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [X, \underset{\underset{j \in \mathcal{J}}{\longleftarrow}}{\lim} Y(j)]
                    \\;\simeq\;
                    \\underset{\underset{j \in \mathcal{J}}{\longleftarrow}}{\lim} [X, Y(j)]
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %munder
                      %mi lim
