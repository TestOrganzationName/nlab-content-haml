                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟵
                        %mrow
