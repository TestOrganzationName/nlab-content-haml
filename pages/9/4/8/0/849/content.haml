          %h3#ExampleInSliceCategories In slice categories
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            in the slice is given by the
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            computed in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            is at
            = succeed "." do
              %em
                %a{:href => "locally%20cartesian%20closed%20category#EquivalentCharacterizations"} locally cartesian closed category – cartesian closure in terms of base change and dependent product
          %p We record some further properties
          #InverseImageBaseChangeIsCartesianClosed.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              any morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi f
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi f
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{/X}
                    \\stackrel{\overset{\sum_f}{\to}}{\stackrel{\overset{f^*}{\leftarrow}}{\underset{\prod_f}{\to}}}
                    \\mathcal{C}_{/Y}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
          %p
            This is discussed in more detail at
            = succeed "." do
              %em
                %a{:href => "cartesian+closed+functor#Examples"} cartesian closed functor – Examples
          %p
            So for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ∈
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Y
                %annotation{:encoding => "application/x-tex"} A,B \in \mathcal{C}_{/Y}
            we have
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mrow
                    %mo [
                    %mi A
                    %mo ,
                    %mi B
                    %mo ]
                  %mover
                    %mo →
                    %mo ≃
                  %mrow
                    %mo [
                    %msup
                      %mi f
                      %mo *
                    %mi A
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %mi B
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  f^* \left[A,B\right] \stackrel{\simeq}{\to} \left[f^* A , f^* B\right]
          %p
            between the image of the internal hom under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            and the internal hom of the images of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            separately.
          #MorphismFromDepProductOfFuncTypeToFuncTypeOfDepSum.num_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} A, B \in \mathbf{H}_{/X}
              two objects in the slice over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mrow
                      %mo [
                      %mi A
                      %mo ,
                      %mi B
                      %mo ]
                    %mo →
                    %mrow
                      %mo [
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi f
                      %mi A
                      %mo ,
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi f
                      %mi B
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_f \left[A,B \right] \to \left[ \sum_f A, \sum_f B\right]
                    \\,.
          %p Here are two ways to get this morphism:
          .proof
            %h6#proofconstruction_1 Proof/Construction 1
            %p
              For any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} U \in \mathbf{H}_{/Y}
              we have a canonical morphism of
              %a.existingWikiWord{:href => "/nlab/show/hom+sets"} hom sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi Y
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi f
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi X
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi U
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi X
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi U
                            %mo ×
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi Y
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi U
                            %mo ×
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo ≃
                              %mrow
                                %mi Frob
                                %mo .
                                %mi Rec
                                %mo .
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi Y
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi A
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi Y
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi A
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi B
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{/Y}( U, \prod_f [A,B] )
                    \&amp; \simeq
                    \\mathbf{H}_{/X}( f^* U, [A,B] )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}_{/X}(f^* U \times A, B)
                    \\\
                    \&amp; \stackrel{}{\to}
                    \\mathbf{H}_{/Y}( \sum_f( f^* U \times A ), \sum_f B )
                    \\\
                    \&amp; \stackrel{Frob.Rec.}{\simeq}
                    \\mathbf{H}_{/Y}( U \times \sum_f A , \sum_f B )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}_{/Y}(U, [\sum_f A , \sum_f B])
                    \\end{aligned}
            %p
              where the first and the last steps use
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              properties, where the morphism in the middle is the component of the
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              functor, and where “Frob.Rec.” is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"} Frobenius reciprocity
            %p
              Since this is
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              implies the claimed morphism.
          .proof
            %h6#proofconstruction_2 Proof/Construction 2
            %p There is the composite morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi f
                        %mo *
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi f
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mi counit
                        %mo ×
                        %msub
                          %mi id
                          %mi A
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mi eval
                    %mi B
                    %mover
                      %mo →
                      %mi unit
                    %msup
                      %mi f
                      %mo *
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\left(f^\ast \prod_f [A, B]\right) \times A \stackrel{counit \times id_A}{\to} [A, B] \times A \stackrel{eval}{\to} B \stackrel{unit}{\to} f^\ast \sum_f B
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction (co)units
              and the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              of the internal hom. Its hom-
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi f
                      %mo *
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ≅
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \to [f^\ast \prod_f [A, B], f^\ast \sum_f B] \cong f^\ast [\prod_f [A, B], \sum_f B]
                    \\,,
            %p
              using prop.
              %a.maruku-ref{:href => "#InverseImageBaseChangeIsCartesianClosed"}
              on the right. The hom-adjunct of that in turn is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi B
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \sum_f A \to [\prod_f [A, B], \sum_f B]
            %p and by symmetry the morphism that we are after:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi A
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_f [A, B] \to [\sum_f A, \sum_f B]
                    \\,.
          #RememberingTopMorphismInHomInSlice.num_remark
            %h6#remark_5 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              (for simplicity), then the morphism of prop.
              %a.maruku-ref{:href => "#MorphismFromDepProductOfFuncTypeToFuncTypeOfDepSum"}
              can be understood as follows: a
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              of the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \prod_f [A,B]
              is given by a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi A
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi f
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\sum_f A &amp;&amp;\to&amp;&amp; \sum_f B
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; X
                    }
                    \\,.
            %p
              The map in prop.
              %a.maruku-ref{:href => "#MorphismFromDepProductOfFuncTypeToFuncTypeOfDepSum"}
              picks out the top horizontal morphism in this diagram.
          %h3#for_smooth_spaces_and_smooth_groupoids
            For smooth spaces and smooth
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            (and the
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            of
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            between these.
          %p
            The
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh(C)
            is that of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
            = succeed "." do
              %em
                %a{:href => "#InASheafTopos"} In a sheaf topos
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi SmthMfd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X , Y \in SmthMfd \hookrightarrow \mathbf{H}
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} [X,Y] \in \mathbf{H}
              is the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              between them regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            %p
              See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/manifold+structure+of+mapping+spaces"} manifold structure of mapping spaces
              for when this internal hom is
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              again by a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmthMfd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in SmthMfd \hookrightarrow \mathbf{H}
              the internal automorphism group, example
              = succeed "," do
                %a.maruku-ref{:href => "#InternalAutomorphismGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism+group"} diffeomorphism group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological
              group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Aut}(X) = \mathbf{Diff}(X)
                    \\,.
          %h3#for_chain_complexes For chain complexes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/internal+hom+of+chain+complexes"} internal hom of chain complexes
          %h3#for_super_vector_spaces For super vector spaces
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            of
            %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            is the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mo +
                    %mo ,
                    %msub
                      %mi V
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V_+,V_-)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo +
                %annotation{:encoding => "application/x-tex"} V_+
            called the
            %em even
            part and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo −
                %annotation{:encoding => "application/x-tex"} V_-
            the
            %em odd
            part. The morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            are likewise pairs of linear maps, i.e. we define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo ×
                    %mi Vect
                    %mo =
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} Vect \times Vect = Vect^{\mathbb{Z}/2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sVect
                  %annotation{:encoding => "application/x-tex"} sVect
          %p
            Because the morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            send even things to even things and odd things to odd things, they are sometimes called
            %em even
            linear maps, and one may write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Even
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  sVect(V, W) = Even Lin(V,W).
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            is
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Vect
          %p
            Occasionally, however, one does need to refer to the
            %em odd
            linear maps, which send even things to odd things and odd things to even things. That is, an odd linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} V\to W
            is a pair of linear maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo +
                  %mo →
                  %msub
                    %mi W
                    %mo −
                %annotation{:encoding => "application/x-tex"} V_+ \to W_-
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo −
                    %mo →
                    %msub
                      %mi W
                      %mo +
                  %annotation{:encoding => "application/x-tex"} V_-\to W_+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            allows us to capture these as well: it is the following super vector space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo ,
                  %mi W
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo +
                  %mo =
                  %mi Even
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo ,
                  %mi W
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo −
                  %mo =
                  %mi Odd
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [V,W]_+ = Even Lin(V,W) \qquad
                  [V,W]_- = Odd Lin(V,W).
          %p
            With this definition,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            becomes a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          %p
            We can equivalently regard a super vector spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo +
                  %mo ,
                  %msub
                    %mi V
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V_+,V_-)
            as being the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo +
                  %mo ⊕
                  %msub
                    %mi V
                    %mo −
                %annotation{:encoding => "application/x-tex"} V_+ \oplus V_-
            equipped with this direct sum decomposition. If we view the internal-hom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [V,W]
            in this way as well, then we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi Even
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mi Odd
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [V, W] = Even Lin(V,W) \oplus Odd Lin(V,W) = Lin(V,W).
          %p In other words, any linear map between these “summed” super vector spaces decomposes uniquely as the sum of an even linear map and an odd one.
          %h3#for_banach_spaces For Banach spaces
          %p
            A similar thing happens in the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ban
                %annotation{:encoding => "application/x-tex"} Ban
            of
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/short+linear+operators"} short linear operators
            %em short
            linear maps (those bounded by
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ban
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %mo{:stretchy => "false"} ‖
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} Ban(V,W) = \{ f\colon Lin(V,W) \;|\; {\|f\|} \leq 1 \} .
          %p
            This definition of morphism recovers the most specific notion of
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            of Banach spaces, as well as defining the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            and
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            as the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            completed with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} p = \infty
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p = 1
            respectively.
          %p
            But the internal hom is the Banach space of
            %em all
            bounded linear maps:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Lin
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %mo{:stretchy => "false"} ‖
                  %mo &lt;
                  %mn ∞
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} [V,W] = \{ f\colon Lin(V,W) \;|\; {\|f\|} \lt \infty \} .
          %p
            This is a Banach space and makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ban
                %annotation{:encoding => "application/x-tex"} Ban
            into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hom-set"}> hom-set
                ,
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/implication"}> implication
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/linear+implication"} linear implication
            %li
              %p
