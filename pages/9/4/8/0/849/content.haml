          .proof
            %h6#proof_5 Proof
            %p
              By definition
              %a.maruku-ref{:href => "#CompositionMorphism"}
              the morphism is the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the double
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi X
                    %mo →
                    %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [Y,Z] \times [X,Y] \times X \to Z
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              of two sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A, B \in \mathbf{H}
              is computed objectwise
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                    %mo :
                    %mi U
                    %mo ↦
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \times B : U \mapsto A(U) \times B(U)
            %p
              it follows that over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              this double evaluation map is the morphism of sets/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
