          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#references"} References
          %h2#Idea Idea
          %p
            The “ZX-calculus” is an elaboration for the purpose of
            = succeed "-based" do
              %a.existingWikiWord{:href => "/nlab/show/qbit"} qbit
            %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            of the
            = succeed "-calculus" do
              %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+via+dagger-compact+categories"} quantum information theory via dagger-compact categories
          %p
            The basic idea is to formalize the co-existence of the ubiquitous pair of
            %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} measurement
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} bases
            of
            %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QBit
                    %mo ≃
                    %msup
                      %mi ℂ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} QBit \simeq \mathbb{C}^2
          %ol
            %li
              %p the “computational basis”
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %mrow
                        %mo |
                        %mn 0
                        %mo ⟩
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mrow
                        %mo |
                        %mn 1
                        %mo ⟩
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\big\{
                      \\left\vert 0 \right\rangle
                      ,\,
                      \\left\vert 1 \right\rangle
                      \\big\}
              %p
                which consists (by common convention) of the
                %a.existingWikiWord{:href => "/nlab/show/eigenstates"} eigenstates
                of the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Pauli-Z+gate"} Pauli-Z gate
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+gate"} Hadamard
                basis
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %msqrt
                            %mn 2
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mrow
                        %mo |
                        %mn 0
                        %mo ⟩
                      %mo ±
                      %mrow
                        %mo |
                        %mn 1
                        %mo ⟩
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\Big\{
                      \\tfrac{1}{\sqrt{2}}
                      \\big(
                      \\left\vert 0 \right\rangle
                      \\pm
                      \\left\vert 1 \right\rangle
                      \\big)
                      \\Big\}
              %p
                which consists of the
                %a.existingWikiWord{:href => "/nlab/show/eigenstates"} eigenstates
                of the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Pauli-X+gate"} Pauli-X gate
          %p
            by observing &amp;lbrack;
            %a{:href => "#CoeckeDuncan"}> Coecke &amp; Duncan, p. 1
            \&amp;rbrack; that:
          %ol
            %li
              %p
                either equips
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi QBit
                      %mo =
                      %msup
                        %mi ℂ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} QBit = \mathbb{C}^2
                with a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                (associated to the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                of the corresponding
                %a.existingWikiWord{:href => "/nlab/show/quantum+reader+monad"} quantum reader monad
                as originally observed by &amp;lbrack;
                %a{:href => "quantum+measurement#CoeckePavlović08"}> Coecke &amp; Pavlović (2008)
                \&amp;rbrack;);
            %li
              %p
                jointly these make a certain
                = succeed "-structure," do
                  %a.existingWikiWord{:href => "/nlab/show/bialgebra"} bialgebra
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/mutually+unbiased+bases"} mutually unbiased bases
          %p
            It is this bi-algebraic formalizaton of the interaction between the “Pauli-Z basis” and the “Pauli-X basis” for
            %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
            which gives the ZX-calculus its name.
          %p Graphically, the ZX-calculus proceeds to declare that:
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/comultiplication"} (co-)
                %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
                and
                %a.existingWikiWord{:href => "/nlab/show/counit"} (co)-
                %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
                of these two
                = succeed "-structures" do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
              %ol
                %li
                  %p in green for the Z-basis
                %li
                  %p in red for the X-basis
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+spaces"} connected
                sub-
                %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
                formed from (co-)multiplications and (co-)units all of the same color are shown as a single box/circle with the given number of in/outputs – then called
                %em spiders
              %p
                (since the
                = succeed "-property" do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
                %a{:href => "#CoeckeDuncan11"} Coecke &amp; Duncan (2011), Theorem 1
                — that any connected diagrams are equal iff they have the same number of in/outputs).
          %ul
            %li …
          %p (…)
          %h2#references References
          %p Landing page:
          %ul
            %li
              %a{:href => "https://zxcalculus.com/"} zxcalculus.com
          %p
            The ZX-calculus has its origin as a tool for organizing
            = succeed "-protocols," do
              %a.existingWikiWord{:href => "/nlab/show/measurement-based+quantum+computation"} measurement-based quantum computation
            = succeed ":" do
              %a{:href => "measurement-based+quantum+computation#DanosKahsefiPanangaden07"} Danos, Kahsefi &amp; Panangaden (2007)
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"}> Ross Duncan
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Perdrix"} Simon Perdrix
                = succeed "," do
                  %em Rewriting Measurement-Based Quantum Computations with Generalised Flow
                = succeed "," do
                  %em Automata, Languages and Programming. ICALP 2010
                = succeed "," do
                  %strong 6199
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-14162-1_24"} doi:10.1007/978-3-642-14162-1_24
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"}> Ross Duncan
                ,
                %em A graphical approach to measurement-based quantum computing
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1203.6242"} arXiv:1203.6242
                video exposition:
                %a{:href => "https://youtu.be/E_zH9C0ds8c?t=648"}> YT
                \&amp;rbrack;
          %p The official introduction of the ZX-calculus:
          %ul
            %li#CoeckeDuncan
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"} Ross Duncan
                %em A graphical calculus for quantum observables
                \&amp;lbrack;
                %a{:href => "https://www.cs.ox.ac.uk/people/bob.coecke/GreenRed.pdf"}> pdf
                \&amp;rbrack;
            %li#CoeckeDuncan08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"} Ross Duncan
                = succeed "," do
                  %em Interacting Quantum Observables
                = succeed "," do
                  %em Automata, Languages and Programming. ICALP 2008
                = succeed "," do
                  %strong 5126
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-70583-3_25"} doi:10.1007/978-3-540-70583-3_25
            %li#CoeckeDuncan11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"} Ross Duncan
                = succeed "," do
                  %em Interacting Quantum Observables: Categorical Algebra and Diagrammatics
                %strong 13
                (2011) 043016 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0906.4725"}> arXiv:0906.4725
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1367-2630/13/4/043016"} doi:10.1088/1367-2630/13/4/043016
          %p Textbook account:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefano+Gogioso"} Stefano Gogioso
              = succeed "," do
                %em Quantum in Pictures
              %a{:href => "https://www.quantinuum.com/publications"} Quantinuum Publications
              (2023) &amp;lbrack;
