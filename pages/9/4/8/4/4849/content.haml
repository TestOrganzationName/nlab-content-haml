            (…)
          %h2#properties Properties
          %h3#RelationToTheWittenGenus Relation to the Witten genus
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} U \subset \mathbb{C}
            an
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            of the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            then the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mi ch
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{ch}(U)
            of chiral differential operators on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is naturally a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+vertex+operator+algebra"} super vertex operator algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            such that its
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            and
            %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
            vanish over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/sheaf+of+vertex+operator+algebras"} sheaf of vertex operator algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mi X
                    %mi ch
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{ch}_X(-)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝒟
                    %mi X
                    %mi ch
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(\mathcal{D}^{ch}_X)
            is itself a
            %a.existingWikiWord{:href => "/nlab/show/super+vertex+operator+algebra"} super vertex operator algebra
            and its super-
            %a.existingWikiWord{:href => "/nlab/show/Kac-Weyl+character"} Kac-Weyl character
            is proportional to the
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w(X)
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi char
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝒟
                    %mi X
                    %mi ch
                  %mo{:stretchy => "false"} )
                  %mo ∝
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  char H^\bullet(\mathcal{D}^{ch}_X)\propto w(X)
                  \\,.
          %p
            Physically this result is understood by observing that
            = succeed "is" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒟
                      %mi X
                      %mi ch
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}^{ch}_X
            %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
            of the
            %a.existingWikiWord{:href => "/nlab/show/topological+twist"} topologically twisted
            %a.existingWikiWord{:href => "/nlab/show/2d+%282%2C0%29-superconformal+QFT"} 2d (2,0)-superconformal QFT
            (see there for more on this) of which the
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            is (the
            %a.existingWikiWord{:href => "/nlab/show/large+volume+limit"} large volume limit
            of) the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
          %p
            See (
            %a{:href => "#Cheung10"}> Cheung 10
            ) for a brief review (where the problem of generalizing of this construction to
            %a.existingWikiWord{:href => "/nlab/show/sheaves+of+vertex+operator+algebras"} sheaves of vertex operator algebras
            over more general
            %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            manifolds is addressed.)
          %h3#RelationToFormalLoopSpace Relation to formal loop space
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a suitable scheme, its
            %a.existingWikiWord{:href => "/nlab/show/formal+loop+space"} formal loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi inf
                  %mi X
                %annotation{:encoding => "application/x-tex"} L_inf X
            in the sense of (
            %a{:href => "#KapranovVasserotI"}> Kapranov-Vasserot I
            ) has a
            %span.newWikiWord
              Tate structure
              %a{:href => "/nlab/new/Tate+structure"} ?
            and hence an associated
            %a.existingWikiWord{:href => "/nlab/show/determinantal+gerbe"} determinantal gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Det
                    %mrow
                      %msub
                        %mi L
                        %mi inf
                      %mi X
                %annotation{:encoding => "application/x-tex"} Det_{L_{inf} X}
            with
            %a.existingWikiWord{:href => "/nlab/show/band"} band
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi L
                          %mi inf
                        %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^\ast_{L_{inf} X}
            = succeed ")" do
              %a{:href => "#KapranovVasserotIV"} Kapranov-Vasserot IV
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            is essentially identified with the
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CDO
                    %mi X
                %annotation{:encoding => "application/x-tex"} CDO_X
            of chiral differential operators on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/chiral+de+Rham+complex"}> chiral de Rham complex
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebra"} vertex operator algebra
