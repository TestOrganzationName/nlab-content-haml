          %h2#Definition Definition
          %p
          #EquivalentConditionsForIdempotency.num_prop
            %h6 Proposition
            %p
              %strong (equivalent conditions for idempotency)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi C
                    %mo ⇄
                    %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \,\colon\, C \rightleftarrows D \,\colon\, G
              be an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              with
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              and
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ε
                    %annotation{:encoding => "application/x-tex"} \varepsilon
              %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
              are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi η
                      %annotation{:encoding => "application/x-tex"} F \eta
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ε
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \varepsilon F
                  is a natural isomorphism.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mi ε
                        %mi F
                      %annotation{:encoding => "application/x-tex"} G \varepsilon F
                  is a natural isomorphism — i.e. the
                  %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                  induced by the adjunction is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                        %mi F
                        %mi η
                        %mo =
                        %mi η
                        %mi G
                        %mi F
                      %annotation{:encoding => "application/x-tex"} G F \eta = \eta G F
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                        %mi F
                        %mi η
                        %mi G
                        %mo =
                        %mi η
                        %mi G
                        %mi F
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G F \eta G = \eta G F G
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mi ε
                      %annotation{:encoding => "application/x-tex"} G\varepsilon
                  is a natural isomorphism.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \eta G
                  is a natural isomorphism.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi η
                        %mi G
                      %annotation{:encoding => "application/x-tex"} F \eta G
                  is a natural isomorphism — i.e. the
                  %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                  induced by the adjunction is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/idempotent+comonad"} idempotent comonad
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %mi G
                        %mi ε
                        %mo =
                        %mi ε
                        %mi F
                        %mi G
                      %annotation{:encoding => "application/x-tex"} F G \varepsilon = \varepsilon F G
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %mi G
                        %mi ε
                        %mi F
                        %mo =
                        %mi ε
                        %mi F
                        %mi G
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F G \varepsilon F = \varepsilon F G F
                  \.
              %li#IdempotentAdjunctionFactoredThroughFixedPoints
                %p
                  The adjunction factors through its
                  %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points
                  as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %munderover
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊥
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %munder
                            %mo ↩
                            %mrow
                              %msub
                                %mi G
                                %mn 1
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi F
                                %mn 1
                        %mi E
                        %munderover
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊥
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %munder
                            %mo ⟵
                            %mrow
                              %msub
                                %mi G
                                %mn 2
                          %mover
                            %mo ↪
                            %mrow
                              %msub
                                %mi F
                                %mn 2
                        %mi D
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        C
                        \\underoverset
                        {\underset{G_1}{\hookleftarrow}}
                        {\overset{F_1}{\longrightarrow}}
                        {\;\;\; \bot \;\;\;}
                        E
                        \\underoverset
                        {\underset{G_2}{\longleftarrow}}
                        {\overset{F_2}{\hookrightarrow}}
                        {\;\;\; \bot \;\;\;}
                        D
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} F_2
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} G_1
                  are
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 1
                        %mo ⊣
                        %msub
                          %mi G
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} F_1\dashv G_1
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mo ⊣
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} F_2 \dashv G_2
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflection
            %p
          #IdempotentAdjunction.num_defn
            %h6 Definition
            %p
              %strong (idempotent adjunction)
              %br/
              When the equivalent conditions from Prop.
              %a.maruku-ref{:href => "#EquivalentConditionsForIdempotency"}
              hold, the adjunction is said to be
              = succeed "." do
                %em idempotent
              %br/
          %p
            An original reference for the equivalence of all but the last of these conditions is
            = succeed ";" do
              %a{:href => "#MacDonaldStone82"} MacDonald &amp; Stone 1982, Prop. 2.8
            = succeed "." do
              %a{:href => "#Grandis21"} Grandis 2021, Thm. 3.8.2
            = succeed "," do
              %a{:href => "#Grandis21"} Grandis 2021, Thm. 3.8.7
          .num_remark
            %h6#remark Remark
            %p
              For an idempotent adjunction as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#IdempotentAdjunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              restrict to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between the
              %a.existingWikiWord{:href => "/nlab/show/full+images"} full images
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (which are, respectively, a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              in the last item above). In other words, for an idempotent adjunction, the category of
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points
              has a particularly simple form.
          .num_remark
            %h6#remark_2 Remark
            %p
              If an idempotent adjunction is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monadic+adjunction"} monadic
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              (i.e. the algebras for an
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comonadic+adjunction"} comonadic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              %em idempotent adjunction
              is when considering adjunctions which are neither monadic nor comonadic.
          %h2#examples Examples
          %h3#general General
          %p
          .num_remark
            %h6 Example
            %p
              Any adjunction between
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              is idempotent. This is a central fact in the theory of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Galois+connections"} Galois connections
              %em non-idempotent
              adjunctions are an important new idea arising by the “groupoidal” form of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} vertical categorification
          %p
          .num_remark
            %h6 Example
            %p
              More generally, an adjunction in which the
              %a.existingWikiWord{:href => "/nlab/show/full+image"} full image
              of either functor is a
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              must be idempotent. This follows from conditions 4, 5, 9, and 10 in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#EquivalentConditionsForIdempotency"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+kernels"} generalized kernels
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/material-structural+adjunction"} material-structural adjunction
              between
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theories
              and
              %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theories
              is idempotent. The
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed categories
              consist of the models satisfying appropriate versions of the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
              or anti-foundation.
          %p
          #CoCommaAdjunction.num_remark
            %h6 Example
            %p
              %strong ((co)comma construction)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              construction forms part of an adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cocomma
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇄
                    %mspace{:width => "thickmathspace"}
                    %mi Cospan
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi comma
                  %annotation{:encoding => "application/x-tex"}
                    cocomma
                    \\;\colon\;
                    Span(X,Y)
                    \\; \rightleftarrows \;
                    Cospan(X,Y)
                    \\;\colon\;
                    comma
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
              and
              %a.existingWikiWord{:href => "/nlab/show/cospans"} cospans
              of categories whose feet are given by categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (
              %a{:href => "#Shulman16"}> Shulman 2016
              ). This adjunction is idempotent and factors into the
              %a.existingWikiWord{:href => "/nlab/show/reflection"} reflection
              into
              %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
              %a.existingWikiWord{:href => "/nlab/show/two-sided+fibrations"} two-sided fibrations
              in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(X,Y)
              and the
              %a.existingWikiWord{:href => "/nlab/show/coreflection"} coreflection
              from
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+cofibrations"} codiscrete cofibrations
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cospan
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cospan(X,Y)
          %h3#involving_topological_spaces Involving topological spaces
          %p
          .num_remark
            %h6 Example
            %p
              The “
              %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"}> frame of opens
              ” and “space of points” functors between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              and
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
              form an idempotent adjunction. The resulting
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              is between
              %a.existingWikiWord{:href => "/nlab/show/sober+spaces"} sober spaces
              (which are reflective in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/spatial+locales"} spatial locales
              (which are coreflective in
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Loc"} Loc
          %p
          .num_remark
            %h6 Example
            %p
              For any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [O(X)^{\op}, Set]
              of
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} Top_{/X}
              of
              %a.existingWikiWord{:href => "/nlab/show/TopologicalSpaces"} TopologicalSpaces
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (the right adjoint gives the presheaf of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of a space over
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              in the modern sense of presheaves satisfying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tal%C3%A9+spaces"} étalé spaces
              = succeed "." do
                %a{:href => "http://golem.ph.utexas.edu/category/2010/02/sheaves_do_not_belong_to_algeb.html"} this blog post
          %h3#BetweenTopologicalAndDiffeologicalSpaces Between topological and diffeological spaces
          %div
            #AdjunctionBetweenTopologicalSpacesAndDiffeologicalSpaces.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+between+topological+spaces+and+diffeological+spaces"}> adjunction between topological spaces and diffeological spaces
                  )
              %p
                There is a pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              #eq:AdjointFunctorsBetweenTopSpAndDifflgSp.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TopSp
                      %munderover
                        %mrow
                          %mphantom
                            %mi AA
                          %mo ⊥
                          %mphantom
                            %mi AA
                        %munder
                          %mo ⟶
                          %mi Cdfflg
                        %mover
                          %mo ⟵
                          %mi Dtplg
                      %mi DifflgSp
                    %annotation{:encoding => "application/x-tex"}
                      TopSp
                      \\underoverset{
                      \\underset{
                      Cdfflg
                      }{\longrightarrow}
                      }{
                      \\overset{
                      Dtplg
                      }{\longleftarrow}
                      }{\phantom{AA}\bot\phantom{AA}}
                      DifflgSp
              %p
                between the
                %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                of
                %a.existingWikiWord{:href => "/nlab/show/Top"} TopologicalSpaces
                and of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/DiffeologicalSpaces"} DiffeologicalSpaces
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cdfflg
                        %annotation{:encoding => "application/x-tex"} Cdfflg
                    takes a
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    to the
                    = succeed "," do
                      %strong continuous diffeology
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi s
                        %annotation{:encoding => "application/x-tex"} X_s
                    whose plots
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi s
                          %mo →
                          %msub
                            %mi X
                            %mi s
                        %annotation{:encoding => "application/x-tex"} U_s \to X_s
                    are the
                    %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                    (from the underlying
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                    of the
                    %a.existingWikiWord{:href => "/nlab/show/domain"} domain
                    = succeed ")." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                          %annotation{:encoding => "application/x-tex"} U
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Dtplg
                        %annotation{:encoding => "application/x-tex"} Dtplg
                    takes a
                    %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                    to the
                    %strong diffeological topology
                    (
                    %a.existingWikiWord{:href => "/nlab/show/D-topology"}> D-topology
                    ), namely the
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                    with the same underlying set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi s
                        %annotation{:encoding => "application/x-tex"} X_s
                    and with the
                    %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
                    that makes all its plots
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi s
                          %mo →
                          %msub
                            %mi X
                            %mi s
                        %annotation{:encoding => "application/x-tex"} U_{s} \to X_{s}
                    into
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                    = succeed "." do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/D-topology"} D-topology
                  %p
                    Hence a
                    %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi O
                          %mo ⊂
                          %mo ♭
                          %mi X
                        %annotation{:encoding => "application/x-tex"} O \subset \flat X
                    is an
                    %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                    in the
                    %a.existingWikiWord{:href => "/nlab/show/D-topology"} D-topology
                    precisely if for each plot
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:lspace => "verythinmathspace"} :
                          %mi U
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} f \colon U \to X
                    the
                    %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %mi U
                        %annotation{:encoding => "application/x-tex"} f^{-1}(O) \subset U
                    is an
                    %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                    in the
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                          %annotation{:encoding => "application/x-tex"} U
              %p Moreover:
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points of this adjunction
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                        %annotation{:encoding => "application/x-tex"} X \in
                    %a.existingWikiWord{:href => "/nlab/show/Top"} TopologicalSpaces
                    (those for which the
                    %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
                    is an
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                    %a.existingWikiWord{:href => "/nlab/show/Delta-generated+topological+spaces"} Delta-generated topological spaces
                    (
                    %a{:href => "Delta-generated+topological+space#AsDTopologicalSpaces"} i.e.
                    = succeed "):" do
                      %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mtext is
                          %mspace{:width => "thickmathspace"}
                          %mi Δ
                          %mtext -generated
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⇔
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi Dtplg
                          %mo{:stretchy => "false"} (
                          %mi Cdfflg
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %munderover
                            %mo ⟶
                            %mo ≃
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi ϵ
                                %mi X
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                          %mi X
                        %annotation{:encoding => "application/x-tex"}
                          X \;\,\text{is}\;\Delta\text{-generated}
                          \\;\;\;\;\;
                          \\Leftrightarrow
                          \\;\;\;\;\;
                          Dtplg(Cdfflg(X))
                          \\underoverset{\simeq}{\;\;\epsilon_X\;\;}{\longrightarrow}
                          X
                %li
                  %p
                    this is an
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
                    = succeed "-generated/" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Δ
                          %annotation{:encoding => "application/x-tex"} \Delta
                    %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
                    as a
                    %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                    inside
                    %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                    and a
                    %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
                    inside all
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              #eq:DeltaGeneratedSpacesInIdempotentAdjunction.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TopologicalSpaces
                      %munderover
                        %mrow
                          %mphantom
                            %mi AA
                          %mo ⊥
                          %mphantom
                            %mi AA
                        %munder
