                %a{:href => "#references"} References
          %h2#definition Definition
          %h3#in_category_theory In category theory
          .num_defn
            %h6#definition_2 Definition
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (possibly
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              its corresponding
              %strong Čech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is given by the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with itself :
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mi ⋯
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi U
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C(U) \coloneqq
                    \\left(
                    \\cdots
                    U \times_X U \times_X U
                    \\overset{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}} U \times_X U \stackrel{\longrightarrow}{\longrightarrow} U
                    \\right)
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/internal+nerve"} internal nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              corresponding to the
              %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
              of the morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \to X
          %h3#in_category_theory_2
            In
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The notion of Čech nerve makes sense in any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-pullbacks
          %p
            Consider a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \rightarrow B
            in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+object"} augmented simplicial object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            obtained by the
            %a.existingWikiWord{:href => "/nlab/show/right+Kan+extension"} right Kan extension
            of that morphism (regarded as a functor from the obvious category into
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object"} groupoid object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mo −
                %annotation{:encoding => "application/x-tex"} \infty-
            functors.
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
          %h2#applications_and_occurences Applications and occurences
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                theory obtained by mapping out of
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+covers"} Čech covers
                instead of general
                %a.existingWikiWord{:href => "/nlab/show/hypercovers"} hypercovers
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
                that is a Čech nerve
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \to X
                exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                as a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %ul
                %li
                  In an
                  %a.existingWikiWord{:href => "/nlab/show/infinity-stack"} infinity-stack
                  %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
                  every
                  %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
                  is a Čech nerve.
          %h2#examples Examples
          #FromACover.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U = \coprod_i U_i
              the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              with respect to a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} connected components
              of the Čech nerve is the
              %a.existingWikiWord{:href => "/nlab/show/subfunctor"} subfunctor
              corresponding to the
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi i
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_0 C(U) = \bigcup_i hom(-,U_i)
                    \\,.
            %p
              This is described in more detail in the section “Interpretation in terms of higher descent and codescent” at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              %a.existingWikiWord{:href => "/nlab/show/etale+homotopy+type"} etale homotopy type
              of a scheme or more generally of objects in certain types of topos.
          .num_remark
            %h6#remark_historical_and_pedagogic_note Remark (Historical and pedagogic note)
            %p
              This example is more or less the way that
              %a.existingWikiWord{:href => "/nlab/show/Eduard+%C4%8Cech"} Eduard Čech
              gave the original form of the construction that now carries his name. More on this can be found in the entry on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+methods"} Čech methods
              = succeed "." do
                %strong nerve of an open cover
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
              is seen to extend simplicial cohomology to spaces that are locally nice. That is one of the first steps on the long route to
              = succeed "\u2018s" do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
