            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is the
              %a.existingWikiWord{:href => "/nlab/show/commutator+subgroup"} commutator subgroup
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
