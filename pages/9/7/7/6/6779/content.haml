                      %mo ≔
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi π
                        %mn 1
                      %mo ,
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)^{ab} \coloneqq \pi_1(X,x)/[\pi_1,\pi_1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
