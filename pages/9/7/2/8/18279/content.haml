          %h2#idea Idea
          %p
            It is not generally true that a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is the
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
            (
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            = succeed "." do
              %em locally connected topological spaces
          %h2#Definition Definition
          #LocallyConnected.num_defn
            %h6#definition_2 Definition
            %p
              %strong (locally connected topological space)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %strong locally connected
              if every point has a
              %a.existingWikiWord{:href => "/nlab/show/neighborhood+basis"} neighborhood basis
              of
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
          #AlternativeCharacterizationsOfLocalConnectivity.num_prop
            %h6#proposition Proposition
            %p
              %strong (alternative characterizations of local connectivity)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is locally connected (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#LocallyConnected"}
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                  of every open
                  %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is open;
              %li
                %p
                  every
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                  (
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  in
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %p
              In particular, in a locally connected space, every connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/clopen+subset"} clopen subset
          .proof
            %h6#proof Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              2)
            %p
              Assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is locally connected, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              be an open subset with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_0 \subset U
              a connected component. We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0
              is open.
            %p
              Consider any point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x \in U_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} x \in U
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyConnected"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_{x,0}
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo ∪
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0 \cup U_{x,0}
              were a larger open connected open neighbourhood, contradicting the maximality of the connected component
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} U_0
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi U
                          %mn 0
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0 = \underset{x \in U_0}{\cup} U_{x,0}
              is a union of open subsets, and hence itself open.
            %p
              2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              3)
            %p
              Now assume that every connected component of every open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is open. Since the connected components generally consitute a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint subsets
              this means that now they for an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              by disjoint subsets. But by forming intersections with the cover this implies that every open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is the disjoint union of open subsets of the connected components (and of course every union of open subsets of the connected components is still open in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of the connected components.
            %p
              3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              1)
            %p
              Finally assume that every open subspace is the disjoint union of its connected components. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              be a point and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              a neighbourhood. We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              contains a connected neighbourhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              But, by definition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              contains an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and by assumption this decomposes as the disjoint union of its connected components. One of these contains
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              all summands are open, this is the required connected open neighbourhod.
          %h2#examples Examples
          #LocallyConnectedEuclideanSpace.num_example
            %h6#example Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              is locally connected.
          #LocallyConnectedEuclideanSpace.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is locally connected)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (with its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
          .proof
            %h6#proof_2 Proof
            %p
              By nature of the Euclidean metric topology, every neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              of a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contains an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{i \in \{1, \cdots, n\}}{\prod} (x_i-\epsilon, x_i + \epsilon)
              of
              %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
              which is still a neighbourhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              Now intervals are connected (by
              = succeed ")" do
                %a{:href => "connected+space#ConnectedSubspacesOfRealLineAreTheIntervals"} this example
              = succeed ")." do
                %a{:href => "connected+space#ProductSpaceOfConnectedSpacesIsConnected"} this example
          #LocallyConnectedOpenSubspaceOfLocallyConnectedSpace.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                of locally connected space is locally connected)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of a locally connected space is itself locally connected
          .proof
            %h6#proof_3 Proof
            %p
              This is immediate from def.
              = succeed "." do
                %a.maruku-ref{:href => "#LocallyConnected"}
          .num_remark
            %h6#remark Remark
            %p
              %strong Warning
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              need not be locally connected.
          .num_example
            %h6#example_3 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topologist%27s+sine+curve"} topologist's sine curve
              is connected but not locally connected.
          %p
            Examples of locally connected spaces include
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} topological manifolds
          %p Finally,
          .num_defn
            %h6#definition_3 Definition
            %p
              A space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected topological space
              if its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              are precisely the
              %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            In other words, a space is totally disconnected if its coreflection into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocConn
                %annotation{:encoding => "application/x-tex"} LocConn
            is discrete. Such spaces recur in the study of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stone+spaces"} Stone spaces
          %p
            The category of totally disconnected spaces is a reflective subcategory of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} X/\sim
            whose points are the connected components of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} q: X \to X/\sim
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+space"} totally disconnected space
          %h2#properties Properties
          %h3#the_category_of_locally_connected_spaces The category of locally connected spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi LocConn
                  %mo ↪
                  %mi Top
                %annotation{:encoding => "application/x-tex"} i \colon LocConn \hookrightarrow Top
            be the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            inclusion of locally connected spaces into all of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #coref.num_theorem
            %h6#theorem Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocConn
                  %annotation{:encoding => "application/x-tex"} LocConn
              is a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a given space,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(X)
              has the same underlying set as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the coarsest locally connected topology that is finer than the original topology on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            Being a coreflective category of a complete and cocomplete category, the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocConn
                %annotation{:encoding => "application/x-tex"} LocConn
            is also complete and cocomplete. Of course, limits and particularly
            %em infinite
            products in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocConn
                %annotation{:encoding => "application/x-tex"} LocConn
            are not calculated as they are in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            and
            %em then
            retopologizes it according to Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#coref"}
            %em finite
            products of locally connected spaces, we can just take the product in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            – the result will be again locally connected.)
          %h3#CohesionOverSets Cohesion over sets
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi LocConn
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Gamma \colon LocConn \to Set
            be the underlying set functor, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ,
                  %mi Δ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Set
                  %mo →
                  %mi LocConn
                %annotation{:encoding => "application/x-tex"} \nabla, \Delta \colon Set \to LocConn
            be the
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            which assign to a set the same set equipped with the
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+topology"} codiscrete
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+topologies"} discrete topologies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:lspace => "verythinmathspace"} :
                  %mi LocConn
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Pi_0 \colon LocConn \to Set
            be the functor which assigns to a locally connected space the set of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                    %mo ⊣
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mo ∇
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Set
                    %mo →
                    %mi LocConn
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_0 \dashv \Delta \dashv \Gamma \dashv \nabla \colon Set \to LocConn
            %p
              and moreover, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
          %p
            While
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocConn
                %annotation{:encoding => "application/x-tex"} LocConn
            is not a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          %p
          .proof
            %h6 Proof
            %p
              The proof is largely straightforward; we point out that the continuity of the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Δ
                    %msub
                      %mi Π
                      %mn 0
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to \Delta \Pi_0 X
              is immediate from a locally connected space’s being the coproduct of its connected components. As for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              preserving finite products, write locally connected spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              as coproducts of connected spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi C
                      %mi i
                    %mo ;
                    %mspace{:width => "2em"}
                    %mi Y
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi D
                      %mi j
                    %mo ;
                  %annotation{:encoding => "application/x-tex"} X = \sum_i C_i; \qquad Y = \sum_j D_j;
            %p
              then their product in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocConn
                  %annotation{:encoding => "application/x-tex"} LocConn
              coincides with their product in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi C
                      %mi i
                    %mo ×
                    %msub
                      %mi D
                      %mi j
                  %annotation{:encoding => "application/x-tex"} X \times Y \cong \sum_{i, j} C_i \times D_j
            %p
              where each summand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi i
                    %mo ×
                    %msub
                      %mi D
                      %mi j
                  %annotation{:encoding => "application/x-tex"} C_i \times D_j
              is connected by Result
              = succeed "." do
                %a.maruku-ref{:href => "#3"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              preserves finite products.
          %p
            Accordingly the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            on a locally connected space is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          %h3#quotients_of_locally_connected_spaces Quotients of locally connected spaces
          #quot.num_lemma
            %h6#lemma Lemma
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              of a locally connected space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is also locally connected.
          .proof
            %h6#proof_4 Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} q: X \to Y
              is a quotient map, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V \subseteq Y
              be an open neighborhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y \in Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(y)
              be the connected component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(y)
              is open in
              = succeed "." do
