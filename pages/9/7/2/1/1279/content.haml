                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    (\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \alpha) \;\;\; (\alpha, \vec{\chi} \vdash_{\vec{x}\colon \vec{T}} \vec{\omega})
                    }{
                    \\vec{\phi}, \vec{\chi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \vec{\omega}
                    }\,;
            %p
              the proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              has been ‘cut’.
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/exchange+rules"} exchange rules
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo ,
                        %mi β
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi ω
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi β
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi ω
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}, \alpha, \beta, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}, \vec{\omega}
                    }{
                    \\vec{\phi}, \beta, \alpha, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}, \vec{\omega}
                    }
                    \\,
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo ,
                        %mi β
                        %mo ,
                        %mover
                          %mi ω
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi β
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi ω
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}, \alpha, \beta, \vec{\omega}
                    }{
                    \\vec{\phi}, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}, \beta, \alpha, \vec{\omega}
                    }
                    \\,;
            %p
              more generally, we may apply any
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of the antecedent and succedent (because every permutation is a
