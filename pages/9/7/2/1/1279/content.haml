                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}
                    }{
                    \\vec{\phi}, \alpha, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}
                    }
                    \\,
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
