            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              are any
              %a.existingWikiWord{:href => "/nlab/show/terms"} terms
              of the same
              %a.existingWikiWord{:href => "/nlab/show/type"} type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              in the context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{x}\colon \vec{T}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is a proposition in the context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mi T
