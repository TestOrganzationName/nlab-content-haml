                    %annotation{:encoding => "application/x-tex"} \vec{x}\colon \vec{T}
            %p
              One could (but rarely does) introduce dual
              %a.existingWikiWord{:href => "/nlab/show/apartness"} apartness
              rules.
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/universal+quantification"} universal quantification
                rules
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo{:stretchy => "false"} [
                        %mi s
                        %mo{:stretchy => "false"} /
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ∀
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mi α
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}, \alpha[s/y], \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}
                    }{
                    \\vec{\phi}, \forall(y\colon U) \alpha, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is a term of type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              in the context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{x}\colon \vec{T}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is a proposition in the
              %span.newWikiWord
                extended context
                %a{:href => "/nlab/new/extended+context"} ?
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mi T
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\vec{x}\colon \vec{T}, y\colon U)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                            %mo ,
                            %mi y
                            %mo{:lspace => "verythinmathspace"} :
                            %mi U
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ∀
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mi α
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}[\hat{y}] \vdash_{\vec{x}\colon \vec{T}, y\colon U} \vec{\psi}[\hat{y}], \alpha, \vec{\chi}[\hat{y}]
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \forall(y\colon U) \alpha, \vec{\chi}
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \phi[\hat{y}]
              is the proposition in the context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} →
                    %mo ,
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\vec{x}\colon \vec{T}, y\colon U)
              produced by
              %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening
              (in the type context) the proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              in the context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{x}\colon \vec{T}
              (and similarly for a list of propositions).
            %p
              Dually, the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
                rules
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                            %mo ,
                            %mi y
                            %mo{:lspace => "verythinmathspace"} :
                            %mi U
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ∃
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mi α
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi}[\hat{y}], \alpha, \vec{\psi}[\hat{y}] \vdash_{\vec{x}\colon \vec{T}, y\colon U} \vec{\chi}[\hat{y}]
                    }{
                    \\vec{\phi}, \exists(y\colon U) \alpha, \vec{\psi} \vdash_{\vec{x}\colon \vec{T}} \vec{\chi}
                    }
                    \\,
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo{:stretchy => "false"} [
                        %mi s
                        %mo{:stretchy => "false"} /
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ∃
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mi α
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \alpha[s/y], \vec{\chi}
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \exists(y\colon U) \alpha, \vec{\chi}
                    }
                    \\,.
          %p
            We have written the rules
            = succeed "," do
              %em additively
            %em multiplicative
            manner. This makes a difference if some of the
            %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening rule
            and
            %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction rule
            are abandoned;
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            uses both rules but for different connectives. Similarly, we have written the rules to apply as much as possible without the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exchange+rule"} exchange rule
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∖
                  %annotation{:encoding => "application/x-tex"} \setminus
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                  %annotation{:encoding => "application/x-tex"} =
            = succeed "." do
              %span.newWikiWord
                noncommutative logic
                %a{:href => "/nlab/new/noncommutative+logic"} ?
            %a.existingWikiWord{:href => "/nlab/show/left+duals"} left duals
            and
            %a.existingWikiWord{:href => "/nlab/show/right+duals"} right duals
            in a non-
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            Gentzen originally did not include
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            is defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo →
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha \to \alpha
            for any atomic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            is defined as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \neg{\top}
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∖
                  %annotation{:encoding => "application/x-tex"} \setminus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∖
                  %mi β
                %annotation{:encoding => "application/x-tex"} \alpha \setminus \beta
            to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∧
                    %mo ¬
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha \wedge \neg{\beta}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo →
                  %mi β
                %annotation{:encoding => "application/x-tex"} \alpha \to \beta
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi α
                    %mo ∨
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \neg{\alpha} \vee \beta
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
          %p
            If we use only those rules that can be stated using intuitionistic sequents, then the result is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∖
                  %annotation{:encoding => "application/x-tex"} \setminus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \to
            using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∨
                %annotation{:encoding => "application/x-tex"} \vee
            is not valid intuitionistically. On the other hand, if we include
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            (and optionally
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∖
                  %annotation{:encoding => "application/x-tex"} \setminus
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            as an axiom.)
          %p
            If we use only those rules that can be stated using minimal sequents (so necessarily leaving out
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∖
                  %annotation{:encoding => "application/x-tex"} \setminus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/minimal+logic"} minimal logic
          %h2#subformulaprop Cut-free proofs
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cut+rule"} cut rule
            expresses the composition of proofs. Gentzen’s main result (
            %a{:href => "#Gentzen"}> Gentzen, Haupsatz
            ) is that any derivation that uses the cut rule can be transformed into one that doesn’t – the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cut-elimination+theorem"} cut-elimination theorem
            %a.existingWikiWord{:href => "/nlab/show/normal+form"} normalization
            algorithm for proofs, which provided much of the inspiration behind
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Lambek"} Lambek
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and equality).
          %p
            The most important property of cut-free proofs is that every formula occurring anywhere in a proof is a subformula of a formula contained in the conclusion of the proof (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/subformula+property"} subformula property
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            or other systems.
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cut+elimination"} cut elimination
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cut+rule"} cut rule
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hypersequent+calculus"} hypersequent calculus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Hertz"} Paul Hertz
          %h2#references References
          %p Sequent calculus was introduced in
          %ul
            %li#Gentzen
              %a.existingWikiWord{:href => "/nlab/show/Gerhard+Gentzen"}> Gerhard Gentzen
              ,
              %em Untersuchungen über das logische Schließen I
              %em Mathematische Zeitschrift
              %strong 39
              1 (1935) &amp;lbrack;
              %a{:href => "http://dx.doi.org/10.1007/BF01201353"}> doi:10.1007/BF01201353
              \&amp;rbrack;
          %p which appeared in English translation as:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gerhard+Gentzen"}> Gerhard Gentzen
              ,
              = succeed "," do
                %em Investigations into Logical Deduction
              = succeed "," do
                %em The Collected Papers of Gerhard Gentzen
              = succeed "," do
                %strong 55
              = succeed "," do
                %a{:href => "https://www.sciencedirect.com/bookseries/studies-in-logic-and-the-foundations-of-mathematics/vol/55"} ISBN:978-0-444-53419-4
              = succeed "&rbrack;" do
                %a{:href => "https://logic-teaching.github.io/prop/texts/Gentzen%201969%20-%20Investigations%20into%20Logical%20Deduction.pdf"} pdf
          %p Introduction:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Downen"}> Paul Downen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Zena+M.+Ariola"} Zena M. Ariola
              = succeed "," do
                %em A tutorial on computational classical logic and the sequent calculus
              %strong 28
              (2018) e3 &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/S0956796818000023"}> doi:10.1017/S0956796818000023
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.pauldownen.com/publications/sequent-intro.pdf"} pdf
          %p Textbook accounts:
          %ul
            %li
              %p
                Morten Heine Sørensen, Pawel Urzyczyn, Chapter 7 of:
                = succeed "," do
                  %em Lectures on the Curry-Howard isomorphism
                %strong 149
                (2006) &amp;lbrack;
                %a{:href => "https://www.elsevier.com/books/lectures-on-the-curry-howard-isomorphism/sorensen/978-0-444-52077-7"}> ISBN:9780444520777
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://disi.unitn.it/~bernardi/RSISE11/Papers/curry-howard.pdf"} pdf
            %li
              %p
                Sara Negri, Jan von Plato, §1, §2 in:
                = succeed "," do
                  %em Structural Proof Theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/CBO9780511527340"} doi:10.1017/CBO9780511527340
                = succeed "," do
                  %a{:href => "https://www.logicmatters.net/resources/pdfs/NegriPlato1.pdf"} §1 pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://www.logicmatters.net/resources/pdfs/NegriPlato1.pdf"} §2 pdf
          %p
            For the basic definitions in a context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              , Defs. D1.1.5 and D1.3 in:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Sequent_calculus"} Sequent calculus
            %li
              %p
                %a{:href => "http://sakharov.net/sequent.html"} Sequent Calculus Primer
          %p
            Discussion for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
          %ul
            %li
              Stéphane Lengrand, Roy Dyckhoff, James McKinna,
              %em A Sequent Calculus for Type Theory
              (
              %a{:href => "http://hal.inria.fr/hal-00150286/"}> inria
              ,
              = succeed ")" do
                %a{:href => "http://138.251.206.45/~rd/publications/42070441.pdf"} pdf
