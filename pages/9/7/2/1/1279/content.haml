                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mi α
                        %mo ∖
                        %mi β
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    (\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \alpha)
                    \\;\;\;
                    (\beta \vdash_{\vec{x}\colon \vec{T}} \vec{\psi})
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \alpha \setminus \beta, \vec{\psi}
                    }
                    \\,.
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/equality"} equality
                rules
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mi α
                        %mo{:stretchy => "false"} [
                        %mi s
                        %mo{:stretchy => "false"} /
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo{:stretchy => "false"} [
                        %mi t
                        %mo{:stretchy => "false"} /
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo =
                        %mi t
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    (\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \alpha[s/y])
                    \\;\;\;
                    (\alpha[t/y] \vdash_{\vec{x}\colon \vec{T}} \vec{\psi})
