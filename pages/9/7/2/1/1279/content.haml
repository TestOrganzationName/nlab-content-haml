                      %mo ,
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\vec{x}\colon \vec{T}, y\colon U)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo =
                        %mi s
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, (s = s)
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is any
              %a.existingWikiWord{:href => "/nlab/show/term"} term
