                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \alpha, \alpha, \vec{\chi}
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \alpha, \vec{\chi}
                    }
                    \\,;
            %p in the absence of the exchange rule, it is important that we can remove duplications only one proposition at a time (as shown here) and only if they are adjacent (as shown here).
          %p
            Some or all of these rules may be dropped in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/substructural+logic"} substructural logic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cut+elimination"} cut elimination
          .num_defn
            %h6#rules_logical_rules Rules (logical rules)
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/truth"} truth
                rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ⊤
                        %mo ,
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    }{
                    \\vec{\phi} \vdash_{\vec{x}\colon \vec{T}} \vec{\psi}, \top, \vec{\chi}
                    }
                    \\,;
            %p that is, any sequent is valid if the necessarily true statement is in the succedent.
            %p
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"}> Dually
              , the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/falsehood"} falsehood
                rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mo ⊥
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                  %annotation{:encoding => "application/x-tex"}
