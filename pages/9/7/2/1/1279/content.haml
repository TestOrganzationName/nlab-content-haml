            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/weakening+rules"} weakening rules
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
                          %mo ⊢
                          %mrow
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:lspace => "verythinmathspace"} :
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} →
                        %mover
                          %mi χ
                          %mo{:stretchy => "false"} →
                      %mrow
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi α
                        %mo ,
                        %mover
                          %mi ψ
                          %mo{:stretchy => "false"} →
                        %msub
