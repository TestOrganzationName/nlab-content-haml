            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cut+rule"} cut rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi ϕ
                          %mo{:stretchy => "false"} →
