              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi s
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{s}
              of
              %a.existingWikiWord{:href => "/nlab/show/terms"} terms
              (of the same length as the list which is the context
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s_i
              is a term over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} T_i
              in the context
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mo *
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} a^*\phi
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} [
                      %mover
                        %mi s
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} /
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \phi[\vec{s}/\vec{x}]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by substituting each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s_i
              for the corresponding
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                    %annotation{:encoding => "application/x-tex"} x_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mo *
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} a^*\vec{\phi}
              (and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mo *
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} a^*\vec{\psi}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
