                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_0(\Omega)
                    \&amp;\overset{\langle - \rangle_\mu}{\longrightarrow}&amp;
                    \\mathbb{C}
                    \\\
                    A &amp;\mapsto&amp; \int_\Omega A \, d\mu
                    }
            %p
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Landsman17"} Landsman 2017, p. 16-17
          #ElementsOfHilbertSpaceAsPureStates.num_example
            %h6#example Example
            %p
              %strong
                (elements of a
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
                as
                %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              be a
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
              %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              with
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ≔
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} \coloneqq \mathcal{B}(\mathcal{H})
              be the algebra of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              under forming
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+operators"} adjoint operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \psi \in \mathcal{H}
              of unit
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi ψ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \langle \psi,\psi\rangle = 1
              there is the
              %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StateOnAStarAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℬ
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ⟩
                                  %mi ψ
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi ψ
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thinmathspace"}
                            %mi A
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} |
                            %mi ψ
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo ≔
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi ψ
                            %mo ,
                            %mi A
                            %mi ψ
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{B}(\mathcal{H})
                    \&amp;\overset{\langle -\rangle_\psi}{\longrightarrow}&amp;
                    \\mathbb{C}
                    \\\
                    A &amp;\mapsto&amp; \langle \psi \vert\, A \, \vert \psi \rangle &amp;\coloneqq&amp; \langle \psi, A \psi \rangle
                    }
            %p
              These are
              %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PureStateOnAStarAlgebra"}
            %p
              More general states in this case are given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/density+matrices"} density matrices
          %p
          #StatesOnGroupAlgebrasAreUnitaryRepresentations.num_remark
            %h6 Example
            %p
              %strong (states on group algebras are unitary representations)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}[G]
              its
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              regarded as a complex
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              under the combined operation of
              %a.existingWikiWord{:href => "/nlab/show/inverse+element"} inversion
              of group elements and
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            %p
              Then each state
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \rho \,\colon\,\mathbb{C}[G] \longrightarrow \mathbb{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StateOnAStarAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mtext -
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mo ⟶
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{(\text{-})} \,\colon\, \longrightarrow U(\mathscr{H})
              on a
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathscr{H}, \langle -\vert-\rangle)
              with a
              %a.existingWikiWord{:href => "/nlab/show/cyclic+vector"} cyclic vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \psi \in \mathscr{H}
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi ψ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mover
                      %mi g
                      %mo ^
                    %mo ⋅
                    %mi ψ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho(g)
                    \\;=\;
                    \\big\langle
                    \\psi
                    \\big\vert
                    \\widehat{g} \cdot \psi
                    \\big\rangle
                    \\,.
            %p
              (With suitable adjustments, this statement generalizes from discrete to
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
          %p
            This is due to
            = succeed "," do
              %a{:href => "#GelfandRaikov43"} Gelfand &amp; Raikov (1943) (2)
            %a{:href => "#Naimark56"} Naimark (1956) §30 Thm. 1
            (reviewed at
            = succeed ")" do
              %a{:href => "https://encyclopediaofmath.org/wiki/Positive-definite_function"} eom
            = succeed "," do
              %a{:href => "#Saworotnow70"} Saworotnow (1970)
            = succeed "," do
              %a{:href => "Saworotnow72"} (1972)
            = succeed "." do
              %a{:href => "#Dixmier77"} Dixmier (1977) Thm. 13.4.5 (ii)
          %h2#properties Properties
          %h3#closure_properties Closure properties
          %p
          #Mixtures.num_remark
            %h6 Example
            %p
              %strong (mixtures, convex combinations)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %msub
                        %mi ℕ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}_+
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi ρ
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒜
                        %mo →
                        %mi ℂ
                        %msubsup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi i
                            %mo =
                            %mn 1
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \big( \rho_i \colon \mathcal{A} \to \mathbb{C}  \big)_{i = 1}^k
                %p
                  be a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                  of states;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi p
                          %mi i
                        %mo ∈
                        %msub
                          %mi ℝ
                          %mrow
                            %mo ≥
                            %mn 0
                        %msubsup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi i
                            %mo =
                            %mn 1
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \big( p_i \in \mathbb{R}_{\geq 0} \big)_{i = 1}^k
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munderover
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo =
                            %mn 1
                          %mi k
                        %msub
                          %mi p
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \underoverset{i = 1}{k}{\sum} p_i \;=\; 1
                %p
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/probability+distribution"} probability distribution
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1, \cdots, k\}
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/convex+combination"} convex combination
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi p
                      %mi i
                    %mo ⋅
                    %msub
                      %mi ρ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒜
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\underoverset{i = 1}{k}{\sum} p_i \cdot \rho_i
                    \\;\;\;
                    \\in
                    \\;
                    \\mathcal{A}^\ast
            %p
              is another state on the star-algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %p
          %p
          #OperatorStateCorrespondence.num_prop
            %h6 Proposition
            %p
              %strong (operator-state correspondence)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒜
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \rho \;\colon\; \mathcal{A} \to \mathbb{C}
              a state, with a non-null observable
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} O \in \mathcal{A}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi O
                        %mo *
                      %mi O
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \rho(O^\ast O) \neq 0
            #eq:OperatorImageOfState.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi O
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi O
                            %mo *
                          %mi O
                          %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi ρ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi O
                      %mo *
                    %mo ⋅
                    %mi A
                    %mo ⋅
                    %mi O
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_O
                    \\;\colon\;
                    A
                    \\;\mapsto\;
                    \\tfrac{1}{ \rho(O^\ast O) }
                    \\cdot
                    \\rho\big( O^\ast \cdot A \cdot O \big)
            %p is a state.
            %p
          .proof
            %h6 Proof
            %p
            %p
              To check positivity
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:Positivity"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ρ
                              %mi O
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi A
                              %mo *
                            %mo ⋅
                            %mi A
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi ρ
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi O
                                    %mo *
                                  %mi O
                                  %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi O
                              %mo *
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi A
                              %mo *
                            %mo ⋅
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi O
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi ρ
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi O
                                    %mo *
                                  %mi O
                                  %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⋅
                            %mi O
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⋅
                            %mi O
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≥
                            %mn 0
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\rho_O
                    \\big(
                    A^\ast
                    \\cdot
                    A
                    \\big)
                    \&amp; =
                    \\tfrac{1}{\rho(O^\ast O)}
                    \\cdot
                    \\rho
                    \\big(
                    O^\ast
                    \\cdot
                    (
                    A^\ast
                    \\cdot
                    A
                    )
                    \\cdot
                    O
                    \\big)
                    \\\
                    \&amp; =
                    \\tfrac{1}{\rho(O^\ast O)}
                    \\cdot
                    \\rho
                    \\big(
                    (
                    A \cdot O
                    )^\ast
                    \\cdot
                    (
                    A
                    \\cdot
                    O
                    )
                    \\big)
                    \\\
                    \&amp; \geq 0
                    \\,,
                    \\end{aligned}
            %p
              where the first step is the definition
              %a.maruku-eqref{:href => "#eq:OperatorImageOfState"} (3)
              the second step uses the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/anti-homomorphisms"} anti-homomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            %p
              To check normalization
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:Normalization"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ρ
                              %mi O
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi ρ
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi O
                                    %mo *
                                  %mi O
                                  %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi O
                              %mo *
                            %mo ⋅
                            %mstyle{:mathvariant => "bold"}
                              %mn 1
                            %mo ⋅
                            %mi O
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi ρ
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi O
                                    %mo *
                                  %mi O
                                  %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi O
                              %mo *
                            %mo ⋅
                            %mi O
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\rho_O(\mathbf{1})
                    \&amp; =
                    \\tfrac{1}{\rho(O^\ast O)}
                    \\cdot
                    \\rho
                    \\big(
                    O^\ast \cdot \mathbf{1} \cdot O
                    \\big)
                    \\\
                    \&amp; =
                    \\tfrac{1}{\rho(O^\ast O)}
                    \\cdot
                    \\rho
                    \\big(
                    O^\ast \cdot O
                    \\big)
                    \\\
                    \&amp; = 1
                    \\,.
                    \\end{aligned}
            %p
          %h3#MultiplicativeStates Multiplicative states
          %p
            Recall that a state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒜
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \rho \,\colon\, \mathcal{A} \xrightarrow{\;} \mathbb{C}
            is generally only required to be a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            on the
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            of the algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            (subject only to the positivity constraint), not necessarily an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
          %p
            Those states which do respect the algebra product, in that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋅
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho(A \cdot B) = \rho(A)\, \rho(B)
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A,B \in \mathcal{A}
            = succeed "." do
              %em multiplicative
          %p
          .num_prop
            %h6 Proposition
            %p
              A multiplicative state is necessarily a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pure+state"} pure state
          (e.g.
          = succeed ";" do
            %a{:href => "#Zhu93"} Zhu 1993, Ex. 13.3
          = succeed ")" do
            %a{:href => "#Warner10"} Warner 2010, Lem. 7.20
          %p
          #OnCommutativeAlgebraPureStatesAreTheMultiplicativeStates.num_prop
            %h6 Proposition
            %p
              If the star-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative
              %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
              on it are precisely the multiplicative states.
          (e.g.
          = succeed ";" do
            %a{:href => "#Zhu93"} Zhu 1993, Ex. 13.4
          = succeed ")" do
            %a{:href => "#Warner10"} Warner 2010, Lem. 7.21
          .proof
            %h6 Proof
            %p
              The idea is that for commutative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/Gelfand+duality"} Gelfand duality
              applies and shows that a multiplicative state is equivalently the operation of point-evaluation on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+spectrum"} Gelfand spectrum
