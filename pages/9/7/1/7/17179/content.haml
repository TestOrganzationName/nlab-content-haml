                    \\stackrel{\overset{L_{lex}}{\leftarrow}}{\hookrightarrow}
                    \\mathbf{H}^{seq}
                    \\,.
          %p
            (
            %a{:href => "#Joyal08"}> Joyal 08, section 35.1
            )
          .proof
            %h6#proof Proof
            %p
              Forming degreewise
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              constitutes an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \Omega \colon \mathbf{H}^{seq} \longrightarrow \mathbf{H}^{seq}
              and by definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              this comes with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              out of the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mo ⟶
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \;\colon\; id \longrightarrow \Omega
                    \\,.
            %p
              This in turn is compatible with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∘
                    %mi Ω
                    %mo ≃
                    %mi Ω
                    %mo ∘
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo ⟶
                    %mi ρ
                    %mo ∘
                    %mi ρ
                    %mo =
                    %msup
                      %mi ρ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \circ \Omega \simeq \Omega \circ \theta
                    \\;\colon\;
                    \\rho \longrightarrow \rho \circ \rho = \rho^2
                    \\,.
            %p
              Consider then a sufficiently deep
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ρ
                        %mi tf
                    %annotation{:encoding => "application/x-tex"} \rho^{tf}
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              available in the
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              this stabilizes, and hence provides a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                      %mo ⟶
                      %mi T
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} L \;\colon\; \mathbf{H}^{seq} \longrightarrow T \mathbf{H}
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+%28%E2%88%9E%2C1%29-colimit"} filtered (∞,1)-colimit
              and since in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              these commute with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} left exact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-topos"} tangent (∞,1)-topos
          %h3#for_excisive_functors For excisive functors
          %p
            See at
            %em
              %a{:href => "n-excisive+functor#nExcisiveApproximation"} n-excisive functor – n-Excisive approximation and reflection
          %h2#construction Construction
          %h3#for_sequential_spectra_2 For sequential spectra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential
            %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pre-spectrum"} pre-spectrum
            %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
            may be constructed
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi k
                  %msup
                    %mi Ω
                    %mi k
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (L E)_n = \underset{\longrightarrow}{\lim}_k \Omega^k E_{n+k}
                  \\,.
          %p
            (
            %a{:href => "#LewisMaySteinberger86"}> Lewis-May-Steinberger 86, p. 3
            ,
            = succeed ")" do
              %a{:href => "#Weibel94"} Weibel 94, 10.9.6 and topology exercise 10.9.2
          %p
            In the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi X
                %annotation{:encoding => "application/x-tex"} E = \Sigma^\infty X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo =
                    %msup
                      %mi Σ
                      %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_n = \Sigma^n X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} (L E)_0
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+infinite+loop+space"} free infinite loop space
            construction.
          %p
            If the pre-spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is not a
            %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
            then the construction of the spectrification is more involved (
            %a{:href => "#Lewis86"}> Lewis 86
            ).
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential
            %a.existingWikiWord{:href => "/nlab/show/prespectrum"} prespectrum
            in
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            the spectrification may be constructed by (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, section 2.3
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi k
                  %mi Sing
                  %mrow
                    %msup
                      %mi Ω
                      %mi k
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi E
                        %mrow
                          %mi n
                          %mo +
                          %mi k
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"}
                  (L E)_n = \underset{\longrightarrow}{\lim}_k Sing {\Omega^k {\vert E_{n+k} \vert}}
          %p
            (i.e. by the previous formula combined with
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrant+replacement"} Kan fibrant replacement
          %p
            Generally, for sequential spectra in any
            %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
            %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            which admits a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
            = succeed ")." do
              %a{:href => "#Schwede97"} Schwede 97, section 2.1
          %p
            These spectrification functors on sequential prespectra satisfy the conditions of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+theorem"} Bousfield-Friedlander theorem
            %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
            of pre-spectra with degree-wise fibrations weak equivalences at the morphisms of prespectra that become weak equivalences under spectrification exists. This is the stable
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
          %h3#for_coordinatefree_spectra For coordinate-free spectra
          %p
            Similarly for a
            %a.existingWikiWord{:href => "/nlab/show/coordinate-free+spectrum"} coordinate-free spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi V
                  %mo ↪
                  %msup
                    %mi Ω
                    %mrow
                      %mi W
                      %mo −
                      %mi V
                  %msub
                    %mi E
                    %mi W
                %annotation{:encoding => "application/x-tex"}
                  E_V \hookrightarrow \Omega^{W-V}E_W
          %p then the spectrification is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi V
                  %mo =
                  %munder
                    %mi lim
                    %mrow
                      %mi V
                      %mo ⊂
                      %mi W
                  %msup
                    %mi Ω
                    %mrow
                      %mi W
                      %mo −
                      %mi V
                  %msub
                    %mi E
                    %mi V
                  %mspace{:width => "thinmathspace"}
                  %mo −
                %annotation{:encoding => "application/x-tex"}
                  (L E)_V = \underset{V\subset W}{\lim} \Omega^{W-V}E_V
                  \\,-
          %p
            (
            %a{:href => "#ElmendorfKrizMay95"}> Elmendorf-Kriz-May 95, p. 7
            )
          %h3#for_symmetric_spectra For symmetric spectra
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            = succeed ")." do
              %a{:href => "#Schwede12"} Schwede 12, prop. 4.39
          %h2#see_also See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/spectrification+of+a+sequential+spectrum+type"} spectrification of a sequential spectrum type
          %h2#references References
          %ul
            %li#BousfieldFriedlander78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eric+Friedlander"} Eric Friedlander
                = succeed "," do
                  %em
                    Homotopy theory of
                    = succeed "-spaces," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Gamma
                = succeed ")" do
                  %a{:href => "https://www.math.rochester.edu/people/faculty/doug/otherpapers/bousfield-friedlander.pdf"} pdf
            %li#LewisMaySteinberger86
              %p
                %a.existingWikiWord{:href => "/nlab/show/L.+Gaunce+Lewis"}> L. Gaunce Lewis
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Equivariant stable homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/equi.pdf"} pdf
            %li#Lewis86
              %p
                %a.existingWikiWord{:href => "/nlab/show/L.+Gaunce+Lewis"}> L. Gaunce Lewis
                ,
                = succeed "," do
                  %em Analysis of the passage from prespectra to spectra
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/L.+Gaunce+Lewis"} L. Gaunce Lewis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Equivariant stable homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/equi.pdf"} pdf
            %li#Weibel94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/An+introduction+to+homological+algebra"} An introduction to homological algebra
            %li#ElmendorfKrizMay95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Modern+foundations+for+stable+homotopy+theory"} Modern foundations for stable homotopy theory
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"} Ioan Mackenzie James
                (ed.),
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Algebraic+Topology"} Handbook of Algebraic Topology
                = succeed ")" do
                  %a{:href => "http://hopf.math.purdue.edu/Elmendorf-Kriz-May/modern_foundations.pdf"} pdf
            %li#Schwede97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %em Spectra in model categories and applications to the algebraic cotangent complex
                = succeed ")" do
                  %a{:href => "http://www.math.uni-bonn.de/people/schwede/modelspec.pdf"} pdf
            %li#Schwede12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                , around prop. 4.39 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Symmetric spectra
                (2012)
            %li#Joyal08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                = succeed "," do
                  %em Notes on Logoi
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/IMA/JOYAL/Joyal.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cary+Malkiewich"}> Cary Malkiewich
                ,
                %em
                  Some facts about
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Q X
