                    \\,.
            %p
              By the fact that everything is
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} 2-coskeletal
              it suffices to check that the differential in first degree
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi p
                          %mn 1
                          %mo *
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %msubsup
                          %mi p
                          %mn 2
                          %mo *
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mo ⋅
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %mi N
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
