          #FunctionsOnTwiddleD.num_defn
            %h6#definition_6 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ,
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k,n \in \mathbb{N}
              %strong
                infinitesimal
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} R^n
              based at the origin is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi ϵ
                        %mo{:stretchy => "false"} →
                      %mi a
                    %mo ∈
                    %msup
                      %mi R
                      %mi n
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (\vec \epsilon_a \in R^n)_{a = 1}^k
              of points in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi R
                        %mi n
                    %annotation{:encoding => "application/x-tex"} R^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi ϵ
                        %mo{:stretchy => "false"} →
                      %mi a
                    %mo ∼
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a : \;\; \vec \epsilon_a \sim 0
            %p and such that all are infinitesimal neighbours of each other
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi ϵ
                        %mo{:stretchy => "false"} →
                      %mi a
                    %mo −
                    %msub
                      %mover
                        %mi ϵ
                        %mo{:stretchy => "false"} →
                      %mrow
                        %mi a
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a,a': \;\; (\vec \epsilon_a - \vec \epsilon_{a'}) \sim 0
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi R
                      %mrow
                        %mi k
                        %mo ⋅
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \tilde D(k,n) \subset R^{k \cdot n}
              for the space of all such infinitesimal
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi R
                        %mi n
                    %annotation{:encoding => "application/x-tex"} R^n
          %p Equivalently:
          #FuntionsOnInfinitesimalSimplices.num_defn
            %h6#definition_7 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ,
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k,n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(\tilde D(k,n)) \in SmoothAlg
            %p
              is the unique lift through the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi SmoothAlg
                    %mo →
                    %msub
                      %mi CAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} U : SmoothAlg \to CAlg_{\mathbb{R}}
              of the commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \times n
              many generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi j
                        %mo ≤
                        %mi n
                        %mo ,
                        %mn 1
                        %mo ≤
                        %mi a
                        %mo ≤
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    (\epsilon_a^j)_{1 \leq j \leq n, 1 \leq a \leq k}
            %p subject to the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mrow
                        %mi j
                        %mo ′
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a, j,j' : \;\; \epsilon_a^{j} \epsilon_a^{j'} = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mrow
                        %mi j
                        %mo ′
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a,a',j,j'   :
                    \\;\;\;
                    (\epsilon_a^j - \epsilon_{a'}^j) (\epsilon_a^{j'} - \epsilon_{a'}^{j'}) = 0
                    \\,.
          #InterpretationOfRelations.num_remark
            %h6#remark_2 Remark
            %p
              In the above form these relations are the manifest analogs of the conditions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ϵ
                        %mo{:stretchy => "false"} →
                      %mi a
                    %mo ∼
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \vec \epsilon_a \sim 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi ϵ
                          %mo{:stretchy => "false"} →
                        %mi a
                      %mo −
                      %msub
                        %mover
                          %mi ϵ
                          %mo{:stretchy => "false"} →
                        %mrow
                          %mi a
                          %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} (\vec \epsilon_a - \vec \epsilon_{a'}) \sim 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo +
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mrow
                        %mi j
                        %mo ′
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a,a',j,j' : \;\;\;
                    \\epsilon_a^j \epsilon_{a'}^{j'}
                    + \epsilon_{a'}^j \epsilon_{a}^{j'} = 0
                    \\,.
            %p In this expression the roles of the two sets of indices is manifestly symmetric. Hence another equivalent way to state the relations is to say
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo ,
                    %mi j
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a,a', j: \;\;\;  \epsilon_a^{j} \epsilon_{a'}^j = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi j
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mi j
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\forall a,a',j,j :
                    \\;\;\;
                    (\epsilon_a^j - \epsilon_a^{j'})(\epsilon_{a'}^j - \epsilon_{a'}^{j'})
                    \= 0
          %p
            This appears as (
            %a{:href => "#Kock"}> Kock, (1.2.1)
            ).
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(k,n))
            is a
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} Weil algebra
            in the sense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            (as discussed there) and we may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tilde D(k,n)
            as an infinitesimal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+locus"} smooth locus
          #examplen2k2.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(2,2))
              consists of elements of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi f
                            %mo +
                            %mi a
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 1
                            %mo +
                            %mi b
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 2
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi ω
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi f
                            %mo +
                            %msub
                              %mi a
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 1
                            %mo +
                            %msub
                              %mi a
                              %mn 2
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 2
                            %mo +
                            %msub
                              %mi b
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 2
                              %mn 1
                            %mo +
                            %msub
                              %mi b
                              %mn 2
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ω
                              %mn 1
                            %msub
                              %mi λ
                              %mn 2
                            %mo −
                            %msub
                              %mi ω
                              %mn 2
                            %msub
                              %mi λ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mfrac
                              %mn 1
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 2
                              %mn 2
                            %mo −
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 2
                            %msubsup
                              %mi ϵ
                              %mn 2
                              %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    f
                    +
                    a \cdot \epsilon_1
                    + b \cdot \epsilon _2
                    + (\omega \cdot \epsilon_1) (\lambda \cdot \epsilon_2)
                    \&amp;=
                    f +
                    a_1 \epsilon_1^1
                    + a_2 \epsilon_1^2
                    + b_1 \epsilon_2^1
                    + b_2 \epsilon_1^2
                    \\\
                    \&amp; + (\omega_1 \lambda_2 - \omega_2 \lambda_1)
                    \\frac{1}{2}(\epsilon_1^1 \epsilon_2^2 - \epsilon_1^2 \epsilon_2^1)
                    \\end{aligned}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \in \mathbb{R}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi ω
                    %mo ,
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a, b, \omega, \lambda \in (\mathbb{R}^n)^*)
              a collection of ordinary covectors and with “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
              ” denoting the evident contraction, and where in the last step we used the above relations.
            %p
              It is noteworthy here that the coefficient of the term which is multilinear in each of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \epsilon_i
              is the
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              of two
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/covector"} covector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(2,2))
              on those elements that vanish if either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \epsilon_1
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \epsilon_2
              are set to 0 as the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mn 2
                    %msubsup
                      %mi T
                      %mn 0
                      %mo *
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \wedge^2 T_0^* \mathbb{R}^2
              of 2-forms at the origin of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %p Of course for this identification to be more than a coincidence we need that this is the beginning of a pattern that holds more generally. But this is indeed the case.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
