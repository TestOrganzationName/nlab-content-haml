              its image in the standard presentation for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %msub
