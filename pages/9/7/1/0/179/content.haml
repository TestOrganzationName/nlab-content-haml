                      %msubsup
                        %mi 𝔞
                        %mn 0
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo ⊕
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi 𝔞
                        %mn 0
                        %mo *
                      %msub
                        %mo ∧
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %msubsup
                        %mi 𝔞
                        %mn 0
                        %mo *
                      %mo ⊕
                      %msubsup
                        %mi 𝔞
                        %mn 1
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ⊕
                      %mspace{:width => "thickmathspace"}
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"}
                      \\wedge^\bullet_{C^\infty(X)}\mathfrak{a}^* =
                      C^\infty(X)
                      \\; \oplus \;
                      \\mathfrak{a}^*_0
                      \\; \oplus \;
                      (
                      \\mathfrak{a}^*_0 \wedge_{C^\infty(X)} \mathfrak{a}^*_0
                      \\oplus
                      \\mathfrak{a}^*_1
                      )
                      \\; \oplus \; \cdots
              %p
                with the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
          #LInfinityAlgebras.num_defn
            %h6#definition_3 Definition
            %p
              An
              = succeed "-algebroid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X = *
              the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              is an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of an
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} b \mathfrak{g}
              for
              = succeed "-algebroids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mo ↪
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_\infty Alg \hookrightarrow L_\infty Algd
                    \\,.
          %p
            We now construct an embedding of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                  %mi Algs
                %annotation{:encoding => "application/x-tex"} L_\infty Algs
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} SynthDiff\infty Grpd
          %p The functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo :
                  %msubsup
                    %mi Ch
                    %mo +
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi Vect
                    %mi ℝ
                    %mi Δ
                %annotation{:encoding => "application/x-tex"}
                  \\Xi : Ch^\bullet_+(\mathbb{R}) \to Vect_{\mathbb{R}}^{\Delta}
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            from non-negatively graded
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            vector spaces is a
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
            and hence induces (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo :
                  %msubsup
                    %mi dgAlg
                    %mi ℝ
                    %mo +
                  %mo →
                  %msubsup
                    %mi Alg
                    %mi ℝ
                    %mi Δ
                %annotation{:encoding => "application/x-tex"}
                  \\Xi : dgAlg_{\mathbb{R}}^+ \to Alg_{\mathbb{R}}^{\Delta}
          %p
            from non-negatively graded cochain
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial algebra
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          #PresentationByMonoidalDoldKan.num_defn
            %h6#definition_4 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo :
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi CAlg
                      %mi ℝ
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\Xi : L_\infty Algd \to (CAlg_{\mathbb{R}}^\Delta)^{op}
            %p
              for the restriction of the above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                  %annotation{:encoding => "application/x-tex"} \Xi
              along the inclusion
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                      %mi Algd
                      %mo ↪
                      %msubsup
                        %mi dgAlg
                        %mi ℝ
                        %mi op
                    %annotation{:encoding => "application/x-tex"} L_\infty Algd \hookrightarrow dgAlg^{op}_{\mathbb{R}}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} \in L_\infty Algd
              the underlying cosimplicial vector space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Xi \mathfrak{a}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mi 𝔞
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\Xi \mathfrak{a}
                    \:
                    [n]
                    \\mapsto
                    \\bigoplus_{i = 0}^{n}
                    CE(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
            %p
              and the product of the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (\omega,x), (\lambda,y) \in CE(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
              in the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ∧
                    %mi λ
                    %mo ,
                    %mi x
                    %mo ∧
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\omega , x)\cdot (\lambda ,y) = (\omega \wedge \lambda , x \wedge y)
                    \\,.
            %p
              (Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Xi \mathfrak{a}
              is indeed a
              %em commutative
              cosimplicial algebra, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\omega,x)
              are by definition in the same degree.)
            %p
              To define the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mi j
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo =
                        %mn 0
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{e_j\}_{j = 0}^n
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and consider also the basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi j
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo =
                        %mn 0
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{v_j\}_{j = 0}^n
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi j
                    %mo :
                    %mo =
                    %msub
                      %mi e
                      %mi j
                    %mo −
                    %msub
                      %mi e
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_{j} := e_j - e_{0}
                    \\,.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi l
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \alpha : [k] \to [l]
              a morphism in the
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              category, set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %msub
                      %mi v
                      %mi j
                    %mo :
                    %mo =
                    %msub
                      %mi v
                      %mrow
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi v
                      %mrow
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha v_j := v_{\alpha(j)} - v_{\alpha(0)}
            %p
              and extend this skew-multilinearly to a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi ℝ
                        %mi k
                      %mo →
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi ℝ
                        %mi l
                    %annotation{:encoding => "application/x-tex"} \alpha : \wedge^\bullet \mathbb{R}^k \to \wedge^\bullet \mathbb{R}^l
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              on homogeneous elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\omega,x)
              in the cosimplicial algebra is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi 𝔞
                    %mi ω
                    %mo ,
                    %msub
                      %mi v
                      %mrow
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha :
                    (\omega, x)
                    \\mapsto
                    (\omega, \alpha x) + (d_\mathfrak{a} \omega , v_{\alpha(0)}\wedge \alpha(x))
          %p
            This is due to (
            %a{:href => "#CastiglioniCortinas"}> CastiglioniCortinas, (1), (2), (20), (22)
            ).
          %p
            We shall refine the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                %annotation{:encoding => "application/x-tex"} \Xi
            to cosimplicial
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mo =
                %annotation{:encoding => "application/x-tex"} T :=
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi smooth
                %annotation{:encoding => "application/x-tex"} {}_{smooth}
            be the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothAlg
                  %mo :
                  %mo =
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"}
                  SmoothAlg := T Alg
          %p
            for its category of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+Lawvere+theory"} algebras
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
          %p
            Notice that there is a canonical
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi SmoothAlg
                  %mo →
                  %msub
                    %mi CAlg
                    %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  U : SmoothAlg \to CAlg_{\mathbb{R}}
          %p
            to the category of
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} comutative associative algebras
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          #SmoothMonoidalDoldKan.num_prop
            %h6#proposition Proposition
            %p
              There is a unique factorization of the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo :
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi CAlg
                      %mi ℝ
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Xi : L_\infty Algd \to (CAlg_{\mathbb{R}}^\Delta)^{op}
              from def.
              %a.maruku-ref{:href => "#PresentationByMonoidalDoldKan"}
              through the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi SmoothAlg
                      %mi ℝ
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi CAlg
                      %mi ℝ
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (SmoothAlg_{\mathbb{R}}^\Delta)^{op} \to (CAlg_{\mathbb{R}}^\Delta)^{op}
              such that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              over base space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the degree-0 algebra of smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              lifts to its canonical structure as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi SmoothAlg
                              %mi Δ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi U
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mn ∞
                            %mi Algd
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi CAlg
                              %mi ℝ
                              %mi Δ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; (SmoothAlg^{\Delta})^{op}
                    \\\
                    \&amp; \nearrow &amp; \downarrow^{\mathrlap{U}}
                    \\\
                    L_\infty Algd &amp;\to&amp; (CAlg_{\mathbb{R}}^\Delta)^{op}
                    }
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Observe that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              the algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ξ
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (\Xi \mathfrak{a})_n
              is a finite nilpotent extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
              %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
              to write every smooth function of sums as a finite Taylor expansion with a smooth rest term. See the examples at
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              for more details on this kind of argument.
          #EmbeddingOfThePresentation.num_defn
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mo →
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} i : L_\infty Algd \to SynthDiff\infty Grpd
              for the composite
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mover
                      %mo →
                      %mi Ξ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi SmoothAlg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mover
                      %mo →
                      %mi j
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi synthdiff
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mi P
                        %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi synthdiff
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi loc
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo ≃
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    L_\infty Algd
                    \\stackrel{\Xi}{\to}
                    (SmoothAlg^{\Delta})^{op}
                    \\stackrel{j}{\to}
                    [CartSp_{synthdiff}^{op}, sSet]
                    \\stackrel{P Q}{\to}
                    ([CartSp_{synthdiff}^{op}, sSet]_{loc})^\circ
                    \\simeq
                    SynthDiff\infty Grpd
                    \\,,
            %p
              where the first morphism is the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothMonoidalDoldKan"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P Q
              is any fibrant-cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              functor in the local
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} models for ∞-stack (∞,1)-toposes
          #RemarkOnModelStructure.num_remark
            %h6#remark Remark
            %p
              We do not consider the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on dg-algebras
              and do not consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} L_\infty Algd
              itself as a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and do not consider an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              spanned by it. Instead, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                    %mo →
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} i : L_\infty Algd \to SynthDiff\infty Grpd
              only serves to exhibit a class of objects in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SynthDiff
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} SynthDiff\infty Grpd
              %a{:href => "#ModelsForTheAbstractAxioms"} Models for the abstract axioms
              we show are indeed
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %a.maruku-ref{:href => "#TheGeneralAbstractDefinition"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} L_\infty Algd
              is that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} SynthDiff\infty Grpd
              after this embedding.
          %h3#GeneralAbstractDefinition General abstract definition
          %p
            We may abstractly formalize this in an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            with
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            as follows.
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
            is equivalently an
            %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            Now an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            A groupoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⟶
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} p \colon X \longrightarrow \mathcal{G}
            is
            %em infinitesimal
            if under the
            %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℜ
                %annotation{:encoding => "application/x-tex"} \Re
            (equivalently under the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            becomes an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Equiv
                  %annotation{:encoding => "application/x-tex"} \Re(p), \Im(p) \in Equiv
          %p
            For example the tangent
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            of any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi η
                    %mi X
                    %mi ℑ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                  %mi ℑ
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta^{\Im}_X \;\colon\; X \stackrel{}{\longrightarrow} \Im X
                  \\,.
          %p
            It follows that every such
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} X \to \mathcal{G}
            canonically maps to the tangent
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – the
            = succeed "." do
              %em anchor map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi η
                    %mi p
                    %mi ℑ
                %annotation{:encoding => "application/x-tex"} \eta^{\Im}_{p}
            exhibits the morphism:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi id
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msubsup
                                  %mi η
                                  %mi X
                                  %mi ℑ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi ℑ
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msubsup
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                            %mpadded{:width => "0"}
                              %mrow
                                %mi ℑ
                                %mi p
                      %mtr
                        %mtd
                          %mi 𝒢
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msubsup
                                %mi η
                                %mi 𝒢
                                %mi ℑ
                        %mtd
                          %mi ℑ
                          %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \stackrel{id}{\longrightarrow} &amp; X
                  \\\
                  \\downarrow^{\mathrlap{p}} &amp;&amp; \downarrow^{\mathrlap{\eta^\Im_X}}
                  \\\
                  \&amp;&amp;  \Im X
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{\Im p}}_\simeq
                  \\\
                  \\mathcal{G}
                  \&amp;\stackrel{\eta^{\Im}_{\mathcal{G}}}{\longrightarrow}&amp; \Im \mathcal{G}
                  }
          %h2#properties Properties
          %h3#general General
          #prop.num_prop
            %h6#proposition_2 Proposition
            %p
              The full subcategory category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mo ↪
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} L_\infty Alg \hookrightarrow L_\infty Algd
              from def.
              %a.maruku-ref{:href => "#LInfinityAlgebras"}
              is equivalent to the traditional definition of the category of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            %p
              The full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlgd
                    %mo ↪
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} LieAlgd \hookrightarrow L_\infty Algd
              on the 1-truncated objects is equivalent to the traditional category of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              In particular the joint intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mi Alg
                    %mo ↪
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} Lie Alg \hookrightarrow L_\infty Alg
              on the 1-truncated
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          %p
            This is discussed in detail at
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
          %h3#ModelsForTheAbstractAxioms Models for the abstract axioms
          %p
            Above we have given a general abstract definition, def.
            = succeed "," do
              %a.maruku-ref{:href => "#TheGeneralAbstractDefinition"}
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            = succeed "." do
              %a.maruku-ref{:href => "#PresentationByMonoidalDoldKan"}
          %p
            As in the discussion at
            %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
            we now present this
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            by the
            %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
            of the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi FSmoothDiff
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                %annotation{:encoding => "application/x-tex"} [FSmoothDiff^{op}, sSet]_{proj,loc}
            of formal smooth manifolds.
          #CofibrantResolutionOfLinfinityAlgebroid.num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ∈
                    %msub
