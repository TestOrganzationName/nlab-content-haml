          .proof
            %h6#proof_10 Proof
            %p
              By the
              %a{:href => "#spring"} above discussion
              we have that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
