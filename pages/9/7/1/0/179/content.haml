                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \:
                    C^\infty(\tilde D(k,n))
                    \\stackrel{\simeq}{\to}
                    \\oplus_{i = 0}^n (\wedge^i \mathbb{R}^k) \otimes (\wedge^i \mathbb{R}^n)
                    \\,,
            %p
              where on the right we have the algebras that appear degreewise in def.
              = succeed "," do
                %a.maruku-ref{:href => "#PresentationByMonoidalDoldKan"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ∧
                    %mi λ
                    %mo ,
                    %mi x
                    %mo ∧
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\omega, x) \cdot (\lambda, y) = (\omega \wedge \lambda , x \wedge y)
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_a\}
              be the canonical basis for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e^i\}
              the canonical basis for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi i
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi a
                    %mo ,
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : \epsilon^i_a \mapsto (t_a , e^i)
                    \\,.
            %p To see that this defines indeed an algebra homomorphism we need to check that it respects the relations on the generators. For this compute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ϵ
                              %mi a
                              %mi i
                            %msubsup
                              %mi ϵ
                              %mrow
                                %mi a
                                %mo ′
                              %mrow
                                %mi i
                                %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi t
                              %mi a
                            %mo ∧
                            %msub
                              %mi t
                              %mrow
                                %mi a
                                %mo ′
                            %mo ,
                            %msup
                              %mi e
                              %mi i
                            %mo ∧
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi t
                              %mrow
                                %mi a
                                %mo ′
                            %mo ∧
                            %msub
                              %mi t
                              %mi a
                            %mo ,
                            %msup
                              %mi e
                              %mi i
                            %mo ∧
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ϵ
                              %mrow
                                %mi a
                                %mo ′
                              %mi i
                            %msubsup
                              %mi ϵ
                              %mi a
                              %mrow
                                %mi i
                                %mo ′
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi(\epsilon_a^i \epsilon_{a'}^{i'})
                    \&amp; =
                    (t_a \wedge t_{a'}, e^i \wedge e^{i'})
                    \\\
                    \&amp; =
                    \-(t_{a'} \wedge t_{a}, e^i \wedge e^{i'})
                    \\\
                    \&amp; = -\phi(\epsilon_{a'}^i \epsilon_{a}^{i'})
                    \\end{aligned}
                    \\,.
            %p The inverse clearly exists, given on generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi a
                    %mo ,
                    %msup
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msubsup
                      %mi ϵ
                      %mi a
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^{-1} : (t_a, e^i) \mapsto \epsilon_a^i
                    \\,.
          #SimplicialSmoothLocusOfLieAlgebroid.num_cor
            %h6#corollary_2 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} \in L_\infty Alg
              a 1-truncated object, hence an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              of rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              over a base manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %msub
                        %mi L
                        %mn ∞
                      %mi Alg
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi SmoothAlg
                        %mi Δ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} i : L_\infty Alg \to (SmoothAlg^\Delta)^{op}
              = succeed "," do
                %a.maruku-ref{:href => "#EmbeddingOfThePresentation"}
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              is, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi U
                    %mo ×
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i(\mathfrak{a})|_U : [n] \mapsto U \times \tilde D(k,n)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Apply prop.
              %a.maruku-ref{:href => "#TwiddleDsAsDOldKan"}
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#PresentationByMonoidalDoldKan"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
              is given by the exterior algebra on locally free
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              modules, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∧
                              %mrow
                                %msup
                                  %mi C
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                              %mo •
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi ℝ
                              %mi k
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo ,
                            %msub
                              %mi d
                              %mrow
                                %mi 𝔞
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mo ∧
                              %mo •
                            %msup
                              %mi ℝ
                              %mi k
                            %mo ,
                            %msub
                              %mi d
                              %mrow
                                %mi 𝔞
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mi U
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    CE(\mathfrak{a}|_U)
                    \&amp; \simeq
                    (\wedge^\bullet_{C^\infty(U)} \Gamma(U\times \mathbb{R}^k)^*, d_{\mathfrak{a}|_U})
                    \\\
                    \&amp; \simeq
                    (C^\infty(U) \otimes \wedge^\bullet \mathbb{R}^k, d_{\mathfrak{a}|_U})
                    \\end{aligned}
                    \\,.
          %h4#TangentLieAlgebroid Tangent Lie algebroid
          %p
