          #InfinitesimalSingularSimplicialComplex.num_defn
            %h6#definition_8 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %msub
                        %mi CartSp
                        %mi synthdiff
                    %annotation{:encoding => "application/x-tex"} U \in CartSp_{synthdiff}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+singular+simplicial+complex"} infinitesimal singular simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Δ
                          %mi inf
