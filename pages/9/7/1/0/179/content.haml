                    \\right)
                    \\stackrel{\simeq}{\to}
                    i(\mathfrak{a})
            %p
              is a cofibrant
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta} : \Delta \to sSet
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
          .proof
            %h6#proof_2 Proof
            %p We have
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
                  is cofibrant in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Δ
                          %mo ,
                          %msub
                            %mi sSet
                            %mi Quillen
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi proj
                        %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{proj}
              %li
                %p
                  The canonical morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mo →
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \mathbf{\Delta} \to \Delta
                  is a weak equivalence between cofibrant objects in the
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Δ
                          %mo ,
                          %msub
                            %mi sSet
                            %mi Quillen
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi Reedy
                        %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{Reedy}
              %li
                %p
                  Because every representable
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FSmoothMfd
                        %mo ↪
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi FSmoothMfd
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi loc
                      %annotation{:encoding => "application/x-tex"} FSmoothMfd \hookrightarrow [FSmoothMfd^{op}, sSet]_{proj,loc}
                  is cofibrant, the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo •
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Δ
                          %mi op
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi FSmoothMfd
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi loc
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi inj
                      %annotation{:encoding => "application/x-tex"} i(\mathfrak{a})_\bullet \in [\Delta^{op}, [FSmoothMfd^{op}, sSet]_{proj,loc} ]_{inj}
                  is cofibrant.
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
                  is cofibrant regarded as an object
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Δ
                            %mi op
                          %mo ,
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi FSmoothMfd
                            %mi op
                          %mo ,
                          %mi sSet
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi inj
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi Reedy
                        %annotation{:encoding => "application/x-tex"} [\Delta^{op}, [FSmoothMfd^{op}, sSet]_{inj}]_{Reedy}
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              over the
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[k] \in \Delta}
                    
                    (-)\cdot (-)
                    \:
                    [\Delta, sSet_{Quillen}]_{proj}
                    \\times
                    [\Delta^{op}, [FSmoothMfd^{op}, sSet]_{proj,loc} ]_{inj}
                    \\to
                    [FSmoothMfd^{op}, sSet]_{proj,loc}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              (as discussed there) for the projective and injective
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on functors
              on the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              and its opposite as indicated. This implies the cofibrancy.
            %p
              It is also a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              (as discussed there) for the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi FSmoothMfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[k] \in \Delta}
                    (-)\cdot (-)
                    \:
                    [\Delta, sSet_{Quillen}]_{Reedy}
                    \\times
                    [\Delta^{op}, [FSmoothMfd^{op}, sSet]_{inj} ]_{Reedy}
                    \\to
                    [FSmoothMfd^{op}, sSet]_{inj}
                    \\,.
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              this implies the weak equivalence (this is the argument of the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan map
          #LInftyAlgIsInfinitesimalObject.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "-algebroid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi 𝔤
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %mi Algd
                  %annotation{:encoding => "application/x-tex"} b \mathfrak{g} \in L_\infty Algd
              over the point by the embedding of def.
              = succeed "." do
                %a.maruku-ref{:href => "#LInfinityAlgebras"}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} i(b \mathfrak{g}) \in
              %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              is an
              = succeed "," do
                %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#LieAlgebras"} infinitesimal cohesive object
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#Homotopy"} geometrically contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi b
                    %mi 𝔤
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi b \mathfrak{g} \simeq *
            %p
              and has as underlying
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
              the point
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi b
                    %mi 𝔤
                    %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma b \mathfrak{g} \simeq *
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              We present now
              %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              by the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi synthdiff
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp_{synthdiff}^{op}, sSet]_{proj,loc}
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi synthdiff
                  %annotation{:encoding => "application/x-tex"} {}_{synthdiff}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              we have by the discussion there that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is presented by the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mi lim
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \mathbb{L} \lim\to
              of the degreewise
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is presented by the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of evaluation on the point.
            %p
              With lemma
              %a.maruku-ref{:href => "#CofibrantResolutionOfLinfinityAlgebroid"}
              we can evaluate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi 𝕃
                            %munder
                              %mi lim
                              %mo →
                            %mo{:stretchy => "false"} )
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mo →
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %munder
                              %mi lim
                              %mo →
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\mathbb{L} \lim_\to) i(b\mathfrak{g})
                    \&amp; \simeq
                    \\lim_\to \int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot
                    (b \mathfrak{g})_{k}
                    \\\
                    \&amp; \simeq
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot
                    \\lim_\to (b \mathfrak{g})_{k}
                    \\\
                    \&amp; =
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot *
                    \\end{aligned}
                    \\,,
            %p
              because each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ∈
                    %mi InfPoint
                    %mo ↪
                    %msub
                      %mi CartSp
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} (b \mathfrak{g})_n \in InfPoint \hookrightarrow CartSp_{smooth}
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
            %p
              That this is equivalent to the point follows from the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
