                    \\stackrel{p_1^* + p_2^* - (\cdot)^*}{\to}
                    N C^\infty(\tilde D(2,dim(G)))
            %p
              is indeed the dual of the Lie bracket. But the product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋅
                      %mi G
                    %mo :
                    %mi G
                    %mo ×
                    %mi G
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \cdot_G : G \times G \to G
              restricted along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi G
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \tilde D(2,dim(G)) \hookrightarrow G \times G
              to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde D(2, dim(G))
              linearizes in each of its arguments: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\vec x,\vec y) \in \tilde D(2,dim(G))
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %msub
                      %mo ⋅
                      %mi G
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo =
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo ⋅
                    %msub
                      %mo ∇
                      %mi x
                    %msub
                      %mo ⋅
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo ⋅
                    %msub
                      %mo ∇
                      %mi y
                    %msub
                      %mo ⋅
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo ⋅
                    %msub
                      %mo ∇
                      %mi x
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo ⋅
                    %msub
                      %mo ∇
                      %mi y
                    %msub
                      %mo ⋅
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vec x \cdot_G \vec y =
                    \\vec x \cdot \nabla_x \cdot_G (0,0)
                    +
                    \\vec y \cdot \nabla_y \cdot_G (0,0)
                    +
                    \\vec x \cdot \nabla_x
                    \\vec y \cdot \nabla_y \cdot_G(0,0)
                    \\,.
            %p
              Since the origin here corresponds to the neutral element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and since with one of its arguments the neutral element the operaton
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋅
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \cdot_G
              is the identity, and since the double derivative produces the Lie bracket (keeping in mind that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mo +
                    %msup
                      %mi x
                      %mi j
                    %msup
                      %mi y
                      %mi i
                    %mo =
                    %mn 0
