                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    H^n N^\bullet
                    \\left(
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot \mathcal{O}(i(\mathfrak{a})_k)
                    \\right)
                    \\,.
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\mathfrak{a})_\bullet
              is cofibrant in the
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi SmoothAlg
                      %mrow
                        %msub
                          %mi Δ
                          %mi proj
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, (SmoothAlg^{\Delta_{proj}})^{op}]_{Reedy}
              relative to the opposite of the projective
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+algebras"} model structure on cosimplicial algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi SmoothAlg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} SmoothAlg^\Delta)^{op}
              is dually in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothAlg
                    %mo ↪
                    %msup
                      %mi SmoothAlg
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} SmoothAlg \hookrightarrow SmoothAlg^\Delta
              the projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %msubsup
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo ⊗
                    %msup
                      %mo ∧
                      %mi i
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{i = 0}^n CE(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
                    \\to
                    \\oplus_{i = 0}^{n-1} CE(\mathfrak{a})_i \otimes \wedge^i \mathbb{R}^n
            %p
              hence is a surjection, hence a fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi SmoothAlg
                      %mi proj
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} SmoothAlg^\Delta_{proj}
              and therefore indeed a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi SmoothAlg
                        %mi proj
                        %mi Δ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (SmoothAlg^\Delta_{proj})^{op}
            %p
              Therefore using the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              property of the coend over the tensoring in reverse to lemma
              %a.maruku-ref{:href => "#CofibrantResolutionOfLinfinityAlgebroid"}
              the above is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %msup
                      %mi N
                      %mo •
                    %mrow
                      %mo (
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\simeq
                    H^n N^\bullet
                    \\left(
                    \\int^{[k] \in \Delta} \Delta[k] \cdot \mathcal{O}(i(\mathfrak{a})_k)
                    \\right)
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
              replaced again by the ordinary simplex. But in brackets this is now by definition the image under the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mo •
                    %mi Ξ
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\simeq
                    H^n( N^\bullet \Xi CE(\mathfrak{a}) )
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              we have hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    H^n(CE(\mathfrak{a}))
                    \\,.
