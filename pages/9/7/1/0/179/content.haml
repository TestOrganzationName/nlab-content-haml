                        %mi k
                      %mo )
                    %mover
                      %mo →
                      %mo ≃
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\int^{[k]\in \Delta}
