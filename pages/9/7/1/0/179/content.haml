          .proof
            %h6#proof_9 Proof
            %p
              The first statement may be checked locally on any
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
