          .proof
            %h6#proof_5 Proof
            %p
              By
              %a{:href => "http://nlab.mathforge.org/nlab/show/synthetic+differential+infinity-groupoid#StrucCohomology"} this discussion
              at
              %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
