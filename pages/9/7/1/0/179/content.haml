            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo +
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} ]
