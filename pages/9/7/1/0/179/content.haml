                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, (\vec \epsilon_a)_{a = 1, \cdots, dim U})
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
