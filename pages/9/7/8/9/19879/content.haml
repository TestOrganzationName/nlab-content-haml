                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi Γ
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo{:stretchy => "false"} )
