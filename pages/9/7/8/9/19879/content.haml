                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %annotation{:encoding => "application/x-tex"} \⟦\Gamma\⟧
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ⊢
                    %mi S
                    %mo ≡
                    %mi T
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \vdash S \equiv T : A
              is derivable, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
