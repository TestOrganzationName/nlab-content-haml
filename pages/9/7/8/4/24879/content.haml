          %h3#dependently_sorted_allegorical_zfc Dependently sorted allegorical ZFC
          %p
            Allegorical ZFC follows
            %a.existingWikiWord{:href => "/nlab/show/SEAR"} SEAR
            in taking
            %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            to be fundamental and
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            as defined.
          %p
            We work in a
            %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
          %ul
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                for every set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/elements"} elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
                (the membership
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∈
                    %annotation{:encoding => "application/x-tex"} \in
                here is a typing
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
            %li
              %p
                for every set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/relations"} relations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo :
                      %mi A
                      %mo ↬
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \varphi:A \looparrowright B
                with
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/domain"} domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                (the relation notation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo :
                      %mi A
                      %mo ↬
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \varphi:A \looparrowright B
                here is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
          %p
            In addition, for every relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo :
                  %mi A
                  %mo ↬
                  %mi B
                %annotation{:encoding => "application/x-tex"} \varphi:A \looparrowright B
            and element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varphi(a, b)
            = succeed "." do
              %strong holds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo :
                  %mi A
                  %mo ↬
                  %mi B
                %annotation{:encoding => "application/x-tex"} \varphi:A \looparrowright B
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b \in B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varphi(a, b)
            holds, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is said to be the evaluation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
