                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi r
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mn 1
                          %mtd
                            %mpadded{:width => "0"}
